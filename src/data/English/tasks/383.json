			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3830401,
					"content": "It worked!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830402,
					"content": "It seems completely different from before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830403,
					"content": "The lyre's Anemo power seems fully restored. We should be able to use it now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830404,
					"content": "#It's all thanks to you, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830405,
					"content": "Now, where should we summon Stormterror?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830406,
					"content": "It must be away from the city, else there will be casualties should we fail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830407,
					"content": "Perhaps here at the winery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830408,
					"content": "If the winery was destroyed, it's not something I couldn't eventually fix, but... I'd still rather not go through the hassle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830410,
					"content": "The wind that blows at sea or in high places should be able to carry a bard's words far away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830411,
					"content": "It's never going to work if the air is too dry or suffocating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830412,
					"content": "Paimon understands. Sea or high places, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830413,
					"content": "Then the best location to play the lyre would be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830414,
					"content": "A cliff?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "If you go east from Starfell Lake, there are mountains south of the beach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830419,
					"content": "..Oh! You mean that beach you were snoring away on and Paimon had to wake you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830420,
					"content": "If you head to where the cliff juts out — that place is known as <color=#00E1FFFF>Starsnatch Cliff</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830421,
					"content": "What do you think, bard? Meets the requirements, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830422,
					"content": "Lemme think... Starsnatch Cliff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830423,
					"content": "...Alright, let's do it there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830424,
					"content": "Very well. Then let's meet at Starsnatch Cliff when we are ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830425,
					"content": "Please don't be late.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830426,
					"content": "Hee-hee! Yes, Ma'am!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830427,
					"content": "Ah, sorry. I didn't mean to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830415,
					"content": "Near the sea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "In the sky? You could play the lyre as you're gliding through the air...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "Even Amber would never think of doing such a thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "Jean"
				}
			]
		}
	]
