					"content": "Use the crystal on the Holy Lyre like last time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830302,
					"content": "Let me give it a try...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
