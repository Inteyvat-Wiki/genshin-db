			"dialogs": [
				{
					"id": 3830201,
					"content": "Woohoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830202,
					"content": "Dvalin Protection Squad! Assemble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830203,
					"content": "Let's put our crystals together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830204,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830205,
					"content": "The color of these crystals looks... muddy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830206,
					"content": "Dvalin... You're going through so much pain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830207,
					"content": "#...Let's start purifying these crystals first. Please, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830208,
					"content": "It is hard to believe such a thing is possible, until you've seen it with your own eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830209,
					"content": "Interesting. It's like filtering wine. The process is... refreshing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830210,
					"content": "I think we should have enough tears now. So next we...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 38303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
