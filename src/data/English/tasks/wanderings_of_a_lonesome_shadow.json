			"dialogs": [
				{
					"id": 191737101,
					"content": "\"...Tamimi's remodeling is going smoothly. As it is now, it can learn how to deal with various dangerous situations in the ruins on its own. I wish you could see it with your own eyes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737102
					],
					"speakerTitle": "Yellowed Note"
				},
				{
					"id": 191737102,
					"content": "\"As I worked, I kept thinking that you'd do a better job at this than I could.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737103
					],
					"speakerTitle": "Yellowed Note"
				},
				{
					"id": 191737103,
					"content": "\"After all, you're the most exceptional student I've ever met.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yellowed Note"
				}
			]
		},
