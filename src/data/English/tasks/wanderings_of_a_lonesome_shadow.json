					"nextDialogs": [
						191737302
					],
					"speakerTitle": "Oft-Corrected Note"
				},
				{
					"id": 191737302,
					"content": "(The messy scribbling has been repeatedly canceled and edited, leaving barely legible phrases and a single neat message at the back.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737303
					],
					"speakerTitle": "Oft-Corrected Note"
				},
				{
					"id": 191737303,
					"content": "\"Hurry up and come home for a meal. Your mom always makes an extra portion of food, you know?\"",
