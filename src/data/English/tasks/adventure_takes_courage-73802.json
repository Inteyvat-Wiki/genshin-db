			"dialogs": [
				{
					"id": 738020101,
					"content": "Ad astra abyssosque! Welcome to the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020102,
					"content": "Hi, Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738020103,
					"content": "Hello, Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "Greetings. You both look great today. Are you here to take commissions or deal with other affairs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020105,
					"content": "Why are you both staring at me? Is there something of significance that you would like to inquire about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020106,
					"content": "No!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "Understood. You seem like a seasoned adventurer already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020109,
					"content": "You could say that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "Then you must be well acquainted with the Adventurers' Guild's way of operation. Therefore, I won't waste your time going over it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020111,
					"content": "If you have any questions for the Guild, please feel free to ask me at any time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020112,
					"content": "Please pitch in with the commissions in Sumeru City. Outstanding adventurers like you will surely be a great help to the people here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020113,
					"content": "Safe travels, Traveler. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020107,
					"content": "W—We just want to take commissions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
		}
	]
