	"talks": [
		{
			"id": 7422201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422201",
							"2"
						],
						"stepId": 7422201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "Stay on your guard, citizen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "Me? It is as you see. I am busy dealing with the barbarian threat! They have been stepping up their attacks — perhaps they might even have sent spies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "This is no trivial matter! Vigilance must be maintained until reinforcements arrive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "If there is anything else, please bring it up with my adjutant, citizen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "A child, out here on their own...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Hmm? A child? Where from? Did some new legionnaire disobey orders and bring their family into the camp again...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "*sigh* Dominus Cassiodor is far too gentle with these greenhorns. If this were to have happened three decades prior, a Tribunus would've had a whip out by now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "Have there been any suspicious happenings lately?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Not at present. That said, the barbarians are akin to cunning beasts. Ever will they strike when your guard has been lowered, for surprise is their greatest weapon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "By methods most foul they infiltrate our cities and seek out our secrets. Even the slightest lapse in discipline may lead to catastrophe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "*sigh* Thirty years ago, when I followed Dominus Boethius to conquest in the far north, they were but a pack of primitives without any such skill for subterfuge. Where did they learn these tricks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Thirty years ago... Your parents wouldn't even have been born yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "Hmm? What did you just say, citizen? I fear my hearing's been going as I age.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "*sigh* Time truly is cruel. During the conquest of Bituria, I could hear the barbarians' bells calling them to muster from miles away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "Fare ye well, citizen! You may report suspicious people to me at any time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
