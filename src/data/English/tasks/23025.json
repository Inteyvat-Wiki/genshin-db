				{
					"id": 230250504,
					"content": "Oh, please don't say that. What could be more serious than the incoming collapse of one's own house?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250505
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250505,
					"content": "Your house is... collapsing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250506
					]
				},
				{
					"id": 230250506,
					"content": "Ahem... Of course not. But say you live in a house, and you've never seen it in its entirety, and no one has ever guaranteed its structural strength...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250507
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250507,
					"content": "Wouldn't living in this house every day worry you somehow? Such is also the case with living in this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250508
					],
					"speakerTitle": "Farghani"
				}
			]
