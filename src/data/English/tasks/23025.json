				{
					"id": 230250801,
					"content": "Ah, Traveler, you've finally come!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250802,
					"content": "How's your research going?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Thanks to you, I've made huge progress in the past few days. The beacons should be collecting data as we speak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250804,
					"content": "Now I only have to retrieve the data and verify my new conjectures!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250805,
					"content": "All you have done these days is make conjectures!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "Well, I've optimized some equations and calibrated my instruments. After all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250808,
					"content": "I won't be able to climb up to the locations where you set those beacons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250809,
					"content": "I'm afraid I'll have to trouble you to retrieve those beacons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250810,
					"content": "Well, alright then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "Please, Traveler! I will take care of the payment, do not fret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250812,
					"content": "Why don't you take retrieval into account next time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "I have weighed some options, you know. Adding a retrieval device, expanding our range of applications... things like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250814,
					"content": "But they require a higher budget, and I'm not sure how this might affect the data precision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250815,
					"content": "Anyways, I'll be counting on you this time as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250806,
					"content": "You haven't made any progress at all...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
