			"dialogs": [
				{
					"id": 730151301,
					"content": "So this is where it was hidden. Wow, we might not have found this place without Aranakula leading the way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151302,
					"content": "But where are its leaves? Paimon doesn't see them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151303,
					"content": "The leaves... They are near this big tree, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151304
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151304,
					"content": "Hmm... The Fungi won't find their way in, so this place is safe. You can just wait for us here, Aranakula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151305,
					"content": "Arapandu told us we just need to make the \"leaves\" on the three stones turn toward the \"branch,\" right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151306,
					"content": "#Thank you, Nara {NICKNAME} and Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
		{
