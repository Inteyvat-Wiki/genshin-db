					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "Aranakula, we're back! You'll need to handle the rest from here though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151602,
					"content": "#Thank you, Paimon, and thank you, Nara {NICKNAME}. Aranakula knows what to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151603,
					"content": "Oh! It looks like everything will be fine here too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151604,
					"content": "I hope the forest will return to normal soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "It will once the Varuna Contraption is fixed. But Marana... must be eliminated for Vana and Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151606,
					"content": "Just as the monument made for Nara Varuna has been covered by bad seeds, Ashvattha's Concourses have also been affected by Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151607,
					"content": "There was a time before Nara Varuna came to Vanarana. Nara and Aranara made nurseries together then. But now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151608,
					"content": "Now, only the children of Vimara Village can still see you. To adults, you only exist in stories... And the nurseries you talked about have also become deserted because of Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151609,
					"content": "Aranakula wants to fill the nurseries with flowers. Nara have forgotten Aranara, but it's fine. Nara will see the flowers.",
