			"dialogs": [
				{
					"id": 751830101,
					"content": "I can feel it, I can feel it! Your \"intensity\"... It's impressive... truly impressive! So, what do you say? Want to take on the \"Warrior's Challenge\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
