				"points": []
			},
			"dialogs": [
				{
					"id": 3560401,
					"content": "So, the present I want to give you is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560402,
					"content": "A <color=#00E1FFFF>Wind Glider</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560403,
					"content": "Outriders use them to ride the wind, and the people of Mondstadt love using them too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560404,
					"content": "I brought you here to give it to you so you can experience it right away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560405,
					"content": "Oh, you're really excited about these wind gliders, huh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560406,
					"content": "Well that's because the wind is the heart and soul of Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560407,
					"content": "Alrighty then, enough talk! Let's give it a whirl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560408,
					"content": "It's easy to use, but you still need to pay attention to my instructions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
