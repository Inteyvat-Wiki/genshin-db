			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560101,
					"content": "Let me officially introduce the city of wind, dandelions, and freedom —",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560102,
					"content": "Travelers under the protection of the Knights of Favonius — Welcome to Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560103,
					"content": "Finally, no more having to camp outdoors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560104,
					"content": "But... the city folk don't look too cheery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560105,
					"content": "Everyone's been put out of place by Stormterror recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560106,
					"content": "But everything will turn out fine as long as Jean's with us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560107,
					"content": "Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560108,
					"content": "Acting Grand Master of the Knights of Favonius — Jean, Defender of Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560109,
					"content": "With Jean on our side, surely even the vicious Stormterror will be no match for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560110,
					"content": "(Sounds like someone pretty impressive...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#Before I take you guys to the Knights of Favonius Headquarters, I have a present for you, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560113,
					"content": "It's a reward for helping me clear out that hilichurl camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560114,
					"content": "He-Hey! Why doesn't Paimon get a reward?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560115,
					"content": "Ahh... Because this reward is useless to you, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560116,
					"content": "But I'll treat you to a traditional Mondstadt delicacy — Sticky Honey Roast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560117,
					"content": "Sticky Honey Roast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560118,
					"content": "Come with me, we'll head to the city's ahh... <color=#00E1FFFF>high ground</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560111,
					"content": "(I hope she knows something about the God of Anemo)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
		{
			"id": 35604,
