					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715070101,
					"content": "The effects are better than I thought! We've recorded all the phenomena we've seen and the data we've collected...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070102,
					"content": "And most importantly, the dark mud was completely cleared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070103,
					"content": "It's just that, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070104,
					"content": "Huh, why do you look so unhappy? Is it a bad thing that the mining complex is all clean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715070105,
					"content": "Let me think... Well, when Khedive and I analyzed the situation previously, we believed that the opening in the Ley Lines through which the dark mud came should be here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070106,
					"content": "I don't think that such an opening would have been this easy to clear out, so the true entry point must be elsewhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070107,
					"content": "And in this case, the affected areas also include...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070108,
					"content": "The front-line mines.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "Exactly, this means that the point through which the dark mud is flowing in is in the tunnels. Such areas will be far more narrow, allowing for greater buildup of the mud, and making it easier for monsters to swarm in, thus worsening our problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070110,
					"content": "Still, I have full faith in the Pursina's Spike.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070111,
					"content": "It is, after all, Pursina's great creation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070112,
					"content": "Just let me do a bit of maintenance work on it first. I'll call the miners who've agreed to move the Spike into the tunnels over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
}