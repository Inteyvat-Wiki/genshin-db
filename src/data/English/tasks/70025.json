			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700250101,
					"content": "Greetings, Adventurer! I have already been informed about your completion of the commission. The Guild is grateful for your ongoing support! Here is your compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700250102,
					"content": "Although you were unable to capture the Unusual Hilichurl and we still cannot ascertain the reason for the recent spate of disturbances... the wilderness is much safer now, so thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700250103,
					"content": "On a related note, Ella Musk is waiting for you in the library.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 7002502,
			"completionStepIds": [
				7002502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002502",
							"2"
						],
						"stepId": 7002502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu... mimi tomo... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250202,
					"content": "Hello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika!!! ...O—Oh, it's just you, phew... Goodness, you gave me the fright of my life. Please, I'd appreciate it if you didn't interrupt me like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250204,
					"content": "How are we interrupting when you called us here in the first place!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250212,
					"content": "Hmm...? Oh, it's you! Thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250205,
					"content": "So, is the handbook accurate? Did it prove useful in interacting with the hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250206,
					"content": "It was nothing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "Well! Either way, my dictionary has been further refined, and we've obtained more evidence to support my thesis that harmonious coexistence between human and hilichurl kind is viable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250209,
					"content": "Still, it is a pity that we didn't get the opportunity to converse with the Unusual Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250210,
					"content": "But from the linguistic corpus I have managed to assemble thus far, it seems likely that it was simply looking to make some friends in an unfamiliar land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250213,
					"content": "It is a real pity that you didn't get to converse with it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250214,
					"content": "Ah, I almost forgot — this is for you, as thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250215,
					"content": "You helped me a lot here, and I do apologize for having put you through so much trouble... But I do hope I will have the pleasure of working with you again in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250211,
					"content": "Well now, isn't that very polite of you all of a sudden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250207,
					"content": "I would have preferred to handle this my way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
}