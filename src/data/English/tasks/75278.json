			"dialogs": [
				{
					"id": 752780101,
					"content": "W—Wait a second! Please stop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780102,
					"content": "How can we help you, little girl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "\"Bear the miracle of the blooming Guiztli, and let the Sacred Flame ignite your smile!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780104,
					"content": "Huh? What's going on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "\"In the name of the Easybreeze Holiday Resort, I present to you a dance of welcome! Shine on, Pipilpan Idol!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780106,
					"content": "Ah! That line again!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#That's right, it's me, \"Chiton\"! Hehe, long time no see, {M#Mr.}{F#Ms.} {NICKNAME} and Ms. Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780108,
					"content": "Oh! It's you, \"Chiton\"! Paimon thought we'd run into someone scary again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "You seem happy. Good news?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Hehe, guess what? Dad's gonna train me personally to become a proper performer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780112,
					"content": "See? He acts all tough, but he really cares about you! Paimon just hopes he can be a little more... conventional in his teaching methods...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "Oh, I almost forgot, this is for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780114,
					"content": "Wait, isn't this your performance outfit? But without it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Don't worry! Dad made me a new one that fits better! No more falling off the stage for me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780116,
					"content": "Consider this old outfit a keepsake! Take it, please, and think of it as a symbol of our friendship!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780117,
					"content": "Next time we meet, I'll wear my new outfit and dance just for you. Promise you'll come see me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780118,
					"content": "We promise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "\"Chiton\"! Training time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#Okay, gotta go work on these muscles. Bye bye, {M#Mr.}{F#Ms.} {NICKNAME} and Ms. Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780121,
					"content": "Bye-bye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(You're really gonna go?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "Of course! Though... it would be nice if she puts on a regular idol performance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "How've things been going lately?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}