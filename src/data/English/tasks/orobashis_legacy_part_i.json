			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "The strangely-shaped stone lantern seems to be emitting an ominous energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721290102,
					"content": "This stone lantern is so strange... It's so creepy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "Oh, what's that written on the light post?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "\"Travelers passing through: if you have any questions about this ward, please go to the Musoujin Gorge and talk to Mr. Kaji about it.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721290105,
					"content": "The handwriting looks very recent, and there are a few lines of smaller handwriting below, which have been eroded by the rain:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721290106,
					"content": "\"Please tell Mr. Kaji we've tried... But unfortunately... Maybe he can find it somewhere nearby...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721290107,
					"content": "\"Please tell Mr. Kaji to come to the refuge as soon as possible. He's dearly missed by his family.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721290108,
					"content": "This Mr. Kaji seems to be pretty concerned about these stone lanterns. Why don't we go to Musoujin Gorge and ask him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
