				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "Not bad, outlander! The clouds are almost gone. It seems as though my guess was right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Next, the two wards at the Serpent's Head and Jakotsu Mine still need to be repaired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "If you don't mind, I'll leave those two wards to you, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "You got it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "Thank you very much for your help. Although I am by no means a man of wealth, I promise that you will be paid fairly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "I still don't know when it'll happen, but it seems that the time for my reunion with family and friends is drawing a little closer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "By the way, you can find me on the west side of the island once you're done. Fort Mumei came under rebel assault previously, and I suspect that the attack is related to these changes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
