			"dialogs": [
				{
					"id": 721290201,
					"content": "You gaze at the ward, and suddenly, a strange energy flows towards you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Touch Ward"
				},
				{
					"id": 721290202,
					"content": "You realize that it is not resisting you, but is asking you for something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Touch Ward"
				},
				{
					"id": 721290203,
					"content": "Something seems to be missing from this ward. Best to look around the area for the missing parts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Use your Elemental Sight to scan for scattered traces of elements nearby. Maybe you'll find something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
