			"dialogs": [
				{
					"id": 721290601,
					"content": "How're things going? Have you finished repairing the wards already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290602,
						721290603
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290602,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "It's fine. Take your time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290603,
					"content": "I'm still working on it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290605
					]
				},
				{
					"id": 721290605,
					"content": "And if you don't manage it, just leave it. The most important thing is that you shouldn't stay in this place too long — it's dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
