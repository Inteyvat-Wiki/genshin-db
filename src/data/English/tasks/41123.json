			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230301,
					"content": "Have you succeeded in beating back those Treasure Hoarders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230302,
					"content": "Sure did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "Wonderful. You've been a great help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230304,
					"content": "Hopefully, those Treasure Hoarders will take a hint from this lesson and stop eyeing Mondstadt up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230305,
					"content": "Well then, if there's nothing else...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "Um, so, please hold on a moment... There is something else I need your help with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230307,
					"content": "In truth, we've received a plenitude of reports about abnormal monsters during this period.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230308,
					"content": "These reports mention that the meteorites have caused the monsters to become especially aggressive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230309,
					"content": "The city's defenses are sufficiently stalwart, so there's no reason to worry there. But one such meteorite has landed right beside Springvale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230310,
					"content": "Springvale is home to many hunters, and we've sent knights to reinforce them, but the terrain is truly difficult to police.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230311,
					"content": "If any monsters were to enter the town, things could get disastrous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230312,
					"content": "Could you head over to Springvale and help us investigate the status of the monsters there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230313,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "I'll leave it in your capable hands, then. I will do what I can to send some knights over to assist you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230315,
					"content": "What's the situation over in Springvale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "To be frank, things don't look good. We already have our hands full dealing with the meteorites' aftermath. But we also need to guard against monsters and the Treasure Hoarders...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230317,
					"content": "It's almost impossible to handle so many things at once...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230318,
					"content": "I'm sorry, but I'm leaving this in your hands. In the meantime, I will try to send knights over to aid you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112304,
			"completionStepIds": [
