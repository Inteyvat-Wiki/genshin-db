			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "Hello, Traveler. Please refrain from leaving the city during this time, if you will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "Now, I believe that you've seen those fallen meteorites as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230104,
					"content": "For some reason, they've started falling at a greater rate than before, and it's become more dangerous out there in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230105,
					"content": "All sorts of matters are cropping up within the city, almost more than the Knights can handle. All this, at a time when we'd just discovered Treasure Hoarder activity near the city...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230106,
					"content": "Those fellows would do anything for a little Mora. I fear that they'll try to take advantage of this situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230107,
					"content": "If you're willing, Traveler, could you help us chase those thieves off?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230108,
					"content": "This should be a task for the Knights, but I fear that we can't spare the people to settle this matter. Can you help us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230109,
					"content": "You can count on me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "You have my thanks. I'm sorry, I know it's not the best look for us to be asking you to help us in these circumstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230111,
					"content": "The Treasure Hoarders aren't scared of the meteorites?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "Hmph. I'd wager that those crooks fear nothing, as long as they can get their hands on some Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230113,
					"content": "You have my thanks. I'm sorry, I know it's not the best look for us to be asking you to help us in these circumstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112303,
			"completionStepIds": [
				4112303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112303",
							"2"
						],
						"stepId": 4112303,
						"stateName": "QUEST_STATE_UNFINISHED"
