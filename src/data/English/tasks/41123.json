					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411231101,
					"content": "How do you do, Honorary Knight? Please, do your utmost to remain within the city limits during this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231102,
					"content": "Now, I believe that you've seen those fallen meteorites as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231103,
					"content": "For some reason, they've started falling at a greater rate than before, and it's become more dangerous out there in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231104,
					"content": "All sorts of matters are cropping up within the city, almost more than the Knights can handle. All this, at a time when we'd just discovered Treasure Hoarder activity near the city...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231105,
					"content": "Those fellows would do anything for a little Mora. I fear that they'll try to take advantage of this situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231106,
					"content": "If you're willing, Traveler, could you help us chase those thieves off?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231107,
						411231109
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231107,
					"content": "I won't let you down.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411231108
					]
				},
				{
					"id": 411231108,
					"content": "Spoken well, Honorary Knight. I'll leave it in your able hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231109,
					"content": "Aren't the Treasure Hoarders scared of the meteorites?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411231110
					]
				},
				{
					"id": 411231110,
					"content": "Hmph. I'd wager that those crooks fear nothing, as long as they can get their hands on some Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411231111
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411231111,
					"content": "You have my thanks. I'm sorry, I know it reflects ill on us to be asking for your help in such circumstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
