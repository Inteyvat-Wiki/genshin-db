			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230901,
					"content": "How's the situation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230902
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230902,
					"content": "Springvale is safe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230903
					]
				},
				{
					"id": 411230903,
					"content": "That's great... I was honestly worried that we might not be able to spare anyone to help out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230904
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230904,
					"content": "Thank you so much. You've really helped us out this time. Please take these as a token of our esteem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230905
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230905,
					"content": "*sigh* Meteorites, monsters... I can only hope that nothing truly messy happens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
