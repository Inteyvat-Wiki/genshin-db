			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timid Morrow"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230401,
					"content": "Aaaah! D—Don't come any...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230402,
					"content": "Eh? Y—You're not a monster. Wh—Who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230403,
					"content": "What's the status on those monsters?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "The monsters? What is there to ask? I was just running from them, that's what!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230405,
					"content": "They were right there, a whole bunch of them, looking like they might attack the town.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230406,
					"content": "If I hadn't run so fast, I'd have been a goner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230407,
					"content": "Where are those beasts?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "Right next to the town. A few steps around the corner and you'll see them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230409,
					"content": "You should get to shelter as well. I'll rest here for a while, and then I'll go warn everyone in town.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timid Morrow"
				}
			]
		},
		{
			"id": 4112308,
			"completionStepIds": [
				4112308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112308",
							"2"
						],
						"stepId": 4112308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timid Morrow"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411230801,
					"content": "Huh? It's you, again? What were you doing this whole time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230802,
					"content": "Defeating all the monsters?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "Defeating all the... What? Just you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230804,
					"content": "You can go check it out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "Ugh, I daren't look. If they see me, I'd be done for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230806,
					"content": "I'll just report what you've said to the Knights — never mind if it's true or not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 411230807,
					"content": "Th—They'll have some way to check if you've beaten all those monsters, I'm sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timid Morrow"
				}
			]
		},
		{
			"id": 4112309,
			"completionStepIds": [
				4112309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
