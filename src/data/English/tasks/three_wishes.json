			},
			"dialogs": [
				{
					"id": 20030501,
					"content": "According to the letter, this should be the place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030502,
					"content": "Sorry, we don't serve the general public. I'm afraid you'll have to leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030503
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030503,
					"content": "Wait! We're not the general public...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030504,
					"content": "Well then... you must be a couple of wandering outlanders that snuck into the nation... judging by your attire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030505
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030505,
					"content": "Are our clothes really so— oh! Uh... What Paimon means to say is—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030506,
					"content": "Here's our Invitation Letter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030507
					]
				},
				{
					"id": 20030507,
					"content": "Hmm, the Yashiro Commission's seal... this must be from Mr. Thoma. It seems there's more to you than meets the eye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030508
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030508,
					"content": "In which case, welcome to the Komore Teahouse, a safe haven for the Yashiro Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030509
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030509,
					"content": "Well, that sounds more like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
