	"talks": [
		{
			"id": 2300302,
			"completionStepIds": [
				2300302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300302",
							"2"
						],
						"stepId": 2300302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "Traveler! Ah, I mean, wondrous child of fortune and luck! You're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030202,
					"content": "I ate the \"Golden Dish\" you prepared the last time and made a killing on the Exchange!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030203,
					"content": "I came here today to check and sure enough, I have made great gains on all the futures I bought!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030204,
					"content": "Come, let's go to Lambad's Tavern, and you can order whatever you want. It'll be my treat! I must thank you, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "This is all thanks to your help, so please, order whatever you'd like to eat today! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030402,
					"content": "Looks like you really did make a lot of Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030403,
					"content": "It is a good sum by a normal person's measure, but compared to the assets that I, Hatim, possess, it is but a mere ripple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030404,
					"content": "After all, I am also privy to knowledge obtained from decades of experience as an old hand. If you are interested in futures, I can share some of my personal experiences with you, in fact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030405,
					"content": "We agreed the last time that you shall gain additional benefits, so please, ask me anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030406,
					"content": "Heh. Y'know, this additional benefit doesn't feel all that different from not having any!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030407,
					"content": "We don't play with futures after all...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "Oh, nonsense! You shall have a share of the Mora too, of course. But compared to that, my advice is what is truly of value!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030409,
					"content": "Then Paimon has a question... Will there really be slime futures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030410,
					"content": "N—Not that Paimon wants to profit, of course! Just asking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030411,
					"content": "Only commodities in circulation can become futures, so if there is as much Slime Condensate as flour and milk on the market, then it's possible for tradable Slime Condensate futures to be created.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030412,
					"content": "But I've mentioned this before. If you want to trade in Slime Condensate futures, I'm afraid that all Slimes in the wild will go extinct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030413,
					"content": "Plus, institutions or individuals who specialize in raising slimes may arise, and they may continuously produce large quantities of Slime Condensate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030414,
					"content": "When that time comes, the price of Slime Condensate might also go up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030415,
					"content": "What!? It's just buying some Slime Condensate, how can things get so complicated...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030416,
					"content": "#P—Paimon'll just stick to getting {NICKNAME} to beat those Slimes up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030417,
					"content": "What about you, Child of Fortune? Do you have any questions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030418,
					"content": "How did you come up with the idea of \"Golden Dish\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "Ha! You really are a Child of Fortune. Straight to asking about the key to wealth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030420,
					"content": "I can't really say that I \"came up with\" it, but I can say that I learned about these \"Golden Dishes\" during my long career in futures trading.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030421,
					"content": "The futures trading market is treacherous... But as long as I have my \"Golden Dishes,\" piloting this investment ship shall be a cinch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030422,
					"content": "This really is nonsense...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "Ah, enough of that! Come, eat, eat! Eat up! I'll be asking for your help more often in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030425,
					"content": "Here! Try this Shawarma Wrap. It's Sumeru's special dish. You really must try it, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030426,
					"content": "You enjoy the delicious food with Hatim...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "Isn't this just what they call \"peace of mind\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "I went to the \"Wealth Spot\" and even ate the \"Golden Dish\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030702,
					"content": "But the result is this drop...! This makes no sense! How is this market making any sense? Where's the fairness!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030703,
					"content": "Hatim, we've been looking for you for a long time. Are you okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030704,
					"content": "Ah, it's you guys... I... I'm fine. I'm great... Look. I'm not missing an arm or a leg or anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030705,
					"content": "I just lost my deposit... Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030706,
					"content": "S—Sorry...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "No! This is not your fault. Don't take it to heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030708,
					"content": "Of course, it's certainly not my fault either. What's truly to blame is this market for being bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030709,
					"content": "It makes no sense! It doesn't follow rules! It just goes down like that, and goes up like... like... Well, it didn't go up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030710,
					"content": "Really, argh... I really...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030711,
					"content": "Never mind, I simply cannot believe it... I cannot believe that I, Hatim the exceptionally rich from Kalimi, still cannot conquer futures trading!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030712,
					"content": "Didn't you lose everything...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "Hmph, it doesn't matter. I still have plenty of backup funds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030714,
					"content": "Even if I don't have any Mora on hand, I still have working capital and assets elsewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030715,
					"content": "Just you wait, Kalimi Exchange! I, Hatim, shall be back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		}
	]
}