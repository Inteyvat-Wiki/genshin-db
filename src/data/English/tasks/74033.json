				]
			},
			"dialogs": [
				{
					"id": 740330101,
					"content": "No one comes here anymore after the Geode Mine Shaft was closed, and the devices here aren't meant for just anyone to handle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330102,
					"content": "And that's exactly what happened this time. Someone tinkered with the drive valve and trapped their own companion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330103,
					"content": "Anyway, let's get it to open up the passage to <color=#00E1FFFF>Supply Warehouse 1</color>. By the way, if they offer you a drink, you'd best say no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330104,
					"content": "Who's going to offer us a drink? And why won't we take it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "You'll find out soon enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
			"id": 7403304,
			"completionStepIds": [
				7403304
			],
