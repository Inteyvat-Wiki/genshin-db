			"dialogs": [
				{
					"id": 745050101,
					"content": "H—H—Hello, you t—two... My name is... is... A—A—Armand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050102
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050102,
					"content": "You seem kinda nervous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745050103,
					"content": "S—S—Sorry! I—I get like th—this when th—there are too many... p—p—people around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050104
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050104,
					"content": "No worries, no worries. You don't have to rush, we're just here to try out the toy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745050105,
					"content": "O—Oh. S—S—Sure... I have p—prepared a... h—h—handbook for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050106
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050106,
					"content": "Aw, that's so nice of you, Armand! We'll read it carefully for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745050107,
					"content": "I—It's alright if you d—don't read it. It's very s—s—simple and f—fun... D—Do you want to t—try?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050108
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050108,
					"content": "Thanks, I'll give it a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745050109
					]
				},
				{
					"id": 745050109,
					"content": "I h—h—hope you... enjoy yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Armand"
				}
			]
		}
