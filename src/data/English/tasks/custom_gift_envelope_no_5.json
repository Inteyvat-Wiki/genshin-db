			"dialogs": [
				{
					"id": 715370101,
					"content": "Honorary Knight! I didn't expect to run into you here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370102,
					"content": "Are you making gift envelopes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "Yes! I finally got the chance to come here on vacation, and I wanted to bring a few gifts back for the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370104,
					"content": "I heard that, during Lantern Rite, locals like to include one of these envelopes with their gifts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370105,
					"content": "So, I wanted to follow their lead and make a few gift envelopes of my own. But, they're not looking too good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370106,
					"content": "I want my gift envelopes to be beautiful! Can you show me how, Honorary Knight?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370107,
					"content": "Of course, leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
