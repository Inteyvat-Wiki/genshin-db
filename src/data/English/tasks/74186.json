			"dialogs": [
				{
					"id": 741860301,
					"content": "Dominus Cassiodor! Dominus Cassiodor... Is that you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860303,
					"content": "It is you! Just as I thought! You've finally returned...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860304,
					"content": "I was ordered to guard this fortress, but the cruel Vishaps and attacks of the barbarians were simply too much for me, so I was forced back step by step until I arrived here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860305,
					"content": "It seems as though many, many years have passed since then... What tidings from beyond? Were we victorious?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860307,
					"content": "...Is that so? Then we lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860308,
					"content": "I am sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860309,
					"content": "Do not say such things, Honored Dominus. I had already imagined this day might come when I joined the Sebastos's legions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860310,
					"content": "Did the Sebastos not say that he wanted to lead us to break the shackles of \"Fortuna\"? But is doing so that simple?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860311,
					"content": "After all, what we struggle against is fate itself, and defying fate is a feat beyond even the greatest of the gods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860312,
					"content": "In the end, all our efforts were in vain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860313,
					"content": "Nay, say not so, Dominus. We took up arms against divine destiny, and our deeds challenged the laws of heaven. We resisted that prophecy, resisted it most valiantly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860314,
					"content": "Though we failed in the end... Someone must have betrayed us, led us astray...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860315,
					"content": "Still, the outcome no longer matters. Come what may, our deeds shall be carved into this world's \"history\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "Nameless Golem"
				},
				{
					"id": 741860316,
					"content": "Hey! Why did he just fall over like that? Can stone people also just... suddenly faint?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "I still do not know his name... It appears his \"history\" has now reached its conclusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860318,
					"content": "Wait, that's so sad! Has he just been fighting here, all these thousands of years?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "But now, he is finally at peace. Let us continue onward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		}
	]
}