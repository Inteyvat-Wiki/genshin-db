			"dialogs": [
				{
					"id": 742080301,
					"content": "About Mysterious Xenochromatic Crystals...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742080302
					]
				},
				{
					"id": 742080302,
					"content": "Same old rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080303
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080303,
					"content": "Excellent. That said, I suppose we probably won't meet again to conduct another one of these happy little transactions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080304
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080304,
					"content": "Mysterious things are only mysterious because they're rare. I did buy some Mysterious Xenochromatic Crystals from another adventurer before this. Only saw him three times, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080305
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080305,
					"content": "According to him, he was able to find these things three times — never again. Maybe there's some strange rule of nature at work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080306
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080306,
					"content": "If you ask me, we'd best leave some of this world's secrets undisturbed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pitot"
				}
