				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "*cough* No... This is still no good... It won't do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830102,
					"content": "Any further delay and I'll miss the next submission deadline... *sob*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830103,
					"content": "Hello...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830106,
					"content": "I'm sorry—soooo sorry! I will submit it today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830107,
					"content": "Whoa! Hang on, we...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830108,
					"content": "Miss Moriko, please just give me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830109,
					"content": "Huh? So you aren't Miss Moriko... Thank goodness... Ugh *coughing*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830110,
					"content": "So who is Miss Moriko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "Miss Moriko is my executive editor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830112,
					"content": "My name is Asagiri. I'm a, um, a freelance illustrator of sorts. Miss Moriko is... the executive editor in charge of my work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830113,
					"content": "An illustrator? What does that mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830114,
					"content": "I suppose you've read some light novels of Yae Publishing House, haven't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830115,
					"content": "Have you noticed that a light novel usually contains a few pages of pure pictures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830116,
					"content": "Such pictures are what we call illustrations, and those who draw them are illustrators.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830117,
					"content": "To serve an important scene or plot, or to give the protagonist a face, some authors will have people draw them an illustration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830118,
					"content": "The illustration not only creates a more immersive reading experience but also enriches the novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830119,
					"content": "Oh, Paimon gets it now. It's no simple business to make light novels...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830120,
					"content": "I can recommend a few novels to you! For example... ahem! *coughing*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830121,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "I'm fine. I've never been very healthy — with all the midnight-oil burning and meal skipping during my work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830123,
					"content": "*cough* As a result, my health keeps deteriorating...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830124,
					"content": "Since you're unwell, why are you still working here out in the open? Can't you draw at home?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830125,
					"content": "I'm here to gather some inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830126,
					"content": "My muse has left me recently. I've missed the deadlines for a few illustrations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830127,
					"content": "Miss Moriko has postponed the deadlines for me several times. She'll be so mad if I dare delay any further.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830128,
					"content": "I was thinking that maybe a walk in the open would bring my muse back, so I decided to go on a trip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830129,
					"content": "But as it turned out... Haha... You see, it hadn't taken long before I ended up in this miserable state...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830130,
					"content": "*sigh* I'd better put up a request at the Adventurers' Guild and see if any adventurer with a Kamera can help out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830131,
					"content": "Huh? Speaking of the Kamera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830132,
					"content": "I do have one...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "Really!? You have a Kamera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830135,
					"content": "I—I wanted to have an adventurer take pictures for me using the Kamera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830136,
					"content": "I've heard about many fascinating locations out there — say, the lofty snow mountain near Mondstadt and the area in Liyue where there are many pillars...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830137,
					"content": "And what's more! There's this place named \"Jueyun Karst.\" They say that the adepti live there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830138,
					"content": "The abode of the adepti... The thought of it gives me thrills...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830139,
					"content": "But sadly, my health doesn't allow me to really go there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830140,
					"content": "However, if you can capture their sceneries with the Kamera, I can surely... Ugh *coughing*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830141,
					"content": "Whoa! Take it easy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726830142,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "Really!? That's wonderful! There are many places on my wish list. Gimme a second. Let me find the list.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830145,
					"content": "And don't you worry about the finances. I have quite some savings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830146,
					"content": "Where is my notebook? Where is it? My notebook...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 726830143,
					"content": "I will work this out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "But what can it do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "Excuse me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}