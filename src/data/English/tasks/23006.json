						230060402
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060402,
					"content": "Yep.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060403
					]
				},
				{
					"id": 230060403,
					"content": "I can't thank you enough, Traveler. Please take this as your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060404,
					"content": "By the way, Mr. Gurgen has been forcing himself to work again lately. I should take some more time to get him to change his mind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060405,
					"content": "There have been so many things that need taking care of lately, so I might have to bother you with cleanup duties next time as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
