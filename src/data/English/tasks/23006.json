			"dialogs": [
				{
					"id": 230060301,
					"content": "Traveler, is there anything you'd like to ask?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060302,
					"content": "Could you tell me more about Zakariya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "Dr. Zakariya is a great doctor and a devout believer of the Dendro Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060304,
					"content": "He treats patients around the clock and hardly ever has time to eat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060305,
					"content": "Dr. Zakariya even said that it's his duty to extend the blessings of the Dendro Archon to more people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060306,
					"content": "Does the blessing of the Dendro Archon really matter that much in healing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "To be precise, the act of \"treatment\" itself is the blessing of the Dendro Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060308,
					"content": "It was by the grace of the Dendro Archon that we could find cures for patients and grow herbs to treat illnesses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060309,
					"content": "Thank you, O Dendro Archon, for your blessing. May everyone be kept from maladies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
