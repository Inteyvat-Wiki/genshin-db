				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "Hey! Big guy! What do you think you're doing? Stop it right now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora... No, no! It was you who killed Murasaki... You must die!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Furious Samurai"
				},
				{
					"id": 760220203,
					"content": "#Whoa! Watch out, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602203,
