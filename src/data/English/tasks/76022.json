			"dialogs": [
				{
					"id": 760220101,
					"content": "Don't struggle if you don't wanna bleed — leave your Mora and walk away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220102
					],
					"speakerTitle": "Furious Samurai"
				},
				{
					"id": 760220102,
					"content": "Help! Someone save me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220103
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220103,
					"content": "Whoa, we should go help that guy!",
