			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Peco"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "Thank you both so much for saving me! I'm Peco, a traveling merchant. If you ever run into me in the future, I'll make sure to give you the best deals around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220302,
					"content": "Today's my unlucky day... What did I do to deserve to run into this \"legend\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220303,
					"content": "\"Legend\"? Is that guy famous or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220304,
					"content": "Not in a good way. Word gets around among us traders... A few colleagues said they ran into him and swore they'd never take this route again. I didn't believe them, figured they were exaggerating...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220305,
					"content": "You're braver than you look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220306,
					"content": "We traveling merchants see all kinds of things, you know? And, well, sometimes stories grow in the telling...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220307,
					"content": "But anyway — they call him \"Gonpachi.\" Rumor has it he got into trouble back in Inazuma and fled out here with his lover in tow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220308,
					"content": "So that \"Murasaki\" he kept mumbling about was...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#Oh, right! That weirdo kept mumbling that name during the fight with {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220310,
					"content": "Once you stray from the straight and narrow, it's hard to get back on track — even in a new place. Without honest work, you end up back where you started.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220311,
					"content": "This lifestyle might work for a lone wolf. But living life by the sword... Sooner or later, you're bound to cross the wrong person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220312,
					"content": "From what I heard, that's how his lover met her end. Ever since then, he's been... well, not quite right in the head.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220313,
					"content": "*sigh* Robbing people is awful, but... knowing how he ended up like this makes Paimon feel kinda bad for him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220314,
					"content": "Let's hope Paimon doesn't turn to a life of crime...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "HEY! That's not the point of this story!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220318,
					"content": "Alright, I won't keep you two any longer. Please, take this as a token of my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220316,
					"content": "If Paimon ever gets robbed...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#Hehe, it's a good thing I've got you around! {NICKNAME}, my Mora guardian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
