							4564.64
						],
						"pointId": 340300480
					}
				]
			},
			"dialogs": [
				{
					"id": 746870301,
					"content": "Hey-ho! Here comes the relief force...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870302,
					"content": "Huh? What are you two doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870303,
					"content": "I—Is there something wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "Have we met before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870305,
					"content": "Nothing wrong at all! It's good to see such famously strong heroes here to help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870306,
					"content": "Back in the unit — and after I returned to the village, too — everyone said you two could take care of anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870311,
					"content": "On the other hand, those two over there are reliable enough, but there's something a little... awkward between them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870312,
					"content": "Human emotions are complicated... I think maybe they could do with a little push.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870313,
					"content": "Awkward?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "Forget it. There are more important things to focus on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870315,
					"content": "Anyway, I have faith in you. The cannon's easy enough to operate. I'm sure you'll have those monsters cleared up in short order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870307,
					"content": "I feel like we've met before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "So you do remember me! I applied for a position at the Chevalmarin Film Fantasyland.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870309,
					"content": "Paimon thinks she maybe remembers that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870310,
					"content": "I'm well aware of your deeds, and I know I can trust you with anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				}
			]
		}
	]
}