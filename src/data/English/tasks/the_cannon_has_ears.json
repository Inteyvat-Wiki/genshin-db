					},
					{
						"sceneId": 3,
						"position": [
							2288.888,
							469.032,
							4564.64
						],
						"pointId": 340300480
					},
					{
						"sceneId": 3,
						"position": [
							2275.039,
							469.192,
							4587.584
						],
						"pointId": 340300485
					}
				]
			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "We've been at this for half a day now, and the monsters aren't showing any signs of thinning out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870102,
					"content": "Maybe I should call for reinforcements?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870103,
					"content": "There's no need to panic. Trust in the cannon and our plainclothes colleague!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870104,
					"content": "Besides, there's an adventurer with a nose for danger and a certain officer who are sure to turn up should we find ourselves in a crisis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870105,
					"content": "What's all this about a crisis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "#Wow, here they are... Proto-Boss and {M#his}{F#her} little assistant really have shown up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870108,
					"content": "Hello, you two. Please allow me to explain the situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870109,
					"content": "Why don't you take a breather? I can brief these two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870110,
					"content": "Hey! Want to have a go on the cannon? Opportunities like this don't roll around often, at least, not since the fleet was destroyed. It'll be a blast from centuries past!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870111,
					"content": "Blowing monsters to smithereens with these specially made projectiles is the perfect way to unwind — and the Gardes will even reward you for it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870112,
					"content": "Blasting monsters with a massive cannon... That's right up our alley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870113,
					"content": "It certainly sounds straightforward enough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "I understand your excitement, Proto-Boss, but we're still on a knife's edge here. Let me fill you in on what's happening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870116,
					"content": "Recently, a group of workers unexpectedly unearthed some ruins nearby, disturbing the monsters slumbering within...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870117,
					"content": "We Gardes have set up a containment zone to prevent their escape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870118,
					"content": "Well, I say \"containment zone\"... At the moment, it's just the two of us and a Melusine agent who happened to be here on holiday... Oh, and our customized cannon, of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870119,
					"content": "Eek! That sounds dangerous! Paimon hopes that Melusine agent isn't in any danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870120,
					"content": "Don't worry about her. The cannon at the entrance to the ruins is operated remotely — she can keep most of the monsters in check without getting anywhere near them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870121,
					"content": "She's very reliable, but this operation's dragging on now, and she must be exhausted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870122,
					"content": "Will you help us out, Proto-Boss? If the situation doesn't improve soon, I'll have to call for reinforcements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870123,
					"content": "#What are you talking about, Chenee? You know how capable our Proto-Boss is — with {M#him}{F#her} in control, my cannon will wipe out those monsters in no time flat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870124,
					"content": "Say no more. I'd love to give this cannon a blast...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "It's not our style to walk away from danger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870127,
					"content": "Fantastic! We're very grateful for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870128,
					"content": "After our last experiment, I made some adjustments to my invention — I hope you'll find it easy to operate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870129,
					"content": "*sigh* Now, if only we could get it to aim and fire automatically... What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870130,
					"content": "That's a great idea! Next time, I can try fitting it with a Gardemek's target identification module! That way, it should be able to operate autonomously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870131,
					"content": "How clever — you really are a genius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870125,
					"content": "I'm willing to help no matter the situation!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "Is there a particular reason for blowing these monsters up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "We got here in time, I hope?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
		{
			"id": 7468703,
