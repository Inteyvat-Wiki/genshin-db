	"talks": [
		{
			"id": 1110001,
			"completionStepIds": [
				1110001
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110001",
							"2"
						],
						"stepId": 1110001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#Hey, {NICKNAME}... Is it just Paimon, or is there something weird about those hilichurls over there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000102,
					"content": "They do give off a sinister energy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Paimon thinks so too. We've seen plenty of hilichurls before, and they're always the bad guys... but this is different.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000106,
					"content": "Uh-oh, this is right by the Wangshu Inn, too. The guests are in great danger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000107,
					"content": "#Now that we've seen it, if we don't do anything about it, Paimon will feel really guilty... Let's go take care of them, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000104,
					"content": "They seem unusually agitated.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "Right! Maybe it has something to do with that sorta... dark energy they're giving off?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110003",
							"2"
						],
						"stepId": 1110003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "These super evil hilichurls are more difficult to defeat than the usual kind, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000302,
					"content": "Hey, seems like people are gathering over there... Wonder what they're doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000303,
					"content": "Whoa, see that guy in the mask? He—He scared off all the hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000304,
					"content": "Could he be an adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "Oh, you mean like Xiao? Now that you mention it, this guy's mask is kinda similar to the one that he wears...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000307,
					"content": "But the magic he was using seemed even more adeptus-y than Xiao's. Shall we go say hi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000305,
					"content": "Looked like he was using some sort of adeptus art...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110004",
							"2"
						],
						"stepId": 1110004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Male Believer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Have you seen the Master of Stars in action? His power truly hails from the divine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Male Believer"
				},
				{
					"id": 111000402,
					"content": "I believe that now, there is finally some hope for my ailing father...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Male Believer"
				},
				{
					"id": 111000403,
					"content": "Tell me about the Master of Stars.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Watching him use his magic is all the proof you need. A true adeptus, no doubt about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Male Believer"
				},
				{
					"id": 111000405,
					"content": "Not long ago, I sought some medicine from him on behalf of my ailing father. The difference with Bubu Pharmacy's prescriptions was like night and day, I tell you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Male Believer"
				},
				{
					"id": 111000406,
					"content": "Once it was boiled and ready, it gave off this really ethereal mist — seemed pretty adeptal to me! Hm... Could have also been because there was Mist Flower in it, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Male Believer"
				},
				{
					"id": 111000407,
					"content": "Adepti medicine is surely the most potent. My father will recover soon, I just know it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Male Believer"
				},
				{
					"id": 111000408,
					"content": "Sure, you have to make some sacrifices if you seek help from an adeptus like the Master of Stars — I had to give a few antiques as offerings. But my father's life is worth much more than a few old relics, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Male Believer"
				}
			]
		},
		{
			"id": 1110005,
			"completionStepIds": [
				1110005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110005",
							"2"
						],
						"stepId": 1110005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Female Believer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Finally, a life full of hope and purpose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Female Believer"
				},
				{
					"id": 111000502,
					"content": "What are your thoughts on the Master of Stars?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "Oh! Are you believers, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Female Believer"
				},
				{
					"id": 111000504,
					"content": "After my fiancé upped and left, I cried every day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Female Believer"
				},
				{
					"id": 111000505,
					"content": "But then I turned to the Master of Stars for help. At his suggestion, I started burning paintings of my fiancé and casting the ashes into the ocean at sunrise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Female Believer"
				},
				{
					"id": 111000506,
					"content": "I can't explain it... but it really worked! I know in my heart that he will return. This is not some sort of positive thinking trick... I am certain of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Female Believer"
				},
				{
					"id": 111000507,
					"content": "I'm so overjoyed that I gave a portion of my wedding budget to the Master of Stars as an offering. After all, if not for him, I wouldn't be getting my fiancé back, in which case I wouldn't need it anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Female Believer"
				}
			]
		},
		{
			"id": 1110006,
			"completionStepIds": [
				1110006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110006",
							"2"
						],
						"stepId": 1110006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mercantile Believer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "The Millelith don't really need to do shifts when the Master of Stars is around, do they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "Mercantile Believer"
				},
				{
					"id": 111000602,
					"content": "What do you know about the Master of Stars?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "I'm a merchant, and I had an especially valuable batch of goods that needed transporting recently. So, I asked the Master of Stars if he would make the journey with me, as presumptuous as that was.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "Mercantile Believer"
				},
				{
					"id": 111000604,
					"content": "Reason being, monsters run a mile as soon as he so much as holds up his talisman. We didn't have the slightest bit of trouble the whole journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "Mercantile Believer"
				},
				{
					"id": 111000605,
					"content": "It didn't come cheap, of course... but then, soliciting the services of an adeptus is a monumental affair — just look at the Rite of Descension! So I can accept it, but I doubt that most from outside of Liyue would be willing to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mercantile Believer"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Starsnatcher"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "What do you think? One's adherents may exaggerate a little, but they speak from the heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000802,
					"content": "From their imaginations, I'd say...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Haha, surely you jest. There was once a senior adeptus, Xue Wuliang, known to the people as \"Liangzi.\" He said this:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000804,
					"content": "\"All things are connected. That which mortals call 'imagination' is merely the bridge betwixt the spiritual and the material.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000805,
					"content": "In other words, their wishes are already on the path of transitioning into reality. Does this make things clearer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000806,
					"content": "Ahh... Nope, it makes them way more complicated... But basically, what you're saying is that their wishes can come true, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "Indeed. You are perceptive, my diminutive friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000808,
					"content": "Okay. Um, so we also have one other question...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "Oh? You need but ask.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000810,
					"content": "Why do you wear a mask?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "One... wanders among mortals, doing good and cleansing evil. One reveals not one's visage to avoid further disturbance to this realm than is necessary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000815,
					"content": "Ah, got it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "Now, then — what are your wishes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000817,
					"content": "I want to know where my sibling is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Hmm... One senses that a tragic tale lies behind this wish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000824,
					"content": "So be it. This wish is not beyond one's power to grant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000825,
					"content": "But first, one must see some proof of your... faith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000826,
					"content": "...What's that supposed to mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "The way of the adepti cannot be grasped from words alone. One must seek... the profound truths that lie beyond them... Should you fail to perceive one's hidden meaning, then regrettably, one may lend you no aid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000828,
					"content": "What do we do? Paimon doesn't understand him at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000829,
					"content": "I think he wants us to sweeten the deal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "Oh, that's right! Some of those believers mentioned that they had to pay a pretty sum for the adeptus' help, didn't they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000832,
					"content": "Well Paimon's not forking over any Mora, and we don't have anything valuable enough on us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000833,
					"content": "You don't even have a Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000834,
					"content": "I don't think people put Visions up for sale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "Hey! Why don't we make him a tasty snack? No one can resist the temptation of good food, can they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000837,
					"content": "No one who shares your values, for sure...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "Yep, a tasty snack is sure to work! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000840,
					"content": "Why don't we head over to Wanwen Bookhouse and see if they've got any new recipes in?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000838,
					"content": "Nom! Sounds good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "No need to rub it in...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "I think he wants some Mora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "I want power rivaling that of the gods.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "Indeed, a great many obstacles may be overcome given commensurate power. But one cannot but wonder — what grudge have you against the gods?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000821,
					"content": "I'd like to get rich quick!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#Now hold on a second! What about your {M#sister}{F#brother}!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000823,
					"content": "This is a common mortal sentiment. That you hail not from Liyue is manifest in your appearance, but one senses their materialistic influence upon you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111000811,
					"content": "Go on, take it off, lemme see...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "Hey! Isn't that a bit inappropriate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000813,
					"content": "Hm. Indeed, it would be inappropriate for one to remove one's mask.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "Starsnatcher"
				}
			]
		},
		{
			"id": 1110010,
			"completionStepIds": [
				1110010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110010",
							"2"
						],
						"stepId": 1110010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Starsnatcher"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111001001,
					"content": "Ahem. Hello! Allow us to introduce ourselves, this—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001002,
					"content": "Please, if you're here to thank me, there's no need. Cleansing the world of evil is the duty of the adepti. Think nothing of it — One certainly doesn't.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111001003,
					"content": "...Wait, who are you? One had assumed you were followers, but on closer inspection it seems that we have not met.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111001004,
					"content": "We're just travelers passing by.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#My name's Paimon! And this is my sidekick, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001006,
					"content": "One sees. One, too, shall introduce oneself, for it is good manners to comply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111001010,
					"content": "Ahem... The one before you is the adeptus, Master of Stars, though one is better known to one's followers as \"Starsnatcher.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111001011,
					"content": "One descended from one's mountain abode to cleanse the world of evil, whereupon fate saw fit that our paths should cross. Now... tell me that which you wish for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111001012,
					"content": "Our wishes? Paimon thought that the adepti in Liyue were just really good in battle... You mean you can grant people's wishes, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001013,
					"content": "Hah... There are different levels of adepti... Are not the stars loftier than the mountains, clouds, and moon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111001014,
					"content": "Yet, it is unbecoming of an adepti to boast of one's powers. One would have you first speak to one's followers, and only then make your verdict.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111001007,
					"content": "We are following the trail of the adepti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#My name's Paimon! And this is my sidekick, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001009,
					"content": "Then it is right that our paths coincide. I, too, shall introduce myself, for with good manners to comply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Starsnatcher"
				}
			]
		},
		{
			"id": 1110023,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
