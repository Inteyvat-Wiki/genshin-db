						],
						"stepId": 1110007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Starsnatcher"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111002301,
					"content": "Chat with them as you please. One will not beat one's own drum — the words of others shall ring truer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Starsnatcher"
				}
			]
		}
	]
}