			},
			"dialogs": [
				{
					"id": 741850301,
					"content": "Hey, this'll be your home from now on, Osse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850302,
					"content": "Meeeow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850303,
					"content": "Still, it feels a bit weird. Cassiodor should've already left here, right? So who is Osse now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850304,
					"content": "Is it the original cat that hadn't been indwelt by Cassiodor, or is it the Monsieur Os that shared all those adventures with us...? Ugh, Paimon's brain is cramping up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850305,
					"content": "Paimon, you're really not suited to thinking about stuff like this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "Paimon doesn't get it at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850309,
					"content": "Anyway, we've found a new home for Osse now, too! If we've got time, maybe we can come play with him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850310,
					"content": "Meow meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850307,
					"content": "\"Osse\" is \"Osse.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "Though Paimon still doesn't get it, it does make a certain kind of sense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}