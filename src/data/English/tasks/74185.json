				]
			},
			"dialogs": [
				{
					"id": 741850101,
					"content": "Este, we're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Oh, if it isn't... Wait, no. Who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850103,
					"content": "#Huh? You can't have forgotten us already! We're {NICKNAME} and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} and Paimon... I have indeed heard tell of these names, but I could've sworn I heard them in a dream!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850105,
					"content": "Uh... But you were definitely awake then, Este! Also, while we were below, didn't we even see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "*sigh* I dreamed that everyone in town was petrified, turned into statues of stone, leaving me utterly helpless and alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850107,
					"content": "Until finally, two brave heroes came and shouldered the burden of rescuing everyone... Could it be, that it was no dream at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850108,
					"content": "Maybe, maybe not.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Yeah. After all, everyone's back to normal now, aren't they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "But it seems as though everyone had some very strange dreams indeed. Just what happened? Could we all have been hypnotized en masse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850112,
					"content": "It would take us ages to explain it all properly... Just forget about the hypnosis thing for now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Oh? Speaking of hypnosis, you two even brought over a cat! It looks quite intelligent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850114,
					"content": "He's even smarter than he looks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "And moreover, he's our companion! But unfortunately, we can't take him with us on our journey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Well now, isn't that a coincidence? Our club just happens to have an open bed for cats available. It's been unoccupied ever since that hypnosis researcher went a-traveling and took his cat with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850119,
					"content": "If you two don't mind, leave him here with us. We'll take care of him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850120,
					"content": "Though I can't quite put my finger on it, I feel like we're bound up together, almost as if by fate. I'll help you take very good care of him indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850121,
					"content": "The cattery is on the other side of the building. Just walk over and you'll see it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741850116,
					"content": "He's our companion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "That's true, but we still can't take him with us on our journey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "That's not important.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
