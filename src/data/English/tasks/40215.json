			"dialogs": [
				{
					"id": 766530401,
					"content": "You're finally here. You didn't forget about this rare outsourced work opportunity now, did you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530402
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530402,
					"content": "Wait, hold on. Which order's yours again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530403
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530403,
					"content": "...I'm Gaudenty, expatriate representative from the Kuuvahki Experimental Design Bureau. That should be enough to jog your memory, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530404
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530404,
					"content": "Too long, didn't hear. Gimme the deets of your order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530405
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530405,
					"content": "You...! Tch, I'll only say it once more. Recently, a batch of out-of-control recon bots flew out of the Design Bureau, and it's my job to retrieve the wandering units.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530406
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530406,
					"content": "But the robots tend to fly rather high, and handling them alone will prove a tall order. That's why I offered you this opportunity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530407
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530407,
					"content": "Honestly, you can either retrieve them or destroy them on the spot. Our goal is simply to prevent them from falling into outsiders' hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530408
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530408,
					"content": "Oh, that one! Yeah, those recon bots can go really, REALLY high, and most ordinary people can't even touch them. But that's why I mastered a way to simply make the Moonlanes we need to get up there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530409,
					"content": "#You can get the kuuhenki to help out, right, {NICKNAME}? Let's test and see if they can use our Moonlanes and help us take down those recon bots!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530410
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530410,
					"content": "#No problem! Just leave it to {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530411,
						766530412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530411,
					"content": "No problem indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				},
				{
					"id": 766530413,
					"content": "Oh, right. I'm not going to pay you in Mora. You can take the components of the recon bots as compensation instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530414
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530414,
					"content": "This was stipulated in my order when I placed it, and I don't take retractions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530415
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530415,
					"content": "...You're giving us spare parts for payment? Didn't you just say the robots weren't supposed to fall into outsiders' hands?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530416,
					"content": "Which is why this is a rare and valuable opportunity for you! If everything goes well, I don't mind turning a blind eye as thanks for your hard work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530417
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530417,
					"content": "That's strange. It just sounds like you don't want to pay us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530418,
					"content": "Well, Mora or no Mora, doesn't matter to me. I want those parts, though. I'm thinking of using them for my future research projects...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530419
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530419,
					"content": "Well, since you're okay with it, Aino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530412,
					"content": "Sounds a little tricky...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				}
			]
		}
	]
}