			"dialogs": [
				{
					"id": 761840301,
					"content": "Not bad, these tea parties, all in all. If I'd known they were this much fun, I would've attended one sooner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840302,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "Alright, see you next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840303,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				}
			]
		}
