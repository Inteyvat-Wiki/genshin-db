			"dialogs": [
				{
					"id": 761840101,
					"content": "Well, this is one for the books. Never thought I'd see the day when you'd invite me to one of your tea parties, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840102,
					"content": "Perhaps if you'd worked on your etiquette, I would have invited you over sooner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840103,
					"content": "I agree. It might also help your case if you stopped challenging people to duels all the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761840104,
					"content": "Heh. You sound exactly like my big brothers and sisters. I can't help it. Back when my master was training me in the wild, etiquette wasn't exactly a priority.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840105,
					"content": "Forget it. It's not often we manage to get together. Let's just relax and enjoy the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840106,
					"content": "Hmm. Is this your latest creation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840107,
					"content": "Her name is Fagio. It stands for \"Facilitatrice Automatisee Generaliste Interactive et Omnitache.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840108,
					"content": "Does this mean Pulonia is really beyond repair...? I'm sorry to hear that, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840109,
					"content": "It's fine, I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840110,
					"content": "...I'm sorry to hear that I'll never get the chance to fight him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840111,
					"content": "Of course you are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840112,
					"content": "Pulonia looked strong, but this \"Fagio\" on the other hand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840113,
					"content": "...Were you about to say she looks weak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840114,
					"content": "Uhm... Haha, no, no. It's just that she doesn't look quite as strong as Pulonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840115,
					"content": "Hmph. Pulonia was built for measurements and calculations. I was careful not to compromise his processing power when giving him combat capabilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840116,
					"content": "But Fagio doesn't need to process complex formulas. All of her computing power can be devoted to her combat module.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840117,
					"content": "So... That means she's actually stronger than Pulonia? Is that even possible...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840118,
					"content": "You really won't be satisfied without a demonstration, will you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840119,
					"content": "Just so we're clear, I'm not paying for any repairs if I break her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840120,
					"content": "And I won't be paying your hospital bill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840121,
					"content": "(*sigh*... I knew this would happen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "The Knave"
				},
				{
					"id": 761840122,
					"content": "(*nom nom*...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
