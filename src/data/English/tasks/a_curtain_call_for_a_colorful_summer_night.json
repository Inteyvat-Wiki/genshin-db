			},
			"dialogs": [
				{
					"id": 150450401,
					"content": "#Morning {NICKNAME}, morning Paimon! Thought I'd come over and say hi, puffer floaters and all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "Morning, Mualani! How are you so full of energy? Weren't you the one partying the hardest last night!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "That was last night! I got a good night's sleep, and now I'm good as new!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Here, take this. It's your prize for completing the album — I picked yours up too, to save you the trip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "Wow! Thanks, Mualani! That was so nice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "When it comes to helping people, a good guide always thinks one step ahead, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "Oh, and speaking of work, I guess our vacation's almost over, huh... Probably for the best. If I don't head back soon, I'm worried my little doggie won't even remember me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "And after talking to the others, it seems like everyone is just about ready to get back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Some are missing their families, others are going through Dandelion Wine withdrawal, I guess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Even Chasca seems to be feeling it. Not that she'd ever admit it, but I have noticed her gazing back towards the Flower-Feather Clan at night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "I completely understand...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "But summer's not over yet! So I say... we squeeze a few more unforgettable moments into the time we've got left!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "Like another group photo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "Hey, how about taking one right here? After all this time, Paimon's grown kind of attached to this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "Great idea! Why don't you spruce up this wall, and I'll go gather the others. See you over at the plaza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
