					"nextDialogs": [
						4860708
					]
				},
				{
					"id": 4860708,
					"content": "...Behold, the Dandelion Knight herself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860709
					]
				},
				{
					"id": 4860709,
					"content": "Oh! It's our Honorary Knight. Sorry, I must have been daydreaming.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860710
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860710,
					"content": "How can I assist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860711
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860711,
					"content": "Actually, it's not us who need your help. It's a bunch of other people...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860712,
					"content": "I see. Well, thank you for your service to the people of Mondstadt. *cough*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860713,
					"content": "I have made a note of these commissions in my files and I will... make arrangements...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860714,
					"content": "...accordingly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860715
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 4860715,
					"content": "Great.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860716,
					"content": "We didn't miss out anyone's commissions, did we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860717,
					"content": "Sara's hilichurls, Charles' tax return, Margaret's cat... Seems that's everything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860718,
					"content": "We'll be on our way then, Jean— Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860719,
					"content": "Jean! Are you okay!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
