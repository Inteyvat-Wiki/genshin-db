			"dialogs": [
				{
					"id": 4860501,
					"content": "Hey, you two!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860502
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860502,
					"content": "Margaret! What are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860503,
					"content": "My cat's gone missing. Have you seen it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860504
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860504,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860505
					]
				},
				{
					"id": 4860505,
					"content": "You mean... Diona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860506
					]
				},
				{
					"id": 4860506,
					"content": "No, not her. I imagine Diona's probably still in the tavern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860507
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860507,
					"content": "I mean little Princey. Prince was just home, now he's gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860508
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860508,
					"content": "Did you seriously think Diona was a house cat!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860509,
					"content": "This is a bit worrying. What if Prince can't find his way home?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860510
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860510,
					"content": "I would love to help, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860511
					]
				},
				{
					"id": 4860511,
					"content": "But we are on our way to an urgent meeting with Jean. Sorry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860512,
					"content": "I guess we can have a look for your cat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860513
					]
				},
				{
					"id": 4860513,
					"content": "#Naw, {NICKNAME}. You're always such a big softie. But aren't we in the middle of something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860514,
					"content": "Sara and Charles need our help urgently, too. Let's go and see Jean first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860515,
					"content": "You're on the way to see Jean? What a coincidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860516
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860516,
					"content": "Paimon thought you were looking for a cat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860517,
					"content": "Yes, I wanted to see if Jean could help look for my cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860518
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860518,
					"content": "Seriously? You want Jean... to help you look for your cat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860519,
					"content": "What's wrong with that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860520
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860520,
					"content": "Jean's a really nice person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860521
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860521,
					"content": "Such a solid line of reasoning...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860522
					]
				},
				{
					"id": 4860522,
					"content": "I feel like this is a classic case of \"good people finish last.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860523
					]
				},
				{
					"id": 4860523,
					"content": "Please mention it to Jean for me. I'll treat you to a brew at Cat's Tail later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860524
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860524,
					"content": "Hey, HEY!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860525,
					"content": "Ugh, unbelievable! Guess the case of Prince the missing cat is now added to the agenda for our meeting with Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
