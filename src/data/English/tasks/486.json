			"dialogs": [
				{
					"id": 4860801,
					"content": "How's Jean holding up? Is it serious?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860802,
					"content": "It's just burnout from work stress. She'll be fine after a good old rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860803
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860803,
					"content": "Thanks for bringing her here — she may have tried to keep soldiering on otherwise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860804
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860804,
					"content": "It's not a surprise though, she does have a lot to get through every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860805,
					"content": "Poor Jean. She has always been one to push herself too hard while overlooking her own needs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860806
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860806,
					"content": "This isn't the first time something like this has happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860807
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860807,
					"content": "She really has it tough doesn't she. Poor Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860808
					]
				},
				{
					"id": 4860808,
					"content": "Seems like you really care about Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860809
					]
				},
				{
					"id": 4860809,
					"content": "Oh, ah... You think so? I—I mean, she's the Acting Grand Master and all, we can't have her collapsing all the time now can we...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860810
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860810,
					"content": "S—So y'know, it's not like this is a personal... thing, it's just out of love for— concern for... the greater good! Yes, that's it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860811
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860811,
					"content": "What's up with Barbara... Weird~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860812,
					"content": "#...Anyway, you're an honorary knight, aren't you {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860813
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860813,
					"content": "While the Master is down, the knights should share her burden, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860814
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860814,
					"content": "That's a very good point, but... Shouldn't one of the fully-qualified knights do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860815,
					"content": "Jean has so much to do, an extra pair of hands can't hurt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860816
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860816,
					"content": "You should go and check in at the <color=#00E1FFFF>headquarters</color>. Jean will be fine with just me here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860817
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860817,
					"content": "Paimon feels like she's trying to get rid of us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860818,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860819
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 4860819,
					"content": "#Nothing! We'll leave you to it — come on {NICKNAME}, let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
