			"dialogs": [
				{
					"id": 4861001,
					"content": "Oh, it's Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861002,
					"content": "I've been waiting for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861003,
					"content": "I have been informed about Jean falling ill. On behalf of all of the Knights of Favonius, allow me to express my sincere gratitude for your assistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861004,
					"content": "So courteous and polite. This isn't the Kaeya Paimon knows.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861005,
					"content": "Haha... Well, the circumstances warrant it. This is the Acting Grand Master herself we're talking about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861006,
					"content": "Now, in addition to that thank-you message, there was one other thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861007,
					"content": "You have a job for us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "It's like you read my mind! We have quite a connection, don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861009,
					"content": "Is this the part where you give us our reward?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "Hahaha. I must say I like your style.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861011,
					"content": "But before we can discuss a reward, there are some things I hope you can assist the Knights with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861012,
					"content": "Things like helping to fill in for Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861013,
					"content": "Right. Although the commissions you reported to Jean have already been handed off to someone else...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861014,
					"content": "...I am concerned that they will not be handled with due care without Jean's personal touch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861015,
					"content": "So I am hoping that you can help out where you see fit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861016,
					"content": "I will feel much more at ease knowing that the Honorary Knight is personally overseeing these cases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861017,
					"content": "#You can flatter {NICKNAME} all you want, but answer me this — why don't YOU do it!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861018,
					"content": "Haha... Oh, I have far more important matters to attend to. There are so many things to... to prepare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861019,
					"content": "Hmph. Fine then. So it's <color=#00E1FFFF>Sara, Charles and Margaret's</color> stuff you want us to help with, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861020,
					"content": "Those are the ones. I appreciate the help. See you later!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
