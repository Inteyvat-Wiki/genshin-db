							304.669,
							1490.06
						],
						"pointId": 7484
					}
				]
			},
			"dialogs": [
				{
					"id": 711140901,
					"content": "*sigh* Maybe we should've grabbed the Qiaoying Village shots first after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140902,
					"content": "Is everything okay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#Ah, {NICKNAME}, Paimon! Thanks to you, we were able to save all of our stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140905,
					"content": "I suppose, though, that if we were to ever return to that area in the future, we shall have to bring a few adventurers with us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140906,
					"content": "So, um, about your feature film on tea... How is the shooting for that going?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "Well... We've currently got...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140908,
					"content": "A good opening sequence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "And a good artistic vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "So... you haven't shot much at all!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "Well, you see... We're currently a little short on money. As a master filmmaker, Mr. Geisert's tuition doesn't exactly come cheap...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140912,
					"content": "Even though we've already shot a few smaller films, and made some Mora from that, a feature film of this length just burns through your budget as if it's nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140913,
					"content": "Especially since Boss also turned down a few potential sponsors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "And refused many invitations to collaborate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "Hey, what do you two know!? This was all so that we can create an excellent film that reflects our standards and our vision!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140916,
					"content": "But Boss... Didn't we start this film company because we wanted to make money...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "I... Stop worrying about that for now! Just go and set up the equipment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, this is your reward. Thank you for always lending me your support.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140919,
					"content": "Once I've made the film of my dreams, I'll be sure to invite you over for the premiere, and then also take you out for tea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng, Xingye, make sure you get the best angle for our lighting! We're gonna get this in one take, you hear me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140921,
					"content": "But Boss, we don't even have any actors here with us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "Isn't it all up to chance whether or not we can grab a scenery shot in one take...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "J—Just hurry up and set up the equipment! And then wait here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 711140903,
					"content": "Looks like you didn't lose any equipment, at least.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
