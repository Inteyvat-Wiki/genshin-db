						742230402
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230402,
					"content": "Truly splendid. Have you previously served in our God King's armies, by any chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230404,
					"content": "Our fine officer also praises your performance! It seems I must work harder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				}
			]
		},
