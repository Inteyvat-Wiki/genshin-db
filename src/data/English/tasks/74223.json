			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "A hundred and thirty-six... Alright, fourteen more times, and we'll take a break!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230202,
					"content": "Do you need a hand?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "A hand? No, no need. What training requires the assistance of another?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230204,
					"content": "Only by honing my physique can I join Legion Athanatoi as one of its sublime soldiers, just like this officer here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230206,
					"content": "Ah yes, introductions are in order! This is my instructor. Only by clearing the tests he sets can I earn the right to ascend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230207,
					"content": "Um, isn't this just a statue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "What are you saying, citizen? Are not all Remurians this way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230209,
					"content": "In any case, would you like to have a go? The initial test involves the simultaneous smashing of these stone pillars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230213,
					"content": "Don't underestimate them, however! Even with all my training, I can only shatter one with a single punch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230210,
					"content": "Tests? What tests?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Combat tests, naturally. An ascendant, immortal form is one thing, but combat skills must be honed of one's own accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230212,
					"content": "In any case, would you like to have a go? The initial test involves the simultaneous smashing of these stone pillars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				}
			]
		},
