			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Siegfria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "Bless you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520302,
					"content": "Piece of cake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520303,
					"content": "So, the hilichurls have been starting to flex their muscles on the back of the wolf scare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520304,
					"content": "That's right. But I must say, if you think the Hilichurls are a nasty lot, the wolves are even worse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520305,
					"content": "They... they attacked Springvale this morning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520306,
					"content": "Springvale!? That's crazy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520307,
					"content": "It's unheard of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520308,
					"content": "I thought I would take my chances on the road after the wolves had their fun... I never thought the hilichurls would show up too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520309,
					"content": "We should head there soon and see how bad the situation is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520310,
					"content": "But first things first, you should assess the damage to your cart. Does it still work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520311,
					"content": "I'll take a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
