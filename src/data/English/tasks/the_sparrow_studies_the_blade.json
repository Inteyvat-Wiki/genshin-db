			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Little Que'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010101,
					"content": "Halt, friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010102,
					"content": "I can tell from the confidence in your posture and the flight in your footsteps that we three are kindred spirits, practitioners of the martial arts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270102,
			"completionStepIds": [
				2270101,
				2270106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270101",
							"2"
						],
						"stepId": 2270101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "What do you want?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "Hey! Show him a little more respect when you're talking to him, got it!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010203,
					"content": "Please, there's no need... it was actually me who started the conversation with them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "Hmph! Well, just as long as they aren't another good-for-nothing bandwagoning adepti-seeker trying to steal our place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010205,
					"content": "Yes, great, thank you for your concern... I think we'll be fine... Now, why don't you take a well-earned rest while I have a word with our new friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "But, but surely there's nothing you would say to them that you couldn't say in front of me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010207,
					"content": "I'd only bore you, it's really nothing you'd be interested in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "Hmph, okay, I get the hint, you wanna talk about the Guhua Clan, again... Fine. If you don't want me to listen, I will leave you well alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 227010209,
					"content": "My friend, over here if you will join me. Then we may talk in depth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270103,
