					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050701,
					"content": "Hey there, we meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050702
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050702,
					"content": "Kito doesn't feel like talking much today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050703,
						722050704
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050703,
					"content": "Is something wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				},
				{
					"id": 722050705,
					"content": "It's... It's nothing. I'll play by myself today. Don't worry about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050706
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050706,
					"content": "Well, would you look at that. He's sulking all by himself again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050707,
						722050708
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050707,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050709,
					"content": "C'mon, Kito, no need to get mad at an outsider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050710
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050711
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050711,
					"content": "...Sorry. I shouldn't have been mad at you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050712,
						722050713
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050712,
					"content": "It's all good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050714,
					"content": "The golden man's bugging us to board the boat again... He talked about going to a shining golden place where there's no fog! I don't wanna go there! I wanna stay with Granny Una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050715
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050715,
					"content": "He doesn't play with us, and he never has anything interesting to say... He just keeps telling us to leave! He's so scary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050716
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050716,
					"content": "It's not as if we're not good at leaving or anything! We're just afraid that Granny Una will worry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050713,
					"content": "Would you tell me what happened at least?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050708,
					"content": "Anything I can help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050704,
					"content": "You don't look all that happy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				}
			]
		},
