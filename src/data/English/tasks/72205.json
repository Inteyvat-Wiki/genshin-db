						],
						"stepId": 7220513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "Looks like we meet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050502,
					"content": "Hello again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050503,
					"content": "And hello to you too!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "Yup, still here! By the way, do you know what this big rock is used for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050506,
					"content": "Hehe! Kito knows everything, don'cha know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050507,
					"content": "I don't know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "I've heard Grandpa Mata say that this is a tombstone used to guide the spirits of the deceased. Lost, lingering spirits will be attracted to these big rocks, and so they'll wake up here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050510,
					"content": "And after they do, they'll wander the island looking for someone who can fulfill their wishes. Once they find that person, they'll grab onto them until their wishes are fulfilled and they can finally be taken away by the boatman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050511,
					"content": "Some of those spirits are nice... and some of them aren't that nice. And that's why those who pass by these big stones in the night have to loudly declare their name and clan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050512,
					"content": "After all, those who know who their ancestors can have way more confidence than some lonesome ghosts. Once they hear where you've come from, they'll slink off quietly and not bother you anymore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050513,
					"content": "Uh... Trouble is, you're an outsider, aren't you? I don't think you'll have any clan to announce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050514,
					"content": "Uh oh, that's true. What'll you do if you encounter a bad spirit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050515,
					"content": "...Hehe, you know what? It'll be fine, 'cuz I'll protect you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050516,
					"content": "Right! That's right! I'll help scare those bad sprits away, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050508,
					"content": "What is it used for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "Still here, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
		{
			"id": 7220507,
			"completionStepIds": [
				7220514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
