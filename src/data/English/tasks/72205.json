					"nextDialogs": [
						722050903,
						722050904
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050903,
					"content": "Why hey there, Kito, Kina!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050905
					]
				},
				{
					"id": 722050905,
					"content": "Thank you, but we won't need anything this time. We're leaving soon... We're going to the land without fog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050906
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050906,
					"content": "We're gonna go see the big, shiny, golden house, and we're gonna ride on a boat to get there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050907
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050907,
					"content": "But before we go, we still need to thank you... Also, could you please pass this to Granny Una for us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050908
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050908,
					"content": "Place this in her hand, and she'll stop worrying and come with us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050909
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050909,
					"content": "We're counting on you one last time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050910
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050910,
					"content": "Thank you so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
