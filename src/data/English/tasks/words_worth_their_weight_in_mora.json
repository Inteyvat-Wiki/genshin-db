			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uncle Tian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050501,
					"content": "What can I do for you, youngster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "Uncle Tian"
				},
				{
					"id": 718050502,
					"content": "Here's the order you placed with Jifang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "The what now? ...Oh, ah yes. I believe I ordered a copy of the Verses of Equilibrium at the Wanwen Bookhouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Uncle Tian"
				},
				{
					"id": 718050504,
					"content": "Indeed, indeed, this is the book that I wanted. Haha, I was beginning to think that Jifang might have forgotten about my order, what with the other customers and all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Uncle Tian"
				},
				{
					"id": 718050505,
					"content": "But it's here now, and that's good. The binding is fairly good as well. Conscientious as always, that Jifang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Uncle Tian"
				},
				{
					"id": 718050506,
					"content": "Thank you, youngster. I'll take this with me, now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uncle Tian"
				}
			]
		},
		{
			"id": 7180506,
