				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050601,
					"content": "So, about those two books...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050602
					]
				},
				{
					"id": 718050602,
					"content": "Have you delivered them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050603
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050603,
					"content": "Yes, I have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "Thank you. Wanwen Bookhouse has managed to stay open all this time due to the support of our long-time customers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050605,
					"content": "What's more, these customers are true lovers of books. It should gladden them greatly to receive good ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050606,
					"content": "Thanks so much for your help, Traveler. Please take this as compensation for your efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050607,
					"content": "If you should ever wish to purchase any books, feel free to approach me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
