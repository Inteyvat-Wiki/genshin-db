			"dialogs": [
				{
					"id": 718050701,
					"content": "So, about those two books...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050702
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050702,
					"content": "The two of them are long-time customers of ours. I usually prepare their books beforehand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050703
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050703,
					"content": "But I ended up dragging my feet a little this time due to the surge in business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050704
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050704,
					"content": "They must have gotten impatient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
