			"trigger": {
				"objectNames": [
					"Gentry De'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050401,
					"content": "What is it, youngster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "Gentry De'an"
				},
				{
					"id": 718050402,
					"content": "Here's the order you placed with Jifang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "The fourth volume of Rex Incognito? I placed this order eons ago. Why has it tarried till now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Gentry De'an"
				},
				{
					"id": 718050404,
					"content": "Let me see. Huh? A first edition? Why, no wonder it took so long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Gentry De'an"
				},
				{
					"id": 718050405,
					"content": "To think I'd assumed that Jifang had forgotten about my book amid all the other customers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Gentry De'an"
				},
				{
					"id": 718050406,
					"content": "Thank you for delivering this book to me, youngster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gentry De'an"
				}
			]
		},
		{
			"id": 7180505,
			"completionStepIds": [
				7180503
			],
