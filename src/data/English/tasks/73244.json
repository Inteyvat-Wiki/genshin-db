				7324417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324417",
							"2"
						],
						"stepId": 7324417,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324406",
							"3"
						],
						"stepId": 7324406,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fatui Negotiator"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441701,
					"content": "P—Please stop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441702,
					"content": "Please have mercy... We're gonna get killed if you keep this up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441703,
					"content": "Sure sounds convincing coming from the one who's been beaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441704,
					"content": "Talk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441705,
					"content": "Spit it out!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "Y—Yes, I'll tell you everything! Anything you want to know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441707,
					"content": "Then start with what you know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441708,
					"content": "W—We always had dealings with Aderfi... A—And it sounded like the Matriarch of the Tanit had a bias for Azariq... and the new girl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441709,
					"content": "And I don't know why, but it seems like Azariq has gone missing too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441710,
					"content": "That woman is cruel. She considers everyone who's no longer of any value to the tribe an eyesore... so Aderfi contacted us in order to maintain his status.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441711,
					"content": "Our business in the desert area never went according to plan, until... until we struck the deal with Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441712,
					"content": "No longer of any value... What does that mean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "I don't know... I really don't! That has to do with the internal workings of the desert folks... But if I had to guess, it might've been because she thought we were no longer trustworthy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441714,
					"content": "...And so she began to keep her distance, and Aderfi, who had been in frequent contact with us, was very distressed because of that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441715,
					"content": "After all, we can always leave this wretched place when needed. Aderfi, on the other hand, will be used by the tribe until he's no longer 'of value'. His life is virtually in their hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441724,
					"content": "But he was extremely cunning. He somehow made us fulfill his every request, while we, on the other hand, never heard anything of the items we asked for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441725,
					"content": "And now the rumors say he's gotten himself in trouble... We weren't sure what exactly happened, but we saw it as a window of opportunity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441726,
					"content": "An opportunity for what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441727,
					"content": "We assumed that there wouldn't be many opportunities for us to trade with Aderfi in the future, so we asked him to bring the special Primal Construct he mentioned in his letters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441728,
					"content": "If we could get a hold of that Primal Construct before we left this place for good, we would've still gained something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441729,
					"content": "Huh, so you're here to steal stuff too? No wonder we couldn't find any goods OR the Energy Transformation Capacitors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441730,
					"content": "Hold on... Did you just say \"too\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441731,
					"content": "Yep. Now hand over the Capacitors.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "Argh... Don't tell Paimon the Energy Transformation Capacitors are all made up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441734,
					"content": "No. The Energy Transformation Capacitors are very real, and there's a whole batch of them. They seem to be ancient relics, so we're not sure if any of them are still functional...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441735,
					"content": "Tell us where these Energy Transformation Capacitors are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441736,
					"content": "Keep up the imposing tone, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#Hehe, Paimon will! ...Hey, {NICKNAME}, don't change the subject!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441738,
					"content": "Speak up! Tell us where the Capacitors are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441739,
					"content": "...They're at a camp not far away from here. Here's the key to its entrance... I've told you everything I know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441740,
					"content": "Then get moving!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "Alright, alright, I'll make myself scarce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441741,
					"content": "Don't get in our way ever again!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "It's bad luck you ran into us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "This... business you're doing in the desert. What is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "...It's top secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441718,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#See, now {NICKNAME}'s mad! You wouldn't want to mess with {M#him}{F#her}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441720,
					"content": "Ugh...! Alright, alright! Please don't get mad, I'll tell! But it's... it's not like I know the full story...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441721,
					"content": "We were asked to investigate the current situation of various desert tribes. After infiltrating them through making business offers, we aimed to attract the Sages' attention... and ultimately work to the benefit of the Lord Harbinger in Sumeru City.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441722,
					"content": "Professor Froderock was looking for live specimens in the desert — he always defied The Doctor's orders... That's just pure jealousy, if you ask me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "Fatui Negotiator"
				},
				{
					"id": 732441723,
					"content": "Ahem, I've gone too far... Anyway, Aderfi had been our point of contact, and he was in charge of everything that had to do with trade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Fatui Negotiator"
				}
			]
		},
