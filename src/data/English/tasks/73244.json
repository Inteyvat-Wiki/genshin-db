			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "How... how could I forget...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440102,
					"content": "I hope it's not too late. We should at least search around his tent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440103,
					"content": "Jeht! ...What's going on? Are you going somewhere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440104,
					"content": "#Paimon and {NICKNAME}... You came just in time. There's something I gotta do right now... I need to go to Aderfi's place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440105,
					"content": "Aderfi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440106,
					"content": "Isn't he that traitor who made shady deals with the Fatui? ...Oh, Paimon knows! You wanna go see if there's any valuable stuff he left behind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440107,
					"content": "No, I'm not interested in his stuff at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440108,
					"content": "The tribe has its own rules on dealing with the belongings of traitors like Aderfi. Hmph... if it weren't for the rules, I would no doubt burn everything down the first chance I get.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440109,
					"content": "I'm going to his tent because...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440110,
					"content": "Because of Benben, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "Ohh! Oh no, Benben's still over there at Aderfi's place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440112,
					"content": "Jehhht... Why did you leave Benben with someone like him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440113,
					"content": "I—I didn't know he was a traitor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440114,
					"content": "Anyway, I need to check on Benben as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}, we should go with her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440116,
					"content": "Then let's not wait any longer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "Yeah... Paimon hopes Benben's okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440117,
					"content": "Let's get going right now!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324403",
							"2"
						],
						"stepId": 7324403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "Hey look, there's something over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440302,
					"content": "Doesn't look like investigation records to Paimon. It looks more like... a letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440303,
					"content": "A letter? Let's open it up and see what's written inside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440304,
					"content": "The letter says Benben simply ran out of energy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440305,
					"content": "Now that Paimon thinks about it, Benben opened the gates to the Mausoleum of King Deshret for us and activated our clearance... It really helped a lot during our journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440306,
					"content": "And even mechanical creatures like Benben get tired. Maybe it ran low on energy after doing so much for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440307,
					"content": "The letter mentioned something called Energy Transformation Capacitors, but I didn't see anything like that in the tent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440308,
					"content": "Could it be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440309,
					"content": "They might be hidden somewhere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "Doesn't look like it. If they were meant for repairing Benben, why would he try to hide them? Wouldn't it be more intuitive to use them right away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440311,
					"content": "Aha, I know! It must be because the transaction hasn't occurred yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440314,
					"content": "Aderfi didn't bring Benben to the transaction, so there shouldn't be any Energy Transformation Capacitors here anyway... There's only one question left: who did he strike the deal with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440315,
					"content": "Ha, that was a dumb question for me to ask. There's only one group outside the tribe he'll have dealings like this with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440316,
					"content": "Sumeru researchers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "It's the Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440320,
					"content": "What should we do now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440321,
					"content": "What else? There's no negotiating with the Fatui. We go to the transaction site and steal the Capacitors from them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440322,
					"content": "Woohoo! Let's go steal them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440323,
					"content": "But Benben... We can't carry it with us in its current state, so we can't take it to the transaction site...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440324,
					"content": "It isn't safe to leave it alone either. I don't wanna put it in a risky situation ever again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440325,
					"content": "#Paimon and {NICKNAME} will go raid the Fatui! You just wait here with Benben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440326,
					"content": "Yeah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "Yeah! Let's raid the Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440330,
					"content": "#I really wanna go myself, but... {NICKNAME}, Paimon, I'm counting on you to help Benben recover!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440331,
					"content": "And... even though they're just a bunch of Fatui, you should still be careful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440332,
					"content": "Don't worry! Just leave it to us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440333,
					"content": "I don't really wanna stay here in this traitor's tent with Benben though. I'll take it to my place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440334,
					"content": "Let's meet up in my tent after you retrieve the Capacitors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440328,
					"content": "Let's raid the Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "Yup yup! This won't be our first time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440318,
					"content": "The Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "Precisely. Who else could it be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440312,
					"content": "He might've never received them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "Ah, I know what you mean! The transaction hasn't even taken place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				}
			]
		},
		{
