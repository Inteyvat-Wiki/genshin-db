			"dialogs": [
				{
					"id": 732440801,
					"content": "Jeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440803,
					"content": "How was it? You didn't get into trouble, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440802
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440802,
					"content": "Everything went as smooth as it could! Look! We got the Energy Transformation Capacitors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7324410,
			"completionStepIds": [
				7324419
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324419",
							"2"
						],
						"stepId": 7324419,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht",
					"Benben"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "Look, it's Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441002,
					"content": "I'm glad Aderfi didn't get to take Benben away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441003,
					"content": "Or perhaps you could say that everything here looks exactly the same as before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441004,
					"content": "Did he really think he'd overturn the Matriarch and return to his tent safe and sound...? What a self-absorbed idiot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441005,
					"content": "But thanks to that, nothing bad happened to Benben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441006,
					"content": "You call this \"nothing bad\"? Ohh, poor Benben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441007,
					"content": "How did it come to this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "Yeah, why is it lying on the ground...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441010,
					"content": "Anyway, what happened to Benben? Everything seemed fine the last time we saw it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441011,
					"content": "After leaving Khaj-Nisut, Benben gradually grew weaker... It looked like its parts were malfunctioning, and the sound of its beeps was getting lower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441012,
					"content": "Then it couldn't make any sounds or move at all. It felt as if I was watching its life slowly drain out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441013,
					"content": "At that time, no one in the tribe knew what was going on with Benben except Aderfi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441014,
					"content": "So I left Benben in his care...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441015,
					"content": "Oh no... Is Benben gonna stay like this forever...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441016,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441017,
					"content": "At the very least, Benben's still here with us. I'm sure we'll find a way to fix it, sooner or later...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441018,
					"content": "But there's nothing we can work with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441019,
					"content": "Hmm, let me think. I remember Aderfi telling me that whatever's wrong with Benben, it's nothing too serious, and that it should be fixed within a few days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441020,
					"content": "Knowing him, if he performed some kind of investigation, he would've definitely left records behind. Let's have a look around the area!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441021,
					"content": "If it really was \"nothing too serious\", maybe we could even try fixing Benben ourselves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441008,
					"content": "What's wrong with Benben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
		},
