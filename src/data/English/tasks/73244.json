			"dialogs": [
				{
					"id": 732441901,
					"content": "Energy Transformation Capacitors... I hope Benben will recover once we get them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441902,
					"content": "If you're still unsure, I can go with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441903,
					"content": "You stay here with Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "Okay. I'll wait for your good news... Please stay safe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441904,
					"content": "We'll be back real quick.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
