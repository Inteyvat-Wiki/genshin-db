			"dialogs": [
				{
					"id": 732441504,
					"content": "Huh, so this is what Energy Transformation Capacitors look like... But how are we supposed to use them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441505
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441505,
					"content": "Beep... Beep-beep...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441506
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441506,
					"content": "Benben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441507
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441507,
					"content": "Benben connects to the Energy Transformation Capacitors and quickly extracts energy from them.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732441508
					]
				},
				{
					"id": 732441508,
					"content": "Beep-beep! Beep-beep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441509
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441509,
					"content": "Whoa! We resurrected Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441510,
					"content": "Silly Paimon. Benben just woke up from a long nap, that's all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441511
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441511,
					"content": "Beep... Bee-eep...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441512
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441512,
					"content": "Hey, I wasn't worried! I knew you'd recover, no matter what!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441513
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441513,
					"content": "Hmph. \"I don't wanna put it in a risky situation ever again...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441514,
					"content": "Don't parrot me, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441515
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441515,
					"content": "Beep-beeep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441516
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441516,
					"content": "#Oh, yeah! {NICKNAME}, Benben says thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441517
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441517,
					"content": "Even though Benben was lying still without saying anything, it knows everything you've done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441518
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441518,
					"content": "No need to thank me, Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441519
					]
				},
				{
					"id": 732441519,
					"content": "Beep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441520
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441520,
					"content": "Mm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441521
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441521,
					"content": "Is anything else the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441522,
					"content": "Even though Benben has woken up, it still looks like it could use some rest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441523
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441523,
					"content": "Right! Have a good rest, Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441524,
					"content": "Beep-beep...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benben"
				}
			]
		},
		{
			"id": 7324417,
