			"dialogs": [
				{
					"id": 790550101,
					"content": "This is a cut scene of the show \"Brokeboat Mountain\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790550102,
					"content": "Originally, the story showed two Hydro Eidolons on board a broken boat, floating along, who fall deeply in love.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790550103,
					"content": "After confessing their feelings for one another, they stand upon the prow of the boat illuminated by the afterglow of the sunset. The scene is extremely romantic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790550104,
					"content": "However, this scene was abandoned because... the two Hydro Eidolons acting the part were simply too energetic and couldn't stop moving for the big romantic scene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790550105,
					"content": "If only I could catch <color=#00E1FFFF>two of them on the prow of the boat at the same time</color>, the scene would be perfect...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790550106,
					"content": "— The Director",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scene Notes"
				}
			]
		},
