			"trigger": {
				"objectNames": [
					"Zhaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Listen, you've got the wrong guy... See, my master's name is Kanei, and I'm Zhaka... He's the one you want!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640402,
					"content": "There's no way I can make dolls as good as my master...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640403,
					"content": "You were kidnapped?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "Huh? Wait, you're not with them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640405,
					"content": "Of course not! Didn't you see us kick their butts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640406,
					"content": "Really? That's great! So, I'm finally free?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640407,
					"content": "You sure are! You can go home now. But... what was all this about anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640408,
					"content": "Those guys just showed up out of nowhere, trying to make counterfeit versions of the dolls sold at the resort. But they're awful at it, so they tried to kidnap my master, Kanei, and force him to help them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640409,
					"content": "Except something went wrong and they grabbed me instead... Oh man, I've only been learning how to paint for three days... There's no way I'm qualified...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640410,
					"content": "Anyway, thank you so much for saving me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640411,
					"content": "Azhka, let's go home!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640412,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azhka"
				}
			]
		}
	]
