			},
			"dialogs": [
				{
					"id": 750290101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290102,
					"content": "Hello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290105,
					"content": "Eek, you almost scared Paimon to death!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290106,
					"content": "I take it you're here for the special training too!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290107,
					"content": "I knew it, I just knew it! Be they human or Saurian, ambitious warriors are always drawn to one another!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290108,
					"content": "Well then, without any further ado, let's dive straight into the special training!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290109,
					"content": "So they have that here too, huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "We haven't even said a word! What makes you think we're here for your special training?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290112,
					"content": "But the way you say it... You're not some kind of Master Trainer, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290113,
					"content": "Not just anyone can become a Master Trainer, you know. I'm not that gifted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290114,
					"content": "But wait, you mean... You didn't fly all the way up here to get special warrior training from me, Matahga!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "Matahga",
					"speakerSubtitle": "Warrior Reserve of the Flower-Feather Clan"
				},
				{
					"id": 750290115,
					"content": "We're just passing through.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "Flying atop a Saurian mount shows that you've got the basics down, but such a lack of ambition... What a waste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290118,
					"content": "I thought you were a like-minded warrior... Such a pity!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290119,
					"content": "Looks like I misjudged you... Honestly, how could I!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290120,
					"content": "Should Paimon be saying that Natlan truly is a nation of heroes, or that its people are just overly hot-blooded? Even the kids are so fired up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290121,
					"content": "Kids? Surely not...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "It's the exact opposite! Laziness is no excuse once you've decided to become a warrior! Those who lack courage, determination, and ambition will never succeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290124,
					"content": "And I'm twelve now! I stopped being a kid the moment I hit double digits... But I forgive you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290125,
					"content": "Sure, my height hasn't budged, no matter how much milk I've drunk, but my willpower? It's unbreakable, and strong enough to smash through any obstacle in my way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290126,
					"content": "Besides, I'm still growing, and it's not like you two are that tall either!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290127,
					"content": "S—Such energy! But why did you drag us into this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290128,
					"content": "Hmph! I admit that a person's physical strength depends on their physique, but a true warrior would never let that become a limitation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290129,
					"content": "It's mind over matter, any day of the week... And that takes faith and belief in your own dreams and ambition!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290130,
					"content": "Even adventurers should be able to grasp such simple truths!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290131,
					"content": "What he said makes sense, but... It almost sounded to Paimon like he was... having a go at us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290132,
					"content": "Yeah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "I was explaining the necessity of ambition for lazybones like you. You'll never be a real hero if you're always so laid back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290135,
					"content": "As a warrior... No, as a person... Without ambition and hard work on the training grounds, you're nothing but a failure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290136,
					"content": "If you can't soar through the skies like a hero, or receive the Master Trainers' recognition, then you're nothing but a failure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290137,
					"content": "So you must train hard! Capiche!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290138,
					"content": "C—Capiche! Uhh... What do we do now? He's so loud, and everything he says is so reasonable, that it's impossible for Paimon to argue back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290139,
					"content": "Good! If you're ready to hone your skills, come see me for some special training! Your goal is to fly your Saurian at full speed along the course and score as highly as you can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290140,
					"content": "During training, I will observe and score performances at every checkpoint. The final results will be divided into four tiers based on these scores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290141,
					"content": "Fly as fast as you can! Even if you can't make the highest tier, at the very least, you must reach the second highest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290142,
					"content": "Now, it's time to fire yourselves up, and try not to let my shadow leave you biting the dust! Go, go, go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290143,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290144,
					"content": "Warrior, I await your reply!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290145,
					"content": "C—Capiche!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "I can't hear you, you'll have to SPEAK UP!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290147,
					"content": "CAPICHE!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "This is where aspiring warriors come to hone their skills. Now, show me your resolve, and never stop pushing your limits!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290149,
					"content": "Come see me for some training when you're ready!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290150,
					"content": "Capiche! But I'd rather not!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "What? You still refuse to shake off your laziness!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290152,
					"content": "What a sorry state of affairs! But no matter. A day will come when you will no longer be able to tolerate your failures!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290153,
					"content": "Endless shirking and constant cowering will get you nowhere, and leave you with nothing! Only by pushing forward can you hope to stand tall and make the world resound with your booming laugh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290154,
					"content": "Hmph, mark my words! But even when that time comes, it won't be too late to come hone yourselves here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290133,
					"content": "Why are you having a go at us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "That's a bit extreme, kid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "Never underestimate an adventurer's curiosity.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "What do you mean by \"special training\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "Hello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
			"id": 7502902,
			"completionStepIds": [
				7502904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502904",
							"2"
						],
						"stepId": 7502904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "Wonderful, outstanding! You've surpassed me, outdone me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290202,
					"content": "I've been keeping up with my special training, all by myself, in the hope that I would one day succeed at breaking my own record. Unfortunately, that's something I still haven't managed to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290203,
					"content": "But you did it! You've proven to me that I should leave this place, as there must be many more warriors out there in the world whose deeds eclipse my own!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290204,
					"content": "I'll surely be able to improve myself by sparring and exchanging pointers with them. Some day, my father and sister will acknowledge my accomplishments — just you wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290205,
					"content": "Acomitl aside, of course. That layabout has zero ambition. I'm ashamed to call him my brother.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290206,
					"content": "Acomitl...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "Uh, never mind. That's enough chit-chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290208,
					"content": "Warrior, hear me now! Never stop honing your skills!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290209,
					"content": "If you want to become a legend, you must charge forward with all your might! Forward, hear me, forward! These words are my parting gift to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502906",
							"2"
						],
						"stepId": 7502906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "Warrior! How is your training on this course?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290502,
					"content": "I'm making progress.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "Pah, weak! If you're not taking a step forward, then it's a step back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290506,
					"content": "Ugh, how should Paimon put this... It seems like \"forward\" and its synonyms are the only words in Matahga's dictionary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290507,
					"content": "Indeed, I am more focused than others! Know why? Because hard work is the only thing I acknowledge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290508,
					"content": "You need training, and so do I. Training to work with Saurians alone won't make me an all-round warrior!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290509,
					"content": "I must seek a larger stage to hone myself! And that means I'll be leaving for some time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290510,
					"content": "Don't worry! I'll keep the course here intact, but I'll be dismantling this cabin and taking it with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290511,
					"content": "Where will you go?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "Oh... To see my father and sister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290515,
					"content": "Huh? Matahga doesn't sound as confident as before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290516,
					"content": "What's wrong with that? Loving and respecting your family is a virtue that every warrior should uphold! Don't be so narrow-minded!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290517,
					"content": "My father's the most professional Master Trainer in the whole of the Flower-Feather Clan, and my sister's the best Saurian rider! I'm proud of them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290518,
					"content": "Hey, c'mon! Paimon didn't mean to question their judgment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290519,
					"content": "I see. Good luck then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "Good luck to you too, Warrior! The words I shall leave you with this time are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290521,
					"content": "Let me think... Never give up! Become a hero, no matter the cost!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290513,
					"content": "How do you plan to train?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "Hmm... I may ask for their opinions before deciding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290504,
					"content": "I haven't had time to train lately.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "Such indolence! Don't tell me, you've been wasting your life on meaningless wandering?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
