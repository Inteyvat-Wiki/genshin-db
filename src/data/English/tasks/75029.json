							"7502903",
							"2"
						],
						"stepId": 7502903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290801,
					"content": "I will become a warrior! No, a hero! Just you wait and see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502913,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7500001",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291301,
					"content": "The Soaring Saurian is open all day! If you wish to join Matahga's special training, then come lift off from the Soaring Saurian! Note: Just as serious, proactive training is a cause for great pride, so laziness and slacking off is a source of great shame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291302,
					"content": "Laze about today, and be as trash tomorrow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291303,
					"content": "Only those who push forward boldly shall truly know greatness as Saurian riders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502914,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7500001",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291401,
					"content": "The order is: <color=#00E1FFFF>Blow the left horn first, then the right one, and finally the left again</color>! Don't mix it up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291402,
					"content": "(Seems like a reminder that someone called Matahga left for themselves. You can really feel the intensity of the emotion in their words.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291403,
					"content": "(But surely putting exclamation marks at the end of every reminder is the same as putting none... Isn't it?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}