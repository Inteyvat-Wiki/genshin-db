						"stepId": 7502903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290601,
					"content": "You weren't bad, so keep it up. I know you can do it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290602,
					"content": "Pah, you didn't really think those were the words I would leave you with, did you? No! Being \"not bad\" and \"making do\" isn't the warrior's way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290603
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290603,
					"content": "You should only strive to be the best! Anyone who fails to do so is a failure, pure and simple!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290604,
					"content": "As long as you still have the courage, then keep trying! Train until you can surpass me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
