					],
					"speakerTitle": "Clever Little Tepetlisaurus"
				},
				{
					"id": 750250506,
					"content": "#Well, being given Berries is never a bad thing, but it seems like {REALNAME[ID(2)|SHOWHOST(true)]} isn't here. Let's keep looking!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
