			},
			"dialogs": [
				{
					"id": 727310201,
					"content": "Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310202,
					"content": "Astounding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310203,
					"content": "Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310204,
					"content": "Amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310205,
					"content": "Even though your fighting style differs greatly from mine, I resonate strongly with the passion you imbue into your Onikabuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310206,
					"content": "In time, you shall surely become a true champion of the beetle-fighting world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310207,
					"content": "You're pretty good yourself! You managed to win an impressive 570 out of our 1,141 matches!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310208,
					"content": "Of all the beetle-battle marathons I've fought in my time, you've lasted the longest by far! Not gonna lie, I'm impressed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310209,
					"content": "No, I won 571 rounds, so I'm ahead. Also, you have the home advantage. Taking that into account, it is in fact I who am the superior warrior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310210,
					"content": "Huh? Why you gotta be so stubborn? I remember our score clear as day, and Mamoru is our witness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310211,
					"content": "Ain't that right, Mamoru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310212,
					"content": "Boss, I... I really can't take it anymore... Please let me sleep for a while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 727310213,
					"content": "Uhh... Have they been going at it this whole time without a break!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310214,
					"content": "Have they been going at it without a break!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310215,
					"content": "The arena must be about to collapse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "Fine! Since I'm a generous guy, I can give you one round, no problemo. I'll just defeat you next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310218,
					"content": "And if you're still not convinced, we'll do the next battle on your home turf. I'll prove that it's about the beetle fighter, not the location!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310219,
					"content": "That suits me just fine. Follow me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310220,
					"content": "Oh? Hey, compadre, Flying Lavender Melon, you're finally here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310221,
					"content": "Wait a minute, why's Paimon back to Flying Lavender Melon again? Does Paimon only get a good nickname when she's fighting for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310222,
					"content": "Uh, never mind that for now! Here's your 2-month free ramen voucher, as agreed. Take it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310223,
					"content": "Ramen voucher? Oh yeah, right! The ramen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310224,
					"content": "Now that's more like it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310225,
					"content": "Time to celebrate!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "Oh, no, no, no, no. This was just the warmup. The Almighty Arataki Extraordinary and Exhilarating Extreme Beetle Brawl is still to come!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310228,
					"content": "After all, things are way too quiet without an audience. We can't just end the event like this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310229,
					"content": "But the good news is, Grandmaster Hanakado finally let go of his pride and admitted that I'm a strong beetle fighter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310230,
					"content": "Still, we ain't done with each other just yet. I'll be heading to his home turf alone soon, where I'm gonna defeat him once and for all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310231,
					"content": "Once that happens, he'll have to follow my orders — and by that, I mean he'll help us make the Almighty Arataki Extraordinary and Exhilarating Extreme Beetle Brawl the biggest, baddest event ever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310232,
					"content": "Thanks again to the two of you. Now, wait here — I'll be back with good news in no time at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310233,
					"content": "Bull-Chucker sure seems like he's having fun, and we got two months' worth of ramen out of it, hee-hee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310234,
					"content": "It's a win-win situation!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "Boss, Boss! There's a letter from Shinobu. Take a look at this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310237,
					"content": "Huh? Where'd the Boss go? He was beetle fighting right here just a moment ago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310238,
					"content": "Uh, is it urgent? Because Bull-Chucker just left with Grandmaster Hanakado. They said they were going to continue their battle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310239,
					"content": "Well, it's not urgent, just a little unexpected...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310240,
					"content": "You can read it for yourself if you want.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310241,
					"content": "What the... So Grandmaster Hanakado is actually part of the Arataki Gang? But his... communication style made Bull-Chucker feel like he was facing a mortal enemy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310242,
					"content": "Just as Shinobu expected, Bull-Chucker is spending all his time beetle fighting without resting or eating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310243,
					"content": "But he did get us to organize the Beetle Brawl event for him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310244,
					"content": "I still wouldn't really call that resting, per se.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "Y'know, Paimon thinks Shinobu deserves to enjoy the ramen voucher more than we do! Why don't we take her for ramen when she gets back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310246,
					"content": "Hmm... Actually, wait a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310247,
					"content": "Bull-Chucker didn't tell us which ramen stall this voucher's meant to be used at...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310248,
					"content": "...Are we supposed to find the store by ourselves!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310235,
					"content": "Everyone's happy, that's all that matters.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "And the \"Extreme Beetle Brawl\" is a wrap!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "The Onikabuto must be exhausted...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
		{
			"id": 7273107,
			"completionStepIds": [
				7273101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273101",
							"2"
						],
						"stepId": 7273101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273104",
							"2"
						],
						"stepId": 7273104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grandmaster Hanakado",
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727310701,
					"content": "I see. I see... Let us battle once more. This time, I'll see through all of your methods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310702
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310702,
					"content": "Victory and defeat no longer seem so important... Let's just battle for fun, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310703
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310703,
					"content": "It's rare that I should find such a great opponent. It would be a shame to end our battles so soon, would it not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310704
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 727310704,
					"content": "Sure! Bring it on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310705
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310705,
					"content": "But seeing through my secret beetle-fighting techniques? Nah, little fella, that ain't gonna happen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310706
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310706,
					"content": "If you'll admit that I'm the stronger beetle fighter, I'll fight you for as many rounds as you want!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310707
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310707,
					"content": "Huh, looks like Bull-Chucker and Grandmaster Hanakado are still raring to go... Well, let's leave them to it! They can battle beetles till the beetle-battling's done!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}