			"dialogs": [
				{
					"id": 760790101,
					"content": "The monsters have disappeared, but still, a fissure remains. And through it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790102,
					"content": "I sense the thick stench of the Abyss. Something lurks behind this rift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790103,
					"content": "Well, come out then. Or would you prefer a sealed letter of invitation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760790104,
					"content": "Did you truly think sneaking out of the fissure unseen would allow you to escape our eyes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
