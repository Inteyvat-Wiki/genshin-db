			"dialogs": [
				{
					"id": 751950201,
					"content": "My goodness, surely not... A kind soul showing up, completely out of the blue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "I was planning to have a Tatankasaurus drop by to help smash up and clear aside the stones in this barren field. If any monsters happened to pop out of the woodwork, it could help deal with them for me as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "I hadn't even gotten started, yet someone's already taken care of it all for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "Ah... I've been fertilizing the fruit trees outside my doorstep every morning for as long as I can remember. This must be the gods' way of rewarding me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "Kind soul, emissary of the gods! I, Dutta, thank you for your generosity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "I don't have anything special to give you, but here's some Mora and a few other useless bits and bobs. Please, accept them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
	]
