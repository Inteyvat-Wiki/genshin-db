						700081302
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081302,
					"content": "Hey there, The Cat's Tail's come up with a new beverage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081303
					]
				},
				{
					"id": 700081303,
					"content": "The Cat's Tail... Aunty Grace says that kids shouldn't drink wine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081304
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081304,
					"content": "Oh, this one's got no wine in it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081305
					]
				},
				{
					"id": 700081305,
					"content": "Really? I'll give it a try...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081306
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081306,
					"content": "It's really nice! It's sweet, and it's cool! Is this a new drink from The Cat's Tail?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081307
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 700081307,
					"content": "I'll tell Timmie and Lily, too! I'm sure they'd like some!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
