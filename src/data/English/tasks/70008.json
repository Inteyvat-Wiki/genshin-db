						700081504
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081504,
					"content": "There's a slight sweetness to the piercing foretaste, and there's also a cooling texture, like that of the flowing breeze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081505
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081505,
					"content": "A most fitting drink for the Windblume Festival. I see I made the right choice in bringing you on board.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081506
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081506,
					"content": "Next, I think this drink needs some taste testers. Traveler, could I trouble you to go out again to look for some?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081507
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081507,
					"content": "I'll see this done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081508
					]
				},
				{
					"id": 700081508,
					"content": "I'll be relying on you, then. I believe there'll be tons of people near the Anemo Archon statue. You can probably find some testers there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
