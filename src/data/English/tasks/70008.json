			"dialogs": [
				{
					"id": 700081401,
					"content": "How did it go? Were you able to find some taste testers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081402
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081402,
					"content": "Oh, I found some, alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081403
					]
				},
				{
					"id": 700081403,
					"content": "Getting reasonably drunk during the festival, huh... No wonder the crowd at the Angel's Share has grown...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081404
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081404,
					"content": "Still, I think this is fine. Other than those who'd like to get reasonably drunk, the children and the city guards should get to enjoy their own fair share of festive cheer as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081405
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081405,
					"content": "I'll continue tweaking this special blend. Thanks for your help, by the way — and here's a little something as thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081406
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700081406,
					"content": "Ah, yes — and Happy Windblume Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
