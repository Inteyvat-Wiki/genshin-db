			},
			"dialogs": [
				{
					"id": 700081201,
					"content": "Hello. Can I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081202
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081202,
					"content": "Hey there, The Cat's Tail's come up with a new beverage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081203
					]
				},
				{
					"id": 700081203,
					"content": "My apologies, but I'm on duty at the moment. I can't drink.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081204
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081204,
					"content": "This drink's non-alcoholic.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081205
					]
				},
				{
					"id": 700081205,
					"content": "Oh? Well... then... I guess it'll be fine. I'm feeling a little thirsty, in any case, so I'll give it a go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081206
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081206,
					"content": "Oh! This is pretty good. It's refreshing, too. Really perks you right up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081207
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700081207,
					"content": "This is a new product from The Cat's Tail, is it? I'll go have another taste later when I can spare the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
