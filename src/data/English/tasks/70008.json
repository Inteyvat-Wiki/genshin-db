				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700081101,
					"content": "*sigh* Festivals just aren't complete without a little swig of drink...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081102,
					"content": "Hey there, The Cat's Tail's come up with a new beverage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "Oh, you want me to test it, do you? Hahaha! No problem, none at all! I'm an old hand when it comes to wine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081104,
					"content": "Let me try it... Eh? This... doesn't have any taste of alcohol at all. It's more like some sort of dairy product.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081105,
					"content": "Don't get me wrong, it tastes good, but I don't think a non-alcoholic drink really fits this festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081106,
					"content": "I mean, there are lots of people who're looking forward to getting reasonably drunk this Windblume Festival. I don't think this sort of drink would receive a particularly warm welcome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 7000812,
			"completionStepIds": [
				7000812
