						700083805
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083805,
					"content": "So, want to try making it yourself, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083806,
					"content": "Sure, I'll give it a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "Great. Now, just let me explain the process of making this beverage. Make sure you remember it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083808,
					"content": "First, place a <color=#00E1FFFF>Sweet Flower</color> inside before pouring the base alcohol we're using for this cocktail... and then, of course, we'll drizzle some <color=#00E1FFFF>Milk</color> in to lay the foundations for the clear, sweet texture we're going for this time around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083809,
					"content": "We'll need to add the <color=#00E1FFFF>Windwheel Aster</color> in at this point to add flavor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083810,
					"content": "Don't rush to mix it all together. Let it <color=#00E1FFFF>sit</color> for a moment and let the floral fragrance emerge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083811,
					"content": "Then scatter the <color=#00E1FFFF>Dandelion Seeds</color> in to make the drink look like it's been adorned with stars. Then, place some <color=#00E1FFFF>ice cubes</color> in, and that's a wrap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083812,
					"content": "And that's how it works. You can't get the steps mixed up if you want to make something delicious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083813,
					"content": "If you've memorized the steps, give it a go. If you've forgotten, feel free to ask me again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
