			"trigger": {
				"objectNames": [
					"Zhiping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "...Ugh, now Tianqiu Valley, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220102,
					"content": "Is something wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#Oh, {NICKNAME}, it's you. Pleased to see you, though I certainly wasn't expecting to run into you today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220104,
					"content": "Um, anyway... have you been to Tianqiu Valley or Nantianmen lately?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220107,
					"content": "The Guild has been receiving a constant stream of reports about earthquakes in those areas recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220108,
					"content": "It was just minor tremors at first, but they've been getting more and more serious since.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220109,
					"content": "Then, not long ago, we received word of a particularly strong earthquake that caused part of the mountains and ruins to collapse, revealing a gigantic cavern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220110,
					"content": "The report also mentioned that some unknown monsters have been sighted in the area. Based on the descriptions, they may well be none other than the Geovishaps and Primo Geovishaps that once terrorized Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220111,
					"content": "Do you need any help from me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "Well, I'd like to ask you to head to Tianqiu Valley to investigate that huge cavern and report on the impact of the earthquake on the surrounding environment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220113,
					"content": "As for the monsters... If it's true that they're appearing in great numbers, then we cannot afford to ignore them. We must decide on what countermeasures to take.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220114,
					"content": "Of course, this counts as official work for the Guild, and you will be compensated accordingly. What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220115,
					"content": "I'll do it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "Thank you very much. Please stay safe while exploring in that area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
