			"dialogs": [
				{
					"id": 230121501,
					"content": "The one that has slipped out today is a black and white cat called \"Lale.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121502
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121502,
					"content": "In cat language, you should call for it like this... \"Meow, meow meow meow, meeeeow!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121503
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121503,
					"content": "Keep in mind how the tone falls and then rises again. Make sure that the last \"meow\" is very high.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121504
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121504,
					"content": "Hmm... Let me write a note for you. Please wait just a moment.",
					"roleType": "TALK_ROLE_NPC",
