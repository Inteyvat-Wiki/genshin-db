					"Sareh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230120101,
					"content": "Meow— *cough*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120102,
					"content": "Uh, what are you doing...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "I'm looking for my kittens. Normally, they respond to my call.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120104,
					"content": "Is my pronunciation off today somehow? I've been calling them for ages, and none of them have answered. How strange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120105,
					"content": "Can't you just call their names?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "Yeah. Don't people usually call kittens' names when looking for them, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120107,
					"content": "But if you call for them in our language, they can't understand it, can they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120108,
					"content": "Eh? Well, you do have a point there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120113,
					"content": "Still, I'm getting nowhere shouting myself hoarse like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120114,
					"content": "Traveler, I'd like to ask you a serious question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120115,
					"content": "Leave it to me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "...Would you like to learn the language of cats?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120118,
					"content": "What?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120120,
					"content": "You mean you're gonna teach us how to talk to cats?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120116,
					"content": "The payment should be...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "What did you mean by \"your pronunciation today\" being off, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "Well, I was calling their names, actually, just in the language of cats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120111,
					"content": "After all, they wouldn't necessarily understand if we called them in our language, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120112,
					"content": "Eh? Well, you do have a point there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2301203,
