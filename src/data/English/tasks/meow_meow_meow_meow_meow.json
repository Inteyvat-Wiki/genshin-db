			},
			"dialogs": [
				{
					"id": 230121101,
					"content": "Well, I've spoken to cats before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "You mean Neko? But she can speak our language. That doesn't really count as \"cat-talk\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "Indeed. Still, in exchange, you will need to help me find a cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "So you agree? Why, thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "Ahem... Now, listen carefully. This is the outline of cat language that I've been working on for a long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "Looks like each city has its unique way of looking for cats...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Heh, that's true! If you think about it, we've helped people find cats in quite a few cities by now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "Should we say that everyone just loves cats, or that everyone who owns a cat has the same problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
