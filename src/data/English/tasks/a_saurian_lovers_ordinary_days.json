			"dialogs": [
				{
					"id": 750240901,
					"content": "Hehe, looks like he was attracted by the scent of the food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240902,
					"content": "#The gap's not large enough, though. Could you help us lure Jade away, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240903,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240904,
					"content": "Nice! We'll leave it to you, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240905,
					"content": "#Let's go check on the guy and see if he's okay once {REALNAME[ID(2)|SHOWHOST(true)]} leads Jade off, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
