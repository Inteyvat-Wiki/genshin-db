						],
						"stepId": 7502402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2030.073,
							74.78,
							8497.404
						],
						"pointId": 8382
					},
					{
						"sceneId": 3,
						"position": [
							-2032.248,
							74.7,
							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "\"...Today's a rainy day. I prepared \"Ripple\" his favorite <color=#00E1FFFF>Sour Sauce Ceviche</color>. His look of satisfaction made it all worthwhile...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240202,
					"content": "\"...Even if he's swimming in a leisurely manner, the moment I proffer some of that <color=#00E1FFFF>Sour Sauce Ceviche</color>... Whoosh! Out he pops from the water, and in such lovely form, too...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240203,
					"content": "\"...I would never doubt his affection for me. Only, perhaps, that he might love <color=#00E1FFFF>the ceviche</color> more...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240204,
					"content": "So... Ripple's this Koholasaur's name, huh? Guess the Sour Sauce Ceviche in the pot must've been for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240205,
					"content": "\"...Big round sparkling eyes, curly tail and cheery cries... Jade, oh, Jade, is there a cuter Saurian in this world than you...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240206,
					"content": "\"...You have never once been cheated, nor never once doubted, as if all life might become your friend and enjoy a wonderful time playing with you...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240207,
					"content": "\"...Were I not so busy, I'd love to play with you all day, watching you dart through woods swimming in mottled sunlight, like a child of the wind, a spirit oh so carefree...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240208,
					"content": "#Ah, so that little Yumkasaur is named \"Jade.\" Playful, too, sounds like. Maybe you two could be friends, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240209,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "\"...I've crossed mountains and valleys just to search for your whereabouts. If you truly wished not to see me, you could have departed...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240211,
					"content": "\"...But you had consideration for my pace, stopping every so often, even collecting so much Grainfruit on my behalf, not to mention those shiny stones...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240212,
					"content": "\"...Oh Marigold, my lovely Marigold, only I know the tender heart that lies beneath your hard shell. To be a fighter so fierce was never your intent...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "Someone's Diary"
				},
				{
					"id": 750240213,
					"content": "Err, so Marigold's that grumpy Tepetlisaurus, then? Call Paimon blind, but she sure doesn't see how that one counts as \"tender\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240214,
					"content": "Anyway, back on topic. So these three Saurians are... his friends? Why'd they knock him unconscious and surround him, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240215,
					"content": "Let's get him out first and ask questions later.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "Yeah, that's true. If only we could get them to make way... Hang on, didn't the diary say that Ripple fancies Sour Sauce Ceviche? There's some in camp, so maybe we can use it as a lure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240217,
					"content": "#As for Jade... Let's send {REALNAME[ID(2)|SHOWHOST(true)]} to go make a friend, shall we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#Great idea! Jade's the fun-loving sort, so {REALNAME[ID(2)|SHOWHOST(true)]} just needs to lead 'er off somewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240221,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#See, {REALNAME[ID(2)|SHOWHOST(true)]}'s excited about the plan too! But perhaps the simplest and least wasteful way would be to use the Sour Sauce Ceviche, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240219,
					"content": "We could duel Marigold.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#Err, let's resolve this by more peaceful means, shall we? Like getting {REALNAME[ID(2)|SHOWHOST(true)]} to lure the fun-loving Jade away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
