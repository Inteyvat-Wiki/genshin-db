			"dialogs": [
				{
					"id": 750240601,
					"content": "Shrawrr—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "\"Marigold\""
				},
				{
					"id": 750240602,
					"content": "Don't get so worked up, we're just checking to see if the guy over there's unhurt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240603,
					"content": "Seems like it's time to duel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "C'mon, don't give up that quickly! Look, we don't mean any harm, and we... Well, we're sure that you're not the fighty type by nature...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240606,
					"content": "Shrar! Grawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "\"Marigold\""
				},
				{
					"id": 750240607,
					"content": "Uh oh... She's getting even angrier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240605,
					"content": "\"Oh Marigold, my lovely Marigold\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
		{
			"id": 7502407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
