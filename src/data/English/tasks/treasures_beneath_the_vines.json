					"Ulman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "Didn't you bring me here, little one? Keep moving!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740102,
					"content": "Never mind, you better stay put...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740103,
					"content": "What are you up to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "I'm duped by it, again... Let me give you a rundown from the beginning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740107,
					"content": "For starters, you may not believe Seelie are somehow easily drawn to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740108,
					"content": "Among the Seelie that came to follow me, I found one kind that is particularly keen on treasure-seeking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740109,
					"content": "I'm not good at naming. I'll just call them Treasure-Seeking Seelie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740110,
					"content": "They excel at treasure-seeking. With their help, I dug up a lot of treasures and made a profit with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740111,
					"content": "But sometimes they suddenly tune out on me. I don't know if they're tired of the seeking, or just think I'm too boring...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740112,
					"content": "Then I'd find a helper favored by the Seelie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740113,
					"content": "The helper takes Treasure-Seeking Seelie to locate the treasures, and I sell them for a fair price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740114,
					"content": "They say ruins and antiques are everywhere in Sumeru. So I came to look for my fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740115,
					"content": "And I attracted a bunch of Seelie here, of course. Some Treasure-Seeking Seelie brought me here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740116,
					"content": "But they ignored me again not long after I scooped up some dirt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740117,
					"content": "Eh? Why did it suddenly start to move? Could it be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740118,
					"content": "Traveler, are you interested in treasure-seeking with Seelie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740119,
					"content": "Me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "That won't be necessary. Just follow it and dig where it stops.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740122,
					"content": "How's that sound? Just give it a try... If you scoop up some treasure, I'll only want the \"Ancient Iron Coins\" if there is any. The rest is all yours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740123,
					"content": "And say you do help me find some of those coins, I'll pay you for them at a fair price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740124,
					"content": "I could give it a go...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "That's the spirit! I like you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740130,
					"content": "Anyways, we are partners now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740131,
					"content": "Take this notebook. I recorded on it some hidden treasure sites I found before but haven't had a chance for a dig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740132,
					"content": "I'm counting on you then, Traveler. Come back and bring me the \"Ancient Iron Coins\" if you find any.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740126,
					"content": "What are \"Ancient Iron Coins\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "Simply put, it's a kind of antique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740128,
					"content": "With good connections, I'll be able to exchange the coins for some decent stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740129,
					"content": "I haven't found any good connections though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740120,
					"content": "I don't know their language...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "Is this... a Seelie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "You mean the little one? Ugh, sort of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "Ulman"
				}
			]
		},
