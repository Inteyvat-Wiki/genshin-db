			"dialogs": [
				{
					"id": 736740301,
					"content": "Didn't you bring me here, little one? Keep moving!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740302
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740302,
					"content": "Never mind, you better stay put...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740303,
						736740304
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740303,
					"content": "Ulman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				},
				{
					"id": 736740305,
					"content": "Traveler? It's been a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740306
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740306,
					"content": "Are you still bumming around the world? I've heard many amazing stories about you. You're really phenomenal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740307
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740307,
					"content": "What troubles are you gonna fix this time in Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740308,
						736740310
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740308,
					"content": "Don't jinx me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740309
					]
				},
				{
					"id": 736740309,
					"content": "Right, back to business, Traveler. How about another team-up action?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740313,
					"content": "The land of Sumeru is strewn with treasures. Mora everywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740314
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740314,
					"content": "Seelie are drawn to me as usual. And the Treasure-Seeking Seelie we got so familiar with are among them too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740315
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740315,
					"content": "Same as before. You and the Seelie look for treasures, and I'll prepare your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740316
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740316,
					"content": "We'll surely rake it in as a team!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740317,
						736740321
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740317,
					"content": "\"Iron Coins\" again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740318
					]
				},
				{
					"id": 736740318,
					"content": "No. This time I'm looking for \"Ancient Iron Coins,\" which are worth more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740319
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740319,
					"content": "It's just another coin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740320
					]
				},
				{
					"id": 736740320,
					"content": "It's not! The antique ones sell for more Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740326,
					"content": "So it's a deal then. Let's make a pile as a team like we used to!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740321,
					"content": "Can't you find someone else?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740322
					]
				},
				{
					"id": 736740322,
					"content": "Well, you always team up with the one you are familiar with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740323
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740323,
					"content": "And we're friends! I look out for my friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740324
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740324,
					"content": "Last time we met, you didn't have that silver tongue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740325
					]
				},
				{
					"id": 736740325,
					"content": "Hehe, that's what you must have to persuade your buyers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740310,
					"content": "Not before I \"fix\" you first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740311
					]
				},
				{
					"id": 736740311,
					"content": "Haha, better not. I wouldn't be strong enough to take your fixing punches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740312
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740312,
					"content": "Seriously, Traveler. How about we team up again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740304,
					"content": "What are you doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				}
			]
		}
	]
}