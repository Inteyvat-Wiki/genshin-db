			"dialogs": [
				{
					"id": 735340901,
					"content": "So you're the fine friend that Dharmakirti's introduced? Piyush, pleased to meet you. I work in architecture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340902,
					"content": "I've heard Kaveh mention your name before, but I haven't had the chance to say hello yet, so this is a happy coincidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340903,
					"content": "I'm guessing I'll dream about a project I just submitted. It was an absolute nightmare... It's just a shame we have to first meet in such a formal fashion... Oh well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piyush"
				}
			]
		},
