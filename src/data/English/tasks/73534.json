				"points": []
			},
			"dialogs": [
				{
					"id": 735340101,
					"content": "Hey there! Are you the one who's assisting me with the Dreamscape Therapy? To be honest, I don't know what my dream's going to be about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "I'm from Mondstadt, and I don't really have any hobbies... You know, except drinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "And I'm the type to mess up sometimes when I get sloshed, so... I'm counting on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
