			"dialogs": [
				{
					"id": 735340701,
					"content": "Ah, so the qualified volunteer for the Dreamscape experiments is one so young? My, aren't young people impressive nowadays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Call me Nitesh. I am a traveling Spantamad scholar, presently working long-term in Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "We older folks tend to come by all manner of problems more easily. I'm counting on you to help me get to the heart of things, youngster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
				}
			]
		},
