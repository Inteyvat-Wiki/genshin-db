			"dialogs": [
				{
					"id": 735340501,
					"content": "Nice to meet you. Higuchi Tetsuya's the name, a youkai novel writer from Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "I've been under lots of pressure lately, so... I'll try anything, do whatever it takes, to get back on my feet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "By the way, my dreamscape might have a rather... personalized look, considering that it's a world of my making — with all the issues that entails. Apologies in advance for any strange things you might see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
