			},
			"dialogs": [
				{
					"id": 735340301,
					"content": "A pleasure to meet you. We're about to enter a dreamscape together, I believe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "I'm Youguang, a guard from Liyue. I touched something... unclean while at work recently, and I haven't had a good night's sleep since. That's why I sought help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "If I can dispel my nightmares through this Dreamscape Therapy, that would truly be amazing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
