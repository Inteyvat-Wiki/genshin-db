			"dialogs": [
				{
					"id": 250360101,
					"content": "...Was this question too easy after all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "Oh, my apologies. I was just thinking aloud, didn't even notice you there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Allow me to extend my greetings. I am Keita, of the Masters of the Night-Wind. I am currently an apprentice here, in charge of file management.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "And what were you thinking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "Ah... Just a few simple questions regarding Natlan's past, present, and future. Completely unworthy of discussion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "Judging by your appearance, you seem to be a traveler from afar. I can tell that your many friendships are deep, and your knowledge broad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "Should you be willing, you could try your hand at some of the questions I've already recorded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "The answers to these questions lie within your journey — past, present, and future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
		},
