				"points": []
			},
			"dialogs": [
				{
					"id": 191211401,
					"content": "...You're asking me what I think Thoma could do better?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211402
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211402,
					"content": "He's busy enough as it is, don't you think? I barely see him around here at the Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211403
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211403,
					"content": "And when I do, more often than not, he's busy with the housework.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211404
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211404,
					"content": "I think he should carry on doing what he's doing. Everyone's got their own way of living, and Thoma's no different.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				}
			]
		},
