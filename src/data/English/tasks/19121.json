					"nextDialogs": [
						191211503
					]
				},
				{
					"id": 191211503,
					"content": "People have been talking about him behind his back? Surely not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211504
					],
					"speakerTitle": "Masanobu"
				},
				{
					"id": 191211504,
					"content": "He does a wonderful job and always remains modest about it. Why would anyone single him out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211505
					],
					"speakerTitle": "Masanobu"
				},
				{
					"id": 191211505,
					"content": "Huh, I can't figure it out. Try asking someone else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masanobu"
				}
			]
