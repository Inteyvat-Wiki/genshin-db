			"dialogs": [
				{
					"id": 761480101,
					"content": "Ugh! Where did you two go just now? Paimon nearly had a heart attack there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480102,
					"content": "Paimon was calling your names the whole time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480103,
					"content": "Hmm? Why wasn't Paimon dragged into the Apathic Interval?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480104,
					"content": "Well... maybe because other than eating and sleeping...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "She doesn't really think about much at all?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "Hmm. Makes sense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480107,
					"content": "Looks like Melanta really is angry now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480108,
					"content": "#Sending {NICKNAME} up to face him has become urgent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480109,
					"content": "Let's talk somewhere else. This place isn't exactly safe anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480110,
					"content": "Um, well, I know no one asked, but... Hello, everyone. My name is Alara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alara"
				}
			]
		},
		{
			"id": 7614807,
			"completionStepIds": [
				7614807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
