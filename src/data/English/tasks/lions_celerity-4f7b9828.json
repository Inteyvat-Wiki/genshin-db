					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Istoria"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							250.415,
							-645.04,
							392.731
						],
						"pointId": 118
					},
					{
						"sceneId": 103,
						"position": [
							252.49,
							-645.37,
							394.33
						],
						"pointId": 119
					}
				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "Once more, we return to this place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "The last time I came, by human lifespans, it must have been... many, many, many... generations ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "Looks like we've all been cast back into the Apathic Interval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "So how are we supposed to get out?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "The usual way is through meditation — learning to master your mind and thoughts, and then letting go of every desire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "In short, we must maintain a state of complete emptiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "Simply enough said. But depending on a person's nature and the strength of their desires, it can take anywhere from a few years to several centuries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "For someone like you who carries the fate of the world on your shoulders, your desires probably can't be cast aside... nor should they be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "Then what do we do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Let's find Zeitlind, and figure it out from there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761480712,
					"content": "What'd you pick up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Wait, Dex was dragged in as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "In that case, there may yet be a chance to turn this around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Since Dex is also a Watcher, it might be able to use the power contained within these fragments to force open a path.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "We're going to need to give these fragments a name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "I've heard of these overwrought coffins. They were set up by one of the temple mistress's sisters... Maranasati Caskets, I believe they were called.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480718,
					"content": "In which case, let's call the fragments Deathmuse Shards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		}
	]
}