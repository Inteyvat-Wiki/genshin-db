			"dialogs": [
				{
					"id": 220230101,
					"content": "Ahh, it would be nice to have some Liyue cuisine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230102,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230103
					]
				},
				{
					"id": 220230103,
					"content": "You are? With that outfit... You're the Traveler, right? Sorry, I'm just a little homesick...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230104,
						220230105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230104,
					"content": "Did you just say you wanted to have some Liyue cuisine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				},
				{
					"id": 220230118,
					"content": "Huh? Could it be... You know how to make Liyue cuisine? That's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230119,
					"content": "Th-Then, please help me! Please make me some authentic Liyue dishes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230120,
					"content": "Let me think... What I really want to eat now is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230121,
					"content": "Mmm! I want to eat meat! A lot, a lot of meat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230122,
					"content": "The delicate texture and the fragrant aroma of the meat mixed with Liyue's special spices...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230123,
					"content": "Just thinking about it makes me salivate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230124
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230124,
					"content": "So, I want to eat meat! Please help me prepare a Liyue dish made of meat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230105,
					"content": "Do you need help with anything?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230106
					]
				},
				{
					"id": 220230106,
					"content": "Let me introduce myself. I'm Tang Wen, a historian from Liyue. I was previously doing some field research on the unique customs and folklore of Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230107,
					"content": "I was about to return to Liyue as I had almost finished collecting information. But because of Inazuma's Sakoku Decree, I ended up being stranded here for a long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230108,
					"content": "Actually, I think this is kind of a good thing for me. It's because I feel that this is a historic moment for Inazuma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230109,
					"content": "I am quite sure that this particular period will certainly leave a strong mark in the annals of history of Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230110,
					"content": "To witness such history with one's own eyes, and then record all of it in a true, complete and clear manner for posterity, is what a historian should do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230111,
					"content": "But... as exciting as this cause is to me, it won't satisfy my stomach...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230112,
					"content": "Are you getting hungry?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230113
					]
				},
				{
					"id": 220230113,
					"content": "I can't say... it's because I'm hungry... Hahaha, Inazuma's food is quite tasty too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230114,
					"content": "I really like the tempura here, although it feels like everything is coated with batter and then fried...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230115,
					"content": "But after eating Inazuma cuisine for a long time, I started to miss the Liyue dishes. Sadly, I couldn't find a restaurant that could make authentic Liyue cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230116,
					"content": "I finally decided to post a Cuisine Commission at the Adventurers' Guild a few days ago but there hasn't been any response...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230117,
					"content": "Can I give it a try?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				}
			]
		},
