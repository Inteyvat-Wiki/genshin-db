			"dialogs": [
				{
					"id": 715380301,
					"content": "Wow, this turned out great! Hmm... you deserve something in return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "Here, take some of this dim sum as thanks for your help. Receiving this envelope from you really makes this trip worthwhile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "...Still, I've been away for some time, now. I wonder if my officers are keeping up with their training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "Well, I guess it's time to start planning a fitness test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
