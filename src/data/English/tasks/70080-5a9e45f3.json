			"dialogs": [
				{
					"id": 700800101,
					"content": "Having stood upon the line between life and death, I miss the flavor of beer most. Even my master and King Deshret himself would rank beneath it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800102
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800102,
					"content": "Ah. I didn't know you so enjoyed your libations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800103
					],
					"speakerTitle": "Kshama"
				},
				{
					"id": 700800103,
					"content": "When delivering bricks to the Mausoleum of King Deshret back in the day, we'd get two large mugs of beer for free every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800104
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800104,
					"content": "Speaking of which, was Maukie among those who were restored?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800105
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800105,
					"content": "No. I suspect the higher-ups intend to deal with him... in violation of the rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800106
					],
					"speakerTitle": "Vitruvius"
				},
				{
					"id": 700800106,
					"content": "I wonder if the note I asked him to bring in secret came in handy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vitruvius"
				}
			]
		}
	]
