			"dialogs": [
				{
					"id": 760190301,
					"content": "...If you plan to kill me or chop me into pieces, go ahead. I won't resist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190302
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190302,
					"content": "#Whoa, whoa! {NICKNAME} and Paimon would never do anything like that! You just promise us you won't trick anyone else, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190303,
					"content": "Even a blockhead like Vieri... Wait, where did he slip off to? ...A—Anyway, you shouldn't take advantage of people — not even the dumb ones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190304,
					"content": "You're kinder than most. If I'd met more folks like you back in Sumeru... maybe I wouldn't have ended up like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190305
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190306
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190306,
					"content": "Aren't you curious to find out what happened to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190307,
						760190308
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190307,
					"content": "Something tells me I'm better off not knowing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190309
					]
				},
				{
					"id": 760190309,
					"content": "Sharp little thing, aren't you... *sigh* Haven't made a proper deal in ages. Maybe it's time I switched careers — better that than having the Voynich Guild on my case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190310
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190310,
					"content": "If you'd figured that out earlier, you wouldn't have ended up getting smacked around just now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190311,
					"content": "Sometimes you need a wake-up call to force a real choice. Good or bad, it gets you moving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190312
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190312,
					"content": "Kid, flying one, if either of you ever needs that kind of a push... come find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190313
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190313,
					"content": "Uhm... Thanks and all, but Paimon hopes that won't be necessary!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190314,
					"content": "Hidimbi leaves her piece of red satin behind and waves goodbye as she leaves...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
