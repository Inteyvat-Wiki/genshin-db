			},
			"dialogs": [
				{
					"id": 752400101,
					"content": "Welcome, friend, to the Ayar Heroes' Cup. I'm the organizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400102,
					"content": "Today's the last day of the competition. If you want to claim the crown, you'll need to defeat our top three warriors back to back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400107,
					"content": "What is the Ayar Heroes' Cup?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "It's a battle for the glory of Ayar! Use fists, weapons, or any other trick in the book to defeat your opponent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400109,
					"content": "And is Ayar a... person, or...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "My friend, only champions are qualified to ask questions here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400111,
					"content": "Get on stage! We'll soon see if you have the strength to earn that respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahuatlalli"
				}
			]
		},
