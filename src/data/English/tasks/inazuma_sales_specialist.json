			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360201,
					"content": "So, tell me how to use the fertilizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "Oh yes, right, I haven't explained it to you yet. The fertilizer you are taking there must be used in a certain way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "Now, let me see... according to the manual, the order should be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "You must first add <color=#37FFFF>water</color> to the fertilizer, before adding some <color=#37FFFF>crushed leaves</color>. Finally, <color=#37FFFF>mix them well</color> and apply it to the field.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "Don't get the order wrong, or it may cause problems, which will affect our customers' impression of us. Our future business is at stake...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "I remember.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "Then I'm counting on you. Once you deliver the Anahitian Blessing to the customer, his first payment will be yours to keep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "Could you repeat the process again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "You must first add <color=#37FFFF>water</color> to the fertilizer, before adding some <color=#37FFFF>crushed leaves</color>. Finally, <color=#37FFFF>mix them well</color> and apply it to the field.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "I'm counting on you, Traveler... Let's all work hard. With any luck, business this month might be good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
