	"talks": [
		{
			"id": 48503,
			"completionStepIds": [
				48503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48503",
							"2"
						],
						"stepId": 48503,
