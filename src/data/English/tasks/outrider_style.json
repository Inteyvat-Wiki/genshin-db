					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850801,
					"content": "Congratulations, here is your gliding license! You're officially legal now, yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850802
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850802,
					"content": "I'm not surprised though, you are a natural after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850803,
						4850804
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850803,
					"content": "Yeah, it was easy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "Oh — and I'll sign you up for the next Wind Gliding Championship!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850806,
					"content": "I glide so fast that no one can keep up — it's just me up there, on my own, gliding around... It's kinda boring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850807,
					"content": "Cool. I'm definitely gonna win.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "Ooh... Fighting talk! Heh. It seems you have no idea how terrifying the championship really is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850810,
					"content": "Well, until I kick your butt in the championship, I wish you a happy, liberating, and above all law-abiding gliding experience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850811,
					"content": "Make sure you obey the rules. Whatever you do, don't get your license revoked...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850812,
					"content": "Oh brother... If you ask me, that's a bit rich, coming from Amber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850808,
					"content": "You won't stand a chance of winning if you sign me up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850804,
					"content": "I actually put a lot of effort into this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				}
			]
		},
		{
			"id": 48511,
