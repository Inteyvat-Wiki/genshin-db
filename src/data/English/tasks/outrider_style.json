				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "It looks like there's no way across... Ugh, he must be around here somewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber, over there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "If you insist on chasing me, so be it... Huh? Who brought the little girl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850304,
					"content": "You must be Raptor! You can't escape!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "Haha, I don't need to escape! There's no way you can make it over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850306,
					"content": "Oh... It is pretty high... and quite far...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "Oh, little girl, why don't you run along home now and let your leader deal with this? Don't worry, I promise that once the Grand Master gets here, I'll surrender immediately! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850308,
					"content": "Hey, watch it! You're talking to a Knights of Favonius Outrider! You'll be sorry when I arrest you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "Deep breaths, Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "...You're right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "Ugh... He's right there in front of us... If only we could glide across.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "So how did HE get across?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "Some sort of mechanism?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "I don't see a mechanism, and I have good eyesight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "Besides, there's nowhere on the ledge that you could build one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "Bye-bye, kiddo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850323,
					"content": "Oh no! He's getting away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "We can't hesitate any longer. The only way to get across is to glide there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "But... but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "Don't worry — I'm the Gliding Champion of Mondstadt, remember! If Raptor can do it, I can do it too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "Oi, Outrider! You have less chance of surviving this than jumping off the Anemo God statue in Mondstadt without your wind glider! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850328,
					"content": "I'm with Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#Paimon sees your point {NICKNAME}... If you rule out everything that's completely impossible, gliding is the only idea left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, remember that book I lent you? The one I thought was the gliding manual, but wasn't?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "The first birds couldn't fly. Flight was their reward for their courage to plunge into the canyon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "Be my witness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "Go! Go! Outrider!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "Roger! Let's show this guy what an Outrider is made of!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "Wait... Stop! You'll never make it! Come on, off you go now, back home like a good little girl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850337,
					"content": "Raptor says I'll never make it. But, if you listen carefully...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "The wind! The wind says I WILL make it, and that's good enough for me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "This will take some serious guts, but it's not completely impossible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "Some kind of elemental magic?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME}, can you see anything with your Elemental Sight...? No? Oh, okay... Never mind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "A grappling hook, or spikes, or something?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "If it's too far to glide, it's definitely too far for anything like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "There's also no sign of an anchor point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "Let's examine our surroundings — just like you taught me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "Alright! I got him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850602,
					"content": "I only noticed the wind current from in the air — and it's the only one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850603,
					"content": "It would be suicide to try and escape in the direction Raptor was going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850604,
					"content": "In other words, the only way Raptor could have gotten out would be this way — past us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850605,
					"content": "Aha! So he was just trying to fool us by acting smug, in the hope that we would just give up and leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850606,
					"content": "Little did he know, we're not so easily fooled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850607,
					"content": "#It was all thanks to {NICKNAME}'s sharp thinking! Just like a wise man once said, \"Once you eliminate the impossible, whatever remains, no matter how improbable, must be the truth.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850608,
					"content": "At the end of the day, gliding is seven parts technique, three parts instinct — and then 90 parts courage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850609,
					"content": "What you did now looked more like 99 parts courage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850610,
					"content": "Ah, it was just like in my first gliding exam... I was super nervous, but in the end, there was nothing to be afraid of and I passed no problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850611,
					"content": "I kinda missed that nervous rush in the exams I've done since then... It just wasn't the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850612,
					"content": "...Erm, sorry — Paimon thought you said you passed no problem? What do you mean, exams since then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850613,
					"content": "Ah... Well you see, the thing is, Mondstadt is all \"no glide zone\" this, \"no landing zone\" that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850614,
					"content": "*sigh* Every time I get my license it keeps getting revoked. I must have taken the exam about 15 times altogether...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850615,
					"content": "But I always pass the first time. I guess my little gliding manual ain't so bad after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850616,
					"content": "#...{NICKNAME}, let's go and get a copy of the real gliding manual from Acting Grand Master Jean some time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850617,
					"content": "Sounds good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "I'll head off first because I need to escort Raptor back to the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850620,
					"content": "Once you're back in the city don't forget to come find me at the Cathedral. I'll issue your gliding license there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850618,
					"content": "I feel sorry for Jean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				}
			]
		},
		{
			"id": 48508,
