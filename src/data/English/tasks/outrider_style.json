			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4851101,
					"content": "There's only one way over there. Raptor must be up ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851102,
					"content": "However, it looks like the only way we can catch up is if we glide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851103,
					"content": "But there's a ton of enemies below... They'll definitely attack us after we take off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851104,
					"content": "If we're gonna do this, <color=#00E1FFFF>we'll have to glide and defeat them in one fell swoop</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851105,
					"content": "#{NICKNAME}, you still had one stage to go in your exam, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851106,
					"content": "Yeah, but what's that got to do with anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851107,
					"content": "#How about we make this the third and final stage of your gliding exam, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851108,
					"content": "Are you sure that's how the exam is supposed to go!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851109,
					"content": "#It's a custom version of the exam for {NICKNAME}, designed by yours truly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851110,
					"content": "#Besides, the normal version of the exam wouldn't be fit for the hero of Mondstadt {M#himself}{F#herself}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851112,
					"content": "Watch me nail this exam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851113,
					"content": "Watch me nail Raptor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851111,
					"content": "#So, what do you say, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851114,
					"content": "Woohoo! Good answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851115,
					"content": "#{NICKNAME}, prepare for take-off! Raptor awaits you once you <color=#00E1FFFF>defeat all these enemies</color>, then that gliding license is yours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}