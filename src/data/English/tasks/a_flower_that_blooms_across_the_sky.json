			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapurva",
					"Avin",
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "Um, Paimon's been meaning to ask what you meant by \"prepared.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320102,
					"content": "Nara Avin has not completely remembered. Memories and dreams are both necessary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320103,
					"content": "Dreams...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320104,
					"content": "But I'll never be able to stand again. Even if I can recover, I don't know how long that'll take.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320105,
					"content": "Such worries are not needed here. Nara Avin, you must remember. Dreams are connected to your heart, not your body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320106,
					"content": "My heart...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320107,
					"content": "I led you this far, but now Nara Avin must find her precious things by herself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320108,
					"content": "Huh? He's gone, just like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320109,
					"content": "It looks like the sky here has changed somewhat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320110,
					"content": "My heart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320111,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320112,
					"content": "Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320113,
					"content": "I... stood up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320114,
					"content": "It wasn't hard at all, and it didn't feel weird. It was like... how things were before I got sick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320115,
					"content": "Wait, so that means we're...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320116,
					"content": "We're inside a dream.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "Not our first time in one. Ah, no wonder Arapurva said not to worry... Avin can move freely in this dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320118,
					"content": "Wow, that's amazing, is this... the power of my heart?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320119,
					"content": "How amazing! Now we can all look for Arashani together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320120,
					"content": "C'mon, let's race! Lemme see how good you really are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320121,
					"content": "I might not have recovered yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320122,
					"content": "Whatever, let's go! I won't lose, not even to an adult!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320123,
					"content": "Ah, and off she goes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320124,
					"content": "Well, this was easy. Paimon thought she'd need more time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320125,
					"content": "I guess that's what they call aptitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "Hehe, that's true. Let's catch up with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320126,
					"content": "That's the power of a wish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
		{
