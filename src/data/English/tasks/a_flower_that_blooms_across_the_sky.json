			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya",
					"Niousha",
					"Avin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "Sumeru's such a nice place. I'll be back for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321106,
					"content": "You will always be welcome here. Avin would be happy to see you again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "Niousha"
				},
				{
					"id": 130321107,
					"content": "It's a deal! I'll be waiting for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321108,
					"content": "Hahaha, you got it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321109,
					"content": "Yoimiya, before you go back, I want to tell you about my new dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321110,
					"content": "I want to travel to Inazuma on my own and watch a fireworks show there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321111,
					"content": "Wow, that's impressive! Hehe, I didn't expect to be introduced to new customers while on vacation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321112,
					"content": "Don't worry, I'll make you some fireworks that you'll never forget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321113,
					"content": "You two as well. No matter how busy your adventures get, remember to come back to Inazuma. We'll always welcome you, no matter when you drop by!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321114,
					"content": "You've got to come and watch the fireworks this meteor shower inspired as they soar high in the sky!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321115,
					"content": "Sounds like a plan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130321116,
					"content": "Take care, Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "I will, I will! Haha, you're as earnest as ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321122,
					"content": "Oh yeah, by the way, have a look at this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321123,
					"content": "An Aranara Carving...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "That's right. This is the one you helped me pick, and you said it looked kinda like me. I went to buy another one — this one's for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321125,
					"content": "Look at it whenever you're feeling down. Who knows, maybe it'll raise your spirits. If nothing else, you'll know that I'm supporting you all the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321126,
					"content": "Of course, meeting in person is still better, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321127,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "Okay, I'll be heading back now. I'm sure we'll meet again soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321130,
					"content": "I really loved the trip you prepared for me — in fact, I'm totally impressed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321131,
					"content": "No matter where you two go, I know that our friendship and its warmth will support you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321132,
					"content": "So go forward — to the end of your journey, and to the ends of this world!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321133,
					"content": "See you around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321128,
					"content": "I'll treasure it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "May all your days be filled with happiness.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "Every day, and forever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321120,
					"content": "Fireworks are for now, but friends are forever!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "Wh—Why'd you just shout that out? It's embarrassing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
