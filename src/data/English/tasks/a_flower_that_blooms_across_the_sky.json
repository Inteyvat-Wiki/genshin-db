			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320901,
					"content": "Mmm... Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320902,
					"content": "We're waking up already? But Paimon wants to watch more...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320903,
					"content": "The meteors we summoned flew up from the ground...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320904
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320904,
					"content": "They were exactly like fireworks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320905
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320905,
					"content": "Ah, I could've kept watching that forever. That was the realest, grandest, most magical dream I've ever had!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320906,
					"content": "Paimon too! Paimon didn't expect you to just pull us onto that shooting star, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320907,
					"content": "Hehe~ Honestly, I didn't think about it at all. I just thought it'd be a shame if we didn't try something crazy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320908,
					"content": "Yoimiya, you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "You already knew that it was a dream.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "You know me. It really doesn't matter to me if our experience was real or a dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320911,
					"content": "I really should thank you two, though. You set all this up as a backup plan because you knew that meteor showers are hard to catch, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320912,
					"content": "Don't worry, I loved it so so so much! I think this ranks as the absolute best gift I've ever been given.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320913,
					"content": "Oh phew, that's good. Paimon was afraid that you might be angry after hearing the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320914,
					"content": "Why would I be? I dreamed about helpful, friendly, cute Aranara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320915,
					"content": "I dreamed that we ran and jumped atop large mushrooms, and we discovered Urstone in a very unexpected way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320916,
					"content": "And when I thought we had woken up, the next part was even more amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320917,
					"content": "From her heart, Avin brought forth Urstone glasses. We found meteors that flew up from the earth, and we even became one with the shooting stars themselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320918,
					"content": "We've been in a dream.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "Who's to say we've woken up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "That's right. Dreams themselves may be imaginary, but they're also experiences that can never be relived or replicated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320921,
					"content": "If we were sticklers about truth and fiction, we would've missed out on so much beauty and emotion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320922,
					"content": "Hehe, you sure know your way with words. Paimon's gonna bump you up a few places on the \"Paimon's Best Friends\" list!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320923,
					"content": "So there's a leaderboard for that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "Um, by the way... the Aranara, they don't usually like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320925,
					"content": "Oh yeah, they're so cute! We really have to thank those lovely carvings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320926,
					"content": "The wood carvings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320927,
					"content": "Yeah. If we hadn't seen those wood carvings, then we wouldn't have dreamed of such cute Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320928,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320929,
					"content": "Yoimiya gets it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "I think they're cuter than the carvings.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "Hehe, don't worry, I know. I think they're very cute, and I'm happy to protect them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320932,
					"content": "Well, it's almost time. Let's send her home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321101,
					"content": "After sending Avin home, you and Yoimiya spend a few more days in Sumeru.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
		{
			"id": 1303211,
			"completionStepIds": [
				1303211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
