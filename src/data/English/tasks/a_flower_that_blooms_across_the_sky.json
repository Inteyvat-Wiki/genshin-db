				]
			},
			"dialogs": [
				{
					"id": 130320201,
					"content": "*pants* You're... good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320202,
					"content": "Hehe, if we had run any further, you would've caught up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320203,
					"content": "Avin was neck and neck with Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320204,
					"content": "I've outrun lots of adults before. Long legs don't necessarily mean you run faster. Training's important, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320205,
					"content": "Haha, I won't even be able to compete with you in a few years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320206,
					"content": "Hm, let's see... Where should we go next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320207,
					"content": "Ah, look! Something's floating up ahead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320208,
					"content": "It looks like a... star?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "Does it want us to follow it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320210,
					"content": "Hmm, maybe. Let's follow it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1303205,
			"completionStepIds": [
				1303205,
				1303214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303205",
							"2"
						],
						"stepId": 1303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avin",
					"Yoimiya",
					"Arashani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "So this is our destination? But Paimon doesn't see an Aranara. Just this big stone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320502,
					"content": "I'm so happy... I almost forgot how it feels to be this happy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320503,
					"content": "You know, at first, it felt like my world had shrunk down to a tiny space.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320504,
					"content": "But as long as I continue moving forward, new sights will always appear in front of me, and my world will keep expanding before my eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320505,
					"content": "Even though I don't know how I did it, I know I have you all to thank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320506,
					"content": "Oh, that's not important. What's important is that you've remembered the joy of going through the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320507,
					"content": "Our memories don't just symbolize our past. They can also shine a light on our future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320508,
					"content": "Once you find the hope in your heart again, that happiness will come back to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320509,
					"content": "Yes! Thank you, Yoimiya! Thank you all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320510,
					"content": "Let's keep looking for Arashani. It doesn't look like he's here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320511,
					"content": "Yeah... Uh, then why would the star lead us here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320512,
					"content": "This stone really stands out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "I dunno how to explain this... I don't know what it is, but it feels very familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320514,
					"content": "Almost like it's a part of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320515,
					"content": "I know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320516,
					"content": "Could this stone be your Urstone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320517,
					"content": "Ur—Urstone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320518,
					"content": "(Yoimiya's good at ad libbing.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "(I'd almost forgotten about that.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "It's a very rare ore that symbolizes a person's aspirations and dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320521,
					"content": "Since you can see it, that means you've found what you've lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320522,
					"content": "Is that how it works...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320523,
					"content": "It's just like in fairy tales... I thought I'd stopped believing in those.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320524,
					"content": "But I'm glad that I found that belief again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320525,
					"content": "Eh? Th—They passed right through!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320526,
					"content": "Let's go after them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320527,
					"content": "Hey, Yoimiya! HEY! ...Well, we have no choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320528,
					"content": "We passed through, but nothing seems to have changed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320529,
					"content": "It has been a while, Nara Avin. It really has been a while, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320530,
					"content": "Arashani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320531,
					"content": "Why do you look sad? Oh. Arashani knows. You are happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320532,
					"content": "Arashani! *sobs*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320533,
					"content": "Aw, the Aranara sure have a flair for magical journeys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320534,
					"content": "They not only helped Avin find her best friend, but they also showed us what an Urstone is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320535,
					"content": "Oh, um, we have to look for one of our own later — to make the purest lens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320536,
					"content": "Yep! It's kinda funny, but Paimon thinks we can actually do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320537,
					"content": "That's an adventure for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "This has been pretty fun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "But we have to bring her back to Sumeru City first. Her mother must be worried sick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320540,
					"content": "The scene before you is akin to a dream. Before you know it, you are returned to where you previously were.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1303206,
			"completionStepIds": [
				1303206,
				1303207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303206",
							"2"
						],
						"stepId": 1303206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avin",
					"Yoimiya",
					"Arashani",
					"Arapurva"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320601,
					"content": "It... The dream ended.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320602,
					"content": "We dreamed a most lovely dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320603,
					"content": "Don't look so lonely! He's right next to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320604,
					"content": "Arashani! Y—You're... still here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320605,
					"content": "Arashani wants to say sorry. It is not that Arashani did not want to find Nara. Arashani could not remember the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320606,
					"content": "Arashani does not dare enter the city. Arashani did not see Nara Avin, so Arashani thought you had made new friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320607,
					"content": "That is normal and unavoidable. It is not something to be grieved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320608,
					"content": "It's okay, I understand. This happened because I lost sight of myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320609,
					"content": "But I think I understand now. Yoimiya's right. Everyone gets bad luck, but we have to support each other through unlucky times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320610,
					"content": "Thanks for helping me rediscover my memories and dreams. I won't let your work go to waste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320611,
					"content": "Hehe. You've also helped us a lot, so don't be so humble! To be honest, we didn't know where to start with the Urstone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320612,
					"content": "But now that we're on this track, I think we'll find it easy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320613,
					"content": "Yoimiya, you need this Urstone because you want to see a meteor shower?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320614,
					"content": "Yep. Oh! Once we find it, you should come with us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320615,
					"content": "If that's how things are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320616,
					"content": "I'm happy to lend you my Urstone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320617,
					"content": "Wha!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320618,
					"content": "Wh—What just happened? Did you just take... glasses out of your chest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320619,
					"content": "I have no idea what's going on, either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320621,
					"content": "Hahaha, how'd you know we'd need this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320622,
					"content": "I didn't. I just thought that since you helped me find my precious friend, I should help you using something precious to me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320623,
					"content": "And then the light turned into this. Is this what you needed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320624,
					"content": "Thank you. I didn't expect us to solve our problem like this. Alright, time to give it a go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320625,
					"content": "Not that I know how to use it, but let's see what my intuition says.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320626,
					"content": "Where are you... Where are you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320627,
					"content": "Ooh! I think I see it! Oh, uh... It was pretty obvious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320628,
					"content": "C'mon, I'll lead the way. Once we're done watching the meteor shower, I'll accompany you home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320629,
					"content": "Also, thank you for helping us. Actually, let me scrap the pleasantries and give you a heartfelt compliment instead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320630,
					"content": "You all are great storytellers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320631,
					"content": "Oh, what a coincidence. I would say the same for you, Red Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapurva"
				}
			]
		},
		{
			"id": 1303209,
