			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221110101,
					"content": "Any new Commissions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110102,
					"content": "Greetings, Adventurer. The tales of your deeds are now known to all in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110103,
					"content": "Continue in this fashion and you are destined to become one of the great Adventurers of our age.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110104,
					"content": "Got anything for me to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "If you wish to become a great Adventurer, there comes a time when you must move beyond the places you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110106,
					"content": "Now you have amassed such a wealth of adventuring experience, perhaps it is time for you to explore somewhere new.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110110,
					"content": "Take this letter and deliver it to Liyue Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110111,
					"content": "...There's a Katheryne in Liyue too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "Yes. I'm sure you will have no trouble finding her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110115,
					"content": "Anyway, once Liyue Katheryne has this letter, she will be your point of contact there for all your adventuring needs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110116,
					"content": "Of course, whenever you are back in Mondstadt I will still be delighted to be of service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110117,
					"content": "I would ask that you refrain from opening the letter en route. If anything were to fall out, it could cause complications.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110118,
					"content": "Adventurer! The time has come for you to take the next step towards the stars and the abyss. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110113,
					"content": "Should I call you \"Mondstadt Katheryne\" in the future, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "If it helps advance your adventuring career, call me whatever you like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110107,
					"content": "But Mondstadt is all I know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "That is because your adventures this far have all been limited to the Mondstadt area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110109,
					"content": "But all that is about to change. Soon, you will be able to venture into the world beyond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2211102,
			"completionStepIds": [
				2211102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211102",
							"2"
						],
						"stepId": 2211102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221110201,
					"content": "I have a letter for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110202,
					"content": "Ad astra abyssosque! Welcome to the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110203,
					"content": "I suspect this is for you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "A letter? For me? Oh... So, you're an Adventurer from Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110205,
					"content": "What's this — a Dandelion? Why is there a Dandelion in the envelope?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110206,
					"content": "Adventurer, did you place a Dandelion in this envelope to try and prove you are from Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110207,
					"content": "There's really no need. There is more than enough information contained in this letter to establish your identity and background.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110208,
					"content": "It wasn't me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "Not that it really matters, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110214,
					"content": "This letter from the Mondstadt Adventurers' Guild says that you are a highly experienced Adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110215,
					"content": "If that's true, I'm sure you are ready to take on Commissions from the Liyue Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110216,
					"content": "A whole new world of wild adventure awaits you. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110210,
					"content": "I bet it was Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "Katheryne? ...Oh, you must mean Mondstadt Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110212,
					"content": "Why did she put a Dandelion in with the letter? Very odd... A Dandelion isn't much use to an Adventurer, now, is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110213,
					"content": "Not that it really matters, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}