			"dialogs": [
				{
					"id": 706960201,
					"content": "Miko gave us a pretty generous stash of comics. Since the plan is to share them with the group, why don't we display them somewhere that everyone can see?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960202,
					"content": "Let's put them near the book stand at the Legion of Soulblazers' camp. That way, it'll be easy for people to browse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960203,
					"content": "You borrow a bookcase and arrange the comics from Miko on the shelves.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960204
					]
				},
				{
					"id": 706960204,
					"content": "Nice, it's looking good! Now people can come and pick some out when they're free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
