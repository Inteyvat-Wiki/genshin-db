			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010301,
					"content": "Did you bring the goods back? Thank you so much, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010302
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010302,
					"content": "You wanted... rice, right? Please wait a moment, I will pick rice of better quality for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010303
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010303,
					"content": "There! This rice is for you, it should be enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010304
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010304,
					"content": "Thank you, Traveler. I should be on my way now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010305
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010305,
					"content": "I hope I don't meet any more monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				}
			]
		},
