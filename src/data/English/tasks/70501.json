				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010101,
					"content": "One wonders if this device may make desserts also...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010102
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010102,
					"content": "What are you making this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010103
					]
				},
				{
					"id": 705010103,
					"content": "Impeccable timing, Traveler. One just finished ruminating on the making of this next dish — a \"pudding,\" so it is named.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010104
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010104,
					"content": "Much consultation did one have with the most recent and popular recipes before deciding on this dish. It is said to be soft and tasty — a fine dessert indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010105
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010105,
					"content": "Changes and improvements, too, has one made to it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010106
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010106,
					"content": "...Along with the addition of rice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010107
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010107,
					"content": "Naturally, one's entitlement it is to name this new dish. Mmm... \"Rice Pudding\" shall its name be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010108
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010108,
					"content": "Sounds really filling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010109
					]
				},
				{
					"id": 705010109,
					"content": "The quality of the rice is key to this dish. Upon one's activation of the Supreme Cuisine Machine, order it one did to search for high-quality rice. The resulting search led one here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010110
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010110,
					"content": "Well now, Traveler. Since you are presently here, will you help one collect some rice of fine stock? The Machine indicates that it may be found not far from here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010111,
						705010112
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010111,
					"content": "Why is it me again...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				},
				{
					"id": 705010113,
					"content": "This device needs tending, and one cannot be in two places at once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010114
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010114,
					"content": "Skilled you are in mind and hand, and are thus an invaluable helper. Go forth to one's aid, and one promises that you shall have a share in the Rice Pudding also.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010115
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010115,
					"content": "Well then, one presumes upon your aid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010116
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010116,
					"content": "Supreme Cuisine Machine... activate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010117
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010117,
					"content": "Traveler, one has now activated the machine. Follow the tracks it has created and retrieve the Rice that one desires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705010112,
					"content": "Can't you fly...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010113
					]
				}
			]
		},
		{
			"id": 7050102,
			"completionStepIds": [
				7050104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050104",
							"2"
						],
						"stepId": 7050104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brunn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705010201,
					"content": "Thank you! You saved my life... I'm Brunn, a merchant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010202
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010202,
					"content": "*sigh* Just my luck. I was originally transporting a batch of cargo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010203
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010203,
					"content": "But... I never expected to get attacked by monsters while I was on my way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010204
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010204,
					"content": "I just kept running, I didn't have time to worry about the goods, or to tell which way I was going... Eventually, I ended up here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010205
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010205,
					"content": "After I got here, I thought I had completely shaken them off. That's why I wanted to get out of the cart and check the goods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010206
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010206,
					"content": "But they suddenly came out of nowhere... Thank goodness for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010207
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010207,
					"content": "What kind of goods are you transporting?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010208
					]
				},
				{
					"id": 705010208,
					"content": "I'm transporting a batch of ingredients, rice and stuff like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010209
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010209,
					"content": "Looks like this is the rice that the adeptus wanted us to find, but it doesn't look like there's much left...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705010210,
					"content": "Could you sell me some rice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010211
					]
				},
				{
					"id": 705010211,
					"content": "You want to buy rice? It's not that I don't want to sell it, it's just that...I basically lost all the goods in my cart on the road when I was running away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010212
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010212,
					"content": "Those monsters must have brought the goods as loot back to their camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010213
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010213,
					"content": "What a headache. How can I get those goods back? If I can't get them back, I will lose a lot of money...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010214
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010214,
					"content": "Traveler... I see that you are very skilled. Can you help me get those goods back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010215
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010215,
					"content": "I—If you are willing to help me, I will give you as much rice as you want!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010216,
						705010218
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010216,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010217
					]
				},
				{
					"id": 705010217,
					"content": "Thank you! I'm counting on you then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010220,
					"content": "Bring my transport balloon along and place the goods on it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010221
					],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010221,
					"content": "I'll leave it to you, Traveler. I'll be waiting for you here. After you get the goods, please bring them back to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brunn"
				},
				{
					"id": 705010218,
					"content": "I don't think I can carry so many goods...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705010219
					]
				},
				{
					"id": 705010219,
					"content": "Don't worry, I have a solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705010220
					],
					"speakerTitle": "Brunn"
				}
			]
		},
		{
			"id": 7050103,
			"completionStepIds": [
				7050107
			],
