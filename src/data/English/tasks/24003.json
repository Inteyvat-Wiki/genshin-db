			},
			"dialogs": [
				{
					"id": 240030901,
					"content": "#Hey! Did you tell {M#him}{F#her} about my spot? How did {M#he}{F#she} find me that quickly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030902,
					"content": "I've told you this before. Your hiding spots are way too obvious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030903,
					"content": "Experience is on my side, I fear.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "Really? In that case, will you come over next time too? Could we play together again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030906,
					"content": "Our parents aren't at home in the day, and my big brother's always reading... No one has time to play...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030907,
					"content": "Well, you can do what I do and read the books on the shelves. That's a lot more useful than playing hide-and-seek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030908,
					"content": "Well... I'd rather go look for Mom and learn sewing from her...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030904,
					"content": "I'm very good at hide-and-seek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				}
			]
		}
	]
}