				"objectNames": [
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "When will Verut grow up... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030702,
					"content": "Not hiding?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "I never really intended to. If Verut didn't bother me as often as he does, I would prefer to read my books for a while more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030704,
					"content": "Our parents work so hard, so I've got to grow up fast and help lighten their load.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030705,
					"content": "But Verut keeps saying that he misses Mom, so I have to accompany him. That way, he'll stop crying for a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030706,
					"content": "Sorry, I've said too much. I'll be waiting at our meeting spot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030707,
					"content": "I can only hope that Verut won't dirty his clothes this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
