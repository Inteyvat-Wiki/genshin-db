			"dialogs": [
				{
					"id": 223040801,
					"content": "I almost forgot, do you know how to read these Treasure Maps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040802
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040802,
					"content": "Frankly, I couldn't make head or tail of them when I first got them, so I had several people take a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040803
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040803,
					"content": "They figured out more or less where the treasure is. But they said if I went to look for the treasure, I should pay them an extra fee... That's why I never bothered to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040804
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040804,
					"content": "If it saves you the bother, I can mark the location for you, no problem. Just say the word.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040805
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040805,
					"content": "But, y'know, I'd have to make you pay a contribution... Let's call it <color=#00E1FFFF>100 Mora</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040806
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040806,
					"content": "What do you say? Shall I <color=#00E1FFFF>mark the location</color> on the Treasure Maps for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
