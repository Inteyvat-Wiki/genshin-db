					}
				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "Well, well, if it isn't our regulars! Here to invest again, are we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470202,
					"content": "A little bird told me your investment coupons are a scam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "Really now? You sure you're not just letting your imagination run wild because you've been running at a loss so far?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470204,
					"content": "Think about it. How could there be any business that only earns but never costs any capital? Some will win, and some will lose. Why, back when I was in Sumeru City... Ahem. I mean, I've been unlucky for a while now, but we can never know when that might change.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470205,
					"content": "\"Hope\" can only be seized by the persistent. You've gotta keep investing if you ever wanna see any return!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470206,
					"content": "Alright. Guess I'll come back again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "Wait, you can't be serious. You're gonna accept it, just like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470209,
					"content": "#That's not gonna end well for you, buddy. We're... Right, we're the famous {NICKNAME} and Paimon. We've got plenty of friends here in Nasha Town!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470210,
					"content": "\"Friends\"... What do you mean— Wait. Do you mean \"that\" kind of friends!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470211,
					"content": "...Huh? Uh, yeah, right! They're exactly the kind you're thinking about — and we've got lots and lots of 'em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470212,
					"content": "What!? Wh—Why didn't you say so before!? I... Uh. Look. I'm sorry, alright? I'll leave you both alone. Just... take this. All of it. Take it and go, and don't come around for coupons again — not that I'd sell you any, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470208,
					"content": "Trying to pull the wool over my eyes, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
}