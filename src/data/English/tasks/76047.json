			},
			"dialogs": [
				{
					"id": 760470101,
					"content": "Uh... So, I've been observing you two for a while now, and...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "Ooh. Spying on us, you mean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "Oh, no, I just... I'm often here looking for books, and just happened to notice that you two were very interested in investing. I... must advise against it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "Well, we haven't exactly been earning big, that's true... but why would you advise against trying at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Because I suspect there can be no \"generous returns\" at all. The boss still has many debts to pay off, and likely won't risk taking any losses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "My friend was once caught in a similar scam, so it would be best if the two of you didn't continue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#Wait, could it really be a scam...? {NICKNAME}, we've gotta find that guy and get to the bottom of this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
