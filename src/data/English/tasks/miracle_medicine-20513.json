					"speakerTitle": "Anthony"
				},
				{
					"id": 205130302,
					"content": "Got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130303
					]
				},
				{
					"id": 205130303,
					"content": "Huh. This Windwheel Aster does feel different from normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130304,
					"content": "Hahaha. Don't ask me why, but I have a feeling that if Anna eats this medicine, she will certainly get well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130305,
					"content": "Maybe her recent improvement's been getting my hopes up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130306,
					"content": "All the same, thank you so much. Take this as compensation for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130307,
					"content": "Hope Anna gets well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130308
					]
				},
				{
					"id": 205130308,
					"content": "Thank you. She will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130309
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130309,
