			},
			"dialogs": [
				{
					"id": 761630101,
					"content": "...Sonnet. You've been ditching work and sneaking out to play with humans more and more often these past few years, haven't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630102,
					"content": "Wh—What's the big deal! We can just leave the work to those Moon Envoys anyway, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630103
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630103,
					"content": "You've taken a shine to our new master, sisters, and they're willing to send subordinates to share our work, so what choice do I have but to accept?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630104
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630104,
					"content": "Besides, you've been having a great time playing around too, Canon! You even participated in a human festival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630105
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630105,
					"content": "...That was part of my duty. Their high priest called my name. It is only natural that I had to respond to their voices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630106,
					"content": "Is pretending to be an ordinary human girl and dancing in front of your own statue also one of your duties? That's news to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630107,
					"content": "...Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630108
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630108,
					"content": "Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630109
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630109,
					"content": "...I wasn't asking you to call my name... Oh, forget it. Since the new Moon Envoy doesn't mind helping Sonnet with her work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630110,
					"content": "Zibai. Her name is Zibai. You really should remember people's names.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630111
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630111,
					"content": "...Since Zbai has no objections, I have nothing more to say. However, Sonnet, as The Will of the Moon, you must not forget the basic formulae that keep the world running.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630112
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630112,
					"content": "Prepare yourself. I will set you some foundational problems on verifying morphological isomorphisms. You are not to go back to the surface until you have solved them all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630113
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630113,
					"content": "Hehe, how mean. You're just like a villain from an earthbound novel trying to drag the runaway princess back to the moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630114
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630114,
					"content": "What she said!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630115
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630115,
					"content": "...You are the moon! Don't say things like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}