						"stepId": 200507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ken",
					"Tadao",
					"Gou",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050801,
					"content": "We really outdid ourselves this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050802
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050802,
					"content": "All those samurai houses packed with goods, haha! We really hit the jackpot. I mean, besides that one house...",
