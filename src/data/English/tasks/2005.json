	"talks": [
		{
			"id": 200501,
			"completionStepIds": [
				200501
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200501",
							"2"
						],
						"stepId": 200501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Oomori",
					"Yuuya",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "They say the Tenryou Commission is directly controlled by the shogun. They're the ones responsible for maintaining law and order in Inazuma — the ones actually enforcing the Vision Hunt Decree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050102,
					"content": "But why would they take action against one of their own?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050103,
					"content": "Paimon doesn't get it... Huh? There seems to be some commotion over there, let's go see what's happening!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050104,
					"content": "I'll ask one more time... Do you intend to withhold this month's emergency provisions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050105,
					"content": "The entire clan is counting on that food. We demand an explanation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050106,
					"content": "How many times do I have to say it... I don't know anything about emergency provisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050107,
					"content": "You dare deceive us! Those provisions are essential, do you understand? Not some goods to be pocketed by greedy samurai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050108,
					"content": "You samurai think that you can just do whatever you please!? The Tenryou Commission will hear of this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050109,
					"content": "Emergency provisions... like emergency food?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "Huh? And who are you? One of Kurosawa's gang, no doubt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050111,
					"content": "What? We just happened to be passing by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050112,
					"content": "We heard the commotion and came to see what the matter was.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050113,
					"content": "I see, you seem to have come just at the right time. Perhaps you can help us settle this matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050114,
					"content": "This is Kurosawa, he's a samurai and a member of the Shogun's Army. They issue emergency provisions to the area, and he's the one responsible for distribution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050115,
					"content": "In the past we'd simply ask him for provisions and everything would be delivered. Now, he suddenly refuses to give us anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050116,
					"content": "He's keeping the provisions for himself, I just know it! We'll starve without them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050117,
					"content": "No one seems to care about us... We used to think Kurosawa was a kind man, but he's shown his true colors. He's the same as all the other samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050118,
					"content": "It's no wonder all the Visions have been confiscated. The Raiden Shogun doesn't need people like him helping her rule the nation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050119,
					"content": "This must be one of the people Ayaka asked us to help. But why would she ever want us to help someone like him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050120,
					"content": "Maybe we should talk to Kurosawa and see what he has to say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200503",
							"2"
						],
						"stepId": 200503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ken",
					"Tadao",
					"Paimon",
					"Gou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "Ugh, there goes all the Mora... We worked hard to steal that, ya know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050202,
					"content": "C'mon boss, think of something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050203,
					"content": "Ahem... Not bad, kid... Y—You ever think of joining the Treasure Hoarders? We could use someone like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050204,
					"content": "Forget it. Tell us all you know about Kurosawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "Kurosawa? Oh... I remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050207,
					"content": "So he's the one who sent you after us, huh? Tsk, just our luck... I knew we shouldn't have hit that place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050208,
					"content": "So what did you see inside? Was it stuffed with food supplies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050209,
					"content": "Food supplies? You kidding? That place was a complete mess... All we found was a strange-looking box, hopefully with valuables inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050210,
					"content": "I didn't want anyone else to see it, so I was planning on opening it myself once we got back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050211,
					"content": "But now that you've caught us, how about we make a deal? That little box for our freedom... Whaddya say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050212,
					"content": "You've got a deal. Now show us what's in the box!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050213,
					"content": "Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050214,
					"content": "What the!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050215,
					"content": "Th—There's nothing in here but IOUs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050216,
					"content": "Yeah, a lot of them, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050217,
					"content": "And they all seem to be made out to the owner of a general goods store, a Miss Aoi... We're talking tons of Mora here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050218,
					"content": "We'd better go talk to this Miss Aoi and get to the bottom of this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050219,
					"content": "As for you guys, you're free to go. Just pray that our paths don't cross again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050220,
					"content": "Y—Yes, of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050221,
					"content": "So we redeemed ourselves for some IOUs... does that mean we broke even?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050222,
					"content": "Shut it! Let's just get out of here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050205,
					"content": "Not likely. Word has it you looted Kurosawa's house.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aoi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "Welcome to Tsukumomono Groceries, we've got everything you need. Can I help you find something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050302,
					"content": "Or perhaps... there's something you want to inquire about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050303,
					"content": "About these IOUs...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "Ah, so you're friends of Kurosawa, I take it? Haha. Perhaps you're here to pay off his debts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050305,
					"content": "Whoa, whoa, let's not get ahead of ourselves... We're just here to learn where they all came from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050306,
					"content": "How did Kurosawa end up owing you so much money? Did he buy anything super-expensive here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050307,
					"content": "Let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050308,
					"content": "Kurosawa would come regularly to purchase large quantities of foodstuffs. He'd always put the payment on his own account.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050309,
					"content": "However, the price of provisions began to skyrocket recently, and his salary was no longer enough to cover the cost. So, he started writing out IOUs to cover whatever he couldn't afford of the usual amount.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050310,
					"content": "So that's how he was getting those emergency provisions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050311,
					"content": "But why did he have to purchase a \"usual\" amount? If the prices increased, couldn't he just buy less?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050312,
					"content": "Well if you think about it, the citizens receiving the emergency provisions must have been carefully calculating how much they needed to sustain them each time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050313,
					"content": "Kurosawa thought that it would be quite the disappointment for them if they found they didn't have enough. Especially after such long and careful planning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050314,
					"content": "So he deemed it necessary to take on the debt rather than let the people down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050315,
					"content": "Wow, Kurosawa was purchasing all the emergency provisions at his own expense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050316,
					"content": "...and no one ever appreciated what he did... They just complained and held him accountable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050317,
					"content": "People's attitudes will always reflect their circumstances. In the face of hardship, nobody cares to think twice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050318,
					"content": "If you ask me, had Kurosawa told everyone the truth about the supplies from the start, then there wouldn't be such a severe backlash now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050319,
					"content": "Of course, I'm sure there would still have been some unrest. What he was doing was truly a thankless deed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050320,
					"content": "As for why he chose to spend his own money on emergency provisions and never tell anyone... I'm still not too clear myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050321,
					"content": "If you're still curious, why don't you go ask him yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050322,
					"content": "Unfortunately, he doesn't remember.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "I see... That reminds me... it seems that his Vision was recently confiscated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050324,
					"content": "Most unfortunate... If he doesn't clear the debt on his name, he'll have no choice but to sell that sword that is so dear to him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050325,
					"content": "Sword? What sword?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050326,
					"content": "Didn't he tell you? He possesses a very valuable blade... He's carried it for years now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050327,
					"content": "I've asked him about its origins — he told me that it was a gift from his father... that it was too precious to sell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050328,
					"content": "In hindsight, I regret that I never made an offer on it... Everything has its price, at least that's what I think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050329,
					"content": "Why don't you ask him about the sword yourself? Perhaps it'll even provide you with the answers you are looking for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050330,
					"content": "Oh, but before you go, if you would kindly settle today's bill...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050331,
					"content": "Eh? But we didn't buy anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050332,
					"content": "Hehe, information is also a kind of commodity, wouldn't you agree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050333,
					"content": "Don't worry, I won't charge much for information about Kurosawa. Nothing we ever discussed was explicitly confidential anyway. Let me think... 2,000 Mora should be a fair price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050334,
					"content": "Fair enough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "At least we now know where the emergency provisions were coming from, plus we found out that Kurosawa has a priceless sword in his possession.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050336,
					"content": "Let's go talk to Kurosawa again and see if he can remember anything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200504,
			"completionStepIds": [
				200505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200505",
							"2"
						],
						"stepId": 200505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "Umm, what are you doing here all by yourself? Where did those other two go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050402,
					"content": "I presented them with a choice: either they left or I drew my sword. They left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050403,
					"content": "It turned out to be a real time-saver, actually. Perhaps I should start using it more often...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050404,
					"content": "Did you manage to track down the Treasure Hoarders? Everything I said was true, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050405,
					"content": "Actually...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "That just about sums it up. It turns out that you really were distributing emergency provisions, but they were all purchased at your own expense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050407,
					"content": "Strange... Is that really the kind of person I was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050408,
					"content": "I don't really have any such recollection. Even after all you've told me, I still don't remember anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050409,
					"content": "Why was I purchasing emergency provisions for everyone? And why would I put myself in such a difficult situation... *sigh* I really don't understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050410,
					"content": "But I cannot deny that when I brandished my sword to scare those two away, I could sense that my body was somehow reluctant to do so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050411,
					"content": "The sword...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "This sword was once wielded by my father.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050414,
					"content": "I remember once when I was young, I wanted to sneak out with the blade and show it off to the kids next door. My father ended up catching me in the act and scolded me severely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050415,
					"content": "What did he say... Huh. I can't seem to remember that either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050416,
					"content": "It would seem that I forgot many important things when my Vision was taken from me. So many memories, gone forever, no matter how hard I try to remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050417,
					"content": "All I can remember now is my father telling me that this blade bore his life's creed. Before he passed away, he placed the sword in my hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050418,
					"content": "...and said to me, \"With this sword, you should—\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050419,
					"content": "Hey... If you look carefully, there seems to be some words engraved on the hilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050420,
					"content": "Can you recognize the words?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050421,
					"content": "The words are: \"Virtue and Justice.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "\"Virtue and Justice\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050423,
					"content": "Somehow, those two words seem to explain everything now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050424,
					"content": "Taking on seemingly endless debts to make others happy. I guess that must have been my greatest ambition after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050425,
					"content": "But what use are virtue and justice? I purchased the provisions for those in need, and look how things ended up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050426,
					"content": "The Tenryou Commission seized my Vision, and the very people I was so desperately trying to help, refuse to understand me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050427,
					"content": "And the irony of all of it is... I somehow still felt sorry when threatening them with my blade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050428,
					"content": "I'm incapable of being a good person... yet I'm equally unable to be bad. I—I don't know what to do with myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050429,
					"content": "Yet another troubled soul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050430,
					"content": "When we get the chance, let's speak to Thoma about Kurosawa's debt. The Yashiro Commission would surely help cover his expenses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050431,
					"content": "In any case, we must never let him sell off that sword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050432,
					"content": "Losing a Vision...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "Yeah, seems like losing all ambition is a terrible experience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050435,
					"content": "Fortunately for us, you don't have a Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050436,
					"content": "Let's go find the next poor soul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050433,
					"content": "...is no trifling matter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "Mind if we have a look?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
		{
			"id": 200505,
			"completionStepIds": [
				200506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200506",
							"2"
						],
						"stepId": 200506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050501,
					"content": "I've never even heard of these emergency provisions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050502
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050502,
					"content": "I don't know whether it's rumors or whether they're trying to blackmail me, but either way it's ridiculous. If I was hoarding supplies, would I still be the poor man I am today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050503
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050503,
					"content": "My own family can barely get by as it is... Now, if you'll excuse me, I've got other matters to attend to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050504
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050504,
					"content": "We heard that you lost your Vision recently.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050505
					]
				},
				{
					"id": 20050505,
					"content": "That's the first bit of truth I've heard all day. The Shogun's Army told me that I was unworthy of my Vision — they said I was slacking off in my work. Apparently I'd even disappointed the Raiden Shogun. That's why they confiscated my Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050506
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050506,
					"content": "Well that's strange, you were helping enforce the Vision Hunt Decree. Why would you be unworthy of your Vision?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050507,
					"content": "To be perfectly honest... I don't seem to remember the details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050508
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050508,
					"content": "All I know is that I would perform certain things every month, but I don't recall what they were.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050509
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050509,
					"content": "And it's not just that... I have this unsettling feeling like... like someone owes me something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050510
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050510,
					"content": "Does it have to do with the missing emergency provisions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050511,
					"content": "I didn't take any! Like I said, if I was taking them for myself, I wouldn't be going through such hard times right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050512
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050512,
					"content": "To top it all off, my house was just raided by Treasure Hoarders... which is why I came here in the first place. I was chasing after them when I got held up by these two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050513
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050513,
					"content": "If you don't believe me, go find the Treasure Hoarders yourself! If there were any emergency provisions to be had, they would've found them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050514
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050514,
					"content": "Huh... He seems to be telling the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050515,
					"content": "But we'd better confirm. Let's go round up those Treasure Hoarders and see what they have to say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050516,
					"content": "We should be able to follow their tracks. They couldn't have gone too far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200508,
			"completionStepIds": [
				200507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
