					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000301,
					"content": "Well, that's all I have to say about that. Maybe we can talk some more next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Aha, ore from the mines! So you do understand a thing or two about the meaning of Geo after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "Liyue's early settlers learnt to smelt ore to extract the metal within. But before that ore had a different use, and a far more important one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "When the very first people arrived here and began to farm the land, they piled up stones to build stoves and struck them together to produce fire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "With fire, they could cook. And with cooked food, they had the strength to work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "All of this came from the rocks of the earth, which were a gift from the Lord of Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "The Geo Lord quickly became known as the God of the Stove in many of the texts written around that time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Newly opened restaurants and taverns all burn incense to the Geo Lord and pray that the fire in their stoves will perpetually prevail, so that business might forever flourish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "Next time you visit one of the restaurants in Liyue Harbor, don't forget to say a silent prayer to the Geo Lord yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "Ah, you must have picked this up somewhere out in the countryside? You clearly went to great lengths to get this. Good work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "As you will have seen, Liyue Harbor is a vast city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "But even the largest cities are built one brick at a time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "There was nothing like the Liyue Harbor we know today when the first settlers arrived here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Through their sweat and toil those brave settlers cultivated the land, bit by bit, and eventually built this great city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "As you know, the terrain is rocky and mountainous around Liyue Harbor. This makes the land extremely difficult to cultivate. And yet, these tenacious plants grow defiantly in the mountains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Each of these plants also has useful properties which made them immensely helpful for the early settlers. They took this as the Geo Lord's divine providence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "Stories of the settlers' accomplishments have always been popular in Liyue Harbor. Even today, many of Liyue's adventurers are inspired by the deeds of their forebears.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "They see themselves as heirs to their legacy of tenacity and their spirit of breaking new ground. In the same vein, they also worship the Geo Lord as \"The Groundbreaker.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Liyue's adventurers require of themselves to be steadfast as the mountains in the face of whatever challenges they may face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230012",
							"2"
						],
						"stepId": 2230012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "Interesting... Now where did you get that from...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "I have heard that this is only found at Yujing Terrace these days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "This item serves as an excellent prompt for talking about the Lord of Geo. A very considered choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "But in fact, this Glaze Lily also strikes at the very heart of what makes Liyue Harbor tick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "Confused? Think about it, what is special about Glaze Lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "It's precious — exactly. Glaze Lily is highly precious. You can sell it for a very good price and earn lots of Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001207,
					"content": "Mora are named in honor of Morax — another name for the Lord of Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001208,
					"content": "So to many people, the Geo Lord is the God of Wealth. Almost every merchant in Liyue, no matter how big and successful, will always make time to offer incense to the Lord of Geo before they go out to do business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "This is quite simply because the Geo Lord is the wealthiest person in the whole world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001210,
					"content": "Even among The Seven... Surely he must be the wealthiest of the Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230013,
			"completionStepIds": [
				2230013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230013",
							"2"
