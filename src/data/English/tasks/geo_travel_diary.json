			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "Ah, a fellow food lover! Liyue Harbor certainly knows what it's doing when it comes to food. Definitely worth trying the local delicacies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001302,
					"content": "What does this have to do with the Lord of Geo? More than you might expect! You may have noticed banners on a lot of the restaurants in Liyue Harbor? Well, those banners are to advertise the restaurants' long histories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001303,
					"content": "If you go to the owner and ask for evidence of just how long the restaurant has been around, they will immediately tell you that the Geo Lord visited this establishment on such-and-such a date in history, this is what he ordered, and here's what he had to say about it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001304,
					"content": "Without going into whether those stories are true or not, what no one disputes is that the Geo Lord has been in Liyue Harbor for a very, very long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001305,
					"content": "Some of Liyue's historians claim that the Lord of Geo is the oldest person who has ever lived and worship him as the God of History.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001306,
					"content": "But as for exactly how long he has lived in this world, I'm not sure anybody knows.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230080,
