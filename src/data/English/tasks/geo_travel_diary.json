			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "...That is all I ask.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000102,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "Worshiping the Geo Lord. I take it you aren't from around here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000104,
					"content": "This is Yiyan Temple. People in Liyue Harbor come here all the time to offer incense to the Geo Lord and to pray for good luck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000105,
					"content": "I live very far away, meaning I don't have the chance to come here and offer incense very often. So each time I come, I spend a little longer to make up for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000106,
					"content": "I've read a lot of ancient texts about the Lord of Geo, and the more I read, the more awestruck I am by His greatness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000107,
					"content": "So when I think about all that He has done for Liyue Harbor, the fact that I have to travel that little bit further to offer some incense to Him seems like a small price to pay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000108,
					"content": "You probably don't know a lot about the Geo Lord, do you? I can tell you all about him if you'd like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000109,
					"content": "That said, just listening to me talk probably won't make it sink in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000110,
					"content": "Hmm... I have an idea. Go look around <color=#00E1FFFF>nearby Liyue Harbor</color> and gather some things I can use as props. Having some props will really help bring my narration to life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000111,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "Great. Don't be too long. I'll be here waiting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000113,
					"content": "What kind of things should I get?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "Anything that you feel is connected with <color=#00E1FFFF>Liyue Harbor</color> or <color=#00E1FFFF>the Geo Lord</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000115,
					"content": "Though now I think about it, I don't know all that many stories... and not everything is worth telling...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000116,
					"content": "We'll cross that bridge when we come to it. For now... off you go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
