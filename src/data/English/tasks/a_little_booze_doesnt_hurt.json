			"dialogs": [
				{
					"id": 200490801,
					"content": "Y—You're back? What's the... situation with Eury?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490802
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490802,
					"content": "Judging by the smell, I'd say he's had more than one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490803,
					"content": "Eury is struggling with a big decision as we speak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490804
					]
				},
				{
					"id": 200490804,
					"content": "Great... great! I, uh... I guess I have time for another then! Bartender—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490805
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490805,
					"content": "Oi! You said just the one! You said you swear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490806,
					"content": "Hehe... I did, didn't I? Just the one... I swear— I swear this next one is just the one for me! Haha! Bartender...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490807
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490807,
					"content": "Thank you, my friends. Please, take these. My gift to you.",
					"roleType": "TALK_ROLE_NPC",
