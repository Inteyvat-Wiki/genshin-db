			"dialogs": [
				{
					"id": 200490601,
					"content": "Did you find any sunsettias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490602
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490602,
					"content": "Will these do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490603
					]
				},
				{
					"id": 200490603,
					"content": "Gosh, that's plenty! This is amazing, thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490604
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490604,
					"content": "They look really good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490605
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490605,
					"content": "...But these apples are so cheap. Maybe I should get some of each?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eury"
				}
			]
