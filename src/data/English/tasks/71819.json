					"Hongyi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190301,
					"content": "What's wrong with the well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190302,
					"content": "Lantern Rite gift delivery!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "Huh, this must be from the Ministry of Civil Affairs. Thank you, I'll take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190304,
					"content": "Still, I need to remain on duty for a while more to ensure that no residents come to draw water from the well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "Hongyi"
				},
				{
					"id": 718190305,
					"content": "*sigh* Who knows what's wrong with it... But either way, it can't be drunk from now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyi"
				}
			]
		},
		{
			"id": 7181904,
