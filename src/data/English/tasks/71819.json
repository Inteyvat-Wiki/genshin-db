			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang'ya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "I don't know whether I'm coming or going anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190102,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "No worries, I'm just trying to sort out everything that needs to be taken care of for the Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190104,
					"content": "It's just that... The more I think about it, the more issues come up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190105,
					"content": "Even though my colleagues took parts of the workload upon themselves, it's my turn this year to coordinate the Xiao Lantern delivery. If I don't buck up and prepare everything, I won't make it in time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190106,
					"content": "Xiao Lantern delivery?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "Right... When I said \"Xiao Lantern delivery,\" I meant more than just sending out the lanterns themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190109,
					"content": "Simply put... It's more about playing the role of the Lantern Rite ambassador, passing on well-wishes, and creating the festive atmosphere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190110,
					"content": "Even with most people being off work for the festival, including some store owners and their staff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190111,
					"content": "There are still essential workers who can't just take a break — for example, those in charge of keeping order during the celebration, like the Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190112,
					"content": "The Ministry of Civil Affairs usually sends them gifts to acknowledge their hard work around the Lantern Rite season...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190113,
					"content": "I was about to visit the Millelith responsible for keeping our city safe to gift them Xiao Lanterns as a token of gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190114,
					"content": "However... We're a little bit short-staffed and haven't managed to send out the gifts to all the soldiers on our list yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190115,
					"content": "Could you do me a favor and deliver these gifts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190116,
					"content": "How could I not?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "Really? That's amazing! Thank you so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190118,
					"content": "Who are the lucky recipients?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "Let me see... Which of the Millelith haven't been checked off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190120,
					"content": "Xiangming... Hongyi... and Cai Le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190121,
					"content": "I'll mark their stations for you. I can't thank you enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190107,
					"content": "How many people do you have to send them out to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
		{
			"id": 7181902,
			"completionStepIds": [
				7181902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
