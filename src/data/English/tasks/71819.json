			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cai Le"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "Did you get the Xiao Lantern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190602,
					"content": "Sure did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "Let me take a look... Yeah, that's the one. You just made those kids' day. I'll give it back to them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190604,
					"content": "I hope they are still waiting where I left them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190605,
					"content": "About the gift...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "This must be from the Ministry of Civil Affairs. Alright, gratefully received. Thanks for the trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190607,
					"content": "Was it also your duty as a member of the Millelith?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "Do you mean retrieving lost Xiao Lanterns? Hahahah, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190609,
					"content": "Doesn't matter if it's finding Xiao Lanterns, chasing after evil-doers, or defeating monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190610,
					"content": "The Millelith's duty is to help those in need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190611,
					"content": "Thank you once again. I need to hurry up and give it back to those kids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190612,
					"content": "And then I still have other tasks to complete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
		{
			"id": 7181907,
			"completionStepIds": [
				7181909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
