				"objectNames": [
					"Yi Xian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190401,
					"content": "*sobs* I—I haven't finished writing my wish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190402,
					"content": "Be a good girl, Little Xian. That nice uncle from the Millelith went to fetch it for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190403,
					"content": "Have you seen Cai Le?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "Are you looking for that nice Millelith?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190405,
					"content": "Little Xian was writing her wish on a Xiao Lantern when she suddenly lost her grip on it, and the Lantern flew away that way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190406,
					"content": "That Millelith told us he'd seen it hanging on a tree and went to get it for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190407,
					"content": "What's so special about that Xiao Lantern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "I told her we could make another one, but she...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190410,
					"content": "Uh... No... We can't. My brother worked so hard to make that lantern...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190411,
					"content": "Little Xian, that nice uncle will bring it back to us in no time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190412,
					"content": "My apologies. If you really need to talk to that Millelith, you can find him over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190408,
					"content": "Can't you make another one?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
		{
			"id": 7181905,
			"completionStepIds": [
				7181906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
