				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cai Le"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190501,
					"content": "For Archon's sake... How do I get there? Perhaps I should try something different...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190502
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190502,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "Traveler? Haha, it's nothing. I'm just wondering how to climb up that tree and retrieve that Xiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190504,
					"content": "It's so hard to fight gravity in full armor... I just slip back down each time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190505,
					"content": "Eh... Would you mind lending me a helping hand? Recovering that Xiao Lantern shouldn't be too difficult for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190506,
					"content": "Sure thing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "Great, many thanks. Let's get it done as quickly as we can so the little girl can finally cheer up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
		{
			"id": 7181906,
			"completionStepIds": [
				7181908
			],
