			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangming"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "Hmm? Do you need anything? I'm on duty...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190202,
					"content": "Lantern Rite gift delivery!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "Quiet down a bit, I'm working over here! What do you mean, gift delivery?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190204,
					"content": "Oh, it's from the Ministry of Civil Affairs? I see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190205,
					"content": "Another year, another Lantern Rite. And I'd wanted to head home earlier this year, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190206,
					"content": "But given the current situation, I can't relax just yet... I guess I'll be heading home a few hours late again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190207,
					"content": "Thanks for coming all this way. I'll take this. Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190208,
					"content": "*sigh* When's that fellow going to leave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangming"
				}
			]
		},
		{
			"id": 7181903,
