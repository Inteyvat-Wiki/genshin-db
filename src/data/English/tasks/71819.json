			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang'ya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "You're back! How did the gift delivery go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190702,
					"content": "Everyone's got their present.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "You're a real life-saver... I wouldn't have made it without you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190704,
					"content": "Do they have to stay on duty throughout the whole festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "Well... The Ministry of Civil Affairs will schedule alternating shifts for them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190706,
					"content": "But Liyue is too large. There are too many stations and places that need patrolling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190707,
					"content": "We simply don't have enough recruits. Even though they take turns, some of them will get the shorter end of the stick and work during the Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190708,
					"content": "Besides, considering how grand the Lantern Rite celebrations are each year, some parts of the city require additional resources. No matter how we distribute our people, there's never enough manpower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190709,
					"content": "Sounds like a tall order indeed...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "Well, that's our job... We'll do what we can to ensure that everyone has a nice Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190712,
					"content": "Which reminds me of other people who might need help around the festival time. It'd be nice if you could lend them a hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190713,
					"content": "The more people we encourage to participate in the Lantern Rite, the more festive its atmosphere will get.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190714,
					"content": "We send Xiao Lanterns because we'd like for everyone to be able to release one and make their own wishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190715,
					"content": "On a broader scale... we'd like the Lantern Rite to spread far and wide. It'd be great if everyone could experience its atmosphere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190716,
					"content": "Lantern Rite is meant for everyone, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190717,
					"content": "Alright, duty calls. I hope you have a great time during the Lantern Rite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190710,
					"content": "Sounds really difficult.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
