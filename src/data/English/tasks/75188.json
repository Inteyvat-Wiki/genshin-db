				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "All three of my little ones are back now. It must be thanks to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880402,
					"content": "Thank you for your kindness, valiant passerby.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880403,
					"content": "My back still hurts, but nevertheless, it feels a lot better having my little saurians around again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880404,
					"content": "I'm not particularly wealthy, but I can still offer you a small reward. Please, take these as a token of my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		}
	]
}