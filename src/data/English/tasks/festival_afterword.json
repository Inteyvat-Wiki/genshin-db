				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "Bad news!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000102,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "Boss got arrested again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000104,
					"content": "Just now, someone from the Tenryou Commission came to post a notice on the bulletin board saying our festival has to be suspended.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000105,
					"content": "I don't know what happened. I think maybe the boss sent some flyers to Tenshukaku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000106,
					"content": "He did say that the Shogun would definitely not wanna miss the Almighty Arataki Great and Glorious Drumalong Festival, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000107,
					"content": "Hmm... Well, I think Boss is right. The Almighty Shogun would definitely wanna come to the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 725000108,
					"content": "Yeah... don't you agree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000109,
					"content": "Come on, who cares what we think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000110,
					"content": "Anyway, the boss was arrested on the spot by the Okuzumeshuu. They took him to the Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000111,
					"content": "What are you going to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "Shinobu's probably on the case by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000113,
					"content": "I heard the Okuzumeshuu charged the boss with causing a disturbance in a restricted military zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000114,
					"content": "Then Madam Kujou Sara changed it to obstructing the public order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000115,
					"content": "Ahhhhh, that despicable Kujou Tengu! How can she get away with charging Boss with a felony over something like this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 725000116,
					"content": "You idiot! That's a misdemeanor, she downgraded the offense. Usually, you just get a warning for that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000117,
					"content": "Anyway, I guess we'll just have to wait until the boss gets out before seeing what to do about the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000118,
					"content": "Don't worry, Traveler. With Shinobu on the case, everything's gonna turn out just fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000119,
					"content": "You've been so supportive of our festival. When the boss gets out, I'm sure he'll want to thank you in person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000120,
					"content": "I hope your journey, like our festival, will go from strength to strength.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 725000121,
					"content": "From strength to strength!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				}
			]
		}
	]
}