			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200440101,
					"content": "Ugh, what a headache... What am I supposed to do about this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440102,
					"content": "What are you up to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "Practicing for the Knights of Favonius' tryouts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440104,
					"content": "*sigh* But I'm nowhere near as powerful as Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440105,
					"content": "I think it's better for me to focus on technique rather than power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440106,
					"content": "For example, I was thinking about how to break all these wooden dummies in one fell swoop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440107,
					"content": "If you're at a loose end, fancy helping me think about how to tackle it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440108,
					"content": "I'll mull it over.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "Sure, take your time. It's not like these dummies are going anywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440111,
					"content": "Nor is my life going anywhere while I'm stuck trying to sort this out, ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440114,
					"content": "If only I had a bigger weapon, or some powerful elemental ability like Jean, breaking all these wooden dummies would probably be a piece of cake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440109,
					"content": "How about we give it a go together...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "You like team combat, then? Alright for some... always someone to help you out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440113,
					"content": "For people like me, the best I can do is try and hold my own as a lone fighter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
