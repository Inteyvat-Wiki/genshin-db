					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000201,
					"content": "Are we there yet? Hmm... We've got to pick a good spot to send our bottle off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000202
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000202,
					"content": "We should find an upstream position if we want it to go out further...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				}
			]
		},
		{
			"id": 2100003,
