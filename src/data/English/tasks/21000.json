				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100006",
							"3"
						],
						"stepId": 2100006,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100007",
							"2"
						],
						"stepId": 2100007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "What the... To think that these things existed... That was scary!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000302,
					"content": "Thank you so much! C'mon, let's continue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000303,
					"content": "...Wait. Where's my drifting bottle? I was just holding onto it, but now it's gone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000304,
					"content": "Did I drop it while we were fighting that... that Whopperflower?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000305,
					"content": "Please, help me find it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				}
			]
		},
		{
			"id": 2100005,
			"completionStepIds": [
				2100011
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100017",
							"3"
						],
						"stepId": 2100017,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100011",
							"2"
						],
						"stepId": 2100011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Meng",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000501,
					"content": "Phew... I was up all night writing that message. If we'd lost the bottle, I'd have to write it all over again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000502,
					"content": "Wow, an all-nighter? You sure have a lot of worries, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000503,
					"content": "Well... not really? I just really want to know how I can become mature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000504
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000504,
					"content": "I've looked at lots of sources and read a ton of books, but the more I read, the less I understand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000505
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000505,
					"content": "Hehe, and that's why I wrote all the questions I don't understand into that message, in hopes that I'd get an answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000506
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000506,
					"content": "C'mon! Let's send our bottle off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				}
			]
		},
		{
			"id": 2100006,
			"completionStepIds": [
