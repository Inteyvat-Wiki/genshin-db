			"trigger": {
				"objectNames": [
					"Little Meng",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "*sigh* Can I really do this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000102,
					"content": "What's wrong, Little Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "Oh, it's you, Traveler. How do you do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000104,
					"content": "You look kinda upset, Little Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "What's the matter? Did the other kids stop playing that, uh, pirate game with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "Eh? No, no. Little Lulu and Little Fei have just gone home, that's all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000107,
					"content": "I... wanted to have a little walk by myself, so I haven't gone back yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000108,
					"content": "Won't your parents be worried?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "They should still be at work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000110,
					"content": "But let's not talk about that right now. Can I ask you a question?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000111,
					"content": "And what might that question be?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "So... I've heard lots of people tell stories about you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000115,
					"content": "You've been to so many places and you've seen so much, so perhaps you can give me an answer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000116,
					"content": "Ooh, you're getting all serious now. What's the question?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "I'd like to ask...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000118,
					"content": "How does someone \"mature\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000119,
					"content": "Maturity takes time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "So you're saying that people will mature naturally as they grow older?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000121,
					"content": "But wouldn't we mature too late, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000124,
					"content": "Well, if you want to take a trip out of the city, we can accompany you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "That's... I wouldn't want to bother you. And I doubt that something special would fall into my lap just because I went outside the city...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000126,
					"content": "Instead, I'd like you to help me with something else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000127,
					"content": "I've heard people say that if you have problems that you can't solve, you can write them down into a drifting bottle and let those troubles float down the river...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000128,
					"content": "That way, they might actually be resolved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000129,
					"content": "But I've also heard that there are lots of monsters outside. I don't think it would be safe to go alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000130,
					"content": "So, could you protect me while I do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000131,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "Thanks a lot! Don't worry, I've got savings. I can pay you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000134,
					"content": "Let's go, then. First, let's go down to the Bishui River.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000132,
					"content": "I'm on the case.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "You need to have some special experiences.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Special experiences, huh... But I've never left Liyue Harbor in my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210000112,
					"content": "I'm afraid I don't have time to play at the moment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Hahaha, I only play that game with Little Lulu and Little Fei. Since they're not around, the game is off for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
