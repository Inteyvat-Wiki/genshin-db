			"dialogs": [
				{
					"id": 741540801,
					"content": "#{NICKNAME}, look! Fresh Fish, and the floor looks clean too. Someone definitely just tidied up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540802,
					"content": "There's someone in Benoit's house for sure. Let's go over and listen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540803,
					"content": "...He's right, he can't just disappear altogether. At the very least, he needs to be seen once in a while... out on a walk or something like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540804,
					"content": "If nothing else, it'll stop the neighbors from calling the Maison Gardiennage — I'd rather not have the Special Patrol's Musketeers breathing down our necks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540805,
					"content": "Dad, you really want to go out for a walk, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540806,
					"content": "C—Can I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540807,
					"content": "Of course you can! Not only that, but we'd be delighted to come with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540808,
					"content": "Careful now — don't let him use it as an opportunity to call for help. Those two weirdos have been watching this place like hawks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540809,
					"content": "Dad won't do that, I'm sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540810,
					"content": "Dad, you wouldn't want the Maison Gardiennage to know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540811,
					"content": "...To know what!? Why are they speaking so quietly? Paimon can't hear a thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540812,
					"content": "They're about to come out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "Okay, we need to move a bit further away. This time, we have to think of a way to speak with Benoit, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540814,
					"content": "Yup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "Alright, let's scoot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540816,
					"content": "How is it, Dad? Are you feeling any better now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540817,
					"content": "It's you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540818,
					"content": "Benoit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540819,
					"content": "...Help me! Uh, I mean, don't help me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540820,
					"content": "What are you saying, Dad? What's all this \"help me, don't help me\" business? Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540821,
					"content": "Oh, it's you two. No wonder Dad went out of his way to talk to you — you are acquainted, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540822,
					"content": "...N—No, I don't! We don't know each other at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540823,
					"content": "No? But why would they be waiting here just for you then, Dad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540824,
					"content": "They were even nice enough to get the paper for us. Why, they even went to the Fleuve Cendre to talk to our old neighbor, Snodgrass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540825,
					"content": "I think you must be very close! And no wonder. You've always loved kids, haven't you, Dad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540826,
					"content": "I love kids too! But I'm afraid I'm not as selfless as my father. I love my own child the most, but... she's gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540827,
					"content": "Just what are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "Athos and I are our father's children. Dad loves us, and we love him too. Isn't it obvious?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540831,
					"content": "Morticia, look at how lovely the weather is today. Perfect for a walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540832,
					"content": "So it is, Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540833,
					"content": "Have you seen today's Steambird? There are quite a few interesting stories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540834,
					"content": "Oh dear, I fear I haven't.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540835,
					"content": "There's one in particular about an old man who met an unfortunate end. Apparently, he encountered some thieves, and as there was no one by his side looking out for him, he ended up falling off a cliff and died.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540836,
					"content": "Oh, really? The horror! That's so terrible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540837,
					"content": "And another about a very unlucky merchant who drowned. It seems he drank too much, and walked into a lake in a stupor, and just like that... he drowned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540838,
					"content": "Ah! My word! Truly unlucky!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540839,
					"content": "#And this last one is very interesting! It's about a meddling busybody who just couldn't keep their nose out of other people's business. *sigh* {M#He}{F#She} accidentally took the wrong medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540840,
					"content": "#{M#He}{F#She} mistook poison for medicine for {M#his}{F#her} illness, and just like that, swallowed the lot! And then ended up dying very, very painfully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540841,
					"content": "Oh my! There really are so many ways to die. Please, go on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540842,
					"content": "...Sorry, sorry! I won't ever do that again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540843,
					"content": "What ever are you talking about, Dad? We're not trying to say it's your fault or anything. But... you must be tired after running around so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540844,
					"content": "Athos, why don't we go back and read the newspaper to Dad? You subscribe to a lot of papers, don't you, Dad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540845,
					"content": "That's right! We've been chatting long enough. We ought to go back now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540846,
					"content": "Let's go back together, Daddy dearest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540829,
					"content": "Why did you do this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "Do you mean accompanying our dad on a walk? It's our duty as his children to do so, is it not? Failing such a basic responsibility to him would be a poor way to repay the care he has given us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				}
			]
		}
	]
}