							3582.002,
							435.073,
							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Considering how persistent you two are, I didn't expect you to just leave it at that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540702,
					"content": "I thought you'd go running to the Maison Gardiennage, but you didn't. Looks like you have a few ideas of your own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540703,
					"content": "Why are you keeping Benoit here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "To tell you the truth, you've impressed me quite a bit. If you'd only put your enthusiasm to better use, you'd have bright futures ahead of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540706,
					"content": "It's just a shame that you won't be getting anywhere with this. *sigh* You really aren't afraid, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540707,
					"content": "You picked the wrong person to intimidate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "Oh? So do you really not have a clue what's going on here, or is it because you think you're on the side of justice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540709,
					"content": "Incidentally, there was an article recently about a merchant who drowned — his name was Brandt. That fellow sure had a way with words alright...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540710,
					"content": "Guess what? According to the paper, it turns out he didn't drown after all, but was in fact murdered and thrown into the lake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540711,
					"content": "After a very long investigation, all that the Marechaussee Phantom was able to conclude was that he was murdered, and that the murderer was guilty of a heinous crime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540712,
					"content": "So that's what the news report said. Who knows what actually happened, or even which one of them deserved to die more — the murderer, or the victim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540713,
					"content": "Hmm... A tough question, isn't it? I haven't decided what the answer is yet either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540714,
					"content": "Anyway, I digress! This has nothing to do with what we need to discuss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540715,
					"content": "What are you trying to say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "I'm saying that acting recklessly before you've fully understood a situation is foolish, and might bring about some undesirable consequences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540717,
					"content": "Witnessing injustice and doing nothing... That is true folly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Haha... Well, perhaps if we'd met under different circumstances, we'd be friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540720,
					"content": "Though I like the way you think, I have things to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540721,
					"content": "This is as far as my patience can be stretched. Next time I see you two anywhere near my house, I'll do something about it — mark my words.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540722,
					"content": "After muttering something inexplicable, Athos leaves.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "His bizarre attitude surprises you, and you start to wonder what position you should take in the matter...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "You suddenly hear a faint tapping sound coming from the back window, and then after a barely audible creak, a note drops down from the window...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "There is brown writing on the note. It looks like someone wrote it in a real hurry, and it appears that they used coffee to do so...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Quick, see what it says!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "It's Benoit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "Shh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "...Sorry! Anyway, let's keep an eye out for the food bowl and wait for his signal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Whenever I witness injustice, I take action.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "How are you two actually related to Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
