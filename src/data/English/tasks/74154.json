					}
				]
			},
			"dialogs": [
				{
					"id": 741540201,
					"content": "Something's fishy, something's fishy... Even Paimon can tell that there's something off about all this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, you're the brighter spark here. What should we do next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoit wants help but insists that he doesn't...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Then how about we go take another look near Benoit's house? Wasn't there a strange box by his back window?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "There's definitely something hidden in there, and it might just be the proof you're looking for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "That couple may have come from the Fleuve Cendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "From their reactions, I'd say that there are some hidden factors at work...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "I have some theories, but no evidence to back them up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
