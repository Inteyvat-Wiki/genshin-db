			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "Oh my, it looks like Hertha has gone back to her duties, and Glenfidia is away somewhere too... Has our dear cutie taken complete charge of the drinks stand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480102,
					"content": "That's right, yours truly is in charge!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "Wonderful. Now I can order without worrying about ending up with one of the Logistics Company \"specials\" — the type of drink that keeps you awake all night, leaving you no choice but to pass the time working...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480105,
					"content": "Working through the night... Shouldn't that be a thing of the past?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "That's right! I'm just a carefree librarian now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480108,
					"content": "If only there weren't so many people with overdue books, and I didn't have to go door-to-door to get them back... I would've dropped by to chat with you sooner — and try out your delightful creations, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480109,
					"content": "So, what will it be?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "Let me think... Hmm, I don't really have a favorite drink. Just rustle me up something rejuvenating that'll lift my spirits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480112,
					"content": "And if it could help me nod off to sleep later, that would be even better...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480113,
					"content": "(The drinks stand has a collection of classic recipes — let's start by choosing one of those...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "(Since Lisa wants to feel rejuvenated, \"Snow-Kissed Dawn\" seems like a good choice...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "Any particular flavor you're after?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "I thought you weren't so rushed off your feet these days?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "Honorary Mixologist, at your service!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
			"completionStepIds": [
				7054806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
