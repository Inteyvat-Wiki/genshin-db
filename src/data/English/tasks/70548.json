					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
