						705480302
					]
				},
				{
					"id": 705480302,
					"content": "This should help you fall asleep quickly and guarantee you peaceful dreams. It's called a \"Slumbering Rose.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480303
					]
				},
				{
					"id": 705480303,
					"content": "From the colors to the choice of glass, everything's been carefully crafted. You've turned it into a completely different drink...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480304
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480304,
					"content": "Based purely on appearance, it's exactly my style! Time to see how it tastes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480305,
					"content": "Mmm... Full marks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480306,
					"content": "It's like... savoring an exquisite dessert before taking a stroll along the shore of Cider Lake, with the gentle breeze caressing your skin, relaxed and at ease...",
