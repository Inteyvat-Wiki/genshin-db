					"nextDialogs": [
						705480309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480309,
					"content": "So good, in fact, that I feel like writing an article to extol the virtues of this \"Slumbering Rose.\" I can use it as an opportunity to crown you the \"New Maestro of Mixology.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480310,
