			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000304,
					"content": "That's a wrap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "Dragging your feet, just like the Knights of Favonius. I gave you a minute! Did you forget, or did you not listen in the first place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000306,
					"content": "No attention paid, even to such simple details... 1,000 Mora it is. Do with it what you will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000307,
					"content": "1,000 Mora? So little!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000308,
					"content": "How much do you expect for a job done like that? This is the pay you deserve — now take it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
