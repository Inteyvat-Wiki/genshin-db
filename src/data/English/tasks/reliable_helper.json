					"nextDialogs": [
						207003202
					]
				},
				{
					"id": 207003202,
					"content": "Not bad, not bad. Not a box was damaged, either — you know what you're doing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003203,
					"content": "Here, take this 5,000 Mora. If the opportunity comes, let us do business again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003204,
					"content": "All that work, just for 5,000 Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003205,
					"content": "Don't you get picky, now. I calculated this remuneration very carefully, and it is commensurate with the work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003206,
					"content": "One must do great things to earn great rewards. If we have the chance to meet again, you can try your luck then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
