			"dialogs": [
				{
					"id": 207004101,
					"content": "I'll go for the mountaintop.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207004102
					]
				},
				{
					"id": 207004102,
					"content": "The group of hilichurls on the mountaintop are the hardest to deal with. I used to go there to relax, but now I dare not even venture close. Very unfortunate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004103
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004103,
					"content": "Well, you look quite capable, so I suppose it'll be a fitting task for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004104,
					"content": "Remember, that big blockhead with the axe has to go first. Watching him walk around all full of himself just makes my blood boil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004105,
					"content": "Then there's the one that waves its big shield around in your face. What an eyesore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004106,
					"content": "Finally, you want to take out those with the long staves... What do they call them, again? Samachurls? Either way, they don't look so tough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004107
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004107,
					"content": "In any case, get rid of them all. Get them out of my sight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
