					"nextDialogs": [
						207004302
					]
				},
				{
					"id": 207004302,
					"content": "...I watched you work from the side, you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004303
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004303,
					"content": "But are you just used to doing things at your own pace, or did you not pay any heed to the order I gave you at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004304
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004304,
					"content": "Do you know? In Snezhnaya, we say that we \"deliver as promised.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004305
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004305,
					"content": "I pay you to do things for me, and every word that I say has meaning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004306,
					"content": "You did complete the task, but these results... I can only give you 1,000 Mora at most. Take it and go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004307,
					"content": "What? 1,000 Mora? What can we even use that for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207004308,
					"content": "Hmph. Too little, you say? You didn't even do the job right. This 1,000 Mora is more than sufficient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
