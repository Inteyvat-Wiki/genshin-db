				"points": []
			},
			"dialogs": [
				{
					"id": 207003101,
					"content": "I'll head for the mountainside.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003102
					]
				},
				{
					"id": 207003102,
					"content": "Ah, there's some cargo of mine that I had intended to transport back and sell on the mountainside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003103
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003103,
					"content": "But now, not only have the roads been blocked, but the area where I stored my cargo has also been occupied by hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003104,
					"content": "Fortunately, they don't have a good eye for value, and didn't touch my goods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003105,
					"content": "Now go and clear them out, and remember not to touch my cargo. Those boxes break easily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003106,
					"content": "*sigh* With these roads being blocked, those goods probably can't be sold anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
