				{
					"id": 207003301,
					"content": "It's done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003302
					]
				},
				{
					"id": 207003302,
					"content": "Did you mishear me, or are you hoping that I'll let this slide? Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003303
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003303,
					"content": "I told you not to break those boxes, and you broke this many? Can they even be sold at this point?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003304
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003304,
					"content": "I didn't see any goods...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003305
					]
				},
				{
					"id": 207003305,
					"content": "It was those boxes! Those were my goods! Why do you think I would stack them up outside anyway otherwise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003306,
					"content": "Forget it. Forget it! I have nothing to say to attention-deficient louts like you. Here's 1,000 Mora — take it and be off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003307,
					"content": "1,000 Mora? That's way too little!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003308,
					"content": "Too little? You can't even do a simple job right, and you want more money? This is the amount you deserve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
