				{
					"id": 207004203,
					"content": "Forget it, I'll say nothing more. Take this 5,000 Mora. We Snezhnayan merchants always deliver as promised.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004204,
					"content": "So Snezhnayan merchants only deliver 5,000 Mora, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207004205,
