						"stepId": 2070026,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2070023",
							"3"
						],
						"stepId": 2070023,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "Done and dusted.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "So soon? In less than a minute, even! You're quite good. Quite good indeed, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000203,
					"content": "Good, good. 5,000 Mora, and not one Mora less. Take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000204,
					"content": "\"Quite good,\" and all we get is 5,000 Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000205,
					"content": "Don't you get picky, now. I calculated this remuneration very carefully, and it is commensurate with the work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000206,
					"content": "One must do great things to earn great rewards. If we have the chance to meet again, you can try your luck then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
		{
			"id": 2070005,
