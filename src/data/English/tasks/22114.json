			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nervous An"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140701,
					"content": "I'm a cooper: I'm neither particularly good with my hands, nor do I have any particular talents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140702,
					"content": "A cooper?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "Well, that is to say that I'm like someone who repairs barrels, and who needs a single plank of wood to finish my wooden barrel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140704,
					"content": "But the plank I have in hand isn't of good quality. It's just a little short, and if I use it to make my wooden barrel, its capacity is going to be lowered significantly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140705,
					"content": "Still, if I want to get a new plank, who knows when I will finish that barrel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140706,
					"content": "And given that the deadline for finishing the barrel is drawing near, I have to choose the lesser of two evils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140707,
					"content": "Who knows how many people there are under the sun who are coopers like me, who are facing a dilemma similar to mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140708,
					"content": "Can we talk about Linling's job?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "Her job? Ah, yes. She did ask you to help her tally boat numbers in the past, didn't she? I know about that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140710,
					"content": "Don't look so surprised. As long as we get results, I'm really not picky as to how she does her work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140711,
					"content": "Besides, the rewards she gives you are taken out of her own pocket.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140712,
					"content": "But as for her reporting data without reviewing it first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140713,
					"content": "That irresponsible attitude is what really made me angry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervous An"
				}
			]
		},
