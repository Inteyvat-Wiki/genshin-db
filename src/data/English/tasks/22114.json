	"talks": [
		{
			"id": 2211401,
			"completionStepIds": [
				2211401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211401",
							"2"
						],
						"stepId": 2211401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "I'm finished, it's all over for me this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "*sobs* Nervous An said that I might not be cut out for this line of work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140104,
					"content": "Isn't he just firing me? What do I do? I... I'm always working so hard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140105,
					"content": "Huh? Why so sudden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "Well... Didn't I ask you before to help me count boats?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140107,
					"content": "I trusted in your ability, so I didn't double check the data you gave me, and handed it in directly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140108,
					"content": "A lot of the numbers turned out to be wrong... Nervous An really lost his temper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140109,
					"content": "Won't you help me talk to him? I—I'll do my job seriously from now on! And I won't call on you to help me out again, either!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140110,
					"content": "But I dare not go to ask him myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140111,
					"content": "Were the previous boat tallies wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "Yes! Didn't I ask you to help me out with them before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140113,
					"content": "I trusted in your ability, so I didn't double check the data. I handed it in directly... and a lot of it turned out to be wrong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140114,
					"content": "But I only asked for your help from time to time. I also tallied a great deal of numbers myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140115,
					"content": "So when put side by side, I didn't know where I had gone wrong at all, which made Nervous An lose his temper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140116,
					"content": "Please help me talk to him! I—I'll do my job seriously from now on! And I won't ask you to help me out again, either!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140117,
					"content": "But I dare not go to ask him myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211402,
			"completionStepIds": [
				2211402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nervous An"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "*sigh* Really, this is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140202,
					"content": "Can we talk about Linling?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "Hmm? You're asking about Linling? Well... How do I say this? She's just not really suited for her job.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140204,
					"content": "Specifically, the mistakes she's made in her data entry are far too egregious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140205,
					"content": "As for this week's data, only one or two days out of seven have the correct numbers. Even a purely visual inspection would be more accurate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140206,
					"content": "How can I leave this job to her with that attitude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140207,
					"content": "Well, if it's just numbers...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "There is no \"just\" when it comes to work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140209,
					"content": "If a single plank in a wooden barrel is a little short, then the volume of the whole barrel goes down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140210,
					"content": "It is the same with work. If we get careless about even one matter, we will drag the larger work through the mud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140211,
					"content": "Let's take tallying up the number of boats, for example. If the numbers are not accurate, then the various activities we conduct at the harbor will also be imprecise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140212,
					"content": "Imprecision there can be costly, and even if someone remedies the issue, the time unnecessarily lost fixing the problem cannot be gained back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140213,
					"content": "Do you understand now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140214,
					"content": "I... I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "Still, we do lack manpower here at the harbor, so I most likely won't fire her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140216,
					"content": "How should I put it... \"a plank shorter\" is better than \"a plank short,\" no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140217,
					"content": "The person in charge of reviewing cargo is unable to be here due to an emergency. Tell Linling that her help there will be expedient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140218,
					"content": "If nothing serious goes wrong with her work there, then she can return to her job tallying boats when the person in charge of the review returns to work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140224,
					"content": "Hmm... I guess this can be considered a test, and something of a second chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140225,
					"content": "Give this manifest to Linling. Ask her to conduct checks according to it, and make markings on the back once each check is completed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140226,
					"content": "Also, please tell her to pull her socks up. If she slips up here as well, then there won't be any more second chances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140219,
					"content": "I'll go tell her...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "What will you tell her? That she's fired? No, she's not fired just yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140221,
					"content": "We have a dire lack of manpower here at the harbor. How do I say this... \"a plank shorter\" is still better than \"a plank short,\" yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140222,
					"content": "The person in charge of reviewing cargo is unable to be here due to an emergency. Tell Linling that her help there will be expedient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 221140223,
					"content": "If nothing serious goes wrong with her work there, then she can return to her job tallying boats when the person in charge of the review returns to work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Nervous An"
				}
			]
		},
		{
			"id": 2211403,
			"completionStepIds": [
				2211403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211403",
							"2"
						],
						"stepId": 2211403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "Oh, what shall I do about work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140302,
					"content": "Nervous An says he's giving you another chance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "Really! Wonderful! That's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140304,
					"content": "Eh? A cargo review? Oh no... I've never done that before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140305,
					"content": "If I make another mistake, I'm definitely finished. No, I have to make preparations first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140306,
					"content": "I need to find the previous review standards, and also the previous standard formats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140307,
					"content": "Could you help me confirm the amount of cargo first? You just need to check the cargo numbers against the document and see if they're accurate. I will conduct a more detailed review later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140308,
					"content": "I got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "Thank you so much. I'll be making preparations here in the meantime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140310,
					"content": "I can't mess up this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140311,
					"content": "You can leave everything to us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "No, I can't, not this time. A cargo review is way more complex than tallying boats. I have to do this myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140313,
					"content": "So, please just confirm the amounts of cargo. I will do a more specific review afterwards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211405",
							"2"
						],
						"stepId": 2211405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "Have you ascertained the numbers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140502,
					"content": "Yup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "Great. My preparations are almost complete as well. I will review all those goods once again in a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140506,
					"content": "Oh, right! Please take this as thanks for your help. I will go and review the cargo in a moment. This time, nothing can be allowed to go wrong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140504,
					"content": "You weren't writing poetry, were you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "Of course not! I do have a sense of priorities, you know. This isn't the time to be writing poetry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "...I can't write poetry at work anymore. I've got to focus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140602,
					"content": "Work comes first in the end.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "I know that. But doing the same thing day in, day out, year on year... you eventually get bored, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140604,
					"content": "And, well, it's precisely because it's this kind of sideline job, you know? It's not that important, and no one really pays you mind, so you start to drift off after a while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140605,
					"content": "Nervous An always says things like \"every job is important\" and \"every job is decisive...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140606,
					"content": "But if that's the case, why's everyone still so picky about the kind of work they want to do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140607,
					"content": "You need to take responsibility for your work.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "I only ask for your help occasionally. I do it myself most of the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140609,
					"content": "I know I should take responsibility for my work. But the busier it gets, the more I feel like slacking off. That's why I ask for your help at times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140610,
					"content": "If I really were to become idle, I find myself looking for things to do instead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140611,
					"content": "Well, you haven't worked a day in your life, have you? There's no use telling you all this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140612,
					"content": "Why do you want to write poetry so much?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "Why are you suddenly asking me this? Let me think... Well, why do you think a person works?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140614,
					"content": "The way I see it, \"working for the sake of continuing to work\" is a little too boring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140615,
					"content": "How I say this? Everyone has got to have their dreams, right? A dream that's totally separate from the daily drudgery of work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140616,
					"content": "That way, even in moments when you're so tired that you think you might break, you can take refuge in your dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140617,
					"content": "But this is just my way of thinking, of course. I have no idea how adventurers would think of this problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140618,
					"content": "When I look at the way they do nothing but live for their dreams, I feel like I need some kind of daily work to ground myself instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140619,
					"content": "Still... Hahaha, take it from me: dreams are just dreams. When you work, you still need to keep your feet firmly planted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211407,
