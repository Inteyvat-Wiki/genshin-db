			"dialogs": [
				{
					"id": 221140801,
					"content": "Reviewing cargo is much more of a hassle than tallying boats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140802
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140802,
					"content": "This time, I have to be very careful. I can't make a single mistake...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		}
