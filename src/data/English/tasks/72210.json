			"dialogs": [
				{
					"id": 722100201,
					"content": "Meow, meow meow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100202
					],
					"speakerTitle": "\"Hachihou\""
				},
				{
					"id": 722100202,
					"content": "Oh, so this must be \"Hachihou\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100203,
						722100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100203,
					"content": "Come here now, be good...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100204
					]
				},
				{
					"id": 722100204,
					"content": "Meow meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "\"Hachihou\""
				},
				{
					"id": 722100207,
					"content": "Aw, what an obedient little kitty...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100205,
					"content": "Meow, meow...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100206
					]
				},
				{
					"id": 722100206,
					"content": "Meow... meow meow meow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "\"Hachihou\""
				}
			]
		},
		{
