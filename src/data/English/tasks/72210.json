			"dialogs": [
				{
					"id": 722100501,
					"content": "Found those two children, have you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100502,
					"content": "It's a work in progress...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100503
					]
				},
				{
					"id": 722100503,
					"content": "Mm, is that so? Then make haste, lest those two run yet further than they already have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		}
