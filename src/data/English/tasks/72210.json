					"\"Konbumaru\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "Have you found them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100402,
					"content": "Yup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "You! You never have ears for me, do you? Why can't you both be as good as Meshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100404,
					"content": "Meshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Hahaha, you really do name them after good things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100406,
					"content": "Meow, meow meow meow... meow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "\"Hachihou\""
				},
				{
					"id": 722100407,
					"content": "Meow! Meow meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100408,
					"content": "No back-talk! Or should I not go and find you, and simply let you... let you go hungry from when the sun is up, to when the moon rises, to when the sun hangs high again, and leave you to find your way home?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100409,
					"content": "Meow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100410,
					"content": "Hah, that's a good child. Alright, alright. It's just good that you have returned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100411,
					"content": "I owe you much. If not for your help, these little rascals would have gone hungry out in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100412,
					"content": "I actually think they would've made it back themselves...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "Whatever the case, you have my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100414,
					"content": "If you can spare the time, do come again. I might still have other matters in which you might have a hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
