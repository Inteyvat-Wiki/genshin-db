			"trigger": {
				"objectNames": [
					"\"Konbumaru\"",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100301,
					"content": "Meow! Meow meow, meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100302
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100302,
					"content": "Whoa! That's a fierce little kitten alright. Be careful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100303,
					"content": "Meow, meow...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "Meow meow? Meow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100307,
					"content": "Hehe, it sure looked fierce, but guess it's just gonna let you carry it after all, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100305,
					"content": "I've come to take you home.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
					"id": 722100306,
					"content": "Meow! Meow... meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "\"Konbumaru\""
				}
			]
		},
		{
			"id": 7221004,
			"completionStepIds": [
				7221004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
