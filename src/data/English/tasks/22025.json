			"dialogs": [
				{
					"id": 220250301,
					"content": "What is it? Hmm... Miss Tang Wen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250307,
					"content": "A strange taste in your mouth, loss of appetite, don't really want to eat anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250302,
					"content": "Is it really because she ate something strange? You're not mistaken, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250303,
					"content": "Why does it sound more like she's just bloated? Hmm, let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250304,
					"content": "Forget it, since there is no way to judge, there is only one dish that I can recommend, and that is — Bamboo Shoot Soup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250305,
					"content": "The taste is savory, the meat is tender, and the flavor refreshing and appetizing. Most importantly, the soup can help in food digestion. Mmm! I wish I could have some right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250306,
					"content": "Believe me, all Tang Wen needs right now is Bamboo Shoot Soup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiuyue"
				}
			]
		},
