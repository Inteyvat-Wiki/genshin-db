					"nextDialogs": [
						220250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250402,
					"content": "What should we do? Paimon's so torn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250403,
					"content": "What do you think, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "Huh? You're asking Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250405,
					"content": "If that's the case... If Paimon were to choose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250406,
					"content": "Paimon will choose Grilled Tiger Fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250407,
					"content": "Grilled Tiger Fish sounds very courageous. If Miss Tang Wen eats this courage, her troubles will be solved, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250408,
					"content": "Paimon, you sure know a lot about eating...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "Oops, that's why Paimon should let you decide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250411,
					"content": "Hmm... The Delicious Jueyun Guoba it shall be!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250414,
					"content": "Woohoo! Let's quickly make this dish and bring it to Miss Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250412,
					"content": "Hmm... The Delicious Bamboo Shoot Soup it shall be!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250413,
					"content": "Hmm... The Delicious Grilled Tiger Fish it shall be!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250409,
					"content": "I don't think that's the story behind Tiger Fish...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				}
			]
