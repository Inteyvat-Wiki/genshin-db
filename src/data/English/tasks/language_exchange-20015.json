			"dialogs": [
				{
					"id": 200150201,
					"content": "Thankfully there's one awake right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150202,
					"content": "This is him, let's go over and say hi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150203,
					"content": "Be careful though, it would be rude of us to wake the others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150204,
					"content": "We don't want them thinking we're storming into their camp to attack them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150205,
					"content": "There's absolutely no way they would talk to us then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
