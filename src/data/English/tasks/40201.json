			},
			"dialogs": [
				{
					"id": 402010101,
					"content": "Well done, you two. Right on time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "How's the case coming along?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "The day after we infiltrated the storage facility, the Dark Financier's two lackeys, Corder and Doddamani, started moving the goods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "See that ship? It's the one Doddamani dispatched to transport the goods. It operates under the guise of a joint passenger and freight vessel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "Whoa, that's one huge boat! Paimon can see all the goods piled up on the pier! Seems like it's transporting quite a few passengers to Lumidouce Harbor as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "What if those aren't the real goods, though?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "Thinking two-steps ahead? I like it. You're a fast learner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "If Corder and Doddamani think the authorities are on to them, it's possible the goods they're sending to Lumidouce Harbor are a whole bunch of nothing. Just bait to flush out the law enforcement on their tail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "But we need to be careful. Several members of the crew have confessed that a veteran Treasure Hoarder known as \"Scamface\" is involved with the Dark Financier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "As an escaped convict, Scamface is a master of staying hidden. Based on our earlier investigation, it's clear he's the one who's been doing reconnaissance on the Millelith's lighthouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "I'll circle the area to draw Scamface's attention away from the scene while you two inspect the goods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "Remember to keep a low profile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "Understood. I'll keep it stealthy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#Yeah! And Paimon will do her best to... float closer to the ground! No higher than {NICKNAME}'s shoulder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "Don't worry. I've got this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "Should we investigate them just in case?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "Any developments?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
		{
