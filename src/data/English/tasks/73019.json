				"points": []
			},
			"dialogs": [
				{
					"id": 730190101,
					"content": "You consume the dew and grow up quickly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190102,
					"content": "Hello! You're Ara... Ara... What was it again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190103,
					"content": "Are you Arapacati's elder brother?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "That's smart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190107,
					"content": "Grow, grow, turn into a delicious dish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190108,
					"content": "He doesn't seem to notice us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190105,
					"content": "Arasaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "Arasaka! Are you Arasaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "Eek! Nara... So tall, so scary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190202,
					"content": "Please, I beg you... Don't pluck them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190203,
					"content": "Okay, we won't do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190204,
					"content": "Great. Hehe... I grew these Zaytun Peaches little by little, ever since they were seeds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190205,
					"content": "Wait, no! Bad Nara! How could you do that to someone else's Zaytun Peaches?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190206,
					"content": "Wh—Why does Nara have such a terrible habit...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190207,
					"content": "We didn't do anything and haven't picked them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190208,
					"content": "It's already scary when you guys didn't do anything. If you had really done something, it would scare me to death!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190209,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190210,
					"content": "No, no, Arasaka... Think about it. You've worked so hard on these Zaytun Peaches for your cooking training... You cannot back out here. You are not scared...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190211,
					"content": "So, you're Arasaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190212,
					"content": "Oh! H—How do you know my name... Where you Nara all come from... T—To know my name at first sight...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190213,
					"content": "You said it yourself...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "Problems are caused by a loose tongue. It's over! My name will be used in terrible curses... Please, please, spare me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190215,
					"content": "Other than giving you the Zaytun Peaches, I will do anything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190219,
					"content": "Easy now. We're actually here because of Arapacati's request.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190220,
					"content": "Ara—Arapacati? Ah, my dear \"younger sister,\" sunlight in the dense forest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190221,
					"content": "You bring Arasaka up to speed on the events so far...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "Ugh... How come Festival Utsava is already approaching... Oh, are you two the Nara who have come to participate in this Festival Utsava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190223,
					"content": "Sorry for calling you bad Nara. You must be good Nara because only good Nara can enter Vanarana and participate in Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190224,
					"content": "Festival Utsava is coming. If I give up my cooking training and return to Vanarana now... No... But I can't skip Festival Utsava either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190225,
					"content": "Why are you getting more nervous instead? Don't you still have the Zaytun Peaches you planted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190226,
					"content": "Th—That's not enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190227,
					"content": "There has to be the \"taste of happiness.\" Without it, Zaytun Peaches will just be Zaytun Peaches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190228,
					"content": "Arachatora, Arapas, and Araphala all don't believe that the \"taste of happiness\" exists. I will make it and show them. And I want Nara to try it too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190229,
					"content": "\"Taste of happiness\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "Hehe, \"taste of happiness\"... I tried it once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190232,
					"content": "\"Taste of happiness.\" It's white, crumbles when you rub it... Turns into white Valuka, but is not hard and painful like Valuka. Stored in a hard bubble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190233,
					"content": "White Valuka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "White Valuka refers to white sand, right? Uh, but what's a hard bubble...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190236,
					"content": "Paimon can't figure it out. Where can we find that \"taste of happiness\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190237,
					"content": "Wh—Why are you asking me? Do you want to take the \"taste of happiness\" before I do? How scary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190238,
					"content": "We only want to help you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "Help me? With what? I—I can get it myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190242,
					"content": "It's just that there are a lot of Nara walking about, and one that smells like Nara Valuka. Ugh... Too many Nara! I'm scared... If there were fewer Nara, I could do it then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190243,
					"content": "...Okay, true, I can't get it. I... don't dare to enter Gandharva Ville. There are too many Nara there, and all the dead trees. I'm scared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190244,
					"content": "I have a Nara friend living inside. But a long, long time has passed. He's changed now and can't hear my voice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190245,
					"content": "So the \"taste of happiness\" you're talking about can actually be found in Gandharva Ville.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190246,
					"content": "The \"taste of happiness\" is not grown from the ground but made by Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190247,
					"content": "I really want to taste it again. I still remember the first time I tasted it and how happy I was. It was an amazing, amazing taste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190248,
					"content": "We were in the forest together with the Nara friend, counting the number of patches of sunlight that fell between the leaves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190249,
					"content": "We sang together and tried the \"taste of happiness\" together. Every time I see the sunlight on branches, I will think of him. Every time I think of him, I remember the \"taste of happiness.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190250,
					"content": "So, I want to let Arapacati taste it. And when Festival Utsava starts, I want Nara to taste it too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190251,
					"content": "#Paimon sees. Then leave it to {NICKNAME} and Paimon! Right, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190252,
					"content": "I want to have happiness too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "Really? You are not lying to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190255,
					"content": "Nope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190256,
					"content": "But there are so many people in Gandharva Ville! Who should we ask for clues?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190257,
					"content": "I know. Not long ago, I saw a Nara passing by here, <color=#00E1FFFF>going to Gandharva Ville</color>. And he had it with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190258,
					"content": "He had a bulging thing on his back. It's what Nara use to carry things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190259,
					"content": "A bulge on the back... Hm. <color=#00E1FFFF>It is probably a bag or a back basket</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190260,
					"content": "Got it! We'll help you find the \"taste of happiness\" now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190253,
					"content": "Since I've promised Arapacati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "Aah! Paimon, you're so scary!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "Hey! Paimon just wants to help Arasaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190234,
					"content": "Hard bubble?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "The \"taste of happiness\" you're talking about is...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "We knew a long time ago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "What!? A long time ago!? So you had your eyes on me long ago... Wh—What do you want from me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190218,
					"content": "Could it be the Zaytun Peaches? No! You can have anything else! But not my peaches!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				}
			]
		},
		{
			"id": 7301903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
