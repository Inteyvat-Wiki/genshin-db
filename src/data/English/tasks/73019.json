			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arasaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190301,
					"content": "H—How was it? Did you find the \"taste of happiness\"? It's in Gandharva Ville...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190302,
					"content": "There's a Nara with a bulging thing on his back. The \"taste of happiness\" must be inside...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arasaka"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301904",
							"2"
						],
						"stepId": 7301904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "Hello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190402,
					"content": "Oh, hello... How can I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190403,
					"content": "Right, we actually want a certain thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190404,
					"content": "Heh. Of course, everyone comes here to get \"a certain thing.\" But just saying \"a certain thing\" doesn't mean I know what this \"certain thing\" is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190405,
					"content": "Oh... Paimon gets it. Let Paimon put it this way: We want...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190406,
					"content": "Something white and cubic...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "White and cubic?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190408,
					"content": "Right, and it crumbles like sand when crushed, and it has to be packed in a hard bubble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190409,
					"content": "What a peculiar description...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190410,
					"content": "It's not clear what it is from what you said, but what does this white and cubic thing you've described do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190411,
					"content": "The use of the thing. You know what it's used for, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190412,
					"content": "It's edible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "An edible, white, and cubic thing...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190416,
					"content": "Oh! I know! I know what you want... Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190417,
					"content": "What's so funny!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190418,
					"content": "Aha, hahaha! White, cubic, crumbles when crushed, becomes sand... and can be eaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190419,
					"content": "Isn't it just \"sugar\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190420,
					"content": "The hard bubble... Are you talking about the glass bottle that sugar is stored in? My goodness! Hard bubble! Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190421,
					"content": "What? So it's sugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190422,
					"content": "I'm a little embarrassed...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "Ooh, I laughed so much I cried. I've focused on my business the past few years, and I don't even remember when was the last time I laughed like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190425,
					"content": "Speaking of which, it's really nostalgic. I remember a long time ago, when I was still a child, I once had a friend who ate sugar for the first time, and the friend said similar things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190426,
					"content": "\"This white cubic thing is delicious! So awesome! The taste of happiness!\" He was really amazed then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190427,
					"content": "Haha... It was so long ago, and now that I think about it, I don't even remember what he looked like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190428,
					"content": "Oh! I'll give you this bottle of sugar as a gift in return for the laughter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190429,
					"content": "Thanks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "Hold it carefully. The hard bubble might be hard, but it can still break if dropped. \"Hard bubble\"! Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190423,
					"content": "This is awkward...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "It's for cooking...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "Cooking, white, cubic... Is it a seasoning?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301904",
							"3"
						],
						"stepId": 7301904,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190501,
					"content": "My family has always been a merchant group on the move, from The Chasm to Sumeru. We import rare gemstones from Liyue, then send spices over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Once, because something came up... I can't remember. Anyway, my father left me in Gandharva Ville for a very long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "I remember I was in the forest, and I made a friend. We ran around together, then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "I don't remember what happened later. I can't remember his name, or what he looked like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "I only remember it being a really happy time. Then my father finally came back, and picked me up. I'd also thought to go back and look for him but I never had the opportunity, and I eventually forgot about this experience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "If it wasn't for you asking me for sugar, I would have forgotten about all these things. Why would it be like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301906,
			"completionStepIds": [
				7301906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301906",
							"2"
						],
						"stepId": 7301906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arasaka",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "That's the one! I didn't think you would get it so quickly... Is it real?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190602,
					"content": "You didn't just make something up to trick me, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190603,
					"content": "It would be a miracle if we were able to make anything that made sense up from your description!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190604,
					"content": "If you're worried, just try it yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190605,
					"content": "...You didn't put anything strange in it, did you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190606,
					"content": "Of course not! Hmph! If you're not trying it, we're gonna take it away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190607,
					"content": "N—No, wait! Don't take it away. Let me... Let me try...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190608,
					"content": "Don't take it away, alright? I'll try it now, right now... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190609,
					"content": "Ah, it's real... This is the \"taste of happiness\"! Hehe... This isn't the first time I tasted it, and yet I still feel happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190610,
					"content": "I didn't expect to ever taste this again... Ah, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190611,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "Well... How should I put this? The \"taste of happiness\" is the same as before. But for some reason, I don't feel as happy as the first time I tasted it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190614,
					"content": "Could it be that the sugar he gave us was not sweet enough?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190615,
					"content": "No, it's not a difference in the taste. But when I ate it with my friend in the past... That was the first time I tasted the \"taste of happiness\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190616,
					"content": "Somehow I feel that I was much happier back then. Why is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190617,
					"content": "#That's normal. Even if it's the same dish, the taste is different every time {NICKNAME} makes it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190618,
					"content": "Paimon's mood is different every time Paimon eats it too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190619,
					"content": "Indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "No, it can't be... There must be a way for me to be as happy as then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190622,
					"content": "I know! I had it with my friend at the time. So the \"taste of happiness\" has to be shared with friends for it to be delicious, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190623,
					"content": "That must be it. You are good Nara, and you found the \"taste of happiness.\" You, are my friends. I'm going to make it for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190624,
					"content": "Yeah, we're friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190625,
					"content": "Arasaka starts cooking right away and adds peaches and sugar into the pot...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "Arasaka then hands the finished product to you and Paimon.\\nAs expected, it doesn't have much flavor other than the overwhelming \"sweetness.\"\\nMaybe this is just the \"taste of happiness\"...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "Ah, what a happy flavor. It's exquisite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190628,
					"content": "Yes, this dish is quite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190629,
					"content": "Quite \"happy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190630,
					"content": "Too sweet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "Paimon thinks it's much too sweet too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190633,
					"content": "R—Really? Oh, I guess I must've put too much in one go, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190634,
					"content": "But... Hehe. It's true that the \"taste of happiness\" is happier when shared with friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190635,
					"content": "It is different from the happiness I felt the first time I had it, but eating it with you guys... I feel a different kind of happiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190636,
					"content": "Well, as long as you're happy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "I had doubts about you guys in the beginning, but you didn't hold any grudge... and you helped me find the \"taste of happiness\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190639,
					"content": "I was able to complete my Supreme Delicacy with your help and complete my cooking training...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190640,
					"content": "It's nothing, really...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190641,
					"content": "No, how is it nothing? You've helped me so much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190642,
					"content": "That's right, I know! I'll teach you how to make this dish so you can share the \"taste of happiness\" with your friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190643,
					"content": "(Hmm... If we modify the formula and add a little something extra, it should make a good snack...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190637,
					"content": "I need water...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "I need water.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "Really?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "Is there something wrong?",
					"roleType": "TALK_ROLE_PLAYER",
