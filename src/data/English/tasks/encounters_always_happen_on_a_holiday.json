			"dialogs": [
				{
					"id": 752460384,
					"content": "#As the elder, you should go first, {M#Gramps}{F#other Granny}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460385,
					"content": "Happily.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#Wow, the competition's really heating up! Here comes a pro move from {NICKNAME}... and there's a bite! {NICKNAME} reels it in, and up comes a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460302,
					"content": "Hold on... is that... an Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460303,
					"content": "Wow... Not exactly the kind of catch I was expecting! Not super sure how we're gonna judge that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460304,
					"content": "#Nice one, {M#Gramps}{F#other Granny}! We'll have to see if anyone manages to reel in something even more special. Otherwise, that might be enough for the win.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460305,
					"content": "Thanks, everyone! I'm up against some fierce competition, but I think I've got a shot. Let's hope my grandson is right!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#Quite the impressive showing from {NICKNAME}! That'll be a tough act for the remaining two competitors to follow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460307,
					"content": "Ifa, you're up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460308,
					"content": "You've got this, bro! Teamwork makes the dream work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460309,
					"content": "Sorry, Cacucu. There's no room for teamwork here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460310,
					"content": "Whoa, look alive, bros... I've got something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460311,
					"content": "Ifa reels in the rod with all his strength. Looks like he's caught something big...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "But... it's another unexpected catch.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "Huh... Looks like Ifa reeled in a koholasaur... towing a capybara? Not sure what's going on there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460314,
					"content": "Impressive! Ifa's always had a way with animals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460315,
					"content": "Wait, I think there's something wrong with this koholasaur's tail... I think he might've cut it on a rock, and I'm guessing this capybara was trying to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460316,
					"content": "Or, the capybara was trying to eat his tail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460317,
					"content": "No way, bro. Cacucu, can you go ask?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460318,
					"content": "Yep, yep... You got it, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460319,
					"content": "See? Haha! Knew I was right... No, wait. That's not what's important right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460320,
					"content": "Ifa quickly checks the koholasaur's tail. Luckily, it's just a scratch.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "After a simple triage, the koholasaur and his capybara companion leave.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "Aw, a new friendship. Looks like today is their lucky day, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460323,
					"content": "\"Too\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460324,
					"content": "That's right. It's my turn, and I have a feeling I'm going to win this thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460325,
					"content": "Teamwork makes the dream work, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460326,
					"content": "Guessing that's your way of rooting for us, little guy? Where did you even learn that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460327,
					"content": "Cacucu, fishing cheerleader extraordinaire!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "\"Fishing cheerleader\" sounds too lackluster. We're fighting for something important. It needs to have a bit more impa... Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460329,
					"content": "What is that!? Quick, out of the way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460330,
					"content": "Okay, this one looks a bit unusual... But, it's another capybara! And he charged at us! Didn't you say they're supposed to be gentle creatures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460331,
					"content": "He must be fighting for something important, too. Hm, I can sense it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460332,
					"content": "...Or, maybe not...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460333,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460334,
					"content": "I guess that's just us. But, he is upset.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460335,
					"content": "Oh, hey, little dude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460336,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460337,
					"content": "Haha! Awesome, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460338,
					"content": "Wh—What? Is Cacucu trying to... talk him down or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460339,
					"content": "Comfort him, more like. He might not look it, but Cacucu has an amazing bedside manner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460340,
					"content": "Huh. Even with his, um... limited vocabulary?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460341,
					"content": "When you're talking to a capybara, I don't think human vocabulary matters much, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460342,
					"content": "Oh... right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460343,
					"content": "We just need to trust the little broski.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460344,
					"content": "Besides, when you're trying to communicate, I think tone carries more weight than the actual words.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460345,
					"content": "For example, \"hello\" means \"I'm happy.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460346,
					"content": "But, \"hello\"... means \"I'm frustrated.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460347,
					"content": "And, \"hello!\"... That's anger, a sign to run and hide because danger is near.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460348,
					"content": "Okay, Paimon doesn't completely follow, but she'll take your word for it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460349,
					"content": "You learn something every day, huh? Thanks!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "Oh, my pleasure! It's the method I came up with to communicate with the aphids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460351,
					"content": "Aphid STAFF... remember, bro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460352,
					"content": "No, not just the staff. There are aphids who didn't want to join, you know. I understand their feelings, of course, and I respect their decision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460353,
					"content": "...Then, maybe you can throw some of that understanding my way, bro. I'm at my wit's end here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460354,
					"content": "Huh, really? I thought you'd be proud. See, look over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460355,
					"content": "——.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460356,
					"content": "Hahaha! For real?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460357,
					"content": "——.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460358,
					"content": "Wow! Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460359,
					"content": "Whoa, looks like they really hit it off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460360,
					"content": "Okay, well, I am a little proud, but... Huh? Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460361,
					"content": "Don't worry. I've got this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460362,
					"content": "Hello, Capybara King. Do you want something to eat? I have a fresh batch of Ifa's cookies here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460363,
					"content": "Rrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 752460364,
					"content": "Capybara King?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460365,
					"content": "Huh, he ate them! Looks like that perked him up for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460366,
					"content": "Oh dear! Oh dear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460367,
					"content": "Hold on... How did our fishing competition turn into a petting zoo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460368,
					"content": "Hey, it's not a bad result!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "Huh, true... Well, guess this makes Ororon the winner?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460371,
					"content": "Considering he managed to catch this, um... Capybara King or whatever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460372,
					"content": "It's a fine name, indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "Sure, Ororon wins. None of us managed to catch an actual fish, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460374,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460375,
					"content": "Nice, then I get the mead! Although, it was mine to begin with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460376,
					"content": "Well, you get to keep it! That's something, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460377,
					"content": "True, and the Capybara King left us a little something extra, too. Look, I think it's a gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460378,
					"content": "A \"Gift Egg\" and a picture? Huh, the location in this picture looks familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460379,
					"content": "Does that mean the Capybara King wants us to go there? Kinda seems like that, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460380,
					"content": "Couldn't hurt to go and see.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "Yeah, definitely something to check out if you've got some time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460382,
					"content": "Maybe there'll be something awesome waiting for us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460383
					]
				},
				{
					"id": 752460383,
					"content": "Yeah, who knows... But we should come prepared just in case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460369,
					"content": "Pretty fun, don't you think?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				}
			]
		}
	]
}