			"dialogs": [
				{
					"id": 752460101,
					"content": "Look, there are people over there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460102,
					"content": "Huh, they look familiar. I think that's...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "Ororon and Ifa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460104,
					"content": "#Oh, {M#Gramps}{F#other Granny} and Paimon! I knew those were voices I recognized!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460105,
					"content": "Bros! Bros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460106,
					"content": "Hah! You're here at the resort, too! Man, it's been a while!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460107,
					"content": "Yep! Chasca told us you've been working here. Guess we were bound to run into each other at some point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460108,
					"content": "Yeah, for sure. Yo, this place has a nice vibe to it, don't you think? I hear everyone's been having a blast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460109,
					"content": "Hehe, definitely! With any luck, it'll only get better, and we'll get even more visitors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460110,
					"content": "What about you two? How's your work going?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460111,
					"content": "Not bad! The saurian staff and the aphids are all in good health and full of energy, so we had some free time on our hands. Thought we'd take a look around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460112,
					"content": "...Aphid STAFF.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460113,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460114,
					"content": "The aphids are part of the staff, too. You missed that part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460115,
					"content": "You can say that again, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460116,
					"content": "Right... My bad. I'm grateful to our entire staff, of course. And, to Mr. Ororon, for looking out for them so... proactively.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460117,
					"content": "We got here early to fight for an important cause. That's its own reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460118,
					"content": "You see, this is my bro's first time getting a formal invitation like that, and as you can probably tell, he's very, um... committed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460119,
					"content": "Enthusiasm's a good thing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#See? {M#Gramps}{F#Other Granny} knows what {M#he's}{F#she's} talking about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460121,
					"content": "Every day, we get a new chance to fight for what's important. Cacucu taught me that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460122,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460123,
					"content": "But, aren't you just... fishing? Since when did that count as \"fighting for what's important\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460124,
					"content": "Do you even hear yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460125,
					"content": "Since it was suggested by a friend, of course. He's a famous adventurer from Mondstadt with incredible luck. If he says it'll work, who are we to argue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460126,
					"content": "(Wait... Bennett?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "Yeah, that bro spun a stick around and it ended up pointing at this pond. As Ororon put it — better to follow luck where it leads than try to make your own. So, we came to fish here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460128,
					"content": "Okay, even if that made sense... This pond is surrounded by capybaras! Can you even fish here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460129,
					"content": "Of course! Capybaras are gentle creatures, so we're good. Besides, when life gives you water, you fish. That's what Granny taught me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460130,
					"content": "Ah, another one of Granny's pearls of wisdom. Along with, \"when life gives you food, you eat\" or \"when life gives you lemons, make lemonade.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460131,
					"content": "#Haha, exactly. Except, we're the ones handing you lemons this time, {M#Gramps}{F#other Granny} and Paimon. Since you're here, why don't you fish with us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460132,
					"content": "And, to up the ante a bit... Whoever catches the biggest fish gets a pint of Ororon's Aphimead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460133,
					"content": "Now that's an offer Paimon can get behind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460134,
					"content": "#Hehehe, did you forget who you're dealing with here? We never back away from a challenge, and {NICKNAME} is a tough opponent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460135,
					"content": "Let's do this, bro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "Got your game face on, I see! Alright, I'm down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460137,
					"content": "I'll take you on, grandson.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "Alright, then it's winner takes all — meaning not only all the fish, but the aphid staff's mead too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
