			"dialogs": [
				{
					"id": 756750101,
					"content": "Hey... Yah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750102,
					"content": "My head's already full of music — dance, dance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750103,
					"content": "Sway, sway~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750104,
					"content": "So happy~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750105,
					"content": "Krraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750106,
					"content": "Made some extra money too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750107,
					"content": "Huh? Since when?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750108,
					"content": "Nusta was swamped, so I helped out her trainees and cleared out a few monster nests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750109,
					"content": "In Natlan, fighting and dancing are equally exhilarating. I like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750110,
					"content": "Thanks for that, Marine. I wanted the rookies to get more training, but they still couldn't handle that mission on their own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750111,
					"content": "I'll make them train harder when we get back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750112,
					"content": "No need — they did great. Just didn't expect the nest to have seven times the estimated number of monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750113,
					"content": "And the Flower-Feather Clan pays pretty well. I even saved enough to get a gift for Aeval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750114,
					"content": "But your vacation's about over too, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750115,
					"content": "A few more days, then I'll start thinking about booking the return ship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750116,
					"content": "No rush, we can still dance. Roxane, Letellier, Chenee, and Frejus have all been competing for jobs lately, so I won't steal their thunder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750117,
					"content": "Then let's just keep dancing and keep having fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750118,
					"content": "When you're tired, eat. When you're full, sleep. No worries at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750119,
					"content": "Raargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750120,
					"content": "The Melusines and the little Koholasaurus lined up and bounced their way toward the stage.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "What a lovely group of guests...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750122,
					"content": "Hehe, looks like you're enjoying yourself too, Nusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756750123,
					"content": "Your smile looks so much more relaxed now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "Really? Then I suppose I must attend every dance party from now on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750126,
					"content": "I'll make sure those kiddos who call me \"ma'am\" or even \"auntie\"... will one day realize I'm younger than them in spirit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750127,
					"content": "And I believe future dance parties should be just like this one — if anything, they should happen more often! I'm all for making it a monthly tradition!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750124,
					"content": "And you even look a bit younger somehow.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}