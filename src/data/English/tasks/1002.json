			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moon Carver"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10020501,
					"content": "We've digressed. State your purpose, traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020502
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020502,
					"content": "Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020503,
					"content": "Preposterous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020504
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020504,
					"content": "PREPOSTEROUS!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020505
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020505,
					"content": "The Liyue Qixing... utterly disappointing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020506
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020506,
					"content": "How could someone possibly assassinate Rex Lapis during the Rite of Descension...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020507
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020507,
					"content": "And then place suspicion upon the attendees!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020508
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020508,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020509
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020509,
					"content": "Traveler, of the unjust accusations placed upon you, one has become aware.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020510
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020510,
					"content": "The mind knows its answer. Though one must consult with one's fellows, lest the mind be misguided.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020511
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020511,
					"content": "Go. Take your Sigil of Permission, carry with you a message.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020512,
						10020513
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020512,
					"content": "Who should I look for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020513
					]
				},
				{
					"id": 10020513,
					"content": "Where should I go?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020514
					]
				},
				{
					"id": 10020514,
					"content": "Mountain Shaper and Cloud Retainer can be found here. Only fate will decide if you shall find them — only fate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020515
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020515,
					"content": "There exists a Conqueror of Demons, a Guardian Yaksha. Go to Wangshu Inn. There you shall seek him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moon Carver"
				}
			]
		}
	]
