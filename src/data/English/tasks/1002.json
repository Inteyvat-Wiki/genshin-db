				"points": []
			},
			"dialogs": [
				{
					"id": 10020201,
					"content": "And who might we be? Those that dare enter Jueyun Karst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020202,
					"content": "I was sent here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "Please take a look at this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "A Sigil of Permission... Many a season has passed since one was last in the presence of such an item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020205,
					"content": "He before you is the mighty and illuminated adeptus, Moon Carver. Speak, traveler. What business have you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020206,
					"content": "Actually...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020207,
					"content": "It's the assassin! They dared to flee here to Jueyun Karst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "Millelith Sergeant"
				},
				{
					"id": 10020208,
					"content": "Sir, we've already stepped too far into Jueyun Karst ourselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "Millelith Soldier"
				},
				{
					"id": 10020209,
					"content": "We... Argh, there's no choice. Apprehending the assassin is top priority, we must press on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "Millelith Sergeant"
				},
				{
					"id": 10020210,
					"content": "...disturbing our borders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020211
					],
					"speakerTitle": "Moon Carver"
				},
				{
					"id": 10020211,
					"content": "See them gone. One will not have interruption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moon Carver"
				}
			]
		},
		{
			"id": 100205,
			"completionStepIds": [
				100205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
