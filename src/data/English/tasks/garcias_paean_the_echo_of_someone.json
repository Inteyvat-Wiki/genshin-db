						230170302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170302,
					"content": "Here's your payment. Do accept it, if you would be so kind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170303,
					"content": "Traveler, why are you giving me that look? You're making me nervous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170304,
					"content": "Ahem! I am going back to work now. Yes, back to work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
