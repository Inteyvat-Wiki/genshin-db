			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "T—Traveler! You're just in time. I was just about to go back to work after this coffee break with Ms. Kaia. Allow me to introduce you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170102,
					"content": "Ah, so you must be the Traveler Garcia's been talking about. It's a pleasure to meet you, I'm Kaia, a... um... well, I dance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Hello, Garcia mentioned you before, I believe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Hehe, is that so? I'm happy to hear that. I was beginning to think that he commits nothing but his machine and Lutong to memory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "You can safely exclude me from this, Ma'am. I believe that this shall be to Mr. Garcia's liking, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "Now, that wouldn't do. Without you, Garcia would surely find himself penniless in the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "Forgive me, Ma'am, if I must disagree. I am certain that Mr. Garcia would save up for two cups of coffee, no matter what.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "Make that three cups!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170110,
					"content": "You display most astonishing empathy, Mr. Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "Well, b—back to business! Now, Traveler, I am still in need of the insignias that the Treasure Hoarders carry with them. Should you find any, do consider selling them to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170112,
					"content": "I have... earned some Mora recently. So you need not fret about your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
