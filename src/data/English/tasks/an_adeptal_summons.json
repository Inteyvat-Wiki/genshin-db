				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020201,
					"content": "These are indeed the blueprints for my Dwelling in the Clouds. One is most pleased.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020202
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020202,
					"content": "You still haven't said what you're gonna—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020203
					]
				},
				{
					"id": 718020203,
					"content": "Must you continue to question me? *sigh* Very well, considering you did make an offering...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020204
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020204,
					"content": "One has heard of a certain Jade Chamber that hangs in the air above Liyue, built by mortal hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020205
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020205,
					"content": "One has also heard that mortals value size above all else, and have on this basis proceeded to declare that said chamber is without parallel in all the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020206
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020206,
					"content": "Hmph! Such are the limits of mortal comprehension, that they fail to fathom the ingenuity of the adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020207
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020207,
					"content": "Jade Chamber my foot! A glimpse at the most trivial of my mechanical accomplishments would reveal the Jade Chamber to be an utterly tedious and mundane piece of work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020208
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020208,
					"content": "Sore loser much...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020209
					]
				},
				{
					"id": 718020209,
					"content": "Nonsense! I am no loser, nor am I afflicted with sores... I merely pity the foolish! These mortals, blind to adepti ingenuity, bedazzled by the crudest of craftsmanship...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020210
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020210,
					"content": "I fear that this will cause mechanics among mortals to develop in a woefully mistaken direction. It falls to me to point them down the right path.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020211
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 718020211,
					"content": "The matter at hand is concluded. Leave at once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
		{
			"id": 7180203,
			"completionStepIds": [
				7180207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180207",
