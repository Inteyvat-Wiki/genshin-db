			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020401,
					"content": "You still have not obtained the blueprints? But they are right there, in the Dwelling in the Clouds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020402
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020402,
					"content": "Ugh, how'd she know we hadn't fetched them yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718020403,
					"content": "Those blueprints are a work of my own hand, should I not be able to sense when they are in my presence? Now, fetch them forthwith!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visit the adeptus' abode"
				}
			]
		},
		{
			"id": 7180205,
			"completionStepIds": [
				7180204
