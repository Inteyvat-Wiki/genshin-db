						],
						"stepId": 7180207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020301,
					"content": "State your business at once! One has a myriad matters to which one must attend. Waste not the valuable time of an adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020302,
					"content": "Just wanted to see how you're doing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020304,
					"content": "Your business is a novel one... You simply came to wish me well, and not to fulfill a wish of some other nature?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020305,
					"content": "Very well, so be it! Mortal minds work in mysterious ways... I have no interest in attempting to understand them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020306,
					"content": "Since you are so demonstrably idle at present... Would you care to do me a small favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020307,
					"content": "Once upon a time, when I had made a modest breakthrough in my mechanical studies, I built for myself a Dwelling in the Clouds suspended in the air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020308,
					"content": "This Dwelling in the Clouds was built principally from plaustrite, supported by a multitude of other ingenious features... In fact, its most marvelous feature of all was, was... Never mind, you would not understand even if I explained it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020309,
					"content": "After construction of the Dwelling in the Clouds was complete, I left the blueprints there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020310,
					"content": "I also added a seal, thinking that one of true affinity with the blueprints might eventually obtain them. But no — to this day, the seal stands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020311,
					"content": "It now seems a needless bother to me to have the blueprints stored there. Perhaps you can retrieve them from the Dwelling in the Clouds for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020312,
					"content": "Sure!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "Such enthusiasm. Then do not delay, deliver them to my abode when you have found them, for that is where I shall be waiting for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020314,
					"content": "What are you gonna do with it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "Naturally, I have my reasons. But please, do not presume that you could scrutinize an idea conceived in the mind of an adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "Visit the adeptus' abode"
				},
				{
					"id": 718020316,
					"content": "Delay no further. Deliver them to my abode when you have found them, for that is where I shall be waiting for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visit the adeptus' abode"
				}
			]
		},
		{
			"id": 7180204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
