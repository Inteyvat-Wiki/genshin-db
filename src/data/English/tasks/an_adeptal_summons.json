			},
			"dialogs": [
				{
					"id": 718021301,
					"content": "...Errr, what is this? It's a table... and a box on top of it, and nothing else anywhere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021302,
						718021303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021302,
					"content": "It's an adeptal table.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				},
				{
					"id": 718021304,
					"content": "You have reached this place, and one knows already your heart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021305
					],
					"speakerTitle": "Cloud Retainer...?"
				},
				{
					"id": 718021305,
					"content": "Uh, it's talking again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021306,
					"content": "Pen down your wish, and consign it to the chest. One shall make the final decision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021307
					],
					"speakerTitle": "Cloud Retainer...?"
				},
				{
					"id": 718021307,
					"content": "Dangers you have braved with an unwavering will — a rare gift indeed. Take, then, these treasures with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021308
					],
					"speakerTitle": "Cloud Retainer...?"
				},
				{
					"id": 718021308,
					"content": "Woohoo! Hehe, Paimon knew you wouldn't let us come away empty-handed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021309,
					"content": "Still, this voice says, \"Pen down your wish, and consign it to the chest.\" Guess we just write our wish down and put it in?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021310,
						718021311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021310,
					"content": "Best not to make a wish to the adepti willy-nilly...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021312,
					"content": "Yeah, that's right. We could just go to... Ms. Xianyun directly if something came up, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021313,
					"content": "In that case, let's just put the blueprint in and leave, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021314,
					"content": "This place sure is empty, though. Guess she must've taken everything with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021315,
					"content": "What sort of situation were these devices made for, anyway...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021316
					]
				},
				{
					"id": 718021316,
					"content": "Paimon doesn't know either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021317,
					"content": "But we can just ask her about her abode the next time we meet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021311,
					"content": "Making a wish to someone you know feels a bit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021303,
					"content": "And an adeptal box.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				}
			]
		}
	]
