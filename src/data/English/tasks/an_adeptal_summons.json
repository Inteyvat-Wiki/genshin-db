			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718021001,
					"content": "To seek the adepti in Jueyun is no mean feat. Still, you have come forth...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "Visit the adeptus' abode",
					"speakerSubtitle": "Somewhat Distorted Voice?"
				},
				{
					"id": 718021002,
					"content": "Whoa! D—Didn't she already go to Liyue Harbor? Did she sneak back here while we weren't looking?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021003,
					"content": "Her voice... doesn't sound quite right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "Uh, so, we were just worried that someone might steal stuff from your place. We didn't mean to disturb you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021005,
					"content": "...One has a task you might perform. Perform it well, and access to one's abode shall be granted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "Visit the adeptus' abode",
					"speakerSubtitle": "Somewhat Distorted Voice?"
				},
				{
					"id": 718021006,
					"content": "She's just talking to herself at this point...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "Err, so you mean that this isn't her we're talking to, but some sorta machine she left behind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021009,
					"content": "Once upon a time, when one had made a modest breakthrough in my mechanical studies, one built for oneself a Dwelling in the Clouds suspended in the air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "Visit the adeptus' abode",
					"speakerSubtitle": "Somewhat Distorted Voice?"
				},
				{
					"id": 718021010,
					"content": "And when said Dwelling was completed, one thought upon the rarity of meeting an adeptus, and there one left the blueprint, for some fated person to take them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "Visit the adeptus' abode",
					"speakerSubtitle": "Somewhat Distorted Voice?"
				},
				{
					"id": 718021011,
					"content": "Retrieve the blueprint before entering one's abode once more. We shall speak more at that time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "Visit the adeptus' abode",
					"speakerSubtitle": "Somewhat Distorted Voice?"
				},
				{
					"id": 718021012,
					"content": "Err, Lady Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "Cloud Retainer? Xian... Err, Ms. Xianyun...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021014,
					"content": "Retrieve the blueprint to complete this task, and then one's abode once more. We shall speak more at that time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021015
					],
					"speakerTitle": "Visit the adeptus' abode",
					"speakerSubtitle": "Somewhat Distorted Voice?"
				},
				{
					"id": 718021015,
					"content": "On and on she goes, without paying attention to us at all, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021016,
						718021017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021016,
					"content": "Definitely a machine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021018,
					"content": "But aren't abode machine guards usually the... punchier sort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021019,
						718021020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021019,
					"content": "She might have her considerations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021021,
					"content": "Well, why don't we go get it and then come back and look inside the abode?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021022,
					"content": "Hehe, Paimon's kinda curious about what machine she's left in there, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021020,
					"content": "I'm a bit concerned about that blueprint...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021017,
					"content": "It's started to repeat the last line...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
