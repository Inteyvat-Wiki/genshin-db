			},
			"dialogs": [
				{
					"id": 721250301,
					"content": "What are you doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250302
					]
				},
				{
					"id": 721250302,
					"content": "I was wondering where I could find some flower seeds, so that I can plant flowers around here again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250303,
					"content": "The population of this island was evacuated during the Mikage Furnace incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250304,
					"content": "I moved back after I heard that everything had been resolved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250305,
					"content": "But all the flowers I planted around here have withered, and I can't find any seeds anywhere. What a pity... this is the perfect place for planting flowers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
