					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250501,
					"content": "Are these flower seeds any use?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Hmm...? Oh, wow! Yes, of course they are! With these seeds, I'm sure I can grow a lot of flowers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "Uh, umm, sorry, please wait... I have to give you something in return...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "These are for you. Thank you so much for the flower seeds! Come visit again some time in the future, and I'm sure you'll see a beautiful sea of flowers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
