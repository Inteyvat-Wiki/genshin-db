			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "Traveler, you're here! Did you come to pay respects?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440102,
					"content": "How's your wood carving going?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "Oh, I'd say that I'm doing fine. I still need to fix the dimensions of the carvings, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440104,
					"content": "According to my initial thoughts, these carvings should fit snugly in a person's palm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440105,
					"content": "That way, they can play with it easily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440106,
					"content": "Also, other than the carvings themselves, I think I should make some decorations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440107,
					"content": "I've seen that when people make these carvings, they will also add some accessories on the side.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440108,
					"content": "Things like flowers, animals, bases that have flowery patterns, things like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440109,
					"content": "I'd also like to put such decorative bases on my wood carvings. That said, due to sizing issues, we can only put one ornament on one wood carving...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440110,
					"content": "But I'm thinking that if the decorations are detachable, I can just put on whatever decorations my customers request.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440111,
					"content": "I'd probably want to start from simpler decorations... Something like Naku Weed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440112,
					"content": "So, Traveler, could you help me gather 3 stalks of Naku Weed back to use for reference?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440113,
					"content": "I've got your back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "Sorry, Traveler, but I'll be leaving this in your hands. Come back and look for me once you have those Naku Weeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440114,
					"content": "Why three?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "If I can get three, I can view them in three different states.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440116,
					"content": "That way, I should be able to carve the best Naku Weed that I can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
