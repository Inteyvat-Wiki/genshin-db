				"points": []
			},
			"dialogs": [
				{
					"id": 220440301,
					"content": "Oh, nice! These should do the trick. Thank you so much, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440302,
					"content": "Now, time to do a little investigating. How are we going to carve wood into the shape of Naku Weed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440303,
					"content": "If I can make these decorations well enough and have a wide enough variety of them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440304,
					"content": "Maybe we'll be able to sell them separately...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
