			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "Is that Albedo? Why would he hang around a place like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410402,
					"content": "The word on the street is he loves painting. He'll hang around anywhere for a good landscape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410403,
					"content": "The views and scenery here are pretty good, potential paintings everywhere you look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410404,
					"content": "But... can't he see those hilichurls? Isn't he in danger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410405,
					"content": "Eek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "Who are you? Why did you alarm them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410602,
					"content": "Thank the gods I'd already completed my painting. Would've been a shame to leave these particular hilichurls unfinished.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410603,
					"content": "You were painting hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "What's up with painting hilichurls? What makes them so interesting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410606,
					"content": "Hmm, I'm afraid the answer isn't easy to explain. If you'd like to have a look at my painting, it may give you a clue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410607,
					"content": "Uh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "Wow, look at the detail! But some of it seems to have been done in a hurry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410610,
					"content": "You can find these hilichurls anywhere, quite boring in fact, not worth closer inspection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410611,
					"content": "But take a look at this specimen. The build, the coat... And there's a distinct force at work here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410612,
					"content": "In the cyclical lives of such primitive communities, such unique attributes are an indication of evolution at work. Evolution, the transition from nothing into existence, from the known to the un—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410613,
					"content": "Hold your horses. Ugh, something tells me we're in for a thesis, and I haven't got the stamina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410614,
					"content": "We've found your man, I'm headed back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410615,
					"content": "What!? Don't you have any questions for him? Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410616,
					"content": "Ugh, what a weirdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410617,
					"content": "So Sister Rosaria brought you? Surprising. And I didn't have time to thank her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410618,
					"content": "But back to the point. From her words, it seems that you were looking for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410619,
					"content": "Mm-hmm, we met a girl in Mondstadt, Sucrose! She said you were stuck with your research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410620,
					"content": "I see, so Sucrose sent you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410621,
					"content": "Then, if I'm not mistaken, you must be the Honorary Knight. You've got the whole of Mondstadt talking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410622,
					"content": "I've heard a bit of everything: your actions during Stormterror's attack, your elemental control, and quite a few other mysterious things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410623,
					"content": "I'll skip to the conclusion, there's only one possibility after all. You came from afar — from another world. Correct?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410624,
					"content": "Correct.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "Excellent. If I could procure your assistance, I think my research would benefit enormously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410627,
					"content": "Your research?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "Ah — forgive me, this must be confusing. Where should I begin? Hmm... The essence of life?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410630,
					"content": "Whoa whoa, you want to start with that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410631,
					"content": "Hmm... You're right. Giving a demonstration would be better than trying to explain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410632,
					"content": "For example, awakening life. Breathing new life into fallen leaves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410634,
					"content": "You can do that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410635,
					"content": "Alchemy really is miraculous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "However, I have a particular seed in my possession. The method I'm talking about has produced no results.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410639,
					"content": "It's like you, in that it hails from another world. Helping it to grow — to bloom... That's the problem my research is up against. That's where I'd need your assistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410640,
					"content": "Well, if you're struggling to figure it out, Paimon's not sure we're gonna be much assistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410641,
					"content": "I beg to differ. I'm unable to comprehend the intricacies of life outside of the known world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410642,
					"content": "But you're not from the known world. By observing and researching you, I may just be able to find a way to get the seed to sprout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410643,
					"content": "So I'm an... object of research?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#Uh... Shall we just get outta here, {NICKNAME}? This sounds a little freaky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410645,
					"content": "Is there any danger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "It's possible. But I will do everything in my control to ensure your safety.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410649,
					"content": "Time for a change of surroundings, we should be going. There's research to do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410650,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410651,
					"content": "Albedo and that Traveler seem to have hit it off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410652,
					"content": "Takes a weirdo to know one I guess. I wonder... Does this constitute a risk to Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410647,
					"content": "What's in it for me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "Mora, knowledge. And the answer to the question you are seeking. It happens to be an answer that I can provide. How does that sound?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410636,
					"content": "Alchemy really is useful.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410628,
					"content": "I'm not sure I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410625,
					"content": "You are worthy of your scholarly reputation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410608,
					"content": "Very... avant-garde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410604,
					"content": "I thought you were painting a landscape.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				}
			]
		}
	]
}