				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "Now is the time to release the seal. Here, take the Key of the Moon-Bathed Deep you retrieved before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330302,
					"content": "Say that again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330303,
					"content": "Key of the Moon-Bathed Deep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330304,
					"content": "Say that again three times fast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330305,
					"content": "Key of the Moon-Bathed Deep, Key of the Moon-Bathed Deep, Key of the Doom-Bathed Meep... Gah! Okay, it's a bit of a tongue-twister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330306,
					"content": "See? Paimon told you that it was a weird name! You should consider changing it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330307,
					"content": "Eh, even if we do change its name today, it'll only be important again a few centuries down the line. Just bear with it for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330308,
					"content": "*cough* Either way. I'm going to begin the ritual now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330309,
					"content": "Unfortunately, we do not have any details as to the nature of Enkanomiya's trial, so you will have to rely on yourself there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330310,
					"content": "If we must blame anything, we should blame stupid traditions that are supposed to \"preserve mysteries.\" I wish you good luck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330311,
					"content": "Also, please do not push yourself too hard. Your safety is of utmost importance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
