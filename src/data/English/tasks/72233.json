			"dialogs": [
				{
					"id": 722330401,
					"content": "#Anything else you wish to ask me, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330402,
					"content": "About the Key Sigils...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "We've placed them at the Fin and Heart of Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330404,
					"content": "Honestly, we just tried to find a compromise between distance and stealth, and those two shrines happened to be in decently concealed locations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330405,
					"content": "We tried our best. Really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330406,
					"content": "Where do I find the altars?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "You can find them to the north and to the east. They are located along the second mountain wall that surrounds the Moon-Bathed Deep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330408,
					"content": "If you draw two lines between Sangonomiya Shrine and the Fin and Heart of Watatsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330409,
					"content": "Then connect those lines with the arc of the mountain wall, you should get two positions. That's where the altars are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
