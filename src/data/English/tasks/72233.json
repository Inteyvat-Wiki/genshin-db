				{
					"id": 722330501,
					"content": "#Anything else you wish to ask me, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330502
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330502,
					"content": "About Byakuyakoku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Enkanomiya's name was Byakuyakoku once upon a time. There was neither sun nor moon in that underground realm, and the only two astronomical phenomena being the Whitenight and the Evernight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "One of my ancestors was a shrine maiden named Eboshi. She was a character of some significance in Byakuyakoku's history, and it is due to her that I am in charge of the Watatsumi Goryou Matsuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
	]
