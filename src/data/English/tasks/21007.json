			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "They've left... They've all left...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070502,
					"content": "Yuan Qing, Yuan Liang, Yuan Cheng... You foolish children. You'll have to think a bit more carefully and look harder than you are doing now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100708",
							"3"
						],
						"stepId": 2100708,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "Hey, look! It's those guys from earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "The tree who stands alone has no forest to call his home... Haha, it's true, you can't achieve anything by yourself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070603,
					"content": "The splendid red autumnal leaves, part ways though there be no breeze... If I could take my brothers and father at their word...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070604,
					"content": "The glorious red autumnal leaves, part ways on a passing breeze... The treasure... Lost everything, all because of the treasure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070605,
					"content": "Trees should blend their roots and shade, for that is where the home is made... Children, we're supposed to be a family...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070606,
					"content": "You seriously thought I hid treasure in the mine? ... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070607,
					"content": "There is a treasure, though... Do you still remember the tree we planted together as a family when you were children?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070608,
					"content": "I come here every year and put a little something inside, hoping that when you're older we can dig it out together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070609,
					"content": "And then use it to buy some treats and a bottle of wine... celebrate together, as a family... talk about the old times...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070610,
					"content": "Oh children, my dear children...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		}
	]
}