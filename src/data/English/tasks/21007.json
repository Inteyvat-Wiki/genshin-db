			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Cheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "Hmph, lousy older brothers! All they care about is taking the best finds for themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070302,
					"content": "And dad's losing it in his old age... either completely oblivious, or just happy to turn a blind eye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070303,
					"content": "I don't think they've realized yet that the treasure's in the mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070304,
					"content": "I've gotta get my hands on it... and then get as far away from here as possible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Cheng"
				}
			]
		},
