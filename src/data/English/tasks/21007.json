			"dialogs": [
				{
					"id": 210070101,
					"content": "\"...The tree who stands alone has no forest to call his home... But the sturdy rock has a heart of gold, unite and you shall share in its blessings... This fortune hereby made known unto you, I say: honor the will of your father...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lost Notes"
				}
			]
		},
