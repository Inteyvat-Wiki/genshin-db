			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Liang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "Hehehe... The treasure will be mine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070402,
					"content": "My brothers are such morons... They ran off after grasping a couple of lines thinking they'd figured it out. Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070403,
					"content": "Honor father's will? Bah! There was one line worth reading in that thing, and that was the part about the treasure being in the mine. Speaking of mine... Soon it will all be mine! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Liang"
				}
			]
		},
