				"objectNames": [
					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "Oh no! What did I do to deserve this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070202,
					"content": "I finally managed to slip away while they weren't watching so that I could be first to get to the mine and find the treasure... But where did all these monsters come from!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070203,
					"content": "I'm done for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Qing"
				}
			]
		},
		{
