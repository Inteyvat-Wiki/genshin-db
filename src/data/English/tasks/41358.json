				"objectNames": [
					"Brother Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "Try the Illumiscreen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580102,
					"content": "Huh? These lanterns...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "Ah, it's you. You've come at a good time. I've changed to a new set of lanterns since the last time you were here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580104,
					"content": "Fancy giving it a try, seeing if you can solve this one? It won't be as easy as last time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580105,
					"content": "Why? Is the image more complex?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "No, no. The image is easy to spot, and there are still only three parts to combine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580107,
					"content": "The difficulty this time has to do with the lantern rotation part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580112,
					"content": "Okay, so, the image to make today is <color=#00E1FFFF>Mora</color>. Remember, you have to get the right image first before you can go looking for the treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580108,
					"content": "Is the lantern rotation more difficult?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "Hehehe, this time the three lanterns are <color=#00E1FFFF>linked together</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580110,
					"content": "To put it simply, when you rotate a lantern, there's a possibility that one of the other ones will rotate, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580111,
					"content": "Give it a go, you'll see what I mean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Brother Qian"
				}
			]
		},
