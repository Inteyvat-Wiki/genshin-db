				{
					"id": 413580201,
					"content": "How is the treasure hunt going?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580202
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580202,
					"content": "I've found every last chest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "All of it? You're quite the expert treasure hunter, then... Plenty of people give up and walk off after the first try...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413580204,
					"content": "Since you found all the treasure... Please take these as your prize. Happy Lantern Rite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brother Qian"
				}
			]
		},
