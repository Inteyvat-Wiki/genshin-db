			"dialogs": [
				{
					"id": 706670201,
					"content": "Meow! (How wonderful! Congratulations on completing the Ascension Challenge. You're now an Expert player!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670202,
					"content": "(You are now qualified to challenge more players. By the way, although you could already do it before, let me remind you that you are allowed to post on the invitation board...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670203,
					"content": "Meow... (This way, whoever wants to challenge you can throw down the gauntlet. A duel without knowing a thing about your opponent can be quite interesting sometimes, don't you think?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670204,
					"content": "(After all, meeting up for a duel is also an opportunity to hang out.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680204,
					"content": "#Meow! (Ah! Sorry, I digress. Anyway, as an Expert player, you, dear {NICKNAME}, have now gained the privilege to buy some truly amazing-looking cards...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706670205,
					"content": "#({NICKNAME}, don't forget why you started playing in the first place, and may the fun be with you in the world of Genius Invokation TCG!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
