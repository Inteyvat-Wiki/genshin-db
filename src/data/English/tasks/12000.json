				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "Wanwen Bookhouse... Guess this is where we go to buy books in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000202,
					"content": "Should we ask here if they have a copy of the Liyue volume of the Teyvat Travel Guide? It's super-duper interesting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "Feel free to take a look around, there's no obligation to buy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000302,
					"content": "We're looking for the Liyue volume of the Teyvat Travel Guide. Do you have it in stock?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000303,
					"content": "Sorry dear, we stopped stocking that a very long time ago. It just wasn't selling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000304,
					"content": "Huh!? But the Mondstadt volume was so interesting! Bummer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000305,
					"content": "The thing is, the author made it too personal, and the result wasn't really much of a guide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000306,
					"content": "It barely sold any copies, and the few travelers that did buy it made complaints afterward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000307,
					"content": "Too much passion, not enough clarity?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "Well, that's a shame. The Mondstadt volume was a good read, even just as an adventurer's diary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000310,
					"content": "The fact remains that I don't have it in stock. If you must read it, try your luck at Chang the Ninth's place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000311,
					"content": "Who's Chang the Ninth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000312,
					"content": "A book collector who lives in Qingce Village. He's a complete grouch — but he will behave himself if the conversation is about books.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000313,
					"content": "He was a regular customer here back when he lived in Liyue Harbor, and I still send him the odd out-of-print book or two every now and then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000324,
					"content": "The place where he lives is difficult to get to. You need to head to the mountain just behind Qingce Village, then follow the wooden walkway all the way up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000314,
					"content": "Did somebody say \"out-of-print books\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000315,
					"content": "Is there a chance that volume six of \"Legend of the Shattered Halberd\" is also in his collection?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000316,
					"content": "Who are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "Apologies my liege, where are my manners? My name is Xingqiu, a humble literature enthusiast who happened to be passing by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000319,
					"content": "Since you and I are both in search of lost books, what say we travel together to Mt. Qingce and pay a visit to Chang the Ninth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000320,
					"content": "Makes sense. Please lead the way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "My pleasure, fellow book lover!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000322,
					"content": "I don't know, it sounds like quite a trek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "Just take it as a chance to get some respite from the hustle and bustle of Liyue Harbor. We all need that once in a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000317,
					"content": "You shouldn't sneak up on people like that!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "Content was a little too wild, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "*sigh* The heavens are smiting me... Smiting me to smithereens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000502,
					"content": "Excuse me, are you Chang the Ninth?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "Uh-huh. And what do you want? Come on, spit it out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000504,
					"content": "We've heard you've got tons of old books lying around, and we wanna borrow the Liyue volume of the Teyvat Travel Guide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000505,
					"content": "Hmph. Don't get me started on the topic of my books...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000506,
					"content": "After the Chasm was sealed off, the family mining business started going south. Then, the Fatui started working to sabotage me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000507,
					"content": "To pay off my debts, I had no choice but to pawn off my beloved book collection. Every last book! Do you have any idea what that means!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000508,
					"content": "You're sad you've got nothing to read now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "Wrong! That was my life's work! I devoted my entire life to curating, collecting, caring for them... And now they're gone! Gone, I tell you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000511,
					"content": "*sigh* It's useless ranting and raving at you like this. All I can do is try to save enough Mora to buy them back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000512,
					"content": "Unless you have other business here, I'm done talking to you. Goodbye! Off you go! Go on, go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000513,
					"content": "Please tell me that you didn't pawn volume six of Legend of the Shattered Halberd?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000514,
					"content": "Legend of the Shattered Halberd... There's a title I haven't heard in a long time. You have good taste, my boy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000515,
					"content": "What, but we don't?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000516,
					"content": "That work was an epoch-defining masterpiece. Granted, it was almost unknown at the time it was published...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000517,
					"content": "But over time it was the work that came to define the genre of martial arts novels — and sparked a plethora of imitation works.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000518,
					"content": "Barely any copies of the first edition were ever printed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000519,
					"content": "The later edition inexplicably went out of print almost as soon as it was released — a shame given what it allegedly added to the original story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000520,
					"content": "Yes! That's right, how did I forget? The original-edition sixth volume of that work is so rare, I could never bring myself to pawn it no matter how much I needed the money.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000521,
					"content": "You mean— You mean you still have it!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000522,
					"content": "Yes. It is my one and only remaining treasure—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000523,
					"content": "Ay! Chang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000524,
					"content": "You've got some nerve keeping me and my boss waiting like this. I need an answer! Will you sell the Cor Lapis or not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000525,
					"content": "I'm sure you don't need me to remind you that if you mess with Gentry Maocai, you're messing with the Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000526,
					"content": "*sigh* You again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000527,
					"content": "But you know I can't afford to give a seventy percent discount on the price... I'd never be able to buy my collection back—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000528,
					"content": "That's your business. The question is, do you want your books or do you want food on your plate? Perhaps you'd like to take your books with you to an early grave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000529,
					"content": "*Grr* You...*sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000530,
					"content": "Whoa there, friend. Come on. This gentleman is either willing to make a deal or he's not. You can't force him to sell against his will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000531,
					"content": "Just who do you think you are? Keep your nose out of other people's business!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000532,
					"content": "My liege, I am but one who comes to the aid of this gentleman in his moment of need. I am Xingqiu, disciple of the Guhua Clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000533,
					"content": "A-hahahahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000534,
					"content": "\"Guhua Clan\"! Did you hear this clown? He thinks he's a Guhua master! In this day and age! Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000535,
					"content": "There was me thinking that the last granddads of Guhua had keeled over and died by now. Who are you supposed to be then, some sort of Guhua messiah!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000536,
					"content": "Justice is blind to our backgrounds, my friend. That just makes me someone trying to do the right thing. But you? The weasel who does the tiger's bidding may be less powerful than his master, but he is no less guilty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000537,
					"content": "Get a load of this guy! Just you wait, you'll be sorry you crossed me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000538,
					"content": "And you, Chang... you're selling that Cor Lapis whether you like it or not!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000539,
					"content": "*sigh* Oh, how the wolves prey upon the fallen tiger! My days are numbered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000540,
					"content": "...So just to come back to what we were talking about earlier, could I get a yea or nay about borrowing that book...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000541,
					"content": "Geez Louise, give the man a minute!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "Oh, what does it matter now? I can't expect anybody to care about me anymore. But since you did stick up for me, please just take this book and leave me in peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000544,
					"content": "Three long years I have waited for this day! Words cannot express my gratitude... I, Xingqiu, vow to repay this great act of generosity!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000545,
					"content": "Alright, give it a rest! Just bring it back when you're finished. Sorry, but I'm not about to put my hopes in some self-professed Guhua disciple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 120000546,
					"content": "Hey! Where are you going!? We've still got a job to do over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000542,
					"content": "Two words: situational awareness...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "You're bored now that you've got nothing to read?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
			"completionStepIds": [
				1200006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200006",
							"2"
						],
						"stepId": 1200006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "So you like reading, huh? Mr. Five-Second Hero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000602,
					"content": "Ho-ho, amazing... I NEVER saw that coming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000603,
					"content": "Hello! Xingqiu! Anybody in there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000604,
					"content": "No wonder this book is so highly sought after...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000608,
					"content": "UGH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000605,
					"content": "That guy back at Chang the Ninth's was pretty bossy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "How can they bully poor old Chang the Ninth like this, forcing him to sell his ore for dirt cheap? It's daylight robbery, pure and simple!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000609,
					"content": "You and I have got to find a way to help Chang the Ninth!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "Don't forget me. I'm in, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000613,
					"content": "Oh, so NOW you can hear what we're saying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000614,
					"content": "The reason I borrowed this book is that it would be a real pity if Chang the Ninth ended up having to pawn it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000615,
					"content": "And I meant every word I said to Chang the Ninth. I will return his act of kindness. It is the just thing to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000616,
					"content": "I will be custodian of this book, and I will also help find a way to buy back the rest of his collection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000617,
					"content": "You already have a plan, don't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "Of course I do. An initial plan, anyway. I still need to work out the details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000620,
					"content": "Give me a second to reflect. It shan't take but a moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000621,
					"content": "You're still here!? What is this, a game to you? You think no one's really gonna get hurt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000622,
					"content": "Huh. I gotta hand it to the Goofball Clan... What you lack in numbers and talent, you make up for in guts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000623,
					"content": "Oh, I'm sorry — did I say Goofball Clan? I meant Guhua Clan... That's what you goofballs call it, right? Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000624,
					"content": "There's a saying that goes: \"The insect that shakes the oak tree ludicrously overestimates its ability.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000625,
					"content": "Quit quoting proverbs at me, you buffoon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000626,
					"content": "Please leave this place. I will not tolerate an attempt to coerce an honest trader — especially when the one you seek to threaten is one to whom I owe a debt of gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000627,
					"content": "It's cute that you wanna stick your neck out for Chang, and all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000628,
					"content": "But you picked the wrong time, you little punk! I brought the Fatui to back me up. A whole army of your little Guhua buddies wouldn't be able to help you now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000629,
					"content": "I may be young, my liege, but the path I have chosen makes me no stranger to conflict. Why should I cower in the face of evil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000630,
					"content": "Great speech. But now it's time for you to learn your lesson!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000618,
					"content": "You don't have a plan at all, do you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "So I guess we're scrapping Operation: Liyue Travel Guide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "Why do you give up on your book search so lightly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000606,
					"content": "That bossy guy back at Chang's — sounds like he's working for a \"Gentry Maocai.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
		{
			"id": 1200010,
			"completionStepIds": [
				1200010
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200010",
							"2"
						],
						"stepId": 1200010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120001001,
					"content": "I thought that was just a regular pendant you were wearing, not a Vision!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120001002,
					"content": "You won this round, but you'd better watch your back! This isn't over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120001022,
					"content": "Would it be too much to hope they've learned their lesson?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001003,
					"content": "So, you're a Vision bearer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "Yes, though I try to avoid using it. I dislike the unfair advantage it gives me against my opponents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001008,
					"content": "They've gone for now, but they'll be back looking to cause more trouble before long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001009,
					"content": "I'll see to it that no harm comes to those who show me kindness. There is a just and an unjust way to do business, and I will ensure the matter is resolved satisfactorily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001010,
					"content": "It's not like the Fatui to pick sides in a business dispute. But the confident demeanor of their errand boy suggests there is substance to his words...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001011,
					"content": "There must be a deeper level of collusion at work here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001012,
					"content": "He mentioned Gentry Maocai. I know this name... he has a stately residence in Liyue Harbor. Maybe the two of you could go and investigate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001013,
					"content": "That idea works... But what are you gonna do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001014,
					"content": "Me? I have other things to look into. Let me see... Let us meet at Yujing Terrace in Liyue Harbor in a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001015,
					"content": "You really have stuff to do? Are you sure you're not just using us as your errand runners?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001016,
					"content": "Wow... So that's how that turned out! This whole passage is just... extraordinary!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001017,
					"content": "ARGH! This guy is SO ANNOYING! Paimon just wants to slap him right in his stupid face!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001018,
					"content": "First let's help Chang the Ninth.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "Hmph. FINE! But as per tradition, Paimon gets to pick an ugly nickname for him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001021,
					"content": "From now on he shall be known as... Guhua Geek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001019,
					"content": "Xingqiu's vengeance may not be swift, but it will surely come.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001005,
					"content": "More to Guhua than meets the eye, huh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001006
					]
				},
				{
					"id": 120001006,
					"content": "N—No, no you misunderstand. That fellow has a foul mouth to be sure, but his assessment of the state of the Guhua Clan is, well... not exactly incorrect, I suppose. *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001007
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001007,
					"content": "Though I long to restore Guhua to its former glory, it is no easy task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				}
			]
		},
		{
			"id": 1200012,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200007",
							"2"
						],
						"stepId": 1200007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 610045101,
					"content": "Hahaha, genius; pure genius! Perhaps a slightly unconventional take on chivalry, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						610045102
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 610045102,
					"content": "He can't hear a single word we're saying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200042,
