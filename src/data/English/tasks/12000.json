				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120004201,
					"content": "I've had my heart set on getting hold of a copy of Legend of the Shattered Halberd volume six for the longest time now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120004202
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120004202,
					"content": "Frankly, I'd be willing to do whatever it takes to get my hands on that book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				}
			]
		}
