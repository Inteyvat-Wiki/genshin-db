					"nextDialogs": [
						722120606
					]
				},
				{
					"id": 722120606,
					"content": "Ah, I understand. The meals you and Hibiki made were all good things. The stone that the stone human will make must then also be a good thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120607,
					"content": "Humans can be quite skilled sometimes, it seems. You have my thanks.",
