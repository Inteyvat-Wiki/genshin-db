			"dialogs": [
				{
					"id": 722120601,
					"content": "Still, I am curious. How will a thing as hard as stone take on my countenance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120602,
					"content": "Is that stone human very powerful? Can he use some magic?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
					],
					"speakerTitle": "Neko"
				},
				{
