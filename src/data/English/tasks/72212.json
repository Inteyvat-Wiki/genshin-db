			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120301,
					"content": "*sigh* When will I be able to find some work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120302,
					"content": "Are you looking for me? What is this about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120303,
					"content": "Do you know how to make stone carvings?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "Eh? Well... Well then, that's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120306,
					"content": "Wait, sorry, I forgot to introduce myself. I'm Ooshima Junpei, and I used to work at Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120307,
					"content": "After that accident, we were all evacuated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120308,
					"content": "But till now, I haven't received any notice that we might be returning to work, so I've been idle here this whole time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120309,
					"content": "So you're looking for someone who can do some stone carving, right? Well, that's not my specialty per se, but I do have some skill in it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120310,
					"content": "What sort of stone carving do you need made? Could you tell me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120311,
					"content": "Well, here's the situation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "Uh... So, let me get this straight. A talking cat wants you to find a craftsman to make a carved statue of it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120313,
					"content": "It's not like I don't believe you or anything. It's just a bit... You know, outrageous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120314,
					"content": "And even if I agreed, how is that... that provisional head priestess supposed to pay me? I'm not going to work for free, no matter what anyone says.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120315,
					"content": "Relax, it'll be fine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(...Will it really, though...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120317,
					"content": "Will it? I... Hmm, it just feels like you're swindling me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120318,
					"content": "Still... You know what? Never mind. I'm a pair of idle hands anyway. Might as well go with you to have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120319,
					"content": "I really hope that I can get paid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 722120304,
					"content": "We're looking for an artisan who can work with stone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
		{
			"id": 7221204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221205",
							"2"
						],
						"stepId": 7221205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Ooshima Junpei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120401,
					"content": "Ah, you have returned. This human must be the stone human, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120402,
					"content": "This is the artisan we hired.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "...What!? The cat... it really can talk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120405,
					"content": "Meow meow meow, such ado about nothing... Is it so strange that I speak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120406,
					"content": "No need to make a fuss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "Wait. Are you saying that this is something super normal for you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120409,
					"content": "That certainly has been the case so far.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "What in the world have you experienced...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120411,
					"content": "Come now, we are not here to merely talk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120412,
					"content": "Back to our main point. Stone human, can you knock on stone and cause it to look like me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120413,
					"content": "Eh? Stone human? You mean me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120414,
					"content": "\"Knock on stone,\" you say... Well, I can give stone-working a go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120415,
					"content": "Is that so? Wonderful, meow meow meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120416,
					"content": "S—So this is how it is, huh... Well, having a job is better than nothing. I mean, I've never worked for a cat before, so... I guess we'll just discuss my salary later?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120417,
					"content": "Hmm. Either way, I'll need to make some preparations. There are quite a few rocks here on this island. I'll need to pick a good one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120418,
					"content": "Ah, yes. How should I address you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120419,
					"content": "I am the Neko, the provisional head priestess of the Asase Shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120420,
					"content": "As to terms of address, you may call me whatever you please, tall, stone-knocking human.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120421,
					"content": "Is that so? Well then, I suppose I shall call you Lady Priestess. You are my employer, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120422,
					"content": "...What is an \"envoyer\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120423,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120424,
					"content": "W—Well, I'll go look around and pick a rock to use, then. You all just stay here for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120425,
					"content": "Working for a cat. Well, that's a first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120426,
					"content": "Mr. Ooshima seems to have forgotten all about that payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120407,
					"content": "It's just a talking cat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "Yes, the stone human.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
		},
