				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "Ah, hello there. What are you busy with today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120202,
					"content": "Helping Neko make a statue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Uh... What? A statue, here? Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120204,
					"content": "I—I'll pick up carving immediately!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120205,
					"content": "I doubt you'll make it in time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "Hmm, is this another one of Neko's requests?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120207,
					"content": "You know what, I don't think it'll be that hard to find craftsmen looking for work, what with the issues we've been having in Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120208,
					"content": "The Guild's received quite a few commissions related to this, and I've heard that some people are still in Tatarasuna looking for work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120209,
					"content": "I encountered just such an encampment while on a commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120210,
					"content": "So if you want, you can try your luck there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120211,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Heh, don't pay it any mind. It wasn't that hard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120215,
					"content": "And you know what? I'd like to see what might happen if that shrine really does thrive again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120216,
					"content": "Especially that \"Hibiki\" Neko keeps talking about. What sort of person could be so beloved by that cat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120217,
					"content": "Alright, don't worry, I'm just talking to myself. Go look for that artisan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120218,
					"content": "As for whether they know how to carve rock or not... Well, I guess that's up to luck, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120219,
					"content": "Come on, Miss Etsuko, you just want to help Lady Neko as well, don't you? Haha, you're such a—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120220,
					"content": "Taisuke, is our survey plan ready yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120221,
					"content": "Uh, I—I'm almost done. Sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120212,
					"content": "You don't seem like your usual self, Etsuko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "What, not used to me giving you information first?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
			"id": 7221203,
			"completionStepIds": [
				7221204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
