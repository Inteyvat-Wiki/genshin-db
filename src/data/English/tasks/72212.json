			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "Your timing is impeccable. I need your aid once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120102,
					"content": "Go on, shoot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "I desire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120104,
					"content": "That you place a tall, large stone shaped in my own image beside this shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120105,
					"content": "Where are we supposed to find something like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120106,
					"content": "She means a statue, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "Whatever the case, I desire something similar to those fox stones on that island far, far away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120108,
					"content": "Hibiki used to say that there were lots of them on that island, and even asked if I would like one made in my image.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120109,
					"content": "I feel that if Hibiki wanted it, it must be good. As such, I ask you to have one such stone made.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120110,
					"content": "I don't have any skill in carving...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "Hmmm, what are we gonna do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120112,
					"content": "Right, why don't we ask Taisuke? He likes cats a lot. He might even be willing to take up carving just to help Neko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120113,
					"content": "Well, I guess we could go look for Taisuke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "That's true! He's so fond of cats. Maybe he can help us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
