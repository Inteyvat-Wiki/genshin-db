				"points": []
			},
			"dialogs": [
				{
					"id": 718080301,
					"content": "You're back. What's the situation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080302
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080302,
					"content": "So, here's what it's like at Nantianmen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "...Earthquakes, monsters, and a little girl... A missing child, presumably?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080304,
					"content": "Here's what she said...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "...She said what? Who's \"He\"? And what \"resurrection\"? What a load of nonsense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080306,
					"content": "Who knows what kind of strange books she must have been reading... Anyway, that's beside the point. I'll send for someone to bring the child back to the city at once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080307,
					"content": "First earthquakes, and now monsters... We musn't let that child come to harm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080308,
					"content": "Thank you so much. Please take these as thanks for running this errand for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080309,
					"content": "Ugh, never a slow day of work, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
