			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "How am I supposed to get that fellow out? This is giving me a headache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940102,
					"content": "Is there anything I can do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "Hm? Oh! A kind adventurer, what good timing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940104,
					"content": "Here's the thing. There used to be a tunnel here that led north, but it collapsed recently after some sort of anomaly with the kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940105,
					"content": "Thankfully no one was hurt, but a traveling merchant from overseas claims his \"companion\" is trapped inside...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940106,
					"content": "It's a Slothsheep he met and befriended around here. Stay in these parts long enough and you'll notice that Slothsheep usually follow people just to scatter the seeds they're carrying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940107,
					"content": "But no matter how we explained it, that gentleman just wouldn't listen. He insisted we find a way to rescue it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940108,
					"content": "To reconnect the path leading deeper into the cave, we'd have to use these Intricate Blooms. The problem is that I can't use the Frostmoon Scions' magic, and I don't have any kuuvahki devices strong enough for the job...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940109,
					"content": "Luckily you came by. If anyone can get that Slothsheep out of there, it would be an adventurer like you, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940110,
					"content": "I'll thank you on behalf of that gentleman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
		{
			"id": 7609402,
			"completionStepIds": [
				7609405
			],
