			},
			"dialogs": [
				{
					"id": 760940501,
					"content": "Oh, isn't this the companion of that foreign trader lost in the cave? So you managed to bring it out after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "We all know the Slothsheep follows you around to scatter the seeds it's carrying farther away, but that gentleman wouldn't believe it, no matter how we explained.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "Honestly, I wasn't sure how to deal with all that. Good thing I ran into a helpful adventurer like you, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940504,
					"content": "Here, just a little something to say thanks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		}
