				"objectNames": [
					"Mali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "My dear friend, are you here to participate in the photography competition as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "As a Fontainian photographer, one who's emerged from the Kamera's birthplace, let me offer you some advice: the purest essence of photography lies within the Kamera itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "Hence, I'd like to introduce you to someone. Back in my hometown, the Kameras he makes are beloved without exception. They come at reasonable prices, too, and I know just how to get my hands on one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "Hey... Don't give me that uninterested look! I'll get you an extra discount!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "Hey... Don't leave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
