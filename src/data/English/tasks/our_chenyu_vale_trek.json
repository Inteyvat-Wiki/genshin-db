			"dialogs": [
				{
					"id": 711101101,
					"content": "Is this pelican here yours, kid? Could we photograph it alongside Qiaoying Village?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101102,
					"content": "Hree hree! Hree hree anng anng hree hree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101103,
					"content": "Eh? What are you saying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "It's pelican talk, which means \"great, great!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "You speak pelican?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Only a little... because I noticed when they eat, they don't stop going \"hree hree! Hree hree anng anng hree hree!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "I'm sure they're happily saying that it's \"great, great\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "So I learned to call to them in that manner too. They come over as soon as they hear, probably because they think there's food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "If you wanna photograph one, then maybe you could try calling out to one yourself! It's too bad I gotta get home now, otherwise, I could teach you some more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "No worries, kiddo! We'll try it ourselves! Thanks, and get home safely!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}, let's give it a go over there! If we can attract a pelican, it'll increase our work's chances of success!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
