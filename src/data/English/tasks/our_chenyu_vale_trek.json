			},
			"dialogs": [
				{
					"id": 711101301,
					"content": "Hang on! Don't come any closer! Are you... are you good people?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101302,
					"content": "Hey, we're the ones who saved you just now! Did you hit your head on something or...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101303,
					"content": "Ah! You're right... I'm really sorry about that. My \"Chenyu Vale Trek\" has been nothing but dizzyingly bad luck... Thank... you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101304,
					"content": "So you're participating in the photography contest, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "You are as well? What a coincidence! I'm just an ordinary tourist, though... So I couldn't do anything about those hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101306,
					"content": "I came across those louts on the road, and they captured and brought me back here without letting me get a word in lengthwise. Hilichurls don't also collect tolls, do they? Preposterous... Luckily, I ran into you guys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101307,
					"content": "Ah... Today was a tough day for you indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101308,
					"content": "Not just today! Yesterday was terrible as well. I bought a rather expensive Kamera from a Fontaine merchant, but it broke after only a few uses. When I went back to find him, he was gone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101309,
					"content": "What a shady guy... Be sure to keep an eye on your wallet while you're out and about!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101310,
					"content": "Ah, sorry. Got a little sidetracked there. Since you're also taking part in the competition, you must be here to photograph Mt. Xuanlian, correct?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101311
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101311,
					"content": "What say I share the best photography spot that I found around here with you as thanks? Here, I'll mark it on your map for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101312
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101312,
					"content": "You can see it from here. In fact, it's right over there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101313
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101313,
					"content": "Eh? What about you then? Aren't you participating in the contest as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101314,
					"content": "This area's rather dangerous, so it'd be best for me to switch things up. I remember the guide spoke of other locations... I think I should check out the Tea-Tasting Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101315
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101315,
					"content": "Yeah! That sounds good. Goodbye, you two! Hopefully, things start turning out well for me now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akai"
				}
			]
		},
