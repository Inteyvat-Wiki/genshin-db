			"dialogs": [
				{
					"id": 711100801,
					"content": "Hmm... these photos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100802,
					"content": "What's wrong? Are ours not good enough?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "It's quite the opposite... I've seen some excellent submissions these past few days, but your works are refreshing all the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100805,
					"content": "Let's take this shot of Qiaoying Village. The pelican adds a touch of liveliness to the tranquil village, contrasting stillness and movement... A one-of-a-kind approach, indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100806,
					"content": "If it were just up to me, your works would certainly be selected for use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100807,
					"content": "Wow! What a compliment! You're making Paimon blush a little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Blush? You're not the one who took these photos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "Paimon was just feeling flattered on your behalf! Paimon knows all about your modesty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Well, in any case, our selection process will be completed before tomorrow morning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100812,
					"content": "From eight in the morning until six at night, we will exhibit the selected works on the street outside Hezhe Post.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100813,
					"content": "Thank you for participating in the \"Our Chenyu Vale Trek\" scenic photography contest. Don't forget to come back around tomorrow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100814,
					"content": "You bet! We're not gonna miss out on the final surprise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "I'm starting to feel a little embarrassed now too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
