				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "I want to spar with this big guy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "Blessed be! Even my lord must keep their divine body limber, so that the fallen slices may grow tender and rich in flavor. Hold nothing back. Show no mercy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "O my lord, Maha Vasudev{RUBY#[D]Scion of the World-Bestowing Lord}ayaputra, may your Jivit{RUBY#[D]Root of Life}indriya sink deep into the bedrock of this land. May your taste surpass that of every god beneath the heavens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "What's this thing...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "A most blessed question! This is the revered Scion of the World-Bestowing{RUBY#[S]Bifrons} Lord, a sacred fungus born of perfected flavor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730303,
					"content": "Nagahvaya ever invokes the Lord of Verdure and the Lord of the Flower{RUBY#[D]Pushpavatika} Garden. Makani Khagan forever prays to the Lord of Sands. Yet ask them yourself. Of the three great lords, which taste better than my lord?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730304,
					"content": "Know this. To do no harm is the righteous path. Were it not for our lord's divine flesh, we would be forced to take the lives of beasts, birds, and plants to survive... Alas, how pitiful that would be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730305,
					"content": "Fortunate indeed. When the Lord of Space carried me away from the ground, my lord's ji{RUBY#[D]spores}va traveled with me as well. And as you now behold, they have grown to this day, bestowing upon me supreme and wondrous flavor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
