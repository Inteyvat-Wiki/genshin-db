				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "What, did you get stumped by Old Chou's games again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				},
				{
					"id": 710820102,
					"content": "C'mon, I told you already... That treasure hunt of his works like this: the <color=#00E1FFFF>better the goods, the more explosive barrels there will be around it, and vice versa.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				},
				{
					"id": 710820103,
					"content": "Got it this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Claims to be \"Tang Wuchou\"",
					"Uncle He",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "You Treasure Hoarder dreg... *pants* If I wasn't so exhausted from lacking any... mushrooms to eat lately...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710820202,
					"content": "I would have beaten you black and blue already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710820203,
					"content": "You old thief! How dare you call my Glaze L... I mean, Qingxin! How dare you call them mushrooms and just... pick and eat them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				},
				{
					"id": 710820204,
					"content": "*cough* By what right do you get to do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				},
				{
					"id": 710820205,
					"content": "Uh, why are you two fighting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820206,
					"content": "I—I was looking for mushroom-meat! Haha, yes, mushroom-meat! But they wouldn't let me back into the mines, no! So I—I came here looking for some.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710820207,
					"content": "And after searching and searching, I finally found that there were mushrooms here! But just as I was reaching for them, this cad attacked me out of nowhere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710820208,
					"content": "#Hah! A cad? He's the one who violated our Guhua training grounds! And what's more, these flowers belong to me... and the heroic {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				},
				{
					"id": 710820209,
					"content": "And the heroic Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820210,
					"content": "Yes, and the heroic Paimon! Other than the three of us, none may touch these sacred grounds!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				},
				{
					"id": 710820211,
					"content": "Treasure Hoarder dreg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710820212,
					"content": "Scandalous old crook!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				},
				{
					"id": 710820213,
					"content": "Okay, okay, Uncle He, Tang Wuchou has stopped being a Treasure Hoarder already. Also, the stuff he planted are flowers, not mushrooms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820214,
					"content": "Eh? Is that so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710820215,
					"content": "C'mon, have a closer look. These are Qingxin for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820216,
					"content": "Ah! Indeed, they are Qingxin! It appears that I'm still a little dizzy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710820217,
					"content": "And you, Tang Wuchou, are you seriously still dreaming of growing that \"great Glaze Lily garden\" of yours?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820218,
					"content": "Well, it would be a most beautiful sight to see, wouldn't you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				},
				{
					"id": 710820219,
					"content": "Whatever the problem is, stop fighting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820220,
					"content": "*sigh* No mushrooms. Goodbye, I go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710820221,
					"content": "Now that that troublesome old geezer is gone, I can finally look into planting some flowers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Claims to be \"Tang Wuchou\""
				}
			]
		}
	]
}