			"dialogs": [
				{
					"id": 762050201,
					"content": "Whoa, that gap's so big!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050202,
					"content": "All things may serve as guides... The scriptures filled... with names divine! The words and chapters... intertwine... and angels act with deeds aligned! In this sacred place, let words forge the path ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050203,
					"content": "~",
					"roleType": "TALK_ROLE_NPC",
