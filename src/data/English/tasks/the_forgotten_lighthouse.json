			"dialogs": [
				{
					"id": 762050301,
					"content": "Treasure! Woohoo, this is so much fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "But... Paimon's head really is pounding. Seriously, did Nicole actually need to shout that loud just to make those stairs appear...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "What's this? Complaining now, are we? Aren't you worried a powerful mage like me might snap her fingers and turn those new trinkets into turnips?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "P—Paimon didn't mean anything by it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Hehe, I'm only joking with you. You should know I'm not the silent, sulking sort of angel that keeps track of every little slight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#...And so, when their day of reckoning finally arrived, {NICKNAME} and Paimon ascended the seven-tiered steps to find a familiar figure awaiting them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050308,
					"content": "Radiant flames converged to form wings upon her back. Her figure remained as noble and beautiful as the day they first met, yet her eyes now shone with a cruel light.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050309,
					"content": "#\"But why?\" asked {NICKNAME} and Paimon in unison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050310,
					"content": "\"It all started the day Paimon complained that I shouted too loudly!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050311,
					"content": "Hey! Words are magic here, don't you know! Don't say such scary things!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050305,
					"content": "Come on, don't take it to heart...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				}
			]
		},
