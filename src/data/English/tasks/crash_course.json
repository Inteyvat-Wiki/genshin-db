			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3071501,
					"content": "Bravo! What a performance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071502,
					"content": "You are, to my surprise, a well-trained knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071503,
					"content": "The battles you just fought were sights to behold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071504,
					"content": "Thanks, that's nice of you to say...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "Haha, I see you already have the knightly virtue of modesty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071507,
					"content": "Stories of your heroic deeds to save Mondstadt from destruction shall be known throughout the City of Freedom, well into the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071508,
					"content": "Please do visit me at our headquarters when you have the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071509,
					"content": "I also know a lovely tavern, if that's more your thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071505,
					"content": "Not worth complimenting really...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				}
			]
		}
	]
