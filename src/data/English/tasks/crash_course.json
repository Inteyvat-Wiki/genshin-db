			"dialogs": [
				{
					"id": 3071101,
					"content": "You've arrived.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071102,
					"content": "Come closer. Can you smell that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071103,
					"content": "...I can't smell anything.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "Something must have happened in the <color=#00E1FFFF>temple</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071106,
					"content": "I imagine there will be slimes, hilichurls, and... whatever is giving Stormterror extra power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071107,
					"content": "Oh yes, it is going to be lively in there indeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071108,
					"content": "Will it be dangerous?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "As bustling as it may be — no, I can't imagine it will be dangerous at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071112,
					"content": "It's a pity that the Temple of the Wolf has been disturbed by such an atrocity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071113,
					"content": "#Let's head in, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071114,
					"content": "No one makes offerings to The Four Winds anymore, yet the old winds never vanish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071115,
					"content": "We need to clear out the temples, for The Four Winds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071110,
					"content": "No doubt nothing more than a disorderly mob of creatures.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "Oh, ho-ho! You're quite the brave one, aren't you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071104,
					"content": "It's the smell of burnt Pyro Slimes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				}
			]
		},
