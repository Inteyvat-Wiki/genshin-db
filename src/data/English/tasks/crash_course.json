					"content": "My first chance to fight beside you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071402
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071402,
					"content": "Think we'll make a good team?",
					"roleType": "TALK_ROLE_NPC",
