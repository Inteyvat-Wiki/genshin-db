				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "Ugh, what a headache... What am I supposed to do about this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660102,
					"content": "What are you up to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "Practicing for the Knights of Favonius' tryouts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660104,
					"content": "*sigh* But I'm nowhere near as powerful as Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660105,
					"content": "I think it's better for me to focus on technique rather than power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660106,
					"content": "For example, I was thinking about how to break all these wooden dummies in one fell swoop... I know they don't look that robust, but they're what I've got. My father went to a lot of trouble to get them for me, so I shouldn't complain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660107,
					"content": "If you're at a loose end, fancy helping me think about how to tackle it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660108,
					"content": "I'll mull it over.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "Sure, take your time. It's not like these dummies are going anywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660111,
					"content": "Nor is my life going anywhere while I'm stuck trying to sort this out, ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660114,
					"content": "At this distance, maybe the best solution would be for me to deal with one side and drop a bomb to deal with the other side.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660115,
					"content": "Haha, just kidding. I have no idea where I would even get a bomb from anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660109,
					"content": "How about we give it a go together...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "You like team combat, then? Alright for some... always someone to help you out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660113,
					"content": "For people like me, the best I can do is try and hold my own as a lone fighter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2006602,
