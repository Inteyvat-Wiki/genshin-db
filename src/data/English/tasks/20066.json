					"content": "Huh, I never even thought of trying that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660303
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660303,
					"content": "Thanks! I'm gonna try it myself now.",
