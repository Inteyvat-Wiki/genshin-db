			"dialogs": [
				{
					"id": 738050101,
					"content": "Traveler, please wait. Here's a letter for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050102
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050102,
					"content": "A letter for me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050103
					]
				},
				{
					"id": 738050103,
					"content": "Yeah, Xudong left it for you. You know, the guy from Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050104,
						738050105
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050104,
					"content": "Where is he now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				},
				{
					"id": 738050106,
					"content": "Beats me. All I know is that he dropped by in a hurry the other day and left this letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050107
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050107,
					"content": "He wanted me to make sure to give it to you. He even offered to pay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050108,
					"content": "Xudong came here... in a hurry? Something must've happened to him, huh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738050109,
					"content": "Did that bad guy cause trouble again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050110,
						738050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738050110,
					"content": "Why don't we read the letter first?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050112,
					"content": "Okay... Let's see what he wrote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738050111,
					"content": "It might tell us what happened.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050105,
					"content": "Why did he leave a letter for me?",
					"roleType": "TALK_ROLE_PLAYER",
