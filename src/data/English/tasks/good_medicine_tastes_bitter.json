					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Doudou, be a good girl, you'll only get better if you take your medicine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "No! I don't want to! I hate it, it tastes gross...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "Oh, hello Traveler. Doudou is quite a sickly child. This is the medicine she needs to take, according to the prescription Dr. Baizhu gave me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "But she refuses to take it. She complains she doesn't like the taste... *sigh* Unfortunately, herbal medicine is bitter, that's just how it is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "The only time she ever agrees to take it is if she gets to have a bowl of Almond Tofu afterwards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "Traveler, if you have the time, could you go and pick me up a portion of Almond Tofu? I should stay here — I may still need to talk her into it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Thank you. Just one portion for Doudou is enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "What illness does she have?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "*sigh* I wish I knew. Whatever it is, Dr. Baizhu says it's nearly impossible to cure, and that just keeping the symptoms at bay takes a lot of medication.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "I fear she might need to take medicine her whole life. And starting at such a young age... It doesn't bear thinking about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "I just wish I were the one with the illness... But the best I can hope for is that things don't get any worse for the poor child.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "Anyway. Please go and fetch me a portion of Almond Tofu, just the one will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Hey kiddo. Not liking the medicine, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "It's sooooo bitter!!! Lulu's medicine is way less bitter than mine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Doudou... Lulu and her friends were just pretending. That wasn't real medicine they were drinking, it was some leftover sugary water from a bowl of Almond Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Oh... So Almond Tofu won't make me get better? Then... I guess I do have to take that icky medicine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "That's right! Good girl. As soon as you're better you can eat whatever you like!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "Why can't they make medicine taste sweet like Almond Tofu? So unfair...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "*sigh* There's no getting through to her... Anyway. Please go and fetch me a portion of Almond Tofu, just the one will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
