						"sceneId": 3,
						"position": [
							2219.314,
							-199.188,
							8840.311
						],
						"pointId": 13689
					}
				]
			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "Wow... There's a bunch of those shiny little things we saw earlier! Wait, where are we, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200302,
					"content": "Could it be we've circled round to right under that weird tree? And those green things... what even are they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
