			},
			"dialogs": [
				{
					"id": 220330501,
					"content": "Eh? I think this is still an Inazuma dish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330502,
					"content": "I don't think this is the dish I asked for... Well, never mind, this dish is also filling...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330503,
					"content": "Thanks anyway, Traveler. Please take these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
