			"dialogs": [
				{
					"id": 220330701,
					"content": "So, which snack should we prepare? How about we choose one for her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330702,
					"content": "Let's see... Paimon's favorite snacks lately are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330703,
					"content": "Cheap but delicious Rice Buns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330704,
					"content": "Delightful and tasty Lotus Flower Crisp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330705,
					"content": "And soft, glutinous Tricolor Dango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330706
					],
