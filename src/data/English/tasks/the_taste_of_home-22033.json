			"dialogs": [
				{
					"id": 220330201,
					"content": "Back so soon? You're not a secret chef, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330202,
					"content": "Hmmm... I can't wait, please let me try it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330203,
					"content": "Please enjoy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "Let's see... What dishes did we talk about just now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "Oh right... Rice Buns, Lotus Flower Crisp, and Tricolor Dango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330206,
					"content": "Let's decide and give it to Miss Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2203303,
