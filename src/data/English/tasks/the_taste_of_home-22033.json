					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330301,
					"content": "Ah! This is it! This, this is the taste of home I've been dreaming of... It's... *sob* I'm so touched...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330302,
					"content": "Thank you so much! I feel energized with all this good food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330303,
					"content": "These are for you. I wish you a smooth journey ahead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203304,
			"completionStepIds": [
				2203304
