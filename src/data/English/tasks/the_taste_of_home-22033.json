			},
			"dialogs": [
				{
					"id": 220330601,
					"content": "Hmm? Why does th—this dish taste... so... so interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330602,
					"content": "Can't say it's interesting... Uhh, I should say...unique, or something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330603,
					"content": "How did you come up with such a dish? Your cooking skills are really...out of this world...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330604,
					"content": "Thanks for your hard work! Traveler, please take these. I'll umm, savor this dish later...",
					"roleType": "TALK_ROLE_NPC",
