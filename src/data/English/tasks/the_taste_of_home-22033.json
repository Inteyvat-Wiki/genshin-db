					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "Hmm, this taste... well, it doesn't seem to taste like a Liyue or Inazuma dish. The taste is really new to me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330402,
					"content": "Although it isn't the cuisine I wanted to eat, I'm already satisfied to be able to taste such a novel dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330403,
					"content": "Thank you, Traveler. Please accept these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203305,
