			"dialogs": [
				{
					"id": 733550101,
					"content": "Hey, a Fungus just floated past. Should it be doing that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550102,
					"content": "Normally, it's pretty dangerous to have Fungi wandering around the city, right? Unless we're talking about the special cases, the super well-behaved ones that have undergone training...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550103,
					"content": "Now that Paimon thinks about it... Why does this feel so familiar? Haven't we been through something similar before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550104,
					"content": "Hold on, is that Bongo-Head?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "That's right! It's Bongo-Head! The Fungi friend we met back in Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550106,
					"content": "Woahhh! It's been so, so long since we last saw it! Come on, let's go say hi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550107,
					"content": "What \"special cases\" again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "Paimon thinks that's... Bongo-Head? The Fungi friend we met back in Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550109,
					"content": "Woahhh! It's been so, so long since we last saw it! Come on, let's go say hi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
