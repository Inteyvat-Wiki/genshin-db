			"dialogs": [
				{
					"id": 705222301,
					"content": "I think that's a good price! You've got yourself a deal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052224,
			"completionStepIds": [],
