			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "Quqing, we're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220302,
					"content": "We've placed an order for the drinks you need. It'll be loaded on the boats tomorrow and it'll be sent to the docks as soon as possible! Please take this receipt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220303,
					"content": "That's it? Wow, you guys move fast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220304,
					"content": "I...I... I'll prepare you a pot of tea with the best spring water...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220305,
					"content": "No need to be so generous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "Yes, yes. We have other people to help order for. There's no need for you to serve us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220308,
					"content": "All the best with your business! Next time we'll come to your place for a nice drink!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220309,
					"content": "Ah... Well, next time I'll be sure to make your favorite drink!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220310,
					"content": "Please come again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220306,
					"content": "We've taken payment for our work already.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
