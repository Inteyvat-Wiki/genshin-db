			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "Welcome to The Cat's Tail! What can I get you guys?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220202,
					"content": "Hello, Diane. We've got a business proposition for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220203,
					"content": "You explain Quqing's order request to Diane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "Oh? The beverage shop on Liyue's north pier that just opened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220205,
					"content": "The sailors from Dornman Port have spoken about the shopkeeper, and Margaret seems to have sourced ingredients from her before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220206,
					"content": "Recently, when Quqing was selling thirst-quenching drinks to sailors at the dock, she also asked them to promote Qingce Village's spring water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220207,
					"content": "She gets water at a high price from Qingce Village and resells it where there is demand, only earning the basic cost of individual labor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220208,
					"content": "With her help, people from other places can brew wine with a unique flavor using the spring water of Qingce Village, and it provides a source of income for the elderly folk in the village. It's two birds killed with one stone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220209,
					"content": "So that's how the story goes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "Whoa, Quqing is such a nice person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220211,
					"content": "Yup. Perhaps The Cat's Tail will be a long-term partner with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220212,
					"content": "Anyway, let's talk shop. How much are you going to pay for all these Mintberries?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052203,
			"completionStepIds": [
				7052203
