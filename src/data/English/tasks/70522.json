			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "Welcome! What would you two like to drink?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220102,
					"content": "Hmm... judging by how you guys are dressed, I'm guessing you're not from around here. I don't know if the tea I've got here is suited to your tastes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220103,
					"content": "I'll start you guys off with a pot of Yunlai White Tea. If that's not to your liking, you can come back later. I should be able to get someone to pick up a batch of specialty drinks from Mondstadt's Weinlesefest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220104,
					"content": "Thanks, but we're not here to drink.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "That's right! We're reliable errand runners! Paimon heard you put up a commission at the Weinlesefest asking for someone who knows what they're doing to help with ordering drinks, so that's where we come in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220107,
					"content": "If you want to place an order for any drinks, let us know, and we'll take the order for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220108,
					"content": "You guys came all the way to Liyue to take orders for clients? You guys are so sweet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220109,
					"content": "I was afraid no one would accept such a troublesome commission... I'll leave it to you then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220110,
					"content": "I've heard from sailors who have been to Mondstadt that <color=#00E1FFFF>The Cat's Tail Tavern</color>'s specialty, the \"Mintberry,\" is refreshing as it is relaxing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220111,
					"content": "So I'd like to order <color=#00E1FFFF>65 cases of Mintberries</color>, to sell to sailors together with other drinks. This way, they can stay in a good mood and work efficiently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220112,
					"content": "In the past, the merchants in Mondstadt would also prepare designated equivalents according to my needs. In accordance with the rules of the Weinlesefest, I've gathered some Fairbrew Jelly in advance, and I'm giving it all to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220113,
					"content": "The funds I've set aside are a rough estimate, and please keep the change as reward for your hard work. Although this is not enough to fully express my gratitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220114,
					"content": "No worries.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#Don't worry. It's 65 cases of Mintberries, right? Leave the order to Paimon and {NICKNAME}. Handling errands is our specialty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220117,
					"content": "We'll be right back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220115,
					"content": "It won't be any trouble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "We're errand runners who help with ordering drinks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
