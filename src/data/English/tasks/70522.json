			},
			"dialogs": [
				{
					"id": 705222401,
					"content": "Well, even though we will take a small loss on this transaction, considering that the goods are for Miss Quqing, this won't be an issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
