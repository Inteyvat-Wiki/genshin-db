					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "Thank you very much for the order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220402,
					"content": "With this batch of specialty drinks, sailors can quench their thirst with a different taste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220403,
					"content": "Taste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "Sailors have different preferences. Some prefer light tea, others prefer sweet and sour juice... If you drink the same thing all the time, you'll get bored of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220405,
					"content": "So I always restock the store with drinks of different flavors, trying to meet the sailors' needs as much as possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220406,
					"content": "About the shop...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "Because the sailors did me a great service, I just recently set up shop on this side of the pier, serving drinks to the sailors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220408,
					"content": "But I'm not exactly the best businesswoman, and business has been rather slow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220409,
					"content": "See you later!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "Bye! All the best with your journey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				}
			]
		},
		{
			"id": 7052221,
