			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Oh, good gulls. I know that you are hungry, but I, too, have not eaten my fill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Forget it. I suppose that it's all good if you're happy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "Traveler? Why, what a pleasant surprise. If you're here to make a request of me, I'm afraid you'll have to wait. I'm not quite done with my fries yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "Oh, I'm not here on business.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Oh, is that so? That's good. I need to hurry up and finish them as soon as possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "Well, this is my main meal. I'll be going out with Roialte on business later, so I need to rush this meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "I'm not used to eating inside the Palais Mermonia, so I tend to go outside and find a quiet spot to get my meal squared away real quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "But today... I don't know what's making these gulls go wild, but they're coming at my fries all at once, and no matter how much they eat, it's not enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Well, there's a lot of them, and only this many fries...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "That's true. But I can't feed every single seagull in the ocean, can I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Well, these are your fries, aren't they? Don't let the gulls get at them just like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "You'll go hungry at this rate, y'know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "You seem a little down, actually.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Really? I'm not... Well, actually, I suppose I am. Nothing escapes you, I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "I just... don't know what the meaning of my work is. I busy myself every day at the Maison Gestion, but I don't really see it bearing tangible fruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "I haven't been able to help anyone, nor has anyone's life been made more convenient by my work. Roialte says that our work is very important, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "I just sit in front of a typewriter and clatter away, endlessly. What purpose does that serve? I might as well just lose another keycap. At least that'll make Estelle a bit of Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Sorry. I know I shouldn't be saying all this, but I just feel rather lost right now no matter what I do. Maybe... Maybe I need more time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Finish eating first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "You're right. But the amount of time we have now is insufficient to go get some new fries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Forget it, I'll just give the rest of them to the birds. I'll just get something to eat once Roialte and I are done with our business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "It'll take us... What, half a day? Not too long, I'd reckon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "Will you be able to hold up after not eating for that long?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Leave the gulls to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Um... Wouldn't that be too much trouble? All that over some fries...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "Just eat your meal. You shouldn't go hungry, no matter how busy you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "I'll take care of those gulls.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Let's solve your gull problem first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "You seem a little off your game.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Not all of them have gotten something to eat just yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "And why are you eating fries over here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
