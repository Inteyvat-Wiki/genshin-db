			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "Um, try eating somewhere else?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "I can't find anywhere better to eat now, anyway. If I'm too close to the Palais Mermonia, I might bump into one of my colleagues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111203,
					"content": "And then I'll get dragged into their discussions of work again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111204,
					"content": "But if I go too far away, I won't be able to get back to the office on time, and I might miss something important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111205,
					"content": "Considering these two factors, this place is my only option.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
