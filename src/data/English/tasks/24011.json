			"dialogs": [
				{
					"id": 240111101,
					"content": "Have you tried getting a dog?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "You mean... I should get a dog to chase them off?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111103,
