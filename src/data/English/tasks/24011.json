			},
			"dialogs": [
				{
					"id": 240111401,
					"content": "We will chase them all away.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "Sure, but could you focus on... only chasing them away? They just want my fries, but there's no malice in them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111403,
					"content": "Well, it is a bad thing for me, but it's not a very serious matter, so... Please, just chase them away, would you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
