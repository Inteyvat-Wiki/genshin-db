					"nextDialogs": [
						240111502
					]
				},
				{
					"id": 240111502,
					"content": "Hmm? That's not a bad idea. But can you really feed that many of them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111503,
					"content": "Well... Even if you can't, you just need to buy me enough time to eat my fries. Alright then, I leave this to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
