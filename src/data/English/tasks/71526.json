			},
			"dialogs": [
				{
					"id": 716663001,
					"content": "Onikabuto are our friends! Like cats and doggies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "Buttercup of Terror"
				},
				{
					"id": 716663002,
					"content": "Another kid? Ugh, didn't we go through this last time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Well yeah, but Grandmaster Hanakado's a kid too, and one of the other kids from last time was actually pretty good. So age is no measure of a beetle-fighter's skill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "Although... uh, Buttercup of Terror has no prior beetle-battling experience, her chosen Onikabuto has the air of a formidable warrior!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716663005,
					"content": "I dunno what you guys are talking about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "Buttercup of Terror"
				},
				{
					"id": 716663006,
					"content": "My Onikabuto was a present from Daddy. He got it from a new friend he made last time he was away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "Buttercup of Terror"
				},
				{
					"id": 716663007,
					"content": "Hoho, your father sounds like a real stand up guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Okay, let's send out Skycleaving White-Iron Lavender Melon for this one. We don't want any accusations of bullying flying around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "Hmph, you make it sound like Paimon's the weakest choice on our side...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Still, Paimon is probably the safest choice... but only because you two maniacs are a danger to yourselves and others when you're in a competitive mood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "Don't be nervous, young lady! It's only a game, so it's just for fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7166631,
