						],
						"pointId": 7027
					}
				]
			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "Phew... Paimon nearly messed that up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "I nearly died of a heart attack! That little beastie is fierce! Even I woulda had a tough time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "How'd you get so freakin' good at this without a teacher? Is everyone in Liyue a born warrior or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "So this is how Onikabuto play together? I get it now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "Buttercup of Terror"
				},
				{
					"id": 716663105,
					"content": "Do you have time to play some more? And I also wanna watch you guys play, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "Buttercup of Terror"
				},
				{
					"id": 716663106,
					"content": "Looks like Buttercup of Terror has a real knack for this... Kinda terrifying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "Hey, Bull-Chucker, if you had this kind of talent, you could probably have learned how to communicate with shelled creatures just by listening to Guoba talk to Crystal Tornado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Hah... Haha, hah... Yeah, I wish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
