					"Lessig",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "...If we start at Aaru Village and take a slight detour, we'll be able to see Caravan Ribat and Pardis Dhyai on the way to Sumeru City...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251202,
					"content": "Ah, very good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251203,
					"content": "Planning to do any souvenir shopping along the way? You can just focus on buying the gifts, I'll carry the bags!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251204,
					"content": "Don't worry about the weight, I can handle it! As long as it's nothing too gigantic, I'll fit it in the bag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251205,
					"content": "Calm down, how many people do you think we'll be buying for...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251206,
					"content": "Mom, Albedo, Master Jean, Razor... Ooh, and Diona, and Mona, and Fischl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251207,
					"content": "Hmph, what's that look for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251208,
					"content": "Nothing, nothing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251209,
					"content": "So, Klee, what are you planning to buy for everyone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251210,
					"content": "Ummm... Sunsettia-flavor candies! And big Fungi caps! And, and...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251211,
					"content": "...And loads and loads of storybooks for everyone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251212,
					"content": "But I haven't decided what to get for Mom yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251213,
					"content": "There's no rush. Let's see what they've got, and if you're still unsure, we can help you decide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251214,
					"content": "Yay! Thanks, you two!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		}
	]
