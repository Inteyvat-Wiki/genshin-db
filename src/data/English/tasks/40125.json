			"dialogs": [
				{
					"id": 401251101,
					"content": "You don't plan on taking the shell back with you, Miss Sangonomiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401251102,
					"content": "No, I think it's better if it stays here with Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251103,
					"content": "Watatsumi Island has something new to treasure now, and slowly but surely, people are seeing progress in pursuing their aspirations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251104,
					"content": "It'll be of more use here, where it can protect this bottle domain, and the dreams of all who journey through here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
