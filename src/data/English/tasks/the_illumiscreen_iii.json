				"objectNames": [
					"Brother Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "Try the Illumiscreen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590102,
					"content": "Do you have another image for me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "You bet! And since you solved both the previous ones so easily, I've swapped the lanterns for the most difficult ones available.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590104,
					"content": "The same principle applies — you combine three images to make one whole. The difficulty is in the fact that they're <color=#00E1FFFF>linked together</color> this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590105,
					"content": "Hehe, you'll see what I mean when you give it a try. This time, you're looking for a <color=#00E1FFFF>divine crane</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590106,
					"content": "Once you've got the images to align, you can go find the treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brother Qian"
				}
			]
		},
