						413590302
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590302,
					"content": "All in a day's work for you, huh? I gotta say, you're one heck of an adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590303
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590303,
					"content": "Go take a look at the screens. You'll find all the treasure clues in there.",
