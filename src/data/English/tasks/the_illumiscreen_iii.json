				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "How is the treasure hunt going?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590202,
					"content": "I've found every last chest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "Wow, you managed to decipher all three images... That's impressive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590204,
					"content": "Ahem. The Guild has prepared an extra-special gift for you on account of you being such an accomplished adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590205,
					"content": "See those chests? Go ahead and open them. The contents are all for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590206,
					"content": "But if I take all the prizes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "Yep, there'll be squat left for anyone else. That's adventuring for you! Finders keepers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "Brother Qian"
				},
				{
					"id": 413590208,
					"content": "Alright then, happy Lantern Rite. Have a good one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brother Qian"
				}
			]
		},
