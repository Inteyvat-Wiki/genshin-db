				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "We're back! It's us again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140102,
					"content": "Traveler, Paimon, welcome back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140103,
					"content": "Paimon's already used to meeting Albedo like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140104,
					"content": "I've fulfilled your request.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "Thank you so much. I knew I could count on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140107,
					"content": "Count on me to help you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "Naturally, you were crucial to my research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140109,
					"content": "Ehehe, glad to hear that~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140110,
					"content": "I'll never forget your kindness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140111,
					"content": "Now you can take the sword back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "Should be powerful enough, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140113,
					"content": "More or less... but tell me... How do you feel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140114,
					"content": "Same old.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "Good. There's no side effects, no corruption or poison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140116,
					"content": "Looks like... I've been correct all along.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140117,
					"content": "This guy, pretending to be a prophet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140118,
					"content": "How do you like the sword?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140119,
					"content": "It's a nice weapon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "Is that so? Regardless, it's reached the desired state.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140122,
					"content": "Why are you holding the sword? Albedo, what're you trying to do? Don't mess around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140123,
					"content": "I want to extract the purified life force from within it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140124,
					"content": "Can this force exist outside of the sword?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140125,
					"content": "What's impossible for some... might be just within my reach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140126,
					"content": "...All done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140127,
					"content": "Wow, this energy looks like a ball of light...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140128,
					"content": "Ah! You put it into a mysterious bottle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140129,
					"content": "This sword might not be a divine weapon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140130,
					"content": "...But it'll make a fine memento. I hope it can be of some help during your travels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140131,
					"content": "Really?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "I needed it for the sake of my research. I've already obtained the results of the experiment. This sword belongs to you, a person who knows how to use it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140134,
					"content": "Thank you for your assistance with completing this research. Well then, goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140135,
					"content": "This dragon's life force resonates with me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140136,
					"content": "Not because it's a dragon, but because I am... me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140137,
					"content": "Rhinedottir... Master... Is this your creation, the giant dragon Durin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140139,
					"content": "Was the two of us meeting really a good thing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140132,
					"content": "You don't need it anymore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "It's no good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "I've done what you wanted, as promised.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}