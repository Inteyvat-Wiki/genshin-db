			"dialogs": [
				{
					"id": 200010901,
					"content": "Thanks for getting rid of them, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010902,
					"content": "Thank goodness you came. *sigh* But I'm stuck here while this roadblock continues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010903,
					"content": "If this keeps up much longer, all this fruit is going to go bad... after I spent so long gathering it, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010904,
					"content": "Can you get rid of the roadblock for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010905,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "Wonderful. I can't thank you enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010906,
					"content": "Sorry, I'm busy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "Oh... Really? I figured if you help someone out, you see it through all the way... Anyway, you're the only hope I've got.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
