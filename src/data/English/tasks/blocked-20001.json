			},
			"dialogs": [
				{
					"id": 200011001,
					"content": "Thank you so much, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011002,
					"content": "My plan was to pick some fruit here then sell it back in the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011003,
					"content": "I hadn't counted on being held up by a roadblock... and then set upon by that group.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011004,
					"content": "Okay, I'm going back to Mondstadt. Do stop by the shop if you're ever in town!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011005,
					"content": "Take these as a token of my gratitude. See how fresh they are? That's why Beatrice is always trying to buy them from me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		}
