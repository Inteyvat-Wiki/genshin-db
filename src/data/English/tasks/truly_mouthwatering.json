					}
				]
			},
			"dialogs": [
				{
					"id": 741210801,
					"content": "Freedom! Ahhh, the sweet taste of freedom! Though not as satisfying as roast chicken is, freedom sure is sweet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210802
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210802,
					"content": "...So, what does the board that you are holding stand for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210803,
					"content": "Hm? Oh, this. It represents protest, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210804
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210804,
					"content": "Against what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210805
					]
				},
				{
					"id": 741210805,
					"content": "Hmm... How should I put this... Th—They are the ones who buried me. They did it to stop me from working hard, which is why I want to protest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210806
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210806,
					"content": "Wait, why do they want you to stop working hard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210807,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210808
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210808,
					"content": "Can you keep a secret?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210809
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210809,
					"content": "Of course! Your secrets are safe with Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210810,
					"content": "Then yours are safe with me, too. But I'm afraid I can't tell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210811
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210811,
					"content": "Hey! Are you making fun of Paimon!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210812,
					"content": "Let's talk about something else, then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210813
					]
				},
				{
					"id": 741210813,
					"content": "Okay... What's with the barrel you were wearing? Is that a form of protest as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210814,
					"content": "Huh? That I don't know... Before they buried me, they put this barrel on me — a deed born of their twisted tastes, I'll wager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210815
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210815,
					"content": "And why did you end up buried by them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210816,
					"content": "Because they are terrible, terrible people! They just grabbed me for no reason at all and buried me in the sand! They wanted me dead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210817
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210817,
					"content": "No reason at all, huh? Really?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210818
					]
				},
				{
					"id": 741210818,
					"content": "O—Of course! Didn't you see? I was literally buried in the sand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210819
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210819,
					"content": "If they didn't want me dead, why else would they do it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210820
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210820,
					"content": "#Hmmm... That makes sense... {NICKNAME}, what do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
