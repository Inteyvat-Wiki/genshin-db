			"dialogs": [
				{
					"id": 741210601,
					"content": "Hmph...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210602,
					"content": "*sigh* I have done noth— I... This is the latest beauty trend...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210603,
					"content": "Waah! When did you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210604,
					"content": "We are taking a walk. Taking walks... is a form of exercise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210605,
					"content": "Exercise involves movement. Movement is what brought us here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210606,
					"content": "Did you do this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "So what if...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210608,
					"content": "#Oh, Hunter, I remember now. Take a good look at {M#him}{F#her}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210610,
					"content": "That's the person he told us not to mess with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210611,
					"content": "Right, right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210612,
					"content": "What are you whispering about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210613,
					"content": "Nothing. We are just taking a walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210614,
					"content": "That's right. We are just taking a walk. If there's nothing else, we'll...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210615,
					"content": "Keep walking and walk to other places.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210616,
					"content": "Wait, don't you have to do anything scary to me anymore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210617,
					"content": "The lesson has been learned, if you know what I mean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210618,
					"content": "What lesson?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "Nothing. I mean, roast chicken is dangerous. It invites trouble. See it as a valuable lesson. Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210620,
					"content": "But, roast chicken is... Debord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210621,
					"content": "Forget the roast chicken! We should continue our walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210622,
					"content": "\"We'll ask Sonny to treat us to roast chicken next time.\"\\nSo says Turner as he walks away with Hunter.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "Thank you! Thank you so much! I knew you'd understand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210624,
					"content": "#Seems it is exactly like what {NICKNAME} said... Let's help Henri out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210625,
					"content": "But digging you out is a really exhausting job! So Paimon will take the roast chicken as payment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210626,
					"content": "Huh? Ugh... Alright, fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210627,
					"content": "It takes you a while to help Henri out of the sands and take the barrel off him.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "You start enjoying the delicious roast chicken with Paimon.\\nHenri seems as if he is about to drool, but he holds back the desire to have a share to keep his promise and maintain his dignity.\\nHowever, seeing Henri trying really hard to look unaffected, Paimon offers to share the roast chicken with Henri.\\nThe chicken is crispy on the outside and gives out an irresistible oily aroma. Yum yum!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
