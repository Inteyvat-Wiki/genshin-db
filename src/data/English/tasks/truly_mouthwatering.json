			"dialogs": [
				{
					"id": 741210301,
					"content": "Hello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210303
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210304
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210304,
					"content": "Hey! Don't leave Paimon in this awkward silence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210305,
					"content": "...Hello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210306
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210306,
					"content": "What a beautiful day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210307
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210307,
					"content": "About the person over there...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "What person?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210309,
					"content": "I don't know the person you're talking about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210310,
					"content": "We're just...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210311,
					"content": "Taking a walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210312,
					"content": "Yes, that's right. We are just taking a walk. A walk, taken by us, two totally ordinary people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210313,
					"content": "What a beautiful day and what a wonderful thing walking is! Don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210314,
					"content": "Taking a walk is totally normal. I'm sure you understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210315,
					"content": "Uh... What are you guys even talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210316,
					"content": "Did you hear someone calling for help? A man is buried in the ground over there and almost got eaten by crabs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210317,
					"content": "What? Something like that happened where we take walks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210318,
					"content": "On such a beautiful day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210319,
					"content": "If he gets eaten by crabs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210320,
					"content": "That'll be really funny. Uh, I mean, a real pity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210321,
					"content": "Shame, we won't let this happen. I mean, we can't let this happen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210322,
					"content": "If we run into something like this during our walk, we will not be bystanders. I mean, if.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210323,
					"content": "What are you guys doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "Taking a walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210325,
					"content": "Like we said, taking a walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210326,
					"content": "You really didn't notice anything weird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210327,
					"content": "No, none at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210328,
					"content": "Yeah, none at all. Except that the two of you are interrupting our walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210329,
					"content": "Taking walks is... very personal. We do not like being interrupted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210330,
					"content": "We suggest that you find a good place for walks. The Fountain of Lucine, for instance, is a pretty good place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210331,
					"content": "This is where we take walks. I mean, where we feel the nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 741210332,
					"content": "That's why we don't want to be interrupted. Goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Turner"
				}
			]
		},
