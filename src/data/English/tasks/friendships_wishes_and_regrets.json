			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Congzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120801,
					"content": "My thanks to both of you, this looks like great stuff. Please wait a moment, this is the final step.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120802
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120802,
					"content": "Okay, there we go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120803,
					"content": "I wrote all five of our names inside the lantern. You know, during the annual Lantern Rite, we all release a lantern like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120804,
					"content": "No matter what the days may bring, whichever roads we choose to take... While this rite remains observed, each of us remains the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120805,
					"content": "As for the matter of Big G... The three of us have discussed amongst ourselves and agreed we won't press you on it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120806,
					"content": "But if you get the chance, please let him know... we're doing well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120807,
					"content": "And that the things we once spoke of, they've all come to pass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120808,
						111120809
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120808,
					"content": "You can count on us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				},
				{
					"id": 111120810,
					"content": "Thank you, we'll pass it on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120811,
					"content": "Big G is lucky to have friends like you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120809,
					"content": "And I won't press you on \"the things you once spoke of.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				}
			]
		},
