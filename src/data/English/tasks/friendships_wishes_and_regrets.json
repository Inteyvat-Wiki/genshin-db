			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "Uhh... Hi... Eh-he... Do you remember us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Ugh, you... Sorry, I won't be needing the funeral parlor's services anytime soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120203,
					"content": "Meng told us his story.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Yes, we grew up together. We still keep in touch even now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120206,
					"content": "I don't know why he started working for Wangsheng Funeral Parlor. To be honest, I find their director to be quite peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120207,
					"content": "But he must've had his reasons. He's on his own now after all, and he still can't get over what happened to Big G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120208,
					"content": "Did he tell you about it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120209,
					"content": "Yeah, he did. Um, if you could pick one thing to give to Big G as a keepsake, what would you choose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120210,
					"content": "...Just, y'know, theoretically speaking. We're just being hypothetical here, definitely not gonna actually go commemorate him or anything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120211,
					"content": "(That's a little bit on the nose.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120214,
					"content": "I'd cook something for him. He could eat spicy food like no other. His favorite meal was extra-spicy Jueyun Chili Chicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120215,
					"content": "I can make it for you if you bring me some Jueyun Chilis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120216,
					"content": "I'm sure he'd appreciate the flavor of his childhood years. I still use that old recipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120217,
					"content": "Deal! Just give us a minute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120212,
					"content": "(Typical Paimon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "Meng said that he's an old friend of yours.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
		{
			"id": 1111203,
