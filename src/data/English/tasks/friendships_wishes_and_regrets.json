				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111122301,
					"content": "Y'know, I just realized... mine's the only item that's been outright purchased. Yours are both handmade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111122302,
					"content": "But yours is worth a lot more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111122303,
					"content": "Worth in Mora is not what's important here. These things all played a big part in our childhood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111122304,
					"content": "They show that we will never forget our promise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congzi"
				}
			]
		},
