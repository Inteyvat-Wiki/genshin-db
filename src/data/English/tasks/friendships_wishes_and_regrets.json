			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "After all that's happened, Paimon's not even sure what's going on anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "I didn't expect to stumble upon Big G just like that either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "Actually, I'm not surprised in the slightest. Remember what I said? There's only so many evil spirits in this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120105,
					"content": "It was a twist of fate that made him leave Wuwang Hill in the first place. Now, for some reason, he can't go back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120106,
					"content": "This explanation sounds a bit far-fetched to Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "Actually... she pretty much summed it up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120108,
					"content": "Ehh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Hehe, don't ever question my professional instincts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120110,
					"content": "I just wanted to check up on my friends. That's why I came to Liyue Harbor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120111,
					"content": "I promise I wasn't up to any mischief! I never wanted to scare anyone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120112,
					"content": "A few days ago, some people came to Wuwang Hill on a dare. I heard them saying they'd come from Liyue Harbor, so I followed one of them back and ended up here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120113,
					"content": "Ah, it must've been poor Luocheng that you followed. Maybe he didn't notice you, but he could still feel your presence. Now we know what caused his nightmares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120114,
					"content": "I—I was discovered?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120115,
					"content": "Well, I assume so, otherwise he wouldn't have been scared half to death.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120116,
					"content": "Why didn't you come looking for Meng sooner?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "Yeah, Hu Tao and Meng were searching for you all over the place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Oh, that's because I couldn't find them. It's my first time in Liyue Harbor and I got lost in the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120119,
					"content": "Now that you mention it, Big G always had a poor sense of direction. When we were kids, he'd never go down the hill by himself. We always had to lead him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120120,
					"content": "So all of this was just because you got lost!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "Why didn't you just fly? Like any other ghost or spirit? Don't you think it's much easier to find your way from up above?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "I... can't.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120123,
					"content": "It's too high for me, I'd get scared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120124,
					"content": "That's right, yes! He used to be so afraid of heights that he wouldn't even so much as look down the hill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120125,
					"content": "Hahaha, you haven't changed a bit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "I knew I wasn't supposed to show myself to the living, and with so many people walking around Liyue Harbor, my only choice was to hide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120129,
					"content": "I wouldn't have found you if it weren't for the Ley Line Monolith's call.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120130,
					"content": "I'm so relieved that you haven't become an evil spirit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120131,
					"content": "Like I said, don't ever doubt my professional instincts. Now, all we have to do is escort this lost child back to Wuwang Hill, and we should be done and dust-to-dusted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120132,
					"content": "But he just said that he wanted to visit his friends. Apart from me, there's also Little Wu, Mumu, and Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120133,
					"content": "Well... if that's the case, we can't let him down. We'll ask them all to help us prepare a farewell ceremony for Big G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120134,
					"content": "Meng and I will escort Big G back to Wuwang Hill. You meet with those three and ask them for keepsakes to symbolize each one of them during the ritual, then come and find us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120135,
					"content": "They're all friends, can't we just go there all together? Or maybe we can take Big G to them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "Um... That's not a good idea. I don't want to scare them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111120137,
					"content": "Hmm, I wouldn't want ordinary folks to become superstitious... The less they know, the better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120138,
					"content": "So be careful what you say when you collect the keepsakes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120127,
					"content": "Good thing they didn't call you \"Tall G...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "So Big G's not an evil spirit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
