			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Congzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120501,
					"content": "Eh? You're all here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120502,
					"content": "Reminiscing about old times, thinking back to past events... We've been at it for years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111120503,
					"content": "Our hometown was completely destroyed in a disaster, so we've got nowhere to go back to. Now, home is wherever friends are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120504,
					"content": "They've just been telling me you're looking for keepsakes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120505,
					"content": "I make artisan Xiao Lanterns down by Liyue Harbor. I guess they represent me better than anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120506,
					"content": "A few days ago, I bought some quality Plaustrite Shards. They're currently all in the warehouse at the dock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120507,
					"content": "I've already spoken to the manager. Could I ask you to retrieve them for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120508,
					"content": "Seems like you already know what's going on! Be back in a jiffy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111208,
			"completionStepIds": [
				1111208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111208",
							"2"
