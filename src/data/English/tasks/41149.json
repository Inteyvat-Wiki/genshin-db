			"dialogs": [
				{
					"id": 411490301,
					"content": "I heard that someone placed a custom order...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411490302
					]
				},
				{
					"id": 411490302,
					"content": "That's right. Great timing, Traveler! Wallit ordered a stack of Tea Break Pancakes from us earlier. Don't worry, he's already paid beforehand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490303,
					"content": "He wants us to bring it to a place south of Brightcrown Canyon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490304,
					"content": "But we've been getting more and more take-out orders lately for some reason, and we can barely keep up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490305
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490305,
					"content": "If you don't mind, could you help us with this delivery?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
