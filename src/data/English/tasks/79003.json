			"dialogs": [
				{
					"id": 790030401,
					"content": "Hey, this must be the other half of the ship. Let's see... Oh, there's some more words carved here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030402,
					"content": "\"Though the front half was lost, we've somehow managed to stay afloat on the remaining back half for some time now... Now that's what I call a ship, haha! Unfortunately, most of the ship's load is probably sitting at the bottom of the sea by now...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030403,
					"content": "\"...It seems like... we floated here on the southeast currents? Well, that doesn't matter. The problem that we need to solve right now is how to leave this place...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030405,
					"content": "The words from each half of the ship are connected.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030406
					]
				},
				{
					"id": 790030406,
					"content": "If we place them together, it reads...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030407,
					"content": "\"We have no idea where we are, but it looks like we've left Inazuma far behind. Ha, I wish I could see the looks on the faces of those Shogunate lackeys!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030408,
					"content": "\"However, there doesn't appear to be a speck of dry land in sight. I'm afraid the boat won't hold up unless we find a place to make anchor soon... We need to think of a way soon.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030409,
					"content": "\"Though the front half was lost, we've somehow managed to stay afloat on the remaining back half for some time now... Now that's what I call a ship, haha! Unfortunately, most of the ship's load is probably sitting at the bottom of the sea by now...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030410,
					"content": "\"...It seems like... we floated here on the southeast currents? Well, that doesn't matter. The problem that we need to solve right now is how to leave this place...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030411,
					"content": "Paimon gets it now. These people were transporting something on the boat when they encountered some trouble at sea and ended up drifting here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030412,
						790030414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030412,
					"content": "Seems like quite the disaster.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030413
					]
				},
				{
					"id": 790030413,
					"content": "No kidding, the boat even broke in half...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030416,
					"content": "Hmm, but the real question is... what were they carrying on the ship?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030417,
					"content": "Why don't we look around some more? *gasp* Maybe we'll find treasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030418,
						790030420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030418,
					"content": "Anything that's been in the water that long is probably ruined by now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030419
					]
				},
				{
					"id": 790030419,
					"content": "Hey! Don't dampen our treasure hunting spirit! I'm sure any treasure we find will be nice and shiny.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030422,
					"content": "Anyway, let's get moving. We've got a lot of sea to cover!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030420,
					"content": "Or more monsters...",
