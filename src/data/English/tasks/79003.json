			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790030101,
					"content": "Oh, this seems to be a ship... Uh, well, more like half a ship...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030102,
					"content": "But what would half a ship be doing in a place like this? Oh, look! There are some words carved on it. Let's see what they say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030103,
					"content": "\"Though the front half was lost, we've somehow managed to stay afloat on the remaining back half for some time now... Now that's what I call a ship, haha! Unfortunately, most of the ship's load is probably sitting at the bottom of the sea by now...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030104,
					"content": "\"...It seems like... we floated here on the southeast currents? Well, that doesn't matter. The problem that we need to solve right now is how to leave this place...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030105,
					"content": "Looks to Paimon like they were a group of people who were stranded at sea. It says the \"front half was lost\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030106,
					"content": "Oh, so that must mean this is the \"remaining back half\"! Whew, what could have possibly caused their ship to break into two like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030107,
					"content": "Hmm, it also said that they ended up here by floating on the \"southeast currents.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030108,
					"content": "If we follow the way that they came and look for the front half of the ship, maybe we'll find something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030109,
					"content": "Let's bring the carved wood plank we just read with us, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030110
					]
				},
				{
					"id": 790030110,
					"content": "Oh, Paimon gets it. You think these carved words might be some sort of clue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030111,
					"content": "Makes sense to Paimon! Most of the ship's wood has already started to rot, the carved plank will probably break right off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790030112,
					"content": "Alright, let's snap off that plank and go search for the other half of the ship!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
