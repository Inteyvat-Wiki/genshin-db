					"nextDialogs": [
						3550705
					]
				},
				{
					"id": 3550705,
					"content": "Just what was that? Paimon thought we were gonna get eaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550706,
					"content": "It definitely has something to do with that weirdo who was talking to the dragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550707,
						3550709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550707,
					"content": "I can't believe dragons exist in this world...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550708
					]
				},
				{
					"id": 3550708,
					"content": "Yeah, Paimon gets why you're worried...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550711,
					"content": "Oh? What's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550712,
					"content": "There's some kind of shiny red thingy on the big rock over there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550713,
					"content": "Let's go take a closer look.",
