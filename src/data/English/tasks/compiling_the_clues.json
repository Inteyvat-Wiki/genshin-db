				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "Okay, everyone's given us a lot of useful information. Let's go through it and try to organize everything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530802,
					"content": "Some things we heard were pretty straightforward, but others were just ridiculous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530803,
					"content": "We should be able to figure out more about its identity and whereabouts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "Yeah, let me think and see what I can make of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530805,
					"content": "(Okay, calm down Layla. I know the info's all over the place, but you can definitely do it.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530806,
					"content": "(First, let's try to figure out the Seelie's identity based on the clues we currently have.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530807,
					"content": "(Then, we'll analyze where it's been sighted and its motives... Finally, we'll piece everything together...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530808,
					"content": "(From there, we should be able to predict its movement. Alright, let's give it a try.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
