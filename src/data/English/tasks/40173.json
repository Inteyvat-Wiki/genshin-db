			},
			"dialogs": [
				{
					"id": 401730201,
					"content": "Okay, looking good... Seems like this guy got off lightly. Just make sure he eats when you get back — he must be starving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730202
					],
					"speakerTitle": "Matla"
				},
				{
					"id": 401730202,
					"content": "That's a relief. I've heard of cases where people's bodies started necrotizing after they spent too long meditating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730203,
					"content": "What a horrifying thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730204,
					"content": "Mm. Anyway, Leyla, even though we didn't know each other before all this, I'm still really glad that you're okay now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730205,
					"content": "Well, maybe you didn't know me, but... I've heard all about you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730206
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730206,
					"content": "#The same goes for High Priestess Citlali, {NICKNAME}, and Paimon. I've heard all the stories...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730207
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730207,
					"content": "Huh? Even us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730208,
					"content": "This might sound corny, but you're exactly the kind of people I've always dreamed of becoming... But it's clear to me now, that was just wishful thinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730209
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730209,
					"content": "Honestly, why'd I have to be born a spirit-duffer? Hehe, nah, it's alright really. I'm used to being useless by now. Thank you all for saving me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730210
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730210,
					"content": "Ororon, I think you're right — it's just a fact of life. I promise I won't take another risk like this in the future. I've brought you more than enough trouble already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730211
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730211,
					"content": "Aw, Leyla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730212,
					"content": "Haha, it's okay! There's no need to comfort me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730213
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730213,
					"content": "Hey, you little rascal. What are you talking about? Look at me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730214,
					"content": "Huh? What's wrong, High Priestess Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730215
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730215,
					"content": "I said look at me. Take a good hard look. Sense anything strange?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730216,
					"content": "Granny, what are YOU talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730217
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730217,
					"content": "#What do you think, {NICKNAME}? Another case of \"happy to help\" written on someone's face?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730218,
					"content": "...Hold on, I think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730219
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730219,
					"content": "Either my mind's playing tricks on me, or... her entire body is an illusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730220
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730220,
					"content": "No... It must just be my imagination. I wouldn't be able to see through something like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730221
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730221,
					"content": "Wait, I know this trick... It's the same one I used a while back. Granny snuck away from right under our noses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730222
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730222,
					"content": "You see? You can perceive some spiritual abnormalities now. Congratulations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730223
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730223,
					"content": "R—Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730224
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730224,
					"content": "But where are you going, Granny?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730225
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730225,
					"content": "Where do you think? I'm going fishing, you dummy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730226
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730226,
					"content": "Someone triggered the trap I set in the cave. Looks like our friend Kokuchuu took the bait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730227,
					"content": "What?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730228,
					"content": "Sorry, can't talk now. You'll find me in the cave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
			"id": 4017303,
			"completionStepIds": [
				4017304
