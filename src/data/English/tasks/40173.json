			"dialogs": [
				{
					"id": 401730101,
					"content": "Greetings again, everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730102,
					"content": "Citlali, you're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730103,
					"content": "I got the ceremonial sword from the chief. It has a certain power that's needed in situations like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730104,
					"content": "...You haven't forgotten what we're doing today, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730105
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730105,
					"content": "Of course not, we're gonna wake Leyla up! ...And then ask him just what the heck he was playing at.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730106,
					"content": "And I've prepared the rest of the tools for the ceremony, per Granny's instructions. We've dotted all our i's and crossed all our t's, so today should go off without a hitch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730107
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730107,
					"content": "Good work, kiddo. Then without further ado, let's get started.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730108,
					"content": "Citlali summons the ceremonial sword \"Calamity of Eshu.\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401730109
					]
				},
				{
					"id": 401730109,
					"content": "I give offerings from the mystic smoke: The gift of stars on a moonless night, a wreath of dreams in the swirling wind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730110,
					"content": "Glory be to the Ruler of Death. Fade. Fade. Fade. Thrice uttered, and thrice repeated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730111,
					"content": "Whoa! Is this one of her magic spells? This whole place suddenly got cold! What's happening!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730112,
					"content": "Keep your voice down. We mustn't disturb her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730113,
					"content": "We, the children of the priest-king, swear to abide by the ancient pact, and tear through the veil of the Night Realm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730114,
					"content": "I am Citlali, hear my command. I am the shepherd of doomsday, I am Ah K'ulbatil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730115,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730116
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730116,
					"content": "Look! Leyla's spirit is back. It's coming towards his body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730117,
					"content": "I shall pierce the cloak of night with flintstone, and banish all souls that do not belong to the land of the dead.\\n",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730118,
					"content": "Leyla! Obey my command, and return to the land where the sun shines. Return to your own path!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730119,
					"content": "D—Did it work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730120,
					"content": "Huh... Huh? Where am I? And... who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730121
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730121,
					"content": "Whoa! ...G—Granny Itztli! I mean...! High Priestess Citlali! Please, have mercy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730122
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730122,
					"content": "Guilty conscience, huh? So you know full well what you've done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730123,
					"content": "Do you have any idea how close you were to never making it back? Or maybe you thought life would be more fun as an inanimate object?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730124
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730124,
					"content": "I—I'm sorry! I messed up... and I'll face the consequences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730125
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730125,
					"content": "Oh? You sure about that? Then say goodbye to your parents. Tell them this:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730126
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730126,
					"content": "\"Goodbye, Mom and Dad. I've realized I enjoy life as an empty shell so much that I've decided to get Granny Itztli to turn me into a stone statue, so I can stand guard over her house for the next hundred years.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730127
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730127,
					"content": "No, please! Please don't, I'm begging you! I'll never do this again, I promise! Thank you, High Priestess Citlali, thank you for rescuing me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730128
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730128,
					"content": "Hehe, don't thank me — thank my grandson. If he hadn't sensed something was amiss, I wouldn't have bothered getting involved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730129
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730129,
					"content": "You're more than welcome, Leyla. And don't mind Granny's — she's all bark and no bite. We're just glad that you're okay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730130,
					"content": "Besides, someone tricked you into doing this, didn't they? That Kokuchuu guy. He's the real culprit here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730131
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730131,
					"content": "No... Mr. Kokuchuu had nothing to do with it. It was all my doing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730132
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730132,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730133,
					"content": "Well, I mean, he suggested the method of using a powerful spirit relic as a medium. But it was my decision to go through with it. I wasn't coerced or anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730134
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730134,
					"content": "I'm sorry. I'm the one to blame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730135
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730135,
					"content": "Hah, the brainwashing is strong with this one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730136
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730136,
					"content": "Um... So, did Kokuchuu provide the relic?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730137,
					"content": "He did. He said it was a treasure related to the Mare Jivari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730138
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730138,
					"content": "Right, so that proves it — he was using you! He coaxed you into doing the clairvoyance for him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730139,
					"content": "But I'm a spirit-duffer who can't cast a single spell... What use would I be to him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730140
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730140,
					"content": "Guys like me couldn't sense a spirit even if we spent the rest of our lives sitting and meditating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730141
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730141,
					"content": "But Mr. Kokuchuu said that if I brute-force the spell and immerse myself in a spiritually rich substance, I might be able to catch a glimpse of one. Seemed like my only option...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730142
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730142,
					"content": "Still, brute-forcing a spell when you're a spirit-duffer is like... forcing yourself to run a marathon without any legs! If it wasn't for Citlali, you'd have been lost forever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730143,
					"content": "I know, I'm sorry... It's just... everyone in this tribe is so amazingly talented, and then there's me... I just didn't wanna be the odd one out anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730144
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730144,
					"content": "I totally understand how you feel, Leyla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730145
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730145,
					"content": "Some seeds effortlessly grow into beautiful cabbages, while others struggle with all their might and never even sprout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730146
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730146,
					"content": "Who knows why this is the way things are... Maybe that's just life? Life is full of things we can't change.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730147
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730147,
					"content": "I know saying this doesn't change anything either, but I hope it makes you feel a little better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730148
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730148,
					"content": "Let's pause this discussion for now. We need to get you to Matla's for a checkup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
