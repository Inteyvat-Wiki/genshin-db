			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220420401,
					"content": "You have returned. It is strange. Those children suddenly all came back, and they looked mighty frightened, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420402,
					"content": "Did they meet some hairy churls outside, the ones with the sticks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420403,
					"content": "Still, they did come back... Wait, what is the matter with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420404,
					"content": "Uh, actually, I...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "...You... unfathomable human! What possessed you to do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420406,
					"content": "You could simply have played with these children the normal way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420407,
					"content": "Meow! No wonder they were so frightened... You must go and comfort them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420408,
					"content": "Really, now. I suppose it was a bit much to ask for all humans to be like Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		}
	]
