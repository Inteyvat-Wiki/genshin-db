					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220420301,
					"content": "You have returned. Have you fed those rascals?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420302,
					"content": "Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Good, good. You have my thanks. Without your aid, those children would have played and played... and then they would have gone hungry outside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420304,
					"content": "*sigh* What a bunch of disobedient children. How will they be fit to receive the people coming to the shrine this way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 2204204,
			"completionStepIds": [
				2204204
