				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220420101,
					"content": "What an unteachable lot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "Ah, it's you. Those little ones have run off yet again. They really are growing most rebellious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420104,
					"content": "Do you need any help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "Now that you have hung those metal balls around the shrine, I believe that they will be able to find their way back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420107,
					"content": "It is not a bad thing, perhaps, for them to go a little wild outside, lest they make a fool of themselves in front of the humans and disgrace the shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420108,
					"content": "But if they should go overboard and go hungry from when the sun hangs high to when the moon comes up... That would not be good either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420109,
					"content": "Well then, please bring these fish to those little rascals so that they may eat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420110,
					"content": "Alright then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "Let's pass our map to Neko to mark out, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220420112,
					"content": "Mmm, it seems that you do not lack comprehension...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420115,
					"content": "Alright then. Go now, and quickly. I have matters of the shrine to attend to yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420113,
					"content": "Here's our map...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "Mmm, it seems that you do not lack comprehension...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420105,
					"content": "Need us to go look for them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
		},
		{
