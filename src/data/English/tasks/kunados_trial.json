			"dialogs": [
				{
					"id": 722700101,
					"content": "I am Daimon of the Jibashiri. Hero of Sangonomiya, I acknowledge that you are worthy to take on this challenge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "Valor is the power to defeat all your foes, regardless of the method used. Simply defeat all the opponents here and release the Flames of the High Gate, and you shall be allowed passage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "It should be said that all these foes are illusions, born from the Sunfire Phantasms and the great enemies you know of in your heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "Even so, you will be vanquished if you are not careful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "I will await your completion of the challenge at the Tower of the Three Realms above.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
