			"dialogs": [
				{
					"id": 726930701,
					"content": "This line says that though one may leave Inazuma, the things one has seen here will remain in one's heart forever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
