			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "Ah, you're here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930102,
					"content": "Lenne wrote of our regret that we did not meet sooner yesterday, and so today I wish to gift him a verse as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930103,
					"content": "Haha, it is my honor to accept such a gift!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930104,
					"content": "Although I'm an old man now, after meeting friends from Mondstadt in recent days, I have grown quite interested in the place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930105,
					"content": "For this poem, I wrote in imitation of Mondstadt's bards, and the verse will also mention some of that land's scenery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930106,
					"content": "Unfortunately, I've never been to Mondstadt... But could you help me take a few pictures of <color=#00E1FFFF>Mondstadt's regional specialties</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930107,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "Haha, in that case, I'll be counting on you. Just like in the previous days, 4 pictures will do the trick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269304",
							"2"
						],
						"stepId": 7269304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "Well then, how are the pictures coming along?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930202,
					"content": "Have them right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "Thank you, thank you. Ah, with these, I can finally pen a satisfactory poem down. Now then, let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930204,
					"content": "Here's my draft, written according to the pictures you brought back. Why don't you choose the stanzas we should use?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
