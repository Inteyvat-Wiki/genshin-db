				"points": []
			},
			"dialogs": [
				{
					"id": 726930901,
					"content": "Well then, how are the pictures coming along?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930902
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930902,
					"content": "I haven't finished taking them yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930903
					]
				},
				{
					"id": 726930903,
					"content": "I'm sorry for troubling you. What we need today are pictures of <color=#00E1FFFF>Mondstadt's regional specialties</color>. Just as before, <color=#00E1FFFF>4 pictures</color> will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		}
