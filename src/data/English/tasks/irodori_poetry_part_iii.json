			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930301,
					"content": "Indeed, using \"tracing the wind's footsteps\" as a metaphor for setting off on a journey is a very Mondstadt-like expression.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
