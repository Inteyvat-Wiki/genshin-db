					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930401,
					"content": "Connecting a flower to a lover is common to all nations, and this sentence compares remembering the sights of Inazuma to recalling one's first love.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269305,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
