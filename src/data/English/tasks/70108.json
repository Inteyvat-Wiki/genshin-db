				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "Hello, how may I help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "I have a letter for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "A letter? ...Oh, it's from her. I'll wager she's asking about the next exploration team again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "*sigh* I don't know what I can do. It's rare to find a team that's willing to take on the mountain these days — it's just too dangerous up there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "I'll write her a letter shortly to explain the situation. Thank you for making the trip to deliver this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "Speaking of letters, she sent another not long ago asking me to prepare a reward for you. Here, please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "One last thing... I can see that you are a hardy type, but nevertheless — I urge you to be careful in the mountains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "Ah, Dragonspine... If ever the chance arose to lead a team of explorers there in person, I would surely take it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
