				"points": []
			},
			"dialogs": [
				{
					"id": 701080301,
					"content": "Did you put the beacon in place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Yep.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Wonderful! Thank you, now I can finally get a reliable measurement of the height of the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "Oh, and regarding compensation — I asked Cyrus to put something together. Ask him for it next time you're in the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "And since you'll see him before I do, could you also give him this letter for me? He promised to keep me in the loop about a second exploration team headed for the mountains, but I still haven't heard back about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Once the rest of my beacons are fixed, I'll have to head back up and set them all up. There's a lot of things that still need surveying on that mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
