				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "Oh, I've heard there's some great-tasting dishes from Mondstadt — Sweet Madame, Mondstadt Grilled Fish, Fisherman's Toast, Calla Lily Seafood Soup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000202,
					"content": "Well, just get me the one that'll best fill my stomach. Thanks for your help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000203,
					"content": "If I eat that, at least my stomach won't be crying out all day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
