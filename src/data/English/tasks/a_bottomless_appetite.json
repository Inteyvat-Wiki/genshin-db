				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "Hello, do you *RUMBLE*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "Ugh, my stomach is making an awful racket again. I was saying, do you need any *RUMBLE*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "Uh, you were saying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "*sigh* My stomach acts up like this every time I'm hungry. Rumble this and rumble that, and it's really loud, too. I can't even hear the sound of my own voice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "Although *RUMBLE* went to Bubu Pharmacy to get myself checked, but the doctor said that I was not sick, just hungry — so there's no cure for my *GROWL*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "The doctor said that I just needed to eat full meals, but I... I've always had a bigger *GRUMBLE* than most. If I were to eat my fill every time, I'd burn a hole right through my wallet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi tells me that if my main meals don't fill me up yet, I should buy a little something to fill in the gaps in between so it doesn't affect my work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "\"Fill in the gaps,\" he says, but I've got a long list of dishes I'd like to eat, and I'm not sure which is best for filling my stomach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "Traveler, you're experienced in the outdoor life. Surely you know what foods fill your stomach best?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "Could you help me pick the most filling and delicious dish from my list?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "What would you like to eat this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Oh, there's plenty... Let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
		{
			"id": 2220002,
			"completionStepIds": [
				2220002
			],
