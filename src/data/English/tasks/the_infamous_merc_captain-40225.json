					}
				]
			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "Wait, is this...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250102,
					"content": "The Alcor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "Actually, this is the second ship in our fleet. The Alcor's back home, patrolling Guyun Stone Forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250104,
					"content": "Beidou! The infamous merc captain who sails the high seas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250105,
					"content": "Uh, yeah, haha. We've met, remember? What's with all the pomp and circumstance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250106,
					"content": "It's a long story...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250107,
					"content": "Well, no sense standin' around. Take a seat. Tell me all about it. I'll have my men roll out the welcome mat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250108,
					"content": "Ah, I see. So, you know the head honcho of the Curatorium, huh... Your network of connections is somethin' else, that's for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250109,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250110,
					"content": "About the registration...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "Right! We need a record of who's participating in the expo and what you're planning to trade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250112,
					"content": "Well, mark down me and a few crew members as participants — the rest will stay on the ship. As for what we're trading... Take a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250113,
					"content": "What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250114,
					"content": "A while ago, Ningguang revamped the Guizhong Ballista. The beauty you see here is one of her new and improved models.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250115,
					"content": "It has insane firepower and comes complete with remote guidance for accurate striking even at long distances. I just know people are gonna be fighting to get their hands on it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250116,
					"content": "Are you sure you're allowed to sell stuff like this!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250117,
					"content": "Haha, don't worry. Compared to the model the Millelith's using, this one might as well be an antique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250118,
					"content": "...Nefer wasn't kidding when she said \"no restrictions,\" huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250119,
					"content": "But, who's gonna buy something like this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Oh, I'm sure someone will bite. Buyers from all over Teyvat will be in attendance, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250121,
					"content": "...Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250122,
					"content": "Ah, sorry. I was so busy with the cargo, I forgot to mention that Yelan was aboard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250123,
					"content": "No worries. You here for the expo too, Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250124,
					"content": "No, I'm just here for work. Captain Beidou was kind enough to lend me a ride. So, no need to register me with the expo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250125,
					"content": "#Anyway, it's been a while, {NICKNAME}. If you get the chance, be sure to pass along my regards to the head of the Curatorium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250126,
					"content": "What kind of work?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "The... sensitive kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250128,
					"content": "Sounds like our cue to stop asking questions, doesn't it...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250129,
					"content": "One hundred percent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "Well, I'll be off, then. Once I'm done with this, drinks are on me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250131,
					"content": "About time! I've been itching to see Nod-Krai from the bottom of a bottle, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250132,
					"content": "Alright, that's it for registration. Follow us, and we'll take you to the venue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
