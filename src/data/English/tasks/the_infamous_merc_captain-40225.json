			"dialogs": [
				{
					"id": 402250201,
					"content": "Beidou directs her crew to unload the cargo and follows you to the venue.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "So, this is the place, huh? Not a bad spot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "When you've got some time, come help me test the remote guidance on this thing. It's a real thrill — you'll love it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
