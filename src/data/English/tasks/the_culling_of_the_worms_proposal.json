			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vinayak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110301,
					"content": "Getting in from this angle, and using the terrain for cover... As long as the angle of sunlight isn't higher than... And my speed is no lower than... Hmm, that still isn't it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110302
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110302,
					"content": "What are you trying to figure out?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110303
					]
				},
				{
					"id": 735110303,
					"content": "A viable route to recover the components without having to face the monsters... Thanks to the Wenut, all my precious components got swept up by those monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110304
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110304,
					"content": "Whoa! Who are you? When did you show up!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110305
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110305,
					"content": "I've been listening to you talk to yourself for a while now...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110306
					]
				},
				{
					"id": 735110306,
					"content": "Relax. We're not bad guys. Your friend sent us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110307,
					"content": "Friend? Could it be Shriya? No, she clearly said she wouldn't care if I was taken by the monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110308
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110308,
					"content": "Ah, I see. She sent you to get the components, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110309
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110309,
					"content": "It doesn't matter if I'm taken by the monsters, but it will definitely matter if the components aren't recovered... Yeah, that sounds like something she would say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110310
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110310,
					"content": "...You could put it that way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110311
					]
				},
				{
					"id": 735110311,
					"content": "Still, thanks all the same. I'm racking my brain trying to figure this out. I was this close to rushing out and just taking it one step at a time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110312
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110312,
					"content": "...One wrong step, and I'll get caught by the monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110313
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110313,
					"content": "Eh... If I wasn't here, and with Shriya being such a klutz... who else would be going to take care of these machines!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110314
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110314,
					"content": "No wonder Shriya was so worried... This guy thinks about nothing but his mechanical components...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110315,
					"content": "#{NICKNAME}, let's go and get the components before he gets himself in trouble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
