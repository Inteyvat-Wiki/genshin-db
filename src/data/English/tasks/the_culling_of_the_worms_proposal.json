	"talks": [
		{
			"id": 7351101,
			"completionStepIds": [
				7351101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351101",
							"2"
						],
						"stepId": 7351101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shriya",
					"Fodil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110101,
					"content": "That fool... running headfirst into the desert like that! Do something, Fodil, please! Give him a hand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110102
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110102,
					"content": "Apologies. The garrison in the village is limited, and since we're tied up with keeping them from causing any trouble, we can't afford to spare any strength for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110103
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110103,
					"content": "But that fool has been bending over backwards to deal with them! At least, in the name of mutual interest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110104
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110104,
					"content": "Well, it's not that we don't want to help. But the guards are now spread thinly across the desert on the lookout for them. Getting a team together is going to take time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110105
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110105,
					"content": "How could this be... If we return to Caravan Ribat for help, it will most certainly be too late...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110106,
						735110107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110106,
					"content": "Is someone in danger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				},
				{
					"id": 735110108,
					"content": "Eh? You guys are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110109
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110109,
					"content": "Just another adventurer passing by.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110110
					]
				},
				{
					"id": 735110110,
					"content": "#And {M#his}{F#her} best friend, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110111,
					"content": "Adventurers? Really!? Thank the heavens! There's help for Vinayak, at last!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110112
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110112,
					"content": "#{M#Mr.}{F#Ms.} Adventurer! Please save Vinayak. We'll make sure to reward you handsomely!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110113
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110113,
					"content": "First, tell me what's going on.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110114
					]
				},
				{
					"id": 735110114,
					"content": "Well, the desert has become more dangerous than before, thanks to those wretched vermin running amok. It's for the best that I fill you in on the situation before making plans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110115
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110115,
					"content": "Eh... you guys are right. Sorry, I was a little anxious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110116
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110116,
					"content": "Paimon's been hearing you talk about a certain \"them\" this whole time. What are they anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110117,
					"content": "A swarm of Wenut. For some reason, they have recently become unusually violent, hiding in sandstorms to attack unsuspecting prey passing by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110118,
						735110119
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110118,
					"content": "They're just bugs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110120,
					"content": "When you put it that way, yes. But this time, there are far too many of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110121
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110121,
					"content": "It's hard to deal with them under the cover of a sandstorm, and they usually flee at the first sign of danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110122
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110122,
					"content": "Wow, that's quite the pickle you're in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110123,
					"content": "It's not just Aaru Village. Other passing merchants have also been affected. That's why the Akademiya sent Vinayak and me to deal with these unruly Wenut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110124
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110124,
					"content": "But the caravan we entrusted to deliver some components was attacked by Wenut on the way, and everything got swept up in sandstorms... I fear they've become the monsters' playthings by now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110125
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110125,
					"content": "I wanted to return to Caravan Ribat for help, but Vinayak... Who knew that after all these years, he's still as rigid as a machine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110126
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110126,
					"content": "He said something about getting his precious components back and just ran into the desert all by himself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110127
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110127,
					"content": "Ahh!! Maybe I should just let the monsters take him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110128
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110128,
					"content": "#Whoa... what should we do, {NICKNAME}? If we leave this matter alone, not only will that researcher be in danger, but the Wenut problem won't be resolved...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110129,
						735110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110129,
					"content": "This crisis in the desert can't be ignored.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110131,
					"content": "Thank you! Thank you so much! I'm sorry that I let my temper get the better of me... I'll mark the location of the attack on the map. Please find him as soon as possible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110132
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110132,
					"content": "I hope he doesn't get the hare-brained idea to dive right into the horde of monsters and start picking up components...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110130,
					"content": "Leave the rescuing to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110119,
					"content": "I've dealt with way bigger enemies.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110107,
					"content": "Do you guys need help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				}
			]
		},
		{
			"id": 7351103,
			"completionStepIds": [
				7351103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
