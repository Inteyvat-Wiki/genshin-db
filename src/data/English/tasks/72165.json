					"Komaki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721650101,
					"content": "You're back. Is there something I can do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650102,
					"content": "Please help me tell my fortune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#Paimon also wants to know what sort of luck {NICKNAME}'ll have today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650104,
					"content": "Hmm... From the pattern of the Spiritherbs' leaves... You will have good fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650105,
					"content": "You will find that fortune at the highest point in Watatsumi Island, in an ancient place dedicated to the gods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650106,
					"content": "Hmm... How come Paimon can't see any of that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650107,
					"content": "Hehe, this is what they call the wisdom of the local old folks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650108,
					"content": "It sounds like you're just trying to bluff Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
