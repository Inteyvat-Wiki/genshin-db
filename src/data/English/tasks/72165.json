			"dialogs": [
				{
					"id": 721650201,
					"content": "Oh, youngsters, how do you do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650202
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650202,
					"content": "Please help me tell my fortune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "Hehe, what's our luck gonna be like today, hmm~?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650204,
					"content": "The Spiritherbs say that... you will have ill fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650205,
					"content": "You will have an ill-fated and unexpected encounter in a cave in the south of Watatsumi Island — a hive of scum and villainy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650206,
					"content": "Eh, it's bad luck! Uh, we should probably avoid that sort of place, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650207,
					"content": "Hehe. However...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650208,
					"content": "Overcoming ill fate may yet bring you an unexpected boon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650209,
					"content": "A boon...? You mean treasure? Is it gonna be treasure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650210,
					"content": "I did not say that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650211,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650212,
					"content": "But I did not say it wouldn't be that, either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650213,
					"content": "Oh, come on, Granny, why do you have to be like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
