					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650305,
					"content": "A gentle Electro Seelie will guide your path near the deep pool in the center of Watatsumi Island, just below the Sangonomiya Shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650306
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650306,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650307,
					"content": "It should be true. These divinations have always been very accurate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650308
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650308,
					"content": "Mmm, the more you say that, the more Paimon's getting suspicious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650309,
					"content": "Don't mind Paimon, Granny.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650310
					]
				},
				{
					"id": 721650310,
					"content": "Hehe, it's alright, it's alright. You're still young...",
					"roleType": "TALK_ROLE_NPC",
