				},
				{
					"id": 721650404,
					"content": "Hmm. The Spiritherbs say that this will be an ill-fated day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650405
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650405,
					"content": "The ruined shrine in the east is shrouded in an ominous aura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650406
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650406,
