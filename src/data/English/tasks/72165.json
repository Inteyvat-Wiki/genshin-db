				},
				{
					"id": 721650407,
					"content": "However...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650408
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650408,
					"content": "Those who boldly go forth and conquer such omens will receive their just reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650409
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650409,
