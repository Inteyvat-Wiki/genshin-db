						721650504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650504,
					"content": "Oh dear, the Spiritherbs' light is rather weak at the moment. It seems they shall need some rest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650505
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650505,
					"content": "All the same, I can help you perform another divination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650506
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650506,
					"content": "Hmm. The twinkling of the Spiritherbs say that you shall have good fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650507
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650507,
					"content": "In the ruins to the northeast, in the ancient city that stands alone amidst the sea, a lingering spirit of mourning will light the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650508
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650508,
					"content": "However...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650509
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650509,
					"content": "You must open for her a great gate and return her to her nest of sweet slumber before the fated reward can be yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
