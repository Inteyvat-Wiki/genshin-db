			"dialogs": [
				{
					"id": 721300101,
					"content": "The strange stone lantern seems to emit an ominous energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721300102,
					"content": "This stone lantern is so creepy... It feels familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300103,
					"content": "Oh, someone's written something on the lantern post!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300104,
					"content": "\"Soldiers stationed here, if you have any questions about this ward, please go to the Musoujin Gorge and talk to Mr. Kaji.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721300105,
					"content": "The handwriting looks new, yet eroded by rain. A few clear lines of smaller writings are below.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721300106,
					"content": "\"Please don't believe these strange notes. We've got no time to lose! This must an enemy trick meant to slow us down.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721300107,
					"content": "\"Whoever leaves the team without permission will be severely punished!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721300108,
					"content": "This Mr. Kaji seems to be pretty concerned about these stone lanterns. Why don't we go to Musoujin Gorge and ask him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
