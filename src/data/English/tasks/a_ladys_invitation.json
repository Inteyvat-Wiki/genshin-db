			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marionette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Oh? You're here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180102,
					"content": "Hiya, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "Thanks for the invitation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Huh? Didn't your letter say we were having a tea party? How come there's nothing here? Don't tell Paimon this is a snack-free get-together!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Hah, I bet you would love that, Paimon? You really think I'd forget the food?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180107,
					"content": "Whoa! Did... Did that table just appear out of thin air!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Hehe, impressive, right? This is my newly developed portable tea table.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180109,
					"content": "It's easy to carry and store, and even equipped with a hover device, just like Fagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180110,
					"content": "What's even more impressive is... Oh, uhm, never mind, I don't want to show off and make this sound like a sales pitch. You can check it out for yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180111,
					"content": "Here, I've prepared some tea and snacks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180112,
					"content": "I'll help myself then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Mmm...! These are so delicious! You really are a great cook!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Naturally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180115,
					"content": "But what inspired you to make something like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "I wanted to be able to enjoy pleasant tea parties with friends wherever they are, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180117,
					"content": "I've said this before. Holding on to what you already have isn't the only way to preserve what's precious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180118,
					"content": "Lately, I've found myself wanting to go on walks and visit my friends more often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180119,
					"content": "But inviting myself to others' homes and expecting them to prepare tea and treats, then letting them clear the table afterward... It's hardly proper etiquette for a lady.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180120,
					"content": "Hehe, Paimon doesn't think your friends would mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "I mind. Besides, a simple invention like this is no trouble at all for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180122,
					"content": "I can see you like it. Don't worry, I can make one for you, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180123,
					"content": "Huh!? Are you sure that's alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "It's perfectly fine. Like I told you, I can whip up something like this in no time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180125,
					"content": "In that case, thank you very much...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Don't mention it. You helped me out a lot during the Fontinalia Festival. Consider this as thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180104,
					"content": "Hope we didn't keep you waiting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}