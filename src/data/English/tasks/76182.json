			"dialogs": [
				{
					"id": 761820101,
					"content": "Is this where you used to live? It's pretty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761820102,
					"content": "It used to be even prettier. I have quite a knack for gardening, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820103,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761820104,
					"content": "What are you laughing about now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820105,
					"content": "I was just picturing you crouching down, tending to the flowers. It's an adorable image.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761820106,
					"content": "Can I take a look inside?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761820107,
					"content": "Of course. I've already cleaned and dusted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820108,
					"content": "What are you going to do with the place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761820109,
					"content": "Hmm... I think I still want to hold onto it. I can come back and tidy up whenever I have the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820110,
					"content": "If you're busy, I can help take care of it for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761820111,
					"content": "It gives me the same feeling your old room used to. It's comforting... A happy place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761820112,
					"content": "Hmph... Suit yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
