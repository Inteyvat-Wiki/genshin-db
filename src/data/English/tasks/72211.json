				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "Hello, welcome to Kiminami Restaurant. Would you like something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110203,
					"content": "So I need to make Neko a meal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "\"Neko?\" ... Might that be a cat's name, by any chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110205,
					"content": "You know who Neko is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110206,
					"content": "No. I just thought that it was a fitting name for a cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110207,
					"content": "That's some strong intuition you've got there...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "Never mind that for now. This is how it happened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110209,
					"content": "There's... an Asase Shrine on Seirai Island, and that shrine is home to a talking cat!? And that cat asked you to make it a meal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110210,
					"content": "Is... Is that really true? I've never heard of such a thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110211,
					"content": "Surely as I live and breathe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "Seirai Island, was it? I'll go there for sure if I get the chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110214,
					"content": "Uh, so, about Neko's meal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "Ah, right... I nearly forgot about that. Let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110216,
					"content": "Hmm, a dish that a cat would enjoy, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110217,
					"content": "Is it gonna be difficult?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110219,
					"content": "It's going to be difficult, isn't it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "This is a challenge to the Kiminami family name! I'm going to overcome it, no matter what!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110221,
					"content": "Now then. I believe that Fish, Raw Meat, Seagrass, and Rice will make for a dish that even cats will fall over themselves to get a taste of. Leave it to me, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110222,
					"content": "P—Paimon wants some too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110223,
					"content": "Actually, me too...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "No problem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110226,
					"content": "Let me consider how I'm going to structure this recipe. In the meantime, help me prepare three servings of Seagrass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110227,
					"content": "You got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "It'll be in your hands then. Just three servings will do. Once you find them, come back and give them to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110229,
					"content": "Have you figured it out already?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "I have some thoughts, but they haven't completely taken shape yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110231,
					"content": "Just help me get those three servings of Seagrass first. Thank you very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110224,
					"content": "We'll leave it in your hands, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110212,
					"content": "You can go have a look yourself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				}
			]
		},
