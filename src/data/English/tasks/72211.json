				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110401,
					"content": "This smell... You've done it, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110402,
					"content": "That we have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110403
					]
				},
				{
					"id": 722110403,
					"content": "Meow, meow! Wonderful! Allow me to have a taste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110405
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110405,
					"content": "Mmm, it's somewhat different from how Hibiki used to make it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110406,
					"content": "I—It should be pretty good. C'mon, let's have a go at it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110407,
					"content": "Ooh, this is great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110408,
					"content": "...Meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110409,
					"content": "(Is Neko unhappy that it tastes different from how this Hibiki person used to make it?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110410,
					"content": "It's very good. You are most reliable indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110411,
					"content": "Glad you enjoyed it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "It is quite different from how Hibiki used to make it, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110413,
					"content": "But when I ate it, the feeling it gave me was the same as the feeling of eating together with Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110414,
					"content": "Why is this so, human? Are you humans capable of some strange magic?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110415,
					"content": "It's just been a while since someone made you food.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "...Still, you have my thanks. Long years it has been since I last tasted something this good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110418,
					"content": "The little ones will love it as well. Could you please bring this meal to them as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110419,
					"content": "Since I enjoy it, they should too. Perhaps they will be more obedient after eating such a wonderful meal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110416,
					"content": "It's probably the passion of the person who made it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
		{
			"id": 7221105,
			"completionStepIds": [
				7221107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221107",
							"2"
						],
						"stepId": 7221107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110501,
					"content": "Have you brought the meal to those little ones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110502,
					"content": "They absolutely loved it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "Is that so? Wonderful, wonderful. Meow, meow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110504,
					"content": "It has been too long since I ate something so wondrous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110505,
					"content": "Meow meow, meow... Though I now need neither food nor water, the taste of a meal with rice is always too great a temptation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110506,
					"content": "That little one was named Meshi, precisely because that is the best thing I could think of in all the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110507,
					"content": "So, what was the name of the dish that Hibiki would make?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "A name? Dishes need names?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110509,
					"content": "This one's called the \"Invigorating Kitty Meal,\" you know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "What a complicated name. Still, I do not hate it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110511,
					"content": "...And you are right. Meals are good things, and all good things should have names.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110512,
					"content": "Meow, meow, I will ask Hibiki when she returns. You can make her your dish then, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110513,
					"content": "And she will make you hers. Then, you shall be able to eat two different yet delicious dishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110514,
					"content": "Indeed, that is all the more reason for me to restore this shrine. When Hibiki returns, we shall all eat together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110515,
					"content": "Thank you. This is most delicious. Meow meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221101",
							"3"
						],
						"stepId": 7221101,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110601,
					"content": "I shall leave the cooking to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110602,
					"content": "And when you are done, eat it together with us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221107,
			"completionStepIds": [
				7221108
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221108",
							"2"
						],
						"stepId": 7221108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110702,
					"content": "Great! Give me a moment. I think... I think I know what to do now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110703
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110703,
					"content": "It's done!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110704
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110704,
					"content": "Ooh, that smells awesome! Paimon really wants to try some...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110705,
					"content": "What shall we call this? Hmm... Since it's for a talking cat, let's call this the Invigorating Kitty Meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110706
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110706,
					"content": "Well then! Here's your dish to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110707,
					"content": "Ah, yes, and let me write the recipe down for you as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110708,
					"content": "#Woohoo! Guess {NICKNAME}-made Kitty Meals are on the menu in the near future!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110709,
					"content": "What are you, Paimon, a cat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "Hey, that's rude! Good food is a universal language, don't you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110711,
					"content": "Anyway, thanks a bunch, Miss Kiminami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110713,
					"content": "It's alright, don't worry! Just take this meal and the recipe as a present for Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110714,
					"content": "I'll be sure to head down to that Asase Shrine to pay her a visit once I find the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110715,
					"content": "Alright, off you go now. Don't keep Neko waiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110712,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
		{
			"id": 7221108,
			"completionStepIds": [
				7221101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221101",
							"2"
						],
						"stepId": 7221101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110801,
					"content": "Ah, you're here. Great timing. I have need of aid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110802
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110802,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110803
					]
				},
				{
					"id": 722110803,
					"content": "Thanks to you, the shrine has been greatly improved, and we can expect the humans to return very soon indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110804
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110804,
					"content": "I have been instructing the little ones to maintain a dignified bearing and not abase themselves before humans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110805
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110805,
					"content": "Unfortunately, they are too used to running wild and will not listen to instruction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110806
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110806,
					"content": "Nonetheless, I have a cunning plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110807
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110807,
					"content": "A cunning plan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110808
					]
				},
				{
					"id": 722110808,
					"content": "When I was still very, very young, I too enjoyed playing everywhere. In an effort to bring me in line along with the other cats, Hibiki would make a most delicious dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110809
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110809,
					"content": "D—Delicious, you say...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110810,
					"content": "Whenever that meal was served, the cats would come running in from trees and rooftops alike. No matter how hot it was, or how scalded our tongues got, we could not resist it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110811,
					"content": "Hibiki would make a huge pot of it every time, and humans and cats would partake together. Even those who visited the shrine would get a share.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110812,
					"content": "Ah, but Domeki... Tsk, that glutton. He would always eat so very much. A more undignified sight I have never seen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110813,
					"content": "So...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "Very good, your comprehension is excellent. Yes, I am asking you to make a dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110816,
					"content": "Not to doubt your wisdom...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "But do you really know how this dish should be made?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110818,
					"content": "Meow, meow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110819,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "I—Is not leaving such matters to you the very point of this exercise? Must I do everything myself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110821,
					"content": "...Ah, but that dish was truly a thing of wonder! Even after wandering far off, or having spent years and years without it, I still remember its flavor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110822,
					"content": "#Well, {NICKNAME}, looks like this is a job for us, eh? It's for the shrine's sake, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110823,
					"content": "What's in that meal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "Of course I remember. Fish meat, animal meat, water-grown grass, and white rice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110827,
					"content": "Ooh, so that's Fish, Raw Meat, Seagrass, and Rice, huh... How was it made, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110828,
					"content": "I do not recall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110829,
					"content": "...Looks like we'll have to ask a chef.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "Sure, but... Where do we find a chef who knows how to make cat food? Hmm... Let's ask Taisuke and Etsuko. Maybe they'll know what to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110831,
					"content": "Let's go ask those two adventurers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "Oh yeah, that's right! Taisuke and Etsuko are adventurers, so they might know something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110824,
					"content": "You're so easily read, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "Come on, Paimon's a friend to cats! Now, Neko, do you still remember the ingredients that went into that dish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110814,
					"content": "You want me to make you some food?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
