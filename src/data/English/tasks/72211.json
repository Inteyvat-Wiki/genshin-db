			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Miss Etsuko, where should we go next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "Phew... I think we'll rest for a while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110103,
					"content": "Hmm? It's you. Is there anything we can do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110104,
					"content": "We need to find a reliable chef...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "You're looking for a chef? On Seirai Island?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "Well, here's the thing. Neko would like us to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "Huh. So Lady Neko wants you to prepare some food, is that right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "Ah, darn it! If only I had some skill in cooking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "In other words, you'd like a chef who can help you figure out \"how to make something a cat would like out of these ingredients,\" right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110110,
					"content": "Let me think... A chef... A chef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110111,
					"content": "Well, why don't you try going to Inazuma City and looking for Kiminami Anna at Kiminami Restaurant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110112,
					"content": "She's a very nice person, and she's good at cooking as well. She should be able to help you out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110113,
					"content": "Thanks, we'll go look for her.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "No need to thank us. Off you go, then, Taisuke and I still need to lay some plans for future exploration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110115,
					"content": "Hehe, well, I hope that this shrine really does thrive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110116,
					"content": "Otherwise, the hard work that you and Neko put into fixing it might go to waste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
			"id": 7221102,
			"completionStepIds": [
				7221103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221103",
