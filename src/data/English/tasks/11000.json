			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000401,
					"content": "These boars look healthy, and active too. I bet their meat is superb quality!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000402,
					"content": "Ugh, just thinking about it is making me hungry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "Wowee! This is great! Some of it I'll shallow fry, some of it I'll deep fry with mushrooms— ooh, and I wonder how well it goes with Slime Condensate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000502,
					"content": "She's off in her own world...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "Paimon thinks she's forgotten about us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000506,
					"content": "Uh, sorry! I got all excited thinking about new recipes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000507,
					"content": "As promised, a tasty snack! Go on, try it! And tell me what you think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000508,
					"content": "Are we your food testers now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000509,
					"content": "Oh gosh, this is... delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000510,
					"content": "Can you tell us how to make it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000511,
					"content": "Hee-hee, sure! The only thing is I haven't written down the recipe yet, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000512,
					"content": "I got it! I'll make another one now so you can watch. I'm sure you'll pick it up straight away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "This seems pretty hard to make, it'll take more than that to learn how to make it. And we don't have a frying pan or any condiments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000514,
					"content": "Come on, it's simple!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000515,
					"content": "We can fry on a slab of stone and cook using some boar fat. Build a stove from rocks, use dry grass for kindling, twigs for firewood...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000516,
					"content": "Sweet flowers will do for sugar. As for salt, I found a load of rock salt in a cave the other day, there's still plenty left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000517,
					"content": "Seems like she's done this a million times before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Hee-hee, I just can't help myself when there's a chance to try something new. But I can't exactly bring my whole kitchen with me every time I leave the house either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000520,
					"content": "Give me a second while I get everything ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000521,
					"content": "Hey! What do you think you're doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000601,
					"content": "This is the boars' natural habitat, you can't hunt them here! You'll send them all running.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000602,
					"content": "We hunters know better than to kill the chicken to get at the egg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000603,
					"content": "Oh! I get it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000604,
					"content": "The freshest, best-quality meat comes from free-range boars that grow up in the environment nature intended for them! If they all ran off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000605,
					"content": "...It would be a major blow to gastronomy— no, to all mankind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000606,
					"content": "That's, uh, one way of understanding it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "I'm sorry. I got excited and didn't think of the impact we'd have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000609,
					"content": "*sigh* You should apologize to Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000610,
					"content": "As our leader, he always stresses the importance of respecting the rules of the hunt. I'm afraid he is very upset right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000611,
					"content": "What are we going to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000613,
					"content": "I made a mistake, and I should go and apologize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000614,
					"content": "Let us come with you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000615
					]
				},
				{
					"id": 110000615,
					"content": "Hee-hee, thanks guys. I'll cook up some more tasty snacks for you once this is over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000616,
					"content": "Okay. Don't worry, Paimon'll remember even if you forget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000617,
					"content": "Draff ought to be in Springvale. Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000612,
					"content": "I think the hunter is right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000607,
					"content": "That's not even close to what he meant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000518,
					"content": "I'm tired just listening to it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000504,
					"content": "I want to try Slime Condensate!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000505
					]
				},
				{
					"id": 110000505,
