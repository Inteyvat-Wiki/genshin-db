				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "Shh! Keep it down, I'm hunting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000302,
					"content": "I've always heard about the wide range of ingredients you can find in Mondstadt, and it looks like it's true!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000303,
					"content": "Are you a hunter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "No — I'm a chef! A chef on a mission to find rare and exotic ingredients from all corners of the world!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000306,
					"content": "My name's Xiangling, I'm from Liyue Harbor. And you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000307,
					"content": "#I'm {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "Hello, my name's Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000309,
					"content": "Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000310,
					"content": "Why are you looking at me like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000311,
					"content": "What an exotic creature, is it edible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000312,
					"content": "We're friends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "What a bummer. Can't eat it if it's your friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000316,
					"content": "You seem like good friends. I have a good friend too, called Guoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000317,
					"content": "Isn't that the name of a Liyue snack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000318,
					"content": "Hee-hee... Both the snack and my friend have a special place in my heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000319,
					"content": "Anyway — can you do some hunting for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000320,
					"content": "There's lots of game around here that would be amazing to cook with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000321,
					"content": "I can't catch anything to save my life and I don't want to miss out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000322,
					"content": "Sounds like a bit of an ordeal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000323,
					"content": "Don't be like that... C'mon, I'll whip you up a tasty snack later!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000324,
					"content": "Ooh, you had me at tasty snack! Don't worry, we're the bestest hunters ever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000325,
					"content": "Whose side are you on!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "Hee-hee, don't worry about it, your friend has already given me a response.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000328,
					"content": "I don't care how it's done, so long as you bring me back some raw meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000329,
					"content": "Great, then I'll leave you to it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000326,
					"content": "You could always ask me first...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "Dig in.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "No! For the last time, Paimon is NOT EMERGENCY FOOD!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000304,
					"content": "Are you an adventurer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
		{
			"id": 1100004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
