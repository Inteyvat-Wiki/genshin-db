			},
			"dialogs": [
				{
					"id": 731040901,
					"content": "You guys are so good! Thanks a lot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040902
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040902,
					"content": "When all the relics are recovered, I will apply for more compensation as your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040903
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040903,
					"content": "You just don't believe I can hook a real fish, do you...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040904
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040904,
					"content": "Wait, something big is on the hook!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040905
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040905,
					"content": "Kayvan lifts the rod hard...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040906
					]
				},
				{
					"id": 731040906,
					"content": "What's this...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040907
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040907,
					"content": "Ah, this is another pack of the relics! Great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040908
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040908,
					"content": "I didn't expect it to go so well. You've recovered two relics now! What a hook, Mr. Kayvan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040909
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040909,
					"content": "I shouldn't have said that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040910
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040910,
					"content": "There are tons of fish in the river. Not so for relics.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040911
					]
				},
				{
					"id": 731040911,
					"content": "But I haven't caught a single fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040912
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040912,
					"content": "Look at the bright side. We've recovered the relics. It's a good thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040913,
					"content": "The last fishing spot is near Vimara Village. A much safer place for fishing. Let's get moving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040914
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040914,
					"content": "Yeah, yeah. Off we go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040915
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040915,
					"content": "This is so weird. Is there something wrong with my bait, or the way I fish...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040916
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040916,
					"content": "Never mind. Traveler, please find some fresh Zaytun Peaches for me this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040917
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040917,
					"content": "Since it's the last spot, I'll have to use my special bait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040918
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040918,
					"content": "I'm counting that on you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
