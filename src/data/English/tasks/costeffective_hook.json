					"nextDialogs": [
						731040702
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040702,
					"content": "I need to concentrate. Please don't make any noise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040703
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040703,
					"content": "Kayvan begins to focus on fishing...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040704
					]
				},
				{
					"id": 731040704,
					"content": "Argh! Look over there! So many Slimes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040705
					],
					"speakerTitle": "Helbet"
				},
				{
