			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "Please, do me a favor! I could really use your help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040102,
					"content": "No can do. Please go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040103,
					"content": "Whoa, what's with the quarrel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040104,
					"content": "Hey, outlander, care to help me persuade this lady here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040105,
					"content": "She came to ask me to salvage some antiques. Has been bugging me all day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040106,
					"content": "She not only scared away my fish but also wants to keep taking up my time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040107,
					"content": "Miss, why such a hurry? Trying to rake it in with the antiques?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040108,
					"content": "No, Mr. Kayvan. I am Helbet with the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040109,
					"content": "The Akademiya found those antiques and I'm responsible for keeping them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040110,
					"content": "But there was an accident on the ship transporting the relics. Some dropped off the ship, floating down the river to the lower reaches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040111,
					"content": "Then go to a professional salvage team! Why bother a fisherman like me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040112,
					"content": "It takes too long to find a suitable salvage team. I've heard people call you \"Supreme Hookshot\" and that you fish lost items up from the river nearly every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040113,
					"content": "And you've been fishing around a lot, so I thought I'd ask you to try casting your rod, see if you could get the relics...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040114,
					"content": "You are being desperate...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "Ahem, Miss Helbet, I feel sorry for what you have been through. But I'm only a fisherman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040118,
					"content": "I cast my rod to catch fish and fish only.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040119,
					"content": "You haven't caught even one fish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040120,
					"content": "Ahem! I've been training to do that with the pure thought in mind. Never thought about hooking other stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040121,
					"content": "So you'd better find someone else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040122,
					"content": "Eh... Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040123,
					"content": "Then... How about this, I won't ask you to hook the relics for me, I just need you to go fishing at another place. What do you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040124,
					"content": "I'm paying you to catch fish! Please, I'm counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040125,
					"content": "Ugh... I am a fisherman! A fisherman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040126,
					"content": "It's nice to fish at a new spot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "Come on, please help me. I've prepared your payment already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040129,
					"content": "You guys are incessant... Fine, I guess I'll do that for a change. Where do you want me to fish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040130,
					"content": "Many thanks! Just follow me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040131,
					"content": "Same as before, Traveler. Please help me find some materials for the baits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040132,
					"content": "Let me think... I'll be using Mint this time. But it needs to be collected from my usual spot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040133,
					"content": "I've marked the general area. I'll leave it to you. After you bring the materials, I will go over the payment in detail with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040134,
					"content": "Miss Helbet and I are going to the fishing spot first. We'll meet there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040127,
					"content": "Well, a fisherman hooks this and that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Well, if it's Kayvan who casts the rod...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "I cast my rod only to get fish, okay!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Kayvan"
				}
			]
		},
