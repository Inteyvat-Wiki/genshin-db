			"dialogs": [
				{
					"id": 731041201,
					"content": "Looks like everything's going well. Time for one last fishing attempt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041202
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041202,
					"content": "Whew... Third time's a charm. Please let me hook some fish! Even a teeny-tiny one will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041203,
					"content": "Kayvan prepares the bait and begins fishing...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041204
					]
				},
				{
					"id": 731041204,
					"content": "A third soaked package is pulled out of the water by the wire after a while.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041205
					]
				},
				{
					"id": 731041205,
					"content": "See it yourself... I don't want to look at it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041206
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041206,
					"content": "Alright, let me take a look... Good, there's no damage at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041207
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041207,
					"content": "Perfect, Mr. Kayvan! The power of Supreme Hookshot, again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041208
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041208,
					"content": "Yeah, haha... As long as you have what you wanted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041209
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041209,
					"content": "Three packs with three hooks... Yet not even one fish came to bite the hook...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041210,
						731041211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041210,
					"content": "That's what makes Mr. Kayvan so impressive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				},
				{
					"id": 731041212,
					"content": "Hey! I've been serious about catching a big fish, not antiques!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041213
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041213,
					"content": "Call me bad at fishing or whatever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041214
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041214,
					"content": "But it's been so many times! Even one with the worst luck should have gotten some fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041215
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041215,
					"content": "But none's ever come to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041216
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041216,
					"content": "Hmm... This is strange indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041217,
					"content": "Well, Mr. Kayvan, if you are interested, I can introduce you to a researcher who specialized in fishing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041218
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041218,
					"content": "He's worked on the design of many popular fishing rods and baits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041219
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041219,
					"content": "I don't know exactly why you couldn't hook a fish. But... It doesn't hurt to ask a professional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041220
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041220,
					"content": "Maybe he'll be interested in you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "You mean interested in the fact that I lift my hook with everything but fish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041222
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041222,
					"content": "But you are right. This is my chance to see what's wrong with my skill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041223
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041223,
					"content": "Sure. Leave the rest to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041224
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041224,
					"content": "But do some bookworm researchers really know fishing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041225
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041225,
					"content": "Oh... I almost forgot! Thank you for the help, Traveler. This is your payment. Please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041211,
					"content": "This is certainly one of a kind I guess...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				}
			]
		},
