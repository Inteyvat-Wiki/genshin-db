				7310404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310404",
							"2"
						],
						"stepId": 7310404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "That's pretty quick! Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040402,
					"content": "Please start fishing, or the relics could... I mean the fish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040403,
					"content": "No rush. I need to feel the flow of the water to ensure I can cast the rod with the peace of mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040404,
					"content": "Let's see what big fish lies for me here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040405
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040405,
					"content": "Kayvan prepares the bait and begins fishing.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040406
					]
				},
				{
					"id": 731040406,
					"content": "Kayvan catches a wet package after a long while.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040407
					]
				},
				{
					"id": 731040407,
					"content": "What do I have here...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040408
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040408,
					"content": "This is... Let me check!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040409
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040409,
					"content": "This is it! One of the lost antiques! Unscathed. No aquatic creature has gotten inside...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040410
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040410,
					"content": "You actually hooked a relic! You are really the Supreme Hookshot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040411
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040411,
					"content": "Is that a compliment? Doesn't really make me happy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040412,
					"content": "Well, the relic at the first spot has been salvaged, and the next... fishing spot is just west of here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040413
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040413,
					"content": "Let's get rolling. The sooner I can go back and catch real fish in peace, the better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040414,
					"content": "No problem. Please follow me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "Helbet"
				},
				{
