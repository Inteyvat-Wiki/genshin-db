				7333007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7333007",
							"2"
						],
						"stepId": 7333007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Markozov",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "Hey, you scheming humans! I suggest leaving this place at once — the heritage and secrets of us Pari are not for you to covet, and certainly not within your reach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300702,
					"content": "...Pari? You're a Pari! Oh, what an amazing experience!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300703,
					"content": "#Oh! And there's also a {M#wiry young man}{F#little young lady} with {M#his}{F#her}... pet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300704,
					"content": "#Hey, watch what you say! Paimon's {M#his}{F#her} best friend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300705,
					"content": "Friend... Why, of course! \"Best friend\"... What a beautiful sound! I've always wanted to have a \"best friend\" since childhood...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300706,
					"content": "#{M#Wiry young man}{F#Little young lady}, you're certainly not in need of two best friends, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300707,
					"content": "What do you mean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "I mean... Even if you're the one having two best friends, don't you think it's a little unfair?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300711,
					"content": "Inequities like this are impossible to forgive... So please, hand the Pari over to me. As for how I'll treat it... you wouldn't have to worry. I'll make sure it's used to its full potential.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300712,
					"content": "Insolent fool...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300713,
					"content": "Whoa, he's being so unreasonable... There's no getting through to him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300714,
					"content": "We can always make him understand without wasting our words... My clever Yasnapati, surely you know what I mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300715,
					"content": "Oh, Paimon knows! Sorush wants us to teach him a lesson!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300716,
					"content": "Hmph! Silence, Pale Floater!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300708,
					"content": "I actually wouldn't mind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "No way! Only Paimon can be your best friend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}