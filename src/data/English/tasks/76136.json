			},
			"dialogs": [
				{
					"id": 761360301,
					"content": "(Perhaps <color=#FFCC33FF>Jahoda</color> would like to inspect the chest...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "Heh heh... Let's see how much we've made recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360303,
					"content": "I remember Boss saying she was going to give me a bonus. How about I help m—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360304,
					"content": "Huh? Where's the money? There's nothing in here but a slip of paper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360305,
					"content": "\"My dear Jahoda, your bonus doesn't come from this box. Be sure to close it properly afterward.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360306,
					"content": "Pfft, Boss is trying to scare me again. Maybe there's a hidden compartment inside here somewhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360307,
					"content": "There isn't any hidden compartment in there. Your bonus is right here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360308,
					"content": "Oh, thanks Boss. I—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360309,
					"content": "Eeek! BOSS!!! I-I-I was just doing a cash count!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360310,
					"content": "I will get to work now, right now—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360311,
					"content": "Stop right there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360312,
					"content": "Yes, Boss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360313,
					"content": "Lock the box properly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360314,
					"content": "Yes, Boss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360315,
					"content": "Now you can go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360316,
					"content": "Yes, Boss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
