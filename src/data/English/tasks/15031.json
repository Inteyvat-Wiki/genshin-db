			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3051.298,
							234.129,
							9908.278
						],
						"pointId": 10477
					},
					{
						"sceneId": 3,
						"position": [
							-3049.413,
							234,
							9905.058
						],
						"pointId": 10930
					},
					{
						"sceneId": 3,
						"position": [
							-3047.629,
							233.936,
							9909.162
						],
						"pointId": 10931
					}
				]
			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "What a great haul! A bunch of Seeing Eyes and this thing the weasel used to spew out fire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310402,
					"content": "I think that's its back armor! It shoots out phlogiston, so it can pretty much attack from all directions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310403,
					"content": "My dad told me about them once — creatures that live in the volcano. I can't believe we actually ran into one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310404,
					"content": "This piece of armor might produce even higher temperatures than the Seeing Eyes. Hehe, we'll get those mushrooms super hot this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310405,
					"content": "Nice fighting back there, by the way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "Oh, well... Even though I don't like fighting, sometimes, you don't have a choice. So, I've tried to figure out a bunch of different ways to get myself in the zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310407,
					"content": "For example, I've read a lot of stories about heroes, and my favorite hero has always been Fietena — the one I mentioned before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310408,
					"content": "Fietena's most iconic feature was her mask, so I decided to make one just like hers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310409,
					"content": "So, now, whenever I wear the mask, it's like there's a little piece of her with me. If I want to honor her legacy, I have no choice but to be brave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310410,
					"content": "At the same time, though... I guess it's kind of like a crutch. Kind of like, I'm hiding behind her strength.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310411,
					"content": "Oh, you really think so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310412,
					"content": "But, it helps you, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "Really? It's just...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310415,
					"content": "I feel like... I need to take it off one day and face things alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310416,
					"content": "But, the longer I put off taking that step, the more impossible it feels. I... don't know if I have it in me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310417,
					"content": "But you were the one who decided to investigate this case.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "Yeah, YOU had the courage to make that decision, and that's what adventuring is all about! Fighting is just a small part of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310420,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310421,
					"content": "Besides, Paimon thinks you're doing a great job! Just take your time — it's not a race.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310422,
					"content": "Thanks for believing in me, you two. I've learned so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310423,
					"content": "And, I won't give up, not until I can face things on my own!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310424,
					"content": "Phew, after that pep talk, I feel like my appetite is back in full force!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310425,
					"content": "You're hungry already? Paimon hasn't even finished digesting her last meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310426,
					"content": "C'mon, let's head back to the tribe. We'll earn that mushroom's recognition this time, for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310418,
					"content": "Not your mask.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "It's nothing to feel ashamed about.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
}