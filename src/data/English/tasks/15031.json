				]
			},
			"dialogs": [
				{
					"id": 150310301,
					"content": "Done and dusted! This core should be perfect. Look! The phlogiston inside it is still active!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310302,
					"content": "Ooh, let's see... Whoa, hot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310303,
					"content": "A few more chunks like this, and we should be good. C'mon, let's keep heading up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
		{
			"id": 1503104,
			"completionStepIds": [
				1503107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
