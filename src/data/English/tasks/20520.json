					"Tommy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "Phew... Much better. Thank you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200402,
					"content": "What brings you to this place?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "*sigh* A commission, what else? I've been at the camp all this time because of a rather... tricky commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200404,
					"content": "But I didn't want to stay there forever, so I was looking for something else to do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200405,
					"content": "The chef, Harris, was looking for someone to find some Chilled Meat up the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200406,
					"content": "He said that I just needed to find some small frozen boar, and that there was no need to go too far up the mountain, so there'd be no danger at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200407,
					"content": "I thought it sounded straightforward enough, so I accepted the commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200408,
					"content": "I'd been preparing myself, too — training myself slowly, acclimatizing myself to Dragonspine's environment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200409,
					"content": "...All so that I might finish the commission given to me by that alchemist lady.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200410,
					"content": "But I didn't expect that I'd lose my way not long after I started my ascent, and nearly get frozen in the process. I was lucky to have met you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200411,
					"content": "My only regret is that... I couldn't complete my commission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200412,
					"content": "Traveler... you seem to know this mountain well. Could I trouble you to do me a favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200413,
					"content": "I just need you to find me one serving of Chilled Meat. Just one is fine — that is all I need to complete my commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200414,
					"content": "I've got your back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "Thanks. In that case, let me mark the locations where Harris mentioned we might find small frozen boars on your map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200416,
					"content": "I'll head down to the camp at the base of the mountain and await your good news there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
