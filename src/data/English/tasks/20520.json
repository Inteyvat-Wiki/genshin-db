			"dialogs": [
				{
					"id": 205200101,
					"content": "T—Traveler... Could... could you h—help me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200102,
					"content": "What's wrong with you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "P—Please... I—I need some warmth... It's... t—too cold...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200104,
					"content": "O—Or maybe... s—some hot food might also be g—good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200105,
					"content": "P—Please... I'm just... too c—cold...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
