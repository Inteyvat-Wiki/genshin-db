				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745270401,
					"content": "#Ah, it's you, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270402,
					"content": "It's been a while, Escoffier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "I'm not heading up the kitchen today. I'm here as a taste-tester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270405,
					"content": "Savanna's trying to come up with something new, and has asked me to check on her. That said, this is... the fifth take on the same dish so far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270406,
					"content": "If it's not the texture of the ingredients being affected by a few seconds' disparity in temperature control, then it's the aroma of the spices used dominating due to over-seasoning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270407,
					"content": "You're as exacting as ever, I see.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "Of course! Cooking is a science, and our friendship isn't going to change that. In fact, our friendship and our duty to our customers demand that I be strict.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270409,
					"content": "I do actually have a small request...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "...At a time like this? If the pictures are going up for public display, might I suggest finding another moment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270412,
					"content": "We need to put the set together with care, and carefully adjust the lighting and angle for the best possible results...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270413,
					"content": "I'm just taking a commemorative photo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "...Alright. There's a bit of time before the sixth redo, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270416,
					"content": "In that case, let's see whether your lens or that new dish will come out on top.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270414,
					"content": "I'm also looking to test out this new lens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "Would you mind if I took a picture of you, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "Are you cooking up an all-new recipe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
}