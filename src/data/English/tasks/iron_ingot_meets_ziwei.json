			"dialogs": [
				{
					"id": 413330401,
					"content": "Huh? Is it me... Or does this tofu smell funny?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330402
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330402,
					"content": "I could never give this to Ziwei. Maybe you could help get another one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				}
			]
