	"talks": [
		{
			"id": 4133301,
			"completionStepIds": [
				4133301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
