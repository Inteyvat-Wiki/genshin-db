			]
		},
		{
			"id": 4133307,
			"completionStepIds": [
				4133309,
				4133310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133309",
							"2"
						],
						"stepId": 4133309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ziwei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "From this angle... The constellation looks just like a dog. Now, I must think of a suitable name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330702,
					"content": "Oh, it's you, Iron Ingot. What are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330703,
					"content": "Umm, well you see... Uh, I—I was just strolling outside the city, and I happened to come across a very scenic spot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330704,
					"content": "A nice spot? You mean for star gazing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330705,
					"content": "Y—Yes, that's it! A nice spot for star gazing. It'd also be a great place to release Xiao Lanterns... See? I've already prepared one for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330706,
					"content": "And look, I've even written a p—poem on it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330707,
					"content": "\"Sparks fly where shovel and meteorite meet.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330708,
					"content": "Yes... Well, even though I don't really know what your wish is, the poem is quite interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330709,
					"content": "But you shouldn't let others see your wish before releasing the Xiao Lantern, otherwise it will never come true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330710,
					"content": "And so, what exactly do you need from me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330711,
					"content": "Well, I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330712,
					"content": "He found a very suitable spot for releasing a Xiao Lantern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "Releasing a Xiao Lantern? Oh, I'm sorry... I was actually hoping to go somewhere away from all the lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330715,
					"content": "The Xiao Lanterns are so bright that they obstruct my view of the stars. I think I'll be going as far as I can away from the festivities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330716,
					"content": "Thanks for the kind offer, but I should get going. Happy Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330717,
					"content": "O—Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330718,
					"content": "And there she goes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "I... I'm fine. Clearly, I must have made my poem too abstract. Ziwei didn't get it at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330721,
					"content": "Don't worry, I won't let it get to me. She'll finally understand my meaning one day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330722,
					"content": "Thanks for your help anyway, Traveler. Here, these are for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330723,
					"content": "Oh, I guess I should at least release this Xiao Lantern now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330719,
					"content": "Keep your chin up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "So if you'd like to release a lantern tonight, you can go together with him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
