				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iron Ingot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "\"Ziwei stumbles across an iron ingot\" ...No, no, that won't do. That's laying it on a bit thick...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330202,
					"content": "Oh, when did you get here? Did you check those two spots?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330203,
					"content": "We sure did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "That didn't take you long. Now let me have a look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330205,
					"content": "Alright, let me have a look here... Hmm, the surrounding scenery at this spot is very unique, whereas the other spot is centered in a more picturesque landscape. It reminds me of the line, \"Ain't no mountain high enough, ain't no...\" Uh, I forget what's after that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330206,
					"content": "Anyway, never mind... Still, these spots look bright and impressive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330207,
					"content": "I've got it! I know which one to pick... But, there's still something I'd like to ask of you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330208,
					"content": "My friends told me that when you go to see someone, it's best to bring something to eat. What do you think I should prepare when I go to see Ziwei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330209,
					"content": "Grilled Tiger Fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "Grilled Tiger Fish, hmm... Don't you think that'd be a little too oily? Maybe something a little more light and refined, like Almond Tofu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330212,
					"content": "Yeah, Almond Tofu! That would be perfect!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330213,
					"content": "Traveler, could you please help me prepare a serving of Almond Tofu? In the meantime, I'll keep working on my poem here. Now how should this next line go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330214,
					"content": "\"And countless sparks fly\"... Oh, that's a good line!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330211,
					"content": "Almond Tofu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
		{
