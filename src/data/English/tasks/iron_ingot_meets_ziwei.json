			"dialogs": [
				{
					"id": 413330301,
					"content": "Oh, when did you get back? Did you prepare the Almond Tofu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330302,
						413330303
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330302,
					"content": "Yep, it's ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "I still need a little more time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "Ah, okay. Don't worry, I can keep working on my poem in the meantime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				}
			]
		},
		{
