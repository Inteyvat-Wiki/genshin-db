			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iron Ingot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "The Mysterious Adeptus of the Highest Heaven Soaring Across the Skies. It's so beautiful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330102,
					"content": "Are you star gazing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "Yes... and no. It's the Lantern Rite, after all. It only seems fitting to look upon such an elegant sight during these festive times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330104,
					"content": "I've even been learning how to write poetry, too. The other guys tell me that girls these days are really into that sort of thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330105,
					"content": "Hah, I'm sure Ziwei will...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330106,
					"content": "Learning poetry?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "Uh — ahem, well, I've heard a lot of constellation names from Ziwei. *sigh* They all sound so beautiful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330109,
					"content": "So you see, I have to thank her somehow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330110,
					"content": "I was thinking that I should write a poem on a Xiao Lantern and find a place to release it together with Ziwei... We'll eat snacks and sing songs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330111,
					"content": "If this doesn't get the job done, nothing will!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330112,
					"content": "Get the job... done?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "Ahem, I mean... This will do the job of helping us enjoy the festival more... Yeah, that's it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330114,
					"content": "Anyway, I want to find a quiet, scenic spot away from other pedestrians.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330115,
					"content": "I started asking around and I've found two potential spots so far. Here, have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330116,
					"content": "The other guys told me that they've released Xiao Lanterns at these spots before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330117,
					"content": "But I still need to come up with a poem... and I'm afraid running around to check the spots will just douse my creativity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330118,
					"content": "Could you help me go check out those two spots?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330119,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "Thanks for your help, I'm counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ingot"
				},
				{
					"id": 413330107,
					"content": "Ziwei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
