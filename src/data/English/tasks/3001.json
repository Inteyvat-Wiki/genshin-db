					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "Alright, next let's see your right hand... Hmm, not bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010102,
					"content": "But please remember that you still need to be careful, understand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010103,
					"content": "Yes, I will. By the way, Master, I still haven't received the patrol route for today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010104,
					"content": "Look, Collei, today's patrol will be a long one, so you won't be coming along this time. Besides, there's a chance we may encounter... Well, you understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010105,
					"content": "But I have a Vision, too! Am I useless to everyone now...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010106,
					"content": "Don't talk like that, Collei. This is not something you need to be worrying about right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010107,
					"content": "Ah, there you are. Feeling any better?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010108,
					"content": "Is there something we can help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "Yeah, since we'll be staying here for now, we thought we might as well try lending a hand around here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010110,
					"content": "Heh, seems you're not the type to sit back and take it easy for a while, huh. In that case, perhaps Collei could take you two for a patrol south of Gandharva Ville for the day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010111,
					"content": "And if you're feeling up to it, you can be responsible for cleaning the Statue of The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010112,
					"content": "Tighnari, we're ready to head out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Amir"
				},
				{
					"id": 30010113,
					"content": "Got it, I'll be right there! Alright, we'll be heading into the forest now. I'll leave any further details to Collei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010114,
					"content": "Yes, you can count on me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010115,
					"content": "So Collei, what exactly are we going to be doing today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010116,
					"content": "Tighnari mentioned cleaning the statue just now, but uh... that doesn't really sound like a job for a ranger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010117,
					"content": "Well, a Forest Ranger's responsibilities can be pretty diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010118,
					"content": "We handle a variety of tasks, like checking the condition of outlying roads, maintaining forest facilities, ensuring fire prevention standards are met, and providing assistance to travelers and locals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010119,
					"content": "As for Master, well, he has to handle more dangerous areas of the rainforest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010120,
					"content": "Today we can perform routine checks on the pathway lamps as we make our way to the Statue of The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "The Statue of The Seven is up on top of that large rock formation. You must have seen it when you came down this road before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010502,
					"content": "It's pretty high up there, isn't it? Don't worry, if you're afraid you can't make it up there, I'm sure Master wouldn't mind if you don't clean the statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010503,
					"content": "No need to worry. I'm a terrific climber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "Oh? I guess I'll leave it up to you, then. There's not much footing once you reach the statue, so be careful up there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}, Paimon'll fly up with you and help with those hard-to-reach areas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010507,
					"content": "Um, by the way, Collei, do you know anything about the Dendro Archon? You know, what's she like?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010508,
					"content": "Uhh, that depends. Are you referring to Greater Lord Rukkhadevata or Lesser Lord Kusanali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010509,
					"content": "Huh? Greater Lord Rukkhadevata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010510,
					"content": "Oh, is that the name of the former Dendro Archon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010511,
					"content": "Uh-huh. Greater Lord Rukkhadevata was Sumeru's first Dendro Archon. She created the rainforests as well as the Wall of Samiel around the desert. Her works provided a means of peaceful living for everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010512,
					"content": "To the people of Sumeru, she is not only a symbol of wisdom but also of power and kindness. Unfortunately, she disappeared in a great calamity that occurred a few hundred years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010513,
					"content": "(Sounds exactly like what happened to Raiden Makoto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "According to what Master has told me, the sages later found the newly born Dendro Archon and whisked her back to Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010516,
					"content": "To celebrate the reinstatement of their lost deity, the sages dubbed her \"Lesser Lord Kusanali\" and let her reside in the Sanctuary of Surasthana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010517,
					"content": "Uh-huh, then what happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010518,
					"content": "Well, and then... uh... I'm not too sure what happened, to be honest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010519,
					"content": "Huh? You're not too sure? But aren't you from Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010520,
					"content": "Yeah, I'm from Sumeru, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010521,
					"content": "Maybe it's difficult to discuss this topic with strangers... If that's the case, then don't worry, we understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010522,
					"content": "No, no, it's not that. I'm not trying to hide something from you. Besides, I don't consider you two strangers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010523,
					"content": "Haha, because you two know Amber, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010524,
					"content": "Wait, Amber? You mean—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010525,
					"content": "Amber, Outrider of the Knights of Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "Yes, that's her! I once lived in Mondstadt for a while, and she helped me a lot during that time. You could even say that she helped me become a new person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010528,
					"content": "There's no one like Amber! She lives life to the fullest while always adhering to her strong sense of justice. She's ready to answer the call for action at any moment, but is also very understanding of others. She's like the spark that lights the fire in everyone's heart around her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010529,
					"content": "If you ask me, she's a prime example of a true Outrider. She's the first person anyone coming to Mondstadt will meet. You can't help but be enthralled by her charm and enthusiasm, causing you to fall in love with the lands of Mondstadt, and...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010530,
					"content": "Uhh, hehe... Sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010531,
					"content": "Huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "Huh, Paimon thought the work of Outriders was a little different from what you just described, but one thing's for sure... you really like Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010534,
					"content": "Ahem... S—Sorry, I was just rambling on just now. It must have sounded kinda weird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010535,
					"content": "Hehe, it's alright, Collei. Knowing that you're a friend of Amber somehow makes Paimon suddenly feel a lot closer to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010536,
					"content": "So, how did you know that we've met Amber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010537,
					"content": "Well, after I returned to Sumeru, Amber and I have stayed in touch by writing each other letters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010538,
					"content": "In one letter, she mentioned that Mondstadt was attacked by a fearsome dragon, but the city was saved by a mysterious blond traveler and their floating companion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010539,
					"content": "I knew you two were the ones she mentioned in the letter the moment I saw you. But, uh, considering everything you'd been through that day, I thought it'd be inappropriate to bring it up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010540,
					"content": "Ah, so that's how you knew!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010541,
					"content": "Yep! So please know that you two have my complete trust, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010542,
					"content": "I wish I could tell you more about the Dendro Archon, but I had been away from Sumeru for some time, and I haven't read any books... Sorry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010543,
					"content": "That's alright! You've already helped us a lot, we had never even heard of Greater Lord Rukkhadevata or the Sanctuary of Surasthana until you mentioned them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010544,
					"content": "Oh, I'm happy that was helpful. There is one thing I want to ask, though... Why do you two want to know about the Dendro Archon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010545,
					"content": "You explain the purpose of your journey to Collei.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "So that's why you're here. Thank you for telling me your story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010547,
					"content": "Don't mention it! We are friends after all, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010548,
					"content": "Paimon's right, we're friends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "Hehe! Alright, we have a statue to clean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010550,
					"content": "You both have my thanks! While you two are up there cleaning, I'll go ahead and inspect the forest canopy. Let's meet back here shortly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010532,
					"content": "Wow, we've never seen this side of you, Collei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "The avid glider from Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(Does it coincide with Khaenri'ah...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "Shouldn't be a problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
