					"id": 30010609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010610
					]
				},
				{
					"id": 30010610,
					"content": "Huh? Wait a sec! Is it just Paimon, or was there something moving!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010611,
						30010613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010611,
					"content": "You noticed it too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010612
					]
				},
				{
					"id": 30010612,
					"content": "Yeah! It was kinda small and round... You know, like a vegetable or something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010615,
					"content": "It really freaked Paimon out! Whatever it was, we should probably go and investigate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010616,
					"content": "Uh actually, on second thought, maybe we should get to cleaning first. Paimon'll fly up and take care of the top, and you clean everything below.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010617,
					"content": "You and Paimon meticulously clean the statue.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30010613,
					"content": "Like a head of cabbage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010614
					]
				},
				{
					"id": 30010614,
					"content": "Yeah, that's it! Small and round like cabbage... but moving!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010605,
					"content": "Maybe Lesser Lord Kusanali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010606
					]
				},
				{
					"id": 30010606,
					"content": "The name does seem to fit the statue somehow. Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "Paimon"
				}
			]
