			"dialogs": [
				{
					"id": 30010801,
					"content": "Collei, we're back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010802,
					"content": "Welcome back! You must be tired after all that climbing. Let's take a little break.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010803
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010803,
					"content": "Ah, by the way, Collei, have you ever seen any small creatures scurrying around in the forest? You know... that kinda look like a veggie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010804,
					"content": "A creature that looks like a veggie? Hmm... Well, I guess Master would say something like, \"All plants are living organisms, so they also fall under the category of creatures.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010805
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010805,
					"content": "You tell Collei about the thing you saw earlier.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010806
					]
				},
				{
					"id": 30010806,
					"content": "Wow, fascinating! It almost sounds like an imaginary creature that you hear kids always talking about! I'll be sure to keep an eye out for anything like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010807
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010807,
					"content": "Oh, I almost forgot. Are you two hungry? I packed some food and water for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
