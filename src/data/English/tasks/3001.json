				"points": []
			},
			"dialogs": [
				{
					"id": 30011001,
					"content": "Yay, food! What kind of goodies did you bring!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011002,
					"content": "Paimon, some restraint, please...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011003
					]
				},
				{
					"id": 30011003,
					"content": "Hey, don't be a party pooper! It's not like Collei is a stranger or anything. Besides, the best way to compliment a chef is to show passion for their food! Xiangling taught Paimon that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011004,
					"content": "I prepared a nice, portable dish that Forest Rangers like to eat, called Pita Pockets. I hope you'll like them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011005
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011005,
					"content": "Wh—Whoops!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011006
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011006,
					"content": "AH! Nooo!!! You dropped it on the ground!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011007,
					"content": "Not to worry! I wrapped a few layers of oiled paper around each pita. They should be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011008
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011008,
					"content": "Oh, whew... Paimon nearly had a heart attack there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011009,
					"content": "You enjoy the pitas together with Collei.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30011010
					]
				},
				{
					"id": 30011010,
					"content": "Those pitas are amazing! You're quite the cook, Collei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011011,
					"content": "Thank goodness you wrapped them in paper... Paimon wouldn't be able to sleep at night knowing something so tasty had been wasted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011012,
					"content": "Haha, you really know how to compliment the chef, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011013
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011013,
					"content": "Since you liked it so much, I'll be sure to give you a copy of the recipe sometime. I'll even include all my personal cooking pointers, so you'll be making your own Pita Pockets in no time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011014
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011014,
					"content": "Yay thanks, Collei! It's hard to believe someone as diligent as you could have clumsy moments too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011015,
					"content": "Oh, hehe... I guess it happens from time to time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011016
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011016,
					"content": "So uh, Collei... Don't you think that Tighnari's a little too strict with you? He won't let you touch anything without his permission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011017,
					"content": "#Paimon knocks stuff over all the time flying around the Traveler, but {NICKNAME}'s never said anything. Everyone has their clumsy moments!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011018,
					"content": "No no, you've got the wrong idea about Master. Sure, he may seem a bit harsh at first. With some time, you'll see that he's actually very kindhearted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011019
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011019,
					"content": "I've heard the veteran rangers say that Master is from some ancient and mysterious race that is known for their cunning wit and reclusive nature. But Master is actually very kind at heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011020
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011020,
					"content": "Oh, by the way, you've heard of the Akademiya, right? Well, there's a group called Am... uh, Amu something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011021
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011021,
					"content": "Well, anyway, because Master does a lot of research on plants, sages from the Akademiya have written him many times, inviting him to take up an official position there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011022
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011022,
					"content": "But Master declines their offers every time, saying, \"Sumeru City is too noisy. It'd be bad for my ears.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011023,
						30011026
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011023,
					"content": "That does sound like something Tighnari would say...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011024
					]
				},
				{
					"id": 30011024,
					"content": "Haha, seems you already know him well. Anyway, I'm sure the sages were not happy about his responses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011025
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011025,
					"content": "Master could obviously have a bright future in the Akademiya, but he insists on sticking to the path of a Forest Watcher. Every day, he helps the locals of the forest and passes on his extensive knowledge to trainees like me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011029,
					"content": "In fact, Master's the one who taught me how to make Pita Pockets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011030
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011030,
					"content": "Really? Paimon would've never guessed that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011031,
					"content": "Oh, speaking of Tighnari, he was the one who took care of you after finding you passed out yesterday. He even carried you all the way here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011032,
					"content": "Paimon's still kinda upset, though! He kept scolding Paimon the entire way here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011033,
					"content": "What did you do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011034
					]
				},
				{
					"id": 30011034,
					"content": "Oh no, I'm sorry. Master might've been overreacting a little...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011035
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011035,
					"content": "#But it's mostly because Paimon wouldn't stop yelling, \"Why, oh why!? Is {M#he}{F#she} going to die!?\" It probably started to get under Master's skin after a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011036
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011036,
					"content": "Hey! Argh, don't laugh!!! Paimon was genuinely concerned about you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011037
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011037,
					"content": "Pfft! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011038
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011038,
					"content": "Hey! Now even Collei's starting to laugh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011039,
					"content": "Ughhh! That's it! Paimon won't forget this! It's time for some Paimonial wrath!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011040
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011040,
					"content": "No! Don't touch me!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011041,
						30011042
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011041,
					"content": "Huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011043,
					"content": "Oh! Sorry, Collei! Paimon didn't mean to scare you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011044
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011044,
					"content": "Ah, no I just... I—I didn't mean that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011045
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011045,
					"content": "Collei, are you okay? What's the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011046,
					"content": "No uh, I—I'm fine. I'm sorry, I must've startled you both reacting like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011047
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011047,
					"content": "Oh, well it's getting late now. Uh, let's hurry back to Gandharva Ville. I think Master and the others should be back by now, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011048
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011048,
					"content": "Huh, what was up with Collei just now? And why's she in such a hurry all of a sudden...? Look, she's practically running back. Paimon can't even see her now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011042,
					"content": "Collei, what's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011043
					]
				},
				{
					"id": 30011026,
					"content": "Speaking of his ears... I'd really like to pet them!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30011027
					]
				},
				{
					"id": 30011027,
					"content": "Hehehe, I know, right! I've always wanted to pet them, too. Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011028
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30011028,
					"content": "Anyway, Master could have easily left the rainforest to take up a position at the Akademiya. But he chose to stay here instead as a Forest Watcher, helping the locals every day and passing on his knowledge to trainees.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011029
					],
					"speakerTitle": "Collei"
				}
			]
		},
