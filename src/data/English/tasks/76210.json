			},
			"dialogs": [
				{
					"id": 762100101,
					"content": "#Your technique is truly extraordinary, {M#Young Hero}{F#Young Heroine}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Hehe, you bet! {NICKNAME}'s the real deal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "#In that case, I wonder if this {M#Young Hero}{F#Young Heroine} might demonstrate the true essence of <color=#00E1FFFF>Leaping Techniques</color> for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "According to the records, the ancient masters of my sect, the Guhua Clan, could scale city walls as if they were walking on flat ground. Having truly mastered the art of roof-running and wall-scaling, they distilled these skills into the Leaping Techniques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "Incredible!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Hmm... We might as well give it a shot. You've done plenty of climbing around looking for treasure anyway, haven't you, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "Sounds like cat burglary to me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#Hehe, come to think of it, {M#Young Hero}{F#Young Heroine}. If a thief can skip over a wall to escape justice, but we who uphold it cannot, wouldn't that leave us powerless to stop the wicked from slipping away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
		{
			"id": 7621002,
			"completionStepIds": [
				7621005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
