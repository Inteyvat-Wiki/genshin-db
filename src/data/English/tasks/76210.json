				]
			},
			"dialogs": [
				{
					"id": 762100617,
					"content": "With a swift leap, the figure from the painting lands right in front of you...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762100601
					]
				},
				{
					"id": 762100601,
					"content": "#Greetings. I'm Zhangsun Jijing. It's an honor to meet you in person, {M#Young Hero}{F#Young Heroine}. {M#Young Hero}{F#Young Heroine}, may I ask why you have called out to me? Do you have urgent matters to discuss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100602
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100602,
					"content": "Uh, nothing like that. We just saw you hopping all over the place inside the painting and got a bit curious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100603,
					"content": "Ah, I see. I was merely practicing my lightfoot techniques. That said, I'm afraid I've treated you to a rather poor display.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100604
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100604,
					"content": "Lightfoot techniques?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100605,
					"content": "Indeed. You see, since rain never falls in this realm, I'm unable to practice the \"Rain Cutter\" arts passed down by my master. Not wishing to let my skills wither from neglect, I've resorted to training in this manner instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100606
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100606,
					"content": "I often think of those bygone days, when the Great Master Guhua honed his agility upon these very stone piles, eventually reaching the pinnacle of his art. We juniors are of meager talent, yet we strive to imitate even a fraction of his brilliance, hoping for the slightest bit of progress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100607
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100607,
					"content": "#{M#Young Hero}{F#Young Heroine}, since fate has brought us together today, and seeing as you are a fellow practitioner of martial mastery... might I ask you to enlighten me with your skills?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100609,
						762100611
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100609,
					"content": "Hmph, just as I'd hoped. Thou shalt witness my skill!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100610
					]
				},
				{
					"id": 762100610,
					"content": "Whoa! Why are you speaking so weirdly all of a sudden? Anyway, uh, what exactly are we supposed to do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100614
					],
					"speakerTitle": "Paimon"
				},
