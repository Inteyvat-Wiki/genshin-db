			"dialogs": [
				{
					"id": 762100301,
					"content": "Have a look at this — our \"Plumwatcher Piles,\" the pride of Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "May I ask you to step on the stone piles in the order I specify within the allotted time, thus demonstrating your prowess?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "No problem, it'll be a walk in the park.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Though there sure are a lot of \"parks\" to walk across... Uh, never mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "#Well then, {M#Young Hero}{F#Young Heroine}, it's time to display your prowess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "Actually, I bet even Paimon, the master of the Paimon Clan, could pull it off...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "What!? That's impossible, no matter how you... Wait. Paimon probably could... but flying would be cheating, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
		},
