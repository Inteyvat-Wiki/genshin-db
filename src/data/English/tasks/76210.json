				]
			},
			"dialogs": [
				{
					"id": 762100201,
					"content": "Truly awe-inspiring. I'm deeply impressed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "#That being the case... I have one more humble request. I wonder... Have you, {M#Young Hero}{F#Young Heroine}, heard of the <color=#00E1FFFF>Cloud-Striding Techniques</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Rumor has it that our Grandmaster, Guhua, once ascended the heavens amidst a purple haze, treading upon the very air as if it were solid ground — all made possible by none other than this legendary secret art...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Sounds a bit far-fetched to me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "Yeah, sounds like some real hogwash... But come to think of it, could we pull off something similar by using a Wind Glider?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "Oh? Then might I ask you to show me a thing or two?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "If we could use the Wind Glider...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
