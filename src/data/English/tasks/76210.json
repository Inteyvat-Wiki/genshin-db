					"content": "Fascinating...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100502
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100502,
					"content": "#One could not call that \"treading upon air,\" but you have inspired me all the same. My thanks for your guidance, {M#fine sir}{F#young heroine}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
