				]
			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "As expected — just another pathetic soul who can't stop repeating the same mistakes. I have to say, I'm a little disappointed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150302,
					"content": "He stopped himself from doing wrong for so many years, but in the end... Does this mean bad people can't mend their ways?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150303,
					"content": "It's harder to keep doing good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Every decision was his to make. Even just now, he could have chosen to admit his mistakes. But he chose violence instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150306,
					"content": "Every move was poorly made, and every one led him to this end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150307,
					"content": "#But enough about him. Here's to a job well done. {NICKNAME}, you can take the bounty proof to Leszek, as arranged.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150308,
					"content": "It was great to have you two take the reins! I could've sworn I was on a vacation today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150309,
					"content": "Hehe, and now that it's over, I think it's about time to get started on your next job, right, Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150310
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150310,
					"content": "Ehhh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150304,
					"content": "He made some poor decisions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				}
			]
		}
	]
}