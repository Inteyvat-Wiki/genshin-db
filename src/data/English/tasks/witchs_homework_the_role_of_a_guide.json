			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1731.516,
							309.11,
							-1602.524
						],
						"pointId": 300100573
					},
					{
						"sceneId": 3,
						"position": [
							1730.843,
							309.134,
							-1602.502
						],
						"pointId": 300100574
					}
				]
			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "Leaving already? Hey, Barbie! Aren't you forgetting something? Like a whole bunch of stuff you were supposed to give...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590102,
					"content": "...me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590103,
					"content": "Is this a bad time...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "Nonsense, your arrival is more or less in line with Barbie's prophecy... Though to be honest, I did think you'd be here a little later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590106,
					"content": "Anyway... Before we get down to business, it might be best if you two... have something to eat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590107,
					"content": "D—Did Barbeloth's prophecy say we'd be hungry?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "No, of course not! But my hearing happens to be quite sharp, and I heard Paimon's stomach rumbling a mile away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590110,
					"content": "*rumble* *rumble*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590111,
					"content": "Whoa! Paimon's stomach is rumbling for two... We must both be super famished...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590112,
					"content": "How was I supposed to know that place would run out of steak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "Don't you worry about that! I've got plenty of cookies and cake — and as you know, nothing bad ever happened to hungry travelers who accepted food from a \"witch\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590115,
					"content": "You and Paimon munch happily on cookies and cake while gulping down tea. Strangely, no matter how much you eat or drink, the teapot remains half full, and there is always a fresh cookie and slice of cake on your plates...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "Paimon's so full... No matter how much she puts in her tummy, there's always more on her plate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590117,
					"content": "Is this what mages' tea parties are like...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "Of course! You can't have a tea party without an ample supply of food and drink.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590119,
					"content": "Though it's true, it is hard to display an appropriate \"magely\" elegance after stuffing one's face. That's why the teapot is usually only half full, and there's only one cookie or piece of cake on each plate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590123,
					"content": "Paimon really can't eat any more! She's coming apart at the seams... Can we get down to business now? *burp* Oh... well, sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590124,
					"content": "Alright. I gather you're here to deliver my \"homework\" — the one that Barbie prophesied?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590125,
					"content": "You knew all along...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "Nothing of the sort. We were discussing something completely different. The moon's massive shift has knocked her hydromancy out of whack, so she needs to head back for a while to undergo a period of silent meditation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590128,
					"content": "While she's away, I'll be taking over responsibility for everyone's homework. I also plan to help her add the next round of homework to the dictionary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590129,
					"content": "Huh? You can just swap the person in charge like that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590130,
					"content": "Well, if anyone can do it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "Not like I had much choice! Before Barbie and Alice even told me about it, they'd already inscribed my \"special homework\" in the dictionary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590133,
					"content": "As much as I'd like to erase the whole thing and keep on casually observing the world, Alice is busy maintaining Teyvat's borders, and Barbie is off realigning her hydromancy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590134,
					"content": "Octavia didn't bother to come back, and you can forget about Rhinedottir... The other mages all have their own affairs to attend to, so the duty of supervising this homework has fallen to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590135,
					"content": "I didn't realize the Hexenzirkel was so busy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "There really are. I don't even know how long it's been since we all got together to make this a proper tea party.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590138,
					"content": "In any case, as long as I finish my homework, my story will be officially inscribed in the dictionary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590139,
					"content": "#After that, I'll be able to go back to observing and guiding... So, {NICKNAME}, Paimon, it's time to deliver your message — what's my homework?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590140,
					"content": "Oh, and since this doesn't count as a prophecy — just something Barbie and Alice came up with ten minutes ago — there probably isn't any useful information to be found in that dictionary you're carrying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590141,
					"content": "You're right, Nicole! We had a look before coming over, and there aren't any detailed instructions at all. There's only these two sentences...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590142,
					"content": "\"Nicole will fulfill her duty.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "Alright. That first sentence was clearly written by Barbie, but I'd bet my bottom Mora it was Alice who added the second.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590146,
					"content": "Anyway, let's get cracking on this homework! Just let me think, where should we begin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590147,
					"content": "Hold on, you actually understood what they want you to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "Huh? Oh, Barbie gave me a rundown of my tasks just now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590150,
					"content": "Basically, I just need to go to a few homework locations, make sure everything's up to scratch, and conduct some fieldwork.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590151,
					"content": "Wait a minute! Paimon thought she was giving you a prophecy? How does a \"rundown\" count as a prophecy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590152,
					"content": "Ah, well, you see, I naturally view anything Barbie says to me as some sort of prophecy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590153,
					"content": "Besides, when Barbie wrote this homework of mine, all she actually did was flip straight to the final page of my story and tell me the ending in advance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590154,
					"content": "Isn't that a massive spoiler!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "Hmm... You make a fair point, but then what's the difference between a prophecy and a spoiler anyway? Alright, enough dawdling — come on, follow me. We're going to... Hmm, yes, that seems like as good a place as any...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590159,
					"content": "Just like that? Hold on, how are we supposed to get the—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590160,
					"content": "In the blink of an eye, you find yourselves standing at the edge of a cliff...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "Does this mean I came here for nothing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "What do you mean? This homework had to be delivered by you — that's a very important step. Certain formalities must be observed in order for homework to count.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590158,
					"content": "But we can talk about that later. Anyway, enough dawdling — come on, follow me. We're going to... Hmm, yes, that seems like as good a place as any...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590148,
					"content": "I didn't understand a word of it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "\"She definitely won't allow you to work for free!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "That's all there is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "Now you mention it, there's quite a lot of you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "...It's Nicole!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "So just now, Barbeloth was...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "We'll have to bring Varesa next time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "Is she the champion eater from Natlan's Collective of Plenty? Alice mentioned her to me once — apparently, she's a fascinating young lady.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590122,
					"content": "I imagine if she were to attend one of our parties, we'd need to set out three... maybe even seven plates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590113,
					"content": "We ate all that salad, but it just felt like a bowl of green air...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "Is hunger something that can be prophesied, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "Maybe we should come back later...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
		{
			"id": 7615902,
