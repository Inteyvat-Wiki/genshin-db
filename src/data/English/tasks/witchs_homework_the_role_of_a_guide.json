			},
			"dialogs": [
				{
					"id": 761590301,
					"content": "Is this Wolvendom? Doesn't seem like the best place for doing \"homework\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590302,
					"content": "This is the nearest Seelie Court to where we're going. Don't worry, we're not far from the starting point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590303,
					"content": "Whoa! Where did all those wolves jump out from!? Hey... We're not here to hurt you! We're friends with Razor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590305,
						761590306
					],
					"speakerTitle": "Wolf Pack"
				},
				{
					"id": 761590305,
					"content": "The wolves have gone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				},
				{
					"id": 761590307,
					"content": "Shh. Has that child not arrived yet? Perhaps we've come too early again. Not to worry, as long as he stands beside his \"lupical\", he can overcome any foe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590309
					],
					"speakerTitle": "Wolf Pack"
				},
				{
					"id": 761590309,
					"content": "Why've they come back? Did they hear us talking? If only Razor were here, he'd be able to tell us what they want to say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590310,
					"content": "You're not wrong, Paimon, but there's a lot more he'd need to understand than just the chatter of wolves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590311,
						761590312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590311,
					"content": "Hey, isn't this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590313,
					"content": "That's right. That child already claimed victory in the battle he was destined to fight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590314
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590314,
					"content": "As long as he stands beside his \"lupical\", I believe he can overcome any foe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590316
					],
					"speakerTitle": "Wolf Pack"
				},
				{
					"id": 761590316,
					"content": "...I'm sure his lupical feels the same way, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590317,
					"content": "Alright! That's about it for this place. I could do with a good rest. Come on, let's go. Time to head back for a cup of—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590318
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590318,
					"content": "Whoa! When did this door appear!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590319,
						761590320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590319,
					"content": "There's a note stuck to it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590321,
					"content": "This looks like Alice's handwriting. Let's take a look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590322,
					"content": "\"Thanks for your help with the homework! Now hurry home and have a hot cup of tea!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590323
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590323,
					"content": "\"P.S. There is a surprise waiting behind this door!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590324,
					"content": "Hurry home? Wait a second, why does this door look so familiar? There's no way it could lead to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590325,
					"content": "Nicole pushes the door open, then strides through purposefully as you follow. A moment later, you find yourselves standing inside a room...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590320,
					"content": "This style... It feels familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590312,
					"content": "Razor and I once fought here together.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590306,
					"content": "I don't suppose this homework is for...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				}
			]
		},
