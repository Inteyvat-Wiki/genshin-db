			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Urubamba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "Yoohoo— Come back now, little ones! Yooohoooo—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "Hello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "Yoooohoooo— *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "I feel awful. So... sad. How can I... make it better...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "Ugh, I step out for one moment to buy some hay, and now I have no idea where my other eight little Tatankasaurs have run off to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "They're still so small! What if they get bullied by hilichurls... or lost... or trapped somewhere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "Kind soul, is there any chance you've seen my little Tatankasaurs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "What do they look like?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "I raised their mother, you know. She's practically my daughter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "She's one of the most stunning saurians in the whole of the Collective of Plenty. She even won the grand prize in our regional beauty pageant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "Those eight little rascals all inherited their mother's good looks. They've got fair, pink skin, with a dash of purple on their perfectly symmetrical fan-shaped horns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "If you see them, please help me get them back here. I'm counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "My little saurians... I promise I won't be so strict with you anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "I'll keep an eye out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "Thank you, kind soul. May your bench press today hit a new personal best and your pull-ups stay cramp-free!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
