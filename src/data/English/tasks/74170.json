			"dialogs": [
				{
					"id": 741700213,
					"content": "Anyway, who is Kuisel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "I don't know either. I don't recall anyone by that name at the Fontaine Research Institute... Perhaps, as far as he's concerned, it's better that nobody by that name exists?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Just like he said himself, Kuisel was just a convenient character. The more different that character was from himself, the better, as it made it less likely anyone would recognize him... Although that's just a guess of mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "*sigh* If you ask me, though, I think he changed enough over the years as it is. I didn't recognize him at first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
