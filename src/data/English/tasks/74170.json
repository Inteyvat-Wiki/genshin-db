					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "Oh, you're back. Well, and so am I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701702,
					"content": "After the Institute heard my brief report, I was asked to assess the area for suitability as a quality development training ground alongside conducting my retrieval work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701703,
					"content": "*sigh* This all feels very familiar, somehow. I remember that there was a period of time when our Administrative Officer was very big on getting everyone to do diving training as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701704,
					"content": "I personally think that it's all rather pointless, but work is work, I suppose, and a mission is a mission... Not to mention how this place is rather strange... I mean, unique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701705,
					"content": "As such, I've placed a few replica anchors in the area. Don't worry, they're just dummies. They're one-hundred-percent safe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701706,
					"content": "The content of the current training is to <color=#00E1FFFF>retrieve all the anchors inside the building within the time limit</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701707,
					"content": "Would you like to give it a go? I can give you some compensation for taking part — you'll be assisting in research, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7417004",
