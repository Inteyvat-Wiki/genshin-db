			"dialogs": [
				{
					"id": 741700217,
					"content": "Leaving the challenge aside, what about the devices here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700218
					]
				},
				{
					"id": 741700218,
					"content": "It's puzzling, isn't it? It seems like he's made... uh... various modifications to this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Now it feels more suited to some ancient ruins that tourists might visit... Although perhaps it isn't too prudent to say it like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "*ahem* The aforementioned viewpoint is only my personal opinion, and is not representative of the Fontaine Research Institute or its viewpoints.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
