			"dialogs": [
				{
					"id": 741700210,
					"content": "Never mind the challenge first. What happened to Coutrot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Just being kicked out of the Fontaine Research Institute didn't bring him to his senses. He really is pigheaded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "But nobody is backing him now, so you can relax. He can't cause any more trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
