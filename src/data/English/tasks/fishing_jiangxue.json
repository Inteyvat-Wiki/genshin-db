				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "I hope I catch something eventually...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040102,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "Preparing to reel in the biggest catch you've ever seen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040104,
					"content": "I have a friend who enjoys cooking. If I catch a nice big fish for him, I bet it'll make him happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040105,
					"content": "The only thing is, monsters keep stirring up trouble here, which disturbs the fish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040106,
					"content": "I sense strong elemental power in you. Would you be willing to deal with the monsters for me, so I can finally catch that fish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040107,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040112,
					"content": "But how do you know when the monsters will get here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040113,
					"content": "Seeing is believing. Look out behind you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040114,
					"content": "Hah! That's the oldest trick in the book—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040109,
					"content": "How can you tell?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "I once had a Vision, too. I don't bother using it anymore, but I can still sense elemental power when I want to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040111,
					"content": "With the power of the elements on your side, these monsters should be a piece of cake for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200405",
							"2"
						],
						"stepId": 2200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "You... you got them! But Paimon didn't see you lift a finger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040302,
					"content": "Who ARE you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040303,
					"content": "Just a fisherman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040304,
					"content": "Hmm... This doesn't add up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "You're right, it doesn't. Lots of things in this world don't add up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040306,
					"content": "The chef from the inn, for example. He used to be a sword fighter, now he loves to cook. He's stony-faced but has a heart of gold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040307,
					"content": "And the boss. She's a Mondstadter, but nobody from Mondstadt knows her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040308,
					"content": "And... you. You don't have a Vision, yet you can still use elemental power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040309,
					"content": "Some things don't add up, but that doesn't always mean they are to be feared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040310,
					"content": "Take these as a token of my thanks. I want to carry on fishing now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
}