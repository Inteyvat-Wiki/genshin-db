			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200500101,
					"content": "Ugh, what a headache... What am I supposed to do about this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500102,
					"content": "What are you up to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "Practicing for the Knights of Favonius' tryouts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500104,
					"content": "*sigh* But I'm nowhere near as powerful as Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500105,
					"content": "I think it's better for me to focus on technique rather than power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500106,
					"content": "For example, I was thinking about how to break all these wooden dummies in one fell swoop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500107,
					"content": "If you're at a loose end, fancy helping me think about how to tackle it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500108,
					"content": "I'll mull it over.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "Sure, take your time. It's not like these dummies are going anywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500111,
					"content": "Nor is my life going anywhere while I'm stuck trying to sort this out, ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500114,
					"content": "I've heard that the elements interact in special ways. I wonder if there's a way we can use the fire on this brazier to cause a little explosion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500115,
					"content": "But first there needs to actually be a fire in the brazier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500109,
					"content": "How about we give it a go together...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "You like team combat, then? Alright for some... always someone to help you out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500113,
					"content": "For people like me, the best I can do is try and hold my own as a lone fighter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2005002,
			"completionStepIds": [],
