						220400302
					]
				},
				{
					"id": 220400302,
					"content": "Kimono patterns? I'm afraid I don't know anything about that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400303
					],
					"speakerTitle": "Tang Wen"
				},
				{
