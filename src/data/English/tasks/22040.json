					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400610
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400610,
					"content": "Traveler, I'm sure that you've seen a great deal in your journeys. May I ask if you've ever encountered any designs that you might consider \"novel\"?",
