					"nextDialogs": [
						220400504
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400504,
					"content": "Books and... tea sets? That sounds interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400505
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400505,
					"content": "But how should we make them exactly? Hmm, I need to give this a bit more thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400506
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400506,
					"content": "Thank you, Traveler. This information has proved extremely useful to me. Please, accept these as a token of my appreciation.",
