			},
			"dialogs": [
				{
					"id": 220400101,
					"content": "This is no way to continue doing business...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400102,
					"content": "Is something the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "Ah, I'm sorry. I was just a little lost in my own thoughts. Are you here to buy some clothes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400104,
					"content": "The high-class silks from Liyue remain out of stock, but we still have the latest kimonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400105,
					"content": "You used to import material from Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "Yes. Before, we were often able to secure high-end silk from Liyue such as those that the Feiyun Commerce Guild makes from Silk Flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400107,
					"content": "But with the current situation here, we haven't been able to import that sort of silk in a while now. We've been having to rely on our existing stock to continue operations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400108,
					"content": "Every bolt of silk we use here is one we're not getting back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400109,
					"content": "I originally planned to design some novel kimono patterns myself, or use some new dyes to make new cloth and attract customers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400110,
					"content": "But I can't think of anything that might be considered a \"novel\" pattern...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400111,
					"content": "Traveler, you've seen a lot, I'm sure. Have you encountered any designs that you might consider \"novel\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400112,
					"content": "I wouldn't say so, exactly...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "Ah, I see. Um, this might be rather presumptuous of me, but... could you help me ask other outlanders about patterns that we could use?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400114,
					"content": "I'm the only one running Ogura Textiles & Kimonos at the moment, so I can't leave the store. If I want to gather information, I can only ask others to do it for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400115,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "Great, let me think... You should go ask Miss Tang Wen and Mr. Ramsay. Perhaps they will have some new ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
