			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732750102,
					"content": "The Golden Roses have sprouted into seedlings, yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "These seeds... Where did you even find these seeds, I wonder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "From a far-off place.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Did you indeed? Well, I suppose that the seeds Uncle Shafaqat sowed really did find their way back here in the end after being spread to every corner of the desert — even if the path they took meandered quite a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "We'll have to take good care of these seedlings — I intend to leave them to young Sabbah. Once I, too, am gone, these flowers shall pass on to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "Thank you, child. There is little I can give you... but please accept these fruits and flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
