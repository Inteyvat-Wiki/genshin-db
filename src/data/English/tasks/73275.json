					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732750501,
					"content": "So, about the folk song...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "Ah, so you've remembered it, eh? Well, that makes one more young person who knows it. Good, good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "\"Rose, oh rose, grant me my wish. Blooming from the stone, the Golden Rose sang to me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "\"No land but folk songs bore my spirit. Songs shall defy my fate, and overcome my destiny.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "\"They will surpass me, surpass time. They will surpass the ever-lasting withering of life...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
