			"dialogs": [
				{
					"id": 250270501,
					"content": "How did it go? Did they have any feedback?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270502
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270502,
					"content": "I've heard these opinions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270503
					]
				},
				{
					"id": 250270503,
					"content": "You convey the customer feedback to Milu Nui...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250270504
					]
				},
				{
					"id": 250270504,
					"content": "A—Ah. Is that how things are? Thank you, the feedback is quite valuable. Let me see what I can change...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270505
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270505,
					"content": "Still, from the sound of it... aren't they all treating my records like kids' songs!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270506
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270506,
					"content": "...No, no, all the more reason to make some changes... Still, where do I begin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
