			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haloa Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "Ooh, a new record! The baby Saurian's gonna love this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270302,
					"content": "Tell me about Milu Nui's music...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "I love Uncle Milu's songs — and really, the baby Saurian we have back home loves them more than I do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270304,
					"content": "Whenever it gets too rowdy, Mom plays one of his songs, and then it quiets down real quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270305,
					"content": "Hmm... Those songs are super long, though. I can barely remember the lyrics, let alone sing 'em for it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270306,
					"content": "Hehe, if he could write some songs with fewer lyrics, I'd be able to sing them every day for that kid's listening pleasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haloa Nui"
				}
			]
		},
