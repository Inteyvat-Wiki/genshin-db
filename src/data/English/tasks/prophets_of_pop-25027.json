			"dialogs": [
				{
					"id": 250270401,
					"content": "Look at those birds, listen to their cries! My, oh my, if those wouldn't make excellent material for my next work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Still, things could get pretty one-note if we only recorded a few of them. If we could find a whole flock and record the sound of their collective calls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "Hang on, that's a Koholasaurus just up ahead. You hear how it scratches the stone with its claws?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "Koholasaurs are the sensitive sort, so let's not get too close. I'll get some professionals from our tribe to gather what I need afterward — if anyone can pull this off, it'd be them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Oh, ho... warriors testing themselves against one another. Good, good, the sounds of battle are lovely indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "Oi! What're you skulking about for? You here for a fight?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Angry Tribal Warrior"
				},
				{
					"id": 250270407,
					"content": "We're just... gathering materials...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270408,
					"content": "Gathering? Well, I'll show you \"gathering\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270409
					],
					"speakerTitle": "Angry Tribal Warrior"
				},
				{
					"id": 250270409,
					"content": "#H—Help! {NICKNAME}, stop him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
