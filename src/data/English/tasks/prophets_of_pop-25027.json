			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mahina Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "Mr. Milu's released a new record! Should I buy it or not...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "Tell me about Milu Nui's music...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "Hmm? Oh, he's great! Haloa and the baby Saurian love it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Every time they get all rowdy and stubborn and don't wanna sleep, I'll play them Mr. Milu's \"Spring-Day Song.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "As soon as they hear it, they're asleep in no time — voila, sweet dreams, see you tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "Still, though... Haloa has been saying that she'd prefer something a bit more intense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "If Mr. Milu could come up with a couple of tunes with a bit more energy, I'm sure she'd have more fun with 'em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
