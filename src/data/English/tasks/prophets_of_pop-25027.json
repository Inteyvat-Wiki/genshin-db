			"dialogs": [
				{
					"id": 250271401,
					"content": "...Milu's style is the same as ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271402
					],
					"speakerTitle": "Tirda"
				},
				{
					"id": 250271402,
					"content": "Tell me about Milu Nui's music...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271403
					]
				},
				{
					"id": 250271403,
					"content": "Hmm? Oh, I love his style of composition. I listen to his songs after work. Really helps me relax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271404
					],
					"speakerTitle": "Tirda"
				},
				{
					"id": 250271404,
					"content": "But if you asked me personally, I'd call his lyrics... a bit, well, overly complex.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271405
					],
					"speakerTitle": "Tirda"
				},
				{
					"id": 250271405,
					"content": "*sigh* I wish he'd make a record without lyrics, y'know? Only instrumental tracks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirda"
				}
			]
		},
