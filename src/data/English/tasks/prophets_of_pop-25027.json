			"dialogs": [
				{
					"id": 250271301,
					"content": "#Phew! You're quite the dab hand yourself, aren't you, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271302
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271302,
					"content": "You seem good at persuading the more agitated types...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271303,
						250271305
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271303,
					"content": "That wasn't even my full power.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271304
					]
				},
				{
					"id": 250271304,
					"content": "I could tell. In every possible aspect... it is quite obvious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271307
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271307,
					"content": "Well, that was quite the adventure, but either way, I've selected plenty of sounds to sample.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271308
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271308,
					"content": "After just a bit of prep work, I'll be able to officially start recording the audio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271309
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271309,
					"content": "Hmm... We should start with the \"sounds of battle\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271310
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271310,
					"content": "Wait, no. That's not a good place to begin. We should open up with something more normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271305,
					"content": "I thought it went okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271306
					]
				},
				{
					"id": 250271306,
					"content": "That's very modest of you. Thank you, in any case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271307
					],
					"speakerTitle": "Milu Nui"
				}
			]
		},
