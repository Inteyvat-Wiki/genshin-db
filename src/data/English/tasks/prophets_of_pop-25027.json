			},
			"dialogs": [
				{
					"id": 250270901,
					"content": "You could try gathering some sound samples...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "Sounds...? Oh, do you mean to say that we could sample the sounds of nature and use them directly in the songs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270903,
					"content": "Hmm... That does sound like a good idea. Yes, very good indeed! See, I knew you were a sharp shovel! Come on, let's get going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270904,
					"content": "Wait, you're not bringing anything with you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "Of course not. Or are you expecting me to drag a gramophone around out there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270906,
					"content": "Don't worry, we're just going to see what sorts of sounds we can use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270907,
					"content": "A duck flapping its wings, for instance, or the splash made as a Koholasaurus hits the water, or the rumbling footsteps of a Tepetlisaurus walking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270908,
					"content": "Once we've selected out targets, I'll make the preparations to take those sound samples... but that's all for later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270909,
					"content": "As for the here and now, let's head out — time's a-wasting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
