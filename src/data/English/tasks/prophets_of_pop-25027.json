					"nextDialogs": [
						250270702
					]
				},
				{
					"id": 250270702,
					"content": "Well, that... I don't disagree, and I've actually made some inquiries myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270703
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270703,
					"content": "But it feels like they just default to pleasantries when they see me, so I never get to hear their honest opinions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270704
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270704,
					"content": "#{NICKNAME}, could you help me ask around instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270705
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270705,
					"content": "I imagine they'll... feel more comfortable being honest with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
