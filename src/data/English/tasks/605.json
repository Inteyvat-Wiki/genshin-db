			"dialogs": [
				{
					"id": 6050201,
					"content": "Fantastic job defending this place, you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050202,
					"content": "We'll take it from here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050203,
					"content": "Captain Kaeya, Swan is—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6050204,
					"content": "Hey! I'm fine. It's your leg we should be worried about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050205,
					"content": "Swan, Lawrence, you should both get treated at the Church. Don't push yourselves. We'll take care of things here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050206,
					"content": "But, Master Diluc... Didn't you leave the Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050207,
					"content": "What, are Knights the only ones capable of defending this gate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050208,
					"content": "It's fine. Master Diluc is just... altruistic as always. If a civilian is willing to help out, who are we to turn him away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050209,
					"content": "...Understood. We're grateful for the support.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050210,
					"content": "Yeah, thanks a million! We'll be back soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6051104,
					"content": "I have some spare time right now, so I was planning to make some potions to help the people fighting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 6051105,
					"content": "A sound plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051106,
					"content": "Remember to be careful. I know it's unlikely, but if you encounter a situation you can't handle, retreat to somewhere safe. Don't worry about the front line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051107,
					"content": "Understood!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
