			"dialogs": [
				{
					"id": 400315201,
					"content": "Leave what comes after the animals are found to me. I will take them home as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315202,
						400315207,
						400315210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315202,
					"content": "What can you tell me about the Black Shadow?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315203
					]
				},
				{
					"id": 400315203,
					"content": "I've heard tell of a secret organization that trains ninken, or ninja dogs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315204,
					"content": "They say that one such dog, code-named Inujin, destroyed countless monsters that threatened Inazuma in the shadows...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315205,
					"content": "...Of course, this is just a legend. Still, I wonder if this Black Shadow could be the legendary ninken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400315206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315206,
					"content": "Whatever. I shouldn't make excuses for my defeat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400315207,
					"content": "So, tell me about those distractions you set up...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400315208
					]
				},
				{
					"id": 400315208,
					"content": "I was unable to save the animals while evading its case, but while I was casing the joint, I did find the time to place a few smoke dispensers nearby.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
