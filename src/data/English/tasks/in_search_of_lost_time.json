						],
						"pointId": 6373
					}
				]
			},
			"dialogs": [
				{
					"id": 740411401,
					"content": "#Here we are, {M#sir}{F#lady}! This is the central processing station, where our hydrology research data is analyzed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411402,
						740411403
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411402,
					"content": "It doesn't look like anyone's here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
					]
				},
				{
					"id": 740411404,
					"content": "Without any Fatui, we're not needed, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411405,
					"content": "We can't be sure yet. What if there are soldiers from Snezhnaya inside? I might not be able to see Conch Madeleine again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411406
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411406,
					"content": "Ahem, I mean, I shan't ever conduct hydrological research again! Please, go inside with me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411407
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411407,
					"content": "Fine. Just open the door...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411403,
					"content": "Can I go now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
					]
				}
			]
		},
		{
			"id": 7404115,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
