			},
			"dialogs": [
				{
					"id": 790580101,
					"content": "This is a cut scene from the show \"The Great Escape\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790580102,
					"content": "The original story was about a Hydro Eidolon trapped in a mysterious cave, who could only use the tools hidden within a tome to escape to freedom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790580103,
					"content": "But Idyia outright rejected the idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790580104,
					"content": "But she had a point, Hydro Eidolons wouldn't need tools to escape a cave, they could just leave whenever they wanted. Also, hiding tools in a book was a bit contrived.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790580105,
					"content": "But... this is definitely a blockbuster idea! If only Idyia could see just how brilliant it is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790580106,
					"content": "But, alas, first the <color=#00E1FFFF>tome containing the tools stolen by hilichurls</color> must be retrieved...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Scene Notes"
				},
				{
					"id": 790580107,
					"content": "— The Director",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scene Notes"
				}
			]
		},
