			"dialogs": [
				{
					"id": 401499701,
					"content": "Back when I was on the expedition with the Grand Master, I was often put in charge of cooking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499702
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401499702,
					"content": "Under the circumstances, I could only cook some pretty crude meals... But everyone still enjoyed them a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499703
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401499703,
					"content": "Maybe \"passion\" was the secret ingredient then, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				}
			]
