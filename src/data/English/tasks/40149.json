				]
			},
			"dialogs": [
				{
					"id": 401490301,
					"content": "#There you are, {NICKNAME}! Thank you for all of your hard work over the past few days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490302,
					"content": "My pleasure... assuming I'm still being paid, that is?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "Hahaha, straight down to brass tacks, are we? Here, take it. I've thrown in a little extra as well — call it a bonus. Hard work is rewarded here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490304,
					"content": "Yay! It's like all the tiredness and stress have suddenly melted away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "I'm just lucky you only worked this job for a few days. At the rate you were progressing, a few more weeks and I think I might be made redundant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401490306,
					"content": "Well, I for one look forward to enjoying your cooking many more times in the future.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Haha, anytime! Bring some friends with you next time, and I'll show you all what Smiley Yanxiao can do when working with both hands intact!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401490308,
					"content": "Great! Although... just to be on the safe side, cook carefully in the meantime! You may have just jinxed it again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
