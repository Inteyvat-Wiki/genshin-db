						],
						"pointId": 310400533
					}
				]
			},
			"dialogs": [
				{
					"id": 401490401,
					"content": "Anything goes, huh? Oh dear... This is a chef's worst nightmare. With no idea of your customers' palates, you're left to make a wild guess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490402
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401490402,
					"content": "Still, now that you've worked in the kitchen for so many days, I have faith that you'll be able to figure it out. Go on, show them what you've got!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490403
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 401490403,
					"content": "(Let me think... What do they like? What could they be craving?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
