			"dialogs": [
				{
					"id": 401499601,
					"content": "I'm sorry! I really can't think of anything off the top of my head... I mean, I could pick from the menu at random, but I'd feel more comfortable leaving the chef to choose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499602,
					"content": "Oh, one thing — I know I said I don't mind what we have, but no alcohol, please. Neither of them can drink... it's a real pity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499603
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401499603,
					"content": "I—I've still got some sparkling water here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
