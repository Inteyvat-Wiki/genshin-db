					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401499401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499402,
					"content": "Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499403
					]
				},
				{
					"id": 401499403,
					"content": "...Ah, sorry. I zoned out just now — didn't see you coming.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499404,
					"content": "Got something on your mind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499405
					]
				},
				{
					"id": 401499405,
					"content": "Yeah... That food you cooked for us just now — it reminded me of the meals my grandfather used to make for me. I thought I'd forgotten how they tasted, but it all came rushing back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499406,
					"content": "He used to make Liyue dishes all the time. I'd do my Outrider training with him until the evening, and then wait patiently at the dinner table...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499407,
					"content": "...I'd sit there, with the smell of delicious food wafting in from the kitchen, waiting for him to finally emerge with the goods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499408,
					"content": "Sometimes we'd have Eula around for dinner, and even though she'd always find something to complain about, I could tell she really enjoyed the food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499409,
					"content": "Ah... so maybe she remembers, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				},
				{
					"id": 401499411,
					"content": "...Your words, not mine. Don't ask her about it — she'll only give you another earful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499410,
					"content": "And maybe that's why she suggested you come here for dinner?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				}
			]
		},
