			"trigger": {
				"objectNames": [
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "Traveler, great timing! I was just looking to ask you something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280102,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "He said that the journey is going to be a long one, and that we'll need some medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280106,
					"content": "Stuff for headaches, diarrhea, heatstroke, hangovers, stuff to help digestion... There's just a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280107,
					"content": "Actually, why do they need stuff for hangovers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "It's probably for business negotiations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "Eh? What does hangover medicine have to do with business deals? It's not like business will boom the more you can drink, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "Whatever the case, Dad wants me to go to Bubu Pharmacy to ask if the medicines have been prepared yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280111,
					"content": "Could you accompany me there? There's something I'd like to ask you for help with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280112,
					"content": "Let's go, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "C'mon, let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280113,
					"content": "What's the thing you need help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "We'll talk about it when we get there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280103,
					"content": "How are the preparations going?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Well, it's mostly Dad and his friends preparing... But Dad's also given me a task!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
		{
			"id": 2102802,
			"completionStepIds": [
				2102803
			],
