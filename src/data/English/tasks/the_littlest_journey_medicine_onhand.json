			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herbalist Gui",
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Welcome. Are you here to procure a herbal remedy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280202,
					"content": "...Little Meng? What brings you here today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280203,
					"content": "...Oh, right. I remember now. You're here about those medicines, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280204,
					"content": "Don't worry, they're almost all ready. I'll send them to your father in batches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280205,
					"content": "That said, his order has drained our reserves of herbs, so some of those medicines will only be ready later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280206,
					"content": "Let me see... Well, the main thing we're low on is Mint, which has put a stop on heatstroke medicine production for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280207,
					"content": "I mean, we are also taking medicine orders other than your father's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280208,
					"content": "Then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280209,
					"content": "Looks like it's my time to shine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "Hehe, thanks, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280213,
					"content": "I'm counting on you to get those herbs! I've got to stay here in the meantime and check those medicines, just like Dad asked me to!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280214,
					"content": "Haha, aren't you an earnest kid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280215,
					"content": "Alright then, right this way. I'll go through this batch of medicines with you in detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280216,
					"content": "Whoa, that's... a lot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280217,
					"content": "Have a look at these first. I'll bring the next batch out shortly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280218,
					"content": "Eh? There's more!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280211,
					"content": "Just don't forget to pay me, now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "Hehe, no problem! Thanks, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
