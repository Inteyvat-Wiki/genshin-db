			},
			"dialogs": [
				{
					"id": 210280401,
					"content": "Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280402,
					"content": "Yes, these will be enough for me to make some medicine with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280403,
					"content": "I'll put the heatstroke medicine into the next batch and have them delivered to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280404,
					"content": "Thanks, Big Brother Gui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280405,
					"content": "And these are for you, Traveler. Thanks for your help! Let's head back now, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280406,
					"content": "Hehe, Dad will be pleased to hear this, I'm sure of it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280407,
					"content": "One moment please, Little Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280408,
					"content": "Eh? What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280409,
					"content": "Weren't you supposed to check the medicines? You still haven't gone through the checklists in the back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280410,
					"content": "Eh... What? I... But I was checking for so long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210280411,
					"content": "And there's more where that came from, Little Meng. Now then, let's continue the reviewing process...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 210280412,
					"content": "Wah... Okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				}
			]
		},
