			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320401,
					"content": "We're back. The doctor gave you this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320402,
					"content": "Lechlade takes the Pure Water and drinks all of it immediately.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "Ah, me, that's better! Vigor fills me once again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320404,
					"content": "That's it!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "Wasn't that a little too fast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320408,
					"content": "Arderne is a really good doctor, and certified, too! The medicine he prescribes always works. Unlike mine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320409,
					"content": "But what about the yellow-green stones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320410,
					"content": "Suspicious, of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320411,
					"content": "Ugh, guess his delusions can't be helped.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320412,
					"content": "Now I can keep working! Thank you so much for helping out. Here, take these Coupons — just a little something to show my appreciation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320413,
					"content": "Stay healthy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320406,
					"content": "I don't think you were sick at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320407
					]
				},
				{
					"id": 740320407,
					"content": "No, no, I was sick — but you brought me the cure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Lechlade"
				}
			]
		},
