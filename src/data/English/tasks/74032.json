			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "Something's definitely wrong with those yellow-green stones... I think I'm going to die here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320202,
					"content": "Um, are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320203,
					"content": "In the long run, we'll all be \"fine,\" but I'm going to be \"fine\" before you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320204,
					"content": "Okay then, sure. Bye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "Wait a minute, this guy doesn't sound fine at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320208,
					"content": "No, I'm fine, literally. If something's wrong, it's too late anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320209,
					"content": "So are you alright or not?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "Paimon's very confused. Can you please be more specific?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320211,
					"content": "Specifically speaking, when I come to the production zone, I get headaches and heart palpitations, and my hands and feet grow cold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320212,
					"content": "I'm done for! Do you know what I mean? I'm done for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320213,
					"content": "It must be the yellow-green stones! They're evil! You know of those stones, right? The Central Laboratory of the Fontaine Research Institute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320214,
					"content": "The yellow-green stones destroyed everything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320215,
					"content": "Please just go see a doctor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "I am a doctor! I know! Wait, I'm no longer a doctor. I lost my certification, and I can't give official diagnoses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320218,
					"content": "Please find a real doctor with certifications to save me! Please!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320219,
					"content": "#This sounds pretty serious. Let's go find a doctor, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320216,
					"content": "Why don't you rest up in the infirmary?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "That's certainly a new way to use the word \"fine.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "You don't sound fine at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403203",
							"2"
						],
						"stepId": 7403203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arderne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "Are you in trouble? Or are others in trouble? You both look healthy, so it must be the latter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320302,
					"content": "Indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320303,
					"content": "You explain Lechlade's situation.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "Him again, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320305,
					"content": "Can you treat him?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "His headache? Or his delusions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320307,
					"content": "Huh? You mean he's not that sick?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320308,
					"content": "Based on his lab results, most likely not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320309,
					"content": "I heard that he misdiagnosed a patient when he was still on the outside, ignoring some early warning results, and healthcare outcome... Well, he's been a little paranoid ever since.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320310,
					"content": "He's like that to others, and worse when it comes to himself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320311,
					"content": "How about the yellow-green stones?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "No one else is having those same health issues, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320313,
					"content": "But I can't very well ignore him, so please, give him this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320314,
					"content": "Isn't this Pure Water? Are you sure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320315,
					"content": "Oh, so you know what this is. It's fine in the sense that it does no harm to the body, and it'll give him a boost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320316,
					"content": "So he doesn't know?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "As far as I know, he stays away from these drinks. But I gave it to him before, telling him it was a health potion, and he did actually show more vigor after drinking it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320322,
					"content": "Alright, we'll give this to him. If it doesn't work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320323,
					"content": "Then tell him to go lie down in the infirmary. If you tell him it's \"doctor's orders,\" he'll listen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320324,
					"content": "#Sure. Let's go back, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320318,
					"content": "Why not just give him Fonta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "That's the thing. Everyone here knows what Fonta tastes like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320320,
					"content": "But based on my knowledge, he hasn't had Pure Water. After all, it's not very common here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320321,
					"content": "I gave it to him before, telling him it was a health potion, and he did actually show more vigor after drinking it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				}
			]
		},
		{
			"id": 7403204,
			"completionStepIds": [
				7403204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
