					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410603,
					"content": "Wah... All weak. Only Golden Nara is strong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410604,
					"content": "This is bad! Must train Ararakalari. With very strong Ararakalari, Nara friend won't be able to find me!",
