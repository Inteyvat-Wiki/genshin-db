					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410605,
					"content": "I don't think that's how this works...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "Are you afraid of losing? There's no need to care about winning or losing when playing games!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410609,
					"content": "Even though I lost, I had fun. Golden Nara is a good Nara after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410610,
					"content": "Our Nara friend wins. Awesome! Please take our flowers!",
