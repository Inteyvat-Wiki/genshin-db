				"points": []
			},
			"dialogs": [
				{
					"id": 200210701,
					"content": "Taking off using Anemo Slimes is always an interesting option.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210702
					]
				},
				{
					"id": 200210702,
					"content": "Is this so? Huh...",
					"roleType": "TALK_ROLE_NPC",
