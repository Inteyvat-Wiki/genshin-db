			"dialogs": [
				{
					"id": 200211401,
					"content": "Wow, you're really good at this! No wonder Amber said that I could learn a thing or two from you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211402
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211402,
					"content": "Hehe, with you as my coach, this exam will be a cinch!",
