					"nextDialogs": [
						200211403
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211403,
					"content": "Thanks so much! Here, these are for you. I'm off to revise some more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211404
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211404,
					"content": "I wonder what color my wind glider should be...",
