			"dialogs": [
				{
					"id": 200210601,
					"content": "To select appropriate take-off points and to assume the correct take-off posture.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210602
					]
				},
				{
					"id": 200210602,
					"content": "Okay, interesting...",
					"roleType": "TALK_ROLE_NPC",
