			},
			"dialogs": [
				{
					"id": 200210301,
					"content": "That depends on how good the person doing the gliding is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210302
					]
				},
				{
					"id": 200210302,
					"content": "Huh, is that so...",
					"roleType": "TALK_ROLE_NPC",
