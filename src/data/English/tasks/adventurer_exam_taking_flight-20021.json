			},
			"dialogs": [
				{
					"id": 200211301,
					"content": "Hmm... I think I've more or less got it all down now! But I won't get anywhere just by listening...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211302,
					"content": "Traveler, could you give me a demonstration of wind glider usage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200211303,
						200211304
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211303,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200211305
					]
				},
				{
					"id": 200211305,
					"content": "I sure will! Let's get going, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200211304,
					"content": "Watch closely now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200211305
					]
				}
			]
		},
		{
