		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "Huh? I see that we have a special guest today. Usually, it's just that chef and I, eating in silence. Perhaps your presence will liven up today's meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290302,
					"content": "But it appears that the chef is terribly worried about something today. Why the long face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue",
					"Smiley Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "These meatballs are not half bad, this meat just melts in one's mouth, the broth packs a lot of flavor as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290402,
					"content": "Huh? There's crab roe in the meat, no wonder it tastes so unusually fresh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290403,
					"content": "Come, Traveler, try one more. I'll teach you what to do. First, use chopsticks to open the meatball up, then soak it in the broth, and eat it with some rice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290404,
					"content": "So nice of you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "You'd better enjoy the food because that might've been the last meal I got to cook here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290410,
					"content": "Last meal you got to cook here... Who told you so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290411,
					"content": "Oh no, is it because of me? Is the innkeeper fed up with you because you've been feeding me all this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290412,
					"content": "Seems a bit unfair, given that I supplied the inn with some of my best catches free of charge. That should've covered at least a part of my bill. Besides, the innkeeper isn't known for being a miser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290413,
					"content": "Give me a break, it was just a few fish, and most of them ended up in your stomach anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290414,
					"content": "So actually...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290415,
					"content": "*sigh* ...Fine. I'll tell you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290416,
					"content": "Presentable, tasty, stylish, artisan, and with personality...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290417,
					"content": "Hahaha, I'm not sure if there's any dish in this world that'd meet the innkeeper's requirements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290418,
					"content": "You think it's funny? We'll see how you'll laugh when you come over next time and I won't be here to feed you for free!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290419,
					"content": "Alright, alright, it's not so funny after all. So that's why you've been looking so worried today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290420,
					"content": "It's hard to be in high spirits when your boss expects you to perform miracles all of a sudden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290421,
					"content": "Hm, there might be a way out. Even though I can't cook myself, I happen to know a recipe for a unique dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290422,
					"content": "I came across that dish during a trip abroad, when I happened to be a guest at a local big shot's house. They called it Chicken Tofu Pudding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290423,
					"content": "By the looks of it, you wouldn't say that it's a meat dish. It really is as delicate as tofu pudding, but with a strong flavor of meat and herbs. A rare meat dish that imitates vegetarian cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290424,
					"content": "That meal left me so curious about the dish that I asked my host for the recipe, however... I'm a bad cook, so the recipe has been collecting dust in my chest ever since...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290425,
					"content": "I'm surprised that you managed to get a hold of such a recipe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Uh... Long story short, I helped someone, and they invited me to a feast to show their gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290427,
					"content": "The chef who came up with this recipe didn't mind sharing it with me. He was confident that one can count the people skilled enough to make such a dish on one hand anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290429,
					"content": "No doubt about it. According to that chef, those who attempt to make the dish, have to be not only skilled in the art of cooking, but also in the art of the sword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290430,
					"content": "Hmph, what kind of a dish requires swinging a sword? I can chop meat just fine with my knife.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290431,
					"content": "I'm afraid you'd sooner cut the chopping board in half than mince the meat fine enough with that knife of yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290432,
					"content": "I was told that minced meat is the highlight of this dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290433,
					"content": "As such, precise sword technique is the key to success. First, one needs to portion the meat and chop it up with the sword's edge. Then, use the sword's backside to mince it. Next...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290434,
					"content": "Hold on. Wait a minute... That recipe of yours is good for nothing in our hands. I'm not much of a swordsman, and you're not a cook.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290435,
					"content": "Where can we find a sword-wielding warrior who also happens to have some culinary skills?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290436,
					"content": "This person... might be closer than you think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290437,
					"content": "M—Me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "Precisely. Isn't it a fortunate twist of fate that you know how to use both the sword and the stove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290441,
					"content": "How about we let the Traveler attempt to make that unique dish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290442,
					"content": "But the innkeeper wanted Yanxiao to...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "Well, the innkeeper only told Yanxiao to come up with a new dish. He didn't specify who had to cook it, so it's still an open question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290444,
					"content": "Am I right, chef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290445,
					"content": "Ah... right! Your logic is sound!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290446,
					"content": "But what ingredients do we need to make a Chicken Tofu Pudding?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290447,
					"content": "Nothing special, really, just some Fowl, Ham, Bird Egg, and Snapdragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290448,
					"content": "...Still have some Fowl and Ham stored in the kitchen, but... we're fresh out of Bird Eggs and Snapdragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290449,
					"content": "Had I known sooner, I wouldn't have made those Matsutake Scrambled Eggs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290450,
					"content": "Traveler, can I count on you to bring me one of each?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290451,
					"content": "Once you find them, we'll work that Chicken Tofu Pudding out together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290452,
					"content": "Uh... Naturally, I'll make sure to repay you for your help... Thank you in advance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718290439,
					"content": "I know my way around the kitchen, that's true...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "You're also a skilled swordsman, aren't you? I've witnessed some of your feats myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290428,
					"content": "Surely, it must be a very difficult dish...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "Whoa, you talk like an expert...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Hahaha, even a fool would learn a thing or two about food if they got to eat such delicacies every day. Let me teach you the correct way to taste this stewed fish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290407,
					"content": "You're not eating with us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "Me? I'm afraid I'm already full... since the innkeeper filled me with anxiety.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Smiley Yanxiao"
				}
			]
		},
		{
			"id": 7182905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
