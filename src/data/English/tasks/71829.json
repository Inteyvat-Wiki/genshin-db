			"dialogs": [
				{
					"id": 718291201,
					"content": "Now, light the stove up and slow-cook the meat paste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291202
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291202,
					"content": "You have to keep the flame in check — too low and the meat won't cook through, too high and the paste will break up and lose its texture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291203
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291203,
					"content": "Slow-cooking the meat in a special broth... This dish is not a budget option, that's for sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				}
			]
		},
