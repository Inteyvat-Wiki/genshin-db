			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Smiley Yanxiao",
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "Let me try...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291402,
					"content": "Mmmm, this flavor... so rich and fresh, but the mouthfeel resembles that of a tofu pudding...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291403,
					"content": "Looks quite presentable, too, and requires truly exquisite workmanship. The premise is also catchy — a meat dish that imitates vegetarian cuisine — I'm sure many would like to try it for themselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291404,
					"content": "Not bad! Not bad at all! I'm sure it'll be to the innkeeper's taste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291405,
					"content": "What a surprise! Turns out you're more capable than I gave you credit for. Who knew a sponger like you would remember this recipe so well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291406,
					"content": "Haha. I might as well tell you: back in the day, I thought that this recipe contained some sort of secret sword art, so I studied it day and night without ceasing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291407,
					"content": "Now that I think about it, I must have been an absolute madman. It was just a recipe, why would there be anything about swordsmanship in it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291408,
					"content": "And all that practice, for...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "To look for someone and to ask for justice, that's all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291410,
					"content": "Hah! That was a magnificent deed! And here you are, speaking so softly about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291411,
					"content": "Haha. Well, once I'd exacted that justice, I came here. Thankfully, the innkeeper was willing to take me in and let me loaf about the place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291412,
					"content": "I am now free of desire. I no longer wish to wield my sword, nor do I have any other skills... Hahaha, I suppose staying here for the rest of my life isn't so bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291413,
					"content": "Well now, I suppose I should give you a copy of this recipe. You can make it for yourself if you have the time. It's a little troublesome, but it tastes pretty good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291414,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Hmm... Well, let's put this dish aside. We can show it to the innkeeper once he gets here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291418,
					"content": "And after that... hey, hey, Mr. Loafer, don't you go anywhere just yet. Come over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291419,
					"content": "Oh, what do you want? I don't have another recipe for you, just so you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291420,
					"content": "Come on. Didn't you say that you didn't have any skills apart from wielding your sword? Well then, draw that sword, I'm teaching you to chop meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291421,
					"content": "Chop meat? I... Well, I'm afraid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291422,
					"content": "You'll get it pretty quickly. Chop meat today, make a dish tomorrow. Learn yourself a few of those, and there, you've got a skill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291423,
					"content": "What are you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291424,
					"content": "Hmph. A few dishes under your belt, yes — that'll spare me the need to watch you scrap for food around here, that's for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291425
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291425,
					"content": "Well, come on then, don't drag your feet. You dilly-dally some more, and you can forget having any meatballs to eat tomorrow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291426
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718291426,
					"content": "Wait, what? Come on, you can't threaten me like that... Alright, alright, I'll chop them. I'll chop them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291415,
					"content": "Will you continue staying here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291416
					]
				},
				{
					"id": 718291416,
					"content": "Of course. I never get tired of our good chef's great food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291417
					],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
}