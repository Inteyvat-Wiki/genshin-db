			"dialogs": [
				{
					"id": 400660301,
					"content": "Wow, it's a new place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400660302,
					"content": "As was the case last time, only Lord Kazuha is missing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660303
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400660303,
					"content": "Don't worry, leave it to us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kageharu",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "...This will do. Ah, Kazuha, you've come just at the right moment. What do you think of this rock carving?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660602,
					"content": "It's very intricate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660603,
					"content": "I based it on a mountain scene I saw in a book. You know, there are nations in this world where the mountains reach all the way up into the clouds. If only I had the chance to see them with my own eyes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660604,
					"content": "Father, you can go anywhere whenever you want.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660605,
					"content": "That's not true. Though the Kaedehara Clan is far from what it used to be, I still bear all the same responsibilities as the clan heads before me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660606,
					"content": "But then again... continuing in the way of our forefathers, sacrificing everything for our declining clan... is it really worth it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660607,
					"content": "But I... I don't understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660608,
					"content": "...Kazuha, there's one thing I want you to always remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660609,
					"content": "Family ties are important, but you ought to not let them hold you back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660610,
					"content": "Family only exists because of the people in it. If we are unhappy, how can we hope to build a joyful one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660611,
					"content": "The events of the past have had a profound impact on our family, but they are not your burden to carry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660612,
					"content": "...If you ever grow tired of this tedious life, just drop everything and go off on a journey, see the world. Remember, Kazuha, don't let yourself get tied down in life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660613,
					"content": "Yes, father.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006611",
							"2"
						],
						"stepId": 4006611,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kaedehara Kageharu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "I'm sorry, but I just don't understand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661102,
					"content": "Kazuha, have you forgotten our promise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661103,
					"content": "You really want to give it all up? But... but even if we're having a rough time, you still have me by your side! Can't I be of any help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661104,
					"content": "When you were my age, you were already helping grandfather out! Am I so incompetent that I'm a disappointment to you? Or...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661105,
					"content": "Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661106,
					"content": "*sigh* ...Now you're blaming yourself for all of this... That's why I have failed you as a father.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661107,
					"content": "The Kaedehara Clan has been paying the price for our past mistakes ever since your great-grandfather's generation. To this day, we have never fully recovered from it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661108,
					"content": "Though we are a family of bladesmiths, you don't have to devote your life to the family craft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661109,
					"content": "If a wounded animal wants to escape from a trap, it has to sacrifice the hind leg that was caught. You might think of this as a loss, but staying in the trap has far more deadly consequences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661110,
					"content": "Enough now, Kazuha. As the head of the family, I failed to revitalize our clan. You never blamed me for not giving you the life promised to you by our heritage, and I'm grateful enough for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661111,
					"content": "All these generations of suffering... let's end them today. From now on, live your life with no burdens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661112,
					"content": "Don't worry, I'll carry the blame for abandoning our family business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661113,
					"content": "Father, please don't... You should not be to blame for not upholding our family name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661114,
					"content": "Even if that day comes, let me share the burden with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661115,
					"content": "Let's just wait and see. Sooner or later, I will have to lead the Kaedehara Clan. When the time comes, I'll deal with all our problems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
