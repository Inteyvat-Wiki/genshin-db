				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670601,
					"content": "Have you finished doing what you wanted to do, Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670602,
					"content": "Yes, you could say that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670603,
					"content": "You saw my past self and said goodbye to him. Only when you witness my whole story does it become truly consigned to history.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670604,
					"content": "What really matters in life is not how strict we are with ourselves, but the connections we make along the way. There's no future for those who linger on the past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670605,
					"content": "So please believe me when I say that I've already come a long way, and I intend to go further still. I will always treasure your support.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006710,
			"completionStepIds": [
				4006715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006715",
							"2"
						],
						"stepId": 4006715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Listen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "Hey, buddy! You okay? Need a ride or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "Listen"
				},
				{
					"id": 400671002,
					"content": "Heh, pirates?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "Listen"
				},
				{
					"id": 400671003,
					"content": "Hah, you could call us that! So, you coming or not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Listen"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006712",
							"2"
						],
						"stepId": 4006712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "Kazuha! We found you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671202,
					"content": "Good timing. I was just reflecting on my life so far, and I think I'm all up to date.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671203,
					"content": "So, what do you think of the Kaedehara Clan's bonsai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671204,
					"content": "Looks like it carries lots of history.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "Old things often carry around some form of regret. The Kaedehara Clan is no exception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671206,
					"content": "But that's okay. Partings produce reunions, if not at home then in a distant land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671209,
					"content": "This mirage is quite fascinating. It presents life like a stage play, with each scene more captivating than the last.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671210,
					"content": "They say that astrologists have seen it all. So if this mirage intrigued you, that says it was a worthwhile encounter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671211,
					"content": "Ahem... How fares thy mood?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671212,
					"content": "Mein Fräulein inquires as to your present wellbeing, Lord Kazuha, hoping your heart is not too filled with sorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671213,
					"content": "There's no way anyone could be cheerful after reliving all that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671214,
					"content": "Haha, you have a point. Thank you all for your concern. Fortunately, all those things are past and gone now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671215,
					"content": "When I first saw this bonsai, I thought of the possibility that... I needed to wait for you. Perhaps that was why I had to be here on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671207,
					"content": "Things weren't perfect, but you have nothing to feel ashamed of.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "Indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006713,
			"completionStepIds": [
				4006713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
