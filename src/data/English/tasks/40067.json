				"points": []
			},
			"dialogs": [
				{
					"id": 400671401,
					"content": "So, those strange houses today, huh... And a... a mirage-bonsai? Basically, lots of weird stuff today! Do you think we should tell Venti about it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671402,
					"content": "I thought you were gonna ask me that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "Dodoco! Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671405
					],
					"speakerTitle": "Dodocommunication Device"
				},
				{
					"id": 400671405,
					"content": "Dodoco! Dodoco! Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671406
					],
					"speakerTitle": "Dodocommunication Device"
				},
				{
					"id": 400671406,
					"content": "There's no answer... That's weird, why is he ignoring us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671407,
					"content": "This doesn't seem like him...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "Maybe he got distracted? Or he forgot to bring the bomb to his performance? Or maybe he got drunk and fell asleep under that huge tree...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671409,
					"content": "Hmm... maybe we should try contacting him tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671410,
					"content": "Traveler, Paimon. So here you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671411,
					"content": "Mona! Are you all done chatting with Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671412,
					"content": "Hahaha, close enough... She was a little downcast. I think it has something to do with the mirage we saw today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671413,
					"content": "Fischl has been very excited about this trip from the start... but I have a feeling she doesn't want to see her own mirage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671414,
					"content": "Why? It seems like this'd be the kind of thing she really enjoys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671415,
					"content": "...I'm not sure at this stage, but I'll keep an eye on her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671416,
					"content": "There's something else I wanted to tell you. I tried performing a divination again on the beach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671417,
					"content": "My scryglass was still blurry, but I felt a force coming from within. I couldn't see its exact position, but I knew that it was changing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671418,
					"content": "How could you tell that if you couldn't see it clearly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671419,
					"content": "Hmm, how can I explain this concept to non-experts... Oh, I know! It's like we're sitting in a room and there's a crack in the walls. We don't know where it is, but everyone can feel the wind rushing in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671420,
					"content": "Not only that, but the room is getting colder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671421,
					"content": "Ohh! Paimon gets it now! So you wanna find where that crack is, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671422,
					"content": "You could say that. I need to see the crack first before deciding what to do next.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671403,
					"content": "Let's give him a call.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				}
			]
		}
	]
