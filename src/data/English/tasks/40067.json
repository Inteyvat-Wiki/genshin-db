			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Fischl",
					"Mona",
					"Oz",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671301,
					"content": "*yawn*... It's been a long trip today, Paimon's getting kinda sleepy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671302,
					"content": "Everyone must be exhausted. Let's call it a day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671304
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671304,
					"content": "Hmm? What's wrong? You don't look too good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671305,
					"content": "Nothing. Perhaps today's arduous journey is making me feel slightly out of sorts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671306
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671307
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671307,
					"content": "Mein Fräulein, are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671308
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671308,
					"content": "Oz, curb thy curiosity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671309
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671309,
					"content": "Yes, mein Fräulein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671310
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671310,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671311,
					"content": "I'll see if I can find something for us to eat. Go ahead and rest if you're feeling tired, but anyone who's up to it is welcome to help out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671312
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671312,
					"content": "I'll help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671313,
					"content": "Me too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671314,
					"content": "Everyone's volunteering to help! Maybe we should too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671315,
					"content": "Count us in.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671316
					]
				},
				{
					"id": 400671316,
					"content": "Whoa, hey, I appreciate the enthusiasm, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671317
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671317,
					"content": "Her Highness looks kinda gloomy. Mona, you two seem close, why don't you keep her company for a while?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671318
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671318,
					"content": "You noticed it too. I was going to bring it up with you while we were preparing the food. In that case, yes, just leave it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671319,
					"content": "Alright! We'll prepare the food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671320
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671320,
					"content": "Mona gives you a wink, then runs to stay with Fischl. Everyone else collects cooking ingredients...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400671321
					]
				},
				{
					"id": 400671321,
					"content": "Yup, this should be enough. We can grill these. Next time we pass by one of those abandoned campsites, I'll see if they have a cooking pot. We'd have some more variety then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671322
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671322,
					"content": "Wow, that's such a nice idea! You might not be a chef, Xinyan, but you sure do know how to keep the diners happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671323,
					"content": "Aw shucks, Paimon. It's no big deal, just doing what I can!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671324,
					"content": "Even the crew mates of The Alcor consider Xinyan someone they can rely on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671325
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671325,
					"content": "We feel the same way about you, too, Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671326,
					"content": "Hahaha, we sure do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671327
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671327,
					"content": "Hmm... Well then, as a trusted friend, I have something I'd like to talk about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671328,
					"content": "From what you've been saying, that miraculous mirage seems to have been based on my life story to date.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671329
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671329,
					"content": "...It felt just like a dream to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671330
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671330,
					"content": "Maybe that's it. Maybe it represented your dreams.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671331
					]
				},
				{
					"id": 400671331,
					"content": "In other words... you've always wanted to make your own bonsai, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671332
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671332,
					"content": "Could that be it...? All that was a means of granting me something I wished for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671333
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671333,
					"content": "And since this happened to me, does that mean it could happen to everyone else, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671334
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671334,
					"content": "Yes, I think so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671335
					]
				},
				{
					"id": 400671335,
					"content": "I agree. But I wonder whose mirage we'll encounter next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671336
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671336,
					"content": "Hah, I'm actually kinda looking forward to my own mirage, if it's a dream come true like you say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671337
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671337,
					"content": "Wait, you actually want something like this to happen with you, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671338,
					"content": "Aw heck, any mirage to do with me would probably be music-related. Hahaha, it'd be a good chance to showcase a few tunes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671339
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671339,
					"content": "You mean you'd wanna do a performance in there!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671340,
					"content": "Why not? I don't think any self-respecting musician could stay silent on these islands. Just look at this place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671341
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671341,
					"content": "So much confidence and optimism! Xinyan rocks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671342,
					"content": "#Oh, uh, {NICKNAME}! Paimon wants to try some of the fruit growing on that cliff over there. Let's go pick some!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671343,
					"content": "(Oh? Is this about...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671344
					]
				},
				{
					"id": 400671344,
					"content": "Carry on without us, I need a moment with Paimon.",
