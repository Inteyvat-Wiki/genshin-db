			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "There was supposed to be a dead plant in that flowerpot. However, there was nothing there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670502,
					"content": "...While we were separated, I had a lot of time to reflect. I think I finally understand now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670503,
					"content": "The mirage is... me. The empty flowerpot represents the state of my heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670504,
					"content": "When the heart is clear, the world is too. And when the heart is unladen, the same is true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670505,
					"content": "Clear and unladen... that describes how I feel right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670506,
					"content": "Although, I would not say there are no regrets in this. To be unladen is also to be empty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670507,
					"content": "That's why this bonsai appeared as part of my mirage. It gave me a chance to fulfill my wishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670508,
					"content": "I never realized that deep down in my heart, I also wanted to make my own bonsai... Perhaps this is what it really means to keep Kaedehara traditions alive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006706,
			"completionStepIds": [
				4006712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
