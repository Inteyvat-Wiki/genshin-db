					"Listen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670401,
					"content": "Kaedehara, that's you, right? Get on board, I'll get you out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "Listen"
				},
				{
					"id": 400670402,
					"content": "But... why are you helping me? I'm a wanted fugitive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670403,
					"content": "Obviously the Yashiro— Ahem! An anonymous financial sponsor wants you to get out safely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "Listen"
				},
				{
					"id": 400670404,
					"content": "But there's only so much they can do. After this, you'll be on your own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Listen"
				}
			]
		},
