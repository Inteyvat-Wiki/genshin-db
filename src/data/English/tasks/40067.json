				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodocommunication Device"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "...When we set foot in this picture-perfect place, I never would've imagined we'd be dealing with such a mystifying occurrence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670202,
					"content": "How do you feel about it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "Fine, I suppose. I could use some help though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670204,
					"content": "What do you need us to do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670205,
					"content": "Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670206,
					"content": "Uhh... nothing, actually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670207,
					"content": "What? Are you underestimating us!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670208,
					"content": "No, I just realized that although you never talk much, you do so much for us all, quietly, in the background.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670209,
					"content": "You're the companion everyone needs. I think we're all very relieved to have you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670210,
					"content": "I know putting high expectations on you might give you some unwelcome pressure, but... I like to think an astrologist's observations can yield insights outside the night sky alone, and noticing other people's strengths is a kind of observation, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670211,
					"content": "So you just wanted to compliment us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670212,
					"content": "I was simply stating the facts, not complimenting anyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670213,
					"content": "Hmm, so you can't admit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "...that you're actually complimenting someone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670215,
					"content": "Stop smirking at me! I told you, it was an objective evaluation, not a compliment! Not a compliment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670216,
					"content": "#I'll keep observing the stars. Stay in touch, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4006703,
