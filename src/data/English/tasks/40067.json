			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodocommunication Device"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "...Seems like similar things happen every time I'm with you. I'll attempt divination, read the signs, zero in on the target, then solve the problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670102,
					"content": "You're surrounded by all kinds of friends, secrets, and destinies. It's incredible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670103,
					"content": "No, you're incredible! You helped Fischl and us solve that Leonard situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670104,
					"content": "Is this a good thing for an astrologist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "All things considered, I suppose. Let's hope we can all stick together and resolve this, like we did last time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670106,
					"content": "When you say together, do you mean the two of you, or all three of us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670107,
					"content": "Pff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670108,
					"content": "Okay, okay, the three of us then! Sometimes, Paimon offers an insightful perspective that can be very helpful to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670109,
					"content": "Really? Paimon's starting to like you a lot, Genius Astrologist Mona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670110,
					"content": "Yes, that's the perspective I'm talking about! You'll never meet another astrologist as clever and charming as me, ohohohoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670111,
					"content": "Yeah, everything about you's great, except for, um... please don't laugh like Fischl again... ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670112,
					"content": "Ahem! Sorry... Heh, friends' habits rub off on you when you spend a lot of time together, don't they... haha... hah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670113,
					"content": "#I'll keep observing the stars. Keep in touch, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4006702,
			"completionStepIds": [
				4006714
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
