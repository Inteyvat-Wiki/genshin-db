			"trigger": {
				"objectNames": [
					"Fischl",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670301,
					"content": "What's happened here? Everything is broken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670302,
					"content": "...Alas, the loftier the clan, the more devastating the fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670303
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400670303,
					"content": "Broken into pieces, and not a single soul around... This must be the way things ended.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670304,
					"content": "C'mon, let's get movin'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006704,
			"completionStepIds": [
				4006710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
