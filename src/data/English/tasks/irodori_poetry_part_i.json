			"dialogs": [
				{
					"id": 726910301,
					"content": "Ah, it's you. Have you finished taking those pictures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910302
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910302,
					"content": "I've taken them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "Wonderful! You have my thanks. Let me have a look... Oh my, I've never seen any of these! ...And ah, this picture is wonderful! This one also seems quite noteworthy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910304,
					"content": "Friend, your photos are a true inspiration! Many thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910305,
					"content": "Now, I have attempted to write several different stanzas according to the pictures you provided me. I'm quite torn as to which to use...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910306,
					"content": "I'm quite curious, actually. If it were you, which would you use?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
