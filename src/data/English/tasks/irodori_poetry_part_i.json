				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726910101,
					"content": "#{F#Miss}{M#Mister}, I see that you've been walking back and forth in this area for some time now. I believe you must be someone who appreciates the elegance of the arts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910102,
					"content": "There is a question of elegance that I might need your help with. Would you mind lending me your aid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910103,
					"content": "Yes, what is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910104
					]
				},
				{
					"id": 726910104,
					"content": "Though I have only just met this man, Lenne, a bard from Mondstadt, over here, we have already become fast friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910105,
					"content": "Ootomo speaks the truth. We have only known each other for a few days, but I already have the greatest respect for his great learning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910106,
					"content": "Hehe, you are too kind, Lenne. In any case, we have made friends through poetry, and we're taking this opportunity to write a few collaborative works.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910107,
					"content": "And since Lenne has gone through all the effort to come to Inazuma, he really wants to add a bit of that Inazuman flavor to his work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910108
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910108,
					"content": "Indeed. Unfortunately, my itinerary has been far too tight. I haven't had time to really go around and see the sights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910109
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910109,
					"content": "So, what can I do for you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910110
					]
				},
				{
					"id": 726910110,
					"content": "Friend, the theme of the poem I wish to write is \"nostalgia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910111
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910111,
					"content": "Upon seeing the sights in a distant land, a vagabond cannot help but remember their home. That is why I need to add some things into my poem that symbolize this distant place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910112
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910112,
					"content": "Could you help me take a few pictures from which I can draw some inspiration?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910113
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910113,
					"content": "Inazuma should have a great number of unique sights to see, yes? For example, when you speak of Mondstadt, everyone's minds will turn to Dandelions or Windwheel Asters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910114
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910114,
					"content": "Ooh, Paimon gets it now. Well in that case, let's take a few pictures of some of Inazuma's regional specialties! That should do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726910115,
					"content": "Indeed, I would be in your debt if you would! Allow me to also write a copy of my half-done poem manuscript, just for you to use as reference material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910116
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910116,
					"content": "As for the number of pictures that I will need, I think <color=#00E1FFFF>4</color>, each showcasing different contents, will do. I will also pay for any travel fees you may incur in the process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910117
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910117,
					"content": "#Well, {NICKNAME}, since Lenne's request seems clear, let's head out right now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7269102,
