					"content": "#{F#Miss}{M#Mister}... You truly have a good eye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910902
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726910902,
					"content": "Ootomo, since both you and our new friend here are both very enamored of these two lines, then let us use them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910903
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910903,
					"content": "Friend, thank you once again for your aid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
