					"nextDialogs": [
						726910203
					]
				},
				{
					"id": 726910203,
					"content": "Remember, you just need to take <color=#00E1FFFF>4</color> pictures of Inazuman regional specialties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
