	"talks": [
		{
			"id": 7269101,
			"completionStepIds": [
				7269101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269101",
							"2"
						],
						"stepId": 7269101,
						"stateName": "QUEST_STATE_UNFINISHED"
