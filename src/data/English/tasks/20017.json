				"points": []
			},
			"dialogs": [
				{
					"id": 200170401,
					"content": "Thank you so much, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170402
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170402,
					"content": "Although, they seem pretty persistent. I can't stay here any longer, it's just too dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170403
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170403,
					"content": "They've bashed up the cart yet again. There's no point me trying to fix it up perfectly... I guess I'll just have to make do by wrapping a rope— Oh for heaven's sake, where is my rope!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170404
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170404,
					"content": "I cannot believe this! Those monsters must've run off with it. Traveler... how's about you see if you can't find me a nice bit of <color=#00E1FFFF>rope</color> around here...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
