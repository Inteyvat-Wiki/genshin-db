			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Farrah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200170101,
					"content": "No, please! Don't hurt me! No— ah? Traveler, where did all the hilichurls go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170102,
					"content": "Great! Thank you so much! Are they really all gone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170103,
					"content": "Phew... I owe you. That said, after all that fuss I won't be able to catch up to the caravan now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170104,
					"content": "What's more my cart is broken. I need to get it fixed and head to the city before the fruit goes bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170105,
					"content": "Once this much fruit goes bad— You can't even imagine the smell. I'll never manage to wash it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170106,
					"content": "I'm going to have to take stock again... I can already smell some of the fruit going bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170107,
					"content": "Can you please help me by taking a look around for some materials to fix my cart with? A <color=#00E1FFFF>Sturdy Plank</color> should be enough to do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
			"id": 2001702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
