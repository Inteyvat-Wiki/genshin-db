					"Farrah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200170301,
					"content": "This is plenty. I'll get this cart fixed up as soon as I've washed my hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170302
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170302,
					"content": "Huh? They're— they're back...! Traveler! They're baaaack!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
			"id": 2001704,
