			},
			"dialogs": [
				{
					"id": 200170201,
					"content": "There should be plenty of <color=#00E1FFFF>Sturdy Planks</color> in the forest. Please hurry, if we wait too much longer all the fruit will be lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
			"id": 2001703,
			"completionStepIds": [
				2001704
