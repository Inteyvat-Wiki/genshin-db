			"dialogs": [
				{
					"id": 200170601,
					"content": "Perfect. That'll see me as far the city, at least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170602
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170602,
					"content": "Thanks for your help, Traveler. May we meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170603
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170603,
					"content": "Ugh, how am I going to get rid of this awful smell...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
