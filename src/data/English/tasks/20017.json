			"dialogs": [
				{
					"id": 200170701,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200170702
					]
				},
				{
					"id": 200170702,
					"content": "Great! I'll wait for you here. Ugh, I wish I could find the fruits that have gone bad already...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
