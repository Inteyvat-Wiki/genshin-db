			"dialogs": [
				{
					"id": 200170901,
					"content": "Certainly!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200170902
					]
				},
				{
					"id": 200170902,
					"content": "I appreciate it! Those monsters seem to want anything and everything they can get their hands on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
