				"points": []
			},
			"dialogs": [
				{
					"id": 200170801,
					"content": "I'm leaving this one to you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200170802
					]
				},
				{
					"id": 200170802,
					"content": "Wait! Please... Smell that? Now imagine that, but a thousand times worse — that'll be my cart if I don't shift all this fruit before long! Please help me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
		{
