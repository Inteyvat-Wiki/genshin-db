			"dialogs": [
				{
					"id": 200171001,
					"content": "Certainly not!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200171002
					]
				},
				{
					"id": 200171002,
					"content": "Hey, wait! Wh—What if they come back, then what am I supposed to do!? An artillery of apples won't do much good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200171003
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200171003,
					"content": "Come on, without your help I'll be done for!",
