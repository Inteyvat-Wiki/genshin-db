			"trigger": {
				"objectNames": [
					"Varka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766750501,
					"content": "Need me on barrel duty, or just wanted to chat for a bit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750502,
						766750504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750502,
					"content": "Please reposition it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750503
					]
				},
				{
					"id": 766750503,
					"content": "Right then! No quitting now, chin up and try again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750504,
					"content": "Let's talk a bit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750505
					]
				},
				{
					"id": 766750505,
					"content": "Back when I was training Noelle, she'd blast the barrels to splinters the second she got nervous. Couldn't stop her from cleaning up the whole mess herself afterward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750506
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750506,
					"content": "Over time... She became the finest cleaner in the Knights, bar none. Ha, she might not have realized it, but that's progress too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 7667506,
