				},
				{
					"id": 766750804,
					"content": "Let's talk a bit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750805
					]
				},
				{
					"id": 766750805,
					"content": "Come to think of it, you haven't met Lohen yet, have you? Kid's so used to doing things his way, he didn't even show up when it was time for the training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750806,
					"content": "Asked him about it later, he said he went to poke a hornet's nest full of monsters, and as for barrel drills... He didn't think targets that wouldn't hit back were worth his time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
