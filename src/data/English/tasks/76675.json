			"dialogs": [
				{
					"id": 766750901,
					"content": "Ah! Grand Master! Honorary Knight! They're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750902,
					"content": "They're back! They're back! Everyone, fall in and give 'em a proper welcome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750903,
					"content": "Wow, we're this popular? Paimon feels like blushing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750904,
					"content": "—How the wind carries that scent from afar! Sweet Barbatos, it's true! Dandelion Wine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750905,
					"content": "A special brew from Dawn Winery, to boot! They're back... all my precious memories... they're all flooding back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750906,
					"content": "Uh... So, the welcome isn't for us, is it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750907,
					"content": "Yes, this is it, this is the taste... It's just how I remembered it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750908,
					"content": "Amazing, after all these years...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750909,
					"content": "Ah, I was starting to think I'd already forgotten the taste of a good Dawn Winery vintage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750910,
					"content": "If the taste hasn't changed... then my home back in Springvale probably hasn't changed either... right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750911,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "...Thank you, Honorary Knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750914,
					"content": "...That's enough, put a cork in it, everyone. Barrels stay sealed until everyone's back. Let's finish the party prep in the meantime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750915,
					"content": "Yes, Sir! On it, Sir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750916,
					"content": "...Like I said: Drinking is the most serious of serious business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750917,
					"content": "Ooooh... Sticky Honey Roast... Sweet Madames... Paimon never thought she'd get to eat such authentic Mondstadt dishes out here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750918,
					"content": "Uh, wait, where's Varka? Anyone seen him? He's not passed out drunk in a ditch somewhere, is he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750919,
					"content": "Given his liver's battle prowess, is that even possible?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "Okay... Paimon'll catch up once she finishes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750920,
					"content": "I'll go find him, you keep eating.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "It's the same, I've been there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
			"id": 7667510,
			"completionStepIds": [
				7667510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667510",
							"2"
						],
						"stepId": 7667510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varka"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5921.365,
							283.763,
							9726.784
						],
						"pointId": 14164
					},
					{
						"sceneId": 3,
						"position": [
							5925.497,
							284.186,
							9722.368
						],
						"pointId": 15086
					}
				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "So, what's the hero who saved our savior and brought it back to camp doing in a corner like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751002,
					"content": "Took the words right out of my mouth.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "Heh... Truth is, what I've got in my cup is the most special of special brews. It can only be drunk alone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751005,
					"content": "...But since you've caught me, nothing for it. Here, have a cup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751006,
					"content": "...I knew it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "Got me! Just a joke. Not a drop of liquor on me right now. If you're thirsty for a real drink, go find Erminie later, she's got plenty in stock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751009,
					"content": "A camp always needs to have one sober soul to guard their drunk comrades from things that go bump in the night. Those have been my standing orders since this expedition started.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751010,
					"content": "Rotten luck, eh? Just so happens that tonight, it's my turn to be that sober soul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751011,
					"content": "...So, on this night when they're all drunk, I can't be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751012,
					"content": "Was it really luck?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "Who knows? Maybe fate just gets a kick out of messing with us? If it'd come one day later, maybe I'd have been down there guzzling wine to my heart's content.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751015,
					"content": "But if it had come but one day later, maybe you'd have passed the camp by. Missed the feast. Never even had this chance to talk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751016,
					"content": "Nobody can say what choices lead to what outcomes until the time comes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751017,
					"content": "Just like when I decided to lead this expedition out of Mondstadt... never imagined I'd make it this far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751018,
					"content": "The reason you launched the expedition... was it to deal with the Wild Hunt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "...That's how it turned out, aye. But when we marched, all I \"knew\" was this: An Abyssal storm was brewing up north, one that threatened to scour all of Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751020,
					"content": "It took us some time to mobilize, but where would the enemy appear, and what form would they take?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751021,
					"content": "...That was all a complete mystery to us when we set out. All we could do was gather intel as we marched, preparing for every contingency.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751022,
					"content": "That's all you knew, and you still launched the expedition?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "Ha! Quick study, aren't you? Alas, the enemy won't sit around twiddling their thumbs while we finish preparing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751025,
					"content": "Every hour we hesitated, the Abyss was devouring the lives of countless people. The sooner we marched, the sooner we could change their fates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751026,
					"content": "—That was all the intel we needed to launch this \"expedition.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751027,
					"content": "No wonder you're the Knight of Boreas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "None of that formality, \"Honorary Knight\"! And you're no different. Your journey's also changed many people's fates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751030,
					"content": "Be it Mondstadt back then, Dvalin... or Nod-Krai now, the expeditionary force... even my fate, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751031,
					"content": "#The fact that we can sing around the bonfire, drinking and thinking about the future... None of that could've happened without your arrival, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751032,
					"content": "...Am I really that amazing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "...Hah, who's to say? Fate's fickle and hard to fathom, after all. But as long as you're alive, there's hope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751034,
					"content": "The wine we didn't drink tonight, we can have tomorrow — the lads'll save my share. As long as we're still breathing, tomorrow'll bring more wine and laughter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751035,
					"content": "So, cheers! To tomorrow! To hope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751028,
					"content": "That's the Knights of Favonius for you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "Didn't you say intelligence is the foundation of any campaign?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "On the very day the Dandelion Wine was due to arrive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751007,
					"content": "It's Apple Cider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751003,
					"content": "What're you doing drinking alone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				}
			]
		},
