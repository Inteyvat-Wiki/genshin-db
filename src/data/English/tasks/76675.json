				},
				{
					"id": 766750704,
					"content": "Let's talk a bit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750705
					]
				},
				{
					"id": 766750705,
					"content": "Jean and Albedo once sat me down to have a serious discussion about whether or not the Spark Knight needed to take part in basic training like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750706
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750706,
					"content": "A knight's basic training helps build character, but since the Spark Knight's still so young... I decided to get her opinion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750707
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750707,
					"content": "...She happily brought her bombs to the training grounds. And so, we reached a consensus: We won't discuss the matter again until she's a bit older.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
