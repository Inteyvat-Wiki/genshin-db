			"dialogs": [
				{
					"id": 766750401,
					"content": "—Hey, are you okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750402,
					"content": "I—I'm fine... Phew, good thing you guys showed up so fast, or I might not have made it by sundown.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750403
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750403,
					"content": "...Praise be! Our \"essential supplies\" made it through, safe and sound.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750404,
					"content": "Uh, what kind of supplies are that important...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750405,
						766750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750405,
					"content": "Booze. It's gotta be.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				},
				{
					"id": 766750407,
					"content": "Good eye! This here is the Dandelion Wine we specially ordered from Dawn Winery! Pure Mondstadt in a bottle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750408,
					"content": "You have no idea what it took us to get it here all the way from there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750409
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750409,
					"content": "Hah, and a fine job you did! You're drinking with us at the feast tonight. Whole camp's been looking forward to toasting you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750410
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750410,
					"content": "...So the only reason you were in a hurry was to make sure the drinks got there in time? And here Paimon thought you were finally being serious about something serious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750411,
					"content": "What's that? Are you saying drinking isn't the most serious of serious business? Because I'd love to have a drink right about... now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750412
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750412,
					"content": "W—Wait! Please, wait a second! Now's not a good time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750413
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750413,
					"content": "Yeah, listen to him! First, you gotta take care of the serious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750414,
					"content": "This is a custom brew, it needs to be kept constantly rolling to prevent settling and keep its flavor! Having sat for so long, I'd say the taste has degraded... by at least ten percent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750415
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750415,
					"content": "Ten percent!? Unacceptable! Nobody touches a drop 'til it's ready!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750416
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750416,
					"content": "...Ooookay. You do you, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750417,
					"content": "So, how can we bring it back up to scratch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750418
					]
				},
				{
					"id": 766750418,
					"content": "We specially commissioned someone to build a mechanism that keeps the barrels rolling... Looks like it broke in the fall, though. So now, I guess we'll have to rely on old-fashioned muscle power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750419
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750419,
					"content": "Hmm, so we just <color=#00E1FFFF>keep whacking the wooden barrels and roll 'em to their destination</color>...? Sounds like some good old Knights of Favonius strength training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750420,
					"content": "Wait, the Knights train that way?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750421
					]
				},
				{
					"id": 766750421,
					"content": "Aye, teaches force control and precision. Need both, or the barrel won't stay true to the path. It's basic training for many knights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750422,
						766750423
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750422,
					"content": "Consider my curiosity piqued.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750424,
					"content": "Hah, keen on basic drills, are we? Well, Laurent and the others won't be back for a while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750425
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750425,
					"content": "Right then, all yours. Don't worry about knocking 'em a bit too far. Just holler and I'll toss 'em back into place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750423,
					"content": "As the Honorary Knight, I'd like to try my hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750406,
					"content": "Why do I smell alcohol?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				}
			]
		},
		{
			"id": 7667505,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
