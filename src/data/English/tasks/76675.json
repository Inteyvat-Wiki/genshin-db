				},
				{
					"id": 766750604,
					"content": "Let's talk a bit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750605
					]
				},
				{
					"id": 766750605,
					"content": "First time I did this training with Razor, it took us an entire day to finish. Know why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750606
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750606,
					"content": "—He spent a quarter of the day rolling the barrels, and the other three quarters trying to figure out what the heck I was talking about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
