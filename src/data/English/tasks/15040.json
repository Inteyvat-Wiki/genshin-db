			"dialogs": [
				{
					"id": 150400701,
					"content": "Alright, we're here. This, ladies and gentlemen, is the Airborne Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400702
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400702,
					"content": "Whoa, it's so cool! I didn't expect it to be this big...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400703
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400703,
					"content": "Once it's painted, I bet we'll be able to see it from miles off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400704,
					"content": "Oh, for sure! As long as you're in an open area and the view isn't blocked by mountains, you'll be able to see it from anywhere — whether that's the rooftop pool on Huha Hill or the fjords on Tete Isle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400705
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400705,
					"content": "That's awesome! Your work's gonna be center stage — you've got this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400706,
					"content": "Man, I'm getting excited already! Should I go with my lucky color? Or maybe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400707
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400707,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400708
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400708,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400709
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400709,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400710
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400710,
					"content": "Wow, he sure had a lot to say this time, huh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400711,
					"content": "Did you catch any of that, Chasca? Mind translating for us again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400712,
					"content": "Hmm, that was a lot to take in. It'll take me some time to sort out all the different possibilities...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400713
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400713,
					"content": "#It's okay, I think I got the gist! The Asha wants to team up with me and compete against {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400714
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400714,
					"content": "He likes helping people out by working together with friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400715
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400715,
					"content": "But, it's the element of competition that turns ordinary activities into exciting adventures, and that's what he enjoys the most.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400716,
					"content": "He really said all that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400717,
					"content": "Haha, more or less! I filled in the gaps here and there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400718
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400718,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400719
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400719,
					"content": "From his reaction, it looks like you got it spot on. The bond between you guys really is growing stronger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400720
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400720,
					"content": "#Alright, Asha. I like that idea, but we should make sure {NICKNAME} thinks it sounds fun too, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400721
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400721,
					"content": "It's always important to check in with your friends and respect their opinions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400722
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400722,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400723,
						150400726,
						150400729
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400723,
					"content": "A chance to challenge our team captain — just what I've been waiting for.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400724
					]
				},
				{
					"id": 150400724,
					"content": "\"Then let the games begin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400725
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400725,
					"content": "Haha... Sorry, with you looking at me like that, I just can't say that with a straight face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400732,
					"content": "Alright, well if both teams are ready, then follow me! I'll be the referee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400726,
					"content": "As long as you two are happy, that's all that matters.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "#Hey, we can't be the only ones having fun! I want you to enjoy it too, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400728
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400728,
					"content": "C'mon, no stress! Let's just have fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400729,
					"content": "Even against all five of you, I'd still come out on top.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400730
					]
				},
				{
					"id": 150400730,
					"content": "I like the confidence! Alright then, I'll give it my all, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400731
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400731,
					"content": "Hey, how could you even think of going against Paimon! We're a team!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Paimon"
				}
			]
