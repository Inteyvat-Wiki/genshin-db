			"dialogs": [
				{
					"id": 411460101,
					"content": "I'll deliver it right now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411460102
					]
				},
				{
					"id": 411460102,
					"content": "Thank you so much. It's much too far away, and we haven't the people to spare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460103,
					"content": "Ah, yes, please be careful while you travel. <color=#00E1FFFF>Don't run too fast or use your wind glider. You definitely shouldn't climb either...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460104,
					"content": "If you takes too many bumps along the way, the meat sauce and spaghetti might come apart... and if that happens, I don't think the customer will accept it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
		{
			"id": 4114602,
