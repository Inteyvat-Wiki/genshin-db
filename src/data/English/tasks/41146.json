			"dialogs": [
				{
					"id": 411460301,
					"content": "I heard that someone placed a custom order...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411460302
					]
				},
				{
					"id": 411460302,
					"content": "Right, I believe a certain... Angelo ordered — and paid for — a serving of our Flaming Red Bolognese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460303,
					"content": "After that, he asked that we deliver it to him near Brightcrown Canyon. But that's some distance away, and I don't have anyone I can send there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411460304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411460304,
					"content": "If you're alright with it, could you help us deliver it to him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
		{
