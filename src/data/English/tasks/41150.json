				{
					"id": 411500301,
					"content": "I heard that someone placed a custom order...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411500302
					]
				},
				{
					"id": 411500302,
					"content": "So it's like this: that air-headed Ling'guan ordered some Come And Get It, saying that she'd come back and eat it later. But my money's on her having wandered off somewhere and gotten lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500303
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411500303,
					"content": "Go deliver this to her. <color=#00E1FFFF>Steady now, and don't run around however you like</color>, or it'll spill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500304
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>Try to avoid touching elemental stuff as well, or the taste might get all mixed up</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411500305,
					"content": "If it goes bad, come back here and I'll whip up another serving for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				}
