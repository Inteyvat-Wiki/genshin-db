				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060201,
					"content": "Eek! That guy just now... Did you see that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060202,
						722060203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060202,
					"content": "Nope.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				},
				{
					"id": 722060204,
					"content": "Uhh, that's just too spooky. Let's just grab a few mushrooms and get out of here, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060203,
					"content": "Must've been an illusion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				}
			]
		},
		{
			"id": 7220603,
			"completionStepIds": [
				7220605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220604",
							"3"
						],
						"stepId": 7220604,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220605",
							"2"
						],
						"stepId": 7220605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "Hey! Hey! Didn't I warn you lot before!? Are you hard of hearing, or do you just not have eyes, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060302,
					"content": "Oh, look, a ghost!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "Eek! Ghost? Where? Where!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060304,
					"content": "Right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "Aaaagh! Go! Shoo! Evil begone! By my clan's name, Abe, depart from this place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060307,
					"content": "...What? N—No! That can't be! I've... I've never encountered such a wicked spirit in all my years! Wh—Why aren't you leaving?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060308,
					"content": "Why, I've come from beyond this island.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "An evil spirit from beyond the Sea of Fog? I—I'm not afraid of you! Just you wait! Th—The Great Thunderbird will exorcise you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060310,
					"content": "Your Thunderbird is long gone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "Wh—What did you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060313,
					"content": "Everyone's left.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "What... What are you saying? D—Don't you try to scare me like that. Ohhh, I—I'm getting goosebumps already...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060316,
					"content": "Still, there have been fewer and fewer people on the island lately. Kina also told me that everyone was getting onboard the boat... *sigh* Who knows where that kid's run off to now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060317,
					"content": "Wait a moment. Spirit from beyond this island... Aren't you leaving too? On the silver boat by the seashore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060318,
					"content": "I saw no boat there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "Huh... I knew it. I knew outsiders wouldn't be able to see that boat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060321,
					"content": "Still, thanks for telling me to get onboard, evil spirit. It's... It's just that I've lived here for so long, and yet there's so much I still haven't seen or done... I can't just leave this place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060322,
					"content": "What will you need?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "Need? Eh? I mean, it's not as if I need anything. I'd just like to see something new, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060324,
					"content": "Once, when I was still very young, I made a bet with Una that there were different kinds of mushrooms outside our island, but she wouldn't believe me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060325,
					"content": "Later, her husband went out to sea, leaving for lands where the outsiders live. He never returned, and they say his spirit wanders the lands beyond... Poor guy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060326,
					"content": "Una's been living alone ever since then. Every time I think about it, I... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060327,
					"content": "Don't worry about her too much.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "I even begged the priest, you know? At the very least, we had to give someone a place to stay... Ah, right, right! The mushrooms!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060330,
					"content": "*cough* Well, I'll be boarding the boat soon, and I don't really have that many regrets... I just haven't seen anything that lies beyond our island. Still, that which concerns me most has to be those mushrooms I take care of every day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060331,
					"content": "Please, help me bring back some mushrooms from beyond the Sea of Fog. I'd love to see what they look like!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060332,
					"content": "Please help me, evil outsider spirit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060328,
					"content": "So about the mushrooms...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "That ship was not made to bear me hence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "It's time to leave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "The Sea of Fog is a thing of the past.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "That's me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
		{
			"id": 7220604,
