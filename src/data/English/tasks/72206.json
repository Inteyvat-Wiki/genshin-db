			"dialogs": [
				{
					"id": 722060401,
					"content": "How's it going? I'm ready and waiting to have my horizons broadened!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060402
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060402,
					"content": "Will these mushrooms do for you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7220605,
			"completionStepIds": [
				7220607
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220607",
							"2"
						],
						"stepId": 7220607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "Ooh! Haha... Wow, they've got such odd shapes! Do they have souls, too? Do they contain peoples' memories?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060502,
					"content": "And these soft, wing-like things... Can they fly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060503,
					"content": "Ah, me and my endless curiosity! The boatman's getting annoyed now, I think. I'm sorry, but I reckon I must go. Yes, I must...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		}
	]
