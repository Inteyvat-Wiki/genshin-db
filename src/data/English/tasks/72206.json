				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "Hey! I'm over here, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060102,
					"content": "Young people these days... Don't you kids have any kind of courtesy at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060103,
					"content": "S—Sorry!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "Hmph! That's more like it. As for those mushrooms, let's just call that my gift... But don't you touch the rest however you like!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060105,
					"content": "Are these your mushrooms?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "None of your business! Just stop picking them however you like and get out of here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		},
		{
			"id": 7220602,
			"completionStepIds": [
				7220603
			],
