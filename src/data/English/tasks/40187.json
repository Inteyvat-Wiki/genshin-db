			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-655,
							221,
							243
						],
						"pointId": 10621
					}
				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#Hey, {NICKNAME} and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870102,
					"content": "Oh, hey Xiangling! What's up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870103,
					"content": "You know what's up! Our get-together, of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870104,
					"content": "Ah, yes, finally time for that meal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "Yeah! You are free, right? You are not getting out of this without a very good reason!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870106,
					"content": "We're not the ones who held it up! That was Hu Tao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870107,
					"content": "Yeah, tell me about it... She thinks being a director gives her a license to be a flake. It's like, unless there's a sizeable crowd coming, it's not worth my time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870108,
					"content": "But don't worry — we've agreed that this time, we're not gonna accept any more excuses from her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870109,
					"content": "Oh? Who's \"we\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870110,
					"content": "Hehe, Xingqiu and I! He said he's been wanting to invite everyone out for a long time, but given the situation with his great-grandfather, he never had the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870111,
					"content": "But amazingly, on the night of the Lantern Rite, his great-grandfather suddenly woke up! Xingqiu was thrilled — and he was finally able to leave the house. So we met up right away and made a plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870112,
					"content": "Wow! So his great-grandfather's gonna be alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870113,
					"content": "Yep! They had a doctor take a look and everything. He'll be just fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870114,
					"content": "According to Xingqiu, his great-grandfather has been eating like Paimon since he woke up... so now, the family's biggest worry is that he'll get indigestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870115,
					"content": "Hmm... Well, that's good news, but somehow doesn't paint Paimon in the best light...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870116,
					"content": "Don't worry, it definitely does! Your appetite represents an optimistic outlook on life: \"Always eat to your heart's content, lest your chopsticks wither with regret\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870117,
					"content": "Well said, Xiangling! Yeah, that attitude is exactly what got Paimon to where she is today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870118,
					"content": "For real? How come I'm only hearing this for the first time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "Yes, for real! Like Xiangling said, always eat till your heart's content, and don't let your chopsticks... um, what was it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870120,
					"content": "Haha, don't worry. Save it for the dinner table, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870121,
					"content": "Hehe, no problem! But where are we gonna eat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870122,
					"content": "At Yilong Wharf, later tonight! Xingqiu and the others are still out there. Oh, and Hu Tao said that we'll be joined by a special guest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870123,
					"content": "Who is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "You'll see when you get there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870125,
					"content": "Ohhh! Paimon has an idea... But, she'll keep it to herself for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870126,
					"content": "I have an idea, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "Huh? Who?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870128,
					"content": "I'm keeping it to myself, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "Hmph! Well, we'll see who guessed right later tonight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
