			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Ningguang"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-647.266,
							258.226,
							428.226
						],
						"pointId": 10623
					}
				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "Hey, the crisis is resolved. Why the long face, Tianquan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870502,
					"content": "#Thanks to Director Hu and {NICKNAME}, disaster was averted. But we still do not know what caused the crisis in the first place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870503,
					"content": "I know you are well-informed, Captain. So I trust you are aware that the nation of Natlan has recently endured some major events relating to the Ley Lines and to issues of life and death.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870504,
					"content": "It makes me wonder whether these events might somehow be connected on a deeper level.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870505,
					"content": "If they are, then this'll be bigger than just Liyue and Natlan. I'll send word to my business partners, and keep an eye out for any similar incidents in the other nations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870506,
					"content": "Right now, though... I say, put those worries to one side and focus on enjoying these stunning sights before they disappear for another year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870507,
					"content": "Hehe, but of course. You don't need to teach me about work-life balance — I am no Keqing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870508,
					"content": "Is that right? Well then, why are you still wearing that same old hairpin? Didn't I tell you to use my pay to buy yourself a new one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870509,
					"content": "I wouldn't dare touch Captain Beidou's Mora without final confirmation. What if you'd been speaking in jest? I'd never hear the end of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870510,
					"content": "Hahaha, do I really have to go pick one out for you? Alright, suits me. Let's go take a stroll through the fair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870511,
					"content": "Well done... When did our straight-talking Captain learn to read between the lines, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870512,
					"content": "Hahaha, that's enough. Are you coming or not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870513,
					"content": "Why not? Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
