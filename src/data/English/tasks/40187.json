			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yun Jin"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2407.683,
							343.151,
							2388.574
						],
						"pointId": 10443
					},
					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "If we're talking the strongest... I'd have to pick Wind Reader. After all, he was the founding master of Qimen Divination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870302,
					"content": "Yeah! He gets my vote too, being my ancestor and everything. Oh, and also the silver swallow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870303,
					"content": "In that case, I'd have to nominate the Two Sages of Lianshan. It's always the ones who live in seclusion and never show their skill who turn out to be the most powerful of all. Well, in the books, anyway. What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870304,
					"content": "If this were a martial arts novel, then I'd agree with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870305,
					"content": "But unfortunately, after reading \"Moonlit Bamboo Forest,\" I am convinced that the title should go to the White Horse of the Three Immortals of Tao Dou. She's got to be hiding some kind of secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870306,
					"content": "Huh? Is no one gonna pick the Yunlai Angler? Even the Yuheng said that her sword-fighting style comes from the Yunlai Angler's rod-wielding techniques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870307,
					"content": "Yeah, so they say... But I mean, fishing? Just seems kinda lame in this context...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870308,
					"content": "Hmm... Although it's more common than you might think for anglers to be more than what they seem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870309,
					"content": "Hey, you're all wrong! The greatest of all were obviously Old Man Wuwang and the Lone Butterfly. Without them, there'd be no Wangsheng Funeral Parlor today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870310,
					"content": "Hard to argue with that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870311,
					"content": "Oh, everyone's here already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870312,
					"content": "#{NICKNAME}, Paimon, you're finally here! Welcome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870313,
					"content": "Ah! Hu Tao, your hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870314,
					"content": "Well noticed, Paimon. Yes, I added another plum branch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870315,
					"content": "#Ooh! So now you and {NICKNAME} have matching plum branches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870316,
					"content": "But um, anyway, what are you all up to?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870317,
					"content": "We're debating who's the best out of the Eight Adepts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870318,
					"content": "Hahaha, well kind of. An open-ended debate, maybe. We're just shooting the breeze really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870319,
					"content": "That's right. The only way you could settle a question like this would be with those special goggles they have in light novels, where you can read someone's power level just by looking at them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870320,
					"content": "Haha, has Xingqiu been getting you into light novels?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870321,
					"content": "#Welcome, {NICKNAME}. My family tell me that you and Hu Tao performed a very risky ceremony, and cured great-grandfather's illness in the process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870322,
					"content": "I cannot thank you enough for your efforts. No matter what kind of trouble you may encounter in the future, you will always find a helping hand at the Feiyun Commerce Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870323,
					"content": "It was a team effort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "Yeah, I know. My father and brother will thank everyone individually in the coming days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870325,
					"content": "Why go to all that trouble, Xingqiu? Save yourself the effort and just admit to me, here and now, that the strongest of the Eight Adepts are the Lone Butterfly and Old Man Wuwang! Then we'll be square.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870326,
					"content": "Come on, enough with the debate already! Everyone's here now, so let's eat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870327,
					"content": "Paimon, you're up! It's time to share your grand philosophy of life with everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870328,
					"content": "Uhh... O—Okay, umm... One sec... It's like, always eat to your heart's content, lest your... what was the rest, again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870329,
					"content": "Lest your chopsticks wither in regret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "Ahh, right, right! Yeah, that's it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870331,
					"content": "Whoa, Paimon, you can't stumble through a motto you live by! It's bad luck! It'll make your life full of stumbling blocks too. Come on, you can do it! One more time, from the top!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870332,
					"content": "Always eat to your heart's content! Lest your chopsticks wither in regret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870333,
					"content": "That's the spirit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "So, is it time to dig in now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870335,
					"content": "Paimon, did you forget about our special guest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870336,
					"content": "Oh, right! Paimon remembers now. Actually, Paimon guessed who it is already, but y'know, no point in saying it out loud or anything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870337,
					"content": "Hmm? You don't sound confident... You don't have a clue who it is, do you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870338,
					"content": "#Ugh, yes, actually! It's obvious who it is. It's, you-know-who, um... {NICKNAME}, a little help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870339,
					"content": "Is it Yun Jin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "Correct! It's our very own Yun Jin. So you haven't forgotten what she said last time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870341,
					"content": "Look, she's taking the stage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870342,
					"content": "Whoa! Isn't that the director of the Yun-Han Opera Troupe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "Lixing"
				},
				{
					"id": 401870343,
					"content": "Amazing! I never would've expected to see her all the way out here in Yilong Wharf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "Jiewu"
				},
				{
					"id": 401870344,
					"content": "Greetings, everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870345,
					"content": "I will perform \"The Sanctification of Tao Dou\" one more time, for all my friends who were unable to join the festivities during the Lantern Rite. My apologies for not being able to set up a grander stage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870346,
					"content": "Aww, that's so nice! She's doing a whole new performance for everyone who couldn't attend last time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870347,
					"content": "Shh! She's about to begin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870356,
					"content": "Recall the bold claims about Tao Dou",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870348,
					"content": "Through discordant tones and tragic fates, souls of two worlds, heed my call",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870349,
					"content": "What delusions thou hast, to set the realm flame with bones and blood",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870350,
					"content": "Shadows of war shall fade with time, while tales of salvation will ever live on",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870351,
					"content": "Sins must be paid once blood is spilled, the rules of life and death thou cannot confront",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870352,
					"content": "The ways of heaven shall ever point true, while selfish desires will lead to your doom",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870353,
					"content": "Pledges were made to vanquish evil, eight Adepts raised their blades against Tao Dou",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870354,
					"content": "Though the body is spent and soul washed away, dreams and ways will continue always",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870355,
					"content": "Swallows will return for a new nest, just as tears and branches will commemorate the day",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yun Jin"
				}
			]
		},
