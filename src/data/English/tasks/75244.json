			"dialogs": [
				{
					"id": 752440402,
					"content": "Still worried about those ruffians? Don't be. If you do run into them, just tell them my name and they'll leave you alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440403
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440403,
					"content": "But don't go asking me why now. The two of us were destined to meet — you even helped me get my hat back. Just think of it as a token of my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Rantiy"
				}
			]
		},
