			"dialogs": [
				{
					"id": 752440302,
					"content": "That's it! Oh, thank you so much! Now that I've got my sturdy hat again, I feel so much more at ease.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440303,
					"content": "It's a special helmet I had someone make for me — it can even block shots from a musket.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440307,
					"content": "You're overthinking things. It's just fishing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "It might sound crazy, but some time ago, there was a guy fishing right around here when someone shot out his eye. Might've been a musket, might've been a bow. Fishing's a dangerous sport, y'see?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440305,
					"content": "I heard tell the whole affair was some sort of power struggle in the Nod-Krai underworld... Who knows the truth? The fact that it happened at all means we should be careful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Rantiy"
				}
			]
		},
