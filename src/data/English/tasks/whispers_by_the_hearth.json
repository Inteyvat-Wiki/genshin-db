			"dialogs": [
				{
					"id": 742500201,
					"content": "Thank you for your hospitality, Lady Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500204,
					"content": "Alright, take care.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
