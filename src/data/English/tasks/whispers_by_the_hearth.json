			"dialogs": [
				{
					"id": 742500101,
					"content": "Come to think of it, I wasn't the most attentive host when you visited Snezhnaya before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500102,
					"content": "There's no need for that, Lady Sandrone. Even if we never sat down for a chat, you always provided us with the best refreshments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500103,
					"content": "*sigh* My apologies. I was too busy back then. I'll be sure to take better care of you the next time you visit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500104,
					"content": "Mm. You never let me try out your inventions before, either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500105,
					"content": "There were different reasons for that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500106,
					"content": "Hmph...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500107,
					"content": "Actually, Father told us not to disturb you wherever possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500108,
					"content": "Don't worry about that, I don't mind the occasional disturbance. You can come for tea whenever you feel like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500109,
					"content": "Really? A—Actually... I've always wanted to ask you to take a look at Pers... I have some ideas for improvements that I'd like to run past you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500110,
					"content": "Sure thing, that is my area of expertise, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500111,
					"content": "...Thank you, Lady Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500112,
					"content": "Mm. Is being a Harbinger really so tough?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500113,
					"content": "When you put it like that... I suppose it is a little. There's a lot to consider. Though most of my frustrations stem from my colleagues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500114,
					"content": "So that must mean... that getting along with others is a must-have skill?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500115,
					"content": "I suppose so... But I doubt you have much to worry about in that regard. At least, Lyney certainly doesn't.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500116,
					"content": "Haha, you flatter me, Lady Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500117,
					"content": "Do you want to be a Harbinger? Actually... Never mind. It's not my place to ask. Just pretend I said nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500118,
					"content": "Hmm... That's all a little far off for me. I'm certainly in no rush to think about it yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500119,
					"content": "If you became a Harbinger, wouldn't that mean you'd have no time to accompany us on missions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500120,
					"content": "In that case... Would that mean... Lynette and I would have to become Harbingers, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500121,
					"content": "I told you, stuff like that is too far off to think about!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500122,
					"content": "Besides, no matter where I go, I'll never leave you two behind. I promise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500123,
					"content": "Hah... Sometimes I really envy this little family you have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
