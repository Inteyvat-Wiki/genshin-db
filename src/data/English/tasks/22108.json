					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "I hope it turns up this time... there are so few leads left...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "What brings you here? If you'd like to learn more about the Guild, please talk to Katheryne over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080104,
					"content": "...Oh, you're an adventurer already? Please accept my apologies, I may be the Branch Master, but I am not well acquainted with the Guild's day-to-day business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080105,
					"content": "So I don't really know any of the newcomers... Having said that, you're no newcomer at all, are you? You look like a seasoned adventurer to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080106,
					"content": "In which case, maybe there's something you can help me with. I must emphasize though, this is not a guild quest but a personal commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080107,
					"content": "I'll take it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "I appreciate your enthusiasm, but it is highly unwise to accept a commission without examining the details first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080111,
					"content": "Your commission, should you choose to accept it, is to defeat two strong hilichurls who bear giant shields.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080112,
					"content": "Their shields are infused with Geo energy. Not terribly dangerous, but you should still proceed carefully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080113,
					"content": "All I need you to do is defeat them. Come and find me afterwards and you will be fairly compensated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080114,
					"content": "Oh, and if you come across anything sword-related, bring it back for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080115,
					"content": "If not, it doesn't matter. As long as you defeat the hilichurls you will receive your compensation. That's all. I will leave you to get ready now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080108,
					"content": "Give me more details, and I'll consider it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "A cautious response. I'm sure you learned the value of caution the hard way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2210802,
