					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080201,
					"content": "Have you defeated them yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080202,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "That's fine; please don't rush. An adventurer who acts in haste is sure to put themselves in harm's way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080204,
					"content": "That said... Think less haste, more speed. Because your compensation is based on how quickly you complete the assignment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2210803,
