			},
			"dialogs": [
				{
					"id": 221080301,
					"content": "Have you defeated them yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080302,
					"content": "Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "Efficient work! I'm impressed. Done like a true Adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080304,
					"content": "Here is your compensation. Thanks to you, things will be much safer around here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080305,
					"content": "I don't suppose you found anything to do with a sword?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080306,
					"content": "...I see. As I expected. Never mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080307,
					"content": "Thank you — here is your compensation. Enjoy the rest of your day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
