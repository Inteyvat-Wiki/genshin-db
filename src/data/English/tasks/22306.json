			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhang Shun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060101,
					"content": "Hmm, what to do, what to do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060102
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060103
					]
				},
				{
					"id": 223060103,
					"content": "I used to be a sailor with The Crux, until I suffered an unlucky injury...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060104
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060104,
					"content": "After I left the fleet I needed money, so I pawned a few Treasure Maps. I gave them to local businessman Bolai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060105
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060105,
					"content": "The agreement was that I would get a share of any treasure found. But I haven't heard a word from him since, and I suspect he hasn't even tried to look for the treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060106
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060106,
					"content": "I can't keep waiting around like this. Would you be willing to search for the treasure for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060107,
						223060109,
						223060116
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060107,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060108
					]
				},
				{
					"id": 223060108,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060120
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060120,
					"content": "Start by paying a visit to <color=#00E1FFFF>Bolai</color> to fetch the <color=#00E1FFFF>Treasure Maps</color>. Then, find the <color=#00E1FFFF>treasure</color> and <color=#00E1FFFF>take it to him</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060121
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060121,
					"content": "I spoke to him about it already. He will hold onto my share for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060109,
					"content": "What made you leave the fleet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060110
					]
				},
				{
					"id": 223060110,
					"content": "I realized that my past injury could flare up at any point and start causing real trouble. I couldn't let something like that put the rest of the crew at risk, so I chose to leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060111
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060111,
					"content": "I started selling a few odds and ends that I'd picked up over the years to earn a living. But business wasn't great and I soon ran out of things to sell anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060112
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060112,
					"content": "I used to own a few Treasure Maps. They were loot I picked up back in the day with the crew.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060113
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060113,
					"content": "In my condition though, it's enough of a struggle just to walk down the street... I can't exactly go shooting off around the world on a treasure hunt, can I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060114
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060114,
					"content": "So I pawned them, gave them to Bolai for a bit of cash.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060115
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060115,
					"content": "But it seems like he can't go and look for the treasure in person either. He is just a businessman, after all... So that's why I need your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060107,
						223060116
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060116,
					"content": "How much treasure are we talking?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060117
					]
				},
				{
					"id": 223060117,
					"content": "Oh, there won't be a huge amount. These were just low-profile treasure maps split among the crew members along with the rest of the loot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060118
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060118,
					"content": "The experienced crew of the fleet can always tell when there's a serious amount of treasure involved, and they'll track it down and bring it back to the ship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060119
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223060119,
					"content": "Any treasure we find will be on the smaller scale, but it will still be worth something. Certainly enough to split three ways... So good luck out there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060120
					],
					"speakerTitle": "Zhang Shun"
				}
			]
		},
