			"dialogs": [
				{
					"id": 223060501,
					"content": "If it wasn't for my injury... I could be out there chasing down even bigger treasure hoards with the captain and my old crew mates...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060502
					],
					"speakerTitle": "Zhang Shun"
				},
				{
