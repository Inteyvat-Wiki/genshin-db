				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "Uh... Huh? Who art thou who disturb my beauty sleep...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150402,
					"content": "Eh!? Wh—Who's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "Agh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150404,
					"content": "Waaaah!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "Hahahahaha! Yes, yes! To fear me is only natural! Were I unconfined to this stone, you would already be in mine belly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150406,
					"content": "What...? Ah! So you're just a talking stone statue... Paimon thought you were a monster of some sort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "Hmph! What dost thou mean, \"just a talking stone statue\"!? Would not one such be frightening in itself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150408,
					"content": "Uh, we've come across many statues like you before, is the thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "Wh—What!? *sigh* Fine. Seems like there's no scaring you guys...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150410,
					"content": "Why must you do that, anyway? Sheesh! You're just a stone statue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "Hmph! Even if I was \"just a stone statue,\" this place is still the Herblord's abode! When she was yet with us, she did not appreciate others disturbing her peace at their liberty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150412,
					"content": "And that's why I scare all the pesky ones away! I shall continue to do so even if she isn't around anymore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150413,
					"content": "Nevertheless, your presence does feel somewhat different from that of those ordinary mortals, and considering that I couldn't scare you either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150414,
					"content": "May I please ask you for a favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150415,
					"content": "Huh? What can we help you with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "Ahem. Take a look at these colorful butterflies! Ever since the abode's lord departed, these little things have scattered all over the place, flying about as they please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150417,
					"content": "Shh... Hang on, there's one on your head! Just a moment. We'll help you get it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
