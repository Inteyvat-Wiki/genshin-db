							176.293,
							1792.852
						],
						"pointId": 310100247
					}
				]
			},
			"dialogs": [
				{
					"id": 711150601,
					"content": "Phew... Yep, just like that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150602,
					"content": "The abode's Herblord previously used these colorful butterflies to adorn its door, but that mechanism was later destroyed. These colorful butterflies and the medicine jar were originally meant to nourish the adeptal tree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150603,
					"content": "Adeptal tree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "Heh, that's right! Back then, the Herblord planted this adeptal tree herself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150605,
					"content": "It may be withered now, but the Herblord said that so long as the colorful butterflies haven't all dispersed, the tree can be revived!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150606,
					"content": "*sigh* She departed as soon as she lost the power to maintain her human form. I wonder how she's doing these days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150607,
					"content": "So what am I supposed to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "Ah, my apologies. I got a little carried away reminiscing about my lord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150609,
					"content": "Ahem! Listen carefully, humans! As long as those colorful butterflies get put back into the jar, we can then nourish the withered tree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150610,
					"content": "Heh, this is the adeptal mechanism designed by the Herblord. Pretty amazing, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150611,
					"content": "Let me give it a try.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "Sure thing. I'm counting on you then, kind humans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150613,
					"content": "Why colorful butterflies?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "Eh? Yeah, why is that... Perhaps the Herblord was just really into colorful butterflies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711150615,
					"content": "Uh... Anyway, I'm counting on you to get them back into the jar, kind humans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				}
			]
		},
