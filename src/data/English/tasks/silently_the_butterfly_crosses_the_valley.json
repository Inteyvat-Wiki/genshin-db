				]
			},
			"dialogs": [
				{
					"id": 711151101,
					"content": "Hey! You liar! We've already returned all the colorful butterflies to the jar, but the adeptal tree still looks the same to Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "Hmm...? Who art thou, to disturb mine... Ah, it's you, kind humans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151103,
					"content": "Ooh! I never thought you'd actually be able to find all the colorful butterflies! I just said that on a whim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151104,
					"content": "No, I meant... I felt the adeptal energies too! We just need to recite the formula that Herblord left us and we can revive the adeptal tree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151105,
					"content": "Hold on, how did that chant go again...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151106,
					"content": "\"...Born in winter, thriving and withering through time. But I yearn for spring when beauty is regained...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151107,
					"content": "Butterflies flutter... flutter... Uh, I don't remember what comes next, but it ends with all being revived!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				}
			]
		},
