			"dialogs": [
				{
					"id": 711151201,
					"content": "Whoa, it's changed completely!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151202,
					"content": "Since the Herblord entrusted the tree to me, I couldn't stand to see it continue to wither! Thank you, kind humans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151203
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151203,
					"content": "You couldn't even remember the phrase at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151204,
					"content": "Eh, don't sweat the small stuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "Carefree Simulacrum"
				},
				{
					"id": 711151205,
					"content": "Oh, if you're interested, I can give you a secret tip! Break off a branch and put it in the broken jar outside the abode, and the stone gate will open...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carefree Simulacrum"
				}
			]
