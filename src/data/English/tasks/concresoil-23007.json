					"nextDialogs": [
						230070303
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070303,
					"content": "But I'm just a bricklayer, and well, hitting Whopperflowers with a brick is hardly going to help me get a hold of that soil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070304
					],
					"speakerTitle": "Akim"
				},
				{
