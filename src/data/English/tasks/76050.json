					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500903
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500903,
					"content": "Hehe, guess this means we did good?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500904,
					"content": "They really are so soft and squishy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500905
					]
				},
				{
					"id": 760500905,
					"content": "Wait, we get a reward even though we got it wrong? Huh, well... Paimon doesn't mind a consolation prize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500906,
					"content": "Who's a good little kuuhenki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500907
					]
				},
				{
					"id": 760500907,
					"content": "The kuuhenki have taken a liking to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500908
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500908,
					"content": "I can feel it... They are at ease in your presence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500909
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500909,
					"content": "Just as Rimehorn Deer fawns are given to bathing in the moonlight, so too are the kuuhenki drawn to that which radiates from your heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500910
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500910,
					"content": "Oh? And what would that be, exactly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500911,
					"content": "A certain kindness and gentleness, I suppose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		}
	]
