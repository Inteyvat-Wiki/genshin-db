			"dialogs": [
				{
					"id": 760500301,
					"content": "All you need to do is guess the image.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500302
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500302,
					"content": "Huh? B—But... it's way too abstract!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500303,
					"content": "Did you actually manage to get the right answer when you played, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500304,
					"content": "No, I guessed wrong more often than not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500305
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500305,
					"content": "#Huh, well Paimon's gonna quit while she's ahead... Why don't you take a guess, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500306,
						760500310,
						760500315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500306,
					"content": "It's... a Rimehorn Deer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500307
					]
				},
				{
					"id": 760500307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500308
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500308,
					"content": "Whoa, that reaction must mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500309,
					"content": "Congratulations, your answer is correct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500310,
					"content": "It's... a Long-Necked Rhino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500311
					]
				},
				{
					"id": 760500311,
					"content": "Yikes! A Long-Necked Rhino with a serious neck injury, maybe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500312,
					"content": "Hmm... I've never seen such a creature before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500313
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500313,
					"content": "The correct answer was \"Rimehorn Deer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500314
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500314,
					"content": "Come back now, little ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500315,
					"content": "A harpoon with one prong bent backwards.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500316
					]
				},
				{
					"id": 760500316,
					"content": "You sure have a wild imagination...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500317,
					"content": "Heh... An amusing answer, to be sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500318
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500318,
					"content": "The correct answer was \"Rimehorn Deer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500319
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500319,
					"content": "Come back now, little ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
