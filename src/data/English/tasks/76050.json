			"dialogs": [
				{
					"id": 760500101,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500102
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500102,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500103,
					"content": "Wow, it's so lively here today! All those kuuhenki are dancing around Columbina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500104,
					"content": "Uh, wait a sec... That's not dancing. Looks more like they're trying to... bury her alive in a pile of cuteness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500105,
					"content": "H—Help me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500106,
					"content": "Give me your hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Phew... Thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500108,
					"content": "Why were the kuuhenki acting like that just now...? They're not usually that energetic, are they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500109,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500110,
					"content": "Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500111,
					"content": "I decided to play a game with the little ones, and it seems they became quite invested...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500112,
					"content": "Crowding around you like that after playtime... Kinda like puppies, aren't they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500113,
					"content": "Maybe that's their way of showing gratitude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Mm... Only this time, their gratitude felt more like getting caught in an unexpected snow drift...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500115,
					"content": "You say that, but Paimon bets you never pass up a chance to spoil them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500116,
					"content": "In any case, would the two of you like to give it a try?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500117,
					"content": "You mean... being surrounded like that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Hm... That can be arranged. You just need to get the right answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500121,
					"content": "Oh, sure thing. It'll be cool to see what sort of game's got the kuuhenki so obsessed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500122,
					"content": "Go on now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760500123,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500119,
					"content": "You mean... playing a game with the kuuhenki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
					"content": "Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "The Damselette"
				}
			]
		},
