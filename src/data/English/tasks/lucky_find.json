				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Olaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030201,
					"content": "Brr... So, so c—cold...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030202
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030202,
					"content": "He's shivering! We need to warm him up, quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030203
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030203,
					"content": "Make a fire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030204,
					"content": "Hot soup would be even better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030205
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030205,
					"content": "#{NICKNAME}, how about I look after him while you make him a <color=#00E1FFFF>nice warm bowl of soup</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030206,
					"content": "We passed a hilichurl camp on the way here. There'll almost certainly be a campfire there to cook on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030207,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030208
					]
				},
				{
					"id": 110030208,
					"content": "Great. Be as quick as you can!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100304,
			"completionStepIds": [
				1100304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100304",
							"2"
						],
						"stepId": 1100304,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"108021",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Olaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030401,
					"content": "Mmm... That is better... That is better...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030402
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030402,
					"content": "Thank you. That soup really did the trick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030403
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030403,
					"content": "What happened, did you get frozen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030404
					]
				},
				{
					"id": 110030404,
					"content": "Yes. I was chasing a boar, and after chasing him all this way he slipped into those underground ruins over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030405
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030405,
					"content": "I followed him inside, but ran into a Cryo Regisvine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030406
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030406,
					"content": "It froze me instantly. When I woke up I ran straight outside, but... I only made it this far before my strength failed me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030407
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030407,
					"content": "Cryo Regisvine? Vines... attack people?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030408
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030408,
					"content": "They do now! I'd heard of them before from others, but this was the first time seeing one with my own eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030409
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030409,
					"content": "Yikes, we should definitely keep our distance from the ruins... It sounds dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030410,
					"content": "It sounds delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030411,
						110030412
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030411,
					"content": "...Seriously?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				},
				{
					"id": 110030413,
					"content": "That's it! The missing ingredient! The icing on the cake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030414
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030414,
					"content": "Calm down. Can we really eat a tree that's that aggressive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030415,
					"content": "Only one way to find out — let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030416
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030416,
					"content": "*sigh* Off she goes again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030417,
						110030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030417,
					"content": "We need to go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030419,
					"content": "Do not worry about me, I'll be fine. But you must stop her, she is putting herself in grave danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030418,
					"content": "You should get back to Springvale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030412,
					"content": "Does anything NOT make you think about food?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				}
			]
		},
