					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145001,
					"content": "I submit that we must earn some Mora, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "I have heard that there is a theater in Sumeru City and that they are looking for someone to do some calculations for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "Besides, the stage crew... You know, they earn quite some Mora, but they have no idea how to keep track of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "I sense opportunity here, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Why, your talent in accounting and business is most astounding, my dear Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145006,
					"content": "Still, give me a second, let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
