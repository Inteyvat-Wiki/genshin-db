						230145602
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145602,
					"content": "Have you been in correspondence with Kaia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145603
					]
				},
				{
					"id": 230145603,
					"content": "Unfortunately, Ms. Kaia hasn't sent back any letters yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145604
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145604,
					"content": "And my plan to send letters to Ms. Kaia failed because I didn't know where to send them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145605
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145605,
					"content": "Have no idea where Ms. Kaia is traveling now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
