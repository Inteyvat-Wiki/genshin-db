			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "Ugh... Lutong, I need a hand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145502,
					"content": "Sir, you'd better go back and get some sleep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145503,
					"content": "Traveler, perfect timing! Come over here. I would like to ask a favor of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145504,
					"content": "What's wrong with him?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Well, in a word... Mr. Garcia had too much coffee and too little sleep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145506,
					"content": "Fortunately, it's coffee he drank, not wine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145507,
					"content": "Lutong, uh... We have to find some more insignias... You know, the ones that the Treasure Hoarders carry around with them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145508,
					"content": "Traveler! You are here. Sorry, I didn't see you there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145509,
					"content": "Would you like to get me some of those insignias? Just a few will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145510,
					"content": "You should take a break.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "It's okay. I'm fine. I know what I'm doing. It's just that my hands play tricks on me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145514,
					"content": "Anyway, please bring back some insignias, and you will get paid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145515,
					"content": "Once you've got it, just bring it to me. I want to take a closer look. A perfect bearing must be made this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145512,
					"content": "Never thought coffee was that effective.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "It's not the coffee. Mr. Garcia doesn't want to sleep...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Lutong"
				}
			]
		},
