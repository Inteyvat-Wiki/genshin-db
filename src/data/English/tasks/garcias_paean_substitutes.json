					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140305,
					"content": "Ugh, Mr. Garcia's accounts... Sorting them out really is a headache...",
