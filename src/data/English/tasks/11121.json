			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bravo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Excuse me sir, are you one of the workers here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "Ah! Yes, yes! You must be here about the disappearance. Please find them if you can!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210303,
					"content": "I... I don't know what happened. The weather was gloomy that day, the foreman left with a few men.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210304,
					"content": "I stayed behind with the other four. After a while I decided to take a break... just to catch my breath!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210305,
					"content": "I ended up falling asleep in the shelter inside. When I woke up, there was no sight of them! I'd only just been speaking with them and suddenly... they'd vanished...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210306,
					"content": "Maybe... maybe I'm next...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210307,
					"content": "So the men that were out working disappeared, with the only one left to tell the tale having been asleep in a shelter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "Perhaps an accident occurred on-site.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "Oh... What a scary thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "An on-site accident... We should note that down too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Over here! What's this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "A pile of shirts, some trousers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "A few everyday items, they must belong to Uncle Dai and his men.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "One, two, three, four...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Huh... that seems right. Ten shirts, ten pairs of trousers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "These must be spares, right? Look, Uncle Dai's clothes are identical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "The four of them have been gone for six days without a change of clothes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "There's also a few handkerchiefs and some soap lying around... Oh, and some tool belts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "Items for washing one's face before the dawn shift... mining equipment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "So... they didn't take any supplies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "Hmm, correct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "Maybe they didn't need them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Improbable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "There are four pickaxes missing. It seems likely they left with the tools of their trade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "They had time to take their tools, but not their everyday items? Curious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Huh... why would someone set off with their tools, but leave their luggage behind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "One: They were working close by and didn't need to move their personal effects. But seeing as they've yet to return, this seems an unlikely hypothesis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "Or, two: They were forced to leave and had no time to think about their supplies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "Oh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Do you think... someone kidnapped them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "It's certainly a possibility. We'll need more clues before any further inference can be made.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "If they didn't leave, maybe they were made to leave... Let's make a note and let Uncle Dai know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "Maybe they just forgot them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uncle Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "You're back! How are the investigations going?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210702,
					"content": "We found three clues in the vicinity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "First, there are four missing pickaxes, yet everyday items are still in their place. This suggests that your men didn't leave of their own accord, but were forced to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "Forced to!? But... who would kidnap miners?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210705,
					"content": "Who, indeed. Second, there were five workers at the mine. One of them left the site to take respite. When he awoke, his colleagues had disappeared without a trace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Those who kept working all disappeared. The one who left early emerged safe and sound. It would appear that the incident occurred on-site.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Now that you mention it, I recall Bravo saying that he took a break.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210708,
					"content": "Could someone have entered the site and simply walked away with them!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210709,
					"content": "This leads me to my third point. Mr. Kun Jun here made good use of his... expert techniques... to arrive at a conclusion. It was a child that took your men away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "A child!? But there are no settlements here for miles around! There's no way a child would have made it over to the mine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210711,
					"content": "Unlikely as it sounds, that's our conclusion. Your men were following a child.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "Where did they go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210713,
					"content": "We believe that they followed the road north, away from the mine and toward the ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "North! Right, I'll rally my men and head in pursuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210715,
					"content": "Do you need help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "You've been invaluable to the investigation, but leave the legwork to us. If we set off now and make haste, we might be able to catch them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210717,
					"content": "Not so fast. The incident occurred six days ago. Even if they set out on foot, they will have covered a lot of ground by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "*sigh* You're right... New plan. I'll lead my search party over to the settlements further out and make some inquiries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210719,
					"content": "There are only a few settlements around here with lodging for the night. We'll go investigate and see if we can come up with anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210720,
					"content": "In the meantime you could keep looking for clues. If we don't see each other, let's reconvene at Wangshu Inn tomorrow evening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210721,
					"content": "Agreed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "Alright, me and my men will get going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210723,
					"content": "So... they're gonna talk to the people over at the settlements, while we keep investigating here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "Correct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "But... there aren't any more clues at the mine... Shouldn't we go north?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Wait... I believe we're missing someone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Oh yeah, where's Kun Jun? Paimon bets he's still investigating. Let's go find him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
							"2"
						],
						"stepId": 1112108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "Kun Jun! What are you searching for? We're all out of clues! Let's get going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210802,
					"content": "Ah, apologies, I'm conducting a quick search for my own benefit. I'm looking for a precious stone known as Dragonfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210803,
					"content": "Dragonfall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Never heard of it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "Dragonfall is often used in forging. What use do you have for it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "I... I don't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "I—I'm sorry, I don't recall why I'm seeking it... I've been feeling very... absent lately. Name and address aside, I'm having trouble remembering things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "In fact, I've been feeling extremely... anxious... as if there's something I've forgotten to finish. It's... an unpleasant sensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "Oh, Paimon knows that feeling! When you know you've forgotten something but you can't remember exactly what it is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "Ugh... I don't even know where to start with it, I've been... aimlessly wandering. That day at the market, I overheard a conversation while I was buying something. They mentioned Dragonfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "It sounded so familiar to me, as if whatever it was I had to do was linked to that stone... So I decided to look for some.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Perhaps if I can retrieve some, I'll remember what it is I have to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "I see... If I am able to during our endeavour, I will help you look for this stone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "Really? Oh, thank you Mr. Zhongli! You're too kind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "Think nothing of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "Shouldn't we get going?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Heading north from The Chasm, we'll reach Lingju Pass. If this is indeed the path they chose, there will be traces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "Great! Let's have a look!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "Not my area of expertise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
