				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uncle Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Whoa, this mine is huge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210102,
					"content": "This is where the incident occurred.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210103,
					"content": "Six days ago, a group of us left the site to attend to other matters. When we returned, the four men we'd left behind had vanished.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210104,
					"content": "I led a team around the entire mine but found no trace. That's when I decided to enlist help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210105,
					"content": "So four miners have disappeared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210106,
					"content": "Yes. There were ten of us. We lost Long, Bold Cen, Brave Cen, and Mao. I worked with all of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210107,
					"content": "Workers in this trade are usually young men in the prime of their lives. Could it be that the four of them left for another mine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210108,
					"content": "Unlikely. There's no other lodging for miles around, and we didn't pass any other mines on the way over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210109,
					"content": "Huh... such a huge mine. Did you really manage to explore every corner?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210110,
					"content": "Underground, overground... we left no stone unturned. We tried everything short of digging further into the earth itself. How could four sturdy young men just vanish into the bedrock?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Uncle Dai"
				},
				{
					"id": 111210111,
					"content": "We'll need to explore the site ourselves before extracting any conclusions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210112,
					"content": "Very well, I'll wait here, please proceed wherever you'd like. If you come across any clues, let me know straight away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uncle Dai"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
