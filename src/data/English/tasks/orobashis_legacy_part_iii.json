			"dialogs": [
				{
					"id": 721310101,
					"content": "The strange stone lantern seems to emit an ominous energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721310102,
					"content": "Is this... a stone lantern? Why is there a stone lantern here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Well, someone's written something on the lamp post. Shall we go have a look?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "\"Fellow workers, if you have any questions about this ward, please go to the Musoujin Gorge and talk to Mr. Kaji.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721310105,
					"content": "The handwriting looks new. There are a few small rough lines of writing below:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721310106,
					"content": "\"I'm sorry, but we can't help you either. We just received evacuation orders from the commissioner yesterday.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721310107,
					"content": "\"I hope I can see you again someday and discuss how to solve our Tatarigami problem.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 721310108,
					"content": "This Mr. Kaji seems to be pretty concerned about these stone lanterns. Why don't we go to Musoujin Gorge and ask him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
