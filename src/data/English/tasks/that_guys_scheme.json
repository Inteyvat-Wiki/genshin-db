			"dialogs": [
				{
					"id": 411245201,
					"content": "You haven't set off yet? Ah, yes... You must have some other questions, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245202,
						411245205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245202,
					"content": "Who's this gentleman, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245203
					]
				},
				{
					"id": 411245203,
					"content": "Hmm. That gentleman is an old acquaintance of yours, really. He says that you even fought side by side for a time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245204,
					"content": "I can't give you his name, though. That would be on my head for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245205,
					"content": "Why don't we just bring all those Treasure Hoarders in directly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245206
					]
				},
				{
					"id": 411245206,
					"content": "You mean to say that even if we do defeat the three bands of Treasure Hoarders lured in by our messages, the rest will simply flee after hearing the news, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245207,
					"content": "Well, that's true, but this is precisely the intention. That gentleman doesn't wish to catch them all, but to send them a little shock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245208,
					"content": "Under the present circumstances, the Knights cannot spare the people to undertake a large manhunt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245209,
					"content": "In any case, the falling meteorites are the top priority at present.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245210,
					"content": "As for Treasure Hoarders, they just need to be... convinced to stop making trouble for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
