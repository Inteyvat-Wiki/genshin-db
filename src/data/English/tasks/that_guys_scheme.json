				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "Have you planted the letters?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240602,
					"content": "Indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "That will do. I trust that the Treasure Hunters will make their plans based on the intelligence contained within those letters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240604,
					"content": "And that \"ideal moment\" should be somewhere between nightfall and dawn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240605,
					"content": "As for the \"ideal entry point...\" Well, there can only be one, yes? Come, I'll mark it out on your map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240606,
					"content": "Well, that should do it. All we need to do now is wait for those Treasure Hoarders to walk into our trap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240607,
					"content": "What if the Knights of Favonius find out?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "Well, your concerns do have merit. Our unorthodox methods, if discovered by the Knights, could land us in hot water...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240609,
					"content": "But rest assured, that gentleman has guaranteed that no such trouble will occur. So let's just... have a little faith, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240612,
					"content": "So, all you need to do is to wait till nightfall, and defeat our entrapped Treasure Hoarders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240610,
					"content": "What if the Treasure Hoarders don't show up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
				{
					"id": 411240611,
					"content": "Oh, they will, alright. Don't you worry about that. These plans were laid by that gentleman himself. Nothing will go wrong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112408,
			"completionStepIds": [
				4112408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112408",
							"2"
						],
						"stepId": 4112408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240801,
					"content": "Have those Treasure Hoarders been taken care of?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240802
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240802,
					"content": "Very well taken care of, indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240803
					]
				},
				{
					"id": 411240803,
					"content": "Haha, I'd expect no less from someone who's caught that gentleman's eye. You're very efficient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240804
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240804,
					"content": "Here's your compensation. It was a... pleasure working with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240805
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240805,
					"content": "If fortune permits, we'll have a chance to do business again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112452,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"4112406",
							"1"
						]
					},
					{
