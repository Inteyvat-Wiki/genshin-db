				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "Oh my, you're here at last. I've been waiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240202,
					"content": "Whatever for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "Come on, don't be so cold. I have something very important to ask of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240204,
					"content": "I'm sure you've seen those meteorites. Though none of them landed inside the city of Mondstadt, the whole place is in an uproar all the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240205,
					"content": "And where there's muddied water, there will be fish that don't belong trying to slip in unnoticed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240206,
					"content": "You mean the Treasure Hoarders.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "Aha, aren't you keen? That's an experienced adventurer for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240212,
					"content": "Though the Knights are on high alert, there's bound to be some gaps in their defenses, what with having to send help to the areas around the city and all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240213,
					"content": "Those money-grubbing Treasure Hoarders have surely made plans to slip through those gaps and \"make a killing,\" as they say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240214,
					"content": "So, where do I fit in?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "Oh my, what a straightforward answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240216,
					"content": "It seems like the contingency plan that gentleman gave me was unnecessary after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240222,
					"content": "Well, simply put, that gentleman has apprehended the Treasure Hoarders who were scouting us out previously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240223,
					"content": "According to them, there are three bands of these bandits looking to slip in during the chaos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240224,
					"content": "So we'll play along, and help them create the ideal opening...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240225,
					"content": "And where do I come in?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "What you have to do is simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240232,
					"content": "To ensure that not everyone would be caught, the Treasure Hoarder scouts didn't report back directly. Instead, they would leave the intel they'd gathered in letters that would then be left in specially designated locations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240233,
					"content": "To avoid any other problems from occurring, they also sent three scouts, who would then send the intelligence they gathered to three different locations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240234,
					"content": "I doubt they expected that all three would be caught by that gentleman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240235,
					"content": "The other Treasure Hoarders will only begin to plan their next move after receiving this intelligence, all the better to choose the best point of entry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240236,
					"content": "But we'll spare them the trouble this time. That gentleman has already made most detailed plans for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240237,
					"content": "Take these three letters with you, and place them at the locations designated by the Treasure Hoarders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240238,
					"content": "Once that's done, come back and report to me. As for what comes next... Let's discuss that later, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240226,
					"content": "Can their word be trusted?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "Haha, you're very cautious, aren't you? Don't worry, the Treasure Hoarders are quite the spineless lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240228,
					"content": "They are, in the end, just a bunch of small-timers who're in it for the money.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240229,
					"content": "\"There's Mora in it for you if you work with us, but if you try anything funny...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240230,
					"content": "They were quite quick to cooperate once we reached this amicable understanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240217,
					"content": "The Knights can handle it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "Haha, I thought you might say that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240219,
					"content": "Don't you worry about a thing, that gentleman has prepared quite the budget this time around. You stand to be well-compensated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240220,
					"content": "And if you should pick anything up while going about this business, it's yours to keep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240221,
					"content": "What's more, this task requires your unique touch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240208,
					"content": "You mean the hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "Haha, of course not. How would they even blend in?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240210,
					"content": "I'm sure the knights would be all too ready for them if they even tried getting close to the walls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240211,
					"content": "I'm talking about the Treasure Hoarders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
