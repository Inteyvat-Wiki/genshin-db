			"dialogs": [
				{
					"id": 735200301,
					"content": "There's a hole in the tree. It seems completely empty, and there's nothing in it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200302,
					"content": "Eh? Wait! There's a note there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200303,
					"content": "\"The good Nara taught Arakasyapa how to read. Arakasyapa must protect the good Nara...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200304,
					"content": "What's this supposed to mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
