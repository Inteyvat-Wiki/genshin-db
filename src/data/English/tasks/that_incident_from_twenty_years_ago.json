			"dialogs": [
				{
					"id": 735200101,
					"content": "Have you decided to buy information from me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Hmmm... Paimon's a little curious about your exclusive information, but we need to hear the price first! If it's too expensive, then forget it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "I'll sell it to you for the fixed price of one million Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "That's a lot! Never mind, one million Mora can buy lots and lots of tasty food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Wait a sec... Let me see... Eh? Paimon is customer number 1,001 for today. The original cost of the information was one million Mora, but for you the price is now free!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "Eh!? Paimon didn't know such luck exists!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Wait, you're not baiting us into spending, are you? Maybe the first sentence is free, but not the next sentence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "If you don't want it, fine! Next!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "Wait, wait, wait, forget what Paimon said. We'll listen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "Dori's exclusive scoop number one! Do you remember the Diadem of Knowledge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Paimon remembers that only the champion was entitled to wear the diadem. It seemed very valuable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "Exactly. The diadem that Sachin gave the Akademiya was a rather expensive antique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Yet this very diadem, after it was donated to the Akademiya, was lost by them once before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "Eh? Why didn't we hear about this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Hehe... if everyone knew about this, would my information still be considered \"exclusive\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Of course, this information doesn't come from nowhere. I've got witnesses, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "There's a young fellow named Kashmer from the suburbs. If you're interested in delving further, you could ask him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "The password is \"that incident from twenty years ago\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
