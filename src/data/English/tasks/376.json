						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37607",
							"2"
						],
						"stepId": 37607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "Ah, Master Diluc. Have you seen two thieves around?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760602,
					"content": "What happened? Why have you mobilized so many guards?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760603,
					"content": "Haven't you heard, Master Diluc? Two thieves were trying to steal the Holy Lyre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760604,
					"content": "Oh? How odd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760605,
					"content": "Isn't it? The Holy Lyre is a treasure that was played by the God of Anemo themselves. Such a precious piece of cultural heritage—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760606,
					"content": "Why would one want to steal something they can't sell off? Would pay better to steal from my cellars...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760607,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760608,
					"content": "Sorry, off topic. Believe they headed that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760609,
					"content": "Understood. Thank you, Master Diluc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miles"
				}
			]
		},
		{
			"id": 37607,
			"completionStepIds": [
				37608
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37607",
