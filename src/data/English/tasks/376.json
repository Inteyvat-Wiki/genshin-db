						],
						"stepId": 37607,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37608",
							"2"
						],
						"stepId": 37608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760701,
					"content": "Today I think I'll have a glass of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760702,
					"content": "You can put down that bottle you stole from behind the counter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760703
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760703,
					"content": "...something cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760704,
					"content": "Right. I want answers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760705
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760705,
					"content": "Lemme finish my drink first? I'll pay you — well, with a performance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760706,
					"content": "It's not about money. You seem too young to be drinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760707
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760708,
					"content": "How about answering my question first?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760709
					]
				},
				{
					"id": 3760710,
					"content": "Actually... yeah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760711
					]
				},
				{
					"id": 3760707,
					"content": "No need to worry. When I started drinking, you were still—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760708,
						3760710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760709,
					"content": "Oh, you wanna ask \"Who's this?\" Am I right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760711,
					"content": "He is Master <color=#00E1FFFF>Diluc</color>, the boss of... ah, the owner of this tavern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760712,
					"content": "He's very famous. By the way, his dandelion wine is one of my favorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760713,
					"content": "Though most of the time I can only afford a bottle or two...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760714,
					"content": "I just heard about some thieves from the guards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760715
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760715,
					"content": "For the record, I like your guts for trying to steal the Holy Lyre der Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760716
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760716,
					"content": "Even if you are fools... but we don't often get to see people like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760717
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760717,
					"content": "It wasn't us that stole it! The real thief is still out there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3760718,
					"content": "This is the hotshot of the Knights of Favonius. Why would someone so aspiring steal Mondstadt's sacred treasure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760719,
					"content": "Hotshot...? Oh, so it's you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760720
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760721,
					"content": "We're not close, actually.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760722,
					"content": "I've only heard him play once.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760720,
					"content": "So, you and the bard are close friends?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760721,
						3760722
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760723,
					"content": "Well... Despite only being a passing traveler, you still offered your help to Mondstadt in its time of need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760724
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760724,
					"content": "A shame you joined the Knights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760725
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760725,
					"content": "The Knights of Favonius... Inefficient right from beginning to end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760726
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760726,
					"content": "And towards the <color=#00E1FFFF>Fatui</color>? Weak and conservative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760727
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760727,
					"content": "Forget it. I don't feel like talking about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760728
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760728,
					"content": "Seems you don't really like the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760729,
					"content": "Just differences in approach is all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760730
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760730,
					"content": "I have my own hopes for this city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760731
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760731,
					"content": "Now, answers. Why did you steal the Holy Lyre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760732
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760732,
					"content": "You sure you want to know? It could implicate you in the affairs of the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760733,
					"content": "That's fine. I somehow always end up implicated in their affairs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760734
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760734,
					"content": "If I tell you the story with a performance, will you believe me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760735
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760735,
					"content": "It depends. I'll make my own judgment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760736
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760736,
					"content": "Then will I get paid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760737
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760737,
					"content": "Your reward will range from anywhere between five Mora and the Holy Lyre. It all depends on your story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760738
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760738,
					"content": "Very well. Let me put on a show...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760739
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760739,
					"content": "What did I just witness...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760740
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760740,
					"content": "This is confidential information. Why did you let me know?",
