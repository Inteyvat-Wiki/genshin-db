				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "Meow! (How wonderful! Congratulations on completing the Ascension Challenge. You're now an Advanced player!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660202,
					"content": "Meow? (It only takes one challenge to become an Advanced player? Well, since most people play the game only for fun, they don't take it too seriously...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660203,
					"content": "(In other words, there are only a few people who are serious about the game, but even if it's just for fun, it's worth some serious dedication too.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660204,
					"content": "Meow! (Ah, yes! Now that you have my recognition, you can also challenge the games set up by the other guys in the tavern. Hmm... they should enjoy your company.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660205,
					"content": "The other guys?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "Meow. (You heard it right. Of course, they, just like me, are cats in this tavern. But they are not to be underestimated.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660207,
					"content": "Meow~ (Should the time come, Shuyun can hold cards for them. Alright. To honor the tradition, there's one more thing I've got to say!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706660208,
					"content": "#({NICKNAME}, may the fun be with you in the world of Genius Invokation TCG!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
