			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310301,
					"content": "Oh, you shouldn't have! Except, you totally should.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310302,
					"content": "This is a token of the Guild's gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310303
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310303,
					"content": "We receive many new commissions every day, and without the efforts of each and every adventurer there is no way we could respond to them all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310304
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310304,
					"content": "If you complete enough commissions each day, you will be eligible to claim a special reward from me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310305
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310305,
					"content": "Your Adventurer Handbook keeps a record of how many adventures you complete each day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310306
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310306,
					"content": "Make sure you claim your daily rewards on the days that you complete sufficient adventures. There is a limited quantity of rewards, so it will become forfeit should you not claim it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310307,
						200310309
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310307,
					"content": "Okay. Thanks for the explanation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310308
					]
				},
				{
					"id": 200310308,
					"content": "You're more than welcome. After all, you are the one helping me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310312,
					"content": "And please note that helping a fellow adventurer to complete a commission also counts towards your eligibility for a daily reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310313
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310313,
					"content": "We encourage you to work actively with your fellow adventurers. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310309,
					"content": "Only one reward per day?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310310
					]
				},
				{
					"id": 200310310,
					"content": "As things currently stand, yes... My apologies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310311
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310311,
					"content": "But please be assured that we are constantly pushing Headquarters to make sure all our adventurers receive fair and adequate compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
