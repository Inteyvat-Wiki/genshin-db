			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#I heard something through the grape vine, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310402,
					"content": "Word has it that you completed a <color=#00E1FFFF>commission</color>. The requester sends their thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310403,
					"content": "What commission? Refresh my memory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310404,
					"content": "You helped someone in need while you were out on the road.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310405,
					"content": "In fact many of those you will meet have commissioned the Guild to assist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310408,
					"content": "Let me explain the Guild's system to you in a little more detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310409,
					"content": "The Guild receives requests from far and wide each day, and assigns commissions to adventurers accordingly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310410,
					"content": "These commissioned adventures are the main source of compensation for our guild members.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310411,
					"content": "On the subject of compensation, I should mention that the Guild has prepared a little something for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310406,
					"content": "I was just being a Good Samaritan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310407,
					"content": "And that is exactly what makes you our avid new adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
