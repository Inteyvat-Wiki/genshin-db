				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310201,
					"content": "#You did a fine job, {NICKNAME}! Outstanding performance, considering it was your first time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310202,
					"content": "The requester even asked me to thank you on their behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310203,
					"content": "And, as promised, you are due your reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003103,
			"completionStepIds": [
				2003104,
				2003107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
