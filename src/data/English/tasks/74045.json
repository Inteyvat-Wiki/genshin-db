			"dialogs": [
				{
					"id": 740450201,
					"content": "Puca, we're back! We found your token.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "You give the token to Puca.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Ohh, yes, this is the one! Thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450204,
					"content": "We also found something else while we were looking for your token...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "It's an ore we've never seen before. We thought it might be valuable, so we brought it back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "If Paimon remembers correctly, you often pick up pretty stones around this area, right? Have you seen any stones like this before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "Let me see... It really is pretty! But it's not precious at all... it's just an ordinary stone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450208,
					"content": "It's true that you won't find anything like this in other places, but they're everywhere in nearby ore veins!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450209,
					"content": "Aw, so it's just an ordinary rock! Paimon thought it looked super valuable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "Seems like we can't use it for anything else. Let's just find a place to dump it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "But if you can't find the ore elsewhere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Oh, you mean we could make a fortune if we took it elsewhere and sold it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "#You do have a point! People don't normally go mining in a Melusine village, which means they've probably never seen anything like this... Great thinking, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "C'mon, let's take this stone to the Court of Fontaine and show the merchants!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "If there's anything else you'd like to know about ores, come find me anytime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450217,
					"content": "Though I don't run a gemstone workshop like my sister and don't know much about appraisals or processing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450218,
					"content": "Compared to precious gems, I prefer collecting all kinds of unique rocks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450219,
					"content": "I guess you can say I know the local ore veins pretty well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450220,
					"content": "Hehe, gotcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "But if it's unique to this region...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
