						740450607,
						740450609
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450604,
					"content": "About precious gems...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "There's lots of beautiful and sparkly stones in the ore veins nearby, but they're nowhere as good as real gemstones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450606,
					"content": "If I were better at finding real gemstones, maybe I could open my own gemstone workshop, just like Sluasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450607,
					"content": "About the uses of ore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "Huh? I've never thought about that before... I only collect stones because they're pretty...",
					"roleType": "TALK_ROLE_NPC",
