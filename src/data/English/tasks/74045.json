					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450602,
					"content": "Is there anything you'd like to know about ore? You can ask me anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450603,
					"content": "Even though I might not have an answer...",
