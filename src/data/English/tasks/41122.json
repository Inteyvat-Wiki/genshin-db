			"dialogs": [
				{
					"id": 411220601,
					"content": "Hello. Do you need help with anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220602,
					"content": "Have a look at these Orders...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "Orders? Allow me... So, instructions to return to the city, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220604,
					"content": "My apologies, but I will have to execute these duties later, as I still have important matters to attend to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220605,
					"content": "It seems as if the monsters around these parts have been affected by the meteorites. They've become much more violent, and are exceptionally dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220606,
					"content": "I have to clean them out in order to ensure this area's safety.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220607,
					"content": "But there's no one here, is there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "Well, it's precisely because no one's around that I'm free to fight these monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220609,
					"content": "This is a very important matter. I cannot leave while it remains undone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220610,
					"content": "I'll help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "Great, thank you. There's not one, but a few concentrations of monsters in this area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220613,
					"content": "Let's split up and destroy all the monsters in our respective areas, and we'll link up here once we're done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220611,
					"content": "Let's do this together.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
		},
