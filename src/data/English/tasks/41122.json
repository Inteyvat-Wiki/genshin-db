					"nextDialogs": [
						411220803
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220803,
					"content": "We're done here as well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220804
					]
				},
				{
					"id": 411220804,
					"content": "Haha, you've got fine moves, don't you? Thanks so much for your help. I don't think those monsters will return to these parts for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220805
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220805,
					"content": "Still, I can't return just yet. Other than these monsters, there are still more roaming about in the Stormbearer Mountains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220806
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220806,
					"content": "I want to continue gathering intelligence here — and if someone were to come to harm nearby, I would be on hand to rescue them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220807
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220807,
					"content": "Not everyone is aware of the call to seek shelter, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220808
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220808,
					"content": "Alright, then. Please convey my intent to Mr. Huffman. I'm sure he'll understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				}
			]
		},
