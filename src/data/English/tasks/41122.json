			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "*sigh* It seems that we don't have any good options...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220102,
					"content": "Something the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "Ah, it's you. Well... I'm sure you've seen those falling meteorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220104,
					"content": "While the city itself has been very fortunate to have avoided any meteorite hits, it's chaos outside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220105,
					"content": "Between the people who fled into the city to seek shelter and those who fell unconscious without warning, we've got our hands full here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220106,
					"content": "I'd like to recall all the knights who are currently attending to duties outside so we can settle matters within these four walls first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220107,
					"content": "But they are currently dispersed out in the wild, and we haven't the extra numbers to go out and look for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220108,
					"content": "Could you lend me a hand and let them have a look at these Orders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112202",
							"2"
						],
						"stepId": 4112202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "Hello. Do you require anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220202,
					"content": "Here's some Orders for you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "Orders? Oh my. Let me have a look... Instructions to return to the city and help to settle various matters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220204,
					"content": "Um, so, I could go back to the city, but those two children simply don't want to do the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220205,
					"content": "I have no idea where their parents have gone, and I don't want to forcibly bring them back, so I've been stuck here guarding them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220206,
					"content": "If I were to head back under these circumstances, I don't know what I'd do if something happened to them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220207,
					"content": "But I've tried several times to persuade them, and now they won't listen to me at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220208,
					"content": "So... could you help me convince them? Maybe they might listen to you instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220209,
					"content": "If you can convince them to return to the city, then I too can leave in peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220210,
					"content": "I'll give it a shot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "Great, thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
		{
			"id": 4112203,
			"completionStepIds": [
				4112203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112203",
							"2"
						],
						"stepId": 4112203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jill"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "Hmm? Is something wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220302,
					"content": "Well, here's the situation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "Oh, I know about the meteorites. But... we haven't seen what they look like when they're coming down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220304,
					"content": "Will said he knew a good spot to watch them, so we came here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220305,
					"content": "You can see them from the city too...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "But we'd need to go somewhere really high up to see them if we were in the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220307,
					"content": "The guards aren't going to let us to get up that high for sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220308,
					"content": "That nice man over there is willing to help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "Eh? You mean that weird old guy there? But the last time he came to talk to us, he looked really nasty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220310,
					"content": "He just wanted us to go back. Didn't say anything else at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220311,
					"content": "But if he agrees to take us to a really high place to watch the meteorites, I think... I think we can go back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220312,
					"content": "But you'd best talk to Will. It was his idea, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jill"
				}
			]
		},
		{
			"id": 4112204,
			"completionStepIds": [
				4112204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112204",
							"2"
						],
						"stepId": 4112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Will"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220401,
					"content": "Hmm? Hello, is something up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220402,
					"content": "Well, here's the situation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "I know, that's why we came out here — to see the meteorites. Don't worry, we'll go back once we've seen them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220404,
					"content": "You can see them from the city too...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "But then we'd need to get way up high. I tried lots of times, but the guards kept yelling at me to come down. I got a scolding from them afterwards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220406,
					"content": "That's why I brought Jill over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220407,
					"content": "That nice guard over there will help us out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "Help us? Do you mean he can take us to a high point in the city to watch the meteorites?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220409,
					"content": "That can't be... He looks so weird, and angry, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220410,
					"content": "I have his Orders with me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "Really? Let me see them! Wow... these really are the official Orders of the Knights!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220412,
					"content": "With this, that man will take us up to see the meteorites, won't he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220413,
					"content": "Hehe... Watching the meteorites from inside the city would be the best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220414,
					"content": "Well, you go have a word with him. I'll talk to Jill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220415,
					"content": "Ah, I really can't wait... I wanna see the meteorites falling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will"
				}
			]
		},
		{
			"id": 4112205,
			"completionStepIds": [
				4112205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112205",
							"2"
						],
						"stepId": 4112205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220501,
					"content": "How did it go? Did you manage to convince them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220502
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220502,
					"content": "Well, so it would seem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220503
					]
				},
				{
					"id": 411220503,
					"content": "Really? That's great! Thank you so much— actually, wait... What do you mean \"so it would seem\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220504,
					"content": "You just need to do your part...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "My part? What does that mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220506,
					"content": "Eh? You want me to take them to the highest point in Mondstadt and watch the meteors fall? That's... rather dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220507,
					"content": "Not to mention that they're kids, too. I'll have to report this to Headquarters first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220508,
					"content": "I've got your Orders right here, you know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "That's... not how you use it, I don't think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220510,
					"content": "Well, never mind. As long as we can get those kids back to the city, I'll... I'll figure something out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220511,
					"content": "Really?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "Of course, I swear it on my honor as a knight and... as an adult.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220513,
					"content": "No matter who it is, our word is as good as our bond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220514,
					"content": "Thanks for your help. Leave the rest to me — I'll bring them back to the city shortly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220515,
					"content": "Afterwards, I'll figure out how to get them to Mondstadt's highest point...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
