							203.141,
							8444.012
						],
						"pointId": 350200059
					},
					{
						"sceneId": 3,
						"position": [
							-2574.509,
							205.081,
							8395.636
						],
						"pointId": 350200171
					},
					{
						"sceneId": 3,
						"position": [
							-2519.865,
							202.947,
							8445.825
						],
						"pointId": 350200364
					},
					{
						"sceneId": 3,
						"position": [
							-2520.345,
							202.9,
							8444.707
						],
						"pointId": 350200365
					}
				]
			},
			"dialogs": [
				{
					"id": 150080301,
					"content": "These Koholasaurs sure seem on guard. We'll never get through...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080302,
					"content": "Given you've already used the information provided by the map to deduce that the clue is in that valley, why don't you simply chase them away? You're pretty strong, aren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080303
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080303,
					"content": "First of all, the elders of the tribe have always warned us to never hurt the Koholasaurs. Doing so will almost certainly bring bad luck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080304
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080304,
					"content": "And secondly, you can't just show up and intrude on others' gatherings, much less make them leave! That's just terrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080305
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080305,
					"content": "But on what basis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080306
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080306,
					"content": "Okay, so can we figure out another way to enter the valley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080307
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080307,
					"content": "Hmm, there must be a way to enter the valley without startling them. It'd take a while for me to come up with a solution on my own, so I'd like to ask everyone to help come up with some ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080308
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080308,
					"content": "Let Paimon think... is there a detour or another way around?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080309,
					"content": "According to the map, the clue is right in the middle of the Koholasaur herd. Even if we try to approach from the other side, we'll just run into the same problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080310
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080310,
					"content": "Hmm, this is tricky...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080311,
					"content": "Karya, I've noticed that you only talk when you're trying to help smooth things over between Viramdra and the others. I'm sure you must have some ideas of your own, so why don't you share them with us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080312
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080312,
					"content": "Me? Alright... When Viramdra decided to look for leads on the Koholasaurs, I wanted to help, and so, I also looked up some information about the creatures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080313
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080313,
					"content": "I discovered something very interesting... We thought that the Koholasaurs relied on their hearing to track their prey, but they also possess a very keen sense of smell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080314
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080314,
					"content": "But, I'm not sure how useful that information is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080315
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080315,
					"content": "Oh... oh! That was actually very useful, Miss Karya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080316
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080316,
					"content": "You can just call me Karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080317
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080317,
					"content": "#In that case, please stay here and keep an eye on the luggage. {NICKNAME}, Paimon, come with me. I've got an idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
		{
