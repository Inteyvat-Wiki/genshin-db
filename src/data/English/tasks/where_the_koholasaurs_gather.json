					}
				]
			},
			"dialogs": [
				{
					"id": 150080401,
					"content": "Found it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080402,
					"content": "What's this...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080403,
					"content": "The key to making our way through the herd!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080404,
					"content": "If the Koholasaurs have a keen sense of smell, then even if we try to sneak around and stay out of sight, they'll still notice us once we get close enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080405,
					"content": "But this plant can help us solve that problem, because its fragrance is very similar to the scent of a Koholasaur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080406,
					"content": "We can apply the plant's extract to our bodies and trick their sense of smell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080407,
					"content": "So we're gonna... rub plant juice on ourselves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080408,
					"content": "Don't worry, it's also good for your skin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080409,
					"content": "Mualani collects some of the plant's extract and masks everyone with its fragrance.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080410
					]
				},
				{
					"id": 150080410,
					"content": "Oh, Paimon feels all wet and slimy... but this actually does smell like a Koholasaur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080411,
					"content": "Perfect! Okay, let's try to make our way through again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
