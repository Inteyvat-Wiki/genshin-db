					"Ookubo Daisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "Thank you, Traveler, thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130302,
					"content": "I was halfway through making the fertilizer when those monsters came charging up out of nowhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130303,
					"content": "That's so strange... But it's good that you showed up when you did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130304,
					"content": "It might be because of that pile of fertilizer, you know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "R—Really? I've heard that this smell is a sign that you might have succeeded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130306,
					"content": "Well, in any case, come over here and have a look at the fertilizer. I'll explain as I open it up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130307,
					"content": "Hold it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130308,
					"content": "Eh? Mr. Gorou? I wasn't aware that you'd be passing this way today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130309,
					"content": "On patrol, Gorou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "I... Uh, never mind that first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130311,
					"content": "Is this pile of... stuff your doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130312,
					"content": "Hahaha, yes. This fertilizer was the work of our hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130313,
					"content": "Mr. Gorou, did you come here to check on the fertilizer as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130314,
					"content": "Hehe, in that case, let's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130315,
					"content": "Wait! Hold on a moment. I'm not here for that. Wait, actually, I am... But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130316,
					"content": "Gorou's face is twisting up something awful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130317,
					"content": "Let's... adjourn to someplace a little further away...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "Alright, let's do that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130319,
					"content": "So, Mr. Gorou, why are you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130320,
					"content": "Lately, a lot of residents have been complaining of a terrifying stench nearby...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130321,
					"content": "So for safety, I came to investigate, and wound up following the smell all the way here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130322,
					"content": "That's how I found you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130323,
					"content": "Iwata, I've heard that you've been researching fertilizer, but the way that you're going about it is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130324,
					"content": "...A disturbance to the peace?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "Basically. Either way, Iwata, could you please dispose of that fertilizer? We'll try to help you find some other way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130327,
					"content": "Sir! General Gorou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130328,
					"content": "I'm here. What's happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130329,
					"content": "General, we caught a suspicious person out in the outskirts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130330,
					"content": "She was acting very furtively, calling herself a... fertilizer salesperson, or somesuch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130331,
					"content": "I thought that was awful strange, so I had this person detained. I thought that you might wish to see to her questioning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130332,
					"content": "Fertilizer this, fertilizer that... What is it with me and fertilizer today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130333,
					"content": "I've got it. I'll be with you shortly. Head back first and help to maintain order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130334,
					"content": "Iwata, please deal with the matter of the fertilizer. We'll discuss this further later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130335,
					"content": "Traveler, why don't you come with me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130336,
					"content": "Doesn't seem like there's anything else to do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "Someone selling fertilizer? Paimon can't help feel like that's familiar somehow... Nothing's coming to mind, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130339,
					"content": "Ah well, whatever. Let's just go over there and see what's up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130337,
					"content": "A fertilizer... salesperson?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "...Far too intense?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
