				"points": []
			},
			"dialogs": [
				{
					"id": 728130901,
					"content": "Traveler, you're back. I've disposed of that pile of fertilizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130902
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130902,
					"content": "*sigh* I suppose I'll have to find another place to conduct my experiments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130903
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130903,
					"content": "Hmm? This person is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130904,
					"content": "An assistant Gorou found you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "Hello, I'm Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130909,
					"content": "Well, either way... The general they called Gorou requested that I assist you with your fertilizer research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130910,
					"content": "It's a pleasure to be working with you from now on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130911,
					"content": "Is that so... That's great! If we succeed, then we'll be able to plant more crops here on Watatsumi Island!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130912,
					"content": "Do remember to pile the fertilizer further away.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "Eh? Oh! Oh, I get it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130914,
					"content": "Yes, the pleasure is all mine, Miss Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130915,
					"content": "Yeah, I'll do my best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130916,
