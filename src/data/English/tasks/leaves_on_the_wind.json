					"Dr. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030201,
					"content": "I'll do it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030202
					]
				},
				{
					"id": 207030202,
					"content": "Great, I'm counting on you, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030303,
					"content": "You can see the elements, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030304,
					"content": "I reckon that you just need to follow the trail of Anemo and search that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030305,
					"content": "I'll be waiting for you under the tree. If you find anything, just bring it down to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
		{
			"id": 2070303,
