				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dr. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "What a shame, I can't use this material either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030102,
					"content": "What are you working on?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "I mean to write a new book about Mondstadt's history that focuses on Anemo, and I'm looking for inspiration here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030104,
					"content": "If you think about it, this place is the ideal spot — there's a Statue of The Seven that represents Anemo, and a tree that's closely linked to the legend of the great hero Vennessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030105,
					"content": "Yet — and I know this might sound funny — looking for and gathering Anemo without a Vision, which I lack, is too difficult.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030106,
					"content": "And this so-called search for inspiration? Why, I'm just staring into space here. Most of my material is synthesized from second-hand resources as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030107,
					"content": "That's the life of a person without a Vision on this continent — to do much, and yet achieve little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030108,
					"content": "One cannot use the power of the elements without a Vision. Whether in research or in life, those without them live like outsiders in their own world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030109,
					"content": "Hahaha, maybe in the eyes of the gods, Vision wielders are the main characters of this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030110,
					"content": "Sorry, I said too much, and while I did say all this, I won't give up on my research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030111,
					"content": "I don't have a Vision, but I won't lose in terms of scholarship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030112,
					"content": "I've also heard that you can use the elements even without a Vision...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030113,
					"content": "If you could help me to grab some objects imbued with Anemo, that would really help me with my research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030114,
					"content": "Could you help me climb up this tree and have a look?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
		{
			"id": 2070302,
			"completionStepIds": [
				2070301
			],
			"beginWay": "TALK_BEGIN_NONE",
