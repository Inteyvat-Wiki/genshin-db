				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dr. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030401,
					"content": "I have to say that someone like you is definitely better suited to doing research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030402,
					"content": "You have a great deal of adventuring experience, and great stamina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030403,
					"content": "And most importantly, you can control the elements even without the use of a Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030404,
					"content": "The elements... Is there really any research on this continent that could uncover their secrets? To a researcher, the ability to use a Vision or the lack thereof really is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030405,
					"content": "Ah, I went off on a tangent again... Sorry, please don't take it to heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
		{
			"id": 2070305,
			"completionStepIds": [
				2070303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
