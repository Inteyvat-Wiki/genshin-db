						],
						"stepId": 2070302,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dr. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "Have you found anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030502,
					"content": "Got a few leaves here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "...Leaves? Let me have a look, please. Huh, you even put them inside a box...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030504,
					"content": "When held in your hand, these leaves do indeed allow you to feel the Anemo within them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030505,
					"content": "To think that this tree really had this power. If I only had a Vision, then I wouldn't have had to waste this much time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030506,
					"content": "Thank you. This is a very precious resource, and I will use it as such.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030507,
					"content": "Still, I don't have any method of preserving these leaves. It is fully possible that the Anemo in them could dissipate all too quickly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030508,
					"content": "Still, take this as recompense for your efforts. Who knows, I might need to call on you in the future to help me collect research material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		}
	]
