			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "You guys are finally back, eh? Jiawei didn't come?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610602,
					"content": "He stayed in the village.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "Oh? He's become a family man? Haha! That seems like something he would do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610604,
					"content": "After all, that was his wish...alright, for this reason, he is forgiven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610605,
					"content": "What about Nantuck? Did you guys find him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610606,
					"content": "He wrote a Best-Selling book.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "Never thought he'd actually be a writer, huh? Pretty talented, so what did he write about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610608,
					"content": "Paimon knows! Paimon knows! The books called \"Regarding How The Lunar Leviathan Is Actually A Giant Sea Turtle\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610609,
					"content": "Oh, that's a long name...is it a light novel? Not bad... I'll go buy a copy and read it too... Hmm? Wait a minute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610610,
					"content": "\"Regarding How The Lunar Leviathan Is Actually...\" It's actually a...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610611,
					"content": "Mmhmm, it's actually a giant sea turtle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "What is this guy talking about? How could it be a giant sea turtle? Did he forget that we saw the \"Lunar Leviathan\" with our own eyes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610613,
					"content": "We didn't believe it at first...until we went to the snowy mountains and found the fossil of the \"Lunar Leviathan\"... Here you go, the book and the fossil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610614,
					"content": "No, I don't believe this. It's not true...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610615,
					"content": "You don't understand, our family comes from a long lineage of fishermen, and my father is also a famous fisherman in Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610616,
					"content": "He had spent decades chasing the \"Lunar Leviathan\" on the ocean, and once, he almost succeeded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610617,
					"content": "Although it was all for naught, my father didn't give up. It would be a great honor for a fisherman if he could catch the legendary \"Lunar Leviathan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610618,
					"content": "But after the next trip to sea...he never came back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610619,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610620,
					"content": "So, I won't believe such words easily, please help me out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610621,
					"content": "What do you plan to do then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "I'm going back to find the items my father left behind. He chased the \"Lunar Leviathan\" all his life and left a lot of information behind. I'm sure I can find a way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610623,
					"content": "I have prepared some fishing training for you, please wait for my good news, I will have to ask you for help then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
