			"dialogs": [
				{
					"id": 726610701,
					"content": "Hey, you guys, do you think this shabby rock is worth anything? It's so rare that it's hidden in the ore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "Old-School Qi"
				},
				{
					"id": 726610702,
					"content": "Oh please, what do you mean by shabby rock, have you touched a book before in your life? It's called a fossil. A fossil, get it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "Fleein' Lin"
				},
				{
					"id": 726610703,
					"content": "Not only is it worth a fortune, this alone can buy half of Liyue Harbor! Go back and read more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "Fleein' Lin"
				},
				{
					"id": 726610704,
					"content": "Really? Is it worth that much? Then, with what we have in the camp, wouldn't we be really weather?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "Klutzy Bazi"
				},
				{
					"id": 726610705,
					"content": "It's \"wealthy!\" You should go and read more too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "Fleein' Lin"
				},
				{
					"id": 726610706,
					"content": "Hey! That guy over there, hand over the fossil!",
					"roleType": "TALK_ROLE_NPC",
