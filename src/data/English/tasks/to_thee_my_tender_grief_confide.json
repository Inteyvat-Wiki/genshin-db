			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "Hey, young fisherman, I'm glad to see you. What's up, have you run into some trouble?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610102,
					"content": "Come come, I am your experienced angling guide. You can let me know about any issues you're having.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610103,
					"content": "It makes sense that Kujirai is still obsessed with finding the \"Lunar Leviathan\" as her wish is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610104,
					"content": "Alas, if she knew the truth about the \"Lunar Leviathan\" she would be devastated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610105,
					"content": "What truth?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "To be truthful, after from returning from the voyage, I did not stop researching about the \"Lunar Leviathan\". I finally found a clue in an ancient book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610107,
					"content": "Based on those clues, I went back out on the field and found out some shocking revelations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610108,
					"content": "I published my findings in a book, I heard it's doing well recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610109,
					"content": "Here, I just happen to have a book left by the editor. The truth about the \"Lunar Leviathan\" is inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610110,
					"content": "Paimon wants to see too! Let Paimon get a look!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610111,
					"content": "\"Regarding How The Lunar Leviathan Is Actually A Giant Sea Turtle\" ... What a long title... Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610112,
					"content": "A giant sea turtle? The \"Lunar Leviathan\" is a giant sea turtle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610113,
					"content": "That's right, the \"Lunar Leviathan\" is a giant sea turtle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610114,
					"content": "That night, what we saw was a giant sea turtle with long bioluminescent plants growing on its back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610115,
					"content": "It was a pregnant sea turtle that was looking for land to lay her eggs, which was how we found our way home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610116,
					"content": "So go back and tell Kujirai, you eventually have to face the facts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610117,
					"content": "But, maybe this can be explained...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "Seeing your expression, you probably don't believe me huh? But my research has evidence to back it up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610119,
					"content": "In the ancient tales, the \"Lunar Leviathan\" is an ancient creature, back when many animals lived on land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610120,
					"content": "Their ancestors were active in the Dragonspine area and you can even find fossils of them today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610121,
					"content": "I found some last time in <color=#00E1FFFF>Wyrmrest Valley</color>. If you don't believe me you can go see for yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
