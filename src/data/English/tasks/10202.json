			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Solitary Confinement"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020401,
					"content": "Guess whooo~?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "That's Paimon's voice I hear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Solitary Confinement"
				},
				{
					"id": 102020403,
					"content": "Need help busting out of this joint?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Ooh, ooh, yes, please! Wait — no, I... I can't. Klee needs to be a good girl and think about what she did... Stop tempting me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Solitary Confinement"
				},
				{
					"id": 102020406,
					"content": "Anyway, while I'm grounded, I'm making an extra-special new treasure... the Ludi Harpastum version!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Solitary Confinement"
				},
				{
					"id": 102020407,
					"content": "When you say \"treasure...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "Tee-hee... I made it into the shape of a harpastum and everything! It looks so cute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Solitary Confinement"
				},
				{
					"id": 102020409,
					"content": "You disguised a bomb as a harpastum!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Just wait for Ludi Harpastum, oh yeah... They're gonna love it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Solitary Confinement"
				},
				{
					"id": 102020412,
					"content": "Yeesh, if Jean was listening to this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "Klee might find herself grounded for an awful lot longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "So... another bomb?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "Need a bite to eat or anything?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
}