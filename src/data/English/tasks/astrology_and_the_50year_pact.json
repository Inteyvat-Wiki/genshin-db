			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000101,
					"content": "H—How do you know about that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000102,
					"content": "How? Because I'm a master of true astrology.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000103,
					"content": "If you've no other questions, let's be off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000104,
						105000105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000104,
					"content": "Oh, I'm just full of questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				},
				{
					"id": 105000106,
					"content": "*sigh* Fine, I'll exercise a little patience, and explain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000107,
					"content": "I am Astrologist Mona Megistus. But considering that it is most rude to misremember names, I allow others to call me Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000108,
					"content": "I am on a mission from my master to retrieve a certain box from Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "It was part of an agreement she made with a friend 50 years ago. But she isn't as spry as she used to be, so now it's up to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Not sure what getting some box back has to do with us. Why do you need us to come along?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Well... that's because I would also like to take on the guardian of the box.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000112,
					"content": "My master and her friend contended in the mystic arts all their lives without a clear victor. If I triumph here, then I will show myself to be superior to my master!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000113,
					"content": "So you want to prove yourself, huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000114
					]
				},
				{
					"id": 105000114,
					"content": "Ahem, well, I want to prove the power and status of astrology, to be precise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Now, from my predictions, I know that my master's friend has left Mondstadt, leaving her successor as the current guardian of that box.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Like me, that successor must also be one who has surpassed their teacher. I must not be careless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000119,
					"content": "But I would prefer to assure my victory in this contest, and upon giving it some thought, you came to mind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000120,
					"content": "But... I have no idea how astrology works.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000121
					]
				},
				{
					"id": 105000121,
					"content": "#How did {M#he}{F#she} get involved in this anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "The knowledge passed down to me from my master must be passed on in turn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "If I were to bring my disciple to meet her, then the lead is already mine, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000125,
					"content": "And you are Mondstadt's great hero, my equal in status. So...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000126,
					"content": "I refuse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000128,
					"content": "Come on, you don't have to actually become my disciple. You just need to act the part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "There's something in it for you as well, should you come with me to get that box.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "Once I meet that successor and have a chance to exchange knowledge with them, I should be able to read your fate more accurately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "Then, I will have answers for you, even regarding such distant and foggy matters as gods and kin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000132,
					"content": "That does seem much faster than searching the land country by country!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000133,
					"content": "Those sound like fine conditions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000135,
					"content": "Hehe, a wise decision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "That said, I would like to pay a certain place a visit before we go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000134,
					"content": "Well... I guess we'll play along.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000127,
					"content": "Since when was I your student?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000122,
					"content": "How did you end up thinking of me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000123
					]
				},
				{
					"id": 105000115,
					"content": "So basically, you want to look good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000116
					]
				},
				{
					"id": 105000116,
					"content": "What are you talking about? The main thing here is to use this chance to prove the power and status of astrology!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000105,
					"content": "For starters, who are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				}
			]
		},
		{
			"id": 1050002,
			"completionStepIds": [
				1050003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050003",
							"2"
						],
						"stepId": 1050003,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46622",
							"3"
						],
						"stepId": 46622,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mr. Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(Well, it's no wonder that an inn set up here has no business...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, you've come at just the right time. Did you see a jade ring while you made your way here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000203,
					"content": "A jade ring? Can't say I have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Oh, that's not good... that ring was given to me by my mother. But while my back was turned, it was swallowed up by a slime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000205,
					"content": "Hmm? That should be no trouble with Mona here. She's really good at astrology...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Absolutely not. Astrology is meant to be used to gain insight into reality and observe destiny itself. It's certainly not for such mundane affairs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "But didn't you say that the owner here's been good to you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "This is a matter of pride and one's state of mind. If an astrologist thinks that their arts can solve all problems, they will be forsaken by the starry ether.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Their divinations will lose the power to guide, and will not be able to pierce the fog of the unknown before them. Principles are principles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Such a powerful ability, and you don't use it to earn a living? What a shame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "*sigh* Well, I was going to put up twenty thousand Mora as compensation, if you were willing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000212,
					"content": "Twenty thousand...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000213,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "Oh, ahh, it's nothing! I... I was just thinking that the person who finds that ring must be lucky indeed, to be able to earn twenty thousand Mora just like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "You were just talking about an astrologist's pride...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "Ahem. Yes. Of course. Still... the owner's business has had it pretty hard. It must be a truly extraordinary ring, to be worth spending this much Mora to find.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "It wouldn't be right for us to leave like this, so let's help to search for it. There may be other means we can employ besides astrology.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Oh, Paimon knows where this is going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, I know, I'll leave this one to you! This is the first mission I'm giving you as your master!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000222,
					"content": "But of course...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000224,
					"content": "Hmm, since it was swallowed up by a slime, maybe we can use Elemental Bait to lure all the nearby slimes to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000225,
					"content": "You remember? The stuff we helped Master Diluc make.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000226,
					"content": "And... Hehe, Paimon actually kept a small amount!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000227,
					"content": "Well done Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000228,
					"content": "Paimon's the very best partner, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "Seems like you already have a plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "Yup. We'll be back in a jiffy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000229,
					"content": "Don't tell me that when you get greedy, you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000230,
					"content": "Aw, don't sweat the small stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000223,
					"content": "Guess it's become my business. Again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000217,
					"content": "Whatever happened to \"principles are principles\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000214,
					"content": "What's with that look on your face?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				}
			]
		},
		{
			"id": 1050003,
			"completionStepIds": [
				1050006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
