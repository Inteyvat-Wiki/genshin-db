			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mr. Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000301,
					"content": "That's it, that's the one! I thought it was lost forever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000302
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000302,
					"content": "You actually found it. Not bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000303,
					"content": "Mr. Zhu, you must take care of such precious things a bit better. You might not be so fortunate next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000304,
					"content": "You're absolutely right. How would I have faced my family if I had lost the 253rd ring my mother gave me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000305,
						105000306,
						105000307
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000305,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000308
					]
				},
				{
					"id": 105000308,
					"content": "Ah, let me explain. My family owns three jade mines, and in order to ensure that I would be able to find myself a good wife, my mother had many jade accessories made as heirlooms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000309
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000309,
					"content": "I think there might be over five hundred of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000310
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000310,
					"content": "Then, why would you feel the need to set up an inn here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000311,
					"content": "Well, inheriting the family business too early unavoidably made things boring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000312
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000312,
					"content": "Thank you, all the same. Here's the Mora, as agreed. Please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000313
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000313,
					"content": "Then—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000314,
					"content": "—Then I'll take it gladly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000315,
						105000316
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000315,
					"content": "That was quick!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000317
					]
				},
				{
					"id": 105000317,
					"content": "But we did all the work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000318,
					"content": "A disciple should act like one. How can they steal their master's thunder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000319,
						105000321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000319,
					"content": "Well...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000320
					]
				},
				{
					"id": 105000320,
					"content": "#{NICKNAME}, didn't we say we were just playing pretend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000323,
					"content": "Well, you need to start practicing now. If my rival is as smart as I think they are, they will figure you out in a heartbeat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000324
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000324,
					"content": "*stomach grumble*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000325
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000325,
					"content": "Huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000326
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000326,
					"content": "What was that rumbling sound?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000327,
					"content": "Oh, right, you mustn't have eaten in days. I'm very sorry, I forgot that you have no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000328
					],
					"speakerTitle": "Mr. Zhu"
				},
				{
					"id": 105000328,
					"content": "Aaaaaaah—! Shhhhahahahaha! That didn't happen! Forget it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000329,
					"content": "...Hmph! Well, I suddenly feel that you have indeed contributed to our good fortune. I say we spend this money on treating you to a fine meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000330
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000330,
					"content": "If we travel north, we'll reach the <color=#00E1FFFF>Wangshu Inn</color>. I hear that the food there is really good, so let's go try it out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000331
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000331,
					"content": "No need to thank me, I'm just doing as a good master should!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000332
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000332,
					"content": "Did she say she was treating us!? Is Paimon hearing things?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000333,
						105000335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000333,
					"content": "\"Let's go after her.\" There. I said it for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000334
					]
				},
				{
					"id": 105000334,
					"content": "Let's go after her! For good food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000335,
					"content": "\"She's a good person.\" Said it for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000336
					]
				},
				{
					"id": 105000336,
					"content": "She's such a good person! Hehe, let's have ourselves a great meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000321,
					"content": "I never said I'd really be your disciple.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000322
					]
				},
				{
					"id": 105000322,
					"content": "Exactly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000316,
					"content": "Even Paimon wasn't that fast!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000317
					]
				},
				{
					"id": 105000306,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000308
					]
				},
				{
					"id": 105000307,
					"content": "... ... ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000308
					]
				}
			]
		},
		{
