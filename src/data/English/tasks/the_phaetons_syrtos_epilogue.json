			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Surepio",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "Travelers from distant lands... *cough* You seem quite tired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450302,
					"content": "That won't do, you know? Many illnesses have their humble beginnings in exhaustion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450303,
					"content": "You must ensure that you get enough rest every day, so that you— *cough*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450304,
					"content": "*cough* *cough* —can grow healthily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450305,
					"content": "Y'know what, you're not looking too good yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450306,
					"content": "Ahaha, it is an old malady of mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450307,
					"content": "You must maintain a healthy body to stimulate a healthy soul, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450308,
					"content": "*sigh* If only I had more time. I would become the greatest physician in the world...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450309,
					"content": "That way, even with this body of mine, I would surely be able to walk out of my room in good health and play to my heart's content.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surepio"
				}
			]
		},
		{
			"id": 7224504,
			"completionStepIds": [
				7224504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224504",
							"2"
						],
						"stepId": 7224504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risutaiosu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "Stop moving!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450402,
					"content": "Oh, stop it! Stop, I say! Come on, I told you to stop moving! Didn't you hear me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450403,
					"content": "Uh, Paimon can't just stop moving...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450404,
					"content": "Imagine asking Paimon not to move...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "No way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450407,
					"content": "Ugh, alright, turn around then. I have never seen these clothes in my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450408,
					"content": "They're not entirely aesthetically pleasing, but they are somewhat interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450409,
					"content": "If you don't like 'em, why'd you even look?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450410,
					"content": "Seriously? Asking those lady retainers to model for me was hardly this difficult.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450411,
					"content": "That said, I've gotten quite sick of looking at the way our people dress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450412,
					"content": "As for what you're wearing, now that's new.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450413,
					"content": "Hmm, I know. So that's how they put those clothes together... Wow, you outsiders really are shameless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450414,
					"content": "I see, I see... So if the clothes are made like that, then the body shape should be like... this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450415,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450416,
					"content": "Making a statue. I mix clay and water, and then I knead them into shape with both hands. It helps to calm me — it's one of the only things that does.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450417,
					"content": "And you know what definitely doesn't calm me? Sitting in regular meetings, reading aloud based on material pre-written by those adults.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450418,
					"content": "Well, whatever. I'm done with your forms as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450419,
					"content": "Now stop bothering me. Go do your own stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450405,
					"content": "Would you fall down, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
		},
		{
			"id": 7224505,
			"completionStepIds": [
				7224505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224505",
							"2"
						],
						"stepId": 7224505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ion",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450501,
					"content": "Oh ho, Traveler, you look pretty interesting. What say I take a stab at reading your fortune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450502
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450502,
					"content": "I am Ion, after all. I never miss a reading.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450503
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450503,
					"content": "Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450504,
					"content": "You sound like a hustler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450505,
					"content": "(Also, Paimon remembers that his tombstone read...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450506,
					"content": "Oh, come now, what's with that suspicious look? I always read peoples' fortunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450507,
					"content": "That said... Few of Byakuyakoku's people have happy fates awaiting them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450508,
					"content": "So I often cheat them, telling them that their luck will turn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450509,
					"content": "If nothing else, I think that I can grant them a little happiness that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450510,
					"content": "In the end, they said that I couldn't tell fortunes at all. Ah, how saddening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450511,
					"content": "Is that how it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450512,
					"content": "Well, little one, I'll prove it to you, right now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450513,
					"content": "O—Oh? Sure! Try Paimon on for size!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450514,
					"content": "Hmm, alright... Let me have a careful go at this... Huh. Why's there so much interference?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450515,
					"content": "Eh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450516,
					"content": "Wh—What's wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450517,
					"content": "I... can't read your fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450518,
					"content": "How could that be? I don't get it exactly right most of the time, but I usually don't fail to get a reading at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450519,
					"content": "Well, guess you ain't that good, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450520,
					"content": "It does seem so. It seems that I must continue my studies in earnest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ion"
				}
			]
		},
		{
			"id": 7224506,
			"completionStepIds": [
				7224506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224506",
							"2"
						],
						"stepId": 7224506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piramumon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "Oh ho! Judging by your appearance, you must be a traveler from another nation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450602,
					"content": "Where do you hail from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450603,
					"content": "We're from Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450604,
					"content": "Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450605,
					"content": "You describe the Mondstadt's scenery to Piramumon in a simple manner...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "I've never heard of such a city. To think that there was such a place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450607,
					"content": "Hahaha! It's just as I said, then! The world couldn't possibly only be the size of Byakuyakoku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450608,
					"content": "I mean, if Byakuyakoku were all there was in the world, that would be a most lonely world indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450609,
					"content": "The ancient texts also talk about times before our nation was founded. That's when I began to believe that there were lands beyond ours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450610,
					"content": "But I was still scared, you know? Scared that there was really nothing else out there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450611,
					"content": "You have no idea, Traveler, how much your arrival sets my heart at ease. Haha, so there are many more fascinating places to see in this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450612,
					"content": "It's just a shame that I have this festival called the Rite of Solar Return to attend to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450613,
					"content": "How about this, Traveler? Tell me how you came here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450614,
					"content": "Once the festival has ended, I'll find an opportunity to sneak out of the Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450615,
					"content": "Let's have some fruit juice together instead! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piramumon"
				}
			]
		},
		{
			"id": 7224507,
			"completionStepIds": [
				7224507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224507",
							"2"
						],
						"stepId": 7224507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orupeusu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "*sigh* So you are the traveler from afar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "What are you pursuing? The sight of you coming this way was grievous to watch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450703,
					"content": "Grief? What's there to be sad about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450704,
					"content": "For a singer of songs, everything in this world is worth grieving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450705,
					"content": "Where there are meetings, there must be partings, and those who are born will one day return to the earth...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450706,
					"content": "Reunions are too brief to salve the pain of long separations... And as for you, Traveler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450707,
					"content": "Only those in pursuit of something will journey into another realm as you do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "The locals, who have lived here for a long time, would find such a journey romantic, but for the wayfarer themselves, it may mean unspeakable pain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "If you came in an earlier clime, I might have sung for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450710,
					"content": "But I have sworn an oath with someone that I shall not sing again until I hear her voice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450711,
					"content": "I can only wish you well, though you seem far older than I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450712,
					"content": "I hope your wish comes true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orupeusu"
				}
			]
		}
	]
}