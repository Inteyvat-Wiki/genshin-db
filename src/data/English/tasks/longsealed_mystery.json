			"dialogs": [
				{
					"id": 190603101,
					"content": "Don't take anything Uesugi says too seriously. Just nod along...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603102
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603102,
					"content": "About Takatsukasa Isamu and Ryuuji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603103
					]
				},
				{
					"id": 190603103,
					"content": "Oh, that? Well, let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603104
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603104,
					"content": "Ryuuji saw Takatsukasa Isamu as his foster father, that's for sure. But I can't say whether Isamu helped Ryuuji without expecting anything in return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603105
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603105,
					"content": "After all, Isamu was a resourceful person. A simple and naive person like Ryuuji wouldn't ever be suitable as an adviser, but he could certainly be a loyal and trustworthy aid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603106
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603106,
					"content": "Isamu was expecting a child of his own later, but unfortunately he was killed before the child was ever born...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603107
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603107,
					"content": "Anyway, enough about all that... Aren't you here to investigate the case? You'd better get a move on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
