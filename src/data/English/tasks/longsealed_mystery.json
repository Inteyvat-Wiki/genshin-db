			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "Hey, Traveler. Investigating a case isn't so easy, is it? Don't worry, I'll tell you all you need to know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "About President Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "Hah, Sango? The Takatsukasa Clan really hired an amazing detective, didn't they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "She comes to the station to submit applications every now and then, and has been constantly requesting to reinvestigate the Ryuuji Case. But Heizou has always prevented her from doing so. I really didn't expect that she'd go as far as writing a complaint letter, though. Whew, she's relentless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "As for why Heizou senpai has been keeping her away from the case, I think he's afraid that Sango would be putting herself in danger. After all, we're talking about the murder of an important man, that can be deep water if you're not careful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Sango may run a detective agency, but in the end, she's just an ordinary person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "So are they friends?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "Uh well... not exactly. I've pretty much seen them argue every time they meet. But, Heizou might still consider her as an old friend. I heard that he used to work with Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603009,
					"content": "Sometimes he'd ask me to hand over less pressing cases to the detective agency. I guess he just wants to support Sango's business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603010
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603010,
					"content": "Hehe, Heizou senpai is a good person, there's no doubt about that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uesugi"
				}
			]
		},
