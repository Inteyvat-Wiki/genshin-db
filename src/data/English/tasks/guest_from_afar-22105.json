				"points": []
			},
			"dialogs": [
				{
					"id": 221050101,
					"content": "How stressful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "Something about this area just unsettles me. I can't quite explain it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050104,
					"content": "It doesn't help that all our guests seem to be the hypervigilant types too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050105,
					"content": "If there's the slightest disturbance, we end up with broken windows and doors, sometimes broken floorboards too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050106,
					"content": "Thankfully the guests do sort the repairs out themselves. But these piecemeal repairs have left us with an assortment of different bits and pieces that don't go together, and it just looks horrendous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050107,
					"content": "Could you take a look around outside the inn? If you find anything untoward, just... sort it out. I need to look after the guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050108,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050109,
					"content": "What is wrong with these people...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "Oh come on, they're not that bad! They're just used to being in survival mode out in the wilderness. You can't blame them for being on high alert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050112,
					"content": "Please, just take a look around the vicinity. I'm sure you won't encounter anything too disastrous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
