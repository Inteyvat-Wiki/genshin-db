			]
		},
		{
			"id": 4111307,
			"completionStepIds": [
				4111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111307",
							"2"
						],
						"stepId": 4111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "Mona, we found some stuff out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130702,
					"content": "An ice-capped mountain looms over the world from far above the clouds... That is the place from which this burgeoning darkness proceeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130703,
					"content": "Ice-capped mountain? Is that all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130704,
					"content": "It is the same ice-capped mountain in everyone's dream.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "It's a really really high mountain that no one's ever seen before, and it's super cold up there. The sleepers are forced to try and climb to the summit, but they don't know why.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130706,
					"content": "Climb the mountain? To the summit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130707,
					"content": "What sort of person would wish to reach the summit of that mountain? And how is their desire strong enough to exert an influence on others?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130708,
					"content": "Perchance some poor soul lies there, buried in the snow, hounded to death on the mountain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130709,
					"content": "Or... Some intrepid explorer was exceptionally keen to conquer that particular mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130710,
					"content": "I'll do another reading!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130711,
					"content": "Aha! I see something here... It's a little vague but I think I can get his name... Ah, yes! <color=#00E1FFFF>\"Leonard\"</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130712,
					"content": "Wow, that was fast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130713,
					"content": "Well, in case you'd forgotten... I am a genius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130714,
					"content": "\"Leonard...\" Paimon's never heard that name before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
