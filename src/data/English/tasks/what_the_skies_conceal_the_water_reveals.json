			},
			"dialogs": [
				{
					"id": 411131301,
					"content": "Hey, has this guy woken up at any point?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131302,
					"content": "Not so far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131303
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 411131303,
					"content": "Okay... Um, has he said anything in his sleep?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131304,
					"content": "Now that you mention it... Yesterday, he suddenly cried out \"So high!\" Who knows what he was dreaming about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131305
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 411131305,
					"content": "How high? High as a snowy mountain peak, maybe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131306,
					"content": "A wicked mountain, its frozen peak looming high, home to a malevolent power...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131307
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131307,
					"content": "Let's talk to that guy over there next.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
