					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130901,
					"content": "This is the one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130902,
					"content": "I sense an unprecedented amount of elemental energy within.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130903
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130903,
					"content": "The very heart of darkness descends upon the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130904,
					"content": "What do the Fatui want with this? Is it the elemental power?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130905,
					"content": "It's possible... But if that were the case, other life forms would surely be drawn to the meteorites' energy too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130906,
					"content": "Let's take a closer look.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
