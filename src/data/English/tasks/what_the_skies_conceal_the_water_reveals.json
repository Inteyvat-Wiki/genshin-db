			"dialogs": [
				{
					"id": 411131001,
					"content": "Done and dusted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131002,
					"content": "Wonderful! What a huge help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131003
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411131003,
					"content": "Have any of the victims woken since the start of the incident?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131004
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131004,
					"content": "Oh, I wouldn't know... You're better off just taking a look for yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
