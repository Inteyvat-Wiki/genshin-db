			"trigger": {
				"objectNames": [
					"Huaqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131201,
					"content": "Mortal! Art thou also descended into the realm of suffering?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131202,
					"content": "Same situation that we've seen in other places, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131203,
					"content": "Hey there. Has this guy woken up at any point?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131204,
					"content": "No, he has said a few things in his sleep, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131205
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131205,
					"content": "What kind of things?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131206,
					"content": "\"So cold,\" \"Can't go on,\" ...Things like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 411131207,
					"content": "The previous victims have said they were cold, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
					"id": 411131208,
					"content": "Somewhere cold, up in the mountains... Where could it be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oz"
				}
			]
		},
		{
