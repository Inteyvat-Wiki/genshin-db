			},
			"dialogs": [
				{
					"id": 411131401,
					"content": "Hello, have any of the victims woken up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131402,
					"content": "Funny you should ask! <color=#00E1FFFF>Gao the Sixth</color> literally just woke up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131403
					],
					"speakerTitle": "Bro Huang"
				},
				{
					"id": 411131403,
					"content": "Alright! We're gonna go talk to him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131404,
					"content": "That's fine, but he's only just awoken and is still very weak. If you must question him, please be gentle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "Bro Huang"
				},
				{
					"id": 411131405,
					"content": "Greetings, you who have suffered and lived to tell the tale. Your sovereign shall question you now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131406,
					"content": "Food... Need food...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131407,
					"content": "Are you okay? Sounds like you're starving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131408,
					"content": "Ugh... Oof...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131409,
					"content": "What are you hungry for? Any dish you like.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "I need... home... home cooking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131412,
					"content": "Home cooking from Qingce Village? Well that can only mean one thing: <color=#00E1FFFF>farmer food</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131410,
					"content": "I'll cook a meal for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
			"id": 4111315,
			"completionStepIds": [
				4111315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111315",
							"2"
						],
						"stepId": 4111315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gao the Sixth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "Phwoar! That's brought me back from the brink, that has!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131102,
					"content": "Did you have a dream while you were sleeping?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131103,
					"content": "Only the most exhausting dream of my whole life!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131104,
					"content": "Really? Why, what happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131105,
					"content": "Were you on a mountain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "Yes... how did you know? Way up in the mountains, the highest mountain I've ever seen... It was freezing up there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131109,
					"content": "What were you doing there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131110,
					"content": "I'm not sure. It's like I was... possessed. I was consumed by the idea of climbing up the mountain and trying to reach the summit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131111,
					"content": "Was there something special at the summit, or?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131112,
					"content": "Who knows? Honestly, it's like I became a completely different person in my dream. Don't ask me why, I have no idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131113,
					"content": "So it wasn't \"you\" who wanted to climb the mountain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "It's hard to describe... It's like I was being controlled, as if somebody else put the idea of climbing the mountain into my head. I know how crazy that sounds, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "Gao the Sixth"
				},
				{
					"id": 411131115,
					"content": "An intruder trespassed in the dark recesses of your soul!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131116,
					"content": "An idea not autonomously generated by the individual, but that appeared within the subconscious... Yes, the signs do indeed point towards mind control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131117,
					"content": "I should be used to this by now, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "All the other victims we've met have talked about being cold, and needing to rest... Were they all climbing the mountain, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131120,
					"content": "How can they all be having the same dream?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "Paimon doesn't even wanna think about it... We need to update <color=#00E1FFFF>Mona</color> on all of this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131118,
					"content": "The things you two say are not even remotely similar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "Were you outside in the snow?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "Well, sort of. Up a snowy mountain, to be precise. It was huge, and it was freezing cold... The moment I fell asleep, I was standing at the foot of the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao the Sixth"
				}
			]
		},
