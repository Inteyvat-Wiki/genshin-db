			},
			"dialogs": [
				{
					"id": 100070501,
					"content": "Ah, looks like our music has moved some in our audience to step on stage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070502,
					"content": "But that's against concert rules, so let's usher them out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000707,
