			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2630.724,
							200.207,
							-2354.246
						],
						"pointId": 14220
					},
					{
						"sceneId": 3,
						"position": [
