			"dialogs": [
				{
					"id": 4880401,
					"content": "It's not uncommon for delivery workers to take a couple of bottles for themselves and make a bit of extra cash on the side. But obviously you don't seem like the type.",
					"roleType": "TALK_ROLE_NPC",
