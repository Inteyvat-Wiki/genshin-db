				"objectNames": [
					"Ernest"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4880101,
					"content": "So this is where Charles' delivery got to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880102,
					"content": "Have you come to rescue me? I've been waiting long enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880103,
					"content": "In all the time I've been working at the winery, this is the first time I've been robbed by hilichurls. *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "If you'd taken any longer, I don't know what I would have done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#Fear not. {NICKNAME} here is a hilichurl exterminator extraordinaire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880106,
					"content": "Just as well. Then... please escort this <color=#00E1FFFF>transporter</color> to the end of the road.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880107,
					"content": "And be careful with it. Just beating up the hilichurls is the not the aim here. You'd better <color=#00E1FFFF>make sure the goods stay intact</color> because I certainly don't have the Mora to replace them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880108,
					"content": "I'll be waiting up ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "Ernest"
				}
			]
		},
		{
			"id": 48803,
			"completionStepIds": [
				48803
			],
