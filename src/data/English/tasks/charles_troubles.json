			},
			"dialogs": [
				{
					"id": 4880301,
					"content": "Thank you, my friend. I thought I was in deep trouble this time. It's a good thing you showed up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880302
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880302,
					"content": "I'll put in a good word for you with the gentlemen at the winery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ernest"
				}
			]
