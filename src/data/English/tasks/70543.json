			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430102,
					"content": "...Meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "Dustball"
				},
				{
					"id": 705430103,
					"content": "...It's you. Me, I'm talking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430104,
					"content": "Talking... Razor, are you talking to Dustball?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430105,
					"content": "Meow, meow-meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "Dustball"
				},
				{
					"id": 705430106,
					"content": "It seems like Dustball is trying to say... \"That's right\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430107,
					"content": "A familiar scent, looking for friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430108,
					"content": "It is good. Happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430109,
					"content": "Meow, meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "Dustball"
				},
				{
					"id": 705430110,
					"content": "Friends followed the scent. You came too, happy. On your body, the smell of wind and rain, very familiar... The scent of cats, also familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430111,
					"content": "Paimon, very sweet scent. Smell good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430112,
					"content": "Eh!? Sweet... Could that be the flavor of the pancakes Valerina gave us? D—Did Paimon eat that many?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430113,
					"content": "I gave you half of my portion, remember?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "Really? Paimon didn't even notice... Mmm, it's all the pancake's fault for being so delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430116,
					"content": "Hehe, and Paimon also wants to eat Sweet Madames, Steaks, and Hash Browns... oh, and drink some Apple Cider!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430117,
					"content": "#Okay, that's the menu for the next meal then! C'mon, {NICKNAME}, let's go place our order with Valerina! You come too, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430118,
					"content": "Thank... Thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430119,
					"content": "Dustball has brought me lots of... nuts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430120,
					"content": "And, meat boxes... I am very full.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430121,
					"content": "Sounds like Valerina ordered delivery, then? Did Dustball deliver the food to you, Razor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430122,
					"content": "Meow-meow. Meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "Dustball"
				},
				{
					"id": 705430123,
					"content": "Paimon never imagined that the cats would actually end up taking care of the customers here in the Furball Fortress!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430124,
					"content": "Looks like you really are the cat's meow, eh, Razor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430114,
					"content": "No sweat, you can still eat triple what you ate before.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
