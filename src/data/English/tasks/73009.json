			"dialogs": [
				{
					"id": 730091301,
					"content": "I can't thank you enough for preparing Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "It's a pity that I couldn't join your adventures like Arama and the others, nor was I able to provide any help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "That being said, if you ever feel tired during your adventures, come visit Vanarana. You're always welcomed in this dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
