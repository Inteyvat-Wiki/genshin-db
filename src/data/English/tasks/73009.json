			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana will take care of her. She is a most cherished friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Nara {NICKNAME}, please go to Vanarana and sing the Rhythm of the Great Dream. Then ask them to help prepare the Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "I'm not sure I understand you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Like clouds know they have to release rain, rain knows they need to fall onto ground, and seeds know they need to grow into big trees and have lots of big fruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "I—I got it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Nara {NICKNAME}, it looks like you don't understand. It's okay. When the right time comes, Nara {NICKNAME} will know what to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
