			"dialogs": [
				{
					"id": 730090301,
					"content": "(Rana is still sleeping. Arana is not around.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090302,
					"content": "(A blurry image appears in the \"bubble\" that envelopes Rana.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090303,
						730090307
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090303,
					"content": "(You are immersed in the image...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090304
					]
				},
				{
					"id": 730090304,
					"content": "You are in a forest where everything looks incomparably massive and serene. You feel very comfortable here.\\nRays of sunshine peek through the sparkling gold leaves, with grass as tall as you swaying quietly all around, gently caressing your hand as you walk by.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090305
					]
				},
				{
					"id": 730090305,
					"content": "You hear the sound of distressed crying amid the musical melody of the wind blowing through the trees and flowing water. Following the sound, you find a small girl.\\nShe looks like she has worn herself out from crying and fallen asleep in the meadow. You walk up to her and softly sing a song that can calm all beings...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090306
					]
				},
				{
					"id": 730090306,
					"content": "(... It seems that Rana's condition hasn't worsened.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090307,
					"content": "(Leave quietly.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
