					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "#It belonged to Nara Varuna. {M#She}{F#He} was a Golden Nara who was kind, brave, and honest, just like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091103
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091103,
					"content": "#I still remember how the Aranara of that time missed {M#her}{F#him} and loved {M#her}{F#his} stories. But I believe that since Nara {NICKNAME} is here now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
