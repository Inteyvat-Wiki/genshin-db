			"dialogs": [
				{
					"id": 730091001,
					"content": "About the Vasoma Fruit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "It's a fruit full of energy. It grows on the memories and dreams in the earth, and it needs the help of Aranara and Nara to bear fruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091003,
					"content": "A Bija can be formed by feeding a Vasoma Fruit to the Ashvattha Tree. It's a great tree planted by Greater Lord Rukkhadevata, and it's the origin of Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
