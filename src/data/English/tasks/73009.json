			"dialogs": [
				{
					"id": 730091501,
					"content": "About the Vasoma Fruit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091502
					]
				},
				{
					"id": 730091502,
					"content": "It's a fruit full of energy. It grows on the memories and dreams in the earth, and it needs the help of Aranara and Nara to bear fruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091503
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091503,
					"content": "A Bija can be formed by feeding a Vasoma Fruit to the Ashvattha Tree. It's a great tree planted by the Lord of Verdure, and it's the origin of Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		}
