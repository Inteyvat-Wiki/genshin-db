						220070402
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070402,
					"content": "Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070403
					]
				},
				{
					"id": 220070403,
					"content": "Let me see... Wow! That's a relic, alright...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070404
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070404,
					"content": "Um... It doesn't look like the one I lost, though. Still, looks valuable to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070405
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070405,
					"content": "This relic needs looking after by an expert. Don't worry, it's safe with me... Hehehe... Thank you both.",
