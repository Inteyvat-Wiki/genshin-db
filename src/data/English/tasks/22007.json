						220070202
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070202,
					"content": "This box is... a bit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "Hey! Take a closer look, I think you'll find I've padded it with plenty of clothes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070204,
					"content": "I'm a professional scholar, don't you know! I don't make rookie errors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070205,
					"content": "Anyway, thanks for helping me look for the relic — I'd be useless in a fight with those monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
