						220070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070302,
					"content": "Do you wanna keep looking? Or go back and check with Bao'er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070303,
						220070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070303,
					"content": "Let's keep looking.",
