						220070305
					]
				},
				{
					"id": 220070305,
					"content": "Alright then. This time with your eyes open.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070304,
					"content": "Let's head back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070306
					]
				},
				{
					"id": 220070306,
					"content": "Yeah, let's see what else Bao'er has to say.",
