	"talks": [
		{
			"id": 7267401,
			"completionStepIds": [
				7267401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267401",
							"2"
						],
						"stepId": 7267401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "Hey there, Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740102,
					"content": "Eeek! You saw through me? How did... Wait, no, this scent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740103,
					"content": "Ah, so it's you. It has been so long, I could not recognize your scent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740104,
					"content": "And you haven't changed at all, Ioroi — still scared of humans and stuck in a stone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740105,
					"content": "Mmm!? What do you mean by that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740106,
					"content": "Hope your seal can be lifted soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "Bah, it is but a human seal! If I were but to try harder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740109,
					"content": "*cough*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740111,
					"content": "#Well. Regardless, I see you have taken good care of the little ones. My little tanuki often say that they enjoy playing with their nice-smelling yellow-furred {F#Aunt}{M#Uncle}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740112,
					"content": "#Yellow-furred {F#Aunt}{M#Uncle}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "And here I had thought that humans were all the same as that fellow who had us sealed — wicked and scary. But it seems that there are still some good eggs amongst you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740116,
					"content": "Most people are alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "That's right. Most of the people we've met are good people! You got sealed because you stole that comb...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740119,
					"content": "Hmph! And I've returned it! So if you ever meet that fellow who learned magic from Reizenbou, tell him to get me out of this stone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740120,
					"content": "Mmph! When you get down to it, everything is that sneaky kitsune's fault...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740121,
					"content": "(Ioroi really complains like some old geezer, huh?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740122,
					"content": "(Well, he is quite old.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "Well then, neither your hands nor legs are made of stone, so you've been to many places, surely?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740124,
					"content": "Yup! We came right over the ocean, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740125,
					"content": "You tell Ioroi about your adventures in Mondstadt and Liyue.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "...So, there are so many lands abroad. Very impressive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740127,
					"content": "I have been subsisting off reports from the little tanuki all this while, and so do not know what the outside world is like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740128,
					"content": "Once upon a time, I stood at the summit of Mt. Yougou and saw a very, very high mountain on the other side of the ocean. It was possibly even taller than Mt. Yougou. I still wonder, even today, what that place was.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740129,
					"content": "Across the ocean, you say...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "That's gotta be Dragonspine, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740132,
					"content": "Mmmm, Dragonspine? Just thinking about that name makes my tummy feel cold. Goodness knows why that fellow wants to go there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740134,
					"content": "As I said earlier, you are fine folk, yes? So...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740135,
					"content": "Paimon can smell this request coming a mile away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740136,
					"content": "Mmm! Even like this, I am still the Hidden Protector of the Grove, defender of Chinju Forest, and thusly appointed by Her Excellency herself! If I was not sealed in stone, I would certainly use an eight-tatami large...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740137,
					"content": "Alright then. What do you need help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "Though I cannot move on my own power, the little children can do so. As such, I would like to ask you to take the little tanuki out to train.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740144,
					"content": "Take Kichiboushi with you. He has been quite eager to see you since the last time you played together — quite eager indeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740145,
					"content": "Well, we can do that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "That's true. We can't understand what Kichiboushi says, so wouldn't traveling together be kinda tough?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740148,
					"content": "Impossible. We tanuki understand human speech by nature. It is you humans who do not speak ours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740149,
					"content": "What? Is that how it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740150,
					"content": "But as travel companions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "We'd like to chat as we travel, you know?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#Just like Paimon does with {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740153,
					"content": "Mmph. Very well then. Now that I consider it, didn't someone once use our magic to make you some food?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740154,
					"content": "Now, I may look like this, but making you a \"meal\" that can allow you to understand Kichiboushi's speech is hardly impossible nonetheless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740155,
					"content": "Woo-hoo! Food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740156,
					"content": "Is it gonna taste good, though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "Now, now, don't you underestimate my culinary prowess!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740158,
					"content": "Although you can't be sure where Ioroi got it from...\\nYou and Paimon have a feast that \"looks very delicious\" off Ioroi's stone tummy.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "Ooh, this is great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740160,
					"content": "Of course. I am Ioroi, you know — the very same who once made Sashimi Platters out of mud balls and tanuki fur to utterly deceive the Four Oni of Ogata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740161,
					"content": "That's awesome, Ioroi! But so, what did you make the meal we just had out of?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740162,
					"content": "Some questions are best left unasked, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740164,
					"content": "Well, forget it. Let's go find Kichiboushi and have a chat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740146,
					"content": "One question, if you would...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "Well...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "#Ooh, Paimon knows what you mean, {NICKNAME}! Will there be treasure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740140,
					"content": "Treasure? Why, of course! I am the chief of five hundred and five bake-danuki, after all! Not a single one of Inazuma's treasures has ever escaped my sight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740141,
					"content": "In that case, what do you need help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "That's right, we're super good at helping!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740131,
					"content": "From the direction you're referring to, that's probably Dragonspine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "Why, thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "Nice-smelling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#Also, it's not {F#Aunt}{M#Uncle}. It's {F#Big Sis}{M#Big Bro}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "Paimon means that we hope that your seal will soon be lifted.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
			"id": 7267402,
			"completionStepIds": [
				7267402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267402",
							"2"
						],
						"stepId": 7267402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Kichiboushi\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740201,
					"content": "Hey there, Kichiboushi! Long time no see!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740202,
					"content": "Mm! White Fur, Yellow Fur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740203,
					"content": "I guess \"Yellow Fur\" must be me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "Who're you calling White Fur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740205,
					"content": "Mm, very strong. Can understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740206,
					"content": "#I'm {NICKNAME}, and this is Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "And you'd better remember that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740208,
					"content": "Squelch squelch Lavender Melon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740209,
					"content": "What? Lavender Melon? And what's \"squelch squelch\" supposed to mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740210,
					"content": "Well, at least we can kinda-sorta communicate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740211,
					"content": "\"Kinda-sorta\" is kinda-sorta right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#Whatever the case, {NICKNAME}, let's go back and see Ioroi again. We are taking Kichiboushi out on a long journey, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740213,
					"content": "Ioroi! Yey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740214,
					"content": "Yey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267403,
			"completionStepIds": [
				7267403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267403",
							"2"
						],
						"stepId": 7267403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "Mm! How goes it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740302,
					"content": "Mm! See White Fur, Yellow Fur, very happy. Lavender Melon Kapow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740303,
					"content": "Lavender Melon Kapow...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "Hmm, quite the bright spark, aren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740305,
					"content": "Kapow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740306,
					"content": "So, what does Lavender Melon Kapow mean again...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "Kapow is Kapow. Lavender Melon is Lavender Melon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740308,
					"content": "Well, it seems that communications have been established without any problems. Ah, mine \"culinary\" skills are as fine as ever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740309,
					"content": "...I suppose so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "Nope, not at all! We can't understand a thing Kichiboushi's saying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740312,
					"content": "Well, Ioroi, here's the thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740313,
					"content": "You tell Ioroi how the attempted interactions are going...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "Mmm, so that's how it is. Not to worry. It is because you are not yet used to Kichiboushi's aura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740315,
					"content": "Take it slow! The more used to his aura you are, the better you shall understand him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740316,
					"content": "How slow are we talking about here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740317,
					"content": "Ah, hmm. Let me think about that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740318,
					"content": "Eh! Whatever the case, do not be in a rush!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740319,
					"content": "Rush no good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740320,
					"content": "You don't know either, do you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "Hmph! I will have you know that I am Ioroi, the long-lived king of bake-danuki! I simply do not put such premiums on time as you humans do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740322,
					"content": "(Even though he's spent most of his time sealed in that stone statue...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740323,
					"content": "Then why can you speak to humans just fine, Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "Mmph! Such impertinence! Rather, you should ask why you humans may speak to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740325,
					"content": "Having lived as long and become as powerful as I have, I have had at least some interactions with humanity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740326,
					"content": "A long, long time ago, I often spoke with tengu, kitsune, oni, youkai, and humans alike. And while human stories often concern themselves, at least half of them involve bake-danuki who transformed into humans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740327,
					"content": "Half of the remaining half are indeed about humans themselves, and the other half are about all the other youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740328,
					"content": "But even in this half, a good half concern we tanuki, who clad ourselves in the guise of the other youkai. Then half again of the tanuki tales are those concerning me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740329,
					"content": "Mmph, as such, you may see that I am the greatest of them all. Naturally, speaking to you young ones is no tall order at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740330,
					"content": "I get it. Five over sixteen to Ioroi, yes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "Mm? What's \"Five Over Sixteen\"? Is it something that one may eat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740332,
					"content": "Sounds delicious. Want to eat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740333,
					"content": "#{NICKNAME}'s referring to the percentage of stories that you're involved in, Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740334,
					"content": "Ioroi. Powerful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740335,
					"content": "Hah, why of course! You have much to learn from my powers, you do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740336,
					"content": "Eh? Come to think of it, we're starting to get what Kichiboushi is saying, aren't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740337,
					"content": "White Fur smart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740338,
					"content": "That might have been praise, but Paimon sure doesn't feel good about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740339,
					"content": "Good, good. Then I leave this child in your hands. Take him to go see the world and train!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740340,
					"content": "Why, when I was but a young tanuki, I too went on a pilgrimage to eighteen sites in Inazuma along the trail of the great bake-danuki Tsukumo, never once straying from the tanuki paths — only thus did I reach my present stature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740341,
					"content": "Eh? Is that why you were sealed in stone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740342,
					"content": "Mm-haha! Stone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740343,
					"content": "Eh!? You too, Kichiboushi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740344,
					"content": "Ahem! So, uh, back on topic! Where should we go first?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740345,
					"content": "There's that place Ioroi mentioned earlier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "Uh-huh! Dragonspine it is, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740348,
					"content": "\"If there's a mountain, we shall climb it\" — ah, Paimon's been waiting for a chance to say something cool like that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740349,
					"content": "Mountain, there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740350,
					"content": "Oooh, that sounds cold... Don't let your tummy get cold now, Kichiboushi. You'll catch a cold otherwise, and if you do, you won't be able to perform using your belly drum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740351,
					"content": "#Also, remember to eat properly and follow {F#Aunt}{M#Uncle} Yellow Fur like a good boy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740352,
					"content": "#Understand! Following {F#Aunt}{M#Uncle} Yellow Fur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740353,
						726740354,
						726740355
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740353,
					"content": "We'll take good care of Kichiboushi, don't worry.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740356,
					"content": "Pleased to meet you, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740357,
					"content": "Mm! No worry! Kichiboushi take care of you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740358
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740358,
					"content": "Hmm, looks like we're not completely getting through to him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740354,
					"content": "Don't you worry.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740355,
					"content": "#It's not {F#Aunt}{M#Uncle}. It's {F#Big Sis}{M#Big Bro}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740347,
					"content": "How does Dragonspine sound?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740348
					]
				},
				{
					"id": 726740311,
					"content": "...\"Without any problems,\" he says...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740312
					]
				}
			]
		},
		{
			"id": 7267404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267402",
							"2"
						],
						"stepId": 7267402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740401,
					"content": "Through the power of the bake-danuki meal made by mine own hands, you, too, may speak to the little tanuki. Go, try having a chat with Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740402
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740402,
					"content": "We'll do that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740403
					]
				},
				{
					"id": 726740403,
					"content": "Go, then, go. I have all the time in the world to go nowhere, but it is not so with my little tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				}
			]
		}
	]
}