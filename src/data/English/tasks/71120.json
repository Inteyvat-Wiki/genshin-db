			"dialogs": [
				{
					"id": 711200101,
					"content": "Hey, keep off! This is the boss man's turf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711200102,
					"content": "Whoa, so mean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "Who are you people?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "That's up to you. If you're nice, we can be pals. But if you get nosy, we'll have to do something about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711200105,
					"content": "You should grow a brain and go back the way you came!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711200109,
					"content": "You're so suspicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "Suspicious? Whoa there... We're just the doormen. If anyone's acting suspicious, it's you weirdos poking your heads everywhere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711200111,
					"content": "Whatever, we've got nothin' to say to you! Just quit bothering us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711200106,
					"content": "Who is this \"boss man\" you speak of?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "Who is the \"boss man\"...? Ha! If I told you, you'd keel over with fright!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711200108,
					"content": "It's for your own good, pal! Leave well alone what you shouldn't mess with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Coiled Serpent"
				}
			]
		},
