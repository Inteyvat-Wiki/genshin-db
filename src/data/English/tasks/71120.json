			"dialogs": [
				{
					"id": 711209101,
					"content": "You two again!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711209102,
					"content": "Stop snooping around, friends. Just pretend you didn't see us, and we'll pretend didn't see you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209103,
					"content": "What are you guarding?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "Take a guess what we're paid to do, buddy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209105,
					"content": "What!? Why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "*ahem* Cough cough...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209107,
					"content": "(I'll only tell the two of you, so don't tell anyone... C'mon, come closer now...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209108,
					"content": "(Sure, Paimon's listening!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "It's to get rid of people like you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209110,
					"content": "Waaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "I just heard a weird noise from inside the cave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "I farted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Sitting Tiger"
				},
				{
					"id": 711209113,
					"content": "Uh... right. He farted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Coiled Serpent"
				},
				{
					"id": 711209114,
					"content": "S—So everything's okay then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
