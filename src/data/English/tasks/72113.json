					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721130701,
					"content": "Ms. Gendou's attitude is the same as ever, huh... Anyway, let's check the slip's contents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130702,
					"content": "Huh? This is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130703,
					"content": "Ooh, Paimon gets it. This must refer to some bad guy who needs defeating!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130704,
					"content": "Yeah, that's gotta be it. So, Ms. Gendou, you're a secret agent who's using this method to communicate and wipe out those who try to harm Inazuma, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130705,
					"content": "You talk too much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130706
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130706,
					"content": "Welp! S-sorry! Please don't sic the \"Shuumatsu\" on us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130707,
					"content": "Leave now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130708
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130708,
					"content": "We're leaving right now! Let's go to the place shown in the picture and see if we can find our target!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
