			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721130201,
					"content": "Let Paimon see, let Paimon see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130202,
					"content": "Wow! It says very auspicious. Yeah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130203,
					"content": "Looks like today's Paimon's lucky day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130204,
					"content": "Yours?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "That's right! Your fortune is Paimon's fortune! And vice versa, Paimon's fortune is also your fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130206,
					"content": "When Paimon eats good food, that's good fortune. So, for the sake of your fortune, please give Paimon some good food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
