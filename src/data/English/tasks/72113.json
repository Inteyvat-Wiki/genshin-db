						721130302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130302,
					"content": "Yeah, not bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130303,
					"content": "Being with Paimon will certainly bring you good fortune!",
