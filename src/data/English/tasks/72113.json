			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "You want a fortune slip?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130102,
					"content": "Geez, she's so cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130103,
					"content": "Yes, I'd like one...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "Got it. Here's how it goes. First, shake this... thing over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130105,
					"content": "Isn't it called a Fortune Slip Box?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "Yes. A Bamboo Slip will drop out from it. Give it to me, and I'll give you a matching strip of paper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130107,
					"content": "I'm pretty sure they say it's a Fortune Slip...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "Whatever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130109,
					"content": "Paimon's got a question! If... What do we do if we get one that means bad luck?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130110,
					"content": "It's fate. You got a problem with that? Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130111,
					"content": "Eh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130112,
					"content": "Isn't there that shelf-like thing outside we can use to...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "Tsk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130114,
					"content": "Did she seriously just say \"tsk\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130115,
					"content": "Let me see... Oh right, so it's like this. \"Tie the inauspicious slip onto the Fortune Slip Hanger to change ill fortune to good\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130116,
					"content": "Ah, right! If you get a slip with ill fortune, just tie it to that shelf, that'll do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130117,
					"content": "Huh, what a bunch of... No, sorry. We at the Grand Narukami Shrine are most gentle indeed. Even if you should draw a slip with bad luck, you shall have a chance to turn it around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130118,
					"content": "Something about this doesn't seem right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130119,
					"content": "#Let's go draw a slip, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7211302,
