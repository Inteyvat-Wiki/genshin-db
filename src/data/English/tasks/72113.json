			"dialogs": [
				{
					"id": 721130601,
					"content": "Eh? What's this? Looks like someone's notes. Let Paimon see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130602,
					"content": "\"... Shuumatsu... Fatui... plot against...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130603,
					"content": "What is this? It's a mess, and it's all covered in stains. Paimon can't really read it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130604,
					"content": "Could be a clue to some treasure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130605
					]
				},
				{
					"id": 721130605,
					"content": "That makes sense! Let Paimon have another look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130606,
					"content": "\"... when deciphering the slip, the secret code... \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130607,
						721130608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130607,
					"content": "Deciphering the slip?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				},
				{
					"id": 721130609,
					"content": "Let Paimon see! \"...The first half is 'In the middle of a hazy night'... \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130610,
					"content": "It cuts off here, and Paimon can't tell what the second half is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130611,
					"content": "But since it used a secret code, there must be some kind of secret to be found, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130612,
					"content": "Either way, this seems important. Next time we decipher our fortune slip, let's try to match the secret codes, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130608,
					"content": "Secret code?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				}
			]
		},
		{
