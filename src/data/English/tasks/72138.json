			},
			"dialogs": [
				{
					"id": 721380501,
					"content": "Phew... Phew... My heart almost jumped out. Thank you for saving my life. I won't forget it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380502,
					"content": "This is a normal phenomenon. Living beings affected by Tatarigami will be unconsciously attracted to inauspicious energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380503,
					"content": "Because this remedy is saturated with Tatarigami energy, it's normal that it would attract them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380504,
					"content": "Phew, anyway... I think I know how to improve this remedy now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380505,
					"content": "But the last failure wasted some fresh herbs. I need some more herbs to continue with my new remedy evaluations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380506,
					"content": "#In your upcoming journey, {NICKNAME}, please watch out for any useful herbs on the island. Just leave them in the bamboo basket in front of the house in the mornings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380511,
					"content": "I will give you the reward as I've promised. But I'm afraid you'll have to wait a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380507,
					"content": "#{NICKNAME}, it's fine if you're busy. Maybe I can find someone else to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380508,
					"content": "You got it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#Goodbye, traveler {NICKNAME}. I hope you will have a safe journey on Yashiori Island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380509,
					"content": "Sure, I'll take care of it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
			]
