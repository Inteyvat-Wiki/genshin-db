			},
			"dialogs": [
				{
					"id": 401930101,
					"content": "Ah, compadre! A little birdie told me you went to Aisa Bathhouse last night!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930102,
					"content": "I'm gettin' the crew together, and we're gonna go there to celebrate! You in?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930103,
					"content": "But, we were just there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930104,
					"content": "Uh, yeah... But, I bet you were missin' a few people, yeah? Like Shinobu.. and Gorou... and, y'know... Ayato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930105,
					"content": "Basically, Boss heard about the trip, and now he really wants to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930106,
					"content": "A—Anyway! Once you're done perusin', come find me, and we'll SOAK! IT! UP!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
