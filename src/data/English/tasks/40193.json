						401930702
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 401930702,
					"content": "Well now, I don't see you going either...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930703
					]
				},
				{
					"id": 401930703,
					"content": "...We did go with the Boss, once. But then he got it into his head to start some sort of competition...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930704
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 401930704,
					"content": "...What sort of competition?",
