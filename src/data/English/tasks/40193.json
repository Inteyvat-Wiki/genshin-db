					}
				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "Following Itto's constant nagging, you all head to Aisa Bathhouse once again...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "Hahaha! This has gotta be the hottest one! Let's see who can last the longest! Who's in?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930203,
					"content": "Hehe, if you're that excited about it, how can I refuse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 401930204,
					"content": "Listen... This isn't a sauna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930205,
					"content": "Ahhh... so warm... *snore*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 401930206,
					"content": "Hey, don't fall asleep in the tub!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930207,
					"content": "Uh... My fur is so heavy. I almost feel dizzy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 401930208,
					"content": "Hahaha! If you can't handle the heat, Gorou, get out of the... tub!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930209,
					"content": "Hey! Stop being so loud!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401930210,
					"content": "On the other side...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "Heh, Itto is as energetic as ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930212,
					"content": "It's not good to get distracted during a match, brother.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930213,
					"content": "#Whoa! This game is getting heated! What's your next move, {NICKNAME}? What do you two think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 401930214,
					"content": "Hm... I would take it slow, try to consolidate my advantage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401930215,
					"content": "Or, you could be aggressive... taking a risk isn't a bad idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "Shikanoin Heizou"
				},
				{
					"id": 401930216,
					"content": "(Go slow and steady)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "#Oh? Very clever, {NICKNAME}! A decisive defeat... I concede! Now, based on the random draw earlier, the next player should be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930219,
					"content": "Ayaka! Have fun, you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930220,
					"content": "#Oh, uh... Okay! Go easy on me, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930221,
					"content": "(Ayato must have lost to me on purpose to give Ayaka more time to play... Always up to something, that one...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "(Be aggressive!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
