			"dialogs": [
				{
					"id": 401930301,
					"content": "Boss! The Mikawa Flower Festival was a huge success for us! We had three times more visitors than usual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930302,
					"content": "Based on what we've made so far, I think we'll be able to make... this much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930303,
					"content": "That's great news! We might even beat Yae Publishing house this month...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930304,
					"content": "Oh? You look pleased about something... Having a party without me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930305,
					"content": "Oh, hehe... It's nothing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930306,
					"content": "I forgot to share some good news with you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930307,
					"content": "Thirty percent of the proceeds from the festival have been transferred to Yae Publishing House. We're expecting record profit this month... Don't you think congratulations are in order?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930308,
					"content": "What!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930309,
					"content": "W—Well, boss... I guess congratulations ARE in order... This is our 333rd time competing against Yae Publishing House in sales, and our best showing to date — second place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930310,
					"content": "Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930311,
					"content": "...May this be a night of sweet dreams for all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
