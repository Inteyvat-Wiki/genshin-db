					}
				]
			},
			"dialogs": [
				{
					"id": 762070201,
					"content": "Ah... I was once language itself. Now, I am reduced to a shattered subject of illusion, returning once more to this imperfect \"symbol.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "Eek! A weirdo saying weird things just popped out of a weird book!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "\"Weird\" is an imprecise term. It implies a unique entity that cannot be described, written, or characterized. I clearly do not fit that definition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "I was merely attempting to find an entry point to \"reality\" within these pages, only to slip into an inadvertent, infinite deferral of metaphors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "I have become a remainder that defies symbolization. It is thanks to your intervention that the tyranny of language has been stripped from me. Now, I can finally begin to misrecognize myself once more...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "In the common tongue, please.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "...I accidentally tumbled into the pages and got stuck. Thank you for pulling me out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
