			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "What? Are you here to disturb my rest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591102,
					"content": "Nope, we just wanna talk to you, seeing you sitting here all by your lonesome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591103,
					"content": "It must be quite boring to drink alone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "Is that so? Thank you. You... remind me of Lyudochka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591106,
					"content": "She's really enthusiastic, just like you... She kept sticking with me, telling me all sorts of things... I was the only one she often confided certain things to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591107,
					"content": "*sigh* How I wish she was around. She's such a fun person. I bet you'd like her if you saw her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591108,
					"content": "Lyudochka? Who is she?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "A friend of mine. Though she may appear serious, she's a funny little pumpkin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591110,
					"content": "We were like sisters back in the House of the Hearth — I'd say that she was even dearer than a real sister. She liked to tease me... And she also looked after me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591111,
					"content": "Haha, anyway, I have a hunch that she's doing fine out there. With this thought in mind, all the injuries that I got in this hell of a place seem to feel like nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591112,
					"content": "I hope she's doing her job alright... Hope she doesn't think of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591113,
					"content": "Lyudochka... You mean the one in Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591115,
					"content": "So, her cover was blown...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591116,
					"content": "Eh, how did you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591117,
					"content": "She... managed to escape.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591120,
					"content": "Haha... That's a relief to know. Let's hope she's still doing her job well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591121,
					"content": "But if she betrays the Tsaritsa for fear of death...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591122,
					"content": "...I hope she doesn't think of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591118,
					"content": "She's still alive, and she's doing great.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "So we came over for a chat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
