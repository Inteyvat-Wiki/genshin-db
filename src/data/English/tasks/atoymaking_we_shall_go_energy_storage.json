			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "Bertrand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950102,
					"content": "#Ah, {NICKNAME} and Paimon. Splendiferous timing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950103,
					"content": "My one and only Great Machine has finished processing the materials you collected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950104,
					"content": "And how did that go?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "Well, come now, this is a machine that I created! Of course there were no issues at all! My techniques were, after all, forged in the fires of Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950106,
					"content": "And of course, none know the operation and workings of such devices better than we, the people of Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950107,
					"content": "I blame the previous, ah, explosive nature of the product on rushed preparation and a lack of helping hands to help hoover up the necessary materials. Things will be different this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950108,
					"content": "So you say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950109,
					"content": "If it still explodes... Well, then my final deposit and the rest of my life will go up in smoke too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950110,
					"content": "So even if you don't believe in me, you can have faith in my resolution to put my life on the line for this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950111,
					"content": "Y'know, Paimon never thought that this toymaking thingamajig was supposed to require that much resolve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950112,
					"content": "Well, regardless, we need to begin on the next step of our work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950113,
					"content": "For safety's sake, let me just ask you this first: of the three processes, the one we have completed is \"Source Material Collection.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950114,
					"content": "Now then, is the next step \"Core Collection\" or \"Charge Collection\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950115,
					"content": "Core Collection...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "Congratulations... on being wrong. If you really did go out and do that, then you'd have a part in the collapse of my fortunes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950117,
					"content": "The correct answer is Elemental Charge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950121,
					"content": "Well, all in all... This Elemental Charge is essentially performed by being affected by the elements while carrying the Material Collector.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950122,
					"content": "For example, I could stand in a river while carrying the Collector to collect Hydro. If I wanted to collect Electro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950123,
					"content": "You'd need to be struck by lightning?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950124,
					"content": "Well, you know, you *are* adventurers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950125,
					"content": "I believe that you have an adventurer's constitution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950126,
					"content": "Oh, so it's our constitution you believe in...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "To be honest, coming into contact with elemental life forms is probably our best bet. During my previous travels in Inazuma, I marked out three different locations frequented by elemental beings...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950128,
					"content": "I'd actually wanted to sneak over there by boat and make contact with those creatures myself, if no help came...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950129,
					"content": "That's way too risky...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950130,
					"content": "Well, now that you're here, why don't you go and try your luck in those places?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950131,
					"content": "Yes, indeed, I believe I shall leave this to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950118,
					"content": "It's Charge Collection...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "Well, it would seem so... But in truth, the answer isn't \"Charge Collection\" but rather, \"Elemental Charge.\" Didn't expect me to give you two wrong options, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950120,
					"content": "This guy's laughter is pretty annoying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
