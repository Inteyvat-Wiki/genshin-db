			"dialogs": [
				{
					"id": 790640801,
					"content": "This is the guards' headquarters. If we can just explain the situation, I'm sure the giant guard will be less hostile towards us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640802
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blue Supervisor"
				},
				{
					"id": 790640802,
					"content": "Hello...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790640803
					]
				},
				{
					"id": 790640803,
					"content": "What are you doing? I'm busy reminiscing about old times with a photo of my friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640804
					],
					"speakerTitle": "Knock on Door"
				},
				{
					"id": 790640804,
					"content": "I know that voice. Is that Winston?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640805
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blue Supervisor"
				},
				{
					"id": 790640805,
					"content": "Hahaha, so, you come crawling back... I told you, I am your only friend in this world. What were you thinking, running off on a mission with two complete strangers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640806
					],
					"speakerTitle": "Knock on Door"
				},
				{
					"id": 790640806,
					"content": "You were so naive. \"Oh, I'll make friends with them, I know I will!\" But in the end, I alone am waiting for you. I alone am your friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640807
					],
					"speakerTitle": "Knock on Door"
				},
				{
					"id": 790640807,
					"content": "#That's not true... It's not just those two. There's {NICKNAME}-Marquis and {M#his}{F#her} companion, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640808
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blue Supervisor"
				},
				{
					"id": 790640808,
					"content": "...You made other friends behind my back!? Well, look at you, Albizzi, all grown up... That's the last straw. Get out of here! I never want to see your face again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640809
					],
					"speakerTitle": "Knock on Door"
				},
				{
					"id": 790640809,
					"content": "Actually, no. Why don't you lift the emergency measures for a second and let me in? I have a VIP with me and we're very close to solving the mystery of our sacred site.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640810
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blue Supervisor"
				},
				{
					"id": 790640810,
					"content": "I said, get out!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640811
					],
					"speakerTitle": "Knock on Door"
				},
				{
					"id": 790640811,
					"content": "Winston sounds the alarm. The giant guards arrive, scoop everyone up, and place you outside.\\n\"You and Winston both need your own space right now. Your friendship needs a cooling-off period.\"\\nThe guards kindly offer relationship advice.\\nThe whole process is unusually civilized.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}