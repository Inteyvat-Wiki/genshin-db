			"dialogs": [
				{
					"id": 790640601,
					"content": "Suspicious individuals detected! I don't know what law you've broken, but we're currently at the highest level of alert. Come with us, turn yourselves in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "Giant Guard"
				},
				{
					"id": 790640602,
					"content": "Everyone scatters. You hear Cappet's voice shouting out, \"It's every man for himself!\"\\nAfter the guards have gone, you regroup back at the same place. It looks like no one was caught...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "Let's try that again, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Detective"
				}
			]
		},
