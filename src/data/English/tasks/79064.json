			"dialogs": [
				{
					"id": 790640301,
					"content": "Everyone, I have returned. I come with the long-awaited Marquis and their followers to search for the lost origins of our clan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640302
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blue Supervisor"
				},
				{
					"id": 790640302,
					"content": "Well, we weren't told anything about that this morning. Get out of here. Leave us alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640303
					],
					"speakerTitle": "Giant Guard"
				},
				{
					"id": 790640303,
					"content": "The giant guards scoop you all up and throw you outside.\\nNo one is able to fight back.",
