			"dialogs": [
				{
					"id": 716540201,
					"content": "Wow... this teapot seems even bigger inside than Madame Ping's. There's even a great big house in the middle, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540202,
					"content": "Huh, but there's just a whole load of nothing around it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540203,
					"content": "Get chiseling, Paimon — you could carve us a whole house out of this rock.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "Paimon can't do that! Well, you're the one with a sword, anyway — you do it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540207,
					"content": "Still... why is it so empty here apart from that house?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540208,
					"content": "Oh, wait a second, what is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540205,
					"content": "Go dig a burrow to live in for now, I guess?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "Hey! There's a perfectly good house right over there. Why should Paimon have to live in a hole in the ground!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
