			"dialogs": [
				{
					"id": 727340101,
					"content": "Undisciplined, inelegant, unoriginal, uninspired... and completely uncoordinated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340102,
					"content": "Hey, what'cha complaining about? Oh, lemme guess, all your teammates we defeated?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340104,
					"content": "I'm talking about your fighting style.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340105,
					"content": "Huh? Have you been hit in the head by a Specter, or something? This ain't some circus show, pal! You wanna know what my style is? Uncheckable strength, unwreckable will, and undefeatable beetles, that's what! I can give you a demonstration — if you dare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340106,
					"content": "Ugh, you bring back some bad memories... I do not deal well with loud and obnoxious types like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340107,
					"content": "#Ah, but this {M#blond fellow}{F#blonde lady} looks like easy pickings... Alright, I'll challenge {M#him}{F#her}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "Wizard Moneybags"
				},
				{
					"id": 727340108,
					"content": "Pfft! Hahahahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340109,
					"content": "Hahahaha! Hey, compadre, did you hear what this joker just said? He thinks you're an easy win! So uh, how about you show him a little Arataki Gang hospitality?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340110,
					"content": "Haha, gladly!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "Paimon doesn't get it... These people haven't researched their opponents at all! All they're doing by coming one at a time is contributing to our winning streak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340113,
					"content": "Grandmaster Hanakado's team members are a real mixed bag! They're no match for us three when it comes to strategy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340111,
					"content": "Oh nooo~! Please don't bully me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
}