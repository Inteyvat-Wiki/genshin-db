			},
			"dialogs": [
				{
					"id": 210080301,
					"content": "Please traveler, get the fires lit soon. The inspector could be here at any moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080401,
					"content": "Tell me more about the road.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "Guili Plains sits atop a range of rock formations, so some areas are a bit more rugged, like the slope heading towards the watchtower west of here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080403,
					"content": "To the east, towards the sea is quite flat, however. If you have the time you should head that way and check out Yaoguang Shoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080501,
					"content": "What about your colleagues?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "So they look after fueling the fires, while it's my responsibility to get them lit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080503,
					"content": "Sure it sounds trivial, but it's important that we each perform our role.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100810,
