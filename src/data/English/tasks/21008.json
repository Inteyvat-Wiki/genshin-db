				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "How have the torches gone out again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080001,
					"content": "What's wrong with the torches?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "Ah, traveler. Look ahead, can you see three watchtowers? The torches on them should all be lit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080003,
					"content": "The roads along Guili Plains can be difficult to traverse at the best of times, worse still when there are monsters out there in hiding. The torches aren't just to light the way for travelers, they also indicate that there is no threat from monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080004,
					"content": "But... I was so busy clearing out monsters in the area that I completely forgot to stoke the fires. By the time I realized it was too late, and they'd all gone out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "Why can't you do it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "Ah, it's 'cause they come to check the fires. If it's me here, I can buy a bit more time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080103,
					"content": "It's no good if you stand here or if there's no-one here at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080104,
					"content": "So please, traveler, go and light the torches for me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080201,
					"content": "Alright, I'll light them for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080202
					]
				},
				{
					"id": 210080202,
					"content": "That would be great. Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080203
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080203,
					"content": "Along this road there are three watchtowers, each with their own torch. After you've lit them all, make sure to come back and see me again, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080204
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080204,
					"content": "At the end of the road, there is a Statue of The Seven. Perhaps while you are down that way you can visit it, perhaps receive the blessings of the Geo Lord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080205
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080205,
					"content": "It may be easy but it still needs doing — so thank you, and please don't forget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
