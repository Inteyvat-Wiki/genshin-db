			},
			"dialogs": [
				{
					"id": 210081001,
					"content": "Phew... Alright, we should be all good now! Thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210081002
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210081002,
					"content": "This is for you, to say thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
