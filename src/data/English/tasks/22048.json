					"nextDialogs": [
						220480303
					]
				},
				{
					"id": 220480303,
					"content": "Meow meow, that is good. You are indeed very reliable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480304,
					"content": "The shrine certainly looks the part now. Ah, Hibiki will be pleased when she returns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480305
					],
					"speakerTitle": "Neko"
				},
				{
