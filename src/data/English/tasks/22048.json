			},
			"dialogs": [
				{
					"id": 220480101,
					"content": "The shrine is getting messy again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "Meow, it is you again. Well met.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480104,
					"content": "Ah, the fallen leaves infest the shrine once again. How unsightly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480105,
					"content": "This is no way to greet those humans coming to pay their respects.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480106,
					"content": "Could you aid me in cleaning up the shrine, as you did before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480107,
					"content": "Don't you have Taisuke and Etsuko around?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "I... will not speak to those two green humans of my own accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480109,
					"content": "The tall human always looks upon me with a strange gaze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480110,
					"content": "And the other green human never seems particularly... motivated?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480111,
					"content": "Meow meow, regardless, they are not reliable humans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480115,
					"content": "Whatever the case, I can only rely on you for this task. Just use the long stick to clean it all up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480116,
					"content": "I've got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "Whatever the case, I shall leave this to you. I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480119,
					"content": "I will wait for you here, meow meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480117,
					"content": "I got you, more or less.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "Well, you could ask Mr. Ooshima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "The stone human is always busy with his knock-knock-knocking. Who knows what he is doing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480114,
					"content": "The stone was knocked, after all. What is he knocking this time, I wonder... How annoying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				}
			]
		},
