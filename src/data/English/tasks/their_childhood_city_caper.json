				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "So this is The Steambird? It... doesn't look all that special, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050302,
					"content": "A most ordinary place, yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "Wow, so they really do have a machine bird here! Cool!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "Right? My father often takes me here to purchase a newspaper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "He absolutely loves The Steambird. In fact, he could spend all day just reading the newspaper. Sometimes, he even cuts pieces out and sticks them in a book he keeps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "He calls those his \"reviews,\" and sometimes, he even reads them out to my mother and me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "We don't really like hearing them, though. We just say \"yeah,\" and \"oh,\" and \"is that so?\" and stuff, but he enjoys reading them so much that he doesn't even notice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "And what does he mean by \"review\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "Simply put, a review is a set of opinions that the reviewer expresses from their own perspective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050311,
					"content": "Lovi's father, Delerue, is a scientist at the Fontaine Research Institute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050320,
					"content": "At the same time, he's also a \"reviewer\" who writes \"reviews\" on The Steambird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050312,
					"content": "Yeah, and he sure loves his lengthy reviews of... well, everything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "Sometimes, he'll think of something as he talks, and he'll rush into his room to scribble a draft. He won't even eat while he's at it. He just drinks tea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "Huh. You can make Mora just by giving your opinion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "That alone won't make you a \"reviewer.\" You need to follow some principles if you want to write a review that others will acknowledge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050316,
					"content": "Um... Uh... Well, anyone hungry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "Mr. Louis told me that he's been selling Bulle Fruit-flavored fries recently. Let's go and try some. It'll be my treat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "Oh... yeah, sure! C'mon, brother, stop rambling. Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "You two...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050303,
					"content": "There is nothing all that special about it, yeah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
