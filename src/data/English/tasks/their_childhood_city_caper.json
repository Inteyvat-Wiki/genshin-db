			"trigger": {
				"objectNames": [
					"Verut",
					"Aurele",
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "C'mon, brother, this way! We haven't seen that big house, have we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "Take it slow, Verut, or you'll fall again. You too, Lovi. Your father says that you're in ill health, so you might catch a cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050103,
					"content": "Ugh, your brother's such a nag, just like my mom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "I know, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "You two...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050106,
					"content": "We meet again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "Hey, it's you! Well, we're not playing hide-and-seek this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "More precisely, we're done playing... and we got an earful from Ms. Nour too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050110,
					"content": "She's always so serious when she's at work, lecturing people left and right. And I even gave her biscuits in the past!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Well, whatever, we were tired anyway. I was gonna take Verut and Aurele around to grab something delicious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "Would you like to join us in our... Uh... What do we call it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "A stroll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050114,
					"content": "Yes, a stroll! Come with us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Let's head to the plaza over there. I wanna see the fountain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Well then, lead the way, Miss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Alright then! Let's... head over to the plaza first. The fountains there are all very beautiful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Well, please lead the way, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
			"id": 2400502,
