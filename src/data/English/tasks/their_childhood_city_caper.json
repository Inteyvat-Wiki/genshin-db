				{
					"id": 240050402,
					"content": "Ah, if it isn't Lovi! I'm afraid I'm out of Bulle Fruit for the day. There were too many people at the port, you see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050403,
					"content": "B—But I told you about this a while back, didn't I? And I even brought some friends with me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050404,
					"content": "*sigh* I'm sorry. There were too many customers today, and I forgot... I do have some ordinary fries here, though. Please, take them on the house.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050405,
					"content": "Alright, then. Thanks, Mr. Louis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050406,
					"content": "Are you just missing Bulle Fruit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Well, if you can provide me with some, I could make the sauce right away. I do have some of the other condiments left over...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "Yay! You're just awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "I'm very sorry. It seems that we always trouble you somehow whenever we meet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050412,
					"content": "No need to be so formal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "Alright then. I need to learn from you. Mr. Delerue says that I'm too stolid, which will make becoming a reviewer in the future hard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050415,
					"content": "*cough* Never mind that. I'll watch over the two of them. As for the Bulle Fruit, we're counting on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050413,
					"content": "Let's not get everyone down over this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "I could fetch you some Bulle Fruit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
