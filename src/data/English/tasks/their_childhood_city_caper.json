			},
			"dialogs": [
				{
					"id": 240051201,
					"content": "Sorry for bothering you. I'll take care of them here. Someone's gotta stop them from running off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051202
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051202,
					"content": "If I can become a reviewer for The Steambird, I'll be able to earn an income...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051203,
					"content": "But Mr. Delerue said that if I wanted to become a reviewer, I can't prize Mora too much. Otherwise, I'll start down the wrong path.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051204
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051204,
					"content": "But I really do need the Mora... What should I do... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		}
	]
