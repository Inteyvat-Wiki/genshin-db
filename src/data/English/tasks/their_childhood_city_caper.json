			"dialogs": [
				{
					"id": 240050601,
					"content": "These should do. Please give me a moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050602,
					"content": "Louis starts making Bulle Fruit sauce...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "And we're done! These fresh-from-the-oven fries are on the house. You can eat them right away, but be careful, they're hot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "Nice! Tuck in, all of you. They're great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050605,
					"content": "Oh, and Aurele, don't tell my father about this, or he'll lecture me again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "Heh. Don't worry. In any case, I doubt Mr. Delerue is all that interested in fries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050607,
					"content": "Well... what about me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050608,
					"content": "You just eat up. As for my share, you can split it amongst yourselves. I don't really like eating fries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050609,
					"content": "Hehehe, in that case, I'll help myself! C'mon, here, you should try some too. This is all thanks to you, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Ah, right, I have to go buy Mr. Delerue some coffee later...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050611,
					"content": "Wait, you can't do that! Mom has banned Dad from drinking coffee for a long time now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Every time he drinks coffee, he will cough non-stop in his room. He even goes hoarse in the process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050613,
					"content": "Dad says that he does all this for work, but what sort of work makes you suffer like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050614,
					"content": "...Is this the \"price\" he mentioned for writing excellent reviews?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050615,
					"content": "The work of a reviewer sure seems hard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
