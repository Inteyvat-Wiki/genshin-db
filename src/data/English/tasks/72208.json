				{
					"id": 722080401,
					"content": "You're back! Did you find the charm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080402
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080402,
					"content": "I need a bit more time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080403
					]
				},
				{
					"id": 722080403,
					"content": "Ah, I see, I see. No rush, y'know? Stay safe while you're at it too, friend from afar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080404
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080404,
					"content": "You'll find an isle west of the Autake Plains that faces three waterfalls. The charm I'm searching for is in the waters west of that small island...",
