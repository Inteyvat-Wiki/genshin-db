			"dialogs": [
				{
					"id": 722080201,
					"content": "Thank you so much! Now I can finally board the boat in peace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080202,
					"content": "Where is that boat going, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "To the land of gold, the land of dreams. A realm with no fog. We'll meet again in dreams, friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				}
			]
		},
