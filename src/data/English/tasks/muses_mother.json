			"dialogs": [
				{
					"id": 740730101,
					"content": "The bonfire is still burning. Wait, why is there a bonfire here? This is just a ruin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730102,
					"content": "Let me see what's written on the stone tablet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730103,
					"content": "\"Lo, this place is the Orthant of Memory, the Hall of Memory, the Room of Memory.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730104,
					"content": "\"Born in an instant\"... \"Often contradicting, your company in eternal rest, never separated\"... \"Fire cannot burn it\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730105,
					"content": "Riddles, huh? Ancient Fontainian civilization loved them, and the Narzissenkreuz Ordo enjoyed them too. I'm not sure if they were just into old stuff, or if this was genuine interest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730106,
					"content": "I have already tried keyword searches on all of them, but have found no answers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730107,
					"content": "But this riddle has already been solved. Maybe the answer has something to do with the bonfire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730108,
					"content": "Is there any point in thinking about riddles that have already been solved?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730109,
					"content": "Yes, there is. Just like you and I are both like this now, but we must still search out what happened in the past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730110,
					"content": "You've got a point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730111,
					"content": "#What do you think the answer is, Knight {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
