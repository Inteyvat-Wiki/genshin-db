			"dialogs": [
				{
					"id": 740730401,
					"content": "Shadows.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730402
					]
				},
				{
					"id": 740730402,
					"content": "Yes, shadows.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730403
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730403,
					"content": "The instant a beam of light shines, a shadow is born.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730404
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730404,
					"content": "We know the answer, but someone's already opened the door. So, what do we do now?",
					"roleType": "TALK_ROLE_NPC",
