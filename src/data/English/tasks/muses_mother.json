					"nextDialogs": [
						740730603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730603,
					"content": "Oh, that's right! What do you think it is, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
