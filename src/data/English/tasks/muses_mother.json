			"dialogs": [
				{
					"id": 740730701,
					"content": "Shadows.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730702
					]
				},
				{
					"id": 740730702,
					"content": "Oh, shadows does seem like the right answer! They are with us for our entire lives, and can't be burned by fire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730703,
					"content": "But what's the point in figuring out the answer to a riddle that's already been solved?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
