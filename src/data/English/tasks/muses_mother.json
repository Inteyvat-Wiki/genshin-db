						740730505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730505,
					"content": "\"Lo, this place is the Or... Orth...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730506,
					"content": "Orthant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730507
					]
				},
				{
					"id": 740730507,
					"content": "\"...Orthant of Memory, the Hall of Memory, the Room of Memory...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730508,
					"content": "\"Born in an instant\"... \"Often contradicting, your company in eternal rest, never separated\"... \"Fire cannot burn it\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730509,
					"content": "A riddle, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730510,
