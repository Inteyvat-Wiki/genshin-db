					"nextDialogs": [
						740751802
					]
				},
				{
					"id": 740751802,
					"content": "Did someone... take whatever was here, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751803,
					"content": "Looks that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751804
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751804,
					"content": "Just who is...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751805
					]
				},
				{
					"id": 740751805,
					"content": "It's Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751806
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751806,
					"content": "We had an altercation with him inside Elynas once... Clarification: Recently, not \"once.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751807
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740751807,
					"content": "When I saw that unfortunate victim at the gate, I knew it was his handiwork. It seems he's still active after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751808,
					"content": "Then what does he want with the stuff he took from here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751809,
					"content": "Simple — He too wants to reforge the Holy Blade of Narzissenkreuz. The dream of the Ordo remains unrealized.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751810
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751810,
					"content": "Anyway, we should make our way to the final area now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
