							3923.576
						],
						"pointId": 7248
					}
				]
			},
			"dialogs": [
				{
					"id": 740750201,
					"content": "Someone was just here! Paimon can't believe we've run into someone with better archaeological exploration chops than us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750202,
					"content": "Is that... a pocket watch on the ground?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750203,
					"content": "If this is anything like our usual adventures, we should take a look at this stone tablet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750204,
					"content": "\"Lo, this place is the Orthant of Souls, the Shrine of Souls, the Room of Souls...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750205,
					"content": "\"I accompany you in eternal rest\"... \"Born in an instant, often contradicting, always united\"... \"I am life's most cherished treasure\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750206,
					"content": "Elementary, my dear friend...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "Hmmm... A valuable pocket watch, and one of life's treasures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750209,
					"content": "Ooh, Paimon knows! It's gotta be Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750210,
					"content": "I—I'm not sure about that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "You're right, the answer to a riddle wouldn't be so tacky. Then it must be... What's the word...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750212,
					"content": "Right, \"wealth\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750213,
					"content": "Wonderful, that's one answer we can count out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "Come on! Why can't you just trust Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750215,
					"content": "Well, if you're so smart, what do you think it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750216,
					"content": "Lovely weather we're having.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750217
					]
				},
				{
					"id": 740750217,
					"content": "Hey! Don't change the subject.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750218,
					"content": "It's not important. Let's go in deeper and take a look around.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750219
					]
				},
				{
					"id": 740750219,
					"content": "Hey! Just admit that you don't know either! Don't run off just because you're embarrassed. Wait up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750207,
					"content": "It's a riddle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				}
			]
		},
