			"dialogs": [
				{
					"id": 740751601,
					"content": "You carefully inspect the top of the mechanism, but you don't find anything.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740751602
					]
				},
				{
					"id": 740751602,
					"content": "There's nothing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751603,
					"content": "It looks like something was here, but someone else took it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751604
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751604,
					"content": "Wait, doesn't that mean that our plan's already failed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751605,
					"content": "The birth of \"reason\" requires the merging of the four orthants. If we can get the rest of them, we still have a chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751606
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751606,
					"content": "In that case, we'd better hurry to the next area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
