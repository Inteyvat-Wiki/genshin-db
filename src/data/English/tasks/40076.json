			},
			"dialogs": [
				{
					"id": 400761601,
					"content": "Huh, we've returned here once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761602
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761602,
					"content": "Looks like the story's not finished yet. Let the adventure continue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
