					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "Whoa! Wait, how the...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760902,
					"content": "Another house in Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760903,
					"content": "What are we doing in my house!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760904,
					"content": "Your house? This is your house?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760905,
					"content": "My, how unexpected... I heard Lady Megistus lived a modest life, but this abode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760906,
					"content": "Look at the labels on these books on the ground... \"Only one of its kind, 990,000 Mora...\" Hey! That's super expensive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760907,
					"content": "There are so many expensive-looking hardcovers over here... So this is what an astrologist's room looks like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760908,
					"content": "The rooms are exquisitely designed... This place must be very expensive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760909,
					"content": "So Mona's rich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "Hey, I'm just occasionally out of Mora, that's all. I never said I was a pauper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760912,
					"content": "You're not? Ugh, so what about those times I treated you to meals? And had you over to my place for dinner?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760913,
					"content": "Mein Fräulein, mind your phrasing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760914,
					"content": "Ahem! Thou wert blessed with the coveted opportunity to enter the palace of the Immernachtreich and meet with the Kaiser and Kaiserin der Verurteilung. Or hast thou conveniently forgotten this magnificent occasion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760915,
					"content": "Oh, yes, the stew and cold cuts your mother made were heavenly! Mmm, I could go for some more of that right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760916,
					"content": "Lady Megistus, this is not the time for such things!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760917,
					"content": "Is that Mondstadt cuisine? I wanna try some! I heard Mondstadt has lots of local delicacies, especially meat dishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760918,
					"content": "Hmph, then I shall extend to you the honor of meeting the Kaiser and Kaiserin with me on a future occasion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760919,
					"content": "#Really? Hey {NICKNAME}, we should go too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760920,
					"content": "Now that you mention it, it has been a while since I visited a friend's house. I shall gladly oblige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760921,
					"content": "Oh, but shouldn't we bring some sort of gift?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760922,
					"content": "Those two are very kind and understanding, so please don't worry about that. Just bring yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760923,
					"content": "You seriously have to try her mom's cold cut platter. It's her specialty, or something — anyway, it's simply delightful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760924,
					"content": "Not to interrupt, but perhaps we should start working on the puzzle at hand? Ever since I entered this place, I have found myself most preoccupied with that ornament...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760925,
					"content": "Oh, right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760910,
					"content": "It was my misconception this whole time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "We're back here again. So... Are we completely out of the mirage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761302,
					"content": "How strange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761303,
					"content": "My mirage didn't contain any hints on the Fatui or the machine... Does that mean they had nothing to do with these mirages after all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761304,
					"content": "Or perhaps these mirages are a mere consequence, and not part of a process at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761305,
					"content": "Umm, Paimon's lost...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761306,
					"content": "I mean, these mirages were not steps towards solving the mystery, but rather a direct effect of whatever is going on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761307,
					"content": "Someone did something to bring the mirages into being. As they were just passive side products, it was natural that they couldn't provide us with any useful information.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761308,
					"content": "In other words, those mirages were only about ourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761309,
					"content": "Hmm, pure materializations of ourselves... Interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761310,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761311,
					"content": "Everyone, maybe we should go back to where this whole thing began.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761312,
					"content": "#During our first day on the island, {NICKNAME} and I checked out the Fatui camp together. We found a strange machine there, as well as some disoriented Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761313,
					"content": "This is correct.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "The researcher who spoke to us claimed that the machine was just a Fatui industrial invention. He even promised to not disturb us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761315,
					"content": "Right right, and the cappy-cap guy looked half asleep the entire time. He kept talking nonsense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761316,
					"content": "I wonder, is it possible that \"madness\" and \"mirages\" are two different outcomes of the machine's influence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761317,
					"content": "If so, everything can be traced back to that damaged machine — except for the difference in how it affects people. This, I believe, is caused by differences between the affected people themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761318,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761319,
					"content": "When you put it that way... it is indeed difficult to distinguish dreams and hallucinations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761320,
					"content": "So what you're saying is, the device affected us differently because we are different from the Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761321,
					"content": "Yes, and according to our observations over these past few days, I think... the difference is that we all have stronger willpower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761322,
					"content": "...Yeah, I can get behind that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761323,
					"content": "People with strong willpower will hallucinate instead of falling into madness, but those who break too easily can't maintain a stable mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761324,
					"content": "In other words, we should go back to the Fatui camp and destroy that machine right away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761325,
					"content": "No, it should be repaired, rather than destroyed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761326,
					"content": "What mein Fräulein means is that rashly destroying a machine we do not understand may lead to more serious consequences. It would be better to find a way to repair it first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761327,
					"content": "Right, it pays to be cautious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761328,
					"content": "If my guess is correct, that machine is capable of influencing the human brain. So we'd better tread carefully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761329,
					"content": "So let's go now! There's no time to waste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl",
					"Oz",
					"Mona",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "What a magnificent view...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761502,
					"content": "Lady Megistus, I believe this is the firmest evidence yet of your immense genius. You truly are the greatest archmage in the history of the Immernachtreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761503,
					"content": "Thank you, although the Immernachtreich really doesn't have that much of a history...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761504,
					"content": "...Stars like diamonds, and the moon like a pearl. This is the most brilliant night sky I have ever beheld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761505,
					"content": "It's beautiful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761506,
					"content": "To call up such a mirage, Mona must have a vast and boundless sea of stars in her heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761508,
					"content": "Mona, what's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "...I'm just thinking, these must be the things that we aspire to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761510,
					"content": "This night sky is incredibly beautiful. In fact, I might go so far as to say it's even more beautiful than what I usually see in divinations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761511,
					"content": "All the stars are in their rightful place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761512,
					"content": "...This is definitely my mirage. Only here can I see extraordinary sights like these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761513,
					"content": "Extraordinary? Why do you say that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761514,
					"content": "You know, the night sky of Teyvat is truly marvelous. All the answers in the world seem to have been hidden within.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761515,
					"content": "\"When is my missing son going to be found?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761516,
					"content": "\"Do they love me or not?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761517,
					"content": "\"Will I ever recover?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761518,
					"content": "As your stars move across the sky, they record all your life events in their path. And among all the people in the world, a considerable number will see their stars deviate from their path.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761519,
					"content": "When your stars are on track, it means you will be healthy, happy, and at peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761520,
					"content": "Conversely, if your stars go off track, everything will get worse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761521,
					"content": "The starry sky in my divinations would never look as perfect as this. Some stars would lose their way, and others would fall...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761522,
					"content": "...I wish everyone could be happy, and stay on track.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761523,
					"content": "To this end, I offer advice and tell the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761524,
					"content": "I know it's useless. All fates are already revealed in the night sky, with mine, too, just another among them. I can't change anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761525,
					"content": "Even so... outside of astrology, outside of the words of truth, I still cling to the wisp of an irrational fantasy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761526,
					"content": "We must all live within the confines of reality, but... call me presumptuous, but I still believe in miracles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761527,
					"content": "In this vast sea of stars, there are stars for you, for me, for everybody.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761528,
					"content": "What are the chances of one star encountering another? Are these encounters not the most wonderful miracles in all of destiny? ...I don't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761529,
					"content": "But within Teyvat, the stars in the sky will always have a place for us. Even if astrology is resolutely rational, fate remains arbitrary, cruel, but romantic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761530,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761531,
					"content": "Mona, you seem to have been deep in thought...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "Have you found the answer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "...I think I have figured out what those stars are hiding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761534,
					"content": "\"Now, I will seize my own destiny.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007616,
			"completionStepIds": [
				4007616
