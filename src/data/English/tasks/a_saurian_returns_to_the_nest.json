			"dialogs": [
				{
					"id": 750320101,
					"content": "Nice view, don't you think? Perfect for flying too. Soaring through the skies, following the wind... It's an awesome feeling all around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320102,
						750320103
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320102,
					"content": "Indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				},
				{
					"id": 750320104,
					"content": "Ho there, warrior! If it's a trial flight you're after, feel free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320105
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320105,
					"content": "My father built this place for me, but I don't mind sharing it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320106,
						750320107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320106,
					"content": "Thanks, I was just thinking about giving it a try.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320108,
					"content": "You're welcome! Anyone who loves flying is a friend of Manyoya's! That's me, by the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320109
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320109,
					"content": "You look a little young for the Saurian flying squad. Are you a reserve rider? Or are you training to become a warrior?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320110
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320110,
					"content": "We're just passing adventurers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320111
					]
				},
				{
					"id": 750320111,
					"content": "Oh? I rarely see adventurers so passionate about flight. Until a moment ago, I thought you were training for the flying squad exam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320112
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320112,
					"content": "Soaring through the skies... Now that's a feeling you never forget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320113
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320113,
					"content": "Doubt you'll find a soul who wouldn't hold onto that freedom no matter what, and I'm no exception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320114
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320114,
					"content": "You sound like you're in the know. Are you from the flying squad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320115,
					"content": "Haha! I used to be! I'm retired now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320116
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320116,
					"content": "I flew for quite some years — and while that doesn't make me too old by most measures, I was a real veteran in the flying squad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320117
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320117,
					"content": "So when my physical condition fell off from where it used to be, it was time to say goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320118
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320118,
					"content": "No need to pity me. Haha! I'm not even sad, though it is quite regrettable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320119
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320119,
					"content": "Our young Saurian riders have just started taking to the air, but I've already caught a shooting star.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320120,
					"content": "Things won't be the same anymore, of course, and I won't get to spend most of my day in the sky, I still have a chance to soar up there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320121
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320121,
					"content": "So, that's why I'm here, reminiscing about the life I've given up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320122
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320122,
					"content": "Shame that flying solo is quite boring without the company of my squadmates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320123
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320123,
					"content": "Oh, yeah, how'd you like to fly with me? Our squad often had little competitions, just for fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320124
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320124,
					"content": "The one with the highest score would get tossed into the air while the lowest would pay for our meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320125
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320125,
					"content": "You Saurian riders are a tight-knit bunch, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320126,
					"content": "Yeah, everyone's amazing. We're both squadmates and rivals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320127
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320127,
					"content": "Ah, not that I'll ever get to enjoy that atmosphere again... Nor can I deny that my skills are on an inexorable downhill slide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320128
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320128,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320129
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320129,
					"content": "But even should physical strength decline and judgment dull, experience never stops stacking up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320130
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320130,
					"content": "So I might have retired, but that's just from the squad — not from the skies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320131,
					"content": "So, shall we compete? Think you can catch a veteran Saurian rider in the air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320132,
						750320133
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320132,
					"content": "We're in.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320134,
					"content": "Huh. I was worried for a moment that you'd think me a freak for abruptly mentioning these things to a youngster like you. Thank goodness you didn't.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320135
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320135,
					"content": "But let me know when you want to give it a whirl. Let's set this as our objective:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320136
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320136,
					"content": "Ride your Saurian as far as you can along the designated course within the time limit. I'll help you keep score. The results are divided into 4 grades, and we'll count this as your win if you can beat the second-highest tier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320137
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320137,
					"content": "Let me know when you're ready to challenge me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320133,
					"content": "Let me think about it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320107,
					"content": "Thanks. I'll think about it when I'm free.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320103,
					"content": "Hello there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				}
			]
		},
		{
			"id": 7503202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503203",
							"2"
						],
						"stepId": 7503203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "So, are we competing, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320202,
					"content": "Ride your Saurian, and fly at full speed along the course, striving to get the highest possible score within the time limit. <color=#00E1FFFF>It counts as a win for you as long as you exceed the second-highest score tier.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320203,
					"content": "I'm ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "Nice! Let's head to the starting point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320205,
					"content": "I need a little more time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "Of course. Just let me know when you're ready. Flying has always been about relaxing and having fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503204,
			"completionStepIds": [
				7503204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503204",
							"2"
						],
						"stepId": 7503204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "Hahaha! You were great! Guess it's true what they say, that the young are bound to surpass the old.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320402,
					"content": "Even stars may fall, let alone people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320403,
					"content": "My time is over. Retiring happily was the right choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320405,
					"content": "... Ah, but it's just so difficult to accept. I'm still young, I don't even have wrinkles. Why do I even have to retire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320406,
					"content": "How could my career be over so soon? I started falling before I could even experience what it was like to reach the top.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320407,
					"content": "Had I known I'd have so many regrets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320408,
					"content": "Never mind. If I could do it all again, I would still make the same choices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320409,
					"content": "I would still do my best to join the flying squad, which isn't difficult given my skills. Then I'd wind up retiring at this age again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320410,
					"content": "I've done my best, and all I can do now is accept it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320411,
					"content": "I guess that's life. Many things are beyond our control, and if you dream of being a hero, perhaps you must accept that you can shine for but an instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320412,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320413,
					"content": "#Not to worry, {M#he}{F#she}'s a brilliant flier. You had this pitying look the whole time, so why the uneasy face now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320414,
					"content": "Haha! Life's full of surprises, and they'll come whether you accept 'em or not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320415,
					"content": "Consider it a pearl of wisdom from a retired Saurian rider. My issues are my own to solve. Don't let them ruin your mood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320416,
					"content": "I'm impressed. If only my siblings were as calm as you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320417,
					"content": "You have siblings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320418,
					"content": "That's right. Two younger brothers, and unlike you, they're a chore and a half to get through to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320419,
					"content": "They're training their flying skills too— Well, no. Acomitl's just focused on running away from it all, so he might've been hiding instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320420,
					"content": "Forget about those brats. I can see your talent, clear as day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320421,
					"content": "Try training a little more if you get the time. Who knows? The flying squad may come knocking at your door.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320422,
					"content": "I'll try my best.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "That's good to hear. I hope I'll catch you flying again. Good luck, young warrior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503206,
			"completionStepIds": [
				7503206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503206",
							"2"
						],
						"stepId": 7503206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320601,
					"content": "It's time for my Saurian to return to its nest. Shall I too descend from the stage in the skies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320602,
						750320604
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320602,
					"content": "Don't stop flying.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320603
					]
				},
				{
					"id": 750320603,
					"content": "I guess you heard me mumbling to myself, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320606,
					"content": "I should make a trip home — haven't told my family about my retirement yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320607
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320607,
					"content": "I'll have a bunch of free time soon, but I haven't figured out what to do with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320608
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320608,
					"content": "Once I find my bearings, I'll have to face the next stage of my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320609
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320609,
					"content": "So I should hear what my family has to say about it first. My father used to be in the flying squad, and he became a training master after retirement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320610
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320610,
					"content": "He's been on this path, so he's got to have some thoughts on the matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320611
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320611,
					"content": "So, I'll be dismantling this place and taking it with me, but I'll leave the course here. Young warriors like you still need a place to train, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320612
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320612,
					"content": "Will we meet again, Manyoya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320613,
					"content": "I don't know. But no matter what choice I make, I don't think I can ever give up on the skies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320614
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320614,
					"content": "So as long as you don't stop flying, I think we'll meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320615
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320615,
					"content": "Until next time, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320616
					]
				},
				{
					"id": 750320616,
					"content": "See you, young warrior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320604,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320605
					]
				},
				{
					"id": 750320605,
					"content": "Oh, there you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320606
					],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
