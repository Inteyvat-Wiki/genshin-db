					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "Not that easy, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320802,
					"content": "Our captain would be furious if word got out that we flying squad members could be surpassed by just any passing adventurer. Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320803,
					"content": "Alright, it's nothing to be upset about. I should be thanking you for keeping my pride intact, if anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320804,
					"content": "You flew quite well, but it's still too soon for you to surpass me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320805,
					"content": "If you think you can do better, why don't you give it another try? You should never stop trying while you're young. Losing isn't a big deal anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
