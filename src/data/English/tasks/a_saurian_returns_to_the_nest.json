			"dialogs": [
				{
					"id": 750321201,
					"content": "Ride your Saurian, and fly at full speed along the course, striving to get the highest possible score within the time limit. <color=#00E1FFFF>It counts as a win for you as long as you exceed the second-highest score tier.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		}
