	"talks": [
		{
			"id": 7181601,
			"completionStepIds": [
				7181601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181601",
							"2"
						],
						"stepId": 7181601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "How am I supposed to deliver this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "You're a traveler, I'll wager. You're quite the lucky one, to have come to Liyue just as the Lantern Rite is beginning. I, on the other hand, don't have much time for celebration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160104,
					"content": "We natives of Liyue have a tradition of releasing Xiao Lanterns during the Lantern Rite. Every year, the amount of lantern-making materials making the rounds through the trade routes is massive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160105,
					"content": "And it might just be my imagination, but it feels like this year's got even more cargo than usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160106,
					"content": "It's all a little too much for me right now, and what's more, that merchant keeps rushing me, without any consideration for the road conditions here in Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160107,
					"content": "I'm of a mind to ask someone for help, but haven't been able to find anyone suitable. You up for an escort job?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160108,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "Great! I like straightforward people. If only the person we were escorting was more like you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160110,
					"content": "His name is Fran, uh... Francis. Ugh, I don't have a head for foreign names.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160115,
					"content": "If you're helping out, meet me at the place where the stores are being kept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160116,
					"content": "I've marked that spot on your map. I'll be heading there first. Let's meet up in a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160111,
					"content": "A merchant from Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "That's right. What was his name again... Fran... Francis? Ugh, foreign names are so hard to pronounce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160113,
					"content": "I don't know what he wants with such a large batch of goods either, but... Well, so long as he's paying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160114,
					"content": "Don't worry, you'll get your fair share once the work's done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181603",
							"2"
						],
						"stepId": 7181603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "Well, this is where we store the goods. I do realize that I'm troubling you to help out, so you just need to escort this one Transport Balloon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160202,
					"content": "But let me just remind you, the cargo it carries is entirely made of fragile materials used in Xiao Lantern construction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160203,
					"content": "It won't do if they get damaged or burned, so you have to be careful while you're out there on the road.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160204,
					"content": "Best be on your guard, monsters and Treasure Hoarders pass this way from time to time, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160205,
					"content": "Well, I'll leave this run to you. Just make sure the goods get to Francis safe and sound, and we'll meet afterwards on the bridge southwest of Chihu Rock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181603,
