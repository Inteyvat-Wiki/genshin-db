			},
			"dialogs": [
				{
					"id": 718160301,
					"content": "Where's that cargo... My stomach's growling already...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181604,
			"completionStepIds": [
				7181605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181605",
							"2"
						],
						"stepId": 7181605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Francis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "These are... the goods I ordered. My word, they're finally here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160402,
					"content": "From your style of dress, friend, you must also not be a Liyue local. Am I right in saying so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160403,
					"content": "Ah, friend, I do not know if you have had the privilege of trying Liyue's delicacies, but they are lovely. Believe me, they are absolutely worth a try!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160404,
					"content": "Alright, now that my cargo has arrived, I can return to eating in peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181605,
			"completionStepIds": [
				7181610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
