			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "I've been in contact with Francis. He's received that batch of goods — thanks a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160502,
					"content": "When did you do that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "Haha, oh, not to worry. Guards for hire like myself are quicker on our feet than most, and when it comes to handovers... We're pretty quick there, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160504,
					"content": "It's thanks to your help that this run went smoothly. And just so you know, I'm a believer in reasonable pay for all. So give me a moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160505,
					"content": "Not taking a break for the Lantern Rite?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "In our line of business, you never know when there'll be work. Can't even be home for the Lantern Rite... But then again, it can't be helped.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160507,
					"content": "If you're traveling the world, you should go to Liyue to experience the Rite — everyone should be releasing Xiao Lanterns at this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160508,
					"content": "What about you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "Oh, I do work outside the city year in and year out. Never quite had the time to release a Xiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160512,
					"content": "If I had a ready-made one, it sure would be nice to release one for good luck, but I haven't the time to put a lantern together myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160513,
					"content": "I'm missing out on that festive cheer for sure, but I guess it doesn't matter that much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160514,
					"content": "Why don't I make you one?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "Huh? You'll get one for me? You're... a pretty nice person, aren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160515,
					"content": "Oh, leave this to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160510,
					"content": "Have you released a Xiao Lantern yet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160511
					]
				},
				{
					"id": 718160511,
					"content": "Not yet. Traveling guards like us don't have time for that sort of thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181607,
			"completionStepIds": [
				7181608
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181608",
							"2"
						],
						"stepId": 7181608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160701,
					"content": "Oh, this Xiao Lantern's pretty good. Thanks! Let me see, what should I write...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160702
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160702,
					"content": "Ah, I don't think I can come up with anything good... Let's just go with \"may everything go well,\" I guess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160703
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160703,
					"content": "As long as all things go as I expect them to, I'll be thankful to Rex Lapis already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160704
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160704,
