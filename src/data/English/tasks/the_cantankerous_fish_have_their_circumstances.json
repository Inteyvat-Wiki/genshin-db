			"dialogs": [
				{
					"id": 747090101,
					"content": "#Thank you for all your hard work, {NICKNAME} and Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090102,
					"content": "I have a pretty good understanding of our patients' condition now, so I've mixed them up some special Melusine medicine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090103,
					"content": "Adding these herbs to the water tank should help calm them down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090104,
					"content": "So you're basically turning the whole tank into a giant health spa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090105,
					"content": "That really is a plan that only you could pull off, Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090106,
					"content": "But won't this only temporarily relieve their symptoms?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "You're spot on. I'll need to invite a whole variety of different fish here for physical examinations before I can determine exactly what's wrong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090109,
					"content": "I'll put together a list of patients to check based on the characteristics I need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090110,
					"content": "I'd appreciate it if you could keep a close eye out for any fish that meet the criteria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090107,
					"content": "To completely cure them, we still need to find the root cause...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				}
			]
		}
	]
