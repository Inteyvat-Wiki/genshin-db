			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Treasure Hoarder Boss"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "P—Please, stop! We've lost! Please, spare us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300402,
					"content": "Pack it up and get ye gone!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "Y—Yes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300405,
					"content": "But... Dare I ask what we've done to offend you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300406,
					"content": "Did you find some treasure in this area, by any chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300407,
					"content": "We're rebuilding a temple nearby.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "R—Rebuilding a temple? In the middle of these mountains?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300409,
					"content": "...There's a temple commemorating an adeptus here!? Wait a minute. Could it be that old house...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300410,
					"content": "Boss, we did see a statue of a bird while we were resting there previously. That must've been...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Treasure Hoarder Sidekick"
				},
				{
					"id": 718300411,
					"content": "That's Pervases, one of the Yakshas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300413,
					"content": "B—Boss! D—Did we really offend an adeptus...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Treasure Hoarder Sidekick"
				},
				{
					"id": 718300414,
					"content": "S—Stop talking nonsense! We didn't know, so that didn't count! It was ignorance! I don't think the adeptus will judge us... Right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300415,
					"content": "Anyway! Thank you for telling us of the reparations being done on the temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300416,
					"content": "We apologize for our previous ignorance and rudeness...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300417,
					"content": "We'll go back and tell the others to give the temple a wider berth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300418,
					"content": "Boss, shouldn't we go there and light a few sticks of incense to apologize to the adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Treasure Hoarder Sidekick"
				},
				{
					"id": 718300419,
					"content": "Hey, hey, when did you become such a talker! Come on, let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Treasure Hoarder Boss"
				},
				{
					"id": 718300403,
					"content": "Don't come near this place in the future.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
