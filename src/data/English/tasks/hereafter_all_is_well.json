			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "This is turning into quite the project...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300202,
					"content": "You're really fixing this place, huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Ah, it's you. I mean, I did say that I was an upstanding citizen now, didn't I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300204,
					"content": "I must say though, it's a much bigger project than I originally thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300205,
					"content": "The designer I brought in to plan the new temple got really fired up the moment I told him that this was a Yaksha's temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300206,
					"content": "Not only did he draw up sheet after sheet of plans, he even dragged me off to buy materials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300207,
					"content": "If he was a few decades younger, I bet he'd insist on working on this himself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300208,
					"content": "You haven't encountered any danger, have you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "Danger? Oh, you mean monsters and Treasure Hoarders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300212,
					"content": "You needn't worry. Once they got wind that I was repairing a Yaksha's temple, the Ministry of Civil Affairs assigned some Millelith to help with security.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300213,
					"content": "They've more or less chased all the nearby monsters away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300214,
					"content": "As for the Treasure Hoarders... They seem to be lying low now that the Millelith are here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300215,
					"content": "However, the volume of work required to fix this temple has really exceeded my expectations. Turns out we didn't prepare enough materials, so we've had to order in more supplies from the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300216,
					"content": "And while those Treasure Hoarders probably wouldn't make a move at the worksite itself, they might lie in ambush along the delivery route to steal the materials along the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300217,
					"content": "The Millelith can hold the worksite, no problem. But if the delivery gets attacked by Treasure Hoarders, there's no way they'd be able to respond in time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300218,
					"content": "Could I ask for a favor from you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300219,
					"content": "I know how skilled you are. Those Treasure Hoarders are definitely no match for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300220,
					"content": "Could you go and teach them a lesson and dissuade them from disrupting our work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300221,
					"content": "I'll do it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Thank you. Thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300223,
					"content": "Why don't you ask the Millelith?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "They're already guarding this worksite day and night. I wouldn't want to tire them out further.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300225,
					"content": "I'll leave this to you then, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300210,
					"content": "I recall that this area wasn't the safest...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "You mean how the surrounding area is full of monsters and Treasure Hoarders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
