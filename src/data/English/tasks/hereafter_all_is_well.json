			},
			"dialogs": [
				{
					"id": 718300601,
					"content": "Alright. I'll take this <color=#00E1FFFF>Sandbearer Wood</color> timber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300602
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300602,
					"content": "The temple will take a while more to repair, so I'll remain here for the time being.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300603,
					"content": "If you have the time, you can come by and check on things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
		{
