			},
			"dialogs": [
				{
					"id": 240010301,
					"content": "Well, there it is — and looking quite good, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010302,
					"content": "I wonder when Ms. Staelle will realize that dogs have no love for the opera, or for her novels?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010303,
					"content": "Let us return — she's probably worried sick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blathine"
				}
			]
		},
