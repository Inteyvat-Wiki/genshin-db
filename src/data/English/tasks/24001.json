			"dialogs": [
				{
					"id": 240010501,
					"content": "Is it that Barea doesn't like my new novel? *sigh* But everyone else thinks it's pretty good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010502
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010502,
					"content": "Perhaps I should read it a nicer passage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
