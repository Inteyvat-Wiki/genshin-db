					}
				]
			},
			"dialogs": [
				{
					"id": 240010101,
					"content": "Please, help me out! I was just thinking about the novel's story, and before I knew it, Barea was just gone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010102,
					"content": "Are you sure you didn't leave it at your seat in the opera house, or left it tied to the restroom door, or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010103,
					"content": "I've already searched all those areas. I've even looked under that seat, but Barea wasn't there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010104,
					"content": "Oh, the mere thought of it, that my little Barea would be kidnapped by someone, or perhaps follow someone blindly as if stricken by puppy love...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010105,
					"content": "Ms. Staelle, I'm quite sure that Barea wouldn't make the same mistake twice like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010106,
					"content": "Ah, but my Barry-boo is still so little... and little children make the same errors many times, and even revel in it, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010107,
					"content": "I'm... quite certain that Barea is not as young as you say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010108,
					"content": "And who's this Barea, if I might ask?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "Ms. Staelle's dog...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010111,
					"content": "My family.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010112,
					"content": "Yep. Her family has gone missing, and she's asking for my help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010113,
					"content": "Ms. Staelle, we have already searched this area once. I would wager that Barea has headed off into the wilds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010114,
					"content": "Then let us go there too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010115,
					"content": "Please, Miss, I ask you to stay in the city. With the dress you wear, you would not be able to catch Barea even if you found it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010116,
					"content": "Nonsense! Why, Barea would jump into my arms if it so much as saw me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010117,
					"content": "Then I suppose it heard us not when we were calling up and down the theater, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010118,
					"content": "Well, there you have it. I'm afraid I cannot bring Barea back to Ms. Staelle alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010119,
					"content": "I cannot simply leave my post for long, much less ask another colleague to leave theirs with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010120,
					"content": "But if you're willing, Traveler, could you help us both out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010121,
					"content": "Well, it wouldn't be a problem, per se...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "Well, that's settled, then. Please come with me to the wilds — we shall look for Barea together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010125,
					"content": "Considering its weight and stamina, it cannot have run too far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010126,
					"content": "What!? My Barea is most healthy, thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010127,
					"content": "I would agree — if we were talking about its mental health.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010128,
					"content": "Let us be off — lest Barea gain a taste for the outdoors and run still further away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010129,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010122,
					"content": "You police need to deal with this stuff too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "If the citizens of the Court of Fontaine ask me for help, I have no reason to refuse them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010109,
					"content": "How may I assist thee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
		},
