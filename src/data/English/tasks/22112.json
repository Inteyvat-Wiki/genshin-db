				{
					"id": 221120301,
					"content": "Found them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120302,
					"content": "Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120303
					]
				},
				{
					"id": 221120303,
					"content": "Let's see... Yes, that should be enough. Thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120304,
					"content": "Right, I should get to work. I need to repair this as quickly as I can...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 2211205,
