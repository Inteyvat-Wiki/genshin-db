					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120501,
					"content": "There, that should do it. I don't think anyone's going to fall on this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120502,
					"content": "It doesn't match the style though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "Not much I can do about that. I'm not some sort of master craftsman, you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120504,
					"content": "Wait... That was only one of them. There's another hole I still need to fix...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120505,
					"content": "Oh well, that will have to do for today. The inn is still open and I need to go back to serving the guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120506,
					"content": "No matter how badly it needs fixing, business is business... Thanks for your help. Take this for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
