			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "Looks like this is going to need repairing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "Ah, it's you. See for yourself — the staircase is broken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120104,
					"content": "It's in pretty bad shape. Someone is definitely going to have an accident if it isn't repaired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120105,
					"content": "How it broke, you ask? Well, a group of monsters tried to get inside, so I came out to fight them off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120106,
					"content": "I should have pulled my punches... I sent one of the big heavy ones flying and he landed right on the staircase. It smashed on impact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120107,
					"content": "I promised myself I'd fix it but I just haven't found the time. Reason being, the inn is just getting busier and busier at the moment. All the more reason why this repair is getting urgent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120108,
					"content": "It's not a difficult job. I can easily repair this myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120109,
					"content": "If you have the time, could you fetch some Wooden Planks for me? I need to stay here in case someone else misses their step...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120110,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "Great. I actually bought the Wooden Planks already, they're currently stored just outside the inn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120112,
					"content": "See if you can find them and bring a few back here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120113,
					"content": "Won't it just get smashed again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "That won't happen. I'm getting old anyway... and I'll make sure I restrain myself next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120115,
					"content": "In any case, it needs fixing whatever happens. I actually bought the Wooden Planks already, they're currently stored just outside the inn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120116,
					"content": "Please bring a few of them here for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
