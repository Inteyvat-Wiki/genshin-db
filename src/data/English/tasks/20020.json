			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "Oh, so that's how it is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200102,
					"content": "Brother, do you know what these plants can do aside from being edible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200103,
					"content": "How am I supposed to know that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200104,
					"content": "I just know where you can find them and whether you can eat them or not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200105,
					"content": "Huh... Then I guess I should go check them out myself. Don't worry, I'm just going to gather some plants. I won't go anywhere near those monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200106,
					"content": "...Oh, just be careful, will you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200107,
					"content": "I know, I know. Well, I'll be a bit late back today, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200108,
					"content": "Still training, Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "Hey there, Traveler! Great timing — I was just planning to go out to observe some plants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200111,
					"content": "Cyrus told me that adventurers will often camp out in the wilds, where foraging is a very important skill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200112,
					"content": "As such, I'm planning to go investigate some wild plants, check out their features and characteristics, and then commit them to memory slowly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200113,
					"content": "That way, I'll at least know what I can and cannot eat out there in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200114,
					"content": "However, I don't think that pure writing is going to be very intuitive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200115,
					"content": "Traveler, I've heard that you have a gadget known as the Kamera. Is that true?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200116,
					"content": "If so, could you help me snap some photos of a few plant species in their natural habitats?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200117,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "Nice! In that case, could you get me photos of Calla Lilies, Small Lamp Grass, and Cecilias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200119,
					"content": "After that, please help me gather these three plant species. I'd like to keep them as samples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200120,
					"content": "Images of these plants in their natural habitats, live specimens, and detailed descriptions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200121,
					"content": "The botany section of my handbook looks to be in pretty good shape!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200122,
					"content": "Alright then, Traveler, I'm counting on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200123,
					"content": "The spring in Springvale plays host to large numbers of Calla Lilies, while Small Lamp Grass is common in Wolvendom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200124,
					"content": "As for Cecilias... it's got to be Starsnatch Cliff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200125,
					"content": "I'll continue my own plant observations elsewhere in the meantime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200126,
					"content": "Once you've got the pictures, let's meet up in the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200109,
					"content": "How's your training coming along?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
			"completionStepIds": [
				2002025,
				2002026
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2002025",
							"2"
						],
						"stepId": 2002025,
						"stateName": "QUEST_STATE_UNFINISHED"
