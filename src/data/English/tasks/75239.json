						752390104
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390104,
					"content": "But Zhaka, my apprentice, hasn't been showing up for work lately. He still has three left to paint, and I've got no idea where he put them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390105,
					"content": "Would you mind helping me look for them? I think they should be nearby.",
