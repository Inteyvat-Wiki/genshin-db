			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Loud Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Who're you? This is my seat, and everyone in the tavern knows it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150102,
					"content": "Did you only just report in on the island or something? You can't just turn up and take someone else's spot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150103,
					"content": "Also, where the devil's my beer? Hurry it up, would ya? I'm going out on patrol soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150104,
					"content": "Tavern? Beer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "If you must have it! But first, come and drink and sing with us. Once we're friends, sit anywhere you please!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150107,
					"content": "You know the tune, right? Yo-ho, come on now! We'll sing one line, you'll sing the next!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150108,
					"content": "\"The sound of dancing drifted from my neighbors', it set my feet a-tapping, oh!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "No, no, no! Are you serious? Everyone from Nod-Krai knows this song, come on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150113,
					"content": "If you don't sing and have some fun, you're not gonna fit in, y'know? An' things don't go so good for soldiers without buddies when the Wild Hunt strikes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150114,
					"content": "Go learn the song, then come back here, you got that? Ya-hey! Hit me with another beer, come on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150110,
					"content": "\"My buddy Paimon's a funny gal, she sets me laughing, ho-ho-ho!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "\"The island ghosts gather 'round the chair, singing and dancing to and fro!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Just lend me the seat for a bit, would you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
