				{
					"id": 760150207,
					"content": "You know the tune, right? Yo-ho, come on now! We'll sing one line, you'll sing the next!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150208
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150208,
					"content": "\"The sound of dancing drifted from my neighbors', it set my feet a-tapping, oh!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150209
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150209,
					"content": "\"You're all smiling, the fiddle I'm playing,\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "\"And we're all dancing to and fro!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150211,
					"content": "\"Come crowd around, let's dance away!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "Haha! That's right, that's the way! You're quick on the uptake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150213,
					"content": "The name's ███. Well, that makes us acquainted. The chair's all yours — I'm a generous fellow, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150214,
					"content": "You're a Ratnik too, eh? Don't worry, this drink's on me. Maybe we'll see each other again during training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150215,
					"content": "Thank you — even though I can't drink it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Well, I'm heading out on patrol. See you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loud Phantom"
				},
				{
					"id": 760150216,
					"content": "Well met, sir. You may call me Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "And if I say I want to sit here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
