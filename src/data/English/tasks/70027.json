				"points": []
			},
			"dialogs": [
				{
					"id": 700270101,
					"content": "You're just in time. The calibration work on Pursina's Spikes is going quite smoothly indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270102,
					"content": "As long as we can secure the components we need, they can be repaired in no time at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270103,
					"content": "I did gather some.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "Thank you, that's a big help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270105,
					"content": "Now that we have these, this won't take long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270106,
					"content": "There is still one small matter that I thought it best to discuss with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270107,
					"content": "When you were collecting components these past few days, I scrutinized the inner workings of the Pursina's Spikes we have on hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270108,
					"content": "They are very intricate tools, as I suppose I should have expected from one so skilled as Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270109,
					"content": "Even a small adjustment can greatly affect the function of the entire machine, so I was somewhat worried if our calibrations would achieve their intended effect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270110,
					"content": "For safety reasons, I hope to ask you to give it a few trial runs. I will then make further calibrations based off the data you collect in these trials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270111,
					"content": "This way, we can ensure that our Spikes are functioning at peak efficiency. Otherwise, things might get dicey if they malfunction when you engage that anomalous model.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270112,
					"content": "Very conscientious of you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "Well, this is my first time working with Pursina's Spikes, so it's best to err on the side of caution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270115,
					"content": "Well, I leave the tests in your capable hands, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700270113,
					"content": "I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
}