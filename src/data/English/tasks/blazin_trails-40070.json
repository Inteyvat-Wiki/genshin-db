				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701801,
					"content": "We've done everything we can, but how do we deal with the last two mountains?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701802,
					"content": "Let's stick to it. There's gotta be a way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701803,
					"content": "After taking a closer look, it seems to me that most of the island mountains contain water veins and plants in their interior. Those together form a system that connects the mountains with one another.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701804,
					"content": "However, now that much of the mountains have collapsed, the connection of plants and water veins is blocked.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701805,
					"content": "If we can dredge all the blockages, we will be able to connect the islands to form the giant instrument described in Albedo's notes, and play music using the islands themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701806,
					"content": "Yep, for me to reach my goal, we gotta do this... But first, I'd like to consult the flower. It should know what to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007019,
			"completionStepIds": [
				4007019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007019",
							"2"
						],
						"stepId": 4007019,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Frozen Soul"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701901,
					"content": "Can you feel anything, now that we've planted the petal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701902,
					"content": "Yes, I can feel it. The sun is shining brightly, the sea gleams like a gemstone, the waves lap the milky-white beaches, and the grains of sand are pulled into the sea, then pushed back ashore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400701903,
					"content": "...the seabirds are landing on the rocks, pecking gently and making rhythmic sounds. ♪ dum-dum, dum-dum ♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400701904,
					"content": "It's music.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701905,
					"content": "This is indeed music. In fact, this whole island is a giant musical instrument. Since you are a musician, you should be able to understand the meaning behind its original creation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400701906,
					"content": "Making music with the tides, waves, and sea breeze as your instruments is the most romantic thing in the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701907,
					"content": "Let's go, everyone. It's time for my performance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		}
	]
}