			"trigger": {
				"objectNames": [
					"Xinyan",
					"Blazing Heart"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "Some of the plants and water veins on the island mountains have been lost. Do you happen to know another way to dredge the blockages?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700402,
					"content": "I know someone who can help you with that. Go ask my companion, Frozen Soul, who lives upstairs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blazing Heart"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Frozen Soul",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "Who are you, and what brings you to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400700502,
					"content": "Nice to meet you. We were wondering if we could use your power to dredge the mountains on the island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700503,
					"content": "Mountains? Oh, I see... you want to become great musicians too, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400700504,
					"content": "Oh? Is that what this is about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400700505,
					"content": "Correct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700506,
					"content": "In that case, we seek the same thing. Despite my frailty, I feel obligated to share some of my power with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400700507,
					"content": "Plant my petal at the ending point of the intersection of melodies, and what had once sunk into the earth will re-emerge with the music. As long as there is music, life will continue to flourish in this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "Frozen Soul"
				},
				{
					"id": 400700508,
					"content": "...Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701002,
					"content": "Finally, the time has come.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701003,
					"content": "Everyone, I once made a wish to perform with someone no one could have expected. And today, on this island, I've found my answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701004,
					"content": "No one knows the name or appearance of the man who transformed this island into a giant musical instrument so many years ago, but he is unquestionably one of Teyvat's greatest musicians.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701005,
					"content": "I never imagined I'd be able to see such an instrument, and I never imagined we'd be able to play it during a high tide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701006,
					"content": "Are you going to play some rock 'n' roll?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701008,
					"content": "Music is the gift one gives to their kindred spirit, so... I'll play something that makes for a better duet with the original musician.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701009,
					"content": "No rock music for today. Instead, I'm gonna show you something new!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701010,
					"content": "...Phew.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701011,
					"content": "How was it? Not bad, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701012,
					"content": "Quite impressive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701013,
					"content": "I've never heard a duet like that before. It was very interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701014,
					"content": "And so elegant as well! Paimon's not sure how best to put it... But it was just super unique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701015,
					"content": "A performance with a lot of personality.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "Hehe, thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701018,
					"content": "And now I can say my wish has come true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701019,
					"content": "Is there anything else you'd like to do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701020,
					"content": "No, in fact, I reckon I'll get a good night's sleep tonight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701021,
					"content": "Does this mean everyone is free for the time being? If so, I have a suggestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701022,
					"content": "I'd like to return to the Fatui camp, and see what's going on there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701023,
					"content": "Oh? So you've discovered the Fatui camp as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701024,
					"content": "Wait, you know about it too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701025,
					"content": "Of course, I'm a genius astrologist. Didn't I mention that my scryglass has recovered a little? I can sense what's going on here through divination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701026,
					"content": "Uh, I didn't know the Fatui were here too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701027,
					"content": "Indeed. I also informed Fischl of this when we parted ways today. If she runs into them, she'll stay hidden and out of danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701028,
					"content": "I see, then perhaps we should tell everyone what we know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701029,
					"content": "You tell everyone about the Fatui camp and the strange machine you found on the day you arrived...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "A strange machine, and delirious Fatui...? Are you suggesting these are connected to the mirage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701031,
					"content": "I can't say I'm certain, but I don't believe they are completely unrelated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701032,
					"content": "Fair enough. Let's go check out the camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701016,
					"content": "A performance with a lot of charm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
