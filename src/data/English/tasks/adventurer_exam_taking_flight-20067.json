			"dialogs": [
				{
					"id": 200671401,
					"content": "Wow, you're really good at this! No wonder Amber said that I could learn a thing or two from you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200671402
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200671402,
					"content": "Hehe, with you as my coach, this exam will be a cinch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200671403
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200671403,
					"content": "Thanks so much! Here, these are for you. I'm off to revise some more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200671404
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200671404,
					"content": "I wonder what color my wind glider should be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200671405
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200671405,
					"content": "Blue? Green? Maybe a bit of both, perhaps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
