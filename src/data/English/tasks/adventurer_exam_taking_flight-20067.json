			"dialogs": [
				{
					"id": 200671301,
					"content": "Hmm... I think I've more or less got it all down now! But I won't get anywhere just by listening...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200671302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200671302,
					"content": "Traveler, could you give me a demonstration of wind glider usage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200671303,
						200671304
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200671303,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200671305
					]
				},
				{
					"id": 200671305,
					"content": "I sure will! Let's get going, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200671304,
					"content": "Watch closely now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200671305
					]
				}
			]
		},
