			"trigger": {
				"objectNames": [
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "You're just in time, Traveler! I was just looking for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270102,
					"content": "Eh? What's up, Little Meng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "Do you remember when I asked you to help me send a drifting bottle downriver with my worries in it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270104,
					"content": "I honestly wasn't holding out much hope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270105,
					"content": "But then, one of my father's business partners came looking for him a few days ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270106,
					"content": "He said that they're currently looking to get into the mushroom business, and are planning to go to Sumeru to survey the market.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270107,
					"content": "So they wanted to ask my dad if he wanted to go with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270108,
					"content": "They even said that they could take me along!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270109,
					"content": "Dad didn't agree at first, but one of his friends pulled out a letter and asked to speak privately with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270110,
					"content": "They talked for a while, and after that, Dad said that I could go with him to Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270111,
					"content": "Well, I don't know why he changed his mind so suddenly, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270112,
					"content": "I can go to Sumeru now! We're going to Sumeru! Woohoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270113,
					"content": "Congratulations!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "It must be that drifting bottle we sent, I just know it! Thank you so much, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270117,
					"content": "Dad said that after going to Sumeru, they'll also go to a place called Qiaoying Village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270118,
					"content": "Qiaoying Village?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Yup. Dad says it's a tea village where they plant lots of tea trees that produce super high-quality tea leaves. The name's a bit of a toughie, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270120,
					"content": "Well, but let's put that aside for now. We'll need to get to Sumeru first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270121,
					"content": "It's really far from here, so it's going to take a while for us to get there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270122,
					"content": "But I've heard people say that traveling requires a lot of preparations, since you could encounter all kinds of situations on the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270123,
					"content": "You're a frequent traveler, so... could you teach me a few tricks for life on the road?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270124,
					"content": "Like, uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270125,
					"content": "Like, what do you usually eat when you're out traveling?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270126,
					"content": "Dad says that they would always eat stuff they made themselves. But I only know a few simple dishes, and I don't know if I can do them well or not...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270127,
					"content": "#Ohohoho! Cooking! Now that's something we're experts at, huh, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "That's right. I can teach you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "Well, then Paimon thinks we should go look for a stove-top somewhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "...Hmm, why don't we borrow Chef Mao's kitchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "Chef Mao? Uhh... Isn't he pretty scary most of the time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270133,
					"content": "Chef Mao? Scary? He's a great guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "R—Really? But every time Dad and I eat there, he'd scrunch up his eyebrows whenever I'd pick the Qingxin out of my dish and not eat it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270129,
					"content": "That's right. Leave it to me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Y'know, I might be going to Sumeru myself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "Really? Then let's meet there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
