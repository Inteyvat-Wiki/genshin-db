			"dialogs": [
				{
					"id": 210270201,
					"content": "Oh, if it isn't the Traveler and Little Meng! Do you need anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270202,
					"content": "Eh? I, uh, um... Traveler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270203,
					"content": "We'd like to borrow your kitchen, please.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Sure, but that's a little sudden of you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270205,
					"content": "Oh. Is that how it is... Alright, use it as you please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270206,
					"content": "Little Meng, remember not to be picky with your food while you're out traveling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270207,
					"content": "I—I got it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270208,
					"content": "Traveler, please teach me how to make something really tasty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270209,
					"content": "I'd like to give Dad a surprise while we're on the road.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270210,
					"content": "You got it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#Now then, {NICKNAME}, what shall we make?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
