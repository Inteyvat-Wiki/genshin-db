					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270601,
					"content": "Wow, this recipe is so detailed... So many words...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270602
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270602,
					"content": "Hmm. You know what? Paimon gets the feeling that it won't quite be a pleasant surprise if it's this simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270603,
					"content": "Eh? Then what should we do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270604
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210270604,
					"content": "Why don't we... add some unique ingredients into the mix?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270605,
					"content": "What should we add, though?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
