				]
			},
			"dialogs": [
				{
					"id": 402260101,
					"content": "The Flagship... Guess this participant decided to figure out lodging first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260102,
					"content": "Partner! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260103,
					"content": "Navia! It's been forever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260104,
					"content": "I'm guessing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "You got that right. Representing the Spina di Rosula, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260107,
					"content": "Top dog of the criminal underworld... Yep, that checks out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260108,
					"content": "Top dog of the criminal underworld... Yep, that checks out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260109,
					"content": "Haha, is that my new nickname? I'm not opposed — it's kinda snazzy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260110,
					"content": "It's great that we found you! We're working a commission to help with participant registration right now. Y'know, goods verification, stuff like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260111,
					"content": "Oh, I see. Well, in that case, take a seat. I ordered a whole bunch of food. Clorinde and Chevreuse went to unpack some things, but should be back in a sec... Ohh, speak of the devil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260112,
					"content": "Talking about us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260113,
					"content": "Clorinde! Chevreuse! You're here too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260114,
					"content": "Nod-Krai is a chaotic and dangerous place. Considering the Spina's importance to Fontaine, the last thing we need is for something to happen to its president.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260115,
					"content": "I do find it nice to travel with friends, but c'mon... Look who you're talking to! What's the worst that could happen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260116,
					"content": "With that nonchalant attitude, it's anybody's guess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260117,
					"content": "Fair enough. Guess you can mark down our Champion Duelist here as my... bodyguard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260118,
					"content": "Gang boss and her bodyguard... Got it. Should we mark you down for the expo too, Chevreuse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260119,
					"content": "No need. I'm here on official business. A lot of our recent cases have had ties to Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260120,
					"content": "Aaand that's Paimon's cue to butt out, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260121,
					"content": "Oh, one more thing! What's the Spina planning to trade at the expo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260122,
					"content": "Ah, this right here! It's one of the Fontaine Research Institute's newest inventions. It's a kind of relay system that allows the user to unleash pneuma and ousia energy in battle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260123,
					"content": "So, it's... a weapon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260124,
					"content": "Of course! At a market with no legal oversight like this one, weapons are gonna be the first to go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260125,
					"content": "Guess so... Still, bragging about not having to follow the law in front of Chevreuse feels wrong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260126,
					"content": "I don't mind. I've read quite a bit about \"lawless territories\" in crime novels before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260127,
					"content": "As a detective, I know that I'll need to put the rules aside for now if I want to get things done here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260128,
					"content": "And, on that note, I should get to work. I've got Patrol members waiting on me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260129,
					"content": "Well, ready to head over to the venue? Just follow us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260130,
					"content": "Alright, let's get this show on the road! I wanna get a bit of shopping in as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260105,
					"content": "...You're here for the expo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
