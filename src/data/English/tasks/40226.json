			},
			"dialogs": [
				{
					"id": 402260201,
					"content": "You lead Navia and Clorinde to the venue.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "Wow, it's even bigger than I expected. I'm hoping more people will show up, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260203,
					"content": "It'll get busier once things kick off. Still, looks like Jahoda needs a lot of help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260204,
					"content": "Well, Clorinde and I are all set up for now. Be sure to stop by our booth when you get a chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		}
	]
