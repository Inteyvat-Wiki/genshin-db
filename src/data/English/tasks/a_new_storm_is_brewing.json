			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400101,
					"content": "*sigh* How am I going to get past...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400102,
					"content": "Oh, hello... Is something wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400103,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "I'm trying to get to the watchtower at Stormbearer Point — I want to see if there is a storm brewing out at sea or not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400105,
					"content": "But there's a group of monsters blocking the way up ahead. I don't know how to get past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400106,
					"content": "Don't worry, I'm not about to ask you to go to the watchtower for me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400107,
					"content": "It is my duty, and I must see it fulfilled no matter what it takes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400108,
					"content": "You probably have things to do. Go on, don't worry about me, I'll figure it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 2004002,
			"completionStepIds": [
				2004003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004002",
							"3"
						],
						"stepId": 2004002,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004003",
							"2"
						],
						"stepId": 2004003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "Is something the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400202,
					"content": "The monsters are gone now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "Really! Thanks be to the Anemo Archon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400204,
					"content": "I mean— Sorry, I take that back. You are the one I should be thanking!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400205,
					"content": "How can I repay you? Oh! I've got it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400206,
					"content": "Come and find me at the top of the watchtower. I'll wait for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 2004003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
