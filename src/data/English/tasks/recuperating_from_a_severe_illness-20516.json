				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205160401,
					"content": "Hasn't this child always been ill? So how...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160402,
					"content": "Have you seen a certain girl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "Ha... You must be referring to Anna. Look up — she's in the hands of the Anemo Archon statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160404,
					"content": "Honestly, I was quite stunned when she ran past me. I mean, she's been ill all this time, so where did she get this much energy from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160405,
					"content": "By the time I recovered, she'd already gone all the way up to the Anemo Archon statue's hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160406,
					"content": "You're... not angry?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "Angry? Well, I was a little angry. But that child has always been tormented by her sickness...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160408,
					"content": "Seeing her healthy like this... How do I say this? I just can't get angry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160409,
					"content": "That said, the wind is very strong up there. I hope she doesn't catch a cold...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
