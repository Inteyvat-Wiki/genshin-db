			},
			"dialogs": [
				{
					"id": 205160301,
					"content": "Have you found Anna already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160302,
					"content": "She's on the Anemo Archon statue's hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160303
					]
				},
				{
					"id": 205160303,
					"content": "The—The Anemo Archon statue's hand? How did she even get up there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160304,
					"content": "I'll head there immediately, get her to come down, and scold her a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160305,
					"content": "My thanks. Please, take these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051604,
			"completionStepIds": [
				2051604
