			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205160101,
					"content": "Oh, that girl, where has she run off to this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160102,
					"content": "Anna's gone out to play again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "Really, how can you be so unperturbed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160104,
					"content": "Anna's become less and less obedient. I turn around for one second, and she just slips away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160105,
					"content": "She hasn't fully recovered yet! Please help me find her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160106,
					"content": "Alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160115,
					"content": "Ah, right. Anna always told me that she wanted to see the statue of the Anemo Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160116,
					"content": "I remember that Sister Grace goes there often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160117,
					"content": "You could go ask her first. Maybe she's noticed something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160108,
					"content": "Have you looked around?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "Of course. I even searched outside the city!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160110,
					"content": "But still, no luck. So I could only turn to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160111,
					"content": "What does she like to eat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "Well, she's fond of... Hey! Haven't I told you to stop treating her like a cat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160113,
					"content": "In any case, she loves all sorts of food, more than I can count.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160114,
					"content": "Okay, I'm counting on you to look for her. I'll be waiting for you here. I'm so tired, I feel like I could collapse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051602,
