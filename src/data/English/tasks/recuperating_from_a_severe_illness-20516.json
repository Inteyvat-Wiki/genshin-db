				"points": []
			},
			"dialogs": [
				{
					"id": 205160201,
					"content": "So you really can see all of Mondstadt from up here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160202,
					"content": "Don't catch a cold, now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "Wah! You gave me a fright, where'd you come from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160204,
					"content": "I bet my brother's looking for me again. Haha, I knew he wouldn't find me here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160205,
					"content": "I know, I know. I get it, I'll go back in a while. I won't make him worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2051603,
