					"content": "So you really can see all of Mondstadt from up here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160502
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160502,
					"content": "Don't catch a cold, now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160503
					]
				},
				{
					"id": 205160503,
					"content": "Wah! You gave me a scare. Where did you pop out from, and how did you find me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160504,
					"content": "I was so sure no one would find me here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160505,
					"content": "Ah, right. Sister Grace must have told you where I am. She's always around here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160506,
					"content": "A lot of the medicine I've taken in the past were sent over by her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160507,
					"content": "Sister Grace is a wonderful person... But I don't want to stay in Mondstadt forever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160508,
					"content": "Alright, I know my brother's looking for me. I'll head back soon, so he doesn't worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
