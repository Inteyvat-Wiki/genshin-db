				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170401,
					"content": "So a photo is a visual representation... an impression, like casting a shadow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170402
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170402,
					"content": "Fascinating. I'm learning a lot today. Let's get this underway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201705,
			"completionStepIds": [
				1201705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201705",
							"2"
						],
						"stepId": 1201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170501,
					"content": "It's a wrap! Take a look, here's the photo we took of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170502,
					"content": "Wow... this is astonishing. Is it some kind of magic? It seems to be... another copy of me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170503
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170503,
					"content": "But she doesn't seem to be able to move or talk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170504,
						120170505
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170504,
					"content": "It's just a record.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				},
				{
					"id": 120170506,
					"content": "I thought it would turn out poorly because I felt rather rigid. But it actually looks much more natural than I'd imagined.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170507
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170507,
					"content": "The pose is exactly the same and so is the scenery in the background... I can't imagine how it's achieved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170508
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170508,
					"content": "That's what makes it so special.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170509,
					"content": "Hang on, I'm still struggling to understand this. I need you to explain it again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170510
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170510,
					"content": "So the one in this photo... are you sure it isn't me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170511,
					"content": "If it's not me, then why does she look exactly like me? And if she is me, then... who am I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170512
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170512,
					"content": "#Uh... okay, way above Paimon's head— over to you, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170513,
					"content": "It's a little bit like you and the Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170514
					]
				},
				{
					"id": 120170514,
					"content": "Hey, that's right. Do you think the Shogun counts as you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170515,
					"content": "Of course I do. It was never my intention to place control of Inazuma into anybody else's hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170516,
					"content": "So then, who does that make you, here and now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170517,
					"content": "Well I'm still me. There is no doubt about that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170518
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170518,
					"content": "So your existence isn't singular.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170519
					]
				},
				{
					"id": 120170519,
					"content": "My existence, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170520
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170520,
					"content": "I think I understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170521
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170521,
					"content": "I am me. There is only one of me, but I can exist in many different forms. It's not important what form I exist in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170522
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170522,
					"content": "The Shogun, for example, is one of my forms of existence. The question of whether or not she is me is not determined by any of her components.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170523
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170523,
					"content": "In that case, this picture is one of your forms of existence, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170524,
					"content": "Hmm. So even I, who seeks Eternity, am constantly changing my form of existence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170525,
					"content": "Then, how can I ask Inazuma and everyone who lives here to remain unchanging?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170526,
						120170527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170526,
					"content": "Inazuma will always be Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170528,
					"content": "Everything I have encountered on this journey with you has been from beyond my existing sphere of knowledge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170529,
					"content": "*sigh* You've seen a lot of my ignorant side today. Maybe you can't tell, but all this has challenged my understanding of things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170530
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170530,
					"content": "Based on what I have seen today, I am forced to accept that Inazuma is a completely different place from the one I remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170531,
					"content": "But it would be incorrect to conclude from this that the Inazuma of today is no longer Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170532,
					"content": "Right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170533
					]
				},
				{
					"id": 120170533,
					"content": "Both the Vision Hunt Decree and the Statue of the Omnipresent God were conceived as a means of bringing about Eternity. But if I were really getting closer to Eternity, none of this ever would have happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170534,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170535,
					"content": "Perhaps... perhaps I've been holding on to everything too tightly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170536
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170536,
					"content": "Sounds to Paimon like Ei's figured things out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170537,
					"content": "And that means that we've done a really great job as her guides!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170538,
					"content": "Master Kamaji! Master Kamaji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170539
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170539,
					"content": "Hmm? Why's it getting so noisy down there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170540,
					"content": "That sounded like Ippei. What could be the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170541,
					"content": "Ippei? Is that someone from the Tenryou Commission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170542
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170542,
					"content": "Yep. Let's find out what's going on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170527,
					"content": "Human beings will always be human.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170505,
					"content": "It's not the real you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				}
			]
		},
