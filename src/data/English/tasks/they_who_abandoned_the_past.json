					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170604,
					"content": "...Rest in peace, Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170605
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170605,
					"content": "One thing's for sure — that \"fate\" of yours isn't gonna get me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170606
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170606,
					"content": "Not yet, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
