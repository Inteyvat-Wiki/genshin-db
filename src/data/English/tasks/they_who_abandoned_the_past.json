			"dialogs": [
				{
					"id": 761170101,
					"content": "Mm-hmm, looks like you handled the commission without a hitch. Thank you, Miss Jahoda. Here is your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170102,
					"content": "See? Told you it'd be fine! Not a bad payout either, hehe... Got any more quick-Mora jobs like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170103,
					"content": "I can certainly take a look. One moment please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170104,
					"content": "Eh!? Isn't that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170105
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170105,
					"content": "Hey, Katheryne... Was that pendant over there used for posting a bounty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170106,
					"content": "It was indeed — you certainly have a sharp eye, Miss Jahoda. Mr. Ihanti left it as collateral for a bounty request.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170107,
					"content": "In that case, I'll take that one. Just give me the deets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170108,
					"content": "The only thing is... the reward for that one isn't all that high, and nowadays, pieces like this are not worth much either. I'm not sure it's the kind of job you're after, Miss Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170109,
					"content": "No worries, I'll take it. Let's call it... a bit of charity work on the side. Gotta build up some good karma once in a while, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170110,
					"content": "Haha... Very well then. Please wait a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170111,
						761170112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170111,
					"content": "Taking commissions again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				},
				{
					"id": 761170113,
					"content": "I mean, it's not like I've got much else to do right now. Can't just sit around playing with Ashru all day, can I? Nef— I mean Boss Nef'd boot me out in no time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170114
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170114,
					"content": "#Hmm, now that you're here... {NICKNAME}, Paimon, you two are pretty handy. Wanna join forces on this one? We could split the reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170115,
					"content": "#A commission, huh? You'd better ask {M#him}{F#her} — {M#he's}{F#she's} the expert, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170116,
						761170117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170116,
					"content": "Seriously Paimon, you're making me blush...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170118,
					"content": "Bet you it's nothing major. Trust me, Ihanti's way too much of a scaredy-cat for it to be about anything serious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170119
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170119,
					"content": "Miss Jahoda, here are the details of Mr. Ihanti's commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170120,
					"content": "Alrighty, let's see what that little wimp's gone and—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170121
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170121,
					"content": "...Ugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170122,
					"content": "What's up? Please don't say it's something super difficult...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170123,
					"content": "Nah, nothing like that. Just didn't expect a guy who couldn't even bring himself to hurt a fly to go posting life-or-death commissions like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170124,
						761170125
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170124,
					"content": "L—Life or death?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170126,
					"content": "You? Hahaha, sure... Couldn't be more by-the-book if you tried, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170127,
					"content": "Relax, I'm just messing with you. It only mentions retrieving something from a bunch of crooks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170128,
					"content": "To a crook, money is life, and life is money. That makes it a matter of life or death, am I right? Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170129
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170129,
					"content": "C'mon, follow me. Pretty sure I can handle those punks by myself — odds are you won't even have to lift a finger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170125,
					"content": "I'm a law-abiding person, just so you know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170117,
					"content": "Alright then, why not. What kinda commission we talking?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170112,
					"content": "Busy as ever, I see...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				}
			]
		},
