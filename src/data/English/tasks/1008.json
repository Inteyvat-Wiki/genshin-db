	"talks": [
		{
			"id": 100802,
			"completionStepIds": [
				100802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100802",
							"2"
						],
						"stepId": 100802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Ding"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "Have mercy, O mighty adeptus! I beg you... Show mercy upon me and my brother... Spare our lives!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080202,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "Who are you? What's going on?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080204,
					"content": "We asked you first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080205,
					"content": "...Oh! You enjoy safe passage in Jueyun Karst... It can only mean one thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080206,
					"content": "You must be adepti messengers! Sent here to rescue me and my brother!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080207,
					"content": "What is he talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080208,
					"content": "...Oh, have mercy, mighty messengers of the illuminated adepti! I beg you to save us... My brother and I, we only came here because our family is poor, and we heard tell of treasures hidden in the amber of Mt. Hulao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080209,
					"content": "It was stupid of us... but all we wanted to do was find enough treasure to sell and support our family...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080210,
					"content": "We followed <color=#00E1FFFF>the path up the mountain</color>, but suddenly, the amber... it swallowed up my brother, Li Dang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080211,
					"content": "I ran away, and made it this far before it dawned on me: We were trespassers in the abode of the adepti, and this was our punishment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080212,
					"content": "I had no idea how to rescue my brother, so I just started praying for the adepti to have mercy, right here on the spot. And now, at long last, two messengers come to my aid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080213,
					"content": "What? We're not adepti messengers... We just wanna find the adepti, like everyone else!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080214,
					"content": "No no no, you must be messengers... You have to be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080215,
					"content": "I have no idea which amber trapped him... Please, you have to rescue him! I beg you, show me some adepti mercy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080216,
					"content": "Oh, fine. I'll go have a look...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "Thank you, thank you! O mighty messengers of the illuminated adepti, I promise that we will never be so foolish again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080218,
					"content": "Of your transgression, your predicament, and your repentance, one has become aware.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "Whoa, check you out! When you speak like that, you actually make a pretty convincing adepti messenger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080220,
					"content": "Thanks be to the adeptus of Mt. Hulao, and to their messengers! Never will we be so foolish again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Ding"
				}
			]
		},
		{
			"id": 100806,
			"completionStepIds": [
				100806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100806",
							"2"
						],
						"stepId": 100806,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100802",
							"3"
						],
						"stepId": 100802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Ding"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080601,
					"content": "Thank you for rescuing my brother, O mighty messengers of the illuminated adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080602,
					"content": "Have you ever seen the adeptus here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "What? No... I mean, like everyone else, we've heard that there's an adeptus living in Mt. Hulao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080604,
					"content": "But regular folks like us would never have the chance to meet them. No way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080605,
					"content": "Unlike you guys... You're adepti messengers, so it's a whole different story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080606,
					"content": "Anyway, we have trespassed in the realm of the adeptus for long enough. We should get going. Thank you, mighty adepti messengers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080607,
					"content": "Yes, thank you, messengers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10080608,
					"content": "...Boy, it'd be super helpful if we actually were adepti messengers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "'Cause it seems like this adeptus has got a real temper problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "But it's not like we've done anything wrong, so... hopefully we'll be okay... hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "Who dares trespass on my mountain? Who is it that frees the thief from his incarceration?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10089602,
					"content": "Foolish mortal, come forth and receive your punishment at once!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mountain Shaper"
				}
			]
		},
		{
			"id": 100807,
			"completionStepIds": [
				100807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100807",
							"2"
						],
						"stepId": 100807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mountain Shaper"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080701,
					"content": "...You intrude upon the sanctity of Mt. Hulao, you destroy the amber of my mountain, and you free a thief whose freedom is not yours to give.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080702
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080702,
					"content": "The thieves' ignorance was an affront to the adepti... but your actions are an abomination of the highest order!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080703
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080703,
					"content": "Wait! We can explain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080704,
						10080706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080704,
					"content": "Here, look at this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080705
					]
				},
				{
					"id": 10080705,
					"content": "...A Sigil of Permission? One was unaware that such things still exist in the mortal realm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080708,
					"content": "Is this... a Sigil of Permission? One is surprised to find that such things still exist in the mortal realm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080709
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080709,
					"content": "In the beginning, Rex Lapis cast them for the mortals with his own hand. Few were made then, and thousands of years on, fewer still remain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080710
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080710,
					"content": "Speak. One shall listen to the matter which brings you here, then one shall verify the truth thereof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080711
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080711,
					"content": "You would be wise to speak the truth, for Liyue is not so far from here that one would be easily deceived.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080712
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080712,
					"content": "Rex Lapis... Assassinated?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080713
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080713,
					"content": "At the Rite of Descension!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080714
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080714,
					"content": "What mortal in Liyue— nay, in all the world, would conspire to commit such foul treason? Or perhaps the more pertinent question is, what power in this world could aspire to achieve it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080715
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080715,
					"content": "Rex Lapis charged the adepti with the protection of Liyue, and we have always honored this duty. As the people have prospered, so have we gradually withdrawn into the mountains. Indeed, this was a gesture of good will towards humanity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080716
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080716,
					"content": "But now... Alas! Rex Lapis, gone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080717
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080717,
					"content": "Traveler, of the matter you have relayed, one has become aware. One now knows why Moon Carver has sent for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080718
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080718,
					"content": "Once one has dealt with certain matters here that require my attention, one shall convene with the other adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080719
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080719,
					"content": "Can someone explain the amber situation to me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080720
					]
				},
				{
					"id": 10080720,
					"content": "Paimon can! Adepti always have magical powers in storybooks, seems it's true in real life too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080721,
					"content": "You know, like how grass is actually adepti hair, and rivers are actually adepti saliva... There must be something similar going on with the amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080722,
						10080723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080722,
					"content": "So is rain... adepti tears?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080724,
					"content": "...Your nonsense knows no bounds. This amber is produced by a flower that one has planted here, called the karst crawler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080725
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080725,
					"content": "The majority of the plant is hidden underground. When stepped on, it produces amber to trap the invader.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080726
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080726,
					"content": "After taking up residence here, one planted many karst crawlers to ensure that the tranquility of the mountain would remain undisturbed. Over the years, they have helped to prevent many disturbances, but in the process they have also trapped many curious things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080727
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080727,
					"content": "Oh, so the amber is... alive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080728,
					"content": "Correct. Thus, one may not leave this place in its current state, for fear of the risk to innocent lives in one's absence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080729
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080729,
					"content": "One will depart as soon as one has attended to this matter. One trusts that the manner of your departure will be swifter in nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10080723,
					"content": "Amber must be crystallized adepti... ew, gross.",
