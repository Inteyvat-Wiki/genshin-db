					"Li Ding"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10089701,
					"content": "My brother told me everything... Thank you both so much for rescuing him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089702
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089702,
					"content": "*sigh* Our family has nothing to live on... We heard tell of treasures hidden in the amber of Mt. Hulao, and with nowhere else to turn, we came looking for them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089703
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089703,
					"content": "We weren't thinking straight... We thought that we could sneak up into the mountain and grab just enough treasure to sell and support our family with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089704
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089704,
					"content": "As you can see, the adeptus punished us for our greed. The amber swallowed me up, and if you hadn't come to my rescue, who knows when I would've gotten out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089705
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089706,
					"content": "...Messengers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089707
					]
				},
				{
					"id": 10089709,
					"content": "Of your transgression, your predicament, and your repentance, one has become aware.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089710
					]
				},
				{
					"id": 10089705,
					"content": "Luckily, the adeptus was merciful. They sent you two as their messengers to save us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089706,
						10089709
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089707,
					"content": "Yes! You two saved my brother just as I was praying for the adeptus' forgiveness, right here on top of the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089708
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089708,
					"content": "You are adepti messengers, no doubt about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089710,
					"content": "Whoa, your adepti messenger impression is really good. It's like this is the part you were born to play!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089711,
					"content": "Thank you... yes, we are truly sorry, my brother and I have learned our lesson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089712,
					"content": "We are truly blessed to receive the mercy of the adeptus. We promise that we will change our ways and make an honest living from now on. Even if it means sweating it out down at the docks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089713
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089713,
					"content": "Anyway, we have trespassed in the realm of the adeptus for long enough. We should get going. Thank you, mighty adepti messengers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089714
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089714,
					"content": "Yes, thank you, messengers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089715
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089715,
					"content": "...Boy, it'd be super helpful if we actually were adepti messengers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "'Cause it seems like this adeptus has got a real temper problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "But it's not like we've done anything wrong, so... hopefully we'll be okay... hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "Who dares trespass on my mountain? Who is it that frees the thief from his incarceration?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Mountain Shaper"
				},
				{
					"id": 10089602,
					"content": "Foolish mortal, come forth and receive your punishment at once!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mountain Shaper"
				}
			]
		},
