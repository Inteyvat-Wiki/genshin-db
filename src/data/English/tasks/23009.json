				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230091701,
					"content": "Thank you. Then I have all the materials I need for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091702
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091702,
					"content": "Give me a second while I mix the Concresoil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091703
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091703,
					"content": "Akim starts to mix the soil...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "Okay, it's done. Please take the soil to Nima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091705,
					"content": "He has been waiting for it for ages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091706,
					"content": "This child is... um... unusually imaginative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091707,
					"content": "Nima told me he wanted to make a group of talking \"pot warriors\" that can roll over enemies and have all sorts of magical powers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091708,
					"content": "The power of these warriors will vary with the materials stuffed in their pot bodies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091709,
					"content": "He even gave these pot warriors a name, called Ad... Well, forget it, I don't remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091710,
					"content": "Unfortunately, I can't really make pot warriors with magical powers. But still, it's an interesting idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091711,
					"content": "So I thought, why not give him the soil as a toy gift?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091712,
					"content": "This way, he can make his own pot warriors and command them like a general!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091713,
					"content": "Ahem, anyway, please help me send this pot of soil to Nima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091714,
					"content": "Once his pot warriors are complete, maybe he will appoint us both \"pot generals\" as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
