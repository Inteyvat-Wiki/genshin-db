				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230091401,
					"content": "Ugh, this is awful. Where did I go wrong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091402
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091402,
					"content": "What's going on?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091403
					]
				},
				{
					"id": 230091403,
					"content": "Ah! It's... it's you, Traveler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091404,
					"content": "*sigh* There's something wrong with my Concresoil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091405,
					"content": "Was it the mix ratio? Or the lack of experimental trials...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091406,
					"content": "Many customers who have built their kitchens using Concresoil have reported cracking after only a few days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091407,
					"content": "Perhaps the temperature grew so high that some parts of the soil just failed to work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091408,
					"content": "*sigh* Anyway, I have to go fix those cracks for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091409,
					"content": "There were too many people needing repairs for me to take all the scraped Concresoil away, so I asked them to just keep it in some pots. And ah, there were very many pots indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091410,
					"content": "Traveler, could you please help me collect the used Concresoil from this house, while I go to another one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091411,
					"content": "*sigh* Where did it all go wrong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
