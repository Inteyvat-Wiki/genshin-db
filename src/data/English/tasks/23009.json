			"dialogs": [
				{
					"id": 230091101,
					"content": "Traveler! Thank goodness you're here. I was just in need of someone's help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091102,
					"content": "So you've made progress in your soil research?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "Well... I don't think I could call it \"progress,\" but a customer of mine did give me some useful advice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "He said that he enjoys growing flowers and the thing that troubles him most is finding the right soil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "The soil needs to have good permeability and adequate nutrients. Plus, it should be water retentive but not soggy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Knowing that I've made such improvements to the Concresoil, he asked me if I could devise a version of it for flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "I found it worth researching, so I'm looking for other materials to further upgrade my Concresoil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Could you please help me look for some fertile soil this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "I'll mark the location of the soil on the map for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091109,
					"content": "Why is it so far away...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
					"content": "I asked around, of course. It's a little out of the way, but they say the soil there is very fertile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091112,
					"content": "But there seems to be a lot of monsters over there too, so I wouldn't dare to go myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091113
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091113,
					"content": "I'm counting on you, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091110,
					"content": "How did you find this place...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				}
			]
