				{
					"id": 230091801,
					"content": "Wow, this must be the soil that can make everything. Just like Akim told me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091802
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091802,
					"content": "#Yay! Thank you, {M#Mister}{F#Miss}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091803
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091803,
					"content": "Now I can make \"Adri\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091804
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091804,
					"content": "What is Adri, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091805
					]
				},
				{
					"id": 230091805,
					"content": "#Didn't Akim tell you about it, {M#Mister}{F#Miss}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091806
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091806,
					"content": "I'm making some pot warriors. Adri is gonna be the first and the best of them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091807
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091807,
					"content": "He is a kind warrior with a good temper. When he awakens as a pot warrior, the first thing he will do is to apologize to the grass under him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091808
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091808,
					"content": "His power is... is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091809
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091809,
					"content": "I—I haven't decided on it yet... but you'll be the first to know once I have!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091810
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091810,
					"content": "After Adri is done, I'll make Ivar, his adjutant, and Lasson, his disciple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091811
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091811,
					"content": "The three of them... no, the three pot warriors... They will embark on a long, long journey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nima"
				}
			]
		},
