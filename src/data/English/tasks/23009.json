				},
				{
					"id": 230090806,
					"content": "However... I'm running low on materials due to a surge in orders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090807
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090807,
					"content": "Even the Whopperflower soil has run out... Traveler, could you please go and get me some more of that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090808,
						230090809
					],
					"speakerTitle": "Akim"
				},
				{
