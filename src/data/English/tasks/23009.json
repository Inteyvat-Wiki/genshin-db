						230090812
					]
				},
				{
					"id": 230090812,
					"content": "Thank you. Don't forget, it's the soil where Whopperflowers grow that we're looking for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090809,
					"content": "What about other materials?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090810
					]
				},
				{
