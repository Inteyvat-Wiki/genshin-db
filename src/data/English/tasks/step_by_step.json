			},
			"dialogs": [
				{
					"id": 200470301,
					"content": "Anything yet? Anything at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470302,
					"content": "I found out a few things...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "...I see, I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470304,
					"content": "That's the low-down.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "This is excellent news. Wonderful. Fantastic! Thank you, take these for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470306,
					"content": "Ms. Patchi! There has been a major change of plan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
