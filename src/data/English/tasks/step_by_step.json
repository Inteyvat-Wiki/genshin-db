					"nextDialogs": [
						200470202
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470202,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470203
					]
				},
				{
					"id": 200470203,
					"content": "Please, everything depends on you! Your findings will make or break my whole adventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
