			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Candace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230301,
					"content": "You must let me know if there's anything I can do to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230302,
					"content": "Though I cannot leave Aaru Village, I can't help but feel... stirred when I see the looks in your eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230303,
					"content": "I've never felt as roused as this when fighting alone in the past...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230304,
					"content": "I suppose this must be the power of camaraderie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
		{
			"id": 302304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
