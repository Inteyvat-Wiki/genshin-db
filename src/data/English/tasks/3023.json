			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230201,
					"content": "Don't rush. This is a big undertaking, and the planning and preparation for what lies ahead will no doubt take some time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230202,
					"content": "Take it slowly. We need to make sure the plan is as effective as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230203,
					"content": "He's starting to read his book again! Hey! Are you even listening?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230204,
					"content": "Would you like me to lend you something to read?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230205,
					"content": "No way! Your books aren't quite to Paimon's taste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "I was joking. I know my books are far too difficult for you, and I have no intention of lending them out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230207,
					"content": "Ugh! You're so annoying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 302303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
