			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30230401,
					"content": "The past few days have been some of the most challenging work I've ever taken on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230402,
					"content": "And none of it will earn me a single Mora... I can't believe it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230403,
					"content": "Look on the bright side, Dehya! Maybe we'll get a huuuge reward after this is all over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230404,
					"content": "Hmm, you've got a point. Hey, what would you do if you woke up tomorrow with more money than you could ever spend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230405,
					"content": "Paimon would buy boatloads of tasty snacks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230406,
					"content": "That's it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230407,
					"content": "Um... and maybe some tasty drinks as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230408,
					"content": "Hahaha, how adorable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230409,
					"content": "Well, here's to all our indulgent fantasies... If there's a chance they can come true, I'll give it my best shot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230410,
					"content": "And here's hoping that everything we do from now on will change this world for the better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
	]
