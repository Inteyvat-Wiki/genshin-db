			"dialogs": [
				{
					"id": 30230101,
					"content": "...In the past, I never imagined that even the gods could suffer from hardship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230102
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 30230102,
					"content": "If we can find a way to change all of this... will this nation become a better place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
		{
			"id": 302302,
