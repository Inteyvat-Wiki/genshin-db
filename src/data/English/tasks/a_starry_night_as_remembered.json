			"dialogs": [
				{
					"id": 790540401,
					"content": "Photos... I can't believe something so amazing exists already. Now, it's possible to keep a record of all kinds of amazing scenery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540402
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540402,
					"content": "#Well, {NICKNAME}, did you finish taking the photo? I'm really looking forward to seeing your photo of the starry sky!",
					"roleType": "TALK_ROLE_NPC",
