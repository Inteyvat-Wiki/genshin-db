				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "Will this prescription really work...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "Traveler! You've got great timing. I was just in a spot of bother.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "Here's the thing. You remember my younger sister, Anna, right? She's always been sickly, and nothing's managed to cure her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "But I heard that there's an incredible doctor in Liyue Harbor who is especially skilled at curing the incurable. So, I asked someone to help me get a prescription from him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "The ingredients are all very unusual... but I suppose I can only give it a shot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Um, let me see... Could you help me find a Dendro-Processed Berry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "There's such a thing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "I have no clue either! Do Dendro Slimes really eat berries...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "Either way, I'm counting on you! I do know of a place where both Slimes and berries may be found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "Please help me take a look. I hope you'll find it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "This doctor's a quack.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "So you think so too, huh? But I don't have any other options.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "I know of a place where you can find both Slimes and berries. Could you please go have a look for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "I'll try the medication that we make first. No matter what, I can't let Anna's condition get any worse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "I could just catch a Dendro Slime for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Huh... What? Are you telling me to stuff the berry into the Dendro Slime's mouth myself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "Spare me, please! The last time I went picking herbs for Anna's medication, a group of Dendro Slimes chased me all the way to Springvale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "I know of a place where you can find both Slimes and berries. Please go have a look for me, will you? I hope you find something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "But... i—if you really can't find anything, then for Anna's sake... J—Just catch a Dendro Slime and bring it back here. I can do it. I... I will do it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
