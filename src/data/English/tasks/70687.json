				]
			},
			"dialogs": [
				{
					"id": 706870101,
					"content": "Hello, dear guests! Please, right this way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870102
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870102,
					"content": "A certain astrologically-adept friend of Madame Mage has prepared you a gift!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870103
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870103,
					"content": "Whoa! What a sparkly crystal ball! Looks expensive, too... How much do you think Margaret would pay for it? Ten million — no, twenty million Mora!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870104,
					"content": "Umm... Sorry, Paimon was just messing around! Anyway, what's it for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870105,
					"content": "In the words of Madame Mage's friend: \"Where there are mages, one must surely have crystal balls worth the name.\" With its help, my dear guests will be able to set foot on a wonderful new stage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870106
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870106,
					"content": "Now, I'm not really sure what she meant — I am just the concierge, after all! All I ever see when staring into a crystal ball is my reflection...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870107
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870107,
					"content": "Ah, right! There's also this box, another gift from Madame Mage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870108
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870108,
					"content": "\"If you can put on a spectacular performance on this hidden stage, one as unpredictable as the tides of fate themselves, you shall discover the wondrous treasures this little box contains\"... At least, that's what she told me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870109
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870109,
					"content": "T—Treasures?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870110,
					"content": "Well, that's all from me! It wouldn't be sporting for the concierge to spoil the intrigue for you all, dear guests. So please, take the stage in your usual gallant fashion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wolfy"
				}
			]
		}
	]
}