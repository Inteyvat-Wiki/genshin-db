			"dialogs": [
				{
					"id": 760280301,
					"content": "#Waaah, there you are, {NICKNAME}! When those two glowing things crashed into each other, the explosion sent Paimon flying! It's a good thing she didn't get hurt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "It took Paimon forever to fly back here... Paimon's just glad you're okay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "Actually, I went flying for a while too...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Paimon under— Huh? Wait, what do you mean by flying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "You tell Paimon what you just saw...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Hmm, Paimon's never heard about a place like that in Teyvat... Are you sure you weren't just seeing things, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "Anyway, as long as you're okay, that's all that matters! There's just way too much weird stuff going on around here. Let's leave this place before it's too late...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Ugh, Paimon didn't think they'd be that dangerous, and we didn't even find any treasure in the end... Why would something like that show up here, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "And if those two glowing things weren't Seelies... then what were they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280308,
					"content": "I think I was blown off to some strange place...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280309
					]
				},
				{
					"id": 760280309,
					"content": "You tell Paimon what you just saw...",
