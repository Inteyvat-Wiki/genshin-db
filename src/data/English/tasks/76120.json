			},
			"dialogs": [
				{
					"id": 761200101,
					"content": "...Here. This is for you. That's my share done, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200102,
					"content": "Hey, it's a drawing canvas. Wait, that means...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Ah. You're just in time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "Well, if it isn't Maalaus, our Great Painter! Long time no see!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "So, what are we \"just in time\" for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "I just took Maalaus to the moon for a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200108,
					"content": "Paimon's sooo jealous of how you just... said that, like you were visiting the garden next door or something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "Still, what did you go there for? Looking for inspiration?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "That's half right. We also selected a location for an \"exhibition.\" Do you recall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200111,
					"content": "Paimon does! Maalaus's Moon Goddess exhibition! Don't forget to invite us when the time comes, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Yes, of course. In addition, Maalaus seems to be able to sense subtle changes around her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200113,
					"content": "She's told me that I have changed a lot since returning from the moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200114,
					"content": "That's why she wanted me to take her there, to see if there was something special about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200115,
					"content": "Heh! Now that's an artist for you, alright...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "So, this special thing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "I'm not sure either. I took Maalaus to many places, but none of them satisfied her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200118,
					"content": "That is, until I brought her close to your ship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200119,
					"content": "Our spaceship?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "But after bringing her closer, I found that she wasn't interested in the ship itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200122,
					"content": "Huh? What does that mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Ohh, she's flying around you, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Haha. She did so back then as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200126,
					"content": "I suspect that her real interest lies with how I looked after seeing the spaceship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200127,
					"content": "How you... looked?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Yes. I was reminded of when {NICKNAME} and I went there together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200129,
					"content": "#We sat atop the ship, gazing at Teyvat. {M#He}{F#She} found the truth about the past, and I found my \"home.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200130,
					"content": "Just thinking about it gave me a sense of peace... or perhaps, happiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200131,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Yes, you are right. These are not things I would have felt before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200133,
					"content": "So, I told Maalaus our story, including what happened after we reached the moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200134,
					"content": "She seemed most pleased after that, as if she had found the inspiration she so desired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200135,
					"content": "Ah. So now it's time for the great artist to work her magic, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "Heh, you didn't take Paimon up there back then, so she's pretty curious what Maalaus is gonna paint too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "And what are we going to use as paint this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "This time is something special.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200139,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus says she wants paints that belong only to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200141,
					"content": "And... what does that mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "I believe she means things that will remind you about this journey, what you have gained from it, and the joy it has brought you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200143,
					"content": "Don't worry. Maalaus just wants to see such objects and feel them. She wouldn't use anything so precious as paint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200144,
					"content": "What did you give her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "Soil from the moon, and the card you gave me for Moon-Prayer Night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200146,
					"content": "#Oh, so basically, it's gotta be something that represents this adventure, right? Okay then. {NICKNAME}, you pick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "Well, that's certainly quite special...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
