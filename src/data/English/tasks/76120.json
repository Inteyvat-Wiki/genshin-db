			"dialogs": [
				{
					"id": 761200301,
					"content": "Hmm. A good choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200302
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200302,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200303,
					"content": "She seems pretty pleased too— Whoa, straight to the canvas she goes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200304,
					"content": "Y'know, now that Paimon thinks about it, Maalaus's paintings pretty much cover your story from when you were born 'til now, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200305,
					"content": "And that story isn't over yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "Yup! And Paimon wants to see more of our great painter's work, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200308,
					"content": "Oh, done already? Quick as ever, huh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200309,
					"content": "Let Paimon see... Oohh! This is so pretty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200310,
					"content": "Paimon had no idea Teyvat looked so beautiful from the moon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200311,
					"content": "Hah... Now I can understand why Maalaus says that I have changed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200312
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200312,
					"content": "Hmm? Why's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200313,
					"content": "When I see this painting, I remember...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200314
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200314,
					"content": "That as I sat on the moon, watching Teyvat, I thought about how I'd always been looking for a \"home\" of my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200315
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200315,
					"content": "But now, I suddenly have two homes, both of them places of such beauty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200316
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200316,
					"content": "It was then that I realized that perhaps \"home\" is wherever the things and people you cherish are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200317
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761200317,
					"content": "A lovely thought.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
