			},
			"dialogs": [
				{
					"id": 240190301,
					"content": "What did I say, eh? Real gentlemen — far better mannered than those ruffians near the Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "They were very well-mannered.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "I know, right? Makes me feel relaxed just sitting here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "I mean, just imagine being a gull yourself. With people coming over to feed you, all you need to do is sunbathe and think about the meaning of life...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "*sigh* Why am I a Gestionnaire and not a Violetgold Angler Gull?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401908,
