	"talks": [
		{
			"id": 2401901,
			"completionStepIds": [
				2401901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401901",
							"2"
						],
						"stepId": 2401901,
						"stateName": "QUEST_STATE_UNFINISHED"
