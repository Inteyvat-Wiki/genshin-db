				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Well, that's all the feed I got. Hope they're all full...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "What are you up to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "I'm feeding these gulls. See, they've almost had their fill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "Whoa... When did you and them grow so close?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "They didn't steal your fries?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "No. It seems that people specifically come here to feed the gulls, so they've no interest in my fries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "But didn't you say that if you got too far from your workplace, you might miss work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Hahaha, it's alright. Today's my day off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "No colleagues here to drag me into work-related chat, and no one or animal to steal my fries... Yes, this is a most suitable place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "The gulls are a friendly lot. They won't steal my fries, nor will they come charging into me to cause a riot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Ever since I fed them personally a few times, they seem to recognize me. They don't seem to resist even when I touch their feathers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "I'd go so far as to call them perfect gentlemen compared to the ilk at the Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "If they could use their talons to write using typewriters, why, they'd nearly put us out of work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "Violetgold Angler Gulls won't help with human business.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "But at least they don't make things worse, either. And everyone knows that some things are simply too hard for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "But let's leave that aside first. Would you like to try making friends with these gentle-gulls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Whew, they're already gentle-birdies in your eyes, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "Would it be rude of me to just go up to them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "No, they are a tolerant sort. As long as you don't ruffle their feathers, you'll be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Come, let me give you this fish I've specially processed. Just take it and put it in that bowl over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Just relax. Violetgold Angler Gulls are a tolerant lot. They like whoever feeds them, and they ask no questions about where you got your fish or how it was made.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "Is there anything I need to look out for when befriending them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Not much, not really. Just don't attempt to ruffle their feathers directly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "Violetgold Angler Gulls don't speak our language.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "I wouldn't be so sure. Perhaps they simply pretend so that they may live more comfortable lives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
