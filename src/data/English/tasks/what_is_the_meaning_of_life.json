			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "How... How could you do that? They're not the ruffians in front of the Palais Mermonia, you know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "Sorry, it was an accident...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "*sigh* I didn't even have time to stop you. Why did you do that... Did one of them attack you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "Regardless, they're gone now. Oh well. I'll have to come back in a few days and offer them some food as an apology...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
