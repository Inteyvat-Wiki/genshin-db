					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210102,
						710210106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210102,
					"content": "You can use a wind glider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210103
					]
				},
				{
					"id": 710210103,
					"content": "Forget it. I've been shut indoors ever since joining the Sumeru Academia. I haven't done any outdoor activities since.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210104,
					"content": "You can't really use your wind glider at the Academia either, so I've probably returned all my gliding instructor's teachings back to them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210105,
					"content": "If you asked me to glide over there, I'd probably fall into the water halfway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210106,
					"content": "You could charter a boat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210107
					]
				},
				{
					"id": 710210107,
					"content": "I thought so too, and I did remember that you could charter one at Dornman Port, but that's way too far away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210108,
					"content": "Who knows how long a round trip will take, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210109,
					"content": "But I couldn't possibly construct my own boat. I mean, I learned nothing about that in the Academia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
	]
}