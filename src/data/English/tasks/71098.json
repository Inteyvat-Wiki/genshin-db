						710980705
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980705,
					"content": "Ah, Lutong. My good Lutong, have you helped me order that dish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980706
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980706,
					"content": "Yes, the Radish Veggie Soup has been ordered, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980707
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980707,
					"content": "Wonderful. How considerate of you, dear Lutong. I'm sure that we shall have our processing formula this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980708
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980708,
					"content": "I'm looking forward to it, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980709
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980709,
					"content": "Eh? What are they talking about... And what's a processing formula, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980710,
						710980712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980710,
					"content": "I'm not too sure myself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "Hmm, then let's go ask them. Maybe they're researching some kind of new dish... Y'know, one that we can try!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980712,
					"content": "Let's go ask them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980713
					]
				},
				{
					"id": 710980713,
					"content": "That's true! Maybe they're researching some kind of new dish... Y'know, one that we can try!",
					"roleType": "TALK_ROLE_NPC",
