					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980703,
					"content": "No, no, almost, almost... Wait, no. Ah, fascinating. How fascinating...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980704
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980704,
					"content": "Mr. Garcia.",
					"roleType": "TALK_ROLE_NPC",
