			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710981501,
					"content": "This flavor is mighty fine indeed, but I must say that it tastes entirely different from the Radish Veggie Soup that Mr. Yanxiao makes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981502,
					"content": "Pardon my curiosity, but how... how did you make this dish? What were the exact amounts of ingredients? What seasonings did you use, and how?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981503,
					"content": "H—Hey! Personal space!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "Ah, yes... my apologies. Still, I would like to know how you made that dish. In detail, please — you never know how the inspiration might come.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981506,
					"content": "You explain the manner in which you make Radish Veggie Soup in detail.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "I see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981508,
					"content": "*sigh* Ah, there truly are too many variables involved in deciding the flavor of a single dish. Much computation is needed to refine our calculations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981509,
					"content": "But I will need to improve my Numbering Machine to allow for more computations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981510,
					"content": "I can only hope that I can find some inspiration in the Akademiya's library.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981511,
					"content": "Why did you want to create such a machine, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "Hmm. Good question. But before I answer that question, permit me to ask you one first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981513,
					"content": "Do you think that the Numbering Machine possesses \"thought\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981514,
					"content": "What do you mean by that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "Exactly. Please think on this question first, if you would.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981517,
					"content": "We can discuss this question when we next meet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981518,
					"content": "As for now, I must organize some data first... Come, Lutong, we begin!",
