			"dialogs": [
				{
					"id": 710981301,
					"content": "This parameter... No, no, I need to adjust the algorithm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981302,
					"content": "Sir, I believe that we should aim to be thrifty in our expenditures, lest we lack sufficient Mora for our journey to Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981303,
					"content": "Sumeru? Ah, yes, right you are, Lutong. Once we get to Sumeru, I shall surely be able to find some way to refine this Numbering Machine of mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981304,
					"content": "Then, my Numbering Machine shall be able to perform ever grander calculations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981305,
					"content": "...I fully concur with your statement, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 7109815,
