				"points": []
			},
			"dialogs": [
				{
					"id": 710980901,
					"content": "Let us begin, Lutong, with ten percent less of each ingredient this time... Alright then. Step 1: begin cooking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980902
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980902,
					"content": "Yes, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980903
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980903,
					"content": "First, the water... Ah! Careful there with the speed at which the water is poured. It is most important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980904,
					"content": "Next, we add the ingredients. First, in go the radishes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980905
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980905,
					"content": "Uhh... Y'know, this looks more like an alchemy experiment than cooking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980906,
					"content": "Will dishes made this way really turn out alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980907,
					"content": "And it is done — Radish Veggie Soup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980908
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980908,
					"content": "Our process went quite smoothly, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980909,
					"content": "Indeed, let us give it a try, Traveler. You're welcome to have seconds, if you two so wish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980910
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980910,
					"content": "Woohoo! Let's dig in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980911,
					"content": "Thanks...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980912
					]
				},
				{
					"id": 710980912,
					"content": "Uh... This tastes like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980913,
					"content": "...Sir, I suspect that these radishes must be cooked for a while longer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980914
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980914,
					"content": "*cough* Agh... How did the Mints turn out like this? I'm sure that I had calculated its optimal cooking time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980915,
						710980916
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980915,
					"content": "Guess I don't have to drink it, then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980917
					]
				},
				{
					"id": 710980917,
					"content": "*cough* The flavor of this soup is... actually worse than what was made in our previous attempt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980918
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980918,
					"content": "I... *cough* fully concur with your position, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980919
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980919,
					"content": "*cough* Alright... Step Two: feedback.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980920
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980920,
					"content": "I say! The formula must be missing one parameter or another, or our calculations are still imprecise... I must adjust the machine's algorithm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980921
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980921,
					"content": "Lutong, have you recorded all the data from this cooking session?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980922
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980922,
					"content": "They have all been recorded, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980923
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980923,
					"content": "Excellent — we are one step closer to success, then. In that case, on to Step Three: requesting that a chef demonstrate the cooking process once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980924,
						710980926
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980924,
					"content": "I'm sorry, why are you all looking at me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980925
					]
				},
				{
					"id": 710980925,
					"content": "I fear that you're the only one we can count on to help us make that Radish Veggie Soup, Traveler. Mr. Yanxiao has... Let's just say he's been ignoring us for a while now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980926,
					"content": "You know that Yanxiao's over there, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980927
					]
				},
				{
					"id": 710980927,
					"content": "I think letting us use his kitchen was as far as he would give ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980928
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980928,
					"content": "I fear that you're the only one we can count on to help us make that Radish Veggie Soup, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980916,
					"content": "I think I'll wait for a while...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980917
					]
				}
			]
		},
