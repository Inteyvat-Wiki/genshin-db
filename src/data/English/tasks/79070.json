				7907001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"2"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saborn",
					"Souffache",
					"Cimest"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "Your Excellencies. I welcome you on behalf of the Kingdom of Breezes and Bells.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700102,
					"content": "What will you do next?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Hmm... Well, first, I shall announce to all the people that the relic has passed judgment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700104,
					"content": "And that the Guardian... will be Mr. Faurobert, who has come here from afar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700105,
					"content": "Huh!? Why would you do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700106,
					"content": "Trying to explain everything we've been through would be far too complicated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700107,
					"content": "Besides, it would take too long for them to grasp the concept of me being both a princess and a Guardian at the same time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700108,
					"content": "When the time is right, I will make a detailed record of all that happened and then inform my people in writing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700109,
					"content": "But until then, I will still preside over all the affairs of the kingdom as its \"Princess.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700110,
					"content": "Once those \"trial grounds\" have been officially converted into \"training grounds,\" I will set off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700111,
					"content": "Set off?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Your Highness, do you still remember... Who the relic actually lit up for back in the cave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700114,
					"content": "Hmm? Who it... actually lit up for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700115,
					"content": "Yes, as we were both next to it at the time. Of course, Your Highness fully deserves to be acknowledged, but I on the other hand... I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700116,
					"content": "You're a champion who's been acknowledged by a champion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Exactly, and that champion came specifically to ask for your help! How could you possibly still think you're unworthy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700118,
					"content": "*sigh* Maybe it's simply that you shine so brightly, Your Highness, that everyone was mistaken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700119,
					"content": "Pfft... Well then, Mr. Champion, would you be willing to undergo another trial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700120,
					"content": "I, Princess Cimest of the Kingdom of Breezes and Bells, shall personally bear witness to your deeds with this relic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700121,
					"content": "Of course! I do, I do, I do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700122,
					"content": "Hold your horses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "He gets so excited whenever he hears the princess's name. Hehe, Faurobert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700125,
					"content": "Don't get me wrong! I—I'm doing this to fulfill the calling of Rainsong Pond! All that training I did, it was all to save... Uhh, I mean, protect Her Highness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700126,
					"content": "And it's such an important task, so naturally I must ensure that it all goes without a hitch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700127,
					"content": "Are you willing to travel together with Her Highness?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "I—I am...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700129,
					"content": "Hehe, that's good to hear. Well then, Mr. \"Champion\" Faurobert, are you ready for my trial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700130,
					"content": "I am, Your Highness! Whenever you're ready, I'm ready!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700131,
					"content": "Whoa! The relic's lit up again, and it's super bright this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700123,
					"content": "My ears... It burns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "What are you going to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Faurobert",
					"Horellou",
					"Estampe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "Estampe! Where have you been!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700202,
					"content": "Uhh, actually, I was strolling about the area, and had a go at that trial. It was fun, but I had to adopt a slightly different approach to pass it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700203,
					"content": "Mr. Horellou has filled me in on everything that has happened to you. Not bad, Mr. Guardian. Turns out you're pretty talented after all, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700204,
					"content": "Y—Y—You... If you'd been standing next to me, I'd have pushed you off, I tell you! I'd have pushed you off ten times if I had the chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700205,
					"content": "Hence why I decided to take part in the trial instead. Faurobert, my friend, I always believed you could do it. And look... You did it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700206,
					"content": "Hahaha, you're jolly good fellows, the both of you. Today is an auspicious day for our pond!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700207,
					"content": "Finally, we have a true champion. Though Mr. Faurobert hasn't saved a princess yet, I believe that his chance will come.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700208,
					"content": "*sigh* But I really didn't do anything, Mr. Horellou, other than standing by and watching as Her Highness did all the heavy lifting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700209,
					"content": "Isn't that even better? Surely you didn't want the princess to be in danger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700210,
					"content": "I... Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700211,
					"content": "Ahh, that's quite enough, Mr. Faurobert. You were entrusted to fulfill the calling by Cibrelus himself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700212,
					"content": "Oh, pish posh! I'm not even sure if it was Cibrelus! After all, I've only ever heard of him, never heard him speak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700213,
					"content": "And you even accepted the princess's trial. You're a champion if ever there was one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700214,
					"content": "Can we just... Not talk about this for now? Please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700215,
					"content": "Anyway, to sum up — the future of Rainsong Pond is now in your capable hands!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700216,
					"content": "Now, we can simply enjoy jumping for jumping's own sake! When I get back, I'll suggest to the committee that we make \"fun\" the focus going forward!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700217,
					"content": "That sounds like a proposal I'd be willing to get behind. On that note, let's head back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700218,
					"content": "Hey, don't leave me here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faurobert"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cimest",
					"Saborn",
					"Souffache"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "Both you and that paper frog were acknowledged as Guardians, Your Highness!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700302,
					"content": "Unbelievable, unheard of! There is simply no precedent for this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700303,
					"content": "And you'll have to make changes to the trial too... No, don't do this, Your Highness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700304,
					"content": "You can't simply overhaul such an ancient tradition on a whim, Your Highness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700305,
					"content": "Alright, alright, keep your voices down. My ears are starting to hurt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700306,
					"content": "It's all been decided already. Now, given that I am both a princess and a Guardian who has been acknowledged by the relic, you're in even less of a position to stop me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700307,
					"content": "But, Your Highness...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700308,
					"content": "The both of you may relax. I'll host a ceremony to train up hosts of reliable flying squirrels to defend the kingdom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700309,
					"content": "Only after that will I leave the kingdom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700310,
					"content": "Your Highness, we... *sigh* You...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700311,
					"content": "Don't worry, you two. I can take care of myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700312
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700312,
					"content": "As the princess, in the end it is I who shall face the wild winds of the world on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700313
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700313,
					"content": "...As you wish, Your Highness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saborn"
				}
			]
		}
	]
}