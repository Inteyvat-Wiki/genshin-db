				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260801,
					"content": "I should be able to see the meteorites clearly from here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260802
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260802,
					"content": "There's a letter for you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260803
					]
				},
				{
					"id": 411260803,
					"content": "A letter from Daddy... Ugh, I already know what it's going to say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260804
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260804,
					"content": "He can't come and spend time with me because of work, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260805
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260805,
					"content": "When those Millelith came here, I thought Daddy would be with them, but that didn't happen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260806
					],
					"speakerTitle": "Little Liu"
				},
				{
					"id": 411260806,
					"content": "But that's not a bad thing, actually. With all those rocks falling from the sky, Daddy could be in danger out there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260807,
						411260809
					],
