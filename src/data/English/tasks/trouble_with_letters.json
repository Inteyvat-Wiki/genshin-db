			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "*sigh* What shall I do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "You must have seen those meteorites that fell from the sky as well, right? Fortunately, the city wasn't hit, but it's a real mess out there in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260104,
					"content": "Not only have the meteorites blocked the roads, but they've also caused the nearby monsters to become more agitated and dangerous than usual, and they've been attacking passers-by and merchants everywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260105,
					"content": "The Ministry of Civil Affairs has sent almost every single available Millelith out, but Liyue is far too large. We can only ensure the safety of a few main roads and some key villages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260106,
					"content": "I'd applied to go to Qingce Village to take up guard duties there, but for some reason, I still got redeployed here to stand by for orders...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260107,
					"content": "Traveler, could you help me send this letter to a girl named Little Liu who lives in Qingce Village?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260108,
					"content": "She's my daughter, and I'd agreed to go back to spend a few days with her. But with this emergency cropping up, there's no way that'll happen now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260109,
					"content": "I've got your back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "Much appreciated, Traveler. Ah, what horrible luck...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260115,
					"content": "That said, I've heard from people who've come to stand down from duty that quite a few monsters have gathered near Qingce Village as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260116,
					"content": "Well... I don't mean to impose, but you do look dressed for adventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260117,
					"content": "Could you have a look around Qingce Village while you're sending the letter, and help to clear the monsters out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260118,
					"content": "The Millelith largely stand guard on the main roads and key passes... Things could go poorly if some scattered monsters were able to sneak into Qingce Village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260119,
					"content": "Alright then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "Thank you! I truly appreciate it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260121,
					"content": "Well, that'll run you extra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "Well, um... Don't worry, I will arrange fair compensation for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260123,
					"content": "You have my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260111,
					"content": "It wasn't in your hands...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "I know, but... I just don't get it. Why does something happen every time I try to apply for leave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260113,
					"content": "I'm finding it hard to call it a coincidence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260114,
					"content": "Well, I'll leave it to you then. Please help me get this letter to Little Liu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				}
			]
		},
