			"dialogs": [
				{
					"id": 411260601,
					"content": "Do you where Little Liu is?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260602
					]
				},
				{
					"id": 411260602,
					"content": "Little Liu? We were going to meet here to watch the meteorites, but she said that she wanted to find someplace higher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260603
					],
					"speakerTitle": "Dongdong"
				},
				{
					"id": 411260603,
					"content": "She said that she'd tell me once she found our new spot, but I don't know where she's gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dongdong"
				}
			]
