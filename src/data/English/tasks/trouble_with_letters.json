					"nextDialogs": [
						411260502
					]
				},
				{
					"id": 411260502,
					"content": "Little Liu? Hmm, I remember her saying that she wanted to find a high place so she could watch the meteorites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260503
					],
					"speakerTitle": "Yundan"
				},
				{
					"id": 411260503,
					"content": "Hmm, I think she <color=#00E1FFFF>climbed up those ladders over there</color>.",
					"roleType": "TALK_ROLE_NPC",
