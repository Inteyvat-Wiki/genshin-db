			"dialogs": [
				{
					"id": 411260701,
					"content": "So, about Little Liu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260702
					]
				},
				{
					"id": 411260702,
					"content": "Little Liu... Little Liu... Ah yes, I know her. But I've been here all this while, and she didn't pass this way.",
					"roleType": "TALK_ROLE_NPC",
