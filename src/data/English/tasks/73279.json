			"trigger": {
				"objectNames": [
					"Masseira",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#Ah, {NICKNAME}, esteemed Master of the Jinni. To what do I owe the pleasure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "Splendid. Another desert-spawn. My master, I— *sigh* Never mind. I trust your judgment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790103,
					"content": "Could you spare a minute for me? I've been looking forward to seeing you as I've been to seeing the moon and rain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "Don't let us doubt your intent. Just cut to the chase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790105,
					"content": "Very well, Master of the Jinni, I do have a request...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "Haha, nothing serious. It's just my Falcon, Tadhla. I think she's in danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "*sigh* If it weren't for my weak legs, I wouldn't be troubling you for this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "Correct Paimon if she's wrong. You want us to rescue her before thanking us profusely, paying us a large sum of Mora, and treating us to a big meal for our triumph, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "Uh... Yes, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "Well, if that's the case, we'll do it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "Paimon always gets extra logical when it comes to such situations...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "*sigh* Alright, let's do it for Paimon's big meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790113,
					"content": "Thank you so much. I'm counting on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "Let me mark out her last known location.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "The person you need to look for, Tadhla, is tall, tanned, with light-colored long hair, and uses a long bow. Yes, this should be enough information about her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "Did you get it all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "Hmm... A tall, tanned girl with light-colored long hair and holds a long bow! Hehe, Paimon has an excellent memory!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "May the wind guide you through sandstorms and away from danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "Thank you. We'll see you soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7327902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
