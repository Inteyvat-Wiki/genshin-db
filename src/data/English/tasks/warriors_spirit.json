			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Your skills are superb. I've been thoroughly bested.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "It was an honor to fight against you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "Ladies and gentlemen, after an exhilarating battle, the champion for the Warrior's Spirit Swordfighting Exhibition has been decided! Give it up for... the Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "Tomorrow, we will conduct the final exhibition match... The Traveler and Miss Kamisato versus the Almighty Shogun's chosen envoy, an autonomous humanoid known as the \"Maguu Kengou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "We'll see you then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "That was a most thrilling match, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "Congratulations, Traveler. You've certainly earned your title as the champion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Paimon had no idea that tomorrow's opponent would be the Maguu Kengou... That name sounds similar to that troublesome one we encountered on Yashiori Island. Oh, Paimon doesn't think it'll be an easy fight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "Don't worry, Paimon. The Shogun's chosen envoy may be strong, but tomorrow's match doesn't prohibit the use of Visions. We'll make a formidable team.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "As long as we can track its moves, an opportunity to strike back will present itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Oh, hearing your confidence sure makes Paimon feel better!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "I cannot guarantee that we will win, but we must try our best, if just to give the crowd a show they will not forget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "We can win, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "I can tell you two are already raring to go, but it'd be best to conserve your energy and get some rest tonight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "We'll also be able to see Ayaka's new outfit when we wake up tomorrow. Ayaka in a Fontaine dress... Oh, Paimon can't wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Ah, yes. Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "I can't wait, either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "Huh, Traveler... You too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Hehe, sounds like there's no way around it, Miss Ayaka. If I wasn't busy tomorrow, I would have loved to come see as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "Ah, I suppose it's settled then. I'll wait for you at the Kamisato Estate tomorrow morning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "Do you want me to pick you up in the morning?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "It'll definitely be an exciting match.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
