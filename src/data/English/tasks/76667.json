			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "Ugh... I should have brought more Lakkaberries...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670102,
					"content": "(When Lauma was here last time...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#Hello, {NICKNAME}, are you here for a Feast of the Moon? I'm so sorry, but... you might have to wait a little while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670105,
					"content": "What is a Feast of the Moon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "Huh? Didn't you get one last time...? Oh, right, Lady Lauma organized that one... and I guess she didn't mention the meal's official name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670107,
					"content": "Simply put, a Feast of the Moon is a free meal we Frostmoon Scions distribute to those in need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670108,
					"content": "Helping such people has ever been one of our traditions, though it used to be limited to the area around Hiisi Island...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670109,
					"content": "But under Lady Lauma's leadership and with everyone's help, we've gradually expanded our reach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670110,
					"content": "Lady Lauma says this is part of spreading the Moon Goddess's Favor to all. There's a saying that goes... Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670111,
					"content": "\"The first fruit of the harvest must be placed upon the Moonlight Altar — not as an offering to the gods, but as a spark for...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670112,
					"content": "\"A spark for...\" Umm... What was the rest of it again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670113,
					"content": "*Ahem*, anyway! This shop is one of the main distribution points for the meal. Hehe, and I manage almost everything here by myself! Pretty impressive, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670114,
					"content": "We've had a lot of trouble getting the meals out in Nasha Town, but I believe in what Lady Lauma says — we really can help more people this way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670115,
					"content": "However... when I was preparing the ingredients yesterday, I forgot to close the box lid tightly, and when I woke up this morning, many fruits had been pecked open by birds and were completely unusable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670116,
					"content": "I can barely make any Feasts of the Moon with the remaining Lakkaberries... *sigh*... What should I do now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670103,
					"content": "(It seems they were handing out food...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
