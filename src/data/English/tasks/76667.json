			"dialogs": [
				{
					"id": 766670401,
					"content": "These will be enough. Thank you, thank you so much! Just a moment — I'll prepare the most delicious Feast of the Moon you've ever seen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670402
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670402,
					"content": "Lyylikki rushes to the kitchen and throws herself into preparing the Feast of the Moon...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "It's ready. Please, have a taste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
					"content": "Thank you again for your help. Should you get hungry next time, please feel free to come by. I'll prepare a special portion just for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
