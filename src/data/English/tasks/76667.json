				"points": []
			},
			"dialogs": [
				{
					"id": 766670301,
					"content": "I'll go gather some for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "You... you want to help?! Thank you so much! Really, thank you! Then... please bring me five <color=#00E1FFFF>Lakkaberries</color>, that should be just enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670303,
					"content": "Once you bring them back, I promise I'll make you the tastiest Feast of the Moon you've ever had!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
