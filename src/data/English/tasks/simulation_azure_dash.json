				"points": []
			},
			"dialogs": [
				{
					"id": 745030101,
					"content": "Welcome, dear guests, we meet again. It has not been long, and yet I miss you a little already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030102
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030102,
					"content": "Hmph, you sweet talker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745030103,
					"content": "Ah, woe is me, loathed am I! How the pain stings. Perhaps I'd best get back to work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030104
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030104,
					"content": "Let me state first that the planned data collection project will be divided into two parts. One will be run by Alberre, and the other by me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030105
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030105,
					"content": "On my side, we wish to model the agility of a Champion Duelist, and so we'll need you to complete a few underwater speed challenges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030106
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030106,
					"content": "Huh, do Champion Duelists have to train underwater?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745030107,
					"content": "Who knows? I do not know one personally, and I don't think the boss knows any either. He probably just thinks that it's cooler this way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030108
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030108,
					"content": "He originally wanted to install 10 different water-drawing mechanisms that can spray jets of water, but eventually gave up on this idea due to the high cost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030109,
						745030110
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030109,
					"content": "That does sound pretty cool.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				},
				{
					"id": 745030111,
					"content": "Well, Fontaine is the realm of water, after all, and if this is to be sold in other nations, a little Fontainian flair is needed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030112
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030112,
					"content": "Anyway, we've prepared a handbook with relevant details. Please peruse it at your disposal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030113
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030113,
					"content": "Well, are you two raring to go already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030114
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030114,
					"content": "Let me make some preparations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030115
					]
				},
				{
					"id": 745030115,
					"content": "No problem. The data collection devices have already been placed over there, so you need not worry about them. You just need to focus on completing the challenge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030110,
					"content": "Only kids would find that cool.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				}
			]
		}
	]
}