			},
			"dialogs": [
				{
					"id": 710060801,
					"content": "This isn't right... This can't be right. Those statues' eyes don't light up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060802
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060802,
					"content": "Is my viewfinding technique wrong somehow? No, that can't be it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060803
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060803,
					"content": "Eyes... What eyes? This statue doesn't have any at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
