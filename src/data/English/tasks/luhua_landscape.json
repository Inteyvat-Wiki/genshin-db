			"dialogs": [
				{
					"id": 710061001,
					"content": "Oh... So that's how it is! These two rocks really are the eyes of the two statues. Their eyes will only shine once you've slotted those stones in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710061002
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710061002,
					"content": "Looks like I'll be able to paint something great after all! I'm off to find a good angle! Thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710061003
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710061003,
					"content": "Wonderful, absolutely wonderful...",
