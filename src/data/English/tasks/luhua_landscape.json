				{
					"id": 710060701,
					"content": "How will I find that one perfect view...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060702,
					"content": "Regarding that rock...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060703
					]
				},
				{
					"id": 710060703,
					"content": "About the rock? Why are you suddenly interested in that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060704,
					"content": "I picked it up while looking for a good view at <color=#00E1FFFF>Luhua Pool</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060705,
					"content": "Do you want to go to <color=#00E1FFFF>Luhua Pool</color> to have a look?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060706,
					"content": "You'll have to keep a close eye out. There're all sorts of things in that pool, and I have no idea who threw it in there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
