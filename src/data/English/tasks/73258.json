					"nextDialogs": [
						732580402
					]
				},
				{
					"id": 732580402,
					"content": "#\"...it looks so good with a garland, and it connects you with everyone. Just like {M#he}{F#she} is an Aranara too.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580403
					],
					"speakerTitle": "Messily-Written Note"
				},
				{
					"id": 732580403,
					"content": "#\"Now Nara {NICKNAME} and Paimon are resting. I still don't understand. Why does Nara have to rest? You can't create memories with your friends while taking a break...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580404
					],
					"speakerTitle": "Messily-Written Note"
				},
				{
					"id": 732580404,
					"content": "#\"... Going to meet Ashvattha. Ashvattha will accept Nara {NICKNAME} and Paimon. We are all children of the forest.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580405
					],
					"speakerTitle": "Messily-Written Note"
				},
				{
					"id": 732580405,
					"content": "#\"By the way, there must be a lot of adventure stories about Nara {NICKNAME}, Paimon and everyone in Aranyaka.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580406
					],
					"speakerTitle": "Messily-Written Note"
				},
				{
					"id": 732580406,
					"content": "#\"After Nara {NICKNAME} and Paimon get the Bija and help Narana, let's call Arana and read the stories in aranyaka!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Messily-Written Note"
				}
			]
