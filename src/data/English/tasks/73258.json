					"nextDialogs": [
						732580302
					]
				},
				{
					"id": 732580302,
					"content": "#\"... Arama has prepared flowers, but Arama is afraid that Arama can't give the flowers to {M#him}{F#her}. However, fear is not good, as Arana said, if you are afraid, you will believe in the power of fear...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580303
					],
					"speakerTitle": "Messily-Written Note"
				},
				{
					"id": 732580303,
					"content": "\"...Festival Utsava is about to begin. Many friends Arama hasn't seen for a long time have returned to Vanarana. Araja is also happy to be able to fill the vacancy for him. \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Messily-Written Note"
				}
			]
		},
