	"talks": [
		{
			"id": 7280402,
			"completionStepIds": [
				7280404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280404",
							"2"
						],
						"stepId": 7280404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Kairagi\"",
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "Agh! P—Please, spare me! Where did you get this kind of help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040207,
					"content": "Foul villain! Hand my weapon over at once!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040208,
					"content": "You... You're still all hung up about that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040209,
					"content": "I am only here to retrieve my weapon. If you tell me where it is, I'll spare you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040210,
					"content": "This...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040211,
					"content": "Don't waste any more words with him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "N—No, please! Please stop! I—I didn't say I wouldn't say anything! We don't have to get this violent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040214,
					"content": "Th—That weapon was taken by our boss as part of his collection. If you want it, you can just go to the camp over there to get it from him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040215,
					"content": "Well, at least you have some sense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040216,
					"content": "P—Please, good sirs, I've told you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040217,
					"content": "Out of my sight!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "At once!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040219,
					"content": "Not much martial skill to speak of, but he was quite the runner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040220,
					"content": "Not to mention pretty quick to sell his buddies out, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "The Kairagi are ultimately a motley band who've banded together for their own selfish gain. Loyalty plays no part here, nor does conviction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040222,
					"content": "The moment trouble starts brewing on the horizon, they will pack up and leave. This is all too common.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040223,
					"content": "But fortunately, I had you here to help me. I doubt that they would have capitulated so easily otherwise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040224,
					"content": "However, our next stop is their main encampment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040225,
					"content": "We will follow our original stratagem. I will take their leader on, and leave the small fry to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040226,
					"content": "I'll take care of it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "Much obliged!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040227,
					"content": "I can take ten of them at once, no problem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Come on, let's find someone else...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280405",
							"2"
						],
						"stepId": 7280405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Kairagi\" Leader"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "You? Hah, aren't you that brat from before? What, are you here to add something to my collection again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "\"Kairagi\" Leader"
				},
				{
					"id": 728040302,
					"content": "No. I am here for my weapon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040303,
					"content": "Heh, well, at least you've got some guts. But only one ally, really? You must really take me for a sucker, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "\"Kairagi\" Leader"
				},
				{
					"id": 728040304,
					"content": "But you know what? I'll give you a chance on account of your bravery, at least. Come on! Let's settle this somewhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "\"Kairagi\" Leader"
				},
				{
					"id": 728040305,
					"content": "Still... it wouldn't be good to leave my boys here with nothing to do, would it? I know! Why don't you ask your little helper to play with them a bit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "\"Kairagi\" Leader"
				},
				{
					"id": 728040306,
					"content": "Any time they're ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "Hahaha. You've got some lip! Well then, boys, you heard 'em. Let 'em have it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "\"Kairagi\" Leader"
				},
				{
					"id": 728040309,
					"content": "As for you, let's go over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "\"Kairagi\" Leader"
				},
				{
					"id": 728040310,
					"content": "I leave this in your hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040311,
					"content": "I'll take care of it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "You have my utmost thanks. I will slay him quickly and come to your aid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040313,
					"content": "Well, aren't you a talker yourself? You're welcome to try!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kairagi\" Leader"
				},
				{
					"id": 728040307,
					"content": "Let's hope that their A-game is passable, at least.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280407",
							"2"
						],
						"stepId": 7280407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "From your steady breathing, it seems that those Kairagi were no match for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040407,
					"content": "And it seems that you were victorious as well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "That is indeed the case. Though I must admit that to my shame, I allowed him to escape with but a single stab from my spear due to a feint on his part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040409,
					"content": "Still, his wound was very severe. I do not believe that he will emerge to do much ill for at least a few years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040410,
					"content": "More importantly, I have defeated him myself and reclaimed my weapon. I am henceforth free from the stain of that humiliation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040411,
					"content": "Congratulations, Asakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "Indeed, I owe you thanks, but I cannot rest yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040413,
					"content": "The reason for this whole incident was my lack of training. I will continue to train hard and refine my skills.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040414,
					"content": "As such... I shall be counting on you in the future as well to spar with me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040415,
					"content": "Ah, yes. Please take these as a token of my thanks. It isn't much, but do accept it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040416,
					"content": "Thank you once again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		}
	]
}