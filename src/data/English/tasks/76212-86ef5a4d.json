			"trigger": {
				"objectNames": [
					"Quiauhquetzal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "You stop at the top of the bookshelf on one side...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "It's safe here. What is it, my golden friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120305,
					"content": "Nothing. I'm just a little curious, that's all...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "Here, it's high up, and you can see far and wide. It's a good place to hide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120309,
					"content": "In our Cal{RUBY#[D]Tribe}pul, being on the ground is considered dangerous. Even if the Great {RUBY#[S]Sovereign Lords} Rulers above us don't decide to wipe us out on a whim, the other Calp{RUBY#[D]Tribes}ulli will still come to plunder us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120310,
					"content": "Perching on the cliffs and in the trees like the quetzals allows us to flee calamity before it strikes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120311,
					"content": "Besides, Vindia says that she wishes to see me fly. She wants to si{RUBY#[D]write}ng of riding a giant bird in a story of adventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120312,
					"content": "Are you sure she isn't putting you on...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "No, no. Vindia is a very good person, maybe even as good as the Lord of the Crossroads. They're both such kind people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120314,
					"content": "But it's amazing just how you two flew, all the way up there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120315,
					"content": "This is for you. Consider it proof of our friendship. Now, I must think about how we can fly even higher to stay out of danger's reach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120316,
					"content": "Neither the Great {RUBY#[S]Sovereign Lords} Rulers nor the conquerors who revel in flaying are here, it is true... but I'm already used to having a means of escape wherever I am.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120306,
					"content": "I'm just wondering if you're stuck up there...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "Thank you, but no, I'm not stuck. It's safe when I'm high up. Here, I won't get killed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "Quiauhquetzal"
				}
			]
		}
	]
}