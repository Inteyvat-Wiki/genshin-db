				{
					"id": 730580401,
					"content": "Let's go to the bad Nara's campsite and find out what they're up to!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "How can you tell if someone's bad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Well, I can't really explain it, but Nara {NICKNAME} and White Floaty are not baddies for sure! I believe that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
