				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "Festival Utsava... Feels familiar... Eh? It's White Floaty... and the Golden Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "It's the Nara friend, and the Nara friend's friend. Hope you will have fun during Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "A friend's friend is also our friend! Golden Nara and White Floaty are both Aragaru's friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		}
	]
