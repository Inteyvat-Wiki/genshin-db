					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#Nara {NICKNAME} and Paimon! Don't worry. The baddies that made Vanarana sick won't be coming back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#Thank you, Nara {NICKNAME} and Paimon for helping Ararycan protect Vanarana. Ararycan has flowers for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "Take the flowers, friends of Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
