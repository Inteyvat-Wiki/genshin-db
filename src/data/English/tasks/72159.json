			"dialogs": [
				{
					"id": 721590501,
					"content": "It seems that you have neglected your training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590502
					],
					"speakerTitle": "\"Masanori\""
				},
				{
					"id": 721590502,
					"content": "A single day of sloth will waste ten of a warrior's work. I'm sure you understand this principle well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590503
					],
					"speakerTitle": "\"Masanori\""
				},
				{
					"id": 721590503,
					"content": "Hone yourself further. I do not believe that is all you can do.",
