			"dialogs": [
				{
					"id": 721590301,
					"content": "I'd like to talk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721590302
					]
				},
				{
					"id": 721590302,
					"content": "I have forsaken my past. There is nothing to be said between me and this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590303
					],
					"speakerTitle": "\"Masanori\""
				},
				{
					"id": 721590303,
					"content": "If you are looking for someone to chat with, you have come to the wrong person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590304
					],
					"speakerTitle": "\"Masanori\""
				},
				{
					"id": 721590304,
					"content": "Kindly leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Masanori\""
				}
			]
		},
