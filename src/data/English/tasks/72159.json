			},
			"dialogs": [
				{
					"id": 721590401,
					"content": "Haha. I am still not your match.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590402
					],
					"speakerTitle": "\"Masanori\""
				},
				{
					"id": 721590402,
					"content": "I should probably have expected that. You are ever advancing in skill, and the limits of my nature prevent me from making a similar breakthrough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590403
					],
					"speakerTitle": "\"Masanori\""
				},
				{
					"id": 721590403,
					"content": "Nonetheless, should you learn any new techniques, I would be glad to see them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590404
					],
					"speakerTitle": "\"Masanori\""
				},
				{
					"id": 721590404,
					"content": "Until we meet again, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Masanori\""
				}
			]
		},
