					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560601,
					"content": "Can't believe I lost to this passerby... three times!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "No, no, you and I lost twice each, and the boss only lost once, so it's not that bad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#Heh! A loss is a loss, no point brooding over it. This {NICKNAME}'s really something else!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "You two can't even beat me on a good day — and now you've seen a real master in action. See? You've got a lot of training to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "As for me? Hah... Maybe it's time to consider early retirement. I wonder if Vaino's training ground is still hiring...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
