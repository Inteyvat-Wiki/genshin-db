			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "I—I lost...? To some random passerby?! Th—This can't be real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560502,
					"content": "Hmph, so even Incali couldn't win... I've definitely been taking you too lightly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560503,
					"content": "It's not your fault, Boss. Who'd have thought someone that strong would just happen to walk by...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560504,
					"content": "Boss! We can't let them off the hook...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560505,
					"content": "Oh-ho, so we're not just here to spar then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "Don't get the wrong idea. Incali just means... We can't give up on winning so easily. After all, we're treasure hunters with a reputation to uphold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}, I formally issue you a challenge. This time it's not just for fun — let's go all out and see what we're really made of!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560508,
					"content": "Then I'll take all three of you at once.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "Alright then, we won't hold back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
