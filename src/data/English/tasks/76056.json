				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "Sorry, I've got other things to do...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "No worries. We're just hanging around killing time. Come back whenever you're free... or bored stiff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
