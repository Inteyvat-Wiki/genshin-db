			"dialogs": [
				{
					"id": 750700901,
					"content": "Haha! Perfect! Here, have a copy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700902,
					"content": "Wow, that *is* amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "Here's your compensation. This is the second... No, the third time you've aided me. If not for you... Why, I doubt I'd have a chance of finishing my photo-taking trip at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700904,
					"content": "My destination is... Here. I've marked it out on your map. Again, if you're interested, I look forward to working with you again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700905,
					"content": "Ah! It's almost time. I've got to go now. See you, and good luck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700906,
					"content": "Magnifico finishes packing and hops happily up into his hot-air balloon.\\nAs the balloon slowly disappears, his boisterous laughter is reduced to a distant echo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
