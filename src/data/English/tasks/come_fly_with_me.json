			"dialogs": [
				{
					"id": 750701401,
					"content": "Gah, we must start over! ...Uh, if you don't mind, I mean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701402,
					"content": "*sigh* There's no \"mind\" or \"don't mind.\" We're already here, aren't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701403,
					"content": "Let's continue, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "You have my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701405,
					"content": "Let's take a break first...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "That's right. Jumping off cliffs is hard work, y'know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701407,
					"content": "Ah... Yes. I did not consider that. Alright, just start whenever you're ready. I will wait for you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
