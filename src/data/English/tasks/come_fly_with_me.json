					}
				]
			},
			"dialogs": [
				{
					"id": 750701601,
					"content": "*sigh* As you can see, the results are... not ideal. As the deeds, so the man — unsuccessful both!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701602,
					"content": "Ah... My family always told me that even small trees can cast huge shadows... But it's nonsense! Nonsense! They only meant to humiliate me, surely!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701603,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701604
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701604,
					"content": "Hey, hey, don't get mad! You're not going to get any bigger even if you do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701605,
						750701609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701605,
					"content": "Don't give up...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701606
					]
				},
				{
					"id": 750701606,
					"content": "Give up? Who says I'm giving up? Nay! Anger and shame only drive me on, give me strength — that is their purpose! We continue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701607,
