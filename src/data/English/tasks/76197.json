			"dialogs": [
				{
					"id": 761970120,
					"content": "(test) Voice Line",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "During my years at sea, I once heard a call coming from nowhere. The others didn't react at all, but I was captivated almost instantly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "It must have been a voice from another world. I've heard it too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Only later did I realize... That call carried with it every dream that never made it to the far shore. You might even call it a gathering of regrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "You should bring an Icy Pebble with you. Look through the hole at its center, and you'll see who's been calling out to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "But back then, I was still a hot-headed young fool. Even danger looked like an opportunity to me. So I charged straight in without a second thought.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "They say the hole at the center of the Icy Pebble is a gateway to another world... But how exactly are you supposed to cross through it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "And after that... the sea and its raging winds took everything from me — my wealth, my honor, and even my family.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Adventures driven by ambition and desire never end well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "Ah, it's stuck...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Let me help you get that off. And next time, try not to do that again, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970111,
					"content": "Linnea! What brings you back here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "I've been collecting Icy Pebbles nearby. I saw you chatting and thought I'd come say hello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970113,
					"content": "Oh! Maybe you could really use an Icy Pebble to open a gateway to another world, Linnea! If anyone could pull it off, it would be you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Even I can't do that. Didn't I tell you before? That's just a folk tale people stitched together. There's no solid evidence behind it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970115,
					"content": "Ugh... Looks like this isn't gonna work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "...Oh. So you were listening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970117,
					"content": "Ahem... no. I'm not the person I used to be anymore. These days, I'm content with what I have, and I want nothing else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "What a pity. Then I'll help you collect Icy Pebbles too, Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "That'd be great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970124,
					"content": "With Auni's help, the materials were soon collected...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Thank you, but I've already gathered everything I need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970123,
					"content": "Alright then. I'll head to Moleyvalley to see Grandpa Moley and the others. See you later!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
