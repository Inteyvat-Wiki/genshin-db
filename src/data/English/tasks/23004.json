						230040602
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040602,
					"content": "Why weren't these in the camp, but on the nearby tree?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040603,
					"content": "Well... Maybe the birds had them stashed away for a rainy day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040604
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040604,
					"content": "Is this stuff so popular with animals? Maybe I should start a business...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040605
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040605,
					"content": "Ahem! Don't mind me. Thank you very much. Here's your payment.",
