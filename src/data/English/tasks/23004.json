				{
					"id": 230040801,
					"content": "Yes! That's it! So I did leave it in the camp after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040802
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040802,
					"content": "About the camp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040803
					]
				},
				{
					"id": 230040803,
					"content": "I see... Was it the work of wild animals...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040804
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040804,
					"content": "Now that you mention it, the food I made attracted Fungi and birds... So, attracting wild animals sounds about right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040805
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040805,
					"content": "Guess I should really consider starting a feed-selling business...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040806,
					"content": "If that turns out well, I could be making much more money than I do now by putting up performances...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040807
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040807,
					"content": "Oh, sorry, I'm getting off-topic... Thanks for your help, and please, take your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
