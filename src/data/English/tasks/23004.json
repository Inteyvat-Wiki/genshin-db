					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042001,
					"content": "Huh? This bead... How... Where did you find this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042002,
					"content": "Inside a pot in the camp. Did you leave that behind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042003,
					"content": "Ah, it was used in past shows. Whenever I play the flute, my little fellas would carry that bead on their heads and dance with their upper bodies in the air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042004,
					"content": "But tricks of this kind have long ceased being profitable, and I haven't performed for quite some time either. I didn't even notice that it had gone missing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042005,
					"content": "Anyway, thanks for bringing it back. Here's your payment, please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
