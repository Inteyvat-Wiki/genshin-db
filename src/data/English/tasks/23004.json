			"dialogs": [
				{
					"id": 230040701,
					"content": "Yes! That's it! So I did leave it in the camp after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040702
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040702,
					"content": "It was buried under the rocks. Your camp seems to have gotten caught in a landslide that carried your stuff far away. We spent a long while looking, actually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040703,
					"content": "Seriously? How could there be a landslide? That spot has never been in any trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040704
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040704,
					"content": "Oh! When I was camping there, I could hear strange sounds at night, and I could feel something scratching at my tent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040705
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040705,
					"content": "My snakes were alert and would wake me every time. But I never found anything no matter how many times I checked...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040706
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040706,
					"content": "Eh, you know what, forget about it... Thanks for your help. Here's your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
