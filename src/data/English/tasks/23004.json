			"dialogs": [
				{
					"id": 230040501,
					"content": "Yes! That's it! So I did leave it in the camp after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040502
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040502,
					"content": "When we arrived, there were Fungi that were trying to swipe it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040503,
					"content": "Fungi, huh... Phew, guess I was lucky to have you go instead. Thank you so much, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040504
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040504,
					"content": "I can't thank you enough. Please, accept this as your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040505
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040505,
					"content": "Here's your meal, little fellas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
