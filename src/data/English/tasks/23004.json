				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "Huh? These hats... Hahaha, I made them for the snakes. How did I even forget these?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042202,
					"content": "I made each of them a nightcap so that they could attract children to the show.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "Red for Jori, green for Amum, yellow for Gana, and blue for Drak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042204,
					"content": "Sounds cute! The show must've been a hit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "It went well at first, but the children would burst into tears whenever the snakes opened their jaws...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042206,
					"content": "Oh, forget about it... Please take this as your payment. It's something, at least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
