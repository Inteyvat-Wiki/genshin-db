			},
			"dialogs": [
				{
					"id": 230041101,
					"content": "There's special food for pet snakes? Don't they eat mice and stuff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041102,
					"content": "Yes, they did hunt by themselves in the past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041103
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041103,
					"content": "But ever since they startled several children whilst feeding, I have banned them from going out without me. I've started mixing food for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041104
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041104,
					"content": "*sigh* But after that, they haven't been moving much, and have stubbornly refused to eat any other food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041105
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041105,
					"content": "*sigh* Paimon thought \"there was no such thing as a free lunch\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041106,
						230041107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041106,
					"content": "Delicious!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				},
				{
					"id": 230041108,
					"content": "Paimon hasn't even asked about the flavor yet, so you can dream on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041109,
					"content": "Enjoying food is Paimon's job!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041110,
					"content": "Uh huh. Very reasonable of you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041111
					]
				},
				{
					"id": 230041111,
					"content": "I must have left their food at one of my camps when I was out picking herbs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041112
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041112,
					"content": "But I can't really leave, what with all my little fellas to care for and stuff. I don't want them scaring anyone again when they search for food...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041113
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041113,
					"content": "Traveler, would you mind visiting that campsite and fetching the food for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041114,
						230041117,
						230041119
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041114,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041115
					]
				},
				{
					"id": 230041115,
					"content": "Thank you so much. Who knows what accidents we might run into if I were to go there with these little fellas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041116
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041116,
					"content": "If they got it into their heads to go playing around in the forest for a few days, I'd be doomed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041122,
					"content": "Anyway, I'll be leaving this to you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041123
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041123,
					"content": "I'll mark all the camps I've stayed at on the map for you, so please take a look at those spots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041117,
					"content": "There aren't any other snakes at the campsites, right...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041118
					]
				},
				{
					"id": 230041118,
					"content": "No, not at all. I set all my camps up away from snake lairs precisely so that we could stay out of trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041119,
					"content": "How many camps have you got, again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041120
					]
				},
				{
					"id": 230041120,
					"content": "Well, I set up a few while I was living in the rainforest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041121
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041121,
					"content": "I've already stopped living in the rainforest, but I still do rest at my campsites if I collect herbs there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041107,
					"content": "Absolutely delicious!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				}
			]
		},
