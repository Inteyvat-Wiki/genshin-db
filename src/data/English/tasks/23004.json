			"dialogs": [
				{
					"id": 230042401,
					"content": "Ah! Isn't this the snake climbing tower I made? Wow, this sure brings back some memories! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042402,
					"content": "Snake climbing tower? What even is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042403,
					"content": "Just a toy for the snakes to climb on. I can't have them hanging on me all the time, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042404,
					"content": "Thanks for bringing it back. Please take this as your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042405,
					"content": "So I designed it like that? Hah, this sure does bring back some memories...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
