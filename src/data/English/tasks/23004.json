			"dialogs": [
				{
					"id": 230040901,
					"content": "Yes! That's it! So I did leave it in the camp after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040902
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040902,
					"content": "Why is your camp in the middle of a bunch of thorny vines!? Wouldn't you get hurt sleeping there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040903,
					"content": "Nah, I'm pretty skilled when it comes to living in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040904
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040904,
					"content": "And there weren't that many vines around when I established that camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040905
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040905,
					"content": "Have you been away from the forest for a very long time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040906
					]
				},
				{
					"id": 230040906,
					"content": "Sort of. I can't remember the details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040907
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040907,
					"content": "Hahaha, I'm really rusty when it comes to setting up camps now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040908
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040908,
					"content": "Most of the camps I've set up in the past have been abandoned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040909,
					"content": "What kind of life would I be leading had I remained in the rainforest...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040910
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040910,
					"content": "...Sorry, I've said too much. Here is your payment. Please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
