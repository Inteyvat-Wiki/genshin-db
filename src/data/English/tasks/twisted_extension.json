					"speakerTitle": "Quenin"
				},
				{
					"id": 750691202,
					"content": "Oh, it's you. Need anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691203,
						750691207
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691203,
					"content": "What are you doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691204
					]
				},
				{
					"id": 750691204,
					"content": "I'm... a warrior of the adventure team. Not one as mighty as our leader, Lord Taika, but I do have my strengths.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691205,
					"content": "I guard our camp... Sometimes, when I can't sleep at night, I patrol to keep the camp safe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691206,
					"content": "Now, I don't know when it started, but there have been fewer and fewer people in camp every day... Huh, wait. Strange... Why am I here now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691207,
					"content": "Nope, don't need anything.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691208
					]
				},
				{
					"id": 750691208,
					"content": "Is that so... Ah, then take my advice, brave warrior. Leave here quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
