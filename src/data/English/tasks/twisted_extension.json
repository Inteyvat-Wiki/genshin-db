				{
					"id": 750691101,
					"content": "The waterfall, haha... The roar of the falls drowns out everything else, so you can't hear a thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691102,
					"content": "Oh, it's you. Need anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691103,
