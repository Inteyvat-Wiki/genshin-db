						"stepId": 7506903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(A torn page, with neatly written words at the beginning...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Quenin's Diary"
				},
				{
					"id": 750690502,
					"content": "\"...Abyss monsters are growing in number, as expected... The adventure team has failed in the end, and a planned retreat is in progress.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Quenin's Diary"
				},
				{
					"id": 750690503,
					"content": "\"We must ensure the remaining members can evacuate safely. Be wary of those who vanish at night, or return from places devoid of light.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Quenin's Diary"
				},
				{
					"id": 750690504,
					"content": "\"...The Abyss monsters are appearing more frequently. The stronghold may be discovered soon, but before that...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Quenin's Diary"
				},
				{
					"id": 750690505,
					"content": "(The handwriting becomes shaky and distorted...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Quenin's Diary"
				},
				{
					"id": 750690506,
					"content": "\"Ah, it's cold... So cold... There, over there, blood is draining...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Quenin's Diary"
				},
				{
					"id": 750690507,
					"content": "\"The sound of the waterfall, so loud... yes, this is good. As long as... under the waterfall, it'll be quiet there... pale faces, opened mouths, drained blood...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Quenin's Diary"
				},
				{
					"id": 750690508,
					"content": "\"Just there... just... there... something... something is there...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Quenin's Diary"
				},
				{
					"id": 750690509,
					"content": "\"Under the waterfall under the waterfall under the waterfall under the waterfall under the waterfall under the waterfall...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin's Diary"
				}
			]
		},
