			"dialogs": [
				{
					"id": 120370801,
					"content": "He still hasn't arrived? Come on, Kaedehara Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370802
					],
					"speakerTitle": "Asano"
				},
				{
					"id": 120370802,
					"content": "All I want is to see our hero with my own eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nosaki"
				}
			]
