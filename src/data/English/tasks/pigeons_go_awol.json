			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200610501,
					"content": "Regarding these pigeons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610502
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610502,
					"content": "You did WHAT? How could you!? They were my carrier pigeons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610503,
					"content": "You churlish imbecile... hilichurlish, even! What am I going to do about all these letters!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610504,
						200610506
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610504,
					"content": "Sowwie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610505
					]
				},
				{
					"id": 200610505,
					"content": "Is that the best you can do? A Knight of Flaming Favonius and the best you can offer is a half-hearted apology!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610508,
					"content": "You've really fluffed up here, and now you have to make it right. Since you're so bird-brained anyway, I trust you will have no problem being my new carrier pigeon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610506,
					"content": "Sometimes I don't know my own strength...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "It helps if you don't chase them off with a flaming meat cleaver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				}
			]
		},
		{
