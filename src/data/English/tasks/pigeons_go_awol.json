			"dialogs": [
				{
					"id": 200610901,
					"content": "Regarding these pigeons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610902
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610902,
					"content": "The hilichurls have an insatiable appetite for avian messengers? Are you serious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610903
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610903,
					"content": "Well, I suppose they are getting plump, and would probably make a great pairing with a glass of jagerschnapps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610904
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610904,
					"content": "...I mean, uh... Oh drats, now I have to raise a whole new flock of pigeons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
