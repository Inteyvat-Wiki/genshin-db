			},
			"dialogs": [
				{
					"id": 200610401,
					"content": "Regarding these pigeons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610402
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610402,
					"content": "Maybe now they'll deliver their messages without a fuss in future...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610403,
					"content": "But I can't exactly follow them and check... Anyway, that'll do for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610404,
					"content": "For your trouble, please take this. And if you ever need to send a message, just come and find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2006105,
			"completionStepIds": [
				2006117
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006117",
							"2"
