			"dialogs": [
				{
					"id": 200611001,
					"content": "Regarding these pigeons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200611002
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200611002,
					"content": "The hilichurls have an insatiable appetite for avian messengers? Are you serious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200611003
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200611003,
					"content": "Is this letter yours?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200611004
					]
				},
				{
					"id": 200611004,
					"content": "A letter? Ah yes, I sent this! It was supposed to go to Sister Grace, in the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200611005
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200611005,
					"content": "You didn't read it, did you? Not that it matters anyway, it's all stuff that happened years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200611006
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200611006,
					"content": "With some things, you can't leave them in the dark forever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200611007
					],
					"speakerTitle": "Draff"
