			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "Hmm... Looks like a Ratnik's gravestone. Could it be from those Ratniki we saw in the canyon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650102,
					"content": "They keep flickering in and out, showing up one moment and vanishing the next...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650103,
					"content": "Hmm, Paimon still doesn't get what's going on. Let's ask around in Piramida next time! Maybe someone there knows about this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patolichev"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "Oh, greetings. I'm Patolichev, quartermaster of the Lightkeepers. How can I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650202,
					"content": "Are you Patolichev of the Frostgale Steeds?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "The Frostgale Steeds... Ah, you mean those strange shadows we saw earlier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650204,
					"content": "Yes, that was the squad I once served with. The Frostgale Steeds... It's been a long time since I've heard that name. I never thought I'd hear it from someone else's mouth... May I ask how you...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650205,
					"content": "We've been to the foot of Kipumaki Cliff before.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "Yep! And we took care of the Wild Hunt that was causing trouble there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650207,
					"content": "We even saw the Ratniki from the Frostgale Steeds... their shadows still lingering from their fight against the Wild Hunt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650210,
					"content": "I can't believe it was real...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650211,
					"content": "Of course it was! We saw it with our own eyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650212,
					"content": "Ah... Over the years, people have told me from time to time of how they've seen the figures of my fallen comrades at Kipumaki Cliff. That's why even now, I still go there often... and tend to their graves while I'm there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650213,
					"content": "But not once... not even once, have I ever seen them myself. It's been so long... I thought those stories were just kind lies to comfort me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650214,
					"content": "And yet you truly saw them... Why is it that whenever I go, they never show themselves to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650215,
					"content": "Maybe... the time just hasn't come yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "Perhaps... Still, knowing they're really there, even as mere fleeting shadows or memories, is enough for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650219,
					"content": "#In any case, thank you, {M#Sir}{F#Lady}, thank you for being willing to tell me. This means a lot to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650220,
					"content": "It's thanks to them that I can still stand here today. And yet... how I wish I could stand with them once more at the foot of Kipumaki Cliff, fighting shoulder to shoulder again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650221,
					"content": "...One day. One day, I'm sure I'll meet them again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650217,
					"content": "Maybe they just don't want you to recall the pain...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "*sigh* Pain? No... Those final days, standing side by side with them to the very end... how could that ever be painful?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650208,
					"content": "We saw the Ratniki of the Frostgale Steeds...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "Yes... and even if only their shadows remain, those shadows still show them locked in battle with the Wild Hunt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}