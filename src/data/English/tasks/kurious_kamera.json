			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414010101,
					"content": "How very strange... What is the matter with this Kamera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010102,
					"content": "What's wrong with your Kamera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "I think it's broken... Well, maybe not broken, but it's certainly not working like it's supposed to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010104,
					"content": "I ordered a batch from Fontaine a while back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010105,
					"content": "The person who sold it to me said that this particular kind of Kamera features the very latest technology from Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010106,
					"content": "Supposedly, it can print photos in a special hue and add in some special effects, or something. So I bought one to try it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010107,
					"content": "But try as I might, I can't get it to print out photos properly. I don't know whether I'm using it wrong, or if it's just faulty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010108,
					"content": "Maybe there's some trick to it that I'm not getting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010109,
					"content": "So, how about you? Much of a Kamera Konnoisseur yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010110,
					"content": "I dabble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "I'll take that as a yes! So, could I get you to help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010114,
					"content": "I'm guessing you're a traveler? You must have a lot of experiences under your belt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010115,
					"content": "What I'd like you to do is use this Kamera to take a picture of something with a strong color.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010116,
					"content": "Once you've taken a snap, if you could please bring me the photo. I want to see if I can isolate the source of the issue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010117,
					"content": "And if I can't, I'll take the photos to the seller and see what he has to say. With the photos as hard evidence, he won't be able to dismiss the issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010118,
					"content": "I'll do it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "Great. Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010120,
					"content": "What do you mean by strong color?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "Oh, you know... Really bright colors, like red Jueyun Chilis, blue Mist Flower...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010122,
					"content": "Once you've taken a good shot, bring me the photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414010112,
					"content": "Never heard of a \"Kamera\" in my life.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "Oh, I see... Well, never mind, it's simple enough to use... Would you mind giving me a hand anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Ji Tong"
				}
			]
		}
	]
}