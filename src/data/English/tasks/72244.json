			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440501,
					"content": "Traveler... Have you... found the bridle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440502
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440502,
					"content": "Could you... let me have a look at it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224406,
			"completionStepIds": [
				7224415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224415",
							"2"
						],
						"stepId": 7224415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "Ahhh... This is the Divine Bridle. The genuine article indeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440602,
					"content": "I never thought that the day would come when I might lay eyes on it once more. Traveler, tell me — whence did you get this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440603,
					"content": "From Aberaku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "From Aberaku no Mikoto himself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440605,
					"content": "How strange. I remember clearly that he was a great figure from the days when our nation had just been founded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440606,
					"content": "But it was said that he planned to usurp the seat of the Sunchild, and was branded with the crime of treason.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440607,
					"content": "But since you say that you obtained it from his hands, perhaps there are hidden things at work that I do not understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440608,
					"content": "So, fate has decreed the bridle should resurface here... Ah, I can recall the faces of those children already...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440609,
					"content": "This way, I might finally atone for my failings...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440610,
					"content": "Traveler, place the bridle within the pool at the Locus. With it, we can surely revivify their souls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440611,
					"content": "Yes, that they may be made whole, and that they may walk the path to the next life hale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224411,
			"completionStepIds": [
				7224423
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224423",
							"2"
						],
						"stepId": 7224423,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441101,
					"content": "One, two, three... Looks like we've finished paying respects at all seven tombs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722441102,
					"content": "Let's go back to the stone shrine and tell the spirit there about this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224412,
			"completionStepIds": [
				7224425
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224425",
							"2"
						],
						"stepId": 7224425,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Ah, Piramumon. You did so love books, saying that there must be a world outside our knowledge, though I did not believe you then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441202,
					"content": "I always smiled and shook my head at your wild pronouncements. Alas, alas! I should have believed you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441203,
					"content": "You said that one day you would escape the Dainichi Mikoshi and venture into paths beyond...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441204,
					"content": "Go now, Piramumon. Let no one shackle you again. Go, be free!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441205,
					"content": "And you, Orupeusu, Orupeusu. What would I give to hear you sing again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441206,
					"content": "There was no one who could hear your clear, pure voice, and did not wish to sing along in their hearts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441207,
					"content": "The night before the Rite of Solar Return, you suddenly wished to hear my voice. No matter what, you desired to hear me sing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441208,
					"content": "You told me that no matter how terribly I sang, you would not laugh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441209,
					"content": "You knew, didn't you? You knew that this Solar Return would be your last.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441210,
					"content": "And yet I... To the end, I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441211,
					"content": "Clymene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "...I apologize, Traveler. That was unsightly of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441213,
					"content": "The female official who serves the Sunchildren is meant to maintain her purity... She shall never marry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441214,
					"content": "Thus, I had no children of my own all my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441215,
					"content": "These children, whom I served and watched grow older... At some point, they became closer to me than blood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441216,
					"content": "Thank you, Traveler. Thank you for finding the bridle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441217,
					"content": "It has passed through the hands of every Sunchild, and the memories it has inherited are enough to fill the gaps in their souls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441218,
					"content": "...Even though these memories are double-sided.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441219,
					"content": "Double-sided?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "Of course. In this case, the memories are two-fold. On one hand, you have your own memories, and on the other, you have others' memories of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441222,
					"content": "Thus the gaps are being filled by both the Sunchildren's own memories, imprinted upon the bridle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441223,
					"content": "As well as the memories of them as the children who were blamed by Byakuyakoku, of those who became children of sin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441224,
					"content": "My own memories are insufficient, and so I had to supplement them with those of the people of our nation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441225,
					"content": "And it is thanks to these transgressions that have been laid upon them that they have now been remembered by Byakuyakoku, and can now leave their afterimages behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441226,
					"content": "Thank you, Traveler. My greatest wish now lies fulfilled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441227,
					"content": "I can finally... be at ease.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441228,
					"content": "Yes, I... can finally be with those children again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441220,
					"content": "Memories have sides?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
