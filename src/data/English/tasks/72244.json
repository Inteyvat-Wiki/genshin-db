	"talks": [
		{
			"id": 7224401,
			"completionStepIds": [
				7224401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224401",
							"2"
						],
						"stepId": 7224401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Clymene",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "Hmm? How strange. I have not seen someone in your garb for a many long years...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440102,
					"content": "From your mannerisms, you are not from Byakuyakoku either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440103,
					"content": "Are you some guest from afar who fell into this place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440104,
					"content": "That's more or less correct...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "To think that there were ways to access Byakuyakoku from the outside world... Shocking news indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440106,
					"content": "I was born here, and I have never seen anyone from the outside world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440107,
					"content": "Someone once told me that he wanted to catch a glimpse of the world outside. I took his words for a jest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440108,
					"content": "*sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440109,
					"content": "Traveler. In truth, I have a humble request for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440110,
					"content": "There are seven royal tombs scattered throughout Byakuyakoku, in which the remains of our \"Sunchi{RUBY#[S]Phaethons}ldren\" have been interred.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440111,
					"content": "The Sunchildren...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440112,
					"content": "Indeed. Here, we worship the Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440113,
					"content": "After a certain number of years, an infant will be chosen as the Sunchild, gaining control over the nation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440114,
					"content": "We had... a total of seven Sunchildren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440115,
					"content": "O rare Traveler from another land, please, kindly pay respects at their tombs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440116,
					"content": "Um, why would you need us outsiders to do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440117,
					"content": "Isn't it usually up to their family and friends to pay respects to them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440118,
					"content": "Indeed, that would normally be the case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440119,
					"content": "Unfortunately, I fear that no one in this nation would want to do so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440120,
					"content": "In fact, it is likely that these royal tombs have not been visited in a long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440121,
					"content": "But why's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440122,
					"content": "Do the people of this nation dislike the Sunchildren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440123,
					"content": "\"Dislike\" is perhaps too kind a word. \"Detest\" might be more fitting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440124,
					"content": "As I said earlier, the Sunchildren were born into their role.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440125,
					"content": "But how could mere children rule a nation? The ones who truly controlled everything were powerful people behind the scenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440126,
					"content": "The Sunchildren were mere puppets, their every move manipulated by these people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440127,
					"content": "And yet there was no end to the greed of those powerful people. They grew fat off the toil of the people, compelling the Sunchildren to perform heinous deeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440128,
					"content": "And so, the peoples' ire rose, and many of those sins were laid at the feet of the Sunchildren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440129,
					"content": "That's awful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440130,
					"content": "The Sunchildren were innocent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440131,
					"content": "Innocent? Oh no, they were not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440132,
					"content": "As far as the people of Byakuyakoku were concerned, their ignorance was the greatest sin of all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440133,
					"content": "A sin, even committed in ignorance, can hurt others. Can a person who commits such transgressions truly be called innocent?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440134,
					"content": "It would be difficult, no? The damage is already done, and it cannot be undone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440135,
					"content": "But if that's what you think...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "Well, you can consider this... my personal sentimentality speaking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440138,
					"content": "My name is Clymene. I was a female official in charge of taking care of the Sunchildren's daily lives within the Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440139,
					"content": "Though I knew that they did wrong, and though I was aware that they were being manipulated...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440140,
					"content": "They were still children that I watched grow up. I pitied them, and I grieved for them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440141,
					"content": "In the end, I could not hate them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440142,
					"content": "Though my work involved being around them every day, I was under heavy surveillance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440143,
					"content": "I was not permitted to say a single word when I was around those children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440144,
					"content": "But when no one was around, when they were helpless and afraid, they would say so, so many things to me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440145,
					"content": "...And I could not offer them a single word in reply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440146,
					"content": "If I had possessed but a little self-sacrificial courage to say something, anything to them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440147,
					"content": "Perhaps everything might have gone differently...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440148,
					"content": "So please, I beg you. I cannot face them as I am, so this is the only way I can honor them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440149,
					"content": "Please, good Traveler, lend me your aid just this once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440150,
					"content": "A single Sango Pearl is all I ask, to be laid before their tombs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440153,
					"content": "This way, you'll be able to light the Soul Lamps at the stone shrine here and open the way to the Soul Guide's Locus and bring their spirits peace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440151,
					"content": "Alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "Thank you. This task is in your hands, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440136,
					"content": "Why do you still want us to pay our respects to them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
		},
		{
			"id": 7224402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224409",
							"2"
						],
						"stepId": 7224409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440201,
					"content": "There were seven Sunchildren in all. Traveler, please take my place and pay respects before their tombs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224403,
			"completionStepIds": [
				7224410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224410",
							"2"
						],
						"stepId": 7224410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "Ah, the seven Soul Lamps are lit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440302,
					"content": "It seems that you have completed your task. I will always remember how you have aided me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440303,
					"content": "Now come, allow me to open it for you... The path to the Soul Guide's Locus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440304,
					"content": "Traveler from a foreign land, I know that I have caused you much trouble... But please, bear witness as they are laid to rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440305,
					"content": "Follow this path. I will meet you on its far side.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224404,
			"completionStepIds": [
				7224413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224413",
							"2"
						],
						"stepId": 7224413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "Ah, Traveler, you have arrived.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440402,
					"content": "This is the Soul Guide's Locus, and this is where my final thoughts remain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440403,
					"content": "When the Sunchildren reached a certain age, they would follow a ceremony and enter the Dainichi Mikoshi on their birth date.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440404,
					"content": "They would enter it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Yes, and that process was known as the Rite of Solar Return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440407,
					"content": "The Sunchildren were birthed from the Dainichi Mikoshi, and they would again return to the seat of the sun before the mortal world could taint them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440408,
					"content": "...The temperature of the Dainichi Mikoshi was such that its light could warm all of Byakuyakoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440409,
					"content": "Of the Sunchildren, naught but shreds of the souls that once were returned at last to the Locus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440410,
					"content": "But I still believe that, perhaps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440411,
					"content": "Perhaps...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "If I was the one who opened the Locus, I might be able to use my memories to supplement what remains of their souls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440426,
					"content": "Allow me to try.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440427,
					"content": "Piramumon... Orupeusu... I am here. Will you not return?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440429,
					"content": "How did it go?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "*sigh* Of the seven Sunchildren, Piramumon and Orupeusu were raised by mine own hand. If even they will not return...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440413,
					"content": "It seems that my memories alone are insufficient...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440414,
					"content": "If only there was something I could use as a medium... If I had the Divine Bridle, perhaps, the badge of the Sunchild's office, it might just work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440415,
					"content": "But alas! It was lost to us long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440416,
					"content": "*sigh* This nation, Byakuyakoku, still hates those children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440417,
					"content": "Perhaps my desire to free their souls is but a forlorn hope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440418,
					"content": "...But still, Traveler, if you would consider this my final request — could you help to find the Divine Bridle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440419,
					"content": "I know that the chances of finding it are quite slim, and indeed, it is rude of me to ask yet more of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440420,
					"content": "But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440421,
					"content": "I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "I... Thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440424,
					"content": "Still, the bridle has been lost for many long years. You need not rush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440425,
					"content": "If you should hear of it, please, tell me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440422,
					"content": "I'll do my best.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "Doesn't that mean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
		{
			"id": 7224405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
