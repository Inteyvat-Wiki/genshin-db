			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Castiglione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762060101,
					"content": "Kanou, why don't you stop scurrying about and finish that folding screen for now? You'd better figure out how you'll paint that waterfall first. For Egeria's sake, who on earth would use scattered perspective to paint a waterfall...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060102
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060102,
					"content": "...Hmm? Oh, my apologies. A new face, I see. I thought you were Kanou from the sound of your footsteps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060103
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060103,
					"content": "What are you doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762060104
					]
				},
				{
					"id": 762060104,
					"content": "Painting, as you can see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060105
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060105,
					"content": "But let's get one thing straight before you get the wrong idea: I may be skilled at painting animals, but the animals I paint are not meant for eating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060106
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060106,
					"content": "Wait, so you're saying we can eat your art!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762060107,
					"content": "The people I paint appear in the flesh, and so the beasts in my paintings may as well be on the plate... *sigh* That said, I do hope you won't be like that Miss Jinggui from Liyue, who keeps pestering me to paint nothing but fish fillets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060108
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060108,
					"content": "Art — venerable Art! Regardless of the era, its core purpose should be the salvation of the human soul and the cultivation of one's character. It should guide us toward a higher spiritual realm with Truth, Goodness, and Beauty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060109
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060109,
					"content": "For instance, when one stands atop the highest mountain peak, the view is naturally clear and true. Such is the art I strive for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060110
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060110,
					"content": "Hmm... I'm afraid you won't get a real sense of it. Words can only go so far. How about this — let me paint a floating platform for you. Go ahead and step onto it to experience my words for yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Castiglione"
				}
			]
		}
	]
}