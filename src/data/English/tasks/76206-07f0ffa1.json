	"talks": [
		{
			"id": 7620601,
			"completionStepIds": [
				7620601
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7620601",
							"2"
						],
						"stepId": 7620601,
						"stateName": "QUEST_STATE_UNFINISHED"
