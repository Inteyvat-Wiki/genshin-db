				{
					"id": 3890302,
					"content": "It's stuck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890303,
					"content": "Hey, check out that <color=#00E1FFFF>roof</color>. Is there a giant <color=#00E1FFFF>hole</color> in it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890304,
					"content": "Hmm... I suppose we could make use of that <color=#00E1FFFF>wind current</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890305,
					"content": "Let's make a detour then. Heading up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890306
					],
					"speakerTitle": "Paimon"
