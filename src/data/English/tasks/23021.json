			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "Yes! It worked out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "There are no structural problems with the hull... The waterline is stable, too. No tipping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "Look, Qishan, my design and calculations are immaculate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "Don't get carried away. We're just at phase one of the load test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210805,
					"content": "And you haven't even taken into account the center of gravity shift that will occur on the ship due to weather and cargo as it navigates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210806,
					"content": "Ugh... I'll consider those factors. But please, just let me enjoy this moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "Oh, Traveler, this is your payment. Please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Qishan, can't you just be happy for me once?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
					"content": "But being happy for you isn't going to help you build the ship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210810,
					"content": "Best you try to make your wallet happy instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
