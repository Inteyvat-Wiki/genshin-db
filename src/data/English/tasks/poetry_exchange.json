					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "So how did they take it? From the looks of it I'm guessing... it went well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031104,
					"content": "It went pretty well!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "So my understanding of the vocabulary was correct after all. Great news!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031106,
					"content": "Another step forward for the field of Hilichurlian Studies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031107,
					"content": "One day, I'll be able to converse freely with the hilichurls, and hear all the secrets they have to share right from their own mouths. When that day comes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031108,
					"content": "I'll finally be able to say that I have lived up to the Musk family name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031109,
					"content": "Oh, but before all that — this is for you. Thanks so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2010312,
			"completionStepIds": [
				2010315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010315",
							"2"
						],
						"stepId": 2010315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031201,
					"content": "How did it go? Did you recite my poetry to the hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031202,
					"content": "I did indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031203
					]
				},
				{
					"id": 201031203,
					"content": "So how did they take it? From the looks of it I'm guessing... uh, not so well...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031204,
					"content": "There was an issue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031205
					]
				},
				{
					"id": 201031205,
					"content": "Did you make sure to follow my notes? Or were even they wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031206,
					"content": "I'm... so sorry. It seems I'm not as proficient as I thought I was... Guess I need to study a bit harder. Thanks for the help anyway, and please take these for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031207,
					"content": "...I need to get a handle on this. I cannot let down the Musk family name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2010313,
			"completionStepIds": [],
