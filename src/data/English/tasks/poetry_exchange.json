	"talks": [
		{
			"id": 2010301,
			"completionStepIds": [
				2010301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010301",
							"2"
						],
						"stepId": 2010301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "Good to see you again! You remember me, right? ...Surely you at least remember our friendship-building with the hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Don't give me that look... This is the nature of learning a language. You have to practice, practice, practice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "Rest assured, your efforts were not wasted! My spoken Hilichurlian has improved by leaps and bounds since that day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "But I also had to get my written Hilichurlian up to scratch. So, after an intense period of research, I have now composed a series of original Hilichurlian poems!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "That said, there are still a few lines I'm not sure of. I need to check the meaning... Could you go and test them out for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "...\"Test them out\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "You know, like... Read them out to a hilichurl and see how they react!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "Don't worry! I've <color=#00E1FFFF>marked</color> the lines where I'm not quite sure of the meaning. And anyway, I'm sure I can't be too far off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "I've already got a place in mind. The hilichurls there look friendlier than most. Just read out the individual lines I've queried to them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "Thanks for your help! Come back here after you've read them the poetry, I want to know everything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "...Reading to hilichurls? Again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "That's right! You're experienced at it, after all. And don't worry, I've <color=#00E1FFFF>marked</color> the lines where I'm not quite sure of the meaning. I'm sure I can't be too far off though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "I've already got a place in mind. The hilichurls there look friendlier than most. Just read out the individual lines I've queried to them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "Thanks for your help! Come back here after you've read them the poetry, I want to know everything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "And, um, if it doesn't go quite as planned, I'm sure you'll have no trouble resolving the situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
