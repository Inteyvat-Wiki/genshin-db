			"dialogs": [
				{
					"id": 201031101,
					"content": "How did it go? Did you recite those lines to the hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031102,
					"content": "I did indeed.",
