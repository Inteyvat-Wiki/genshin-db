			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Kichiboushi\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780301,
					"content": "Mm... Very nice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780302,
					"content": "What's wrong, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780303,
					"content": "This is a grim city. Very sad, don't know why. Strange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780304,
					"content": "I feel the same way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "Next up, let's head into the center of this \"city\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780305,
					"content": "That's rather odd, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				}
			]
		},
		{
			"id": 7267804,
			"completionStepIds": [
				7267804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267804",
							"2"
						],
						"stepId": 7267804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780401,
					"content": "Mmmph! The wind... strong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780402,
					"content": "We can't pass through these storm-walls. We've got to go around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780403,
					"content": "Easy now, Kichiboushi, just follow us around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267805,
			"completionStepIds": [
				7267807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267807",
							"2"
						],
						"stepId": 7267807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780501,
					"content": "We're finally here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780502,
					"content": "The view's much better up here. Look over there — that's the spot where we came from!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780503,
					"content": "Paimon likes high spots, mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780504,
						726780505
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780504,
					"content": "You can see everything from these vantage points, and they are good for gliding, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780507
					]
				},
				{
					"id": 726780507,
					"content": "Does Storm-Storm sleep here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780508
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780508,
					"content": "Yup — for a really long time, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780509,
					"content": "#Even though {NICKNAME} fought Stormterror, he's not a bad dragon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780510,
					"content": "He just experienced something terrible, got hurt, and was tricked by bad people, so he thought that his friend, the Anemo Archon, no longer needed him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780511,
					"content": "Mm... Then what happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780512
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780512,
					"content": "#After that, huh? Do you remember, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780513,
					"content": "I purified his poisoned blood during our battle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780514
					]
				},
				{
					"id": 726780514,
					"content": "But the platform we were battling on collapsed. At first, it looked like we and the Anemo Archon were going to fall into a deep, dark place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780515,
					"content": "Eek! That's horrible... What did you do? Did you fly away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780516,
						726780519
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780516,
					"content": "Dvalin saved us, and he bore us away.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780517
					]
				},
				{
					"id": 726780517,
					"content": "Dva...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780518
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780518,
					"content": "That's Stormterror's name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780520,
					"content": "#Stormterror actually had a name of his own, just like Kichiboushi, Paimon, and {NICKNAME} — and his name is Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780521,
					"content": "At first, Dvalin was injured and tricked by some bad people, so he was very angry. That's why he attacked Mondstadt, and because everyone thought he was a bad dragon, they called him \"Stormterror.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780522,
					"content": "Later, we beat those bad people and helped the Anemo Archon purify the blood that was tainting him. That was when he realized that the archon hadn't abandoned him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780523,
					"content": "Ooh! So Storm-Storm became good again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780524
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780524,
					"content": "Exactly! And that's why Paimon brought you here for training today — it was to tell you the story of Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780525,
					"content": "When you grow older, you will also be misunderstood, get hurt, and experience sad things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780526,
					"content": "But you mustn't become a bad person. Because \"winds change their course\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780527,
					"content": "And someday, they will blow towards a brighter future...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780528
					]
				},
				{
					"id": 726780528,
					"content": "Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780529
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780529,
					"content": "Was that a bit tough to understand, Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780530
					]
				},
				{
					"id": 726780530,
					"content": "Understand, but also not really...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780531
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780531,
					"content": "#But Kichiboushi knows that it is something important. Will not forgetting what Paimon and {NICKNAME} say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780532
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780532,
					"content": "Hehe! Then at least our long storytelling session didn't go to waste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780533,
					"content": "But whatever the case, make sure you don't become too playful or cheeky — that might get you sealed sometime in the future!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780534,
						726780535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780534,
					"content": "Looks like this round of your training has drawn to a close.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780536,
					"content": "Mmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780537
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780537,
					"content": "There's no need to be so sad! Smile as we go back, or you'll make Ioroi sad, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780538,
					"content": "Alright then. Guess we've gotta do our jobs as guides one last time, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780539,
					"content": "Now then — time to bring Kichiboushi back to Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780540,
						726780541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780540,
					"content": "Let's move out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780542,
					"content": "Mm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780541,
					"content": "Let's go, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780542
					]
				},
				{
					"id": 726780535,
					"content": "Seems like we've completed Ioroi's commission.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780536
					]
				},
				{
					"id": 726780519,
					"content": "Stormterror saved us and bore us away from the battle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780520
					]
				},
				{
					"id": 726780505,
					"content": "You know what they say about \"idiots and smoke...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780506
					]
				},
				{
					"id": 726780506,
					"content": "That's not what this is about! You can see everything from up here, and the air is great, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267808,
