		{
			"id": 7267811,
			"completionStepIds": [
				7267811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267811",
							"2"
						],
						"stepId": 7267811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726790101,
					"content": "We're back, Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790102,
					"content": "Ooh, you've finally returned! How has Kichiboushi's training gone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790103,
					"content": "Squelch squelch, kapow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790104
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790104,
					"content": "Mmhahaha! Good, good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790105
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790105,
					"content": "Oh brother, we can't understand Kichiboushi anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790106,
					"content": "We even took a lot of photos. Have a look, Ioroi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790107,
					"content": "You show all the photos you took for Kichiboushi during this time to Ioroi.\\nYou also tell him about your adventures.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726790108
					]
				},
				{
					"id": 726790108,
					"content": "...And that's how we completed your request to \"take Kichiboushi to eight places to train,\" Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790109,
					"content": "Mm! Good, very good, as might be expected of humans I had mine eye on. If you were also tanuki, you would be great and renowned indeed. Perhaps half as great as I when put together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790110
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790110,
					"content": "(That's not super impressive...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790111,
					"content": "But since we've completed the task, we should probably leave now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790112,
					"content": "Mmmph...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790113,
					"content": "Oh, don't be like that. Come on, Kichiboushi, Paimon's gonna teach you one more thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790114,
					"content": "When you say goodbye to friends, you should see them off with a smile! That way, you'll be even happier when you meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790115,
					"content": "...Mm? Alright. Sure. Leave it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790116
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790116,
					"content": "Kichiboushi says, \"Got it, White Fur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790117,
					"content": "Eh? Does this mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790118,
						726790119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790118,
					"content": "Kichiboushi's lost his ability to speak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				},
				{
					"id": 726790120,
					"content": "It has been some time. The effects of the tanuki meal must have worn off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790121,
					"content": "Hmph! If I were free from this stone seal, it would be a thing of ease to have you understand tanuki speech all the time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790122
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790122,
					"content": "...Hmm? Of course, I will pass it on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790123
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790123,
					"content": "\"Kichiboushi train hard.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790124,
					"content": "\"Become strong bake-danuki, like Ioroi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790125
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790125,
					"content": "Mm? Hahaha! That's quite the boast, you little rascal. Reminds me of myself when I was your age!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790126
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790126,
					"content": "\"Then White Fur and Yellow Fur no eat bake-danuki food, understand Kichiboushi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790127,
					"content": "We'll be waiting, Kichiboushi! We'll come train with you next time, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726790128,
					"content": "Good luck, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790129
					]
				},
				{
					"id": 726790129,
					"content": "Don't get sealed by humans, now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790130
					]
				},
				{
					"id": 726790130,
					"content": "Mm!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790131,
					"content": "Mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790132
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726790132,
					"content": "Eh, forget it. I shall not pursue the matter, considering that you did take Kichiboushi out to train.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790133,
					"content": "Ah, yes. There was once this fellow called Utamarou who painted the tanuki sealed in Chinju Forest and left some drafts behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790134,
					"content": "You can have it, to look upon whenever you wish to remember the handsome forms of the tanuki race!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790135,
					"content": "*sigh* If only you, too, were tanuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726790136
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790136,
					"content": "Wouldn't we have been turned into stone already, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790137
					]
				},
				{
					"id": 726790137,
					"content": "Mmph, true. Well then, off you go now. I have a little magic to teach Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726790119,
					"content": "We've lost the ability to understand Kichiboushi's speech?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726790120
					]
				}
			]
		}
	]
}