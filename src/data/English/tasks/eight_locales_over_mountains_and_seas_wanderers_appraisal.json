			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726780101,
					"content": "This city is very big, but... feels grim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780102,
					"content": "We came here before with a lot of companions, and we fought a battle against Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780103,
					"content": "Is Stormterror a large, sharp-tooth, scary dragon with flip-flap wings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780104,
						726780105
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780104,
					"content": "Well, he wasn't that scary.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				},
				{
					"id": 726780106,
					"content": "Do you still remember that Anemo Archon statue we saw in Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780107,
					"content": "Anemo Archon Statue...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780108
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780108,
					"content": "That big, tall stone statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780109,
					"content": "Mm! Yes! Anemo Archon had big hands!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780110
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780110,
					"content": "Stormterror is the archon's good friend! Long ago, the Anemo Archon was from this city, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780111,
					"content": "Ooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780112
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780112,
					"content": "But if Storm-Storm is so big, how does he get in here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780113,
						726780114
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780113,
					"content": "You know, this question feels familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780115,
					"content": "Paimon knows this one! That's because he doesn't walk in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780116,
					"content": "Ooh, Kichiboushi knows. Storm-Storm can fly. Does not need walking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780117
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780117,
					"content": "A—Argh! How...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780118,
					"content": "Mm? Paimon, you seem a little unhappiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780119
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780119,
					"content": "Eh... We can talk about that later. First off, let's take a photo! Alright, stand still now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726780120,
					"content": "Kichiboushi stand straight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726780114,
					"content": "It's \"Stormterror.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780115
					]
				},
				{
					"id": 726780105,
					"content": "He was quite lovely, actually.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780106
					]
				}
			]
		},
		{
			"id": 7267803,
