			},
			"dialogs": [
				{
					"id": 760370101,
					"content": "Details on all four targets are up on the board. I can fill you in if needed, but don't bother haggling over the bounties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Submit proof that the bounties have been dealt with.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "About the bounty targets...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "There are four targets at the moment, but only three of them have leads. The first one's Hidimbi, a fortune teller from Sumeru who's wanted for fraud. You can often find her around <color=#00E1FFFF>the southern docks</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "Then there's a rampaging Inazuman Kairagi who's claimed the lives of several traveling merchants passing through the <color=#00E1FFFF>Nothing Passage</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "Next up's a gang of smugglers who deal in dangerous goods. They're reportedly hiding out at <color=#00E1FFFF>a camp on the beach north of town</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "Finally, there's the vicious pirate known as Hark the Crackjaw. There are no leads on him right now — he's likely gone into hiding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "See you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Bye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
