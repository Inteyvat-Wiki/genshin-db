			"dialogs": [
				{
					"id": 760370301,
					"content": "(About Hidimbi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370302
					]
				},
				{
					"id": 760370302,
					"content": "\"Bounty Target: Hidimbi, a fortune teller from Sumeru. Female, age unknown. Wanted for: Suspected of laying curses and high-value fraud.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370303
					],
					"speakerTitle": "Bounty"
				},
				{
					"id": 760370303,
					"content": "\"That woman swindled me out of 18,000,000 Mora! She said that if I wore the necklace she claimed to have acquired from Al-Ahmar, the God of Love, the ladies would fall for me at first sight!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370304
					],
					"speakerTitle": "Bounty"
				},
				{
					"id": 760370304,
					"content": "\"Turns out Al-Ahmar wasn't the God of Love at all. He's been dead for thousands of years, and he never even managed to win over the girl he loved.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370305
					],
					"speakerTitle": "Bounty"
				},
				{
					"id": 760370305,
					"content": "\"So the necklace she sold me was real, alright, but it cursed me to never find love. Anyone who can track her down and lift the curse will be handsomely rewarded.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bounty"
				}
			]
		},
