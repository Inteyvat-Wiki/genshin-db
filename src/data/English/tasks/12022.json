			"dialogs": [
				{
					"id": 120220501,
					"content": "Whoa... Look at all these petitions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220502,
					"content": "So does Kokomi make time to deal with these even when she's resting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220503,
					"content": "\"Sangonomiya Events Cash Flow Statement,\" \"Consolidated Annual Report on Fishing Production,\" \"Watatsumi Island Monthly Maintenance Expenses Breakdown\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220504,
					"content": "This is a lot of work for one person. And it's on top of all the directives she has to write and the people she has to meet day-to-day. It's no wonder she gets burnt out from time to time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220505,
					"content": "Let's track down that book and help her feel like herself again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
