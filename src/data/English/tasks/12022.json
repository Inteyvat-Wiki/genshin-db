			"dialogs": [
				{
					"id": 120220401,
					"content": "Kokomi, is this the book you wanted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220402,
					"content": "Hmm, I'm not sure, actually... Could you read a bit out loud?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220403,
						120220404
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220403,
					"content": "\"Act to the plan, and plan to the situation\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				},
				{
					"id": 120220405,
					"content": "*yawns* Yes, that's the one! Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220406,
					"content": "Kokomi? Kokomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220407,
					"content": "#Oh no, she's fallen asleep. What're we gonna do, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220408,
					"content": "Tonight's the Victory Feast! Not to mention that the peace talks are just around the corner. She's got so much to do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220409,
						120220421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220409,
					"content": "Let's let her rest a while.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220410
					]
				},
				{
					"id": 120220410,
					"content": "You sure that's a good idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220411,
					"content": "Hmm, she does look pretty exhausted. Guess there's still some time to go, too. Alright, let's keep her company while she rests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220412,
					"content": "Avoid disaster... Protect peace at all costs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220413,
					"content": "The war's over... Things are slowly getting better...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220414,
					"content": "Did you see...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220415,
					"content": "Uhhhh... Huh? What time is it? Did I fall asleep?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220416,
					"content": "Yup, you've been out for ages! It's nearly time for the feast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220417,
					"content": "I can't believe it got so late!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220418,
					"content": "*sigh* I haven't slept that peacefully in so long. That's gotta be three whole energy points right there. Should be enough to see me through the peace talks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220419,
					"content": "#Thank you, {NICKNAME}. Well, we better get ourselves over there, it's nearly time to light the bonfire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220420
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220420,
					"content": "Woohoo, Kokomi's back to full energy! Good to have you back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220421,
					"content": "Let's wake her up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220422
					]
				},
				{
					"id": 120220422,
					"content": "We probably should, after all, she did say she wanted to wrap everything up before the feast kicks off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220423,
					"content": "Kokomi, wakey-wakey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220424,
					"content": "Hmmmm...? Was I asleep? ...What time is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220425
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220425,
					"content": "Time to get going! It's nearly time for the feast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220426,
					"content": "Really? It's that time already? Ughhhh... I still don't feel like I'm fully recharged.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220427,
					"content": "I'll buy you a new book on military strategy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220428
					]
				},
				{
					"id": 120220428,
					"content": "Really? Yes! I want the latest volume of the Teyvat Art of War!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220429
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220429,
					"content": "The Yae Publishing House published it last month, but I haven't had the chance to get my hands on it... No backing out now, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220430
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220430,
					"content": "Huh, that really perked her up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220431,
					"content": "Alright, let's get to the feast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220404,
					"content": "\"Attack where the enemy is weak, emerge where the enemy is blind\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				}
			]
		},
