						120220602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220602,
					"content": "Look, there's even a bookmark. None of the other books have one, so she must have finished reading those already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220603
					],
					"speakerTitle": "Paimon"
				},
				{
