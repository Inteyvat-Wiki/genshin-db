			"dialogs": [
				{
					"id": 120220301,
					"content": "#Hey, look, {NICKNAME}. Could this be the book she wanted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220302,
					"content": "\"Swordfish captain came back today. Energy +4...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220303,
					"content": "Ah, that's... that's just, um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220304,
						120220305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220304,
					"content": "We saw nothing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
				},
				{
					"id": 120220306,
					"content": "Give. It. Here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220307,
					"content": "Eh-heh, guess that was the wrong one... Let's keep looking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220305,
					"content": "(And if we did, it was all Paimon's fault.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
				}
			]
		},
		{
			"id": 1202204,
