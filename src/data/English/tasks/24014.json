				},
				{
					"id": 240140202,
					"content": "I need to put the fry out into deeper waters... Ugh, why did my divesuit have to give out now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140203
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140203,
					"content": "What are you up to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140204
					]
				},
				{
					"id": 240140204,
					"content": "Hello there. Pleased to meet you. I'm Linorea, a journalist specializing in reporting on environmental issues. I'm... putting fish fry into these waters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140205
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140205,
					"content": "Wait, you look familiar. Weren't you with Semaine when we last saw him, Linorea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140206,
					"content": "You must be Semaine's...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140207
					]
				},
				{
					"id": 240140207,
					"content": "Wait, you know Semaine? Are you... Oh, were you the ones who helped him bring those gifts? Thank you so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140208
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140208,
					"content": "Semaine only told me about that after I'd finished watching the opera and returned home previously. Honestly, I've been looking to invite you for a meal at my place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140209
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140209,
					"content": "I didn't think I would meet you here... but this is really bad timing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140210
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140210,
					"content": "You just said that you're throwing fry into the water, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140211,
					"content": "And why are you doing that, exactly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140212
					]
				},
				{
					"id": 240140212,
					"content": "Do you know about Mekafish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140213,
						240140214
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140213,
					"content": "Never heard of them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140214,
					"content": "Are they a species unique to the Court of Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
