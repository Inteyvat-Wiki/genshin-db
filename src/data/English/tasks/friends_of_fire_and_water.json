					"nextDialogs": [
						751080510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080510,
					"content": "There wasn't even a plate of food around... Perhaps they've been locked up so long that they're starving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080511,
					"content": "#If that's so, let's make something for the Blubberbeast and {REALNAME[ID(2)|SHOWHOST(true)]} to eat!",
