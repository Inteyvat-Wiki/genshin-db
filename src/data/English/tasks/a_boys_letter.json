						"stepId": 2010206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020701,
					"content": "You're back? Did you deliver the letter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020702
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020702,
					"content": "Timmie wants you to send this letter to his daddy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "Timmie's still writing letters to his father... I assume you heard the whole story from Grace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020704,
					"content": "I... I can't send this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020705,
					"content": "Okay... just don't send it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "Well, yes... As much as I'd like to, I simply can't.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020707,
					"content": "There's nothing I can do. I suppose I'll just hold onto it for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020717,
					"content": "Anyway, enough about that. I will keep the letter. Please consider it sent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020718,
					"content": "He would understand... My dear old friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020719,
					"content": "Thanks for your help and please, please don't tell Timmie about this. I can trust you with that, right? ...Considering, here's your payment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020708,
					"content": "Burn it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "Hahaha... That's the adventurer in you talking! Decisive and efficient in all things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020710,
					"content": "I'm no adventurer myself. Just a plain old hunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020711,
					"content": "I'm not going to burn this, or even open it. I'm just going to hold onto it for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020712,
					"content": "Let me keep it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "What for? Surely you don't think my old friend might still be alive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020714,
					"content": "...Somewhere, out there, just waiting to be found...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020715,
					"content": "Yes, I used to wonder the same thing myself. Even put it to the test, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020716,
					"content": "In the end I just had to accept the facts — my best friend is gone forever, never to return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010208,
