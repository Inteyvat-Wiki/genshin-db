					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020801,
					"content": "...Lord Barbatos, if you've been watching...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020802
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020802,
					"content": "...Please tell me what I'm supposed to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 2010209,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010206",
							"2"
						],
						"stepId": 2010206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020901,
					"content": "Remember, give it to Mr. Draff in Springvale. Don't give it to the wrong person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020902
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020902,
					"content": "Mommy says Daddy and him are best friends. He's sure to know how to get this letter to Daddy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020903
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020903,
					"content": "But... Mommy also says that Mr. Draff and Daddy are both very busy in their work... Hmm, I wonder if I'll be busy like them when I grow up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020904
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020904,
					"content": "Ah, it doesn't matter — as long as I get to help Daddy, I don't mind if it's busy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		}
	]
