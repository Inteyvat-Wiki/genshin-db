				"points": []
			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "As a descendant of the illustrious Lawrence Clan, I learned many skills during my journey, for example... baking flatbread!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Good, this should be just the right amount of heat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "I had no idea you knew how to bake... I thought you'd be the type who'd never get anywhere near the kitchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Ah, I've been meaning to ask you... Do you have time later? Could you teach me how to make those delectable snacks of yours?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "Oh? But that might take some time. Besides, we're not here to get to know each other as family.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "So again you're worried about our ties within the Lawrence family, fine... But you said yourself that we're just ordinary people, so why don't we learn from each other like regular cousins would?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
		{
			"id": 4011810,
			"completionStepIds": [],
