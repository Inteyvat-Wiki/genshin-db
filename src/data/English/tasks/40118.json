					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "I wanna ride the Choo-Choo Cart with Miss General! Up, up, up, and... WEEEE!!! But uh, I guess the ride makes her a little dizzy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Ah, so you noticed? Very good. Was it the stars spinning in her dazed eyes that gave it away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Mm-hmm, yesterday she said she had lots of little golden stars floating around her. But she seems to be doing a lot better today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "If Mom were here, she'd probably say the stars are all fish that fell into the clouds!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 4011811,
			"completionStepIds": [],
