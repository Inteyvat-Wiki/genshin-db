				"points": []
			},
			"dialogs": [
				{
					"id": 401181101,
					"content": "This is the first time I've had tea that tastes like this. It seems Inazuman tea is a lot different from what we have in Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401181102,
					"content": "Ah yes, it seems people in Sumeru like to put spices in their tea, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401181103,
					"content": "Yes, that's right! But I still can't get used to it... If I had to pick, I'd drink coffee, even though it gives me insomnia sometimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
