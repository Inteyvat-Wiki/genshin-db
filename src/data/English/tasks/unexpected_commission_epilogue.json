			},
			"dialogs": [
				{
					"id": 706900301,
					"content": "Oh? You finished sorting already? That went much faster then I expected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900302,
					"content": "Now then, what would you like in return, cutie? You freed up my whole afternoon, helping me with that. How about we spend it together?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900303,
					"content": "I'd like to be paid...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "Oh, that's all? Well, don't worry. I won't forget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900306,
					"content": "Ah, so you noticed, too. Such strange names, and even stranger contents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900307,
					"content": "Not to mention, this is the largest library in northern Teyvat, and I didn't recognize a single title on the list. I just don't see how that's possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900308,
					"content": "Unless...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900309,
					"content": "Actually, we just ran into—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706900310,
					"content": "Trouble, I presume? I think I'll steer clear, if it's all the same to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900311,
					"content": "Besides, if a book exists in this world, then there's a place for them in this library.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900312,
					"content": "Better for them to remain here than end up in the hands of someone more... suspect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900313,
					"content": "Anyway, here's your payment. Thanks again for all the help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900305,
					"content": "I'd like to ask about these books...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
}