			},
			"dialogs": [
				{
					"id": 761230101,
					"content": "That smells great! Did we make it in time for Columbina's mealtime again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Huh. Are those kuuhenki... lining up? For soup that Columbina's serving?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Just a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "Wow, this is really good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Refreshing, tasty fruit soup — Paimon's never had anything quite like it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "Another serving?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230108,
					"content": "Make that two!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "Are you learning to cook?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Yes. I asked Ineffa for some basic recipes, and have made several attempts. The kuuhenki and animals have both responded quite positively.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230112,
					"content": "Having any issues in the kitchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Well... My sleeves are too wide. They brush against the pot if I'm not careful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230114,
					"content": "(So, it's not the cooking itself that's giving you trouble.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "I struggle somewhat with making desserts, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230116,
					"content": "You have to get the temperature and proportions just right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230117,
					"content": "(She must not have cooked much for herself in the past, then.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(Besides, desserts and snacks are particularly hard to get right if you're working solo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Would you like me to help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Sure. Let's start with krumkake, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230121,
					"content": "Some time later...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Would you like to try one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230123,
					"content": "(Take a nibble.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230126,
					"content": "(Oh wow, that first bite probably soured my face into a prune...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(But after you swallow some, the sweetness resurfaces... Maybe it gets better once you get used to it...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230129,
					"content": "Passable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Did Paimon miss anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Try this real quick, would you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "Gaaaah, it's so sour! Wh—What are you trying to do to Paimon!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230136,
					"content": "The aftertaste is pretty good, though.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "It's all about the initial taste! Couldn't one of you have warned me to take a smaller bite!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "If you hadn't said anything, Paimon would've thought this was a prank! Watching people's faces pucker or something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "Okay. Let me try again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230140,
					"content": "More time passes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Here. Try this batch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230142,
					"content": "(Whoa...! This is way better!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "It's delicious!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Really? Paimon wants some too! ...Mmm! That's the stuff! Sooo tasty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "Good enough to be given as a gift?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230147,
					"content": "Totally! Wait, did you learn how to cook and make krumkake because you wanted to make a present for someone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Yes... For my friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230149,
					"content": "That's a great idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "Do you still remember the first time you came here together? You had prepared some food for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230151,
					"content": "Though the food couldn't do much to replenish the power I had lost, eating it did make me feel more relaxed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230152,
					"content": "I did not give it much thought then, but now I understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230153,
					"content": "The time and effort put into carefully preparing food by hand is what gives it soul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230154,
					"content": "What I enjoyed was not simply the food itself, but the warmth and kindness in the hands that made it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230155,
					"content": "And the less those hands seek reciprocity, the greater the warmth and kindness required to match it in turn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230156,
					"content": "Awww, Paimon's gonna blush if you go on like that... To be honest, we were at least kinda hoping to get on your good side back there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "But things are different now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "Indeed. But now that I understand all this, I'd like to do a little more... It's a wonderful feeling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230160,
					"content": "Would you come with me to visit our friends?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230161,
					"content": "Apart from the krumkake, I have also prepared a few other gifts. Ah, but they must be sent in secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230162,
					"content": "Why \"in secret,\" if you don't mind Paimon asking?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "Well, you've always been the ones to \"pleasantly surprise\" me. I'd like to see how my friends will react when the tables are turned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230164,
					"content": "Phew. We were running all over! Finally done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "Their reactions were kind of surprising, though. Some didn't even realize they were gifts from you, Columbina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "Aino just got straight to snacking...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "It's fine. I expected as much. What's important is that they were happy to receive the gifts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230168,
					"content": "In that case, Lauma definitely knew the krumkakes and wreath on her desk came from you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "Paimon can understand her being hesitant about wearing the wreath, but seriously, she stared at the krumkakes for a good ten minutes and still couldn't bring herself to eat one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "I was getting worried that she might enshrine them...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "It seems Jahoda got quite the fright, though... Perhaps we shouldn't have slipped the gifts directly behind her...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230172,
					"content": "She almost jumped out of her skin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Maybe she's just naturally more alert? Still, she seemed to calm down when Ashru came over to paw at the scratching post you sent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "As for our other friends who aren't in Nod-Krai, I'm counting on you to deliver their gifts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230175,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "Longplume Ibis"
				},
				{
					"id": 761230176,
					"content": "I must say, you're quite good at preparing presents.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "Here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761230178,
					"content": "Ooh! Is it finally our turn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230179,
					"content": "Huh? Candies? Paimon thought we'd get krumkakes like everyone else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230180,
					"content": "Well, you already had some of those while taste-testing. Some variety is nice, don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
