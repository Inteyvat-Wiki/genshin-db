					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121101,
					"content": "Time and wind... Just what did he find?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "Time and wind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Oh, that's something that my friend mentioned in the very last letter that he sent me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "He said that \"time and wind\" hide one of Mondstadt's secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "However, I've never heard that phrase before, and I'm from around these parts. Who knows where he heard that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "You studied in Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "I did. Though I'm from Mondstadt, I've always been studying at the Sumeru Akademiya. I've probably spent more time there than I have in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "You want to know what happens in there? Well, it's not a secret, so... Hmm, how should I put it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "They're a bunch of weird people. Hmm, perhaps that's too disrespectful... I guess they're \"people who make quite the impression?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "If you ever have the chance to go, you'll see what I mean. But just stick to having a look. You don't want to stay too long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
