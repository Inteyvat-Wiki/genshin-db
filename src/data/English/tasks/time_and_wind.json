				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "\"Stories brought on the wind will bloom into legends in due time.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "Ravaged Carving"
				},
				{
					"id": 710120202,
					"content": "This must be the sundial mentioned in the notebook!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120203,
					"content": "Paimon doesn't get what's special about it, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120204,
					"content": "Maybe we should read that notebook a bit more carefully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "Hmm? Did you have some business here, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121002,
					"content": "About the Eye of the Storm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "An Eye of the Storm? I've been in this area this entire time, and I've never seen such a thing, except for that sudden huge gust wind earlier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121004,
					"content": "But I'm sure that it wasn't an Eye of the Storm. I would recognize one of those things anywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121005,
					"content": "Alright then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "Believe me, I wouldn't be able to forget something like that coming to interrupt my research even if I tried.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121009,
					"content": "To be precise, I'm doing research together with a friend of mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121010,
					"content": "He's also a scholar, and we went to Sumeru Akademiya together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121011,
					"content": "He became an archaeologist thereafter, traveling the world and doing surveys, while I continued my studies in the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121012,
					"content": "When he came to Mondstadt, he told me excitedly that he was surveying the Thousand Winds Temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121013,
					"content": "He even said something like: \"Once I've uncovered the secrets of your homeland, you're the first person I'll tell.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121014,
					"content": "I didn't hear from him afterwards. I asked someone to send Cyrus a letter, requesting that the Adventurers' Guild help me look for my friend's whereabouts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121015,
					"content": "But there was no news of him at all, and so I discontinued my studies and hurried back here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121016,
					"content": "But there's nothing here but a sundial, and there are no other clues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121017,
					"content": "Well, there's a sundial on that island...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "What? There's another sundial elsewhere that's identical to this one, and it's on an island?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121019,
					"content": "Oh, yes! Now I remember. I've actually seen that island sometimes, when the weather's clear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121020,
					"content": "Wait... You said that you found a notebook next to the sundial? Had my friend perhaps been there...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121021,
					"content": "Thank you. If I have the chance, I will head to that island to have a look. For now, however, I still have to figure this place out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121022,
					"content": "I must continue my research. If you're interested, you can have a look at my research notes. I've left them over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121023,
					"content": "Who knows? Perhaps there's something in there that might help you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121007,
					"content": "What are you up to here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121008
					]
				},
				{
					"id": 710121008,
					"content": "Me? I'm doing a bit of research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				}
			]
		},
