			"dialogs": [
				{
					"id": 710122401,
					"content": "Where did this thing come from? It wasn't here before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122402
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122402,
					"content": "How did you summon it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122403
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122403,
					"content": "Well...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710122404
					]
				},
				{
					"id": 710122404,
					"content": "Ah, so that's \"time and wind...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122405
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122405,
					"content": "So, there's another sundial exactly like this one on the island, am I right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122406
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122406,
					"content": "And the method to solve its riddle is the same? Then there must be some link between these two sundials, and the two places they are located in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122407
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122407,
					"content": "I must find a way to get to that island, and quickly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122408
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122408,
					"content": "Thank you, Traveler. Once I've made some preparations, I will look for you, and we shall visit that uninhabited island together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
