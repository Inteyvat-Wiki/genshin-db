			"dialogs": [
				{
					"id": 710120101,
					"content": "\"Stories brought on the wind will bloom into legends in due time.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "Ravaged Carving"
				},
				{
					"id": 710120102,
					"content": "What does this even mean? ...Paimon has no idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120103,
					"content": "Still, this place looks like it hides some secret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120104,
					"content": "Let's check this area out. We might find some clues!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
