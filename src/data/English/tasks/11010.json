	"talks": [
		{
			"id": 1101001,
			"completionStepIds": [
				1101001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101001",
							"2"
						],
						"stepId": 1101001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daipai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "Be on your guard, Traveler. Now is no time for sightseeing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100102,
					"content": "Oh, why's that? Has something happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100103,
					"content": "Yes. As unusual as this may sound, numerous eyewitness reports have confirmed an active Ruin Guard presence in this area, even though this is far beyond their normal area of activity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100104,
					"content": "Sergeant sent someone to find out just where these ancient machines might have come from. It appears that they simply left their ruin and marched off all of a sudden, for no clear reason.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100105,
					"content": "So did somebody wake them up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100106,
					"content": "As I say, the reason is still unclear. We have very little intelligence at present.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100107,
					"content": "Moreover... The ruin in question is of the especially spooky variety. Strange noises are often heard coming from within...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100108,
					"content": "As such, we are not permitted to investigate until the order comes through from headquarters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100109,
					"content": "One can never be too cautious.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "In any case, the only sensible strategy in the meantime is to increase Millelith patrols. We must not let innocent civilians come to harm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100114,
					"content": "That's a good point... Ruin Guards are probably pretty dangerous for regular folk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100115,
					"content": "Is there any way I can help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "Wow, uh... I'm very grateful indeed for the offer, but... it just wouldn't be worth the risk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100117,
					"content": "#Oh, don't worry about that! {NICKNAME} here, {M#he}{F#she} beats up Ruin Guards for breakfast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100118,
					"content": "I do know a little self-defense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "Is that so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100122,
					"content": "Well, if you're genuinely offering...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100123,
					"content": "I did see some Ruin Guard footprints on the <color=#00E1FFFF>hillside</color>, but since then I've been too busy warning passers-by to investigate myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100124,
					"content": "Footprints, eh? Interesting... We'll take the case!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100125,
					"content": "While the Millelith stands guard, evil shall never prevail! On behalf of the Millelith, I salute you, Traveler. You have my gratitude. I will rendezvous with you once I have finished my patrol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100120,
					"content": "Not to brag, but I could beat ten of you in a fight.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "Ahaha, the self-confidence of young people is an extraordinary thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100110,
					"content": "The Millelith... Always so inefficient.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "Sorry? Did you say something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100112,
					"content": "...Was that supposed to be your impression of Master Diluc talking about the Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "Hey, you! Check this out, isn't it awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100202,
					"content": "...What is he wearing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100203,
					"content": "I've never seen one this close before! Have you ever seen one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100204,
					"content": "Yes, it's a powered-down Ruin Guard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "Um, excuse me? His name is Mr. Cyclops, actually! What sorta dumb name is \"Ruin Guard\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100208,
					"content": "\"Mr. Cyclops\"? Aw, that's cute... Wait, what? Do people seriously call them that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100209,
					"content": "Yep! My brother said so. And he's the best toy seller in the whole world! It's his job to sell this kinda stuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100210,
					"content": "Right now he's at the Institute for Toy Research in Liyue. That's where Mr. Cyclopses come from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100211,
					"content": "It's always nice to meet someone else who likes toys. So tell me, where'd you get your toy from? Must be a pretty new kind, I've never seen one that can fly and talk before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100212,
					"content": "Paimon is not a toy, neither are Ruin Guards...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "Yeah, Paimon is not a toy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100216,
					"content": "Greetings, have you found anythi— Oh, a child...? Wh—What's the situation here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100217,
					"content": "We just, y'know, found him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100218,
					"content": "Uh-uh, you shouldn't be out here, boy. There are killing machines in the area, it's extremely dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100219,
					"content": "\"Killing machines\"? You mean... ones that look like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100220,
					"content": "Precisely, and including this one. It's not moving now, but if it were to wake up, the consequences would be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100221,
					"content": "You take that back! Mr. Cyclops is not a killing machine, he's one of the good guys!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100222,
					"content": "Um... \"Mr. Cyclops\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100223,
					"content": "We shouldn't be talking to this guy. If he's saying mean things about Mr. Cyclops, he's definitely a bad man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100224,
					"content": "I—I'm just trying to help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100225,
					"content": "I think you've lost him...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "Ugh, I've always been hopeless at dealing with children...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100228,
					"content": "Well then, why don't you get back to your normal job and leave us to do the babysitting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100229,
					"content": "It seems I have no other choice... Very well, I will continue with my patrol. Please escort the child to somewhere safe, it's much too dangerous here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100230,
					"content": "Hahahaha, the mighty Mr. Cyclops scared off the bad guys once again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100231,
					"content": "What's your name, kid?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "My name's Teucer! I came all the way from Snezhnaya to look for my brother in Liyue. But I'm all on my own, and I don't know where to find him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100234,
					"content": "You came all the way from Snezhnaya!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100235,
					"content": "Oh, I think this is the part where I give you this... Here you go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100236,
					"content": "What is it? Looks heavy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100237,
					"content": "What the!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100238,
					"content": "So much Mora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "My brother said I should take it with me. He said, \"Find a nice person to give this to, and they will take good care of Teucer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100241,
					"content": "Your brother makes a good point... Still, it's hard to believe you made it all this way armed with nothing but a few bags of Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100242,
					"content": "Your family must be super rich! Paimon never knew you could make so much Mora from selling toys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100243,
					"content": "I will gladly take it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "#Yay! Thanks, nice {M#guy}{F#lady}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100246,
					"content": "Alright, now we gotta make a pinkie promise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100247,
					"content": "You make a pinkie promise, you keep it all your life. You break a pinkie promise, I throw you on the ice. The cold will kill the pinkie that once betrayed your friend, the frost will freeze your tongue off so you never lie again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100248,
					"content": "Wow... That one nursery rhyme kinda says all you need to know about Snezhnayan culture...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100249,
					"content": "Well, if we weren't your babysitters before, we sure as heck are now! ...But where should we look for your brother?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100250,
					"content": "Somewhere with close connections to Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "Snezhnaya... Ooh, how about the <color=#00E1FFFF>Northland Bank</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100254,
					"content": "Alright! Finally, now I get to see my brother!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100252,
					"content": "<color=#00E1FFFF>Northland Bank</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "Great idea. Alright, off we go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100244,
					"content": "I will gladly take it! (And give it to your brother when we find him...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "So, so, so much Mora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "Where are your family?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "Maybe let me handle this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "Limited edition. Jealous much?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "Hey! Just 'cause you get to play with Paimon all the time does not mean that Paimon's a toy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100206,
					"content": "Careful kid, these guys are tough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "You bet! Mr. Cyclopses are crazy strong! No bad guys can escape from these guys, that's for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101003,
			"completionStepIds": [
				1101006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101006",
							"2"
						],
						"stepId": 1101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "That seems a little inappropriate, don't you think, sir? How can you—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100302,
					"content": "Relax, once in a while can't hurt. It'll be fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100303,
					"content": "Huh? What's he doing here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100304,
					"content": "Yay, my brother! I found you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100305,
					"content": "I know that voice... Why, if it isn't my little brother, Teucer! My goodness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100306,
					"content": "Haha... What a nice surprise, Teucer! I thought I would have to wait till I return home before seeing you again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100307,
					"content": "How are the others — sister Tonia and brother Anthon? Is everybody keeping well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100308,
					"content": "They miss you a lot! Tonia prays for you every day at dinner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100309,
					"content": "...Wait a second, what are you doing here in Liyue, Teucer? How have I not heard anything about this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100310,
					"content": "Well... what happened was... I saw a boat that looked like it was selling toys, so obviously I thought you were on board...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100311,
					"content": "And then when I got off I just kept walking and walking... and then, I found a Mr. Cyclops!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100312,
					"content": "#Mr. Cyclops scared off a bad guy, and then I found this nice {M#guy}{F#lady} to help me come look for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100313,
					"content": "So Teucer's a stowaway!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "And also... Teucer is Childe's brother!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100316,
					"content": "Cool! Suddenly, Paimon doesn't feel so bad about taking Teucer's money!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100317,
					"content": "Teucer, what you did was extremely dangerous... I'm so happy to see you, really I am, but please... Promise me you won't do anything like this ever again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100318,
					"content": "Okay, I promise... Please don't be mad at me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100319,
					"content": "I'm not mad at you. I just care about your safety, that's all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100320,
					"content": "If you hadn't met these nice people, things could have been a lot more dangerous for you, Teucer. I hope you said a big thank-you to them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100321,
					"content": "Yep! I always remember my pleases and thank-yous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100322,
					"content": "Oh, so you did notice we were here, you were just ignoring us. Gotcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100323,
					"content": "Hahaha, forgive me, it's always family first where I'm from. Don't take it personally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100324,
					"content": "I know we've had our differences up to now, but... a few minor quibbles aside, we get on quite well, don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100325,
					"content": "Do you mean that, or are you just keeping up appearances?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "Heh... Come on, you know I'm just a pawn in all of that. Just doing my part. As for who wins, who loses, and how each side deals with the consequences... I prefer to leave all that up to the ones playing the game.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100328,
					"content": "I'm much more interested in who wins and who loses when it comes to our little sparring matches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100329,
					"content": "Hmm... Sounds like you're ready to get your butt kicked again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100330,
					"content": "Hah! You're forgetting something about me — I, Tartaglia, spend every second getting stronger. Don't expect to have it quite so easy next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100331,
					"content": "I've also come a long way since then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "Whoa, whoa, whoa, you aren't gonna fight now are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100334,
					"content": "Hahaha... Maybe not right now. Not while my kid brother is watching.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100335,
					"content": "#Why do you wanna fight the nice {M#guy}{F#lady}? Are you guys enemies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100336,
					"content": "#No, not at all! {NICKNAME}, allow me to formally express my sincerest gratitude for taking care of my darling brother. His safety matters very much to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100337,
					"content": "I'm still keeping my eye on you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "...Um, so anyway, Paimon has a question...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100340,
					"content": "Teucer said something about you being a toy seller... What's all that about? Aren't you supposed to be one of the Fatui's Harb—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100341,
					"content": "Ahem! Um... Yes, about that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100342,
					"content": "Shh, look, I only told him that so that he'll look up to me. In the eyes of a child, working with toys must be the best job imaginable, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100343,
					"content": "I don't want my family to have anything to do with the Fatui's... or should I say, Snezhnaya's... darker side.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100344,
					"content": "The older ones already know that I serve the Tsaritsa. But Teucer is still so young, and in his eyes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100345,
					"content": "Ahem. As I was saying... I remain Snezhnaya's greatest expatriate toy seller, currently attached to the Liyue Branch of our Institute for Toy Research!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100346,
					"content": "That's right! My brother's the greatest! He's Mr. Cyclops' bestest friend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100347,
					"content": "Just humor me in front of Teucer, if you would be so kind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100348,
					"content": "Ah, yes. Ekaterina. I will deal with the issue of that outstanding payment right away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100349,
					"content": "Hey! Slinking off, are we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100350,
					"content": "But Master Childe, would it not be a little improper to ask you to deal with... debt collection?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100351,
					"content": "A bet is a bet, isn't it? And if you lose a bet with an agent... Well, you might as well get a little exercise out of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100352,
					"content": "Are you going off to sell toys now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100353,
					"content": "#That's right! As much as I'd love to catch up a little longer, Teucer, duty calls! I'm sure {M#Mr. Nice Guy}{F#Ms. Nice Lady} here will be happy to keep you company while I'm out, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100354,
					"content": "Ugh, so we still need to keep babysitting for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100355,
					"content": "#Sure! I really like this {M#guy}{F#lady}, and anyway {M#he}{F#she} made a pinkie promise to take good care of me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100356,
					"content": "Ah! Well, it sounds like Teucer really likes you, and that you've already made a pinkie promise to take good care of him anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100357,
					"content": "(They're ganging up on me...) ...Okay, sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "Then I'm in your debt. Here, take this as Teucer's entertainment fund. I want him to have a good time while he's in Liyue, so take him anywhere he wants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100360,
					"content": "If need be, you may find me by the river near <color=#00E1FFFF>Qingxu Pool</color>. I'll see you both around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 110100358,
					"content": "Okay, we'll do it. For Teucer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100338,
					"content": "Concern for your family's well-being. That I can understand.",
