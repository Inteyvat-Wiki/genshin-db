			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "How did it go? Did you take care of them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400402,
					"content": "Yep, all done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "Thank you so much! Habachi can finally have a peaceful lunch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400405,
					"content": "Here, this is for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400406,
					"content": "Um... What else will arrive today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400403,
					"content": "You won't see them for a while.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
