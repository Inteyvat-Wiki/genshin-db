				"points": []
			},
			"dialogs": [
				{
					"id": 230400701,
					"content": "Traveler, did you get the goods?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400702,
					"content": "Yes, got them right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "Great! Please leave them there. Thank you so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400704,
					"content": "Habachi is tallying some other stuff in the warehouse. I'll take care of the food here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400705,
					"content": "*sigh* Fingers crossed that we didn't lose too much food...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
		{
			"id": 2304008,
			"completionStepIds": [
				2304008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304008",
							"2"
						],
						"stepId": 2304008,
						"stateName": "QUEST_STATE_UNFINISHED"
