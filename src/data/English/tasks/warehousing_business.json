			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "Ugh, these Red Vultures! They just won't leave, will they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "Excuse me, what happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "Are you... the Traveler? I've heard about you from Ebeid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "Hehe, we don't usually see many travelers around, so I wasn't expecting you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "Oh, have you met Habachi? The lad's always so strict — makes him seem unapproachable at times. Please don't feel offended though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "You see, we've got all sorts of stuff stored here, not just food but also clothes, weapons, and even Mora and goods...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "There aren't many young people in this place, and they need to manage all kinds of things, from protecting the village to the daily affairs of villagers. As a result, Habachi has been the only person on the warehouse-guarding duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "I can't help him much except for keeping accounts and tallying goods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "What's with the Red Vultures?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "*sigh* Don't get me started. We just received a batch of jerky in the warehouse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "I guess it's the scent or something that has attracted these birds. Anyway, they started lurking on the hill near the warehouse from time to time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "They can't have their way with the jerky locked in the warehouse, but whoever eats in front of them becomes an easy target instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "Our guards are too busy to come and get rid of them, nor is Habachi available...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "Traveler, if you have time, could you deal with them for us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Thank you so much. Those vultures are fierce. You might want to keep your distance. I'd suggest using a bow and arrow to get rid of them. It's safer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "Have they attacked anything?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Yes, lots of things, actually — the goods we're transporting, the meat we're drying, and also Habachi's lunchboxes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "Every time Habachi's having lunch while on duty, the vultures always come snatch his meat away when he's not watching.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "The poor lad can't leave his post to chase after them, so he has to make do with what's left...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "So, please get rid of the vultures for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
