			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "*sigh* Habachi should really allow himself some rest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400502,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "Traveler, perfect timing! Could you help me with something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400504,
					"content": "We just got some dried foods from outside the village. Habachi was about to deliver them here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400505,
					"content": "But a group of Red Vultures was attracted by the smell and came whooshing down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400506,
					"content": "Although the guards managed to drive them away quickly, they had scattered the food everywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400507,
					"content": "Some people have left to warn other delivery teams, and Habachi's busy retrieving what is still edible. Traveler, could you help us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400508,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Thank you so much. My apologies, I've got another batch of goods coming in, so I can't go myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400510,
					"content": "Is Habachi okay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "*sigh* I asked him to take a break, but he wouldn't listen. He said he'd go over the goods in the warehouse once he was done putting the scattered food back. He's overworking himself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400512,
					"content": "The goods should be near the White Lift. Please bring them to me, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
