				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "Ah, Traveler, thank goodness you've come! Please go help Habachi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400802,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "*sigh* A group of Treasure Hoarders suddenly showed up outside the village and stopped one of our delivery teams. We've summoned every guard available to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400805,
					"content": "But Habachi said that was not enough, so he also grabbed a weapon to join the guards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400806,
					"content": "I heard there are too many Treasure Hoarders this time. Habachi can't handle them on his own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400807,
					"content": "Traveler, I've marked the location on the map. Please help him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400808,
					"content": "I'll go right away.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "I'm counting on you. Hope nothing happens to Habachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400810,
					"content": "Is he a good fighter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "He can handle a thug or two alright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400812,
					"content": "But it's a whole group of ambushing Treasure Hoarders we're talking about. Had it not been for the fast runner in the delivery team, no one would've known what happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400813,
					"content": "*sigh* How I wish Ms. Candace were around — none of the Treasure Hoarders would dare to lift a finger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400814,
					"content": "They must've been waiting for her departure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400815,
					"content": "Traveler, please help Habachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
