			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721580101,
					"content": "The storm... has passed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580102,
					"content": "It seems like all four Warding Stones have been sealed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580103,
					"content": "That they have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "I—It's you! How did you get up there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580105,
					"content": "Taisuke said that you passed through some kind of door — and then you disappeared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580106,
					"content": "What on earth is with that door? How strange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580107,
					"content": "What happened up there, exactly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580108,
					"content": "Etsuko and I heard a sudden rumbling from above, almost like thunder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580109,
					"content": "But the storm should have abated already...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580110,
					"content": "Well, here's what happened...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "Rocks floating in the sky... formed a platform...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580112,
					"content": "Huh. That's... I must confess that I've never heard of such a natural phenomenon occurring on Seirai Island...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580113,
					"content": "...Which part of that sounds like a natural phenomenon, seriously...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580114,
					"content": "It's super unnatural no matter how you look at it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580115,
					"content": "Agreed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "Well, natural or otherwise, the storm over Seirai Island has been calmed, and our commission is complete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580118,
					"content": "You know, we also found this strange feather...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "This is... Taisuke, you have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580120,
					"content": "Alright, allow me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580121,
					"content": "Apologies, but I have no idea where this feather came from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580122,
					"content": "This feather's pattern and texture are nothing like any birds I know of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580123,
					"content": "And if you study its dimensions and the ratios involved, this bird would have been as large as that stone platform up there in the sky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580124,
					"content": "Is this feather that important? If you want to figure its history out, why don't you put up a commission at the Guild? Who knows, you might run into someone who can give you a lead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580125,
					"content": "Alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "Well, in that case, thanks again for your help, Adventurer. Taisuke and I will head back to the Guild to make our reports.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580128,
					"content": "Ah, right. This is for you. It's not much... But I'd say you're still owed some payment for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580129,
					"content": "Taisuke, get ready to pack it up. We're headed back to the Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580130,
					"content": "Uh, so, Etsuko... Let's drop by that shrine real quick and see Lady Neko, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580131,
					"content": "...Taisuke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580132,
					"content": "Come on! It's a cat that can talk! A talking cat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580133,
					"content": "*sigh* Seriously...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721580126,
					"content": "I'll give it some thought myself...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "You'd be right to say so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}