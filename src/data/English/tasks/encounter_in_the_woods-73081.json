			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "It's Arama and the Golden Nara. You are so tall. But the silver one by your side...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "Hmm? What about the silver one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "How should I put it... You must be able to squeeze into the narrowest tree hollows. How convenient!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#Well, based on Nara customs, we should do introductions first. This is Nara {NICKNAME} and Paimon. This is Arakavi. You guys shake hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "You are a little lost, but you shake hands with Arakavi anyway...\\nYou try not to use too much strength.\\nArakavu's hand feels... interesting to the touch.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "How fascinating. I've heard a lot about Nara before, but this is the first time I've ever touched one. It's a very special feeling!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "It's been a long time since we last hosted a Nara here. Many seeds have grown into trees, and many stories have become legends. That Nara was a good Nara — or so we've heard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Nara {NICKNAME} is good, too. Strong and brave, like a sapling sprouting out of a rock wall. And they are here to help Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Ah, Arana... It's been a while since we last met. I hope all is well, and that the little Nara at Vimara Village are well, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "You know the kids of Vimara Village?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Of course I do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "We all do! Arana came back and told us stories about the little Nara. Nara Iotham, Nara Bahram, and Narana are our friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "Paimon's not sure that counts as \"knowing someone\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "What counts, then? Do we need to \"shake hands\" after the \"introduction\" like Nara do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "I know what Paimon means. Nara eat and look for \"treasures\" together. Then they know each other, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "It's not quite that simple, either...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "As long as we know each other's stories, we know each other. This is because the Aranara's world is a place for songs and dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Arakavi is right. As long as we hear about Nara {NICKNAME} through songs and see what Nara {NICKNAME} looks like through dreams, it'll count as knowing you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "Paimon thinks that we can leave this aside for now... After all, we're already friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "Good friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama and Arakavi"
				},
				{
					"id": 730810325,
					"content": "Good friends!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Yes. Since we're going to celebrate Festival Utsava, Arakavi needs to make some preparations!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "That's true. We need the Bija, right? I've sent Arayasa, Aradasa, and Arasudraka to look for Ashvattha's Concourses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Spot on! But Paimon's wondering... Why don't you guys know where these concourses are?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "Ashvattha's Concourses are very, very sacred places. We don't usually go there. We would prefer to let the Vasara Trees sleep and dream, until all memories come together in Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "The forest will remember. No good thing will ever fade away, and all suffering will come to nourish something beautiful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "Anyway, you can find Arayasa, Aradasa, and Arasudraka looking for Ashvattha's Concourses out there. Arama, you go and help them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#I will. If Nara {NICKNAME} and Paimon run into us in the forest, we can go adventuring together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Very well. Nice to have met you, Nara {NICKNAME} and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "Now let's talk about business...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "How should I explain this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "I eat and search for treasures with Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "Yes! And we're not just \"people who know each other,\" but the best of companions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#Good for you, Nara {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
