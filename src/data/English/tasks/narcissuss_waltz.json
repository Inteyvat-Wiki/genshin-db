			"dialogs": [
				{
					"id": 742540601,
					"content": "Such a peaceful, pleasant day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540602,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540604,
					"content": "Mmhmm, thank you for the invitation, Sandrone... Or should I call you \"little sister\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540603,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Marionette"
				}
