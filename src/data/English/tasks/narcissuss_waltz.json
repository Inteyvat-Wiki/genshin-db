			"dialogs": [
				{
					"id": 742540501,
					"content": "Seymour! It's been so long! And Mamere too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540502,
					"content": "Hehe, Seymour wouldn't stop telling me how much he missed you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540503,
					"content": "Affirmative. I never stopped thinking of Miss Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "And thank you, Miss Sandrone, for hosting this tea party. It's so nice to get together and chat about our travels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540505,
					"content": "Don't mention it. I feel like we're all family on some level, with a long, shared history. Uhm, at least that's how I see it. So there's no harm in getting together when everyone's free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540506,
					"content": "Family? I don't know why, but hearing you say that fills me with joy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540507,
					"content": "So does that make Miss Sandrone our... little sister?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540508,
					"content": "Uhm... Maybe we can skip the whole big, little thing for now...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540509,
					"content": "Affirmative. As the prototype created by Mr. Alain, Miss Sandrone should properly address me as \"Big Brother.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "Hmph...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540511,
					"content": "Aw, that's so lovely. Can I be a member of this family, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540512,
					"content": "Of course! We're hardly a conventional \"family\" to begin with. What harm could adding a Melusine to the mix do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540513,
					"content": "Affirmative. Besides, Miss Mamere is already my family.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Hehe. This makes me so happy! How about I paint us all a family portrait?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540515,
					"content": "A family portrait? It's been a long time since I posed for one of those...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540516,
					"content": "Make sure to make me look impressive! Like the big sister of the family!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540517,
					"content": "Sure thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540518,
					"content": "Heh... Why not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
