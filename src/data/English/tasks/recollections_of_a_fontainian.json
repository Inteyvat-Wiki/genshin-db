			},
			"dialogs": [
				{
					"id": 733500201,
					"content": "Have you taken my picture?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500202
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500202,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500203
					]
				},
				{
					"id": 733500203,
					"content": "Oh, take your time. Taking a good photo is no easy task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Augustus Lovelace"
				}
			]
		},
		{
			"id": 7335003,
			"completionStepIds": [
				7335003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
