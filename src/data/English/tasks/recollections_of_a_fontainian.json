			"trigger": {
				"objectNames": [
					"Augustus Lovelace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500301,
					"content": "Not bad indeed. You have a gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500302
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500302,
					"content": "It's the first time in my travels that I've met someone with such control over composition and color.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500303
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500303,
					"content": "Where have your travels taken you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500304
					]
				},
				{
					"id": 733500304,
					"content": "Ah, that, well... I could have come directly to Sumeru from Fontaine... after all, there's a line going straight to the Bayda Harbor in Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500312
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500312,
					"content": "But as they say, it's about the journey, not the destination. So I chose a... more interesting route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500313
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500313,
					"content": "First, I went from Lumidouce Harbor to Chenyu Vale, and then passed through Qingce Village on my way to the Stone Gate that separates Mondstadt from Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500310
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500310,
					"content": "After stopping by Dawn Winery, I decided to head south and visit Liyue Harbor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500305
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500305,
					"content": "I embarked on a ferry to Port Ormos from Liyue Harbor, traveled northward along the river, and here I am standing before you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500306
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500306,
					"content": "After all, my goal is to relax. Were I a brave warrior with a passion for adventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500311
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500311,
					"content": "...I might have decided to set out from Romaritime Harbor and followed the ancient path of the pilgrims, heading southward into the desert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500307
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500307,
					"content": "Who knows? Maybe I'll try to cross the desert on the way back. Anyway, I've still got extra Mora to spend, and paying a visit to Natlan on the other side of the desert sounds nice too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500308
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500308,
					"content": "Alright, I won't keep you any longer. Thank you for helping me with the photo, please accept this as a token of my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500309
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500309,
					"content": "I'm off to write to Xavier. If he still won't come to Sumeru, then I might as well go back to Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Augustus Lovelace"
				}
			]
		},
