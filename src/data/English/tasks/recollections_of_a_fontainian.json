			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Augustus Lovelace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500101,
					"content": "A-Achoo! The smell of these spices is just too... A-ACHOO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500102
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500102,
					"content": "I should just take a picture and go hide in my room...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500103
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500103,
					"content": "Traveler! Hey! Traveler! Hold on a second!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500104,
						733500105
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500104,
					"content": "Who, me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500106
					]
				},
				{
					"id": 733500106,
					"content": "I'd like your help with taking a picture, just one. It won't take long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500109
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500109,
					"content": "*sigh* It's embarrassing to admit, but the aroma of the spices here is a little too strong for me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500110
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500110,
					"content": "During my time in Fontaine, I never had food with even just a hint of spiciness, a pinch of salt is as much as I can take.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500111
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500111,
					"content": "Here, I'm sneezing so much that— ACHOO! I can't even hold the Kamera steadily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500112
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500112,
					"content": "So, all I can do... is ask someone else to take a photo for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500113
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500113,
					"content": "You certainly seem to be a kind person, so... I'd like to ask for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500114
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500114,
					"content": "You're from Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500115
					]
				},
				{
					"id": 733500115,
					"content": "Indeed. I'm very sorry that I forgot to introduce myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500116
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500116,
					"content": "I'm Augustus Lovelace, a researcher from Fontaine Research Institute of Kinetic Energy Engineering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500117,
						733500118
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500117,
					"content": "Fontaine Research Institute of Kinetic Energy Engineering?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500119
					]
				},
				{
					"id": 733500119,
					"content": "It's a mouthful, isn't it? You can call it the Fontaine Research Institute, as most people in Fontaine do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500120
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500120,
					"content": "The Fontaine Research Institute used to be a paradise for researchers in Fontaine and where most mechanical creations originated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500121
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500121,
					"content": "But thanks to Mr. Edwin, most buildings in the Fontaine Research Institute are lying in ruin now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500122
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500122,
					"content": "And ever since Raimondo and Mr. Choiseul took over the reconstruction project, the spirit of research at the institute has been in freefall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500123
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500123,
					"content": "I have standards and prefer a tidy environment. I refuse to live in a pile of rubble, and so I've been traveling around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500124
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500124,
					"content": "Don't let my troubles spoil your mood, they have nothing to do with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500125
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500125,
					"content": "Come on, please hurry and snap a photo for me. Once Xavier sees the beauty of Sumeru, there's no way he'll stay in Inazuma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500126
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500126,
					"content": "About Xavier...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500127
					]
				},
				{
					"id": 733500127,
					"content": "Xavier is a researcher from the Fontaine Research Institute. We used to work in the same laboratory, and he once gave me quite a bit of help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500128
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500128,
					"content": "He insisted on shooting a film and being the director. That wasn't a very popular idea in Fontaine Research Institute at the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500129
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500129,
					"content": "Even after being assigned to other projects, he still continued shooting \"dokumentari films\" in the name of recording their research process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500132
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500132,
					"content": "Just like that, he went back and forth between projects and the laboratory until he was finally sent to Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500130
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500130,
					"content": "He's a very resourceful person. I'm certain that had he been born in the past, when funding was abundant and more fields of research were accepted, or been born in a brighter future, he would have accomplished great things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500131
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500131,
					"content": "That's enough of that. Come and take a photo of me. Right here will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500118,
					"content": "What kind of place is that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500119
					]
				},
				{
					"id": 733500105,
					"content": "What can I do for you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500106
					]
				}
			]
		},
		{
			"id": 7335002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
