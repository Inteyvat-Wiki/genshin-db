				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "Okay! Let's set up the second riddle here. Once this riddle is solved, the final chest can be found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030202,
					"content": "I'm going to place the final treasure... there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030203,
					"content": "Huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030204,
					"content": "Um...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "Isn't this just an ordinary little hill with an ordinary little waterfall next to it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030206,
					"content": "That's right! But it will soon be anything but ordinary because of our riddles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030207,
					"content": "Okay, Traveler, what do you suggest for this riddle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030208,
					"content": "Let's make it a bit straightforward this time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "Eh? You think so? Hm... True, the riddle solvers would be pretty tired when they get here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030210,
					"content": "Alright, straightforward it is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030219,
					"content": "Not exactly trained for it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "Well, practice makes perfect...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "I see. As expected of the Traveler! How knowledgeable... Okay, I will put up the riddle you wrote here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030222,
					"content": "Drusus starts putting up the riddle...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "Done! This little notice board should be obvious enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030224,
					"content": "Then let's go set up the last treasure chest now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030211,
					"content": "Let's use the waterfall as a theme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "Hmm... The waterfall is indeed a very clear theme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030213,
					"content": "No problem, let's use it as a theme. As for the difficulty of this last riddle... Let's tone it down a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030214,
					"content": "Hehe, let me write something.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "Hey! You're laughing more and more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030216,
					"content": "It's done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "\"The green umbrella gazes at the pearl curtain.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030218,
					"content": "Hm... This riddle sounds special... Did you learn this from somewhere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				}
			]
		},
