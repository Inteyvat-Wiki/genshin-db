				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "This is the last chest. There's no need for riddles for this one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "But what should I put in it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "Something valuable enough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "That makes sense. The content of this chest should be at least worthy of the riddle solver's hard thinking along their journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "Speaking of value, the most logical would be Mora, of course. Ah, I'll just put some Mora in there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "Okay, this set of riddles is finished now. Thank you for your help, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "These are for you, as a reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "*sigh* I was planning on discussing riddles with you in more depth, but I have to return to the Akademiya to tend to some matters first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "If you discover any strange new riddles in your travels, or get stumped by one, please come to me by all means.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "We can discuss them in detail together, then... Put together new riddles for other adventurers! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "Farewell, Traveler. I wish you safe travels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "I hope that Treasure Hoarder named Narzam won't cause any serious trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "Something of practical value.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "Practical value? Hm... What can be of enough practical value?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "Oh right! I got a recipe from someone a few days ago. Let's put it in this chest as a reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "This process of thought is the greatest treasure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "Hahahahaha! You're right! So true! The thinking process is indeed a priceless and valuable experience! Compared to it, other things are almost worthless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "That's simply not true! Put some Mora in it, or a recipe! Some vegetables or fruits at the very least, don't put nothing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "I'm kidding, I'm kidding. I'll definitely put something in as a reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
