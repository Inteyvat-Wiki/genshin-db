			},
			"dialogs": [
				{
					"id": 721520101,
					"content": "\"...This used to be where the great pirate Rinzou stored his treasure. The lads moved the last few chests out...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Treasure Hoarder's Notes"
				},
				{
					"id": 721520102,
					"content": "\"...Rinzou was a cunning man in life, though, and he left all manner of special symbols on the island...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Treasure Hoarder's Notes"
				},
				{
					"id": 721520103,
					"content": "\"...It might be a smokescreen, or there might really be treasure. But we'll only find out if we go there and see for ourselves...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Treasure Hoarder's Notes"
				},
				{
					"id": 721520104,
					"content": "\"...We've found some of those symbols. Well, time waits for no one. Best we go dig up Rinzou's full hoard!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Treasure Hoarder's Notes"
				},
				{
					"id": 721520105,
					"content": "Wow, this is... really long... Paimon really can't be bothered to read any of this other than the bit about treasure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Wait... Treasure!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "C'mon, Traveler, there's treasure to be had! We can't let the Treasure Hoarders get ahead of us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
