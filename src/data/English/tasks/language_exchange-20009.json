			},
			"dialogs": [
				{
					"id": 200090601,
					"content": "Olah! Muhe mimi, nye, eh... mosi aba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090602
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090602,
					"content": "Yo mimi beru si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090603
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200090603,
					"content": "Buka...mita nye, guru-guru...yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090604
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090604,
					"content": "Ya odomu, Todo yo, buka guru-guru nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090605
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200090605,
					"content": "Mi? Dada! Valo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090606
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090606,
					"content": "Valo, ya odomu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090607
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200090607,
					"content": "Hehe, look at how he's acting. He seems so happy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090608
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090608,
					"content": "Looks like this time has finally been a success, and my Hilichurlian has finally improved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2000907,
