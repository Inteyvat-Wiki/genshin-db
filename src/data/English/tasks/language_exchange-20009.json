				"points": []
			},
			"dialogs": [
				{
					"id": 200090101,
					"content": "Traveler! Here! Over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090102,
					"content": "Don't startle those hilichurls over there. Why are you always running off into hilichurl camps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090103,
					"content": "Forget it, it's not important. I've been researching Hilichurlian for some time, but I'd much rather get in some actual speaking practice than constantly going over books.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090104,
					"content": "I've finally stumbled across a whole hilichurl camp... I cannot let this opportunity pass me by!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090105,
					"content": "So, Traveler, can you go with me into the camp and help me find a hilichurl to practice with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2000902,
