			},
			"dialogs": [
				{
					"id": 200090301,
					"content": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090302
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090302,
					"content": "Dala beru yo!? Kundala muhe, kucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090303
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200090303,
					"content": "Kundala gusha! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090304
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090304,
					"content": "Biat ye, plata ye pupu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090305
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200090305,
					"content": "Movo unta nye kucha, mi dada tiga mitono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090306
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200090306,
					"content": "Oh! I think he understood me! He seems to be taking out something to show us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090307
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090307,
					"content": "Oh, oh no! It's a weapon! Traveler, help me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
