					"nextDialogs": [
						760830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830506,
					"content": "So that's what it's called. Does it pick its creator up and carry her around in its hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830507
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830507,
					"content": "Paimon thinks you might be confusing Aino with a former colleague of yours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830508,
					"content": "A Weasel Thief who's eaten too much.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830509
					]
				},
				{
					"id": 760830509,
					"content": "Could a Weasel Thief this stuffed still steal stuff?",
