						760830511
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830511,
					"content": "The correct answer is \"the big mechanical duck next to Aino's workshop.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830512
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830512,
					"content": "Come back now. Thank you, I know that wasn't easy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830513,
					"content": "A flask.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830514
					]
				},
				{
					"id": 760830514,
					"content": "Whoa, the kuuhenki learned what specialized lab equipment looks like just for this game? They're really going all out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830515
					],
