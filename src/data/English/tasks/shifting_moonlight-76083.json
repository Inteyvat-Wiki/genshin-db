						760830405
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760830405,
					"content": "Hmph, that was way too obvious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830406,
					"content": "I'm afraid this riddle was a little too simple for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830407,
					"content": "Unagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830408
					]
				},
				{
					"id": 760830408,
					"content": "Hey, what's wrong with this eel's waist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830409,
					"content": "You two possess an impressive wealth of knowledge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830410
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830410,
					"content": "The correct answer is \"the moon.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830411
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830411,
					"content": "Come back now. You did a wonderful job.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830412,
					"content": "An arc.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830413
					]
				},
				{
					"id": 760830413,
					"content": "Anyone with eyes can see it's an arc! How could the answer be something so simple!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830414,
					"content": "While you aren't technically wrong, I'm afraid that's not exactly what the kuuhenki were going for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830415
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760830415,
					"content": "The correct answer is \"the moon.\"",
					"roleType": "TALK_ROLE_NPC",
