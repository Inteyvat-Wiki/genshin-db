			},
			"dialogs": [
				{
					"id": 718130801,
					"content": "Hello, can I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130802
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130802,
					"content": "So, about those preparations you've been making...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "This is... the \"Meadow of Gems\"? Where did you get this book? I've searched high and low throughout Liyue, and I couldn't find it even so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130804,
					"content": "Qingzhou hand-wrote a copy for me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "That poet? Hmm, it seems that his reputation is well-founded...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130806,
					"content": "Thank you for your help in preparing these objects. Once Master Lu sends those ornaments over, I will also arrange for him to receive appropriate compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130807,
					"content": "So, you're rebuilding the Jade Chamber, huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "Indeed, we do have plans to do so. But with the number of things we will need to prepare, there is still much work to be done. I doubt that we can finish rebuilding it quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130809,
					"content": "Not to mention our biggest material headache, which we have yet to find a solution to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130810,
					"content": "Never mind, I shall not speak of it. Thanks for your help once again — and please, accept these for your aid. Now, if you'll excuse me, I must return to my work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
		},
