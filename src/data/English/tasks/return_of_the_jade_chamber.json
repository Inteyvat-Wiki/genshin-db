				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130401,
					"content": "The \"Meadow of Gems,\" how does it start... Ah yes, \"Commerce and trade, like springs and streams, begin with the mountains and end with the seas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181305,
			"completionStepIds": [
				7181305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181305",
							"2"
						],
						"stepId": 7181305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "\"This grand plan charts the course that will lead us, slowly but surely, to Liyue's longevity and the people's prosperity.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130502,
					"content": "Ah, you've returned. One moment, I am still penning the last few lines...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130503,
					"content": "Hmm... There. That should do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130504,
					"content": "Here's your Triple-Layered Consommé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "Ah! That can wait, though — first, please see if the book is to your satisfaction. I trust that you will find my penmanship to be quite satisfactory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130506,
					"content": "This is seriously impressive work...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "Hahaha, you praise me excessively, my liege. This book is for you. Don't lose it, now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181306",
							"2"
						],
						"stepId": 7181306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Master Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "Hmm? Do you need anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130602,
					"content": "I'd like to order some small ornaments made of bamboo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Small bamboo ornaments, you say? I could do it, but may I know where this order is coming from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130604,
					"content": "It's from this checklist of Baiwen's...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Oho... an order from Yuehai Pavilion, is it? Well then, I suppose I should complete it as quickly as I can, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130606,
					"content": "There is one problem, though: the bamboo forest that I frequently gather materials from has suddenly become occupied by a great many boars, for reasons unknown to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130607,
					"content": "Though it is not much of a problem, I often have to go around them to collect bamboo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130608,
					"content": "If you could chase those boars out, I can go and collect some bamboo now, and we can begin work right away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130609,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "I shall wait for you here, then. Once you have chased those boars out, come back and give me a shout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Lu"
				}
			]
		},
		{
			"id": 7181307,
			"completionStepIds": [
				7181310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181310",
							"2"
						],
						"stepId": 7181310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Master Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130701,
					"content": "So, have you chased those boars away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "Master Lu"
				},
				{
					"id": 718130702,
					"content": "All of 'em.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "That will do. I shall head over to collect bamboo in a while. Once the ornaments are ready, I shall have them delivered directly to Yuehai Pavilion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
