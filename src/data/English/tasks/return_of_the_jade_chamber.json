			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Hi. Would you like to buy anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "We'd like a copy of \"Meadow of Gems.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "\"Meadow of Gems\"? We don't have it in stock here. Do you need it in a hurry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "Well, they're rebuilding the Jade Chamber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Are they really? Well, that would require proper preparation, yes. Let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Perhaps you can look for Qingzhou instead. He is extremely well-read — perhaps he might know where a copy of \"Meadow of Gems\" might be found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "If my memory serves, Qingzhou often lodges at the Wangshu Inn. You can try looking for him there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181303",
							"2"
						],
						"stepId": 7181303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "A conundrum. Most vexing, indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130302,
					"content": "So, uh, do you know anything about the \"Meadow of Gems\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "The \"Meadow of Gems,\" you say? Yes, I do recall that book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130304,
					"content": "I once went hither and thither in search of material with which to write a poem about merchants and happened upon this book in the process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130305,
					"content": "I did not fully comprehend the book's contents, but some of its anecdotes proved most inspirational nonetheless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130306,
					"content": "Let me try to recall the name of that poem. Pray, give me a moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130307,
					"content": "Do you remember where I can find that book?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Ah, so you wish to locate that book? I must confess that no such place comes to mind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130309,
					"content": "However, if you need it urgently, I could just write you out a copy of it myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130310,
					"content": "Write it out?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "Ah, it was hardly a lengthy text. Memorizing it was no tall order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130313,
					"content": "More to the point, the book collector wouldn't let me loan it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130314,
					"content": "And since poetry is not something that one can rush, I decided I'd simply write out a copy for my continued perusal... The book's contents were not very long, either, so I have it more or less memorized now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130315,
					"content": "That's seriously impressive work...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "Ah, it is but a trifling matter, my liege. Still, perhaps you could do me a favor in exchange for the hand-written text.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130317,
					"content": "As embarrassing as this is... I have been so focused on gathering inspiration here that only now do I realize: I have completely forgotten to eat today. Suddenly, I feel rather ravenous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130318,
					"content": "Could you help me get a serving of Triple-Layered Consommé? In exchange, I shall write you a copy of \"Meadow of Gems.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130319,
					"content": "I believe that I should just about be done by the time you return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130311,
					"content": "From memory?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
