			"dialogs": [
				{
					"id": 718131001,
					"content": "\"There are those who lose their jobs and have no reliable source of food, nor a roof over their heads, they toil in vain in their barren fields. All the while, the wealthy merchants' residences overflow with gold and jade. What justice and uprightness is this?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
