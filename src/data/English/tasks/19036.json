					"Shibata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361701,
					"content": "Oh, it's you...! The captain of Swordfish II! My name is Shibata. I'm in charge of the watch here. May I inquire as to what the captain needs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361702,
					"content": "I'm here for information about a specific individual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "You tell Shibata about the commission to find Heizou.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "So his name is Shikanoin Heizou, huh? Yes, I'm familiar with the detective, he used to stroll around the area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "Her Excellency had assigned me to keep a close eye on him at the time, fearing that he would do something unpleasant, but I eventually realized that he acted more like he was on a trip or something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "Come to think of it, I believe he was recently spotted in the area east of the Sangonomiya Shrine. Please feel free to go there and take a look for yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
		},
