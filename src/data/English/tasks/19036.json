	"talks": [
		{
			"id": 1903614,
			"completionStepIds": [
				1903601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
