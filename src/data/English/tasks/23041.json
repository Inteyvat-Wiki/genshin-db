			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "Oh no... There's more bitten leaves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410202,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "Traveler, look! That kitten is chewing on my flowers again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410204,
					"content": "Look at this leaf over here... That one too! They all have large chunks bitten off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410205,
					"content": "Perhaps the kitten is hungry.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "That's also what Raef said. He even went around to feed the kitten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410207,
					"content": "But the next day, the kitten came back to nibble on my flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410210,
					"content": "The kitten just munches on leaves for now. What if it starts biting the stems? ...That would be a disaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410211,
					"content": "But I don't want to chase it away either. If it leaves the village, it'll have nowhere to go but to the desert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410212,
					"content": "Traveler, could you help me feed the kitten again? I hope it doesn't come nibbling at my flower leaves again. They're not even tasty to begin with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410213,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "Anyway, thanks for agreeing to help. I'll mark the kitten's favorite spot on your map...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410217,
					"content": "Meanwhile, I'm gonna stay here and watch my flowers in case another little cat comes along and takes a chunk off the leaves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410214,
					"content": "I'm somewhat of a cat expert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "That would be great! Whenever I see cat paws, I'm worried that the cat'll pounce at me with its claws out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410208,
					"content": "Perhaps the kitten... enjoys chewing on plants?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "I'm not sure what it likes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				}
			]
		},
