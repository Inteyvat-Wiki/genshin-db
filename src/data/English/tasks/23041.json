			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "Traveler, perfect timing! Come have a taste of the Minty Bean Soup I made.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410303,
					"content": "The ingredients in your soup...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "I asked someone to buy most of the ingredients for me, but as for Mint... I grew them myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410305,
					"content": "Raef gave me a set of gardening tools and some fertilizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410306,
					"content": "I thought it would be a waste to use them on one single pot of flowers... So I asked Azalai to buy some Mint seeds for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410307,
					"content": "After planting the Mint seeds, I took care of them just like how I take care of the flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410308,
					"content": "As time went on, the Mint grew and matured...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410309,
					"content": "So I picked some and made this Minty Bean Soup. What do you think? Tastes pretty good, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410310,
					"content": "Um... Since you ate my Minty Bean Soup, you have to do me a favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410311,
					"content": "Uh, I'm not done eating yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "Hey, I was just joking! I'll give you a nice reward for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410314,
					"content": "I just need you to pick three Zaytun Peaches for me. They're Raef's favorite fruit.",
					"roleType": "TALK_ROLE_NPC",
