			"dialogs": [
				{
					"id": 728070201,
					"content": "*sigh* What a headache... Hi there, is there anything you want?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070202
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070202,
					"content": "About Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Are you talking about Master Kamaji? What do you want from him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070204,
					"content": "(Show Chisato's Letter)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "You said this letter is from Ms. Hiiragi Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "If this letter is really from that Hiiragi Chisato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "I think... You should talk to Master Kamaji directly. He's been taking walks near the bridge recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sanada"
				}
			]
		},
		{
