					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "You are... Ahh, you're that Traveler from abroad. What can I do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "About Hiiragi Chisato's Letter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "This letter... Did Ms. Hiiragi really ask you to deliver this letter to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "This handwriting... It really is her... Thank goodness...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "Thank you for making this trip, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "As for the Travel Permit... As it's Ms. Hiiragi's personal request, I will naturally see it through.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "However, I'll need some time to prepare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "How about this. Can you wait for me at the Kiminami Restaurant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "Why do you want to go there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Well... I want a small favor from you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Recently... I was also thinking of sending something to Ms. Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "I wrote a letter and also requested Ms. Kiminami to make some treats for me. I was planning to send them together to Ms. Hiiragi as a present.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "But if my father finds out about my plans, he might be upset... Just as I was pondering what to do, you showed up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "It's only a present.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Father doesn't want me to communicate with Ms. Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "I understand his concerns. After all, I am a member of the Kujou Clan and one of the enforcers of the Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "Ms. Hiiragi is the young lady of the Kanjou Commission's Hiiragi Clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "If I were to get too close to her, it would be inevitable that someone might try to take advantage of our situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Even though it is only a present, in some people's eyes, it's a lot more than that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Hehe, let's not talk about these trivial matters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "Traveler, please wait at the Kiminami Restaurant for me. After I approve the Travel Permit, I'll bring it to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "Is your father very strict?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Father... He naturally has to be strict. I do understand why he's unwilling for me to communicate with Ms. Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070322,
					"content": "After all, I am a member of the Kujou Clan and one of the enforcers of the Tenryou Commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070323,
					"content": "Ms. Hiiragi is the young lady of the Kanjou Commission's Hiiragi Clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070324,
					"content": "If I were to get too close to her, it would be inevitable that someone might try to take advantage of our situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070325
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070325,
					"content": "Even though it is only a present, in some people's eyes, it's a lot more than that.",
					"roleType": "TALK_ROLE_NPC",
