				"objectNames": [
					"Frejus",
					"Chenee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "The data indicates that this invention is a success. Thank you both.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120102,
					"content": "Yup, thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120103,
					"content": "See, I told you this would go well! With your genius in play, Frejus, this remote-controlled cannon thing was a piece of cake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120104,
					"content": "I—I suppose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120105,
					"content": "In that case, let's get cracking with the next awesome gadget — and I have a great idea for one, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120106,
					"content": "What?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120107,
					"content": "What about an airship that can explore the skies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120108,
					"content": "Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120109,
					"content": "Or a mega drill that can bore deep underground?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120110,
					"content": "Hah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120111,
					"content": "Feels like she's trying to make his life difficult on purpose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120112,
					"content": "Those might be a bit of a tall order...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "I mean, you're the one who rejected the Institute's offer three times. I'm sure you can make stuff even they can't, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120114,
					"content": "Of course. I can only say that it will be tricky, but not a big deal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120115,
					"content": "*sigh* You know what? I don't want those things anymore. Flying up into the sky or delving into the earth both sound boring. It's cold up there, and it's stuffy down there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120116,
					"content": "I share that sentiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120117,
					"content": "In that case, could you make something that we'd use normally? ...Ooh, that's right! I love sleeping in in the mornings, so could you make me an automatic oven that bakes on its own?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120118,
					"content": "Well now, that sounds possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120119,
					"content": "Her earlier suggestions were intentionally impossible, I think.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "Alright, let me consider how this might be designed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120121,
					"content": "Nice! I'll take that as agreement — and if it does prove impossible, you'll just have to make me breakfast in the future, eh, Frejus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120122,
					"content": "What? What sort of request is that... In any case, you needn't worry, I'm sure such a small invention is well within my skill. I am, after all, a \"genius.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				}
			]
		},
