						"stepId": 7415608,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415607",
							"3"
						],
						"stepId": 7415607,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Let them take care of it. I won't interfere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Oh, my dear Autumn, do you really want to do this to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561103,
					"content": "What child of the Fleuve Cendre was as lucky as you? The sweets you ate, your satin dresses, the novels you adored, all of those required money.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561104,
					"content": "While others shuddered and starved, you were wearing pretty dresses and putting necklaces on your dog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561105,
					"content": "I gave you that life, so don't you think I should get some kind of reward? After all, there's no such thing as a free ride.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561106,
					"content": "Me, cruel to you? I have been generous enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561107,
					"content": "Autumn, think back carefully. What part of your life did I not prepare for you? Every time you went astray and met with misfortune, it was due to your own willful decisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561108,
					"content": "Ah, Mr. Benoit, you simply are amazing at twisting words until the logic itself is completely inverted. Proclaiming generosity and kindness while only seeking to further your selfish ends. In the end, it's all about you, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561109,
					"content": "Your so-called kindness was only an attempt to fatten me up like a lamb for the slaughter. Spare me your lies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "The extent of my compassion and pity for you now is to give you a quick death. But before that, tell me, where is my child?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "Whether at the old home, or the house you live in now, there isn't a trace of her or her whereabouts. Just where did you send her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "If I tell you, will you let me go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561113,
					"content": "No, but I'll let you die less painfully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "...If I don't tell you, I die. If I tell you, I die anyway. Heh, if there's nothing in it for me, then why should I make things easy for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561115,
					"content": "*sigh* ...Autumn, you really never do tell a lie, do you? Now we'll never find out where she went.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561116,
					"content": "Well, I do happen to know where she is, hehe! But I won't tell you, nope! I'll never tell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561117,
					"content": "You'll never find her. Never, never, never, never, never...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561118,
					"content": "I'm going to take him away. I'll be bringing him back to his own home — do any of you have any objections?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Please do. We won't interfere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "Y—You guys take care of it yourselves. It's not our business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoit keeps repeating \"You will never, ever find her\" over and over as the silent Autumn takes him away.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "I wasn't planning on letting anyone else know about any of this. After all, she has an arrest warrant out for her. It's probably worth mentioning that I, too, am the subject of such a warrant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561123,
					"content": "If you go to the Maison Gardiennage now and file a report, you should be able to pocket a hefty sum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561124,
					"content": "But I would advise against doing so. If you do, our friends will not forget. Feel free to find out for yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561125,
					"content": "I won't report anything.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Haha, that's what I thought you'd say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561128,
					"content": "In that case, this Rainbow Rose is for you. We favor this flower on account of its rich symbolism.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561129,
					"content": "Right now, it symbolizes a warning. A warning not to change your mind about what you just said.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561130,
					"content": "Farewell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561131,
					"content": "So... That's what happened. What a complicated family!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Paimon doesn't know what to say about all of that! It's a good thing we didn't report anything to the Maison Gardiennage earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "Paimon feels bad for Autumn though, she never managed to find her kid in the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "And Paimon thought Benoit was a nice guy, too! Uh... Do you think Paimon's easy to fool?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "You're just realizing that now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "Hey! That's going too far! Mocking Paimon at a time like this... Hmph! Paimon won't forgive you unless you treat her to a big meal at the Hotel Debord!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Your brain cells die lonely deaths.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "I don't need the money.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
		{
