				"points": []
			},
			"dialogs": [
				{
					"id": 741561202,
					"content": "Ho, looks like we've got trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561203
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561203,
					"content": "Thank you, thank you! *sigh* Autumn, I put so much into raising you, yet these outsiders care for me more than you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561204
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561204,
					"content": "What child of the Fleuve Cendre was as lucky as you? The sweets you ate, your satin dresses, the novels you adored, all of those required money.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561205
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561205,
					"content": "While others shuddered and starved, you were wearing pretty dresses and putting necklaces on your dog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561206
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561206,
					"content": "I gave you that life, so don't you think I should get some kind of reward? After all, there's no such thing as a free ride.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561207
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561207,
					"content": "Me, cruel to you? I have been generous enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561208
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561208,
					"content": "Autumn, think back carefully. What part of your life did I not prepare for you? Every time you went astray and met with misfortune, it was due to your own willful decisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561209
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561209,
					"content": "The extent of my compassion and pity for you now is to give you a quick death. But before that, tell me, where is my child?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561210
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561210,
					"content": "Whether at the old home, or the house you live in now, there isn't a trace of her or her whereabouts. Just where did you send her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561211
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561211,
					"content": "If I tell you, will you let me go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561212,
					"content": "No, but I'll let you die less painfully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561213
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561213,
					"content": "*sigh* ...Autumn, you really never do tell a lie, do you? Now we'll never find out where she went.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561214
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561214,
					"content": "Y—You... Don't think you can do whatever you want! There's someone else watching you here, you know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561215,
					"content": "You think we care? That we don't dare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561216
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561216,
					"content": "...Autumn, forget it. Give up. She's living a good life, and her parents are rich. What would you even do if you found her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561217
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561217,
					"content": "Would you make her drift about with you? You're an escapee from Meropide! Do you want her to live like you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561218,
					"content": "So she's been adopted... Why didn't you tell me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561219
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561219,
					"content": "She... She's okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561220
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561220,
					"content": "Let me go, Autumn. It doesn't matter to you whether I live or die.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561221
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561221,
					"content": "Does she have a mother to take care of her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561222,
					"content": "She does! And her adoptive mother is very good to her. Compared to you or me, she's superior in every way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561223
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561223,
					"content": "What does it matter if I find her then... It's meaningless...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561224
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561224,
					"content": "That's right, everything is meaningless! Everything I have in the Court of Fontaine, I'll return to you. I don't want it anymore — just let me go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561225
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561226
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561226,
					"content": "Autumn, what're you spacing out for? Are you actually considering letting him go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561227
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561227,
					"content": "Is that it, Benoit? You actually think you can get away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561228
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561228,
					"content": "I won't stand by and watch you hurt Benoit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561229
					]
				},
				{
					"id": 741561229,
					"content": "So you still want to butt in as far as you can, huh? You have nothing to do with this, but you just have to stick your nose in and interfere, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561230
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561230,
					"content": "A self-righteous suck-up with a bleeding heart, that's what you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561231
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561231,
					"content": "Autumn, are you honestly going to let him go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561232
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561232,
					"content": "I... I don't know... I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561233,
					"content": "*sigh* You're still too softhearted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561234
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561234,
					"content": "Benoit, looks like your gamble paid off — a child is a mother's biggest weakness. And considering how you've got help, I'll let this slide for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561235,
					"content": "But we'll see just how far you can run. Let's see what happens first, shall we? Will we catch you, or will you run off to someplace even we cannot find?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561236
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561236,
					"content": "By the way, I hope you don't misunderstand. I won't be the only one chasing you to the ends of the earth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561237
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561237,
					"content": "I met quite a few friends in the Fortress of Meropide, and before this trip to the Court of Fontaine, many of them expressed a keen interest in meeting you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561238,
					"content": "My wealth... you can take it all! Take it all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561239
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561239,
					"content": "It seems today won't be your last day — and before my friends find you, I sincerely hope you'll survive a few more. Now scram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561240
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561240,
					"content": "Benoit flees in the opposite direction from the Court of Fontaine, and leaves your sight via the mountain path without ever looking back.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561241
					]
				},
				{
					"id": 741561241,
					"content": "And as for you... We'll be leaving the Court of Fontaine soon, and I expect we'll never see each other again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561242,
					"content": "Autumn, time for us to leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561243
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561243,
					"content": "...Sorry, Athos, I'm so sorry... my child, she... I'm sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561244,
					"content": "It's okay. This is a personal matter for you. It's up to you to decide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561245,
					"content": "Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561246
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561246,
					"content": "So... That's what happened. What a complicated family!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561247,
					"content": "Paimon doesn't know what to say about all of that! Paimon feels bad for Autumn though, she never managed to find her kid in the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561248,
					"content": "But no matter what, at least we stopped any bloodshed from happening! That's enough, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}