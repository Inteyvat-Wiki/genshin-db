			"dialogs": [
				{
					"id": 741560401,
					"content": "Paimon's so nervous! Based on what that note said, we just need to wait for him here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "Then we wait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "Okay, it's your call!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "After quietly and patiently waiting for a bit, the window opens with a creak and a familiar face appears. Benoit surveys the environs cautiously, and after seeing you both there, carefully climbs out.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Benoit, just what are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "Quickly, quickly! If I'm discovered, it'll be all over for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560403,
					"content": "I have a few questions for him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
