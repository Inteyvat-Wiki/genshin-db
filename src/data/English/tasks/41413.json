			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "Hey, Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130202,
					"content": "Traveler! Ah — excuse me. I should address you as Honorary Knight under the circumstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130203,
					"content": "I suppose you heard? You're this year's Windblume Star. You will be making an offering of Windblumes to the Anemo Archon, Barbatos, on behalf of the whole of Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130204,
					"content": "...Although... things will be a little different this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130205,
					"content": "*sigh* ...Yeah... But with us and the Tone-Deaf Bard here, this year's Windblume Festival is sure to be bigger than ever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130206,
					"content": "That is true... Thank you for taking up residence in Mondstadt, and I hope you continue to enjoy Mondstadt life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130207,
					"content": "Oh! The Windblume Ceremony is about to begin. Windblume Star, have you chosen your Windblume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130208,
					"content": "So we choose one type of flower, then offer it to the Anemo Archon, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130209,
					"content": "Exactly right. Please consider your choice carefully. Remember, you are representing the whole of Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130210,
					"content": "Venti, what kind of flower do you like?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "Eh? ...Very cunning, trying to cheat, are we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130212,
					"content": "Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130213,
					"content": "Hey! Don't you two go spilling secrets during an occasion like this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130214,
					"content": "Haha, they told us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130215,
					"content": "Don't worry about me, choose something you like! I trust your tastes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130216,
					"content": "So, Honorary Knight, what is your choice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130217,
					"content": "Dandelion",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "Ahhhh... throwing your weight behind one of the people's favorites! Windblumes must be dandelions after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130229,
					"content": "On behalf of the people of Mondstadt, please offer your Windblume to the statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130219,
					"content": "Windwheel Aster",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "Ahhhh... Throwing your weight behind one of the people's favorites! Windblumes must be Windwheel Asters after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130221,
					"content": "Cecilia",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "Oh! Same idea as Beatrice, Cecilias for Windblumes. Pretty niche, but not without advocates!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130223,
					"content": "Small Lamp Grass",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "Oh! Same idea as Nimrod, Small Lamp Grass for Windblumes... A flower to light up the dark!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130225,
					"content": "Sweet Flower",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "Oh! Same idea as Sucrose, Sweet Flowers for Windblumes. A flower that has lasted through the ages!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130227,
					"content": "Wolfhook",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "Oh! Same idea as Razor, Wolfhooks for Windblumes. Spiky and tingly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141304,
			"completionStepIds": [
				4141304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141304",
							"2"
						],
						"stepId": 4141304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130401,
					"content": "Thank you, Windblume Star, for your sincere Windblume offering to the Anemo Archon, Barbatos. May the wind protect Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130402,
					"content": "Huh, interesting choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130403,
					"content": "You like it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "Hehe, take a guess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130405,
					"content": "Typical Tone-Deaf Bard, stop making people guess all the time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130406,
					"content": "Ahahahaha! Okay, okay, I'll tell you. But not here though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130407,
					"content": "Not a good idea with so many people in the plaza... Change of surroundings needed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130408,
					"content": "Where should we go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130409,
					"content": "I want you to come with me to Stormterror's Lair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141307",
							"2"
						],
						"stepId": 4141307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "Ah... now this is a view.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130702,
					"content": "The scenery is beautiful.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "Isn't it? I am fond of this place. Sometimes, when I've got nothing else to do, I come here just to sit and gaze awhile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130705,
					"content": "You mean sit and laze around?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130706,
					"content": "Hahaha, guilty as charged!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130707,
					"content": "...It's so beautiful... if only we had some cider in hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130708,
					"content": "So, Traveler. The Mondstadt Windblume Festival. Do you like it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130709,
					"content": "It's full of love and cheer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "And yet, you still have something you wish to ask, do you not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130712,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "I know your question. What are Windblumes, exactly? And what do Windblumes and the Windblume Festival mean to Barbatos, the Anemo Archon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130714,
					"content": "As you've seen, the people of Mondstadt each make their own choice. Out of the millions of flowers there are, some choose the dandelion, others choose the Windwheel Aster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130715,
					"content": "Huh... it does seem like \"Windblume\" means something unique to each person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130716,
					"content": "Correct, and long may that be the case. There is no single answer and no true Windblumes in existence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130717,
					"content": "So Windblumes... don't really exist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130718,
					"content": "The word \"Windblume\" dates from the age of Old Mondstadt. It was a code word that the people used to stay in contact and mount resistance in secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130719,
					"content": "At that time, the people often said that the stronger the wind blows, the firmer the roots of the Windblume grow, and the brighter the flowers that burst into bloom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130720,
					"content": "If you want my perspective, Windblumes don't exist. Yet they are all around us nonetheless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130721,
					"content": "They are the spirit of yearning for freedom, the courage to follow the wind wherever it may lead... All objects that are beautiful and worthy of blessing... All can be Windblumes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130722,
					"content": "You can't see them, but you can feel their presence everywhere... just like the wind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130723,
					"content": "Haha, well said.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130724,
					"content": "So what are Windblumes? Something that the Anemo Archon Barbatos will not define.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130725,
					"content": "Flowers of blessings, flowers of respect, flowers of love. Every individual has their own Windblumes, and every individual has the right to define them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130726,
					"content": "Guess it's no surprise that the type of flower given by the City of Freedom to its deity is in itself an expression of freedom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130727,
					"content": "I enjoy the feeling of freedom, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "I know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130729,
					"content": "It is people's shared will that brings them onto the same page. And surely, it is the wind of freedom that brought us together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130730,
					"content": "It comes from the end of the journey, the edge of the world, the depths of our hearts. It is ceaseless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130731,
					"content": "\"Who was it that stroked your bloodied, determined visage\\nBy stream flowing small\\nBy boulder standing large\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130732,
					"content": "\"Who was it that embraced your weary yet noble soul\\nIn dreams deep\\nIn skies soaring\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130733,
					"content": "\"Dear friend\\nI am leading you by the hand\\nInto the night where lanterns shine bright\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130734,
					"content": "\"To tell you a tale of freedom and dreams\\nThe tale of where this festival begins\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130710,
					"content": "It's great to be with everyone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "It's a pleasant atmosphere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
