				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "How's the painting going?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "I've been painting here at the side of those two statues since their eyes lit up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "But... How should I say this? I just feel like I haven't been able to paint that perfect picture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "It just feels like there's something missing, you know what I mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "It's like a dish that uses good ingredients and is cooked well, but... but something's just not there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "I don't know how to express this feeling, and I can't grasp it, either. All I can do is continue to paint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Don't worry, you can laugh. Really, all this drawing is making me a little woozy. And I would have taken a short break, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "But every time I close my eyes, I can suddenly see the shining eyes of those statues before me. It's as if they've come alive and are staring right at me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "Which is why I came back here to take a break. I shouldn't be able to see the statues' eyes from here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Ah, yes. Why don't you take this painting? It's the best one I've done so far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Now, if you don't mind, I'm really tired. I need a break.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Still, what are my paintings missing... What are they missing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}