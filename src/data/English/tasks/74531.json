			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}, Paimon, you're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310102,
					"content": "Took quite a few photos this time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "That's wonderful! Thank you so much for your help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310105,
					"content": "While you were busy taking those photos, I started thinking I can't just stand by and do nothing, or I'll never make any progress...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310106,
					"content": "So I worked up the courage to ask a few passersby for help, and I even managed to take quite a few shots myself! I think that should be plenty of data for testing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310107,
					"content": "#Heh, I knew you wouldn't let me down! Thanks to {NICKNAME} for stepping in as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310108,
					"content": "Lepine-Pauline! When did you get back? Ninette said you've been busy with something else lately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310109,
					"content": "Well obviously, it's a massive deal — enough to fill my pockets to the brim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310110,
					"content": "Things got pretty busy for me lately, so I'm really glad you were there to help Ninette out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310111,
					"content": "She's got the talent and the taste, that's for sure. She's just a bit shy. But with your help, she's really taken an important step forward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310112,
					"content": "So, what's this \"massive deal\" you've been so mysterious about? Don't tell Paimon you heard another wild rumor and went all in again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310113,
					"content": "What? Of course not! I've learned my lesson. This time it's the real deal — safe and sure to make a fortune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310114,
					"content": "(That doesn't sound entirely convincing...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "Hmph, if I tell you now, it'll ruin the surprise. Once it's done, you'll be the first to try it out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310103,
					"content": "The \"Shutterflash\" lens worked great.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
}