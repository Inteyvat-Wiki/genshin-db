			"dialogs": [
				{
					"id": 708160301,
					"content": "Did you manage to find them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160302,
					"content": "Got them right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708160303
					]
				},
				{
					"id": 708160303,
					"content": "Whew, that's a relief. I've always been using this map, so I've put down a lot of markings onto it. Losing it would have been a disaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160304,
					"content": "And if I had really lost my handbook, I don't know how I would have asked Katheryne for a new one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160305,
					"content": "I mean, what a joke, for an adventurer to lose their handbook during an adventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160306,
					"content": "Thanks, I'll keep these things close from now on. Please take these as a token of my appreciation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
