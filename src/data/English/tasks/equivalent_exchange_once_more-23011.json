				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Hmm... How should I carve this again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110102,
					"content": "Hi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Ugh, who's there? Stop bothering me already, I'm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110105,
					"content": "Eh!? Traveler!? What brings you here to Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110106,
					"content": "Come on, Rudolf can't have sent you to beat me up, right? I did nothing but send Lily a little gift way back when!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110107,
					"content": "I'm just stopping by...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "So you're still traveling. Just can't stop, can you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110112,
					"content": "But, you know... I didn't expect to see you here in Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110113,
					"content": "My original orders were to relocate from Mondstadt to Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110114,
					"content": "But another order came and I was sent to Sumeru City to assist Mr. Vsevolod. Moreover, I was told that I was being transferred to Lord Pulcinella's command.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110115,
					"content": "Pulcinella?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Yes... Well, no. I shall stop here, or Mr. Vsevolod would criticize my insensitivity to affairs of confidentiality.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110118,
					"content": "*sigh* The names of our Lord Harbingers are no secret. I can never understand why he's so antsy about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110119,
					"content": "So, what are you doing in Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Oh, Mr. Vsevolod and I are mainly responsible for logistical support and coordination. In short, we go shopping a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110121,
					"content": "It doesn't sound like a big deal, but it's certainly nicer than idling away in the Mondstadt Cathedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110122,
					"content": "Hehe, my current job also comes with lots of free time, and no one's keeping an eye on me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110123,
					"content": "So I picked back my childhood wood carving hobby back up. And guess what, Sumeru happens to be rich in wood. Perfect for practice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110124,
					"content": "And you know what? My wood carvings are actually popular among kids. They have been bothering me about it, so I promised to carve one for them each.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110125,
					"content": "Aren't you with the Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "Yes, so what? I mean... Who says a Fatuus can't make toys for kids?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110127,
					"content": "Besides, I'm just the supply guy. As for all those fancy great deals, I'll just leave them to the Lords.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110130,
					"content": "All in all, that's the situation here. I wasn't able to return to Snezhnaya, but I kinda like Sumeru. There's food, entertainment, and a pretty nice environment here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110131,
					"content": "After work, I just grab some food and get myself a nice sunny spot for some wood carving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110132,
					"content": "However... Haha, everyone gives me those skeptical looks, just like the one you gave me when we first talked.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110133,
					"content": "But there's nothing I can do. I'm a Fatuus after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110134,
					"content": "I still don't really trust you even now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Okay... Basically, I'm quite happy with my life now, and I even managed to keep some savings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110137,
					"content": "If these days continue, I might just settle down here in Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110138,
					"content": "Ahem, well, that's enough of that. Now that you're also here, Traveler, let's continue our \"equivalent exchange,\" if you're in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110139,
					"content": "But I'm also out of stories, so your payment will be in real currency this time around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110140,
					"content": "Well, that works better for me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Alright, let me make the commission clear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110144,
					"content": "I ordered some wood from Hamawi lately, but it hasn't been delivered yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110145,
					"content": "I can't go talk to him during working hours, or Mr. Vsevolod will scold me for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110146,
					"content": "Traveler, would you please do me a favor and ask Hamawi about my wood delivery?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110147,
					"content": "Just get my payment ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Rest assured. I won't let you down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110151,
					"content": "Anyway, I'll leave this to you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110149,
					"content": "You sure you're not up to anything...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Come on, when did I play dirty tricks in our trades before? Don't worry, I can't be bothered, anyway... What's wrong with a peaceful, simple life?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110141,
					"content": "Am I taking commissions from the Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Of course not, you'll just be doing commissions for Viktor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110135,
					"content": "Who says I trust you now? Stop cottoning up to me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "You're not trying to pump the kids for information... Are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Hey! I'd never do that! What's with your horrible stereotype of us Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110116,
					"content": "Another Harbinger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "That's right, come back to Mondstadt with me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Ha, ha, ha, alright. Want a pair of shackles to lead me away while you're at it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110111,
					"content": "Okay, enough joking around. I've got things to deal with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110103,
					"content": "V—Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
