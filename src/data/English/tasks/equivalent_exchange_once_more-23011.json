			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hamawi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110301,
					"content": "What awful luck...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110302,
					"content": "About Viktor's wood delivery...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "Are you talking about the wood that the Fatuus ordered?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110304,
					"content": "*sigh* I knew dealing with the Fatui wouldn't end well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110305,
					"content": "We were attacked by monsters while transporting that wood. All of us made it back alive, but our cart didn't. We were forced to leave the wood by the roadside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110306,
					"content": "I dare not go over there, nor can I find someone to get rid of those monsters so soon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110308,
					"content": "We aren't Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "Aren't you a Fatuus? Then why are you helping him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110310,
					"content": "Anyway, I can only leave my cart there for now and see if I can hire someone to deal with the situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
