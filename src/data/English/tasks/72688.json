			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726880101,
					"content": "We meet again, you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880102,
					"content": "The previous \"floral courtyard\" was a pleasure to behold indeed. You are both most talented, to have grasped the essence of the art so quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880103,
					"content": "The new theme awaits your perusal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880104,
						726880110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880104,
					"content": "Well, let's begin, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880105
					]
				},
				{
					"id": 726880105,
					"content": "Yup! We're ready as can be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726880106,
					"content": "Haha, such a vivid sparkle there in your eyes, almost like they reflect a radiant sea of flowers. Most lovely indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880107,
					"content": "In that case, today's theme is slightly harder than the last one, all the better for you to refine your craft with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880108,
					"content": "\"Silken and sturdy, the lotus in the pond.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880109,
					"content": "Ponder the meaning of this theme and select your flowers carefully to form a most special \"floral courtyard.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880110,
					"content": "I've got some other things to do at the moment...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880111
					]
				},
				{
					"id": 726880111,
					"content": "That's alright. Ikebana requires one's full attention, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880112
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880112,
					"content": "Once you have completed the various tasks you have on hand, rendering yourself free of disturbances, I'm certain that your floral courtyard shall be all the more perfect for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268801",
							"2"
						],
						"stepId": 7268801,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268803",
							"2"
						],
						"stepId": 7268803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fushizome"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "In the following days, I will continue to stay here and guide those who come for the Irodori Festival, and help them to enjoy the beauty of the \"floral courtyards.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870202,
					"content": "Don't forget to drop by every day to get another \"theme.\" There will be a total of four such themes for you to figure out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870203,
					"content": "Of course, if you have any other questions, I will do my best to answer them for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870204,
					"content": "About the flowers here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "The flowers I use are all provided by Sakuya's Flowers. The flowers they grow are of impeccable quality and affordable prices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870206,
					"content": "Perhaps you've met Sakuya as well. We once studied ikebana under the same master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870207,
					"content": "Sakuya is also very well-studied in the floral arts, but when she heard that there would be tons of people at the Irodori Festival, she seemed to have gotten a bit of stage fright. She said that it would be difficult to quiet down and focus on her work in such an environment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870208,
					"content": "In any case, I will advertise Sakuya's Flowers on her behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870209,
					"content": "We can help too if you need us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870219,
					"content": "Well then, do the two of you have any other questions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870220,
					"content": "Thank you, Ms. Fushizome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "Think nothing of it. If you have time, you can come and look for me any time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870210,
					"content": "About the Yashiro Commission's involvement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "The Yashiro Commission has always been very supportive of Inazuma's floral arts. Indeed, the person who sponsored this event is the Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870212,
					"content": "She has always been incredibly talented in these arts, even from a young age. I saw her perform ikebana once, and even had the honor of exchanging pointers with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870213,
					"content": "Although I'm older than her, I'm nowhere near her ability in terms of skill in ikebana or understanding of the floral arts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870214,
					"content": "Where circumstances have permitted, she has provided funding to help publicize ikebana every year. I've even heard that she has used her own savings to do so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870215,
					"content": "She once expressed her frank desire for more people to understand ikebana and to drum up more interest in it such that more might want to practice this art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870216,
					"content": "Huh. So Ayaka did so much for Inazuma's floral arts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870217,
					"content": "I hope her wish comes true.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "Thank you both. You are indeed good-hearted people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870222,
					"content": "I have no further questions at the moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "Alright, then. You can come and look for me any time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		}
	]
}