			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "Welcome. Every treasure here is unique, guaranteed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040102,
					"content": "Hehe... Yep, there's nothing here that Paimon recognizes, that's for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040103,
					"content": "Haha, what did I tell you! These are all rare items brought back by adventurers from all corners of the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040104,
					"content": "Is there anything that catches your eye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040105,
					"content": "It's all so exquisite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "No need! I forgot to mention, I operate on a trading basis. Goods for goods — no Mora accepted here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040108,
					"content": "I've been trying to make something a bit special recently, and I need a lot of <color=#00E1FFFF>Anemo Sigils</color> to decorate it with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040109,
					"content": "Do you have any <color=#00E1FFFF>Anemo Sigils</color> with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040110,
					"content": "I have a few.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "Haha, it seems the Anemo Archon approves of your adventures then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040114,
					"content": "More to the point, any <color=#00E1FFFF>Anemo Sigils</color> you find you can trade in here for items in the shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040115,
					"content": "Browse items.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "What are those?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "It's like a seal or emblem that the Anemo Archon gives to adventurers as a form of acknowledgment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040106,
					"content": "I daren't ask about the price!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
			"id": 2050403,
			"completionStepIds": [
				2050403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050403",
							"2"
						],
						"stepId": 2050403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "<color=#00E1FFFF>Anemo Sigils</color> appear all over Mondstadt. If you find yourself short, just keep exploring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040302,
					"content": "Are they really just for decoration?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "Absolutely! What could be more beautiful than a gift from the Anemo Archon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040304,
					"content": "Haha, okay, you got me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040305,
					"content": "It's actually more complicated than that, but it's easier for people to understand if I just say it's for decoration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040306,
					"content": "Obviously the reason I need <color=#00E1FFFF>Anemo Sigils</color> is because they have properties that other materials cannot provide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040307,
					"content": "Let me see it when it's finished.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "Haha, of course! I guarantee you will be quite surprised at the result.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040312,
					"content": "Do come again soon — and bring me lots and lots of <color=#00E1FFFF>Anemo Sigils</color> next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040313,
					"content": "Please also visit if you come across any weird and wonderful treasures on your adventures!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040309,
					"content": "I feel like you're making this sound more mysterious than it actually is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "But it's working... Paimon's curious now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040311,
					"content": "Haha! Well it wouldn't be much of a surprise if I gave everything away, now would it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				}
			]
		}
	]
}