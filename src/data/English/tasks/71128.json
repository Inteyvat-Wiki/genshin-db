			"dialogs": [
				{
					"id": 711280201,
					"content": "\"Once this tree gets a bit larger, I'll cut its leaves down and make some tea for all of you.\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280202
					]
				},
				{
					"id": 711280202,
					"content": "\"When that time comes, we'll get Cloud Retainer and Mountain Shaper to come over...\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280203
					]
				},
				{
					"id": 711280203,
					"content": "\"Seriously? You plant trees any way you like on my turf, and you have the nerve to spout such things?\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280204
					]
				},
				{
					"id": 711280204,
					"content": "...The day when the promises of yesteryear could be fulfilled arrived not, but the silent old tree still remembered the sound of that vow...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280205
					]
				},
				{
					"id": 711280205,
					"content": "...Today, the aroma of tea has long since permeated Chenyu Vale and been carried to distant lands far beyond...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
