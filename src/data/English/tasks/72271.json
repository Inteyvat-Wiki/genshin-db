					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710201,
					"content": "About the Dragonbone Orb...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710202
					]
				},
				{
					"id": 722710202,
					"content": "Oh, have you considered your options?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710203,
					"content": "I'll take that item for 80,000 Mora and 5 Bountiful Years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710204,
						722710207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710204,
					"content": "It's yours.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "Thank you for your patronage. Here's your Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710206,
					"content": "If you should find any other such treasures, we are always awaiting your patronage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710207,
					"content": "Let me think about it one more time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710208
					]
				},
				{
					"id": 722710208,
					"content": "No problem. After all, you should always check the prices on the market when you're planning to sell precious relics.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710209,
					"content": "You can come to me again once you've mulled the matter over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		}
	]
}