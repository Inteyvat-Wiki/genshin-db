			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "I've got some treasure I want to sell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "Oh, what rare objects have you found this time? Let me have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710104,
					"content": "You tell Linlang about the Dragonbone Orb.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "If what you see is true, this is a truly amazing relic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710106,
					"content": "But from a cursory examination, I can't find anything evidently special about it. Perhaps it requires extensive use to show its qualities...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710107,
					"content": "The way I see it, it does seem that the wondrous properties you ascribe to it might be a tad... exaggerated. Perhaps it was simply something entrusted to you by those who had failed in their task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710108,
					"content": "Don't take it to heart, though. I'm just saying what's coming to my mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710122,
					"content": "This is quite the common occurrence in our line of work, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710109,
					"content": "Also, I believe that you did not keep this in sealed storage — it does seem like there is some wear and tear on its surface already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710110,
					"content": "I'm afraid that there will be some price reduction on that front, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710123,
					"content": "How does 80,000 Mora sound? I can add 5 Bountiful Years on as specialty dishes as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710111,
					"content": "I believe that this is a good price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710112,
					"content": "...What will you use it for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "To be honest, I would consider the story behind it more valuable than its capabilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710114,
					"content": "I suspect that this might be of much interest to our storytellers and opera troupes, or perhaps the great men and women of Yujing Terrace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710115,
					"content": "It would be quite the ancient showpiece of a relic even if I were to simply mount it on our shop counter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710116,
					"content": "A fair price. Done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "My, that's quite forward of you. Well then, here's you Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710118,
					"content": "If you should find any other such treasures, we are always awaiting your patronage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710119,
					"content": "Let me think about it a bit more.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "No problem. After all, you should always check the goods — I mean, the prices — when you're planning to sell precious relics.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710121,
					"content": "You can come to me again once you've mulled the matter over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
			"id": 7227102,
