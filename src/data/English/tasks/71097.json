			},
			"dialogs": [
				{
					"id": 710970101,
					"content": "Have you found the Archaic Stones?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970102,
					"content": "Here they are.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "With these three included, it's nine in total. They should be enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970202,
					"content": "You managed to gather what Huishan Hall needs so quickly. No wonder they speak so highly of you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970203,
					"content": "Eh, it was easy! Easy-peasy, lemon-breezy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970204,
					"content": "I'm sure it's \"lemon-squeezy,\" Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "Eh? Uh, well, lemons can be breezy too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970206,
					"content": "Oh, look at you, forcing your logic through. Most impressive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "Haha... We've all witnessed your heroic deeds of fighting the sea monster. I believe it was no challenge for you to accomplish such a feat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970208,
					"content": "No challenge at all indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "Well, so much for working at the Ministry of Civil Affairs. They still ask you to do stuff like \"look for Archaic Stone in The Chasm\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970211,
					"content": "Speaking of which, you said you often argued with your father back then and didn't have a job.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970212,
					"content": "Then how did you make it into the Ministry later?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970213,
					"content": "You know how I owed a big sum at the time? I could turn to no one, nor was I willing to go home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970214,
					"content": "In the end, the debt collectors came looking for my old man at the Shenglu Hall... I thought he'd come find me to break my legs upon hearing the news.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970215,
					"content": "But your legs look fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970216,
					"content": "Yes... It's embarrassing to say, but he cleared my debt and came looking for me. By the time he found me, I was almost like a beaten-up dog on the street. He said, \"I have all your IOUs, so now you're indebted to me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970217,
					"content": "With that, he forced me to work — to pay my debt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970218,
					"content": "So your father is your creditor now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970219,
					"content": "You can say that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970220,
					"content": "Back then, with the debt collectors after me, I couldn't even fall asleep at night. So, I swore that I'd mend my ways if I was given a second chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970221,
					"content": "But I didn't expect the chance to come from my father, who always disapproved of my behaviors...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970222,
					"content": "He didn't lash out at me as usual. Instead, we had a talk — an honest and sincere one. How I wish we could've talked this way earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970223,
					"content": "But even if he'd been open for a talk, I wouldn't have been willing to listen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970224,
					"content": "Looks like your father treats you well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970225,
					"content": "Yeah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970226,
					"content": "So I have to get my job done well under whatever circumstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970227,
					"content": "Whether it's the incident in The Chasm or the search for Archaic Stone requested by Huishan Hall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970228,
					"content": "I believe I'm the one who did the job for you this time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "Having people get the job done also counts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970230,
					"content": "But still, it's all thanks to you that we moved swimmingly — I'd say it was way more quickly than I expected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970231,
					"content": "Huh, Paimon finally senses a touch of gratitude there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970209,
					"content": "It's actually a bit of a challenge...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}