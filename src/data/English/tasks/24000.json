					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Caron"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240000301,
					"content": "So tiring... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000302
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 240000302,
					"content": "About the External Assisting Personnel Registration Form...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000303
					]
				},
				{
					"id": 240000303,
					"content": "You describe Livre's experiences and desire to borrow the form...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000304
					]
				},
				{
					"id": 240000304,
					"content": "This happens pretty often when you're dealing with the Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000305
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 240000305,
					"content": "I do have an extra form, so you can pass it to him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000306
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 240000306,
					"content": "But I wouldn't let him get his hopes up about the Palais's work efficiency.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000307
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 240000307,
					"content": "Even if the form is submitted, it will take some time for the formal allocation of funds. And there's no use pressing them for it either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caron"
				}
			]
		},
		{
			"id": 2400004,
