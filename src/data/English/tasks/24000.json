			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Estelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240000201,
					"content": "What a pain... It's only a bit of Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000202,
					"content": "About the External Assisting Personnel Registration Form...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "You describe Livre's experiences and desire to borrow the form...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "*sigh* Tough luck for Livre... I'm afraid I haven't any extras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000205,
					"content": "I brought a staff member from the store to assist me when I was repairing street lights at the Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000206,
					"content": "Now, he was barely any help at all, so I didn't put his name down in the form.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000207,
					"content": "But when it came time to hand the form in, Clapiers insisted that I put every last name down...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000208,
					"content": "He even said that there would be \"serious, unpredictable consequences\" if I did not fill it out truthfully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000209
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000209,
					"content": "Seriously, it's just one missing name. What serious consequences could that lead to? Preposterous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
		{
			"id": 2400003,
			"completionStepIds": [
				2400003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
