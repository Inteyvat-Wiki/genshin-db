			},
			"dialogs": [
				{
					"id": 722250101,
					"content": "Ouch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME}! Paimon! You're just in time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250103,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "Ow, ow, ow, think I sprained my ankle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250105,
					"content": "Big Brother Ku's hurt again. Could you please help us make offerings at the Perch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250106,
					"content": "You know, I have to admit that I expected this development...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "Don't you worry about a thing! We've got this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250109,
					"content": "Thanks so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250110,
					"content": "Ooh, right! Aren't you very sensitive to the elements and all, Ruu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250111,
					"content": "Why don't you do that yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250112,
					"content": "Uh... So, I did try before in previous ceremonies, but it didn't turn out so well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250113,
					"content": "Why did that happen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "I... don't know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250117,
					"content": "Ah well. Guess we're handling this perch business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250115,
					"content": "Then I'll do it in your stead.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "We'll leave the injured person to you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
		{
			"id": 7222502,
