			"dialogs": [
				{
					"id": 722250201,
					"content": "Please help us with the Perch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250202
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250202,
					"content": "I'll stay here with Big Brother Ku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
		{
			"id": 7222503,
			"completionStepIds": [
				7222505
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7222505",
							"2"
						],
						"stepId": 7222505,
						"stateName": "QUEST_STATE_UNFINISHED"
