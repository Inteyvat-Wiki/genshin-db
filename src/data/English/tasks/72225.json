				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ruu",
					"Ku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "Ooh, the Perch is all lit up now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250302,
					"content": "Guess that's that done. Sorry, I imagine that it was pretty rough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250303,
					"content": "Hehe! We're specialist problem solvers, don'cha know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250304,
					"content": "It's not that different from the Light Actuating Ceremony.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "Going to three spots to fix three smaller problems to solve a larger issue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250306,
					"content": "It feels like we've had this happen to us a lot, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250307,
					"content": "I don't really understand a lot of what you said, but the adults do have this saying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250308,
					"content": "They call it \"The Rule of Three.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250309,
					"content": "What's that supposed to mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250310,
					"content": "Well, I guess they just mean that you need to do things thrice in order to get a result.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250311,
					"content": "For example, they say that \"good omens must occur three times for good fortune to truly descend\"... Same for bad omens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250312,
					"content": "They also say that \"you must forge past obstacles three times to succeed on the fourth.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250313,
					"content": "But isn't that more like the \"Rule of Four,\" then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250314,
					"content": "Huh, that's true! You're really good at numbers, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250315,
					"content": "Hehe, of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250316,
					"content": "How is that the point?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "Anyway, are you sure Ku will be fine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250319,
					"content": "Don't worry, he's always like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250320,
					"content": "Ugh, what an embarrassment... I just hope this won't affect the ceremony.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250321,
					"content": "I wouldn't know how to face you if it does, Ruu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250322,
					"content": "Oh, don't be like that! You've always been so nice to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250323,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME}, Paimon, you two go ahead first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250325,
					"content": "I'll stay here with Big Brother Ku. We'll take charge of the cleanup work once you're done with the offering!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250318,
					"content": "How's Ku's injury, by the way?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
		},
