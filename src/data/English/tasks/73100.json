				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Araminali knows the Golden Nara is a good Nara who helped Aranara. So Araminali's \"treasure chests\" are for Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310003,
