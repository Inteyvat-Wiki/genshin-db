			"dialogs": [
				{
					"id": 731000601,
					"content": "#Araminali is not ready! The \"treasure chests\" are still hungry. Nara {NICKNAME} and Paimon can \"lazy about\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000602,
					"content": "#Hmm, no, not right. Nara {NICKNAME} and Paimon can \"roam around.\" That way, might run into Aranara in need of help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
