				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#Nara {NICKNAME} wants to open the \"treasure chests\"? But... There are still a lot of Aranara in need in Vana, if the Golden Nara can help these Aranara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000102,
					"content": "Araminali will fill the \"treasure chests\" with treasure! Together with the \"good stuff\" sent back by Aranimba, the \"treasure chests\" will be filled with good stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
