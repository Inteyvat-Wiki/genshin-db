					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#Araminali heard that Nara {NICKNAME} was \"showing off {M#his}{F#her} skills\" in Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000302,
					"content": "#\"Treasure\" has been put in the \"chest,\" Nara {NICKNAME} can open the \"treasure chest,\" \"you are welcome\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#Nara {NICKNAME}, and Paimon, hurry up! Araminali's treasure chests are ready, and Araminali has been waiting for a long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000402,
					"content": "Aranara's good friends. \"Treasure chests\" have been filled up. Time to open them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#Araminali has been told by many Aranara that Nara {NICKNAME} and Paimon did a lot of good things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000502,
					"content": "Araminali already knew it. Those praise words, running through the branches of the forest, wading through the trickle, along with the breeze, are blown into the \"happy nest\" of Araminali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000503,
					"content": "#So this time, Araminali filled the \"chests\" up and wait for Nara {NICKNAME} to open.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000504,
					"content": "#The sparkling things brought back by Aranimba were also stuffed in the \"chests.\" Maybe Nara {NICKNAME} will like them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000505,
					"content": "Didn't Aranimba come back?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "Well, unlike a big tree with a deep root. Aranimba is the kind of Aranara who doesn't stop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000507,
					"content": "Eh... Won't Araminali be lonely here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000508,
					"content": "What does \"lonely\" mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000509,
					"content": "Um... That is, when you are alone, you really want to have someone around you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000510,
					"content": "There are many Aranara in Vanarana so Araminali is not \"lonely\" at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000511,
					"content": "With that being said, Arayama and Aranimba are no longer in Vanarana. These three Aranara used to stick together, and they were so happy no matter what they did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000512,
					"content": "Arayama's Ararakalari is very strong. Weak Nara can do nothing about it. Aranimba is very good at painting, all kinds of things, all look good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000513,
					"content": "But now, there are only Araminali and his \"treasure chests.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000514,
					"content": "Araminali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000515,
					"content": "It's fine. Araminali has many \"treasure chests,\" although Araminali doesn't know why Nara likes opening chests...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000516,
					"content": "But Araminali is the owner of the \"treasure chests.\" Nara, who likes treasure chests, also likes Araminali, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000517,
					"content": "However, Araminali has no more \"treasures\" left, um... the \"chests\" will be empty for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000518,
					"content": "#Though Araminali's \"treasure chests\" are about to be empty, Nara {NICKNAME} will still be Aranara's good friend, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
