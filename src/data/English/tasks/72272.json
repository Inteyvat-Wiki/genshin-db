			},
			"dialogs": [
				{
					"id": 722720102,
					"content": "I've got some treasure I want to sell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "Eh? Well, to tell you the truth, we've managed to restore a regular supply of goods, and we don't really make collecting odds and ends a habit, in any case...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720104,
					"content": "But just from looking at you, I think it's safe to assume that it's something most interesting indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720105,
					"content": "Well... Why don't you let me have a look at it, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720106,
					"content": "You tell Mikoshi Genichirou about the Dragonbone Orb.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720108,
					"content": "I'll be honest with you. While this is quite the curious tale, it does seem a bit too out there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720109,
					"content": "This object falls somewhat outside my area of expertise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720110,
					"content": "Please, don't scoff. I am but a mere craftsman myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720120,
					"content": "How about this, then? 80,000 and 5 Sashimi Platters. Those dishes aren't cheap by any means, mind you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720111,
					"content": "If you agree to this price, I will buy this treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720112,
					"content": "...What will you use it for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "I'm not sure at the moment. I'll need to give it some thought.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720114,
					"content": "If the situation is right, I might be able to modify this into a special netsuke and sell it for a decent price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720115,
					"content": "A fair price. Done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "In that case, please take this Mora. As for me, I'm going to go look into this item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720117,
					"content": "Let me think about it a bit more.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "Fair enough. I need to give this a little thought myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720119,
					"content": "You can come to me again once you've thought things over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				}
			]
		},
