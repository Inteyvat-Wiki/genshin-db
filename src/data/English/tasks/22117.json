			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211701",
							"2"
						],
						"stepId": 2211701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "Oh, please tell me I didn't leave it at the top of the mountain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170102,
					"content": "Hey granny, fancy meeting you here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "Well! Fancy running into you youngsters at a place like this! What are the chances... But, you should have put on more layers, you know. It's windy up there, you'll catch a cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170104,
					"content": "I was just on my way back to the city from Mt. Hulao. I went up there to see an old friend of mine, and we had a delightful chat about the old times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170105,
					"content": "But halfway back, I've suddenly realized I've forgotten something. *sigh* I must have left it up on the mountain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170106,
					"content": "At my age, I don't think I could make it all the way up there a second time in one day... It's such a long distance, and there's all that bothersome amber up there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170107,
					"content": "Youngsters... Could you fetch it back from the mountain top for me? I'd be ever so grateful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170108,
					"content": "Who is this old friend?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "You know, the one who lives on Mt. Hulao. You must have met him. That amber of his is a real nuisance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170110,
					"content": "My memory must be going. Honestly, how could I forget to put the box in my teapot before I left...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170111,
					"content": "What did you leave up there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "A box... I think. My memory is not what it once was... Why didn't I just put it in my teapot straight away? Would've saved me so much hassle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170113,
					"content": "At least if it is up in the mountains, the chances are it will have become trapped in amber. So finding it once you're up there shouldn't be too difficult.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170114,
					"content": "Youngsters, please make a poor old lady's day. Fetch it back from Mt. Hulao for me, would you? The part where all that amber is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170115,
					"content": "Mind yourselves, though. Who knows what else might be encased in amber after all these years...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 2211703,
			"completionStepIds": [
				2211703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211703",
							"2"
						],
						"stepId": 2211703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "Silly child, why ever didn't you wrap up warm before you came out? I'd feel terrible if you were to catch a cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170302,
					"content": "Hi granny, is this what you lost?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "Let me take a look... Ah yes, that's it. So I did leave it up there, after all. My memory is so hopeless these days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170304,
					"content": "I'll take it now, thank you. All it contains is a few old bits and bobs anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170305,
					"content": "These, on the other hand, are for you. Thank you dears.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170306,
					"content": "Now to put this box in my teapot before I forget...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 2211704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
