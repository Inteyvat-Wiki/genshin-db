				"points": []
			},
			"dialogs": [
				{
					"id": 221170401,
					"content": "Silly child, why ever didn't you wrap up warm before you came out? I'd feel terrible if you were to catch a cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170402,
					"content": "Tell me about the amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "My old friend makes it. He says it catches monsters and bandits on their way up the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170404,
					"content": "It's been around a very long time indeed. Honestly, that amber has trapped some very peculiar things over the years...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170405,
					"content": "It really is a ghastly substance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170406,
					"content": "How's the teapot these days...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "Oh, it's spick and span once again now. All thanks to you, of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170408,
					"content": "In fact, the whole reason I came all this way to collect that thing was to spruce up my teapot a little further.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170409,
					"content": "Once it's both spick and span and in tip-top condition, I'll finally be able to treat my guests to tea again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		}
	]
}