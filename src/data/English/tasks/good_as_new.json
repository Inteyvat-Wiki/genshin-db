			"dialogs": [
				{
					"id": 736810101,
					"content": "Hello, Traveler, Paimon. I've heard that you've been participating in the Fecund Hamper event. Was it fun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810102,
					"content": "It's been pretty fun! Paimon isn't sure if it's because there was this market during Weinlesefest, but we got all sorts of decorations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736810103,
					"content": "Haha, there are indeed people who would prepare those as gifts. Right, since we're running a snack shop, do you want to put some of those decorations here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810104
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810104,
					"content": "Prettying the shop up could help us attract more customers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810105
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810105,
					"content": "Besides, I'm sure the gift givers would be happy to see their sincere gifts being used in your shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810106,
					"content": "#Good point! C'mon, {NICKNAME}, let's decorate our shop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
