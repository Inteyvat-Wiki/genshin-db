			},
			"dialogs": [
				{
					"id": 748000501,
					"content": "Ah, right... That's true...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000502,
					"content": "Coffee's getting cold.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "We're already finished drinking.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Well, thank you, {NICKNAME}. And thank you for escorting me here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000505,
					"content": "You say \"escort,\" but all we did was walk with you here. We didn't do anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000506,
					"content": "Nothing bad happened.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "And you encountered no danger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "Yes. It appears I really was overthinking it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000509,
					"content": "This coffee is really great, haha... ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000510,
					"content": "...So, do you think it's poisoned?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000511,
					"content": "...*psfffsh*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "Would it kill you not to say things like that for two seconds!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "Stop saying that kind of baloney! We finished drinking already, and we're fine, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000514,
					"content": "No, no, no, perhaps it is a... special sort of poisoning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000515,
					"content": "First, the poisoner mixes a kind of medicine into our coffee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000516,
					"content": "Drinking that medicine alone will have no effect whatsoever on the victim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000517,
					"content": "After we have finished our poisoned drinks and gone home, the poisoner will follow us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000518,
					"content": "And as we sleep, he will enter our room, and mix a second kind of medicine into your water bottle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000519,
					"content": "The next day, after you're out and about, you'll take a drink from your water bottle. Then, the two medicines will mix and react within your body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000520,
					"content": "And then we'll...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000599,
					"content": "The sound of hurried footsteps suddenly draws near...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "My dear customer, just what are you saying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000522,
					"content": "Coffee? Poisoned? Please do not make such jests in my establishment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000523,
					"content": "Should your japes affect the other customers, I shall have to ask you to leave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000524,
					"content": "Sir, allow me to explain...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "She's a friend of mine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "You explain Guijarro's situation to Arouet. After listening, he leaves, exasperated...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
				},
				{
					"id": 748000527,
					"content": "By way of apology, Guijarro buys another three cups of coffee...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000528
					]
				},
				{
					"id": 748000528,
					"content": "You watched him make the coffee this time! There's no way there could be a problem with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000529,
					"content": "Stop imagining things.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000530
					]
				},
				{
					"id": 748000530,
					"content": "I know, I know, but... I did find a lot of inspiration along the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000531
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000531,
					"content": "If I just put it all together, I'm sure I can think of how the perfect crime — one that leaves no trace — could be committed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000532
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000532,
					"content": "After I finish writing the book, I'll be sure to send you a copy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000533
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000533,
					"content": "But before that, let me finish this cup of coffee, this cup... of coffee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000534
