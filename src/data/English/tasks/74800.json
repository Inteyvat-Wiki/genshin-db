				]
			},
			"dialogs": [
				{
					"id": 748000401,
					"content": "Why are you hiding again? There's nothing around here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000402,
					"content": "Can't you see that Gardemek? It's right in front of us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000403,
					"content": "Is something wrong with it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Shh! Quick, get out of there! What if it goes out of control?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000406,
					"content": "Or maybe its... its power core will suddenly explode! Or someone controlling it remotely will use it to attack us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000407,
					"content": "It looks completely normal to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "That is exactly what makes me so scared! A meka that is operating normally suddenly losing control, and some poor unfortunate sop suddenly losing their life...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000409,
					"content": "Nobody would even be held responsible for such a thing! Perhaps the true culprit would never be found... No, it's simply too dangerous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000410,
					"content": "It already left, you can come out now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000411,
					"content": "Phew... It didn't go out of control, truly unexpected. Our lives have been spared yet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000412,
					"content": "That kind of accident just isn't possible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "What I was thinking of, was more of an \"intentional accident.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000415,
					"content": "Wait. But criminal events without a culprit... A crime that no individual will be held solely responsible for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000416,
					"content": "That's it! Inspiration has struck! Quickly, quickly, to the café! I must write this down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000417,
					"content": "Hey! Slow down, aren't you worried someone'll toss a rock and trip you or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000413,
					"content": "It wasn't going to go berserk in the first place, capeesh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "Uh... and?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
		{
