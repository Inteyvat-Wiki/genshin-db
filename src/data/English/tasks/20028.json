				"points": []
			},
			"dialogs": [
				{
					"id": 200280101,
					"content": "#Th—Thank you kindly, {M#sir}{F#ma'am}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280102,
					"content": "I may be a hunter by trade, but I've sure met my match with these darned slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280103,
					"content": "Thanks to them, once again I got nothing to show for this hunt. Ain't caught squat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280104,
					"content": "I sure hope them other hunters ain't as unfortunate as me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280105,
					"content": "Speaking of slimes and such... Could you take a look-see around here for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280106,
					"content": "It could just be my imagination, but... they seem to be showing up more and more 'round this town.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280107,
					"content": "Can you check the road ahead for slimes? If you see any... you know what to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280108,
					"content": "Sure, I have time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "You're doing me a great service. Well, I'd better get back and report all this to Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280111,
					"content": "Here's hoping he isn't so drunk that it goes in one ear and out the other!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timid Morrow"
				},
				{
					"id": 200280109,
					"content": "Sorry, I have to get back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "#Please {M#sir}{F#ma'am}, if not for me, then for the sake of everyone in Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timid Morrow"
				}
			]
		}
	]
