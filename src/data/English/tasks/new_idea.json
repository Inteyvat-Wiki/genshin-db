			"dialogs": [
				{
					"id": 766562001,
					"content": "#Hello, {NICKNAME} and Paimon. Thanks to your help, I've finished making adjustments to the robots you found previously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562002
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562002,
					"content": "Ooh, the gang's all here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562003,
					"content": "So far, I haven't run into any new problems, but what I have run into is a new idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562004
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562004,
					"content": "#When you track down the other robots, {NICKNAME}, can you pay attention to any of their special behaviors?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562005
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562005,
					"content": "\"Behaviors,\" meaning...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562006,
					"content": "Well, that'd be... how they interact with each other, I suppose? Ah, it should be much more obvious once we've recovered enough of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562007
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562007,
					"content": "Okay... Well, leave it to us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562008,
					"content": "Thank you both! I'll mark the next area on your map...",
