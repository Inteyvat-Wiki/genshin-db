				},
				{
					"id": 710590601,
					"content": "Uh... There's no sign of anyone. What are we supposed to tell Katya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590602,
					"content": "Well, Paimon guesses there's not much we can do. Let's head back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "These are... insignias, action logs, and... note?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591306,
					"content": "Please tell me where Kolya is. Is he still alive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591307,
					"content": "We didn't find him, but he's probably still alive.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "Kolya would never desert and abandon me. I'm sure of it, I just know it. He wouldn't run away in the face of a battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591310,
					"content": "Where did you find these?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591311,
					"content": "A cave in the southeast. Let me mark it out for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "It's a creepy place with many monsters inside it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591313,
					"content": "Th—Thank you... I'm sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591314,
					"content": "I... I hope Kolya sold his life dearly. I'd rather that's what happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591315,
					"content": "Kolya, please don't bring shame to the Tsaritsa. Don't bring shame on me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591316,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "Ahem, I—I'm fine... Just got a bit sentimental there. It just occurred to me that I haven't properly thanked you two!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591318,
					"content": "Oh right, here's some Fire-Water... *sigh* But you don't drink, do you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591319,
					"content": "I have some Mora...and some other materials that I collected. They are of no use to me now, so please take them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591320,
					"content": "What's your plan next?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "What's my plan next? Thank you for asking, but I don't need you to assist me in my \"evil-doing\" anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591323,
					"content": "Well, I'll go looking for Kolya, perhaps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591324,
					"content": "He wrote me a letter before I was redeployed, which I have with me. For me, it's the only evidence left that proves his existence, and I'll carry it with me, forever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591325,
					"content": "If he's still alive... As a Fatuus loyal to the Tsaritsa, I'll hunt this traitor down and kill him, wherever he goes or hides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591326,
					"content": "If he is no longer in this world... As his older sister, I will embrace the inevitable fate of every Fatuus and will be proud of him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591327,
					"content": "When we say \"if not us, then who\"... Well, this is what that means.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591328,
					"content": "What if you're up to something evil and I must stop you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "...There's always a moment when you're left with no choice. And we all have things that we must do, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591333,
					"content": "You're too serious. I mean, I get it. Kids who haven't grown old enough to hold their liquor tend to get drowned in all sorts of strange worries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591334,
					"content": "I mean, we'll see, won't we? Let's see what I'll do when I need to face the final, inevitable choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591335,
					"content": "But for now, what I need is to take a nap... Wanna rest too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591336,
					"content": "There's only a straw mat here. That doesn't make a comfy bed! You're just trying to get rid of us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591337,
					"content": "Well, I don't see how that's my problem! Ah, I pity you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591338,
					"content": "But anyway, thank you for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591330,
					"content": "Do you always have to do it the Fatui way?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "Yes. Is that so strange?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591332,
					"content": "But anyway... Ideas, perspectives... What terribly boring avenues of inquiry! Pfft... Don't you go thinking that there are only ideas underneath my mask. I am certainly not bulletproof beneath it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591321,
					"content": "Do you need my help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "He might've escaped through a secret tunnel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "\"...I made it into this secret chamber. The mechanical monster is still lurking outside like a ferocious predator, just waiting for me to go out...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "Kapral Nikolay's Diary"
				},
				{
					"id": 710591402,
					"content": "\"...My left leg is badly wounded and it hurts like hell. I bandaged it up haphazardly, but it's swollen — could be a sign of infection...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "Kapral Nikolay's Diary"
				},
				{
					"id": 710591403,
					"content": "\"...The grotto has another exit, but I don't know where it leads. The structure of the exit looks tenuous. Without something to support it, it might collapse if exposed to violent force...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "Kapral Nikolay's Diary"
				},
				{
					"id": 710591404,
					"content": "\"...I've been spotted! Someone's coming. It's a... swordsman... clad in black?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "Kapral Nikolay's Diary"
				},
				{
					"id": 710591405,
					"content": "\"...He, no, it... Seems as though even metal bars are no obstacle for it. And just from looking upon it, I know this in my heart...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "Kapral Nikolay's Diary"
				},
				{
					"id": 710591406,
					"content": "\"...I'm sorry, Katya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kapral Nikolay's Diary"
				}
			]
		}
	]
}