			},
			"dialogs": [
				{
					"id": 710590401,
					"content": "You're back. Did you find anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590402,
					"content": "It's alright if you found nothing. Go get some rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590403,
					"content": "Don't you worry about me... I'm not anxious. After all, I kinda wanna stay here for my retirement. Maybe I'll ask you to deal with my pension application!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590404,
					"content": "Wow, you sure are getting some good rest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590405,
					"content": "Hmph, if you keep coming back here without bringing me any news... Who knows, you might just find me resting till I rest in peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
