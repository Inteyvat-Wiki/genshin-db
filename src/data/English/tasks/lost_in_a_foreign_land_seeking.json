			"dialogs": [
				{
					"id": 710590301,
					"content": "You're back. I have some Fire-Water to spare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590302,
					"content": "Haha, I'm not inviting you to drink. It can also be used to clean your wounds if you're injured.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590303,
					"content": "How is it? Did you find anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590304,
					"content": "We found this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
