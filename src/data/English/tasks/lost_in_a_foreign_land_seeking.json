			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "\"... Oh no! Katya's balalaika is broken. I somehow damaged it during the fracas. Gotta get it repaired before she chews me out...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "Shred of Kapral Nikolay's Diary"
				},
				{
					"id": 710590202,
					"content": "\"...Did our ancestors fight the calamity like this five hundred years ago? The Kapitan-Poruchik once said we knew not a hundredth of the grueling battles that our ancestors went through...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "Shred of Kapral Nikolay's Diary"
				},
				{
					"id": 710590203,
					"content": "(Many pages in the middle are tainted by some black substance. When you clean it off, the writing in ink is also rendered entirely illegible.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "Shred of Kapral Nikolay's Diary"
				},
				{
					"id": 710590204,
					"content": "\"...I can't stay here any longer. They could easily track me down through the black mud...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "Shred of Kapral Nikolay's Diary"
				},
				{
					"id": 710590205,
					"content": "\"...Next, I'm gonna go the opposite direction and lure them further away from the rest of the squad...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "Shred of Kapral Nikolay's Diary"
				},
				{
					"id": 710590206,
					"content": "\"...There's a hole near the ruined bastion on the southeast side. Maybe I can take that route...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "Shred of Kapral Nikolay's Diary"
				},
				{
					"id": 710590207,
					"content": "\"...Wish me luck. If not us, then who?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shred of Kapral Nikolay's Diary"
				}
			]
		},
