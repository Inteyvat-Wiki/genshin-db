			"trigger": {
				"objectNames": [
					"Little Meng",
					"Master Zhang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "Eh? These two ores aren't the same either?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300102,
					"content": "Of course not. The quality and price of anything forged from either of these types of ores would be completely different.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300103,
					"content": "Um, but... But this is all we have left of these two types, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300104,
					"content": "*sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300105,
					"content": "What are you two doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "Hi there, Traveler! I'm currently helping Dad check on the ironware that he's ordered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300107,
					"content": "Mister Blacksmith over here is totally the best! He said he'd forge me a small sword, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300108,
					"content": "But he says that there haven't been enough raw materials to go around the store lately, so Dad's batch of ironware might be delayed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300109,
					"content": "And I've got no idea when my sword will be ready, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300110,
					"content": "*sigh* Well, it can't be helped. We've been very busy lately, so we're more or less out of ore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300111,
					"content": "The areas where ore is most plentiful are also occupied by many monsters, so I dare not go mining there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300112,
					"content": "I can only try to tide this busy period over before asking an adventurer to escort me to an area where I can mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300113,
					"content": "But when will that be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300114,
					"content": "Actually, Traveler, I've heard that you're really good at beating monsters. Is that true?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300115,
					"content": "If it is, could you please help me out? Please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300116,
					"content": "Haha, alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "Traveler, are you going to check the situation out there? In that case, let me mark my usual mining spots on the map for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300119,
					"content": "Alright, that should do it. Be careful while you're there. Those places are crawling with monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300120,
					"content": "I'm counting on you then, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300117,
					"content": "I'll... see what I can do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
