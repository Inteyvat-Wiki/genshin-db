			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "How are things going there, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300202,
					"content": "They should be safe for now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "Wow, you're amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300204,
					"content": "Dad said that he will hire a few people to protect us while we're traveling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300205,
					"content": "I just hope those people are as good as you are, Traveler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300206,
					"content": "Mister Blacksmith, does this mean that you can continue mining and making the ironware now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 210300207,
					"content": "Hahaha, of course! Just give me a moment to prepare. I'll get those ores and be back in time to continue my work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Master Zhang"
				},
				{
					"id": 210300208,
					"content": "That said, there is a limit to how much ore I can carry by myself. With any luck, that area should be free of monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Master Zhang"
				}
			]
		},
