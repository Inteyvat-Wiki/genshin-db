			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ying'er",
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716600101,
					"content": "You're back! How are the Smoldersleet Potions performing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600102,
						716600105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600102,
					"content": "I just wish we could use it outside Domains.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600103
					]
				},
				{
					"id": 716600103,
					"content": "Yup! That would take the cake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600104,
					"content": "Oh? Seems like you liked it. Go on then, give us the details!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600108,
					"content": "You explain what happened during the test run in detail.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600109
					]
				},
				{
					"id": 716600109,
					"content": "It's just as you predicted, Ms. Ying'er!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600110
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600110,
					"content": "Our path for improvement is clear — we must somehow contain the sublimated substances within a set area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600111,
					"content": "Perhaps we could reverse the special characteristics of dandelions to create special excipients that can prevent the substances from being affected by the flow of air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600112,
					"content": "There is no precedent to such a method though, and we will need a great number of trials to prove its feasibility.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600113,
					"content": "Wow, Paimon couldn't make sense of that at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600114,
					"content": "Still, it feels like you made some important suggestions each time, Ms. Ying'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600115,
					"content": "Ah, I don't think I ever came up with such a detailed postulation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600116
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600116,
					"content": "Well, my hardworking alchemist, are you trying to fathom my depths, or are you just trying to please me through flattery?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600117
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600117,
					"content": "I—I'm just expressing my admiration for your knowledge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600118,
					"content": "Alright, alright. You'd best give it your all, now. Who knows? You might have to use some alternative sources of knowledge in the future, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600119
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600119,
					"content": "Don't forget to keep me posted once your research succeeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600120
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600120,
					"content": "Of course! When that time comes, I'll send you my best potions as a memento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600121
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600121,
					"content": "You know, Ms. Ying'er, if you have the time, would you like to come with us to Wanmin Restaurant...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600122
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600122,
					"content": "Oh, I'm afraid our academic exchange must come to an end for now. There are still many matters I must attend to at Scent of Spring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600123
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600123,
					"content": "Don't forget to drop by often~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600124
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 716600124,
					"content": "We will!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600125
					]
				},
				{
					"id": 716600125,
					"content": "Thanks, Ms. Ying'er!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600126,
					"content": "Ying'er leaves.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600127
					]
				},
				{
					"id": 716600127,
					"content": "*sigh* I couldn't say it in the end, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600128,
					"content": "But considering that I'd already given her so much trouble, it was probably for the best that I didn't take up any more of her time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600129
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600129,
					"content": "Alright then. We'll calm down a bit, and wait for a suitable opportunity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600130
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600130,
					"content": "What are you talking to yourself about, Timaeus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600131,
					"content": "Uh, N—Nothing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600132
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600132,
					"content": "Thanks for your help so far! As we agreed, I'll treat you both to a great meal at Wanmin Restaurant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600133
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600133,
					"content": "I'd almost forgotten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600134
					]
				},
				{
					"id": 716600134,
					"content": "Ooh, that's right! Alright, alright, alright! Time for a great big meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600135,
					"content": "You go to Wanmin Restaurant with Timaeus and have a hearty meal.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716600136
					]
				},
				{
					"id": 716600136,
					"content": "Whew! Paimon's super full!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600137,
					"content": "Actually, this research was pretty cool! You should bring us along next time you come to Liyue, Timaeus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600138,
						716600139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600138,
					"content": "You know, Paimon, somehow I doubt that you're in it for the research.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600140,
					"content": "C'mon! Paimon did help... ask for directions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600141,
					"content": "Haha! Whatever the case, thank you both so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600142
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600142,
					"content": "But once I return to Mondstadt, I'll be throwing myself into improving the Smoldersleet Potion, so I'm afraid I won't be coming back to Liyue for some time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600143
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600143,
					"content": "Maybe I'll have to ask you to help me deliver a letter. I mean, I still haven't properly thanked Ms. Ying'er for her help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600144
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600144,
					"content": "Eh? Weren't you two discussing stuff the whole time? Why didn't you just tell her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600145,
					"content": "*cough* Well, uh, Ms. Ying'er's manner of speech is just too... too special! I must consider my words very carefully, and in such cases, penning a letter is naturally superior to speaking face-to-face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600146
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600146,
					"content": "Well now, time presses. Let's head back to Mondstadt right now. Why, I can't wait to create the perfected version of my Smoldersleet Potion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600147
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 716600147,
					"content": "Traveler, do you get the feeling that Timaeus has been acting all weird ever since we said bye to Ms. Ying'er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600148,
					"content": "Paimon doesn't get it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600139,
					"content": "You're just here for the free meal, aren't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600140
					]
				},
				{
					"id": 716600105,
					"content": "I think there's room for improvement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716600106
					]
				},
				{
					"id": 716600106,
					"content": "That's true... For example, it would be better if we could use it outside Domains!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716600107,
					"content": "True. I was just discussing the issue with Ms. Ying'er. Please, give us all the details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716600108
					],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}