						760850602
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760850602,
					"content": "This one is delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760850603,
					"content": "It's my favorite so far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760850604,
					"content": "Wow! Finally, a drink that Columbina likes! Paimon's over the moon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Uhm... sorry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760850606,
					"content": "Let's summarize: No noticeable bitterness, never add fruit juice straight, and milk's okay but it's better without...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760850608,
					"content": "So this is a \"lighter-bodied\" drink...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Figuring out the pattern's a good thing! In the future, we'll know how to mix drinks the way you like 'em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "...In the future?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760850611,
					"content": "Of course, we're friends! Whenever you're feeling thirsty, you just let us know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Wait, is that why you aren't finishing your drink? You're not saving it because you think this is the last cup you'll ever taste, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "...Uhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760850614,
					"content": "It's fine, don't worry.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760850616,
					"content": "Thanks for the treat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
