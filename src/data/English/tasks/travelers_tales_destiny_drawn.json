					}
				]
			},
			"dialogs": [
				{
					"id": 727380101,
					"content": "Yes, that'll do. Just a quick and simple cleanup job...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380102,
					"content": "Ah, little one, you're just in time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380103,
					"content": "Just in time... In time for what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "Oh, look at you. I can tell you're thinking. \"Oh no, she's going to send me off on some pain-in-the-neck errand again, isn't she?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380106,
					"content": "Don't worry, I was just going to say that we've finished renovating the shrine and are preparing to roll out a brand-new service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380107,
					"content": "Now, I haven't had the chance to announce it yet, but here you are already. Wouldn't you agree that's good timing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380108,
					"content": "See this offering box beside me? There's going to be another place to make wishes here soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380109,
					"content": "Don't you already have fortune slips?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "That's different. Fortune slips are about telling fortunes, whereas this... is about making wishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380111,
					"content": "Now then, close your eyes, make a wish, write it down on a prayer plaque, then hang it up on this rack here, and maybe your wish will come true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380112,
					"content": "Can I wish for anything?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "Of course. But as for which wishes come true... That is up to the gods who watch over us all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380114,
					"content": "Powerless Guuji that I am, I can only help you in mortal matters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380115,
					"content": "I wouldn't mind making some new friends...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "If that's what you wish for, then why not try it out? Here, take this fortune paper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380118,
					"content": "It's left over from writing fortune slips. You can have it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380119,
					"content": "Try writing your wish there. That might make it more likely to come true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380120,
					"content": "Really?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "When have I ever lied to you? Hurry up now, little one, it's time to make your wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380122,
					"content": "Remember to write your wish on the fortune paper, then stick it to the prayer plaque and hang it on the rack...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380123,
					"content": "After that, your wish will be made.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380124,
					"content": "Yes. Nice and solemn. Very good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380125,
					"content": "Are you sure this'll work...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "Alright, little one, back to business with you. Remember to keep your ears pricked and your eyes open!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380127,
					"content": "After all, the person you wish to meet might just be sitting at some noodle stand, having themselves a lovely bowl... And bring me back one while you're at it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380116,
					"content": "I'd like to be reunited with some old friends...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "Hold on a second... Where's this going?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}