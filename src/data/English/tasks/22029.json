				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "*panting* You... are indeed formidable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "I... I have learned much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "Are you okay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "That's... alright. I just need to catch my breath...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "But you are so powerful that I would have believed it even if you claimed to have defeated a giant dragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "Actually, I have defeated giant dragons...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Hahaha... I believe you, of course. Thank you for training with me. I will remember what I have learned from this match.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "If you do not mind, please come and practice with me often from now on. Having a strong warrior such as yourself as my training partner... I am sure that I will complete that deed soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "\"That deed\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "Ahem... It's just a little wish I have on my mind. Thank you for your help. Please take these as payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Now, I need to go back and take a break. Your moves were most mighty indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "Sorry, I didn't control my strength back then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
