				"points": []
			},
			"dialogs": [
				{
					"id": 220290201,
					"content": "Did you hold back just now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290202,
					"content": "Don't worry about my pride. Please bring out all you have. I... must become stronger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2202903,
