			"dialogs": [
				{
					"id": 742250201,
					"content": "Thank you, my benefactor! God King be praised, I'm saved!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "Are you one of the legionnaires who defend this city? Or a valiant soul who happened by?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "In any case, allow me to introduce myself. Faustus am I, one of the Mercatores Exquisiti appointed by the God King himself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "I came here to transport spices from the southern realms... I did not think that those vile vishaps would surround me the instant I came ashore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "Vishaps? I didn't see any vishaps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "Hmm? My word, you truly are a mighty warrior — those foes were simply beneath your notice, I see!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "In any case, do take these. Yet I fear I must be short on pleasantries — these goods still need transporting into the city. Perhaps we shall meet again there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
