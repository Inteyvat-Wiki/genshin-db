				"objectNames": [
					"Rie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130501,
					"content": "Hi there, are you up for a chat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130502,
					"content": "Indeed. Have you read \"Onibudou,\" by any chance?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "I have. I like the main character a lot, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130504,
					"content": "But I've been having a hard time reading it lately...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130505,
					"content": "A hard time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "In the last few chapters, the main character was suddenly bestowed with all these new abilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130507,
					"content": "The story spends a lot of time talking about how those abilities were awakened and how they can be used.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130508,
					"content": "And the names of those abilities are getting harder and harder to follow. I can't remember any of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130509,
					"content": "If I keep reading, I don't think I will be able to follow the story without understanding these abilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130510
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130510,
					"content": "*sigh* I was thinking of giving the book a rest and switching to something a little easier to follow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130511
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130511,
					"content": "Uh... Let's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130512
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130512,
					"content": "Let's head back...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130513
					]
				},
				{
					"id": 220130513,
					"content": "Okay... I don't get why this is happening...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201306,
			"completionStepIds": [
				2201305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
