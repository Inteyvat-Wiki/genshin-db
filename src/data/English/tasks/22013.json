			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "Have you read the reader feedback? Our reviews have been plummeting lately!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130102,
					"content": "Don't worry. This is just the calm before the grand climax!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130103,
					"content": "When the key plot point gets revealed, we'll see a real turnaround in those reviews!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130104,
					"content": "And what good is that if your novel gets axed long before you get there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130105,
					"content": "What's going on?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "Traveler, thank goodness you're here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130107,
					"content": "Junkichi has been adding a lot more wild abilities to the main character, in \"Onibudou.\" It's just been one thing after another ever since that \"inspiration trip\" of his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130108,
					"content": "Yae Publishing House has received a lot of negative feedback from readers who say they don't understand why these abilities are appearing. They think that the author isn't taking the story seriously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130109,
					"content": "They don't know what they're talking about. I'll just keep writing, they'll get it at some point...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130110,
					"content": "Like I was saying, your novel will get axed before you can get to that point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130111,
					"content": "Oh, whatever... From what I recall, there are a few readers of \"Onibudou\" around this area...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130112,
					"content": "Why don't you go and ask them if your idea has legs or not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130113,
					"content": "Fine! I'm sure they'll get it, anyway. Traveler, come with me. I'll need a witness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130114,
					"content": "Yes, that sounds good. Bring the Traveler with you. That way, you can't deny what they say later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130115,
					"content": "Let's do this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "Okay, let's get going. I'm sure my readers will understand me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130117,
					"content": "How much feature creep is there, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Just... just a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130119,
					"content": "\"A bit\"? The main character will soon have more abilities than every other character in the story combined!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130120,
					"content": "Ahem! Let's get going. I'm sure my readers get it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
