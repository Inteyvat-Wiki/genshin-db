				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130601,
					"content": "Alright then, how did it turn out? Did you get the readers'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130602
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130602,
					"content": "...Wait, why does he look so depressed... what kind of feedback did you get?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130603,
					"content": "*sigh*... So, Junkichi, will you accept the feedback now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130604,
					"content": "I can't believe it... How did this happen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130605,
					"content": "Are my ideas... and my writing... not interesting enough?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130606,
					"content": "As I said, advancing the plot purely by giving the character new powers can be dangerous...",
