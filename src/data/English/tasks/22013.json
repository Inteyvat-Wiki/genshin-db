			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hasegawa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "Hello, is there anything I can help you with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130402,
					"content": "Yes, there is. Have you ever read \"Onibudou\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "Yes, I have! It's a very interesting novel. The characters and the plot are wonderful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130404,
					"content": "But... I feel like the author has been slacking off a bit lately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130405,
					"content": "Uh... Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130406,
					"content": "There are all these new powers that suddenly appear without having ever been referenced before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130407,
					"content": "Although it's called an \"awakening,\" it just seems cheap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130408,
					"content": "I just think this kind of cheap plot makes the character look cheap too. I really hope the author reconsiders this course...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130409,
					"content": "Traveler, let's... let's go ask someone else...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201305,
