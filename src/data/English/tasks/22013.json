			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuzu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "Hello, what is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Hello there. Have you read \"Onibudou,\" by any chance?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "Huh? I have and I liked it, but... How should I put it? The plot seems a little strange lately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "The main character is constantly getting new abilities and can immediately defeat the enemy with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "I liked \"Onibudou\" because of the clever methods the main character used to defeat his enemies, but now... it feels like the author is just being lazy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "Also, most of the abilities the main character gets are only used once. It makes the story seem so... flippant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "I really don't know what the author is thinking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "Ahem... well... let's ask a few more people, shall we? This has got to be an odd case...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201304,
			"completionStepIds": [
				2201303
			],
