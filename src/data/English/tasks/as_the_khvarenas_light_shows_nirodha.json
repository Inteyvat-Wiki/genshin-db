					"nextDialogs": [
						732562005
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562005,
					"content": "It seems that the modifications did not include the dismantling of the original devices. A most helpful discovery indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562006,
					"content": "In that case, my Yasnapati, the honor of operating this cannon shall be yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
