					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562304,
					"content": "Once we go in here, we shall be within the proving ground that the Dahrians once used to test their machines. There is even an incomplete prototype of a giant machine amongst them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
