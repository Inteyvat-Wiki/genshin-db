				"points": []
			},
			"dialogs": [
				{
					"id": 732562601,
					"content": "Just install the Energy Block into these Energy Cores, and the whole control system should start!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325627,
			"completionStepIds": [
				7325627
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325627",
							"2"
						],
						"stepId": 7325627,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562701,
					"content": "It is just as the notes say... Hmm? You're back already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562702,
					"content": "But judging from your appearance, you must've found the Energy Block we require.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562703,
					"content": "I have examined these Energy Cores... They are very well-preserved. Now, all that is needed is to install the Energy Block into them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562704,
					"content": "...And that, I shall leave in your hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325628,
