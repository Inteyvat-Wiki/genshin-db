					"Nasejuna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560301,
					"content": "<color=#00E1FFFF>\"Turn the gears such that all three types of runes are displayed. Ensure that the square rune is connected to the triangular rune at the bottom without changing said triangle.\"</color> Simply do as I instruct, and we should be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325604,
			"completionStepIds": [
				7325604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325604",
							"2"
						],
						"stepId": 7325604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "Behold, the moment of destiny is at hand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560402,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "This is just a normal mechanical door!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560404,
					"content": "*cough* I mean to say that as long as we open this mechanical door, we will gain access to the ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560405,
					"content": "Haha, this is my first time entering a Dahrian ruin, you know? Is it so surprising that I might be excited?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560406,
					"content": "Eh? You sounded so confident earlier that Paimon thought you must've explored loads of ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560407,
					"content": "Hah! Well, I can't claim to have personally explored them. But with this copy of \"Rene's Investigation Notes,\" written as it is by an excellent scholar of ancient histories, it is as though I were there in the flesh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560408,
					"content": "\"Rene's Investigation Notes\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "Have you never heard of it? I thought that only one sequestered in a distant desert such as I would not have heard of such a brilliant scholar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560410,
					"content": "These notes contain a lot of records left by the people of Dahri. According to the author, he once discovered knowledge that \"surpasses mortals\" in these ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560411,
					"content": "This sounds harder to believe by the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560412,
					"content": "Leaving that aside for the moment, now that we have these notes, entering these Dahrian ruins should be a simple matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560413,
					"content": "If you don't believe me, let's test this! For example, if we'd like to open this device... Oh, there we go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>\"Turn the gears such that all three types of runes are displayed. Ensure that the square rune is connected to the triangular rune at the bottom without changing said triangle.\"</color> Simply do as I instruct, and we should be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325606,
			"completionStepIds": [
				7325607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_B_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325607",
							"2"
						],
						"stepId": 7325607,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_LESS",
						"rawParams": [
							"73027",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7318710",
							"2"
						],
						"stepId": 7318710,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7318710",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560601,
					"content": "Looks like we've finally reached the heart of these ruins. Now then, as the one amongst us who has done a fair amount of research into Dahrian ruins, allow me to tell you all about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560602
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560602,
					"content": "According to the notes I have, this was once a proving ground where the Dahrians would conduct research and tests. The Great Song of Khvarena we seek is at the deepest part of this facility.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560603
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560603,
					"content": "If we want to reach it, we'll first have to, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560604
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560604,
					"content": "You were just saying that you'd done your homework, and you're fumbling about already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560605,
					"content": "Well, the makeup of these ruins really is too complicated. I doubt anyone could fully understand the principles behind the mysterious machines that the Dahrians used just from descriptions alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560606
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560606,
					"content": "Let me see... Ah, there we go. Looks like our current position is that of the control hub for the entire proving ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560607
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560607,
					"content": "If we wish to reach the Great Song, we must first activate the entire ruins' control mechanisms. To do so, we have to solve an energy issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560608
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560608,
					"content": "Though the people of Dahri are said to have been able to use the power of impurity to operate machines and master monsters, it seems that these ruins don't do so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560609
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560609,
					"content": "On the contrary, it seems that they used a form of energy known as Azosite. It was drawn from pure elemental energy before being formed into blocks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560610
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560610,
					"content": "That means that as long as we find an Energy Block of this kind, we will be able to provide energy to these cores, after which we should be able to settle any other problems with ease.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560611
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560611,
					"content": "That sounds troublesome. Now if only we could simply settle this through combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732560612,
					"content": "Well, let's begin, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560613
					]
				},
				{
					"id": 732560613,
					"content": "Ah, raring to go, I see. That's the Envoy's Yasnapati, indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560614
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560614,
					"content": "In that case, I will leave the work of searching for the Energy Block to you. This is a set of schematics that shows the layout of the proving ground. I'm sure you'll put it to good use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560615
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560615,
					"content": "In the meantime, I have some other things I must examine. As such, I'll wait for you to return here. With the honored Envoy by your side, this shall be child's play — I know it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560616
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560616,
					"content": "If you encounter any issues, just examine these schematics a bit more closely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
