			"dialogs": [
				{
					"id": 732561001,
					"content": "The Energy Cores have been filled. Now, we should be able to activate the control systems...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561002
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561002,
					"content": "Huh? That wasn't what I was expecting. Is there a problem somewhere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561003,
					"content": "It seems as if we'll need to go have a look at the control center where the relays are. Which is fine, it's on the way to the proving ground all the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561004
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561004,
					"content": "Well now, it seems the control center is in the direction you previously came from. Since that's the case, let's go together!",
