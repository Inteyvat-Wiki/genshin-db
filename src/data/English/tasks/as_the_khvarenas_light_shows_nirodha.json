				"points": []
			},
			"dialogs": [
				{
					"id": 732562801,
					"content": "If I went along with you, I suspect I would only drag you all down. As such, I shall simply wait here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562802
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562802,
					"content": "But I believe that whether it be Dahrian machines or the monsters of Dev, they shall be no match for the great Envoy or yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		}
	]
