				{
					"id": 721780404,
					"content": "(The shrine is simple but elegant. Its wood shimmers slightly, greeting guests and their offerings with solemn silence.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Shrine"
				},
				{
