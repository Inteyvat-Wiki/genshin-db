					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
					"content": "Let's go back and tell him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
