					}
				]
			},
			"dialogs": [
				{
					"id": 402461001,
					"content": "Well, that's one old mess for the books. Glad to have that over and done with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461002
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461002,
					"content": "Feels nice to do a good deed every once in a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461003
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461003,
					"content": "You helped everyone out a bunch in Nod-Krai, too! Kinda seems like you're just a good person at heart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461004,
					"content": "Heh, I wouldn't be so sure. I'll be heading back to the Fatui soon enough. You two are too trusting sometimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461005
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461005,
					"content": "Well, at the very least, we know we can trust you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "Hmph, fine. Just don't say I didn't warn you when it comes back to bite you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461007,
					"content": "Well, where to next? Back to the ship?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461008,
					"content": "Yeah! Your personal business, the Narzissenkreuz thing, it's all resolved. That means you can \"see the people that need seeing\" now, right Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461009,
					"content": "Everyone's gonna be so happy you're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461010,
					"content": "Heh... You wouldn't catch me dead admitting to this before, but... Yeah. I really have missed everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461011,
					"content": "Columbina's a special case, though! This time, I'm definitely getting her back for all her annoying antics over the years!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
