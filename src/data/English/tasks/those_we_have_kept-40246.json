					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2652.556,
							253.937,
							3640.104
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 402460701,
					"content": "Ready?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460702,
					"content": "Yeah. When this thing appears, I'll try talking to the souls inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460703,
					"content": "But, more than likely, they've already been driven to madness. If communication fails, we'll have a battle on our hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460704,
					"content": "In that case, Paimon better find a hiding spot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "If a fight does break out, I should be the one to deliver the final blow. Trust me on that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460706,
					"content": "Understood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "Alright, I need quiet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "...Wandering spirits drifting along the tides, hear me now. Broken souls, silenced, torn apart, and forsaken, follow the traces of the past and return to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "...Let resentment recognize resentment. Let vile entities be drawn together, and in this place, take form once more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(...What now? Is that it?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460713,
					"content": "(Ugh... This is exactly why I deal in math not magic. How are we supposed to know what stage the spell is at? It's like there's no logic to speak of.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460714,
					"content": "(Mechanical science is so much easier to—)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460715,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460716,
					"content": "Watch out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460717,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Wandering Souls' Resentment"
				},
				{
					"id": 402460718,
					"content": "Hey, you! Or whoever's inside of you... I need you to listen to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460719,
					"content": "I'm a descendant of Fontaine's \"Lord-Artificer,\" Alain Guillotin. I can make you whole again and return you to the Ley Lines. You just need to work with me here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460720,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Wandering Souls' Resentment"
				},
				{
					"id": 402460721,
					"content": "Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "Tch... Looks like talking this out is off the table.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460723,
					"content": "Alright, plan B... Time to blow off some steam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024609,
			"completionStepIds": [
				4024609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4024609",
							"2"
						],
						"stepId": 4024609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2644.99,
							253.937,
							3639.558
						],
						"pointId": 8
					}
				]
			},
			"dialogs": [
				{
					"id": 402460901,
					"content": "...Is it over?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Yep. Told you it'd be a piece of cake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460903,
					"content": "How did you do that back there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460904,
					"content": "That creature was nothing special. Add a bunch of souls with nowhere to go, a touch of malicious energy, a few impurities, and a whole lot of resentment, and that's what you get.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460905,
					"content": "All I did was separate the original souls from the rest of the filth, allowing them to be accepted by the current rules of the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460906,
					"content": "The principle behind the world-formula is \"divergence.\" Starting from a point of origin, it deconstructs and reconstructs the possibilities of the world to find certain answers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460907,
					"content": "So, it would follow that reverse-calculating the world-formula allows us to achieve convergence and restoration instead. Using the numerological array, I was able to do just that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460908,
					"content": "It's similar to the concept of homological reduction in mathematics. I reduced them to the basic, fundamental essence of their being, without changing their underlying nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460909,
					"content": "That meant... Ugh, never mind. Judging by all the blank stares, I'm guessing you don't actually care.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460910,
					"content": "I think I finally understand how outlanders feel when I ramble on about Shaman stuff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460911,
					"content": "P—Point is, it was super impressive! You really are amazing, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Hah, you're just realizing that now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460913,
					"content": "I'd expect nothing less from the Unraveller of All Reason...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Ahem, enough about that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460915,
					"content": "W—We should get going! I'll go reset the mechanisms inside the tower. See you back on land!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
		{
			"id": 4024610,
