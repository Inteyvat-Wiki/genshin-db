					}
				]
			},
			"dialogs": [
				{
					"id": 402460501,
					"content": "Huh, no sign of it so far...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460502,
					"content": "Should I start the summoning ritual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460503,
					"content": "Let's drain the water from this floor of the tower first. It'll make it easier to move around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460504,
					"content": "Wait, we can do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Of course. Alain and Rene both saw the future that awaited Fontaine, and even shared a few methods for waterproofing buildings. The principle behind it is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460506,
					"content": "...Ahem, not important. Just unlock the mechanisms in the order I tell you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
