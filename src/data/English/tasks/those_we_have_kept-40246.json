			"dialogs": [
				{
					"id": 402461101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 402461102,
					"content": "Um, Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461103
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 402461103,
					"content": "Don't ruin the moment. Or I'll start thinking about how you teleported me to a random location after I explicitly told you to stop doing that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461104,
					"content": "U—Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461105
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 402461105,
					"content": "Aaand... Scene! Bravo! Bravo! We got it! This is exactly the ending I was hoping for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461106
					],
					"speakerTitle": "Xavier",
					"speakerSubtitle": "Film Producer"
				},
				{
					"id": 402461106,
					"content": "...Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461107,
					"content": "Where did you just go, Miss Columbina? You vanished, and then the next second you were back, hugging this, um... new friend here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461108,
					"content": "Th—That... was all... on... Kamera...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461109,
					"content": "Yeah. Well, the Kamera was already rolling, and it happened so fast, so... Yeah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402461110,
					"content": "Hold on, this must be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461111,
					"content": "Yep, my best friend. The one I was looking for. I never thought I'd actually get to see her again. I'm just... so happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 402461112,
					"content": "Plus, the film got a happy ending too. It's all thanks to you, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 402461113,
					"content": "...Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 402461114,
					"content": "You couldn't stop being annoying for one second!? Columbinaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
