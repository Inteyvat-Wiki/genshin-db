			"dialogs": [
				{
					"id": 402461201,
					"content": "Citlali, we're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Oh, right on time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461203,
					"content": "Well, yeah... We weren't the ones who drank our weight in alcohol yesterday.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "Heh, what? Are you suggesting granny can't handle her liquor? It takes a lot more than that to get me drunk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461205,
					"content": "Really? 'Cause, uh, you stopped making sense after a while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "Uh... Did I? Huh, news to me. I didn't say anything... too crazy, I hope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461207,
					"content": "Let's see... You spent half an hour badmouthing Ororon, half an hour complaining about work, an hour talking about light novels... and, uh, Paimon kinda fell asleep after that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "...Are they gone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461209,
					"content": "Hm? Oh, the crew? Yeah, we bumped into them on the deck, but they just left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Wait but, now that everything with your core is sorted out, what's stopping you from seeing Columbina? She misses you a lot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "I... I just want to deal with this mess first. Besides, this is the perfect chance to make her jump for once. I have to plan it out more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461212,
					"content": "But, enough about that. Were you able to pinpoint the location of our target?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461213,
					"content": "Of course. When Granny Itztli promises something, she delivers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461214,
					"content": "Great, let's see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461215,
					"content": "The Morte Region... Wait, this is the Tower of Gestalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461216,
					"content": "The place the souls were severed... Is that the source of the resentment? Or is it the Narzissenkreuz Ordo in general?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461217,
					"content": "Let me come with. This thing's movement isn't fixed. If it's not at this location when we get there, I can use a ritual to summon it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461218,
					"content": "You've already gone to more than enough trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461219,
					"content": "I don't mind. These old bones have nothing better to do anyway. Summoning a spirit isn't going to do me in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461220,
					"content": "(Besides, if I don't go, they'll just have more inside jokes I can't join in on!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461221,
					"content": "Alright then. I appreciate it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461222,
					"content": "Hah, there's no time to lose. Let's head out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}