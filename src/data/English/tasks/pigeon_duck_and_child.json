					"nextDialogs": [
						200480403
					]
				},
				{
					"id": 200480403,
					"content": "Fine. But make sure you find it before the ducks get back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480404
					],
					"speakerTitle": "Timmie"
				},
				{
