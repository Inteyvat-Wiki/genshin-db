			"dialogs": [
				{
					"id": 200480301,
					"content": "I'm sure they'll all get on much better after a nice meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480302
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480302,
					"content": "Next time you're passing by, please try not to scare off the pigeons. It's hard work to get them to come back again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480303
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480303,
					"content": "I'll be more careful in the future.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "Alright. I forgive you. Here, have a Mondstadt hash brown — they're my favorite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480305,
					"content": "Mommy says you should always be kind to others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
