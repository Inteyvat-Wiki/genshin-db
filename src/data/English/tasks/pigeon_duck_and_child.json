					"id": 200480601,
					"content": "WHAT HAVE YOU DONE!? I saw that, you... you... Those poor ducks...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480602
					],
					"speakerTitle": "Timmie"
				},
				{
