				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raiden Shogun",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "Many challenges still lie ahead for Inazuma, but I am prepared for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320102,
					"content": "About the \"challenges\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "Abolishing the Sakoku Decree has a myriad of implications. It would be folly to say that it will be all positive, and there will be no negative repercussions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320104,
					"content": "For example, I can foresee the outside world posing a threat to Inazuma's businesses. These are the issues that I must work to solve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320105,
					"content": "Ei, you're thinking about this all so conscientiously. I've only got as far as wondering whether I'll be able to sell entrance tickets to the Grand Narukami Shrine in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "Honestly, Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320107,
					"content": "About the gaze of the gods...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "Makoto's gaze was always fixed on the people of Inazuma. I always assumed it was because... that was her duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320109,
					"content": "But now I see that hers was a gaze full of delight and hope. It was not just a duty, but a joy, too. She loved humanity very dearly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320110,
					"content": "If people of the past deserved the gods' attention, then so do the people of the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "Indeed. No longer will I ignore their passions and dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320112,
					"content": "About the centuries of dueling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "To put it bluntly, it was constant torture with no end in sight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320114,
					"content": "Faced with an endless battle, I had to remain focused at all times. Had my concentration lapsed for but a moment, the Shogun's blade would have taken my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320115,
					"content": "Safe to say, were it not for my previous experiences in combat, my skills would not have been up to the challenge. I would most certainly have been defeated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320116,
					"content": "And through it all, you also had your part to play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320117,
					"content": "About the damage to the Sacred Sakura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "Don't worry, I haven't forgotten. I will be sure to remind the Tenryou and Yashiro Commissions of their duties in this regard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320119,
					"content": "It's not only the monsters that I am worried about. I'm concerned about what else might escape from the Sacred Sakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320120,
					"content": "That's a tough one, alright... There's plenty more besides memories held in the Ley Lines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "Since you clearly understand, perhaps you could think about making an effort, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320122,
					"content": "Yae Miko said she was placing her god—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "Ahem! Yae Miko said nothing of the sort, and the Traveler has some nerve making up spurious claims about her while she is still present.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "Some words are not to be passed on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "Trust me, you don't want to know the cost of betraying me. Just think of the things I said to you as our little secret. Understood?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "What are you talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 120320127,
					"content": "Nothing. I suddenly want some fried tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "I have no other questions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}