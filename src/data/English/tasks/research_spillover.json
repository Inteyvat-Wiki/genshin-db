			},
			"dialogs": [
				{
					"id": 761380101,
					"content": "Lady Nefer! What a coincidence, you've come at just the right time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380102,
					"content": "You've made up your mind, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380103,
					"content": "Huh? Made up my mind...? Wh-what do you mean, could it be...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380104,
					"content": "I know you've always wanted to visit the Frostmoon Scions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380105,
					"content": "You hope to get acquainted with Lyylikki first, and use that friendship as your stepping stone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380106,
					"content": "You... you knew it all along? But I've kept it locked in my heart and barely told anyone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380107,
					"content": "Well, Mr. Zompaynco, when you guard a secret, you must also learn to hide the fact that you're guarding one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380108,
					"content": "Otherwise, no matter how tall a wall you build in your heart, sooner or later the wind will find its cracks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380109,
					"content": "*sigh* I was never good at keeping my feelings bottled up, even back when I was still in my hometown.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380110,
					"content": "Well, now that you know, could you help me make an introduction? I'm an outsider, and I don't want to intrude on Miss Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380111,
					"content": "Rest assured. The Frostmoon Scions are exceptionally gracious — whether one arrives as a stranger or in a form not entirely human, they will extend a warm and courteous welcome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380112,
					"content": "Huh? Is that so...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380113,
					"content": "But still, it wouldn't be proper to just barge in. Lady Nefer, could you introduce me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380114,
					"content": "Alright. Judging by the time, they should have just finished distributing the meals — perfect timing for a chat. Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380115,
					"content": "By the way, no charge this time. I was just passing by, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380116,
					"content": "Oh, thank you so much! I'll go get my things right away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		},
