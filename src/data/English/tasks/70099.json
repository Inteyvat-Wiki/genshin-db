			"dialogs": [
				{
					"id": 700650101,
					"content": "Some people just won't listen. I already told you, now's not the time to go up the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650102,
					"content": "Easy there, Old Mann. Let's calm down and talk this out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650103,
					"content": "We were getting along just fine earlier at the Night Brew.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650104,
					"content": "But the moment I mentioned I was heading for Windrest Peak, he grabbed me and dragged me all the way here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650105,
					"content": "Oh, Huffman. What's going on here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "As you can see, Old Mann is trying his best to keep people away from Windrest Peak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650107,
					"content": "Anyway, let me introduce you. This is Lipphart, an adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650108,
					"content": "What I saw... What I felt... It was terrifying! Surely you don't wish to hear it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650109,
					"content": "Doesn't look like I'm going anywhere today, so let's hear it. Consider it an extension of our drinking and bragging session from earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650110,
					"content": "So, what sort of \"great peril\" are we facing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650111,
					"content": "The sanatorium's haunted! Seriously! I saw them ghosts with my own eyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650112,
					"content": "Ghosts!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "It happened last night...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mann"
				}
			]
		}
	]
