			},
			"dialogs": [
				{
					"id": 752190101,
					"content": "#Ah, it's {NICKNAME}! Please, wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190102,
					"content": "Here you are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190103,
					"content": "Oh hey! Do you need help with something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190104,
					"content": "Haha, not quite. I was just passing by with a package for the two of you. And there I was wondering how I'd track you down...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190105,
					"content": "Speak of the devil, or make that devils, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190106,
					"content": "A package! Who's it from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190107,
					"content": "Well, it's had quite a journey. It first turned up in the Adventurers' Guild, then after changing hands many times, finally got picked up by the Scions of the Canopy's couriers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190108,
					"content": "Considering Natlan's recent state of affairs, normal caravans haven't been up and running for a while. The sender didn't leave their name on the package, but judging by the signature... it seems to be from Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190109,
					"content": "Seems like you've got friends all the way in Fontaine, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190110,
					"content": "Received with thanks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190111,
					"content": "Great! I'll take that off your hands, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "Whew, today's work sure is off to a great start. No sooner do I get the package than I run into its recipient. Praised be the Pyro Archon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190113,
					"content": "Alright, I'm gonna go get more deliveries done. Have a good day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190114,
					"content": "Yeah, good luck with your work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190115,
					"content": "From Fontaine, huh... He called it a package, but it's so small! Looks more like a letter to Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190116,
					"content": "Let's open it and see!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190117,
					"content": "Oh, it's from Charlotte! It's the photo we took when we were leaving Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190118,
					"content": "It hasn't been that long since we took the photo, but it sure feels like forever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190119,
					"content": "Hehe, let's keep this photo someplace safe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}