			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "Hmm... it should be around here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "Julie? What brings you here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "Huh? Oh, Traveler, it's you! Hehe, never expected to run into you here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "I'm here to look for ingredients. Xudong is working on new dishes, and Parvaneh is giving him ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong told me that he wanted to make a sweet and soft dish for dessert based on Inazuma's Tricolor Dango. But it would take several special ingredients to do so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "Uncle Munehisa went into town to buy some Lavender Melons. I'm here to gather what they call Sakura Blooms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "Although I have gathered some, it's still not enough yet. I wanted to go search ahead, but it's crawling with monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "Traveler, please. Could you please help me bring three Sakura Blooms back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "I've got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "Thank you! I'll treat you to something great when you get back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "These monsters shouldn't be a trouble for you, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "Well, that would generally be the case...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "But, hmm, how do I put this? If I really have to fight against those monsters, I'll definitely forget about the ingredient-gathering mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "I've been like this ever since I was in Mondstadt. Whenever I was dealing with monsters, I would forget about everything else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "Only after I completely defeated the monsters would I remember that I still had an assignment that required my attention... That's how I failed so many assignments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "You really hate monsters, don't you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "Hate them? No, not really... Actually, I find fighting them really fun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "Have you ever had that feeling, when you don't need to think about anything but defeating monsters? It's amazing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "Well, let's not dwell on that. So, please help me out with the Sakura Bloom-gathering mission, thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "I'll treat you to something great when you get back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
