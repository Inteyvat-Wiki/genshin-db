				]
			},
			"dialogs": [
				{
					"id": 790720101,
					"content": "#Oh my, what an honor. You must be {NICKNAME}, in which case, the one by your side must be your companion, Ms. Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720102,
					"content": "Hehe, right in one! That's us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "We're that famous, are we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "News travels quickly to, from, and through Constellation Metropole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720105,
					"content": "I must say that you're right on time — I was just putting the finishing touches on this game of mine, named \"Flying Hats.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720106,
					"content": "I can't be like the eponymous hatter in the \"Flying Hatter,\" who gave everyone a lovely hat, I fear...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720107,
					"content": "But I believe that \"Flying Hats\" will bring joy to those who play it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720108,
					"content": "I've also designed three completely different gameplay modes for it... Don't worry, don't worry, the rules aren't too complicated!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720109,
					"content": "You'll figure it out after just one game, I guarantee it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720110,
					"content": "I'll give it a try!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Alrighty-righty then. This way, please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720112,
					"content": "I'm busy right now...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Oh, it's quite alright. Just come find me whenever you've got the time. I'll be staying here for time being.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				}
			]
		}
	]
}