			"dialogs": [
				{
					"id": 751130401,
					"content": "Wow, I'd never have guessed you'd do so well — I clearly underestimated you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130402
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130402,
					"content": "To think that after all that preparation, the challenge prizes would end up being scooped up, just like that, by a total stranger passing through... It almost sounds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130403
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130403,
					"content": "...Like one of those heroic tales, straight out of a woven scroll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130405
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130405,
					"content": "Maybe someday your heroic deeds will end up being woven into our legends too? In fact, when I put it like that... it sounds quite likely!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751130406
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 751130406,
					"content": "So, how about a quick selfie together, hero? Who knows, this photo might just become my source of future bragging rights!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
