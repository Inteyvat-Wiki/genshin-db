			"dialogs": [
				{
					"id": 761190201,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "Was that too easy for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761190203,
					"content": "Should you come around to play again, I will try to shuffle the hats around faster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761190204,
					"content": "Paimon's curious... How exactly did you play with them earlier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "You can't see anything if you don't use kuuvahki, but if you do use it, you'll see too clearly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "Well, I can open my eyes, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761190207,
					"content": "Oh yeah. Didn't think of that one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
