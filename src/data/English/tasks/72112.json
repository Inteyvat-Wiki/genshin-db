					"nextDialogs": [
						721123603
					]
				},
				{
					"id": 721123603,
					"content": "This shrine really seems to lack the whole divine affection thing, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123604,
					"content": "Here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123605
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123605,
					"content": "Let's see how our luck's going...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123606,
					"content": "Ah, yes. You can only draw one fortune slip each day. Please remember that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123607
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123607,
					"content": "It's too tiring otherwise... Wait, no. If not, you won't be able to use the Fortune Slip Hanger to... No, that's not right either. What was I supposed to say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123608
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123608,
					"content": "\"Fortune slips are the manifestation of our archon's will. It is our place as mortals to respect it and do all we can.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123609
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123609,
					"content": "See? Elegantly put. So please remember, you can only draw one fortune slip each day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
