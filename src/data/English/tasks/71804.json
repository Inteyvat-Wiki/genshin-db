				{
					"id": 718040501,
					"content": "Orderly lines please, orderly lines!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040502,
						718040504
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040502,
					"content": "Ivanovich is looking to get a new business permit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "Oh? You're here as his representative? I see. May I have your business premises certificate and... Uh, what was it again? Right — a business safety certificate. Do you have them both with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040504,
					"content": "You're in charge of these certificates?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "No, no, I'm ad-hoc help, just like you. Clerk Zhao has her hands full at the moment, so I've been called in to help collect and file those certificates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040506,
					"content": "*sigh* It's really tiring work... So, have you brought both your business premises certificate and business safety certificate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
