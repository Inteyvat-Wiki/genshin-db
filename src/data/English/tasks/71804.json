			"dialogs": [
				{
					"id": 718040401,
					"content": "The paperwork for these procedures is incomplete again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040402
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 718040402,
					"content": "Ivanovich is looking to get a new business permit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Ivanovich? Oh, yes, I remember him. He's been here a few times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 718040404,
					"content": "Applying for a new business permit, is he? Haha... he must be terribly busy right now, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "Nervous An"
				},
				{
					"id": 718040405,
					"content": "You're here to help him out, I presume. Have you brought his <color=#00E1FFFF>exit permit</color> with you? I do remember telling him before that his paperwork wasn't complete, and that he needed to get it filled in elsewhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervous An"
				}
			]
		},
