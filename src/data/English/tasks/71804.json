			"dialogs": [
				{
					"id": 718040701,
					"content": "Have you submitted all the documents yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040702
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040702,
					"content": "They've been submitted.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040703
					]
				},
				{
					"id": 718040703,
					"content": "Phew, that's wonderful. As long as I get a new business permit, I can continue doing business here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040704
					],
