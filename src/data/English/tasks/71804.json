					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040602
					],
					"speakerTitle": "Clerk Zhao"
				},
				{
					"id": 718040602,
					"content": "Ivanovich is looking to get a new business permit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040603
					]
				},
				{
					"id": 718040603,
					"content": "You're his representative? Alright. His <color=#00E1FFFF>old business permit</color>, please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040604
					],
					"speakerTitle": "Clerk Zhao"
				},
				{
					"id": 718040604,
					"content": "If you have it, submit it. I'll need it if you want a new one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clerk Zhao"
				}
			]
		},
