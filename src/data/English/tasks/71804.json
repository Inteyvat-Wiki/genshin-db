			"dialogs": [
				{
					"id": 718045101,
					"content": "I can finally rest for a while. Any more of this and I would have collapsed for sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045102,
						718045106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045102,
					"content": "What's with the huge number of procedures?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718045103
					]
				},
				{
					"id": 718045103,
					"content": "Haha. Well, this is Liyue Harbor, after all. Contracts are of utmost importance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045104
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045104,
					"content": "Don't we all feel safer when all things big and small are written down in black and white?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045105
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045105,
					"content": "Well, I say that, but this really is too much. I'm getting dizzy already...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045106,
					"content": "Is Snezhnaya like this too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718045107
					]
				},
				{
					"id": 718045107,
					"content": "You mean in the way we do things? Well, not exactly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045108,
					"content": "But if you want specifics, I could probably go on and on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718045109
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718045109,
					"content": "You'll see what I mean, though, if you ever get the opportunity to set foot in Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
