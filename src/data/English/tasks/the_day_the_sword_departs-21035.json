						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210350201,
					"content": "*huff* That was tough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350202,
					"content": "I apologize. Look at me, making a fool of myself. I didn't expect that I would be so nervous when confronting real monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350203,
					"content": "Needless to say, I still need more training. Anyway, thank you, Traveler. Please, take these as your reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350204,
					"content": "Are you really leaving?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "I haven't fully decided yet. I still need more time to think it through. Meanwhile, I'll see if I can convince Que'er to leave with me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		}
	]
}