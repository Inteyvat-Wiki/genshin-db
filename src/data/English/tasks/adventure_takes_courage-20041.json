		{
			"id": 2004101,
			"completionStepIds": [
				2004101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004101",
							"2"
						],
						"stepId": 2004101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patchi the Curious"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "There's no such THING as a perfect plan when you're on an adventure! How are you going to make any progress at all if you keep deliberating like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410102,
					"content": "If the plan isn't perfect, then we need to be prepared for anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "What are you arguing about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "I am a researcher of ancient ruins, and I wish to embark on a field trip to the Thousand Winds Temple. But I don't deal well with situations involving combat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410105,
					"content": "Mr. Doolan here is an adventurer, and has taken it upon himself to make all the necessary arrangements for the temple investigation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410106,
					"content": "Now, I do not mean to be critical of Doolan in any way, and I know that those Ruin Guards can be a real nuisance... but he insists on devising a fully comprehensive adventure plan down to the last detail, to which end he calls meeting after meeting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410107,
					"content": "We've had research, investigation, and amendments, followed by supplementary research, further investigation, and round-two amendments... Ahh, I just can't take it anymore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410108,
					"content": "Now he says he's found new evidence of monsters camping out next to the temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410109,
					"content": "I'm begging you, clear them out for me, would you? Just to shut him up, even if it doesn't get us inside the temple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410110,
					"content": "I think I understand what needs to happen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "I'll happily take your place at Doolan's meetings.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "I appreciate the gesture, but take it from me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410113,
					"content": "...You'll find those monsters far less stressful to deal with than one of his meetings!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patchi the Curious"
				}
			]
		},
