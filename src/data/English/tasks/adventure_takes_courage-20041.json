			"dialogs": [
				{
					"id": 200410301,
					"content": "Have you wiped out the monsters' camps yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410302
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410302,
					"content": "Yes, they're all gone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410303
					]
				},
				{
					"id": 200410303,
					"content": "Wonderful. I will speak with him at once about a proposed means of entry into the temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410304
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410304,
					"content": "He'll have no excuse to pull me into a meeting this time!",
