					"content": "So, have you wiped out the monsters' camps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410202
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 200410202,
					"content": "Not just yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410203
					]
				},
				{
					"id": 200410203,
					"content": "Please do it as soon as you can. Before Doolan finds yet another piece of evidence to pursue and ponder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patchi the Curious"
