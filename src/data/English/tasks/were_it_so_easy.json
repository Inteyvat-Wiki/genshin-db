			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#Ah, it's {NICKNAME} and Paimon, the bringers of exotic flowers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490102,
					"content": "Hello, Cosanzeana. Have the flowers we brought been growing well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490103,
					"content": "Um, about that... I haven't gone to look at them for a whole day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490104,
					"content": "Eh? Didn't you like the flowers? Why aren't you looking after them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490105,
					"content": "Ohh... They were so hard to get, so I do want to take good care of them, so, so much... But when I think that they might wither before my eyes, I... I'm scared to go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490106,
					"content": "Oh wow, you really are very concerned about them... Why don't we go have a look together? If anything bad happens, we'll help you out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490107,
					"content": "There's no point in worrying too much.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "You're right... Let's go together! With the two of you to help me, I feel like we can handle this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
