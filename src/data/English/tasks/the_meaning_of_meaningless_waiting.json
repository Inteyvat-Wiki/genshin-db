			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Let's see, where's the person Ayaka told us about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040102,
					"content": "Why are you doing this? Why leave all of a sudden, after all these years?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040103,
					"content": "Precisely, it's much too sudden. We've had no time to prepare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040104,
					"content": "The children are desperate for you to take them out to play... Please, we urge you to reconsider!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040105,
					"content": "That must be the guy Ayaka told us about. Let's go over and see!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "This looks like Tejima's diary alright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040202,
					"content": "Let's see what we have here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040203,
					"content": "\"Today, the villagers and I got together to cook Dry-Braised Salted Fish. I messed up and burned mine a little, so I had to pretend that it was Black Snakehead instead.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040204,
					"content": "\"Today, I helped rescue a kid who had fallen in the water. After I pulled him out, he told me that his best friend, Banbu, was still in the water. I searched the water the whole afternoon before finding out that Banbu was the name of his pet crab.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040205,
					"content": "\"I went kite-flying today. The string broke, so I chased after it as fast as I could. I soon realized I was never going to get it back, so I just found somewhere to sit and watch as it flew away into the distance.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040206,
					"content": "Hmm... Seems like your average diary of daily village life...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040207,
					"content": "Huh? Wait — there's more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040208,
					"content": "\"I went to pray at the shrine again today, and stayed there a while. The omamori you gave me has faded a little, but it is still my most treasured possession...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040209,
					"content": "Now that's the kind of info we're looking for! Time to pay a visit to the shrine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200403",
							"2"
						],
						"stepId": 200403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "So this is the omamori Tejima wrote about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040302,
					"content": "Interesting... looking at the color and the design, Paimon would've thought it belonged to a child...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040303,
					"content": "But anyway, if he had this with him all the time, there's a chance some of his elemental energy remained on it. D'you think that might come in handy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "Here we are! This seems to be somewhere that Tejima visited a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040402,
					"content": "The soil looks like it's been disturbed... Maybe Tejima buried something precious here — something that's kept him in the village all these years?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040403,
					"content": "Must be something pretty amazing if it made him stick around for 30 years. Let's dig it up and take a look~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040404,
					"content": "It looks like... a letter? The paper's gone yellow — must have been written a really long time ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040405,
					"content": "\"Konda Village\"... Sounds so familiar — where is that place, again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040406,
					"content": "It's here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "Huh? So the reason Tejima came here was to wait for someone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040408,
					"content": "But he's been here for 30 years... Aw, guess they didn't show up in the end, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040409,
					"content": "Well, let's go give Tejima his stuff back and take it from there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tejima",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "Well, I'll be... That's certainly my handwriting... and I guess the omamori and letter belong to me too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040502,
					"content": "...But I have no memory of anything that's written in this diary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040503,
					"content": "Still... it's clear that I was waiting for someone here, and that I chose to wait for 30 years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040504,
					"content": "Over the years, I must have made a note of anything interesting... anything that I could share with her when we were finally reunited.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040505,
					"content": "And just look at all the things that did happen over the years... The time has flown by so quickly. 30 years feels like the blink of an eye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040506,
					"content": "How could I have forgotten something so important to me? Hmm... Now that I think about it, when my Vision was taken from me, it felt like I'd suddenly been... hollowed out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040507,
					"content": "Love, regret... everything I felt for her... it's all disappeared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040508,
					"content": "Does that make you feel sad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "No... not especially.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040510,
					"content": "After all, I've forgotten who she was. Her face, her voice, the things we experienced together... I barely recall any of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040511,
					"content": "It's as if she'd never been in my life to begin with... as if, all these years have been nothing but a hazy dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040513,
					"content": "So, do you still plan on leaving?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "Mm... I think... maybe not. If this is something I waited most of my life for, I suppose I should carry on waiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040516,
					"content": "Although, what if she were to turn up eventually, only to find I didn't remember so much as her name... Wouldn't that be upsetting for her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040517,
					"content": "When I think about it like that... I do feel a slight tinge of sadness in my heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040518,
					"content": "How curious... Why am I thinking like this when I don't even remember who she is? It's just like that feeling of emptiness, the feeling that something is... missing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040519,
					"content": "*sigh* Thank you both for helping me reconnect with my reason for staying here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040520,
					"content": "I shall remain here, and keep waiting for her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040522,
					"content": "Tejima seems to be dealing... okay, but still... it makes Paimon really sad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040523,
					"content": "Yeah, me too...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "Seems it's just like Ayaka and Thoma were saying. If you lose your Vision, you lose all your hopes and dreams, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040526,
					"content": "That certainly explains the state Tejima was in earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040527,
					"content": "At least we were able to help him... weren't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040528,
					"content": "*sigh* ...Well, let's go find the next person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040524,
					"content": "Losing a reason to feel sad is maybe the saddest thing of all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
