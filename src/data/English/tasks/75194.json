					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "Ten, twenty... Sold a bunch of stuff, so our finances should be healthy for now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "Not going to try and make a bit more?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "Haha, nope! I'm calling it quits for now! If you hadn't been so understanding and helped me out, I'd have gotten myself into trouble over those couple of jade bits for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "Besides, constantly chasing money is boring. It's just a hobby for me. Observing the volcano is what really matters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "We can always make more money, but if an eruption warning doesn't get sent out on our account... that would be a huge loss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "Don't you get funding from the Speaker's Chamber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "We didn't apply for any. With all the stuff they already have to deal with on the daily, I doubt they need the extra stress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "The gang and I are a different story. We're used to funding our own travels by picking up odd jobs as we go. It's become a lifestyle, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "As such, monitoring the volcano while we travel isn't a big deal, just like how you often help people in need — it just comes naturally!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Alright then, see you around.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Take care, hehe. May we meet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
