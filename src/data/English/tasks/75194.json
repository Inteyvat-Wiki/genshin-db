			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Phew, what a relief. Looks like the volcano situation isn't as bad as we thought. Guess we can sleep easy tonight...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "It's all thanks to you, of course. If you hadn't stepped in and helped us without holding grudges, things wouldn't have gone so smoothly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "Please, take this as a token of my gratitude — and as an apology, to boot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "Hehe, well, since you put it that way... we graciously accept!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "What do you plan to do next?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "I've still got some cargo stocked up. Normal operations should put our finances back on track.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Of course, we're not in an emergency situation this time, so I'll be doing honest business, don't you worry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
