				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640301,
					"content": "Meow! Yes, this work was given specifically to me by Hibiki. A vital task to be completed by no other.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640302,
						721640311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640302,
					"content": "So, about your name...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640303
					]
				},
				{
					"id": 721640303,
					"content": "My name is Neko — a name bestowed by Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640304,
					"content": "It was she who often came out to receive guests at the shrine, and so I was not obligated to manage such affairs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640305,
					"content": "I had neither name nor title then. I slept where she wished, and played with whomever she willed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640306
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640306,
					"content": "One day, Hibiki said that she would call me \"Neko,\" on account of my habit of sleeping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640307,
					"content": "Hibiki is presently absent, but a shrine is no shrine without a head priestess, and so I have taken up that post.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640308,
					"content": "That is also why I hope to restore the shrine to its former liveliness before Hibiki returns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640309,
					"content": "Once she returns, I can fall asleep in her bosom, and not have to wait for her to repair the Offering Box, or for her to use that long stick of hers to clear the fallen leaves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640310,
					"content": "Well, I shall leave those tasks to you. There are some sneaky bugs that have stolen into the shrine, and they must now be driven out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640311,
					"content": "So, who used to tidy the shrine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640312
					]
				},
				{
					"id": 721640312,
					"content": "It was Hibiki. Domeki would help her sometimes, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640313,
					"content": "Hibiki often took that stick and waved it back and forth before sunrise. She would also pour water on the ground. Ugh, water...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640314,
					"content": "Wait. Did she pour the water first? I do not quite recall the sequence of events...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640315,
					"content": "Domeki would come by at times as well, and he would use crossed metal plates to go snicker-snack! And the branches and leaves would come falling down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
