			"dialogs": [
				{
					"id": 413360901,
					"content": "Oh, it's you, Linling. Any progress on the lantern...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360902
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360902,
					"content": "Don't worry, the Traveler and I have already taken care of it. Here you go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360903
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360903,
					"content": "Oh, that didn't take you any time at all. Thank you, let me read what you've written on it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360904
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360904,
					"content": "\"With goods so fresh he sways to and fro. No one sells produce like ol' Bibo.\" Not bad, that sounds just like me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360905
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360905,
					"content": "I have another verse here that I wrote too, you can have them both.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360906
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360906,
					"content": "Another one? Let me see, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360907
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360907,
					"content": "\"By day, he tends to his business like a\"... Hey! Wh—What are you tryna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360908
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360908,
					"content": "What do you think? It's quite fitting, isn't it? If you like that one too, you could make another Xiao Lantern and write it on yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360909
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360909,
					"content": "Ahem... No thanks! I must get going...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360910
					],
					"speakerTitle": "Bibo"
				},
				{
					"id": 413360910,
					"content": "Well, that does it for all the Xiao Lanterns. Thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360911
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360911,
					"content": "Everyone seemed to enjoy them. It seems you have a lot of literary skill, just like me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360912
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360912,
					"content": "*sigh* There are not many in this city that could compose couplets with me like you just did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360913
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360913,
					"content": "If you ever have the time, please feel free to visit me again. We can continue working on more poetry together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360914
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360914,
					"content": "Uh, will do...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360915
					]
				},
				{
					"id": 413360915,
					"content": "Good. Now I just need to come up with something to write on my own lantern, hehe. I won't need your help this time though, I'll be able to manage it myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360916
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360916,
					"content": "Oh, I nearly forgot... these are for you. Consider them a token of my appreciation. It was nice to have someone accompany me during the festival. Thanks again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
