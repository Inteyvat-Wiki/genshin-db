			},
			"dialogs": [
				{
					"id": 413360301,
					"content": "Good, these will be perfect. Let's start by finding Manager Xiao, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 4133604,
			"completionStepIds": [
				4133604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133604",
							"2"
						],
						"stepId": 4133604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360401,
					"content": "There's Manager Xiao, let's watch from here and see what he's up to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360402,
					"content": "Hmm, let me think... I know Manager Xiao pretty well, it won't take me long to write his wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360403,
					"content": "Here, how does this sound...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360404,
					"content": "\"A shriveled old man with the heart of a shark\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360405,
					"content": "What!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "\"But underneath his impersonal cloak lies a warm and caring heart.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360408,
					"content": "Oh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "I've even come up with a title, too... \"A Nice Person, Indeed.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360411,
					"content": "So? Pretty fitting, don't you think? Even though Manager Xiao appears to be pretty fierce, he's actually a nice person...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360412,
					"content": "Do you have any alternatives to consider as well?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "No, just this one... I can't seem to think of how to continue with this theme, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360414,
					"content": "Would you like to give it a try?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360415,
					"content": "The first phrase is \"Down at the dock, his steely gaze inspires awe in the hearts of the young\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360416,
					"content": "\"But he sleeps like a rock and snores like a bear when the working day is done.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "Hmm, not bad... That'll do just fine. Now all we need is a title...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360418,
					"content": "Uh... \"Peaceful as a Slumbering Mountain\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "Oh! I never would have guessed you had such literary talent. These lines are perfect!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360420,
					"content": "Just wait a moment while I write this on the Xiao Lantern...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360421,
					"content": "Alright, that does it. Let's go give the lantern to Manager Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360409,
					"content": "I think we've heard enough...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "Y—You can't be serious...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
			"id": 4133605,
			"completionStepIds": [
				4133605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
