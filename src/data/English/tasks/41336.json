			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manager Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "Ah, hello Linling. Do you need anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "Manager Xiao"
				},
				{
					"id": 413360502,
					"content": "Remember how you asked me to come up with some lines for you on a Xiao Lantern? Well, the Traveler and I have just finished preparing everything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360503,
					"content": "See, we've even written the words on the Xiao Lantern for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360504,
					"content": "Oh thank you very much, let me read it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "Manager Xiao"
				},
				{
					"id": 413360505,
					"content": "\"Down at the dock, his steely gaze inspires awe in the hearts of the young\"... \"But he sleeps like a rock and snores like a bear when the working day is done.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "Manager Xiao"
				},
				{
					"id": 413360506,
					"content": "\"Peaceful as a Slumbering Mountain\"... Hehe, that's pretty good, thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "Manager Xiao"
				},
				{
					"id": 413360507,
					"content": "You're welcome, Manager Xiao. I still have another verse that I wrote myself. Here, let me read it to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360508,
					"content": "Alright, I think we'd better be going now! We've still got other people to see, you know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
					"content": "Oh, right! Well then, our next patron is Degui. Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360511
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360511,
					"content": "The verses for Degui will be my finest work yet! I'll tell you more once we find him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360509,
					"content": "Um, we still have more lanterns to deliver!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				}
			]
		},
		{
			"id": 4133606,
