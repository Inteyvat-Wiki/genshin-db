					"Degui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360701,
					"content": "Ah, Linling. What can I do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360702
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360702,
					"content": "Remember you asked me to write some lines for your Xiao Lantern? Well, the Traveler and I have just finished preparing everything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360703
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360703,
					"content": "We've even written everything on the Xiao Lantern for you, so... Here you go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360704
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360704,
					"content": "Oh, great! Thank you. Let me read what you've written here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360705
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360705,
					"content": "\"An indulgent bowl of rich rice wine, topped with pearly white dumplings so fine\"... \"Extravagant but Elegant\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360706
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360706,
					"content": "It reads quite nicely, yes... Very nice, indeed. Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360707
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360707,
					"content": "You're very welcome. We have the Traveler to thank here for all the inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360708
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360708,
					"content": "By the way, I have another verse I came up with by myself that I've written down on this note. You may read it later when you have the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360709
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360709,
					"content": "Sure! Thanks a lot, you two. I need to get back and look after my business now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360710
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360710,
					"content": "\"Third-Round Knockout is what people say, but just three bowls will leave you in dismay\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360711
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 413360711,
					"content": "Alright, our next patron is Bibo, he also asked me to make him a Xiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 4133608,
			"completionStepIds": [
				4133608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
