			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360801,
					"content": "That's Bibo just up ahead, let's keep an eye on him from here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360802
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360802,
					"content": "Hmm, I've heard that he's always involved in some mysterious business, but he's quite a nice guy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360803
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360803,
					"content": "I've already come up with a verse that is suitable for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360804
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360804,
					"content": "\"By day, he tends to his business like a crafty rat\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360805,
						413360806
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360805,
					"content": "Huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360807
					]
				},
				{
					"id": 413360807,
					"content": "\"But by night, you discover that he's not so bad.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360808,
						413360809
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360808,
					"content": "Oh no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360810
					]
				},
				{
					"id": 413360810,
					"content": "Oh, and the title... \"He's a Jolly Good Fellow.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360811,
						413360812
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360811,
					"content": "No, please stop!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360813
					]
				},
				{
					"id": 413360813,
					"content": "No good, huh? Well, this was the more complete version I was able to come up with... I have another one that's not quite finished yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360814
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360814,
					"content": "It's a little bit plain and could use some creative flair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360815
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360815,
					"content": "Let's hear it, I'll see what I can do...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360816
					]
				},
				{
					"id": 413360816,
					"content": "Okay, here it goes: \"With goods so fresh he sways to and fro...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360817
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360817,
					"content": "\"No one sells produce like ol' Bibo\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360818
					]
				},
				{
					"id": 413360818,
					"content": "Oh! That's a good one, but how about a title?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360819
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360819,
					"content": "How about \"Bibo's Seaside Market\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360820
					]
				},
				{
					"id": 413360820,
					"content": "\"With goods so fresh he sways to and fro. No one sells produce like ol' Bibo\"... Titled \"Bibo's Seaside Market.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360821
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360821,
					"content": "\"By day, he tends to his business like a crafty rat. But by night, you discover that he's not so bad\"... Titled \"He's a Jolly Good Fellow.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360822
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360822,
					"content": "Hmm, now that I hear them side-by-side, I'm starting to think that yours sounds a bit better. My verse is a bit too vivid, not something you'd typically write on a Xiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360823
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360823,
					"content": "Alright! Let me just write your verse on the lantern and we'll be ready to give it to him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360812,
					"content": "That won't work at all!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360813
					]
				},
				{
					"id": 413360809,
					"content": "No, I really don't think you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360810
					]
				},
				{
					"id": 413360806,
					"content": "W—Wait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360807
					]
				}
			]
		},
