				]
			},
			"dialogs": [
				{
					"id": 733520101,
					"content": "Why, my greetings to you, dear traveler from afar, and to your little friend. Have you been enjoying the Sabzeruz Festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520102
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520102,
					"content": "If you're both interested, I, the Phantom Toy Master, shall be pleased to invite you to play a new game — the \"Rocking Carriage,\" a flower that blooms only during the Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520103
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520103,
					"content": "And what's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520104,
					"content": "Just hearing the name, Paimon's kinda imagining Nahida happily swaying from side to side in her carriage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520105,
						733520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520105,
					"content": "Even I'm getting all gladsome over here!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				},
				{
					"id": 733520107,
					"content": "Wonderful! All in Sumeru wish that the \"Dendro Archon shall be happy every day,\" after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520108
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520108,
					"content": "That association you made... Ah, what an excellent scene! One that deserves to be rendered upon a magnificent scroll, if I do say so myself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520109
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520109,
					"content": "Still, the atmosphere of this game is a livelier thing. Rather than a celebration, it's best thought of as an adventure—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520110
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520110,
					"content": "\"Smart or not, nice or naughty, every child with a good heart will receive their own Flower Carriage during the Sabzeruz Festival celebrations...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520111
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520111,
					"content": "\"Riding in their carriage, the children shall embark on unique adventures, encountering and overcoming danger, and finding the greatest treasure, a thousand blooming flowers...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520112,
						733520113
					],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520112,
					"content": "Paimon's both smart and nice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520114,
					"content": "Hehe, that's right! And as for that treasure, it may as well be ours already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520115,
					"content": "Haha, good, good. In that case, play on, play to your hearts' content!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masud"
				},
				{
					"id": 733520113,
					"content": "Trust me, we're danger-overcoming pros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520106,
					"content": "Just hearing you say that makes me wanna watch Nahida do that too...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				}
			]
		}
	]
}