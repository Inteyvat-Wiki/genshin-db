			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040401,
					"content": "How did it go? Were you able to find that Ast... Well, your friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040402,
					"content": "Here's the rent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "Ah, good, good. This will do. Thank you very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040404,
					"content": "That said, might I ask what it is that your friend does for a living?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040405,
					"content": "She seems like the capable sort, and yet she always appears short on Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
		{
			"id": 2000405,
			"completionStepIds": [
				2000405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
