					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040501,
					"content": "You're back. I assume Goth has been paid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040502,
					"content": "That he has.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "That's good. Thankfully, the rent on this house isn't particularly expensive. I was just barely able to scrounge up the necessary Mora as things stood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040504,
					"content": "That said, I suppose I'll be subsisting on salad for a few more days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
