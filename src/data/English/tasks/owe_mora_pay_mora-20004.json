			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040701,
					"content": "Thank you so much. These should do. Now to send them off to the carpenter... Oh. Right! I need to collect rent as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040702
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040702,
					"content": "*sigh* I just wonder if that... As... Astromona, or whatever she was called, will be in this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040703
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040703,
					"content": "It's Mona Megistus, the Astrologist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040704
					]
				},
				{
					"id": 200040704,
					"content": "Right! Yes, that was her name... Ugh. It's a bit long, if you ask me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040705
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040705,
					"content": "Mona hasn't paid her rent, you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040706,
					"content": "Well, that's just the thing, see? All my other tenants have already paid theirs. She's the only one left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040707
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040707,
					"content": "I came by a few times previously, but she wasn't in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040708
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040708,
					"content": "So please, Traveler, help me go down there and urge her to pay up soon, would you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
