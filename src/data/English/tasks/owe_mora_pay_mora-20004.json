			"dialogs": [
				{
					"id": 200040601,
					"content": "Have you obtained the timber? I just need one set of Fir Wood and another of Birch Wood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
		{
			"id": 2000407,
			"completionStepIds": [
				2000407
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
