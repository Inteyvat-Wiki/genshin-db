				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040101,
					"content": "*sigh* I suppose I might have to sort this out myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040102,
					"content": "Ack, these old bones will fall apart at this rate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040103,
					"content": "Is there some urgent matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040104
					]
				},
				{
					"id": 200040104,
					"content": "Oh, Traveler? Well, this... I wouldn't call it \"an urgent matter,\" but it is getting out of hand for sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040105,
					"content": "As you know, those Fatui have my hotel fully booked.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040106,
					"content": "And as you know, I, as the boss of the Goth Grand Hotel, have to attend to them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040107,
					"content": "I coordinate food catering, repairs, and a slew of miscellaneous matters besides.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040108,
					"content": "Lately, some rooms have had their furniture damaged, so I've had to contact people to bring the appropriate timber to some carpenters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040109,
					"content": "Then there's the matter of collecting rent on a few apartments... and the matter of my lad Marvin being nowhere to be found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040110,
					"content": "*sigh* I wonder how long I can last... Or when that boy will finally grow up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040111,
						200040112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040111,
					"content": "I'll lend you a hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				},
				{
					"id": 200040113,
					"content": "You're willing to help? Ah, that's wonderful! ... *sigh* If only that loud Marvin had as good a head on his shoulders as you. That would've spared me much trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040114,
					"content": "In that case, could I trouble you to fetch some Fir Wood and Birch Wood? I'll need to have them sent to the carpenters soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040112,
					"content": "You rest here first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				}
			]
		},
		{
			"id": 2000403,
			"completionStepIds": [
				2000403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2000403",
							"2"
						],
						"stepId": 2000403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "Ah, it's you. It's been a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040302,
					"content": "Strange, you seem to be in a hurry. Were you looking for me, by any chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040303,
					"content": "Where have you been, Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040304,
					"content": "We've been looking for you these last few days.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "Oh, that was... rather inopportune of you. A few days ago, The Steambird sent me a request for a new manuscript.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040306,
					"content": "The topic in question was \"celestial shifts and their relation to a person's changing fates.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040307,
					"content": "As such, I have largely been out studying the stars these past couple of days, only returning well after dark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040308,
					"content": "Looks like Mona's working for that Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040309,
					"content": "W—Well, I mean, there's this new celestial globe from Fontaine that I've put down an order for. I've even paid the deposit already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040310,
					"content": "Once I get the Mora from submitting this manuscript, I should be able to settle the balance and claim the celestial globe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040311,
					"content": "Well, don't forget about your rent payment to Goth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "Rent?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040313,
					"content": "Oh! I, um... Surely, I've put some Mora aside for this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040314,
					"content": "Give me a moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040315,
					"content": "Mona rifles through her purse...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "These here... and these! There, that should cover it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040317,
					"content": "(She's practically emptied her pockets here...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "Right, then. Help me pass this Mora to Goth, would you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 2000404,
			"completionStepIds": [
				2000404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
