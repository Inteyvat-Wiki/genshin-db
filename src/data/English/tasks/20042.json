			"dialogs": [
				{
					"id": 200420101,
					"content": "Where are you hiding, you pesky little...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420102,
					"content": "What are you looking for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420103
					]
				},
				{
					"id": 200420103,
					"content": "Me? Oh— I'm looking for a very dodgy person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420104,
					"content": "His name is Albert and he always lurks around the Cathedral during the day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420105,
					"content": "He looks like he's up to no good. I'm worried he's plotting something bad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420106,
					"content": "Can you chase him off for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
