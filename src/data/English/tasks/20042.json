			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albert"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200421001,
					"content": "Me? Me, sneaking around, acting suspiciously, and plotting evil deeds? You guys have got this all wrong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421002
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421002,
					"content": "*sigh* ...Do you know Barbara? She's Mondstadt's angel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421003
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421003,
					"content": "Many people in Mondstadt admire her, including me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421004
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421004,
					"content": "In fact, I am head of the Barbara fan club.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421005
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421005,
					"content": "The Knights of Favonius will be here shortly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200421006
					]
				},
				{
					"id": 200421006,
					"content": "L—Let me finish! I really look up to Barbara. I want to be like her — I want to do something for Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421007
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421007,
					"content": "But I'm just an ordinary person with ordinary abilities. The best I can do is to do some sweeping around the Cathedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421008
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421008,
					"content": "But Miss Victoria never listens to me, she just says she wants me gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421009
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421009,
					"content": "Recently I noticed that no one has swept away the leaves around the Cathedral for a while. But if I tried to explain to Miss Victoria, she wouldn't understand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421010
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421010,
					"content": "Can you help me sweep away the leaves? For Mondstadt... And for Barbara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
