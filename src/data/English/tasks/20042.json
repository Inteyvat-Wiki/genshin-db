			},
			"dialogs": [
				{
					"id": 200420901,
					"content": "Oh, I've already told the Knights of Favonius all about you and your antics!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420902
					]
				},
				{
					"id": 200420902,
					"content": "What!? What am I supposed to have done? Tell me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
		{
			"id": 2004210,
			"completionStepIds": [],
