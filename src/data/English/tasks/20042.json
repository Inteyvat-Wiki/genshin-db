			"dialogs": [
				{
					"id": 200420701,
					"content": "I have an update about Albert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420702
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420702,
					"content": "Has he left?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420703
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420703,
					"content": "Yes, he's gone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420704
					]
				},
				{
					"id": 200420704,
					"content": "Well, that's that sorted... But, what on earth were you doing sweeping leaves just now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420705,
					"content": "Never mind, I suppose no more leaves means one less excuse Albert can use to get near the Cathedral in future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420706,
					"content": "These gifts are my way of saying thank-you. Take them, and may the Anemo Archon protect you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420707
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420707,
					"content": "If there's nothing else, I should get back to work. You should get back to yours, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
