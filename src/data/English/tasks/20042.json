				"points": []
			},
			"dialogs": [
				{
					"id": 200420601,
					"content": "Have you finished sweeping yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420602
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420602,
					"content": "Yep. All gone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420603
					]
				},
				{
					"id": 200420603,
					"content": "Thank you. The Cathedral looks much better now! I'm sure Barbara will feel better for it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420604
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420604,
					"content": "But, please don't tell Barbara about this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420605
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420605,
					"content": "The point here is to reduce her burden; telling her about it would only add to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420606
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420606,
					"content": "As we agreed, I'll be on my way now. See? Nothing to worry about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420607
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420607,
					"content": "See you again soon... Maybe? Who knows.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
