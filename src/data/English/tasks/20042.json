					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200420301,
					"content": "Shall I contact the Knights of Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420302
					]
				},
				{
					"id": 200420302,
					"content": "I thought about doing that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420303,
					"content": "But I have no concrete evidence on him. There's nothing they would be able to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420304
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420304,
					"content": "For the greater glory of the Anemo Archon... Please, just get rid of this guy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
