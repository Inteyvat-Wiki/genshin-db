			"dialogs": [
				{
					"id": 721180501,
					"content": "The Fatui are acting more and more strangely. They seem to be gathering around the core of the furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180502
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180502,
					"content": "Hopefully, they aren't hatching some other dastardly plot. Or should I say, trying to do something that we won't be able to mitigate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
