					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180301,
					"content": "So, have you scouted the situation out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180302,
					"content": "That I have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211804,
			"completionStepIds": [
				7211809
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211809",
							"2"
						],
						"stepId": 7211809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Great! Let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "We're in luck, it seems. The Mikage Furnace is quite stable, and the energy within is not yet over-saturated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "At this level of concentration, my device will still hold out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "Do we need to purify all that energy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "If this device could do that, why, I would have applied for a patent long ago. But our fine friend here can only decrease the energy level in a localized area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "However, the reason for the deactivation of the Mikage Furnace and the failure of even its auto-restart program is the high saturation of Tatarigami energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "As long as we find the area with the highest concentration and purify it, we should be able to restart the core.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "At that point, the Mikage Furnace should restart, and beyond that point, any further issues will not be our concern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "That's the plan. But before we execute it, I still have a few final preparations to make.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
