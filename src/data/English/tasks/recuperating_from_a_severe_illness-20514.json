						205140602
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140602,
					"content": "She's on top of a windmill.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140603
					]
				},
				{
					"id": 205140603,
					"content": "A windmill!? How did that girl get up there? I'm going up there right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140604
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140604,
					"content": "What? She wants to try becoming an adventurer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140605
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140605,
					"content": "She's getting ahead of herself, she hasn't even fully recovered yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140606
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140606,
					"content": "Don't get me wrong. Once she's well, I don't have any problems with her going out to see the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140607
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140607,
					"content": "Thanks, I'll go look for her. Running off like that when she's only just recovered... I have to teach her a lesson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
