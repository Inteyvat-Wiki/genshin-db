					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140301,
					"content": "Have you found Anna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140302,
					"content": "She's on top of a windmill.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "A windmill!? How did that girl get up there? I'm calling the Knights of Favonius right now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140304,
					"content": "She said she'll be back soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "O—Oh. Is that so? Well, she's fine, and that's what matters. You scared me there for a moment! I thought she was stuck on top of a windmill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140306,
					"content": "Thank you, I'll go look for her now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140307,
					"content": "Running off like that when she's only just recovered... I have to teach her a lesson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
