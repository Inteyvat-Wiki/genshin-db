			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140201,
					"content": "I'm so high up! My brother will never find me here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140202,
					"content": "What are you doing here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140203
					]
				},
				{
					"id": 205140203,
					"content": "Wah! How'd you get up here, and without a sound, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140204,
					"content": "No, wait. How did you even find me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140205,
					"content": "Me? I just climbed up here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140206,
					"content": "My brother's looking for me? Huh. It's been some time, hasn't it? I hadn't noticed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140207,
					"content": "I got it. I'll go back soon. Just let me stay here for a while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2051403,
			"completionStepIds": [
				2051403
			],
