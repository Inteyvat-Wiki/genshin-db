			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140401,
					"content": "Oh? You're here? That's unusual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140402,
					"content": "Have you seen a certain girl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "A girl? Oh, you mean Anna? I did see her. She was heading for that windmill over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140404,
					"content": "I'm still quite puzzled by it, myself. I thought she was unwell. Where did she suddenly get all that energy from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140405,
					"content": "She greeted me and just ran by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140406,
					"content": "That kid... Do you have any idea when she recovered from her illness?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
