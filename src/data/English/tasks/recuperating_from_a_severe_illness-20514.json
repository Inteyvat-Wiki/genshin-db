			"dialogs": [
				{
					"id": 205140501,
					"content": "I'm so high up! My brother will never find me here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140502
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140502,
					"content": "What are you doing here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140503
					]
				},
				{
					"id": 205140503,
					"content": "Whoa! How'd you get up here, and without a sound, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140504,
					"content": "Also, how did you even find me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140505,
					"content": "Ah, I know. Mr. Cyrus must have told you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140506,
					"content": "He's always taken care of my brother and I, and I greeted him as I was passing by. He looked so surprised, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140507,
					"content": "Maybe I should try out for the Adventurers' Guild and become an Adventurer. That might be nice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140508,
					"content": "What? My brother's looking for me? Huh. It's been some time, hasn't it? I hadn't noticed at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140509
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140509,
					"content": "I got it. Just let me stay here for a while, I'll go back myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
