				{
					"id": 207400501,
					"content": "So, about those dandelions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400502
					]
				},
				{
					"id": 207400502,
					"content": "Have you managed to get the dandelions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400503,
					"content": "I have them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "Thank you. This should be enough. I'll sow the seeds into these pots...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400505,
					"content": "...Along with those flowers that you found for me earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400506,
					"content": "Ah, yes. I have to thank you, don't I? This is a little token, please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400507,
					"content": "Now, I have to quickly put these flowers inside these pots here. Then the dandelions seeds go there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
