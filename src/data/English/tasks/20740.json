					"nextDialogs": [
						207400602
					]
				},
				{
					"id": 207400602,
					"content": "You can find small lamp grass and sweet flowers in the Whispering Woods. Windrise is where you'll find windwheel asters, and you can find cecilias on Starsnatch Cliff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400603
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400603,
					"content": "You can definitely get the freshest flowers from these areas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400604
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400604,
					"content": "Once you've finished picking them, please bring them back to me as quickly as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
