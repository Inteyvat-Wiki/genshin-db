				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "Got it. I'll set off right away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890102,
					"content": "Amber! Are you here to help out with Jean's commission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890103,
					"content": "Oh, hi. Yeah, I was just getting ready. Who better than an Outrider to mop up some hilichurls on the delivery route?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890104,
					"content": "*sigh* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890105,
					"content": "Sara... What are you still stressing about? I'm an Outrider, and I won't disappoint!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890106,
					"content": "You misunderstand me. I don't doubt your abilities, I'm just overwhelmed at the number of orders piling up in front of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890107,
					"content": "Another bizarre order came in just now. It's like they're hosting a banquet or something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890108,
					"content": "*clears throat*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890109,
					"content": "Is there anything we can help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "I can help with the cooking!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "Really! You don't mind helping?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890112,
					"content": "That would be wonderful! You really are the Good Hunter's guardian angel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890113,
					"content": "Yeah well... Those hilichurls are going to be a handful, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890114,
					"content": "Well, why don't you take this order. Start by getting the ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890115,
					"content": "#Are you sure {NICKNAME} can be trusted? It might end up tasting a bit funky...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890116,
					"content": "We're well past the point of aiming for perfection. This is now a fight to save the Good Hunter's business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890117,
					"content": "A fight?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890118,
					"content": "For this dish, we need... <color=#00E1FFFF>three Sweet Flowers and three Fowls</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890119,
					"content": "Okay, go and get ready. You too, Amber. I'll be waiting here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890120,
					"content": "O—Okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
