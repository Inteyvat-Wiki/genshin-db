				{
					"id": 4890301,
					"content": "One Sweet Madame, received!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890302,
					"content": "Mmm, it smells... pretty good! You have a knack for this — just the person I need!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890303,
					"content": "Hmm, since you cook so well... You might as well take this <color=#00E1FFFF>Sticky Honey Roast</color> next.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>Sticky Honey Roast</color>! We tried that before, with Amber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890305,
					"content": "That's right, a mainstay of the Good Hunter menu. It's my pride and joy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890306,
					"content": "The Knights order it almost every time they come here for a gathering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890307,
					"content": "Let me teach you the recipe for a <color=#00E1FFFF>Sticky Honey Roast</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Wait, didn't you say it's your pride and joy? You're going to teach us how to make it, just like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890309,
					"content": "With your cooking skills, I don't think you will be doing a disservice to the Good Hunter brand! Hee-hee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890310,
					"content": "As soon as that <color=#00E1FFFF>Sticky Honey Roast</color> is ready, please bring it here.",
