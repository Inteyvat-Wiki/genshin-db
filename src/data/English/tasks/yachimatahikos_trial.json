			"dialogs": [
				{
					"id": 722680101,
					"content": "I am Uda of the Jibashiri. Hero of Sangonomiya, I acknowledge that you are worthy to take on this challenge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680102,
					"content": "I am in charge of the trial of \"wisdom.\" Go forth and solve all the puzzles to return the Flames of the High Gate to their places.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680103,
					"content": "It is not bravery that advances bereft of wisdom, but foolhardiness instead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680104,
					"content": "I will await your completion of the challenge at the Tower of the Three Realms above.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
		},
