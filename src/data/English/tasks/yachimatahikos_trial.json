			"dialogs": [
				{
					"id": 722680301,
					"content": "I, Uda of the Jibashiri, acknowledge your great valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680302
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680302,
					"content": "Indeed, you are both \"extensive and meticulous\" in your wisdom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680303
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680303,
					"content": "How can you tell a person's character from these trials?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722680304,
					"content": "To be honest, these words are praises that the Divine Priestess used to bestow upon skilled youths. They eventually came to be written on pennants at the Jibashiri headquarters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
