					"nextDialogs": [
						722390602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390602,
					"content": "They don't look like anything special, never mind like something magical...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390603,
					"content": "Well, here goes nothing. Let's just grab some.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
