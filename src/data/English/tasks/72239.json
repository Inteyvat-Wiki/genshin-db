					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722391301,
					"content": "Uhh, this reads... \"The Bandit, Supada no Hiko\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391302,
					"content": "Uh, no, it should just be \"Supada no Hiko.\" That's that man's name! Let's go tell him, quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7223918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adonis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722391801,
					"content": "After the sun, the true light starts...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391802
					]
				},
				{
					"id": 722391802,
					"content": "The what with the what now? Get out of here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				}
			]
		},
		{
			"id": 7223919,
			"completionStepIds": [
				7223906
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adonis",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722391901,
					"content": "After the sun, the darkness starts...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391902
					]
				},
				{
					"id": 722391902,
					"content": "...But true light hides... within our hearts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391903,
					"content": "...I'd almost forgotten. It's been so long since I've heard this phrase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "Tell me, my good comrade, who sent you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "Master Spartacus!? Master sent you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "Where is he? I only know that he was captured during the uprising by the henchmen of the Sunchild. We lost all contact with him after that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "He's been locked in the altar at the Serpent's Heart, and judging by how things look, he can't get out. That's why he sent us to look for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "That accursed Sunchild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "What instructions did Master entrust you with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "He just asked us to carry a message.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "\"Never give up, children. The hope of Byakuyakoku lives amongst you.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391914,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391915,
					"content": "I... I'm sorry! We have failed you, Master!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391916,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "The resistance is no more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "Eh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "After Master was captured, the backbone of the resistance collapsed utterly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "Only those of us students who followed him ordinarily escaped thanks to being far from the center of events.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "Afterward, those of us who were lucky enough to get away fled to our pre-prepared hiding places, hoping to muster our strength once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "We have excellent strategists, professional scholars, skilled mystics, and reliable doctors amongst us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "Well, that sounds promising!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "That's what we thought too. Given time, we believed that we could revitalize the movement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "But all these things needed funds... which we didn't have any of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "Finally, someone suggested that we sell Dragonbone Orbs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "What's a Dragonbone Orb?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "It is a rare fruit that Dragonbone Flowers will bear under special circumstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "Its fragrance can relax the mind and calm anxious thoughts, sweeping all of one's worries away. As such, it can fetch a very high price on the market.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "Is it really that mystical? You sure this isn't a scam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "I only wish it were all a lie... Naive as I was, I did not perceive the perils that lay down that path.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "I do not know where the formula came from, but I do know that it did earn us a lot of capital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "Everything was going so well... But soon, we discovered that some of our comrades suddenly began to avoid conflict and reject the idea of going into battle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "The number of such people increased by the day, to the point where they requested to leave our ranks. I was unable to stop them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "How did this happen? Is this because the orbs earned you and your comrades so much money that most people lost the will to fight on?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "Do you mean the corrupting allure of money? No... I... I don't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "I only know that when oppressed peoples grow satisfied with their lives, they cease to resist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "That was where the collapse started, and once it began, there was no stopping it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "Sometimes, I actually wonder if the formula for making these things wasn't leaked to us by those despicable rulers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "Sometimes I wonder if the best-selling nature of these orbs wasn't all a false pretense created by those despicable rulers...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "*sigh* If Master had been there, I'm sure that he would have been able to control the situation. He might even have nipped it in the bud right from the start.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "I'm sorry, Master. We could not become hope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "I'm very sorry to hear that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "I cannot face him like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391942,
					"content": "But still, you have my thanks for bringing news of him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391943,
					"content": "I do not have anything with which I can thank you. But if you do not mind, allow me to tell you the secret of the Dragonbone Orbs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391944,
					"content": "They can only be created through the use of the waters of Tokoyo Reisen, that is to say, the waters of Lethe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391945,
					"content": "Perhaps you might be able to exchange it for some money, or keep it for yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391946,
					"content": "Still, be wary. Keep your desire to press onward about you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391940,
					"content": "Would you like to see your Master?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722392401,
					"content": "(There are two rows of text on this headstone. The first row is in the script of Byakuyakoku and is unintelligible.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "An Ancient Stone Tablet"
				},
				{
					"id": 722392402,
					"content": "The second row is in the common script, and it reads as follows:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "An Ancient Stone Tablet"
				},
				{
					"id": 722392403,
					"content": "\"Here lies Spartacus the Righteous, known now as Supada no Hiko. Beneath lies the litany of his crimes. Read them and remember our history.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "An Ancient Stone Tablet"
				},
				{
					"id": 722392404,
					"content": "\"Supada no Hiko, the notorious outlaw, mastermind of great crimes, and the root of unrest. Now in the name of Tokoyo Ookami, may his sight be cut off, and may his soul be crushed. May he be thrown into a deep prison, now and forever.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An Ancient Stone Tablet"
				}
			]
		}
	]
}