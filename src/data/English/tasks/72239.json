			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Supada no Hiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390301,
					"content": "You... Who are you? You sound quite familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390302,
					"content": "Eh? You've forgotten us already? Oh no, you're in worse shape than Paimon thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390303,
					"content": "Thank you. Are we truly acquainted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390304,
					"content": "We just met, actually.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "Ah, yes, I remember. In this place, your very soul shall be eroded. My memories must have been ground away too severely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390307,
					"content": "I'm sorry, I... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390308,
					"content": "Did you manage to find anything useful, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390309,
					"content": "Is your name Supada no Hiko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "Supada no Hiko... Right... Yes, that's correct! I'm the leader of the resistance, Spartacus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390313,
					"content": "Ooh, so they're both your name, then? As expected of an awesome leader, you've even got two names!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390314,
					"content": "Thank you so much for returning my name to me. I seem to have remembered some other things as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390316,
					"content": "\"After the sun, the darkness starts, but true light hides within our hearts.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390317,
					"content": "What's that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "This is our secret pass-code.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390319,
					"content": "Now that I have my name back, my memories are returning as well. This should be our pass-code.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390320,
					"content": "Now let me tell you where my children are hidden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390321,
					"content": "Do you have any message you'd like me to pass along?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "Let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390323,
					"content": "Tell them this for me: never give up, for the hope of Byakuyakoku lives amongst them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390324,
					"content": "Would you like me to bring them here to see you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "No. Never.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390326,
					"content": "Our only advantage is that the enemy is in the open, while we are in the shadows. The hearts of Byakuyakoku's people are all with us, and we must not reveal ourselves so cheaply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390327,
					"content": "Moreover, I cannot remember every single one of their names. I mean, I even forgot my own...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390328,
					"content": "So yes, tell them to never give up, for the hope of Byakuyakoku lives amongst them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390329,
					"content": "If they are no longer there...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "No. That will not happen. As long as the corrupt leaders who control the Sunchild are still in place, they will always be there. The resistance will continue to endure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390331,
					"content": "Bring my admonishment to them: to never give up, for the hope of Byakuyakoku lives amongst them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390332,
					"content": "That will be enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390310,
					"content": "Is your name Supada the Bandit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "Oh, come on! It's Supada no Hiko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390305,
					"content": "We were just looking for your identity.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				}
			]
		},
