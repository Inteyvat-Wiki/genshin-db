			"dialogs": [
				{
					"id": 731850401,
					"content": "Whoa! This Sumpter Beast is huge. It must hurt so bad getting kicked by it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850402,
					"content": "Feed it with the food Mr. Elber gave us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850403,
					"content": "Nice and slow...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850404
					]
				},
				{
					"id": 731850404,
