			"trigger": {
				"objectNames": [
					"Elber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "Whew. Thanks, Traveler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850102,
					"content": "It's good to see they're alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "I'm Elber, a businessman. I was just relaxing here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850105,
					"content": "I never expected to get attacked by those hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850106,
					"content": "Didn't you have any guard with you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "We have heard in town that normally merchants would hire the Eremites to escort their goods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850109,
					"content": "Well, that costs you Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850110,
					"content": "The prices they asked for were just astronomical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850111,
					"content": "I'm running a small business. Can't afford that kind of price...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850112,
					"content": "I thought, well, I know a thing or two about fighting monsters anyway, and it's not a long haul, so I might as well go on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850113,
					"content": "But I didn't expect the hilichurls to spook my two Sumpter Beasts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850114,
					"content": "I was run down by one before I could even react, and when I came to my feet, I got kicked by the other one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850115,
					"content": "Uh-oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850116,
					"content": "They soon ran away, and I was besieged by the hilichurls... Lucky for me, you were here to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850117,
					"content": "But all my stuff is on those two Sumpter Beasts... Traveler, could you please help bring them back for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850118,
					"content": "I don't want to get kicked...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "Don't worry. They are gentle in nature, it's just those hilichurls knocked over their food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850121,
					"content": "They had traveled so far with the loads and were very hungry. That's why they got so restive after their food was knocked over...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850122,
					"content": "So they were disrupted when eating and their food was messed up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850123,
					"content": "Ugh... Paimon is getting angry just thinking about that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850124,
					"content": "You are quick to catch on to that, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "Well, I'll just leave the food to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850126,
					"content": "Please feed the Sumpter Beasts when you find them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850127,
					"content": "They won't throw tantrums as long as there's food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850128,
					"content": "I noticed one of them knocked over the hilichurls and ran away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850129,
					"content": "The other one seems to have been taken away by the hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850130,
					"content": "I'll mark their locations roughly and leave the rest to you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850131,
					"content": "You'll be fairly paid for the return of my goods!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850119,
					"content": "They could knock me over...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "No one was protecting you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "It was nothing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
