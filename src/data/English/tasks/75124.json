							10051.33
						],
						"pointId": 10188
					}
				]
			},
			"dialogs": [
				{
					"id": 751240301,
					"content": "Ah, such lovely timing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "I can barely believe that my photo-taking quest, which had eluded me no matter how hard I tried, was completed so quickly with your help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "All these Flowcurrent Birds, their bobbing, rolling forms sitting within their swim rings! A sight so moving as to bring one to tears...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "Is it really that moving...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "Sometimes, we make our life's pursuit out of something that others cannot understand — indeed, even consider absurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Nonetheless, I believe that the number of Flowcurrent Bird enthusiasts in the world shall increase, so long as I keep taking these photos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "Paimon one hundred percent believes in this future too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "Ah, thank you both so much for your help! Please, take these as tokens of my gratitude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
		{
