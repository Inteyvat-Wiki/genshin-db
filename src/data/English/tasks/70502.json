	"talks": [
		{
			"id": 7050201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050201",
							"2"
						],
						"stepId": 7050201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Luka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "Hello there! So, you must be the renowned Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020102,
					"content": "That's me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "Hey, don't forget about the equally renowned Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020105,
					"content": "Hehe, of course. Well, it just so happens that our tavern, Angel's Share, is hosting a Bartender's Academy Week. I'm hoping the event might interest you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020106,
					"content": "Basically, you'll have full access to all of our ingredients to mix cocktails or any other drink you please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020107,
					"content": "As long as you refrain from being wasteful, you can enjoy unlimited refills for the drinks you create.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020108,
					"content": "Unlimited refills!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020109,
					"content": "Also, you'll be rewarded handsomely if the guests are happy with your drinks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020110,
					"content": "What? There's even rewards!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020111,
					"content": "Well, Paimon is sold...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "Where do we sign up!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020113,
					"content": "It's called an \"academy\" but attendance is certainly not mandatory...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020114,
					"content": "And you don't have to make your decision right away. You're more than welcome to give it a try first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020115,
					"content": "So, what do you think? Will you give the academy a try?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020103,
					"content": "Uh, can I help you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050203",
							"2"
						],
						"stepId": 7050203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "Hey, I know you two. So, what can I get for you today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020202,
					"content": "Hi, Charles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "Hey, Charles! Actually, we came to be bartenders today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020204,
					"content": "Bartenders? Oh, so Luka roped you two in, did he? He's got quite a knack for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}, you're certainly talented at handling difficult tasks, there's no doubt about that. But mixing cocktails is a whole different game, it's delicate work and requires a certain amount of finesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020206,
					"content": "Everything from the ratios of your ingredients to your mixing techniques could affect the final product.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020207,
					"content": "#Don't worry. {F#She's}{M#He's} a fantastic cook. Cooking and cocktail-making have a lot in common, you know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020208,
					"content": "Alright, I'll take your word for it. Oh, and one more thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020209,
					"content": "In a previous event, we had a student who arbitrarily mixed three kinds of hard liquor. Just one glass was enough to leave a customer passed out on the floor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020210,
					"content": "So in light of that incident, we decided to no longer provide alcoholic ingredients to beginners. I hope you'll understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020211,
					"content": "No problem at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "Great, that just about covers all I have to say. You'll learn all the skills and techniques you need on the fly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050205",
							"2"
						],
						"stepId": 7050205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "Mmm, you're a quick learner, this tastes pretty good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020302,
					"content": "Paimon agrees! This is amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020303,
					"content": "That was just practice, though. On the job, customers often will have special requests for their drinks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020304,
					"content": "Some may enjoy a stiffer drink, while others might prefer something more sour, everyone has their own preferences. Adjusting the amounts of the ingredients is always the key.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020305,
					"content": "Paimon would like a Caramel Pinecone, extra sweet, in the biggest glass you have. Please and thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020306,
					"content": "Well, that's about all there is to it. But, to become a truly exceptional bartender, in addition to mixing skills, you'll also need to master conversing with your customers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020307,
					"content": "I'm up to the challenge!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "Alright, in that case, you two can take this counter. If you have questions or need any help, just give me a holler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020310,
					"content": "Whew... Class dismissed! Wait, where's Paimon's Caramel Pinecone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020311,
					"content": "So you really did want a Caramel Pinecone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "I love chatting with people.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
