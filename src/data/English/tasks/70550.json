					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "Your Fairweather Frolic is here. Go on, give it a try!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "Wow, so a Fairweather Frolic is this color? Purple sky... Is it supposed to be a bright, shiny night?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500203,
					"content": "Maybe it's supposed to be a cloudless sky at dusk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "Klee will take a sip first... Then you can think about it more carefully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500206,
					"content": "Ahhh, finished...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500207,
					"content": "Yummy! Both sweet AND sour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500208,
					"content": "If Klee drank this while eating Grilled Fish, I could definitely gobble down two, or three, or four, or even... five!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500209,
					"content": "But one drink isn't enough. Klee wants to try... a drink that tastes like cake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500210,
					"content": "Roger that. How about a \"Cake in a Cup\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#Hmm... Klee doesn't know what drink to choose. Why don't we decide together, {M#Mr.}{F#Miss} Honorary Knight?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500214,
					"content": "That candy you've brought with you looks very special!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "This stuff? Heehee... Mom taught me how to make it using the alchemy bench!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500216,
					"content": "A dash of sugar... then a lot more sugar, then some flowers from Mom's friend in Fontaine, star honey from Aunty Barbie, and finally some magical jam from Aunty Tavia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500217,
					"content": "Put everything together on the alchemy table, wish for the shape you want, then recite Mom's incantation, and... poof! Dodoco-shaped candy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500218,
					"content": "That's quite the process...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "Klee can give you some Dodoco Candy, too, if you want! And if you really like them, I could even teach you my mom's incantation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500221,
					"content": "That way, you could make your own candy whenever you want!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500222,
					"content": "Thanks for sharing your amazing recipe, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "Heehee, if you get stuck, remember to come ask Klee! When it comes to magical candy, I'm an expert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500225,
					"content": "Do you have any other plans for today?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "Yeah! Mom gave me an amazing book recently. She said I have to read one chapter every night, learn something useful, and then go to bed early!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500227,
					"content": "That book taught Klee how to make something called \"propellant.\" Now Jumpy Dumpty can go \"Phwooar!\" and bounce even higher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500228,
					"content": "I—Is that really something you should be learning?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "It's not hard at all... In fact, it's a lot like making bombs. You just have to be careful when trimming it down — it's like sharpening a pencil that could suddenly go BOOM!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500231,
					"content": "Bedtime's an important part of Klee's schedule too! Mom sits by my side and tells me all kinds of wonderful stories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500232,
					"content": "She has a lamp made of gemstones, and when she turns it on, it goes \"ka-bling\" and lights up the ceiling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500233,
					"content": "Does the ceiling show scenes from the stories?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "Yeah! When something happens in the story, the lights on the ceiling make pretty pictures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500235,
					"content": "Sometimes, Mom falls asleep before the story ends, so Klee has to tuck her in instead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500236,
					"content": "#As soon as Klee learns how to use the lamp, I can come tell you stories, {M#Mr.}{F#Miss} Honorary Knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500237,
					"content": "That sounds great!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "Heehee, Klee has memorized so many wonderful stories — enough to make everyone happy every day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500240,
					"content": "Do you plan to eat anything else today?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "Yeah! When Klee gets back home, I'm gonna eat some salted nuts while reading my book!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500242,
					"content": "Klee used to eat cake after dinner, but Master Jean said it's too sugary, and it's not good to eat sugary things before bed! Apparently, it makes you chubby and gives you toothaches!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500243,
					"content": "So Mom got some advice from Aunty Barbie, and now she gives me nuts instead. She says they help my brain remember things better!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500244,
					"content": "Nuts don't have much flavor — it's like chewing on grass — but they're okay if you add a little salt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500245,
					"content": "That sounds like a great solution — nutritious and healthy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "There must be some ingredients that are both healthy and sweet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "Oh yeah... Klee still wants to eat sweet things — like cake, for example! Maybe we could just go easy on the cream... or add more fruit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500248,
					"content": "Oh, right! That friend of Mom's who's always wearing glasses gave her a big bag of Fontainian Bulle Fruit. They're so round and rolly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500249,
					"content": "Klee ate a whole bunch of those, and they were super sweet... but Master Jean said it was okay, because \"sweet fruit isn't the same as sweet sugar!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500250,
					"content": "So if Klee really has to eat nuts, maybe I can just soak them in some fruit juice first?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500251,
					"content": "Speaking of food, I hope you're getting your three square meals a day?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "Three square meals? Heehee, Klee often eats five meals a day — sometimes even seven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500253,
					"content": "Seriously!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "Adventuring takes a lot of energy, and if I eat too much at once, I can't run so well... So it's better to eat lots of smaller meals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500255,
					"content": "Albedo used to prepare all Klee's meals, and my lunchbox was always arranged so neatly, just like a pretty painting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500256,
					"content": "That sounds like Albedo, alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "When Albedo's busy at Dragonspine, Klee goes to eat with the other Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500259,
					"content": "Kaeya's camp is usually the neatest, while Amber sometimes camps in the trees — it's so much fun! Oh, and Aunty Hertha makes the best food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500260,
					"content": "When my mom comes back, there'll be even more yummy food to eat. There's this one dish where she takes loads of different fish and makes them into little pudding cubes — it's called Rainbow Fish Jelly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500261,
					"content": "You're making me hungry...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "Her Chococo Crunchy Slices are fantastic too! It's her newest creation, made with chocolate and cookies! They're a little bitter, but they're crunchy, they smell scrumptious, and they have a really sweet aftertaste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500264,
					"content": "Whenever I eat them, I feel sooo full of energy... Next time, Klee will have to bring some for you to try!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500265,
					"content": "Alright, I think I know how to improve that drink!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "Let me mix another one for you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "Yeah! That was quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500268,
					"content": "Klee's looking forward to finding out how tasty your next concoction is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500262,
					"content": "Great food from a great adventurer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "I'd like to try Albedo's cooking sometime...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "I'll be waiting!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "I—Is that easy to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "I'll work really hard to learn how to do it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "What an amazing treat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "Alright, get ready for another super yummy drink!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "Any flavor Klee wants, she can have!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "It's not the most fitting color... How about I make a few changes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
