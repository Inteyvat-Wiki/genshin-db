			"dialogs": [
				{
					"id": 705500301,
					"content": "Tada! It's done — I just know you're going to love this new creation!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "Wow! There's Dodoco Candy on top!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500303,
					"content": "There's so much orange in this cup, and Dodoco looks like he's lying on top of white, fluffy clouds... and the weather inside looks much better, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500304,
					"content": "Would you like to taste it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "Yummy... It's so delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500306,
					"content": "Klee has to drink slowly... I can't just gulp it down, or I'll miss all the yummy flavor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500307,
					"content": "#{M#Mr.}{F#Miss} Honorary Knight, this is amazing... It's like you mixed sunshine with juice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500308,
					"content": "Klee was so tired from playing, but now I feel refreshed... and warm... and peaceful...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500309,
					"content": "#*yawn* You're the best, {M#Mr.}{F#Miss} Honorary Knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500310,
					"content": "How about you choose a name for this drink, Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "Really? Let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500313,
					"content": "Hmm... When the weather's nice, and Dodoco's happy, Dodoco will want to sing, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500314,
					"content": "And when Dodoco sings, Klee wants to sing, too... So, let's call it... Dodoco's Duet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500315,
					"content": "What a wonderful name!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "Heehee, thank you — and thanks for making such a yummy drink for Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500318,
					"content": "Klee's gonna go tell Mom that the best drink in Mondstadt right now is Dodoco's Duet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500319,
					"content": "I'm glad you like it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "#Heehee! Klee's gonna write down Mom's incantation and give you a copy, {M#Mr.}{F#Miss} Honorary Knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500322,
					"content": "Then you should learn magic too, so you can make all the candies you want!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500323,
					"content": "See you next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500320,
					"content": "I passed your test, Miss Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "Your names are the best!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "I'm sure you'll come up with something amazing!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
		}
	]
