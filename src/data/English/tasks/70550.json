							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#Huh? Is that... {M#Mr.}{F#Miss} Honorary Knight!? Yippee, it's you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500102,
					"content": "Hey, it's Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "Haha, Aunty Eula told Klee that Miss Hertha had found someone amazing to help out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500105,
					"content": "#Seeing you here, {M#Mr.}{F#Miss} Honorary Knight, Klee knows this must be the best drinks stand in all of Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500106,
					"content": "So kind of you to say, Klee. That's the ultimate goal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "Y—You mean this stand ISN'T already the best?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500109,
					"content": "#Well... out of all the drinks stands Klee's ever visited, {M#Mr.}{F#Miss} Honorary Knight's is easily the best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500110,
					"content": "#Aaand... no matter what drinks {M#Mr.}{F#Miss} Honorary Knight makes, Klee will definitely think they're yummy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500111,
					"content": "This time, Klee, I need you to be a little tougher on me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "Oh! Y—You want me to be mean? But... Klee could never be mean to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500114,
					"content": "Hmm, let me think... I know! I'll pretend to be Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500115,
					"content": "Whenever Albedo reviews Timaeus's work, his face goes super serious, and Klee can hear every word he says!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500116,
					"content": "Brilliant, then you can be my teacher!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "Heehee... Get ready for Klee's super amazing order!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500119,
					"content": "I'm going fish-blasting with Mom soon... Don't tell Master Jean, though!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500120,
					"content": "Me and Mom blasted sooo many fish today... Don't tell Master Jean, though!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500121,
					"content": "These past few days, I've been having such a blast with Mom all day long! It's been so much fun! Even being sent to solitary confinement couldn't wipe the smile off my face!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500122,
					"content": "So, Klee wants to order a Fairweather Frolic. Anything like a bright, sunny day will definitely put Klee in a super-duper mood!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500123,
					"content": "Got it, Miss Klee, I'll get right on it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "Heehee... I wonder what it'll taste like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500124,
					"content": "Understood, Master Alchemist Klee, I'll get right on it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "Brilliant, then you can be Master Alchemist Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "This time, you can criticize me all you like!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "So kind of you to say, Klee. I'm working hard to become the best!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "Hey, Customer Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
		{
			"id": 7055002,
