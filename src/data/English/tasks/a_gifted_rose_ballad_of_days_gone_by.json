			"dialogs": [
				{
					"id": 732060402,
					"content": "About Affan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "Hmm? Did something happen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060404,
					"content": "You tell Sabbah about the difficulties Affan has encountered.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "I see, so that's why you have come to me for help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060406,
					"content": "I'm honored that I am the one you thought of when something like this came up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060407,
					"content": "That said, I did not specialize in plant cultivation, and my experience is limited. I'm not sure that I'll be of much help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060408,
					"content": "Still, I will try my best. The gentleman you mentioned who cultivated a new species of rose also interests me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060409,
					"content": "I will visit Mr. Affan's nursery when I have some time. You can look for me there later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
