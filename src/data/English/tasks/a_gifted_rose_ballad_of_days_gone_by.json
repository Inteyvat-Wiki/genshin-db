			"dialogs": [
				{
					"id": 732030619,
					"content": "How's life in Aaru Village?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "It's alright. I have food and a roof over my head. All the essential things in life are taken care of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030621,
					"content": "I was banished, after all, so I can't dream of having books and research instruments here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030622,
					"content": "This place has been used as exiled scholars' banishing grounds for quite a while. Life is hard and practical here, so naturally, no one here is interested in academics or research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030623,
					"content": "I'm certainly not the first exile, and probably won't be the last.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030624,
					"content": "All I can do is to learn to live with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
					"content": "Ah, I just rambled for a long time... But it feels good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030626,
					"content": "Before you got here, I really didn't have many friends, and it could get pretty lonely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030629,
					"content": "Very few people in the village are into gardening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030630,
					"content": "...Well, that's not entirely true. An old man living to the north of the village also plowed a plot to grow flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030631,
					"content": "I've visited him before. He's a slightly eccentric old man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030632,
					"content": "I saw him planting stones, but he insisted that they were flowers, and even kicked me out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030633,
					"content": "It must be lonely, living all by himself. I can understand that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030634,
					"content": "You helped me with my Sumeru Roses... Maybe you can help him with his plants too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030635,
					"content": "You and Paimon should visit him if you get a chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
