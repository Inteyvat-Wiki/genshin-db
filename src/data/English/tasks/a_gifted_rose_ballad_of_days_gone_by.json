		{
			"id": 7329002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329002",
							"2"
						],
						"stepId": 7329002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "How I miss this sight... Here, your presents are ready too. Please, take them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900202,
					"content": "They're all seeds of plants that won't grow here. If you have a yard somewhere else, you can watch them mature there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900203,
					"content": "Ah, I just rambled for a long time... But it feels good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900204,
					"content": "Before you got here, I really didn't have many friends, and it could get pretty lonely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900207,
					"content": "Very few people in the village are into gardening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900208,
					"content": "...Well, that's not entirely true. An old man living to the north of the village also plowed a plot to grow flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900209,
					"content": "I've visited him before. He's a slightly eccentric old man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900210,
					"content": "I saw him planting stones, but he insisted that they were flowers, and even kicked me out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900211,
					"content": "It must be lonely, living all by himself. I can understand that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900212,
					"content": "You helped me with my Sumeru Roses... Maybe you can help him with his plants too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900213,
					"content": "You and Paimon should visit him if you get a chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
