			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "\"Rose, oh roses, grant me my wish.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070502,
					"content": "\"Blooming from the stone, the Golden Rose sang to me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070503,
					"content": "\"She sang:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070504,
					"content": "\"No land but folk songs bore my spirit.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070505,
					"content": "\"Songs shall defy my fate, and overcome my destiny.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070506,
					"content": "\"They will surpass me, surpass time. They will surpass the ever-lasting withering of life.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070507,
					"content": "This is the song Uncle Shafaqat taught us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
