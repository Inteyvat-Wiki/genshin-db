					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7320701",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060601,
					"content": "I'm sorry, Uncle Shafaqat. I wasn't able to fulfill your last wish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060602,
						732060609
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060602,
					"content": "Who's Shafaqat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060603
					]
				},
				{
					"id": 732060603,
					"content": "Ah yes, you children were pestering me about the old ghost, weren't you? Well, that's not his real name. I mean, who would actually be called that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060604
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060604,
					"content": "I heard from my elders that his name was Shafaqat. He left Sumeru City when he was young and came to our village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060605
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060605,
					"content": "He built this house after arriving here and lived in it by himself, and for decades, he barely left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060606
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060606,
					"content": "I've never seen him as a young man, but they say that he didn't really dislike children at that time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060607
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060607,
					"content": "He grew many trees and flowers in the front and back yard of his house. Children liked to run over to his place and ask for Ajilenakh Nuts, and also to listen to him talk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060608
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060608,
					"content": "But by the time I met him, he'd already become old and was called the old ghost, and he'd also come to dislike children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060621,
					"content": "There must be another way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060622
					]
				},
				{
					"id": 732060622,
					"content": "What other way can there be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060623
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060623,
					"content": "Uncle Shafaqat... That old geezer's already passed away in peace. If he was still alive, I could ask him what special methods could be used to cultivate these roses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060624
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060624,
					"content": "Who can I ask now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060625
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060625,
					"content": "I know an Amurta researcher named Sabbah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060626
					]
				},
				{
					"id": 732060626,
					"content": "Oh, you mean that outsider girl. Can she help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060627
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060627,
					"content": "Besides, she came by here before and I drove her away. Will she still be willing to help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060628
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060628,
					"content": "I'll give it a shot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060629
					]
				},
				{
					"id": 732060629,
					"content": "You're a good kid. It's alright if you can't find anyone to help. The thought is enough for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060609,
					"content": "Why are you so obsessed with growing flowers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060610
					]
				},
				{
					"id": 732060610,
					"content": "Once in a while, some outsiders would be forced to settle here in our village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060611
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060611,
					"content": "Some people never got used to living here, even if they kept pushing themselves to do so, and so they ended up alone for the rest of their lives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060612
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060612,
					"content": "That old geezer Uncle Shafaqat was probably one of them. Everyone just accepted this state of affairs over time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060613
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060613,
					"content": "But no matter how many years passed, I refused to get used to such a thing. It's really such a pity, what happened to him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060614
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060614,
					"content": "You would have loved his garden too if you ever saw it. Pretty flowers of all kinds of colors, and so many trees of varying heights...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060615
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060615,
					"content": "The person who cultivated such a great garden passed away so quietly. And the only thing people would remember about him now is that the old ghost would take away naughty children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060616
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060616,
					"content": "I refuse to accept this. He wrote in his notes that he wanted these roses to grow everywhere. And I want to fulfill his wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060617
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060617,
					"content": "I'm old anyway, so I don't care how others may see me. My life will be worth it if I can do this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060618
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060618,
					"content": "I've cleaned up his house for him and sorted out the large pile of booklets he'd left behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060619
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060619,
					"content": "I can show you a volume or two if you're interested.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060620
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060620,
					"content": "I'll put these notes <color=#00E1FFFF>in front of the house</color>, just so he can see the sun for a bit through them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320701,
			"completionStepIds": [
				7320701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320701",
							"2"
						],
						"stepId": 7320701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070101,
					"content": "You're here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070102,
					"content": "This must be the person you found to help me, right? I said something harsh to her just a few days ago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070103,
					"content": "I'm really... *sigh* I'm old and useless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070104,
					"content": "Aren't we having a friendly chat right now? Don't take it to heart, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070105,
					"content": "Have the seeds germinated?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070106
					]
				},
				{
					"id": 732070106,
					"content": "Mr. Affan and I went to take a look, and they haven't, unfortunately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070107,
					"content": "Based on my observations, these seeds appear to have gone through petrifaction. There are two possible reasons for this:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070108,
					"content": "The first possibility is that they lost all possibility of growth after a long period of natural weathering and have thus transformed into a petrified state.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070109,
					"content": "If this is the case, the seeds will be unable to germinate. However, the probability of this hypothesis proving true is low.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070110,
					"content": "It takes a very long time for petrifaction to take place, and these seeds do not meet that time requirement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070111,
					"content": "The second possibility is that this breed has a strong affinity for Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070112,
					"content": "That is to say that they can gather enough Geo elements while in seed form to form a stony shell over their exteriors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070113,
					"content": "If the above hypothesis is true, this means that these seeds can be preserved for a long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070114
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070114,
					"content": "Paimon... Paimon doesn't really get it. Are you saying that the seeds have turned to stone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070115,
					"content": "So they're stones, huh? Then I suppose all hope is lost. Golden Roses can't grow from stones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070116,
					"content": "Golden Rose? Do you refer to the Golden Rose that the folk song sings of?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070117,
					"content": "Oh, you probably don't know about this. The village has a rose folk song that has been passed down, and it was originally composed by Uncle Shafaqat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070118
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070118,
					"content": "He taught the folk song he composed to the generation before me, and they taught it to their own children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070119
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070119,
					"content": "There are already people in my generation who have never heard of this song, and when our generation is gone, no one will remember him anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070120
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070120,
					"content": "\"Rose, oh roses, grant me my wish.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070121
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070121,
					"content": "\"Blooming from the stone, the Golden Rose sang to me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070122,
					"content": "That's right... We can make the stones bloom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070123
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070123,
					"content": "Did you think of something, Sabbah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070124
					]
				},
				{
					"id": 732070124,
					"content": "As the song hinted, perhaps breaking the stone shell will let the seeds sprout from the stones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070125
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070125,
					"content": "Normally, an ideal planting environment needs to be created to awaken the seeds and let them break through the seed casing on their own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070126
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070126,
					"content": "But this rose breed has a seed casing that is too hard for the sprout to break through. So we can try lending them a hand instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070127
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070127,
					"content": "Is this fine with you, Mr. Affan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070128
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070128,
					"content": "Do you mean to break the seeds open by force?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070129,
					"content": "Obviously, we're not going to completely smash the seeds. We have to get someone nimble to do this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070130
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070130,
					"content": "#{NICKNAME}, can you do it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070131,
						732070132
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070131,
					"content": "Doing the dirty work again...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				},
				{
					"id": 732070133,
					"content": "You must be careful. Use <color=#00E1FFFF>Blunt Attacks</color> to break the seed casings first, then use the power of <color=#00E1FFFF>Dendro</color> to awaken the seeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070132,
					"content": "I'm on it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				}
			]
		},
		{
			"id": 7320703,
			"completionStepIds": [
				7320703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320703",
							"2"
						],
						"stepId": 7320703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "After you wait in silence for some time, young shoots slowly emerge from the soil...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "Wow, Sabbah's method really worked!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070302,
					"content": "They're finally sprouting! Finally...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070303,
					"content": "Looks like Mr. Shafaqat's wish can finally be fulfilled after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070304,
					"content": "Mr. Affan, you told me before that this breed of rose is something that he cultivated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070305,
					"content": "To be able to cultivate a new species, he must have been a researcher who was exiled here, just like me, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070306,
					"content": "Yes... He was exiled to this village, and he lived in the house behind us his whole life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070307,
					"content": "I see. That's probably how all of us exiles will end up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070308,
					"content": "Speaking of which, cultivating new species is something only the top researchers can do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070309,
					"content": "It's a great pity that a person like him faded into nameless obscurity so far away from the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070310,
					"content": "Are you thinking about your own future as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070311,
					"content": "Keep your chin up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "Yes, child. You still have a long way to go, and lots of things to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070313,
					"content": "Don't be trapped in melancholy. I don't want to see a second old ghost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070317,
					"content": "You're right. I shouldn't be getting all melancholic at a happy time like this. Let's get back on topic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070318,
					"content": "These Golden Roses have only just sprouted. They have yet to bloom. I want to keep watching over them until they bloom. How about you all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070319,
					"content": "Same here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "Let's give them more time to absorb more nutrients. We'll reconvene later and watch them bloom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070314,
					"content": "(I'm not sure how we can console Sabbah...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "Don't be sad. Look, in the end, he still managed to leave us the Golden Rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070316,
					"content": "They are the proof that Uncle Shafaqat once existed in this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				}
			]
		},
