			"dialogs": [
				{
					"id": 220220401,
					"content": "In Liyue, there is a dish called Bamboo Shoot Soup. It's supposed to be very delicate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220402
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220402,
					"content": "Xudong... he changed this one too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220403
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220403,
					"content": "\"Chop Snapdragon and boil it with Mushrooms. Add Salt and Sugar. The soup will taste like Ham.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220404
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220404,
					"content": "Who would cook these things together!? And even if the soup tasted like ham, it's not as if there would be any in there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220405
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220405,
					"content": "Forget it... Traveler, what I want to ask is: \"Besides raw meat, what else is in Bamboo Shoot Soup?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220406,
						220220407,
						220220408,
						220220409
					],
					"speakerTitle": "Parvaneh"
				},
				{
