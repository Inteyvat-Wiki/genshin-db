			"dialogs": [
				{
					"id": 760740101,
					"content": "That's such a weird instrument... No matter how Paimon plucks it, there's not a single sound! Is it broken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740102,
						760740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740102,
					"content": "Let's follow those Seelie first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740103
					]
				},
				{
					"id": 760740104,
					"content": "Huh? But I definitely heard music just now. And singing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740105
					]
				},
				{
					"id": 760740103,
					"content": "Yeah, forget the instrument for now. Just follow the Seelie up, and we'll probably find the treasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740105,
					"content": "R—Really? But Paimon only heard the wind... Wait, is it one of those situations where only the person strumming it gets to hear the music?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740106,
					"content": "Alright, let me give it a try too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740107,
					"content": "Paimon gives the strings a firm strum...\\n",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760740108
					]
				},
				{
					"id": 760740110,
					"content": "#Waaah, still no sound at all! {NICKNAME}, are you really sure you heard something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740111,
					"content": "Whatever, forget the instrument for now. Just follow the Seelie up, and we'll probably find the treasure!",
