			"dialogs": [
				{
					"id": 726940501,
					"content": "Heh! If that's the amount I'm getting for one of these, then I just need to sell 20,000 of them to pay off my debt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940502
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940502,
					"content": "As simple as that... Uh, you seem to have some questions, I presume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940503,
						726940505
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940503,
					"content": "What do you plan to sell?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "I plan to sell toys, but... Unfortunately, the toys are yet to be produced. Please check them out once I have them ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940505,
					"content": "Nothing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940506
					]
				},
				{
					"id": 726940506,
					"content": "If you've nothing to say, then don't bother me. I'm currently making a batch of important products.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		}
	]
}