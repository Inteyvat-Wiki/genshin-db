			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940301,
					"content": "Have you collected the source materials using the Collector? The source materials play a critical role in shaping the toys. Be careful with your choice, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269404,
			"completionStepIds": [
				7269404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269404",
							"2"
						],
						"stepId": 7269404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940401,
					"content": "How's it going? Have you collected any materials?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940402,
					"content": "They're all in the Collector.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "Alright then, lemme add the materials to my One-of-a-Kind, Never-Failing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940404,
					"content": "It's \"The Great Machine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940405,
					"content": "Fine. Lemme add the materials to the Great Machine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940406,
					"content": "Bertrand connects the Collector to The Great Machine.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "Wow! And what's next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940408,
					"content": "Will the machine go \"chug chug chug\" and then spill out the toys with \"crackle and kaboom\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940409,
					"content": "Hahaha, that is totally...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940410,
					"content": "Impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940411,
					"content": "What are you thinking? That's only the first step of the three processes. We're far from getting things done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940412,
					"content": "Paimon gets it, so we need to complete all the processes, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940413,
					"content": "Yep, we need all three processes in order to produce the toys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940414,
					"content": "That's so troublesome...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "Look at you, always wanting a quick fix. It takes patience to make toys. We must infuse every process with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940417,
					"content": "With what? Oh, Paimon gets it. It's toys we're making, after all, so we must infuse every process with real passion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940418,
					"content": "Yep, my passion for Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940419,
					"content": "Uh... Although that's not what Paimon was thinking, Paimon does share the sentiment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940420,
					"content": "Hey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "Hehe, Paimon was just trying to make conversation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940422,
					"content": "Then, Bertrand, what do we do next? Should we move on to the following processes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940423,
					"content": "No worries. Since I've recently adjusted the machine, and this particular process hasn't been tested yet, I need to check if it works well with the materials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940424
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940424,
					"content": "This requires some time. Please come back later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940415,
					"content": "That's so much work...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				}
			]
		},
