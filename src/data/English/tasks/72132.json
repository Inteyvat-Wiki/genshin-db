			"trigger": {
				"objectNames": [
					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "Thanks for your efforts. Although the island is still full of dangers, this will give a little hope to all the people who have left their hometown and long to return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "The fact that the rain has stopped may actually make the warring parties more aggressive in fighting for the island...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "But they were never going to help resolve the situation on the island anyway. What we have done is at least better than leaving the problem to fester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Now, the gift I promised you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "This is the famed spear once used by the Prefects of Yashiori. Now, I'm not sure how much use this drawing will be to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "But if you give it to a sufficiently skilled smith, they should be able to recreate the glory it once had in Lord Kitain's hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "*sigh* Alas, the age of heroes has come and gone, and the Kitain, who once destroyed so many evils, will never return again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Still, we seem to have gotten a step closer to matching Lord Kitain's deeds in the present, thanks to your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "Next, I will go to my friends in the Shogunate army to see if there's anything I can help with. I hope to see you again in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
