			"dialogs": [
				{
					"id": 790480101,
					"content": "There are some pieces of paper here. Are they someone's notes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480102
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790480102,
					"content": "Judging by the words they used... It seems like a painter's diary?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480103,
						790480104
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790480103,
					"content": "So confident...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790480105
					]
				},
				{
					"id": 790480105,
					"content": "But Paimon gets it! Without that kind of nerve, no matter what you do, it can be hard to master it quickly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480106
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790480106,
					"content": "But this diary doesn't say much, Paimon is kinda curious about what happened to him after that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480107
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790480107,
					"content": "#Perhaps we can find the rest of the diary somewhere else. {NICKNAME}, let's just keep an eye out for it, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Read"
				},
				{
					"id": 790480104,
					"content": "Even a bit arrogant...",
