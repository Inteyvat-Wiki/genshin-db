						],
						"pointId": 7030
					}
				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "This makes no sense... How did you do that!? My... my reputation is destroyed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "It was an honor doing battle with you, good Sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "No-Frills Instant Kill"
				},
				{
					"id": 716665003,
					"content": "What the... So polite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Haha! So, been busy losing while we were away, Bull-Chu{RUBY#[S]\"Bona-Fide Beetle Battle King\"}cker?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "I don't see it that way. Unless the Bona-Fide Beetle Battle King is ready to give up now, he hasn't lost to me yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "No-Frills Instant Kill"
				},
				{
					"id": 716665006,
					"content": "In battle, and in life, it's normal to hit setbacks every once in a while. But a setback only turns into a failure if you make the decision to stop trying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "No-Frills Instant Kill"
				},
				{
					"id": 716665007,
					"content": "Word! Heck yeah! I ain't about to admit defeat yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "Still, there's nothing to be gained from constantly making excuses. Don't put all your energy into talking garbage — spend it on fighting a little harder instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "No-Frills Instant Kill"
				},
				{
					"id": 716665009,
					"content": "Oof, burn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "Oni King, this brand of enemy doesn't seem to be your area of expertise. I advise you send in another of your generals and observe the duel in detail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716665011,
					"content": "Watching others do battle is also a crucial part of a warrior's training. Some skills, one learns by doing. Others, one learns through observation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716665012,
					"content": "Good point, Grandmaster! And good timing, compadre! Oni King's Right Hand, I'm handing the fight over to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Hehe, finally it's your turn! Make it count, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "Hehe! Piece of cake!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#So I'm going head-to-head with the legendary {NICKNAME}? Guess I'd better look sharp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "No-Frills Instant Kill"
				},
				{
					"id": 716665015,
					"content": "Uh-oh! I'm scared!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
