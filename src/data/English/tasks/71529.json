						],
						"pointId": 7030
					}
				]
			},
			"dialogs": [
				{
					"id": 716665101,
					"content": "Nicely done. You beat me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "No-Frills Instant Kill"
				},
				{
					"id": 716665102,
					"content": "#I'd go as far as to say that it's an honor to lose against {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "No-Frills Instant Kill"
				},
				{
					"id": 716665103,
					"content": "Ahhh, so that's how you do it! I never would've thought of that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "Yup! When you're up against a cunning enemy, you gotta get creative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "When your tactics fail, you have to change your point of view. In our journeys far and wide, we often have to think on our feet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "Clinging to old methods can never solve the problem, no matter how hard you try!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "I think Shinobu said something like that once, too. I guess there's something to it after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "But I'll mull it over some other time. Right now, my focus is on the task at hand — more beetle-fighting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
