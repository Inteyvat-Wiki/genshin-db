			"dialogs": [
				{
					"id": 751030101,
					"content": "Wow, there's so much fish! What are you all doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "#Hmm? Oh, hey there, {M#Big Bro}{F#Big Sis} Blondie! And your, uh... White... little sister, I guess?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Iwai and I are waiting for the Flowcurrent Birds to return to shore. Not much else to do right now, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "Return to shore? Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "Hrroo, roooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030106,
					"content": "Alright, come on, Iwai. You're a good kid, aren't you? Now be patient. There's no need to rush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030108,
					"content": "Anyway, our original plan was to come down here to play. But no one else usually comes down here other than Uncle Rongo, so this is our super secret base... or something like that, anyway!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "But we didn't think that these birds would steal a march on us today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "And that's why I've got all this fish ready to lure them over with. Flowcurrent Birds love the stuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Really? They don't seem all that attracted by it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "Yeah. Could be that we're too far away, and they can't smell the fish? If only we could get 'em ashore somehow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "If Uncle Rongo was here, he'd say something like <color=#00E1FFFF>\"Just boop them all ashore, why don't you?\"</color>... Iwai and I don't have the raw strength for that though. They'd blow us away instead, I'd bet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Hmm... Why don't we give that a try instead, {NICKNAME}? If we could get them to come ashore, they might be attracted to the fish then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "I see, so \"Paimon\" is in fact a subspecies of Flowcurrent Bird...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Round like a roly-poly, and fond of fish... Yeah, I can see where you're coming from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "Mmm! Mmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030115,
					"content": "What? No! Anyway, back to the point — you haven't lured any Flowcurrent Birds over at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
