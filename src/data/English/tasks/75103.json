				},
				{
					"id": 751030403,
					"content": "Just glad I could help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030406
					]
				},
				{
					"id": 751030406,
					"content": "See you around, then! If you've got time, feel free to swing by and play, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030404,
					"content": "Paimon seems to have been attracted by the fish as well...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030405
					]
				},
				{
					"id": 751030405,
