				"points": []
			},
			"dialogs": [
				{
					"id": 3930101,
					"content": "I'm thinking about turning these adventures into songs after we're done...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930102,
					"content": "Well, we certainly have gone through quite a lot recently.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "Hopefully, this song will be sung for years to come by the people of Mondstadt, just like The Legend of Vennessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930105,
					"content": "I have loved that song since I was small.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930106,
					"content": "#How are you feeling today {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930107,
					"content": "I am completely prepared and fully confident that we can do this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930108,
					"content": "You're so reliable, Master Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "Even Master Diluc accompanied us to the very end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930111,
					"content": "Despite only being an accidentally involved...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930112,
					"content": "...Bystander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930113,
					"content": "You shared your secret with me, and I only returned your trust to the same extent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3930114,
					"content": "So \"trust\" is what drove Master Diluc here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "As for Master Jean... \"responsibility\" perhaps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930116,
					"content": "What about the Tone-Deaf Bard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930121,
					"content": "It's \"freedom.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930122,
					"content": "Freedom...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930123,
					"content": "When you first arrived at Mondstadt, did no one tell you that Mondstadt is the City of Freedom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930124,
					"content": "Amber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "Hahaha... She really is a child of freedom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930126,
					"content": "Mondstadt is a romantic city, without the reign of a king.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930127,
					"content": "And its citizens enjoy the most freedom amongst the seven nations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930128,
					"content": "I hope the dragon that once protected Mondstadt will soon be free too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930129,
					"content": "No one should have deceived him by telling him that Mondstadt betrayed him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930130,
					"content": "And no one should have told him that it was his eternal duty to protect the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930131,
					"content": "He has the right and freedom to choose his own way of life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930132,
					"content": "Venti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930133,
					"content": "#Well then, {NICKNAME}, may the thousands of years of wind that have blown through Mondstadt go with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930134,
					"content": "Just like the last time, I shall channel Anemo energy for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930135,
					"content": "...\"Last time\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "#Oh! No wonder {NICKNAME} said his voice sounds familiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930136,
					"content": "I knew it! It was YOUR voice I heard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "So \"responsibility\" is what drove Master Jean here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "As for Master Diluc... \"trust\" perhaps?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930119,
					"content": "What about the Tone-Deaf Bard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930120,
					"content": "What about Venti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "Rest assured, I'm also completely prepared!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "We're practically old partners now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
}