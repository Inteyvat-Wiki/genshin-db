			"dialogs": [
				{
					"id": 726771001,
					"content": "This is a super special view, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771002,
					"content": "So much water, super special colors, mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771003,
						726771008,
						726771011
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771003,
					"content": "You two sound like you could be siblings.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771004
					]
				},
				{
					"id": 726771004,
					"content": "#But it is very special, isn't it? How would you describe it, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771005,
						726771006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771005,
					"content": "Like Cryo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771007,
					"content": "What's that even supposed to mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771013,
					"content": "This place has a great view, though. Really makes Paimon wanna draw!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771014,
					"content": "You can draw, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "Paimon can learn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771016,
					"content": "Drawing... But drawing is very hard. Watched Utamarou draw. Took very long for one drawing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771017,
					"content": "Why do people drawing when they have photo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771018,
					"content": "#Huh. Actually, why is that, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771019,
					"content": "I suppose people have a desire to make something that is uniquely theirs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771020
					]
				},
				{
					"id": 726771020,
					"content": "Huh, that sounds reasonable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771024,
					"content": "Something that you draw yourself has much more sentimental value.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
					"content": "That's true, drawing something out brushstroke by brushstroke is pretty hard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771026,
					"content": "Mm... Then is taking photos of me easy, not-hard, and not-sentimental?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771027
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771027,
					"content": "Eh!? N—No, that's not it, we just...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771028
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771028,
					"content": "Drawing takes a long time, you know. It's pretty tiring.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "That's right! If we spend too long drawing, your legs might fall asleep on you from all that standing still.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771030,
					"content": "When I was sealed in stone, always standing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771031,
					"content": "So when freed from seal, a long time later, legs very sore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771032
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771032,
					"content": "Ergh, that sounds very painful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771033,
					"content": "But Paimon can flip-flap. Legs won't be sore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771034
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771034,
					"content": "Hey now! Floating's a full-body exercise. It's super tiring!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771035,
					"content": "Ooh, fire flower!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771036
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771036,
					"content": "Hey, are you listening, or what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
