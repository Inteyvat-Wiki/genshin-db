			},
			"dialogs": [
				{
					"id": 726770701,
					"content": "#{NICKNAME}, so strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770702,
						726770703
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770702,
					"content": "I'm so-so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				},
				{
					"id": 726770704,
					"content": "#{NICKNAME} and Paimon fight often?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770705
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770705,
					"content": "Come to think of it, the goal of our journey is to help you find your lost relative, but we always wind up in fights along the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770706,
						726770708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770706,
					"content": "It's fine. I quite like fights.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770707
					]
				},
				{
					"id": 726770707,
					"content": "Well... That's nice and all, but there's better hobbies out there for sure, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770710,
					"content": "#When I become great bake-danuki, will become as strong as {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770711
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770711,
					"content": "You can do it for sure! But you've got to promise Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770712,
					"content": "Yes, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770713
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770713,
					"content": "Well... Ahem! Even if you become a powerful bake-danuki like Ioroi, promise that you won't bully those weaker than you, or pick fights whenever you want!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770714,
					"content": "#Don't be like that big, fiery, flower that started spewing flames the moment it saw {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770715,
					"content": "Then when is fighting okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770716,
						726770717,
						726770718
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770716,
					"content": "When it's self-defense...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770719,
					"content": "Mm... Not really understanding, but I promise Paimon. No bullying weak people, no picking fights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770720
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770720,
					"content": "That's a good boy, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770721,
					"content": "Next up... Huh, this should be the final stop out of the eight that Ioroi set down...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770722,
					"content": "Mm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770717,
					"content": "When you need to protect others...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770718,
					"content": "When you need to stand up for what's right...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770708,
					"content": "Battles are bothersome, honestly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770709
					]
				},
				{
					"id": 726770709,
					"content": "That's true, but sometimes we've just got no choice, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770703,
					"content": "We've fought this sort of thing enough times by now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				}
			]
		},
