			"dialogs": [
				{
					"id": 726770401,
					"content": "Ooh.. So hot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770402
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770402,
					"content": "Hehe, guess you know now, eh, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770403,
					"content": "Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770404,
					"content": "Know what, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770405
					]
				},
				{
					"id": 726770405,
					"content": "Can you imagine if we had to draw you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770406,
					"content": "And that's why we chose to take photos instead! It's not that we don't care. It's precisely because we care about you that we decided to save time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770407,
						726770408,
						726770409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770407,
					"content": "Oh, so that's what you were intending to do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770410,
					"content": "Understood. Photo, good. So... hot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770411
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770411,
					"content": "Let's take the heat source out. The quicker, the better.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770412
					]
				},
				{
					"id": 726770412,
					"content": "Mmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770408,
					"content": "Ridiculous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770409,
					"content": "You're not wrong, but it's still way too hot in here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				}
			]
		},
