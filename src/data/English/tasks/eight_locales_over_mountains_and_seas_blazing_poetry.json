					"nextDialogs": [
						726770802
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770802,
					"content": "If we had a Flaming Flower at Dragonspine, would be good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770803
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770803,
					"content": "He's got a point. We should probably have gone better prepared...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770804,
					"content": "Paimon, if we had a very big flower, could we make the snowy mountain have no snow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770805
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770805,
					"content": "P—Probably not...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770806,
					"content": "Mm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770807
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770807,
					"content": "We could take Kichiboushi to see a \"very big Flaming Flower.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770808
					]
				},
				{
					"id": 726770808,
					"content": "Eh? Wait, you mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770809,
						726770810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770809,
					"content": "I mean the Pyro Regisvine, of course.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770811
					]
				},
				{
					"id": 726770811,
					"content": "Alright then, guess that's Kichiboushi's training for today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770810,
					"content": "Let's get going.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770811
					]
				}
			]
