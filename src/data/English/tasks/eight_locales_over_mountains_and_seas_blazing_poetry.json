			"dialogs": [
				{
					"id": 726770301,
					"content": "So big! So hot! Amazing to have big fire flower!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770302,
					"content": "Right? Ooh, also...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770303,
					"content": "Hang on a moment, Kichiboushi. Let's take a photo of you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770304,
					"content": "In this steaming hot place?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770305
					]
				},
				{
					"id": 726770305,
					"content": "That's the whole point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770306,
					"content": "Mm... Okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
