						],
						"stepId": 4133705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Little Que'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413371101,
					"content": "Are you quite alright? How did you suddenly develop a headache... Do you need any medicine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371102,
					"content": "No, uh, no need... Just stay with me for a bit, I'm sure it'll pass...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Que'er"
				}
			]
		}
	]
}