			]
		},
		{
			"id": 4133704,
			"completionStepIds": [
				4133704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133704",
							"2"
						],
						"stepId": 4133704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "Thank you! We should be able to make a Xiao Lantern now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370402,
					"content": "It's done, Que'er. Inscribe our wishes on this lantern later, if you will, for your handwriting has always been very good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370403,
					"content": "Sure, sure. I'll do the writing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370404,
					"content": "Que'er... Are you... displeased, by any chance? What's the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370405,
					"content": "Oh no, I'm not displeased at all. In fact, I couldn't be more happy to help release this lantern...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370406,
					"content": "*cough* Ahem! So, uh, where were you planning to release that lantern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "Wh—Why, uh, yes! Indeed, friend, you speak the truth — we should do exactly that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370409,
					"content": "Okay, you can go if you want. I won't join you, though. It's a hard climb and I don't have the energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370410,
					"content": "But... But we've been resting here for a sufficiently long time, I do believe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370411,
					"content": "Uh, I've got a headache coming on. I don't know, maybe I caught a cold from this mountain air. It was a bit windy just now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413370412,
					"content": "I... Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370413,
					"content": "...Please, allow me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "I... ...*sigh* If you would be so kind, my friend. In fact, I had originally planned to release it from a very specific location...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370416,
					"content": "Back when the Guhua Clan still... well, existed, an elder disciple would take me there to release a lantern every Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370417,
					"content": "Sadly, the Clan has since met its demise. No practitioner of Guhua has set foot in that place to release a lantern in a long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370418,
					"content": "Since you offer your aid, my friend, I shall not refuse it. Please, go there and release this Xiao Lantern on my behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370419,
					"content": "I shall mark the location for you. Meanwhile, I need to take care of my fellow disciple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370414,
					"content": "I'll release the lantern for you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "Ahem. You should go release your lantern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
			"id": 4133706,
			"completionStepIds": [
				4133706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133706",
							"2"
						],
						"stepId": 4133706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370601,
					"content": "You're here... to release lanterns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370602
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370602,
					"content": "None but the members of the Guhua Clan know of this spot, and yet your faces are unfamiliar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370603
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370603,
					"content": "I'm here at someone's behest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370604
					]
				},
				{
					"id": 413370604,
					"content": "There are those of the Guhua Clan who still remember this place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370605,
					"content": "I saw no one when I first arrived, and that saddened me, I must admit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370606,
					"content": "But it gladdens my heart to know that there are still those of the Guhua Clan that remember this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370607,
					"content": "The Guhua Clan used to release lanterns here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "Yes... We would craft our lanterns, then an older disciple would bring us here. They'd lead the way, and we'd follow behind with our lanterns in hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370609,
					"content": "Back then... Xiao Lanterns from all over the mountain would merge into one in the sky. It was a wonderful sight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370610
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370610,
					"content": "But now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370611
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370611,
					"content": "...Let's release the lantern first. If you have the time, we can discuss the past further as we walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133707,
			"completionStepIds": [
				4133713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133713",
							"2"
						],
						"stepId": 4133713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370701,
					"content": "I remember that there was once when, on the occasion of our releasing lanterns, a high-spirited senior demanded a match with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370702
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370702,
					"content": "I had yet to make reply when a trusty female junior of ours stealthily poured water on the ground where he stood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370703
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370703,
					"content": "With the ground so wet and slippery, our elder disciple had not even drawn his sword before taking one step, slipping and falling, and landing right on his buttocks. I laughed so hard that I promptly followed suit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370704
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370704,
					"content": "He was not angry, he just pointed at me and laughed. Everyone else gathered around and laughed along...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370705
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370705,
					"content": "I don't know where he is today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133708,
			"completionStepIds": [
				4133714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133714",
							"2"
						],
						"stepId": 4133714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370801,
					"content": "I also once saw a glimmer of hope. It was a young boy who had just joined the Guhua Clan. He was handsome, well-mannered, and exceptionally talented. It seemed like he would be the one to revive the tradition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370802
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370802,
					"content": "But he was a difficult one to track down, and no one would see a glimpse of him for long periods... *sigh* I guess I never should have put my hopes in him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370803
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370803,
					"content": "Better to let him go, and not hold out for his return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133709,
			"completionStepIds": [
				4133715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133715",
							"2"
						],
						"stepId": 4133715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370901,
					"content": "When I left the Guhua Clan, there were barely any disciples left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370902,
					"content": "Master did not blame me. He just told me to live a good life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370903
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370903,
					"content": "But now, I don't know whether I have lived a good life...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370904
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370904,
					"content": "...Or just... made it through life, with little to show for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370905
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370905,
					"content": "I've heard people say that a Guhua disciple called Sun Yu is currently visiting the mountain, and that he seeks to revive Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370906
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370906,
					"content": "If only I had his courage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370907
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370907,
					"content": "Sorry, I'm prattling away, aren't I... It's good to come outside once in a while, get some fresh air, and get some things off my chest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370908
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370908,
					"content": "You seem a little down.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370909
					]
				},
				{
					"id": 413370909,
					"content": "Oh... I'm fine. It's just... this time of year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370910
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370910,
					"content": "Anyway, it's getting a little late. Happy Lantern Rite, and... please, could you pass on a message to the one who sent you with the lantern? The message is this:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370911
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370911,
					"content": "...The message is... Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370912
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370912,
					"content": "...Um, um... \"Happy Lantern Rite, from Zhiruo,\" I suppose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370913
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370913,
					"content": "Happy Lantern Rite to you, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370914
					]
				},
				{
					"id": 413370914,
					"content": "Thanks. Take care of yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133710,
			"completionStepIds": [
				4133710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133710",
							"2"
						],
						"stepId": 4133710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413371001,
					"content": "Ah, you're back. Did you release the Xiao Lantern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371002
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371002,
					"content": "About what happened when we released the lantern...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371003
					]
				},
				{
					"id": 413371003,
					"content": "I see. Yes, Zhiruo... I remember her. She took good care of me back then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371004
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371004,
					"content": "And she still remembers the Guhua Clan. I am pleased...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371005
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371005,
					"content": "How is Little Que'er?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371006
					]
				},
				{
					"id": 413371006,
					"content": "Ah yes, Little Que'er's headache is getting better. Perhaps she had just caught a cold, I'm now preparing to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371007
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371007,
					"content": "Brother, about that person Zhiruo you were speaking of just now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371008
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371008,
					"content": "Was she your senior in the Guhua Clan? Was she good-looking? Were you two close?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371009
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371009,
					"content": "Oh well, I can't say I knew her too well... But Zhiruo was quite adept at healing wounds. Whenever anyone was injured, we'd always go straight to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371010
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371010,
					"content": "Hahaha, now that I think about it, there were probably many that fancied her in the Guhua Clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371011
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371011,
					"content": "And how about you, Brother?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371012
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371012,
					"content": "Oh, uh... I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371013
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371013,
					"content": "Brother, you and Zhiruo... what's your relationship, exactly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371014,
					"content": "Uh... We aren't very close, really. You could say we share the fated fellowship of our clan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371015
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371015,
					"content": "Oh... Then what about the relationship between you and me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371016,
					"content": "Hahaha, why, we also share the fated fellowship of our clan, of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371017
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371017,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371018
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 413371018,
					"content": "Que'er? Is... is there something wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 4133711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
