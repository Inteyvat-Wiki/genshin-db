			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "Ah, hello. Just the person I wanted to speak to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020102,
					"content": "About what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "Nope, no need. I've figured out what it was.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020105,
					"content": "I finally managed to track down the merchant the other day. The one who sold it to me in the first place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020106,
					"content": "I told him there was a problem with the Kamera he sold me, but he was having none of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020107,
					"content": "Luckily I had all the photos you took for me. Without them, I'd have had no way of convincing him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020108,
					"content": "After taking a look at your photos, he finally agreed to take a look at the Kamera he sold to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020109,
					"content": "Yesterday, he came to see me and brought a bottle of some sort of potion with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020110,
					"content": "He explained that this Kamera works differently from regular models. You need to add some of this potion to it to make sure the photos turn out normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020111,
					"content": "If you don't add any, the photos turn out just like yours did. Just pages of color, rather than clear images.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020112,
					"content": "Good thing that your Kamera's not broken, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Well... To be honest, I'm less interested in the Kamera itself now. This potion is what intrigues me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020115,
					"content": "Think about it. Most people will just buy the Kamera, right? Buy it once, use it forever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020116,
					"content": "But this potion is a consumable. So, once you've used it up, you have to buy more if you want to keep using it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020117,
					"content": "Also, the guy says that different potions will produce photos with different effects. He's currently developing more types...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020118,
					"content": "Maybe... Just maybe, those bottles of potion are where the big business opportunity is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020119,
					"content": "Ah, sorry. I'm rambling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020120,
					"content": "Thanks for all your help. Hand me this Kamera, I'll add some potion in for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020113,
					"content": "So... problem sorted?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "About strong-color photography?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
			"completionStepIds": [
				4140202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
