						"rawParams": [
							"4140203",
							"2"
						],
						"stepId": 4140203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "Alright, this Kamera is yours to keep. Take care of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020302,
					"content": "...You're just gonna give it to me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "There's enough potion in there for you to get a good amount of use out of it. Once it runs out... Well, you know where to find me, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020305,
					"content": "While we're on the subject, I'm planning to talk to my contact about importing some new kinds of potions for the Kamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020306,
					"content": "If you find that's something that interests you, I hope to see you here again in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020307,
					"content": "Thought I was just buying a Kamera, turns out I was buying a whole business venture...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020303,
					"content": "What happens when the potion runs out?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}