			},
			"dialogs": [
				{
					"id": 220300301,
					"content": "I will take care of the camp on the right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300302
					]
				},
				{
					"id": 220300302,
					"content": "Then I shall leave it to you. I will go to the other camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300303
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300303,
					"content": "Can you handle them yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300304
					]
				},
				{
					"id": 220300304,
					"content": "They are just monsters. There is no need to worry about me. If it weren't for the ingredients, I would have been able to take them all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300305
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300305,
					"content": "Alright, once you have eliminated the monsters and retrieved the ingredients, you can come find me at the other camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300306
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300306,
					"content": "Let's get going now. If the ingredients are ruined, I'm afraid that the dish won't be as tasty as I promised.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
