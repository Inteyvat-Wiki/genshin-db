					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "We meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300102,
					"content": "Sorry for my impudence, but I need your help with a certain matter today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300103,
					"content": "What is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "After I was hired by Xudong, I have been traveling with him and the others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300107,
					"content": "I want to make some gifts as my token of appreciation for his taking me in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300108,
					"content": "But since Xudong appears to prefer cooking to martial arts, I would like to make some food personally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300109,
					"content": "I had already found two locations for the necessary ingredients, and I was planning to retrieve the ingredients once they have ripened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300110,
					"content": "However, there are two groups of monsters occupying those two locations, and they all have already taken the ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300111,
					"content": "The freshness of the ingredients is essential for me to cook the dish. I was planning to get them from one place first and then go to the other...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300112,
					"content": "But now that both groups of monsters have already taken the ingredients, I must retrieve those two ingredients as soon as possible if I am to cook that dish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300113,
					"content": "However... I can't be in two places at once. Even if I can handle the monsters at one place, the ingredients would have already been ruined by the monsters at the second.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300114,
					"content": "That's why I need your help. We will defeat those monsters at the same time and retrieve the ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300115,
					"content": "Well, leave it to me then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "Thank you. I honestly can't thank you enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300119,
					"content": "Hmm... talking more about it here won't do us any good. Please come with me, and we shall discuss further.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300117,
					"content": "After you are done cooking the dish, could I have some?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "Of course. Indeed, you shall be the first to have it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300104,
					"content": "No need to be so courteous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "Since I need something from you, this sort of etiquette is necessary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
