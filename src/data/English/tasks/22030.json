			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300601,
					"content": "Thank you! These ingredients are still usable, but we cannot delay any further... I'm going to get started with the cooking now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300602,
					"content": "It's done. Phew... it's all thanks to you that this dish was completed smoothly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300603,
					"content": "You truly are a perfectionist...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "Of course. Be it floral design, tea, cooking, or swordsmanship, if you don't pursue perfection, their meaning will be lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "The path of \"extremes\" is my way of living. However... Xudong appears to hold a different opinion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "He once told me that there is a word in Liyue called moderation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300607,
					"content": "It means one should always avoid being extreme, whether it be living one's life or doing certain things. Moderation without leaning towards either side is the best way to live.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300608
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300608,
					"content": "I don't quite understand what Xudong meant, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300609
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300609,
					"content": "But I believe that he must have gone through many things to have come up with this sort of philosophy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300612,
