	"talks": [
		{
			"id": 7352801,
			"completionStepIds": [
				7352801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352801",
							"2"
						],
						"stepId": 7352801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Basima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735280101,
					"content": "Passing Travelers, I, Basima, Amurta researcher, beseech thee not to leave too hastily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280102,
					"content": "Please. Relax thy body, clear thy mind, and listen closely, for I have a matter of utmost importance to share with you—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280103,
					"content": "Finches are the cutest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280104,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280105,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "Finches are definitely cute... But Miss Basima, you're a researcher, right? You should know saying something like that without any qualifications can lead to serious arguments!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280107,
					"content": "Paimon thought that scholars spoke a bit more cautiously. Paimon would never say something like \"Golden Shrimp Balls are the most delicious food!\" if Paimon was a researcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280108,
					"content": "Paimon would qualify her statement! Like, \"Among the Liyue cuisine Paimon's eaten lately, this is Paimon's favorite.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280109,
					"content": "But I'm willing to say this no matter what!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "#Wha— {NICKNAME}, that was really unexpected!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280113,
					"content": "Even if it's not a joke, you shouldn't be so loud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280114,
					"content": "Hahaha, now that's the spirit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280115,
					"content": "It is precisely because I am a researcher that I don't want my whole life to be like an academic debate, constantly worrying about the accuracy of every word that comes out of my mouth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280116,
					"content": "It's not like I'm under constant surveillance! Speaking carelessly won't get me punished, so why live in constant fear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280117,
					"content": "We should be brave, and shout out the most important feelings in our hearts as loud as we can for the world to hear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280118,
					"content": "Once you've tried my tabletop game \"Bing-Bang Finchball\", I'm sure you wouldn't hesitate to shout out \"Finches are the cutest!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280119,
					"content": "Bing-bang... Finchball? You mean those things on the table behind you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280120,
					"content": "That's right, once you've played, you'll see for yourself just how adorable finches are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280121,
					"content": "Also, as an official amusement venue of the Veluriyam Mirage, you'll be able to get rewards based on your score!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280122,
					"content": "She's made it sound so dramatic... but it worked! Paimon's getting really curious. Plus, there are rewards for playing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280123,
					"content": "#What do you think, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280124,
					"content": "Let's give it a go!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "Hahaha, now you're getting it! Enjoy the game!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280125,
					"content": "Let's see just how cute finches really are!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "Paimon is the cutest!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "Period!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}