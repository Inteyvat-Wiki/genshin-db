			"dialogs": [
				{
					"id": 790350101,
					"content": "#{NICKNAME}, Paimon, have you met two bake-danuki recently, by any chance? One of them carries a purple cloth bag, while the other has a yellow one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350102,
					"content": "Ooh! You must be talking about Mamesuke and Shibasuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350103,
					"content": "Ah, great, so you do know them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350104,
					"content": "Um, did something happen to them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350105,
					"content": "Not really, they just made a bunch of gestures before giving me this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350106,
					"content": "I've heard that you once visited the Good Hunter with a bake-danuki from Inazuma, so I thought you might be friends. I think they wanted me to give this to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 790350107,
					"content": "Ooh! So this is a gift from Mamesuke and Shibasuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790350108,
					"content": "Hehe, looks like their journey's off to a good start! Paimon wonders if we'll ever meet again...",
