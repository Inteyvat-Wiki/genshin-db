			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Alphonso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800101,
					"content": "(Let's uncover the \"bad guy\" in Vimara Village.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800102
					]
				},
				{
					"id": 730800102,
					"content": "Hello, Alphonso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800103,
					"content": "#It's you guys. {NICKNAME}, what can I do for you? If you're looking for Rana, she's gone already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800104
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800104,
					"content": "I want to talk to you about something...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800105
					]
				},
				{
					"id": 730800105,
					"content": "The \"bad guy\" hiding in Vimara Village.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800106
					]
				},
				{
					"id": 730800106,
					"content": "#After all, Rana only felt relaxed enough to go on a journey after {NICKNAME} promised her to deal with the bad guy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800107,
					"content": "I see. I understand now. Even though I don't have a clue, feel free to ask.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800108
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800108,
					"content": "First, let's recap what happened.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800109
					]
				},
				{
					"id": 730800109,
					"content": "So, who was the first missing child in Vimara Village?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800110,
						730800111,
						730800113,
						730800116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800110,
					"content": "Sudabeh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800119
					]
				},
				{
					"id": 730800119,
					"content": "Paimon remembers now, it's Sudabeh! She heard that there were herbs that could improve Amadhiah's sight and then sneaked into the woods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800120,
					"content": "That's right. We were worried when it happened and organized a search party.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800121
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800121,
					"content": "Paimon remembers now! Rana did say you organized the search party, and brought curry along too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800122,
					"content": "Who told Sudabeh about the herbs?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800123
					]
				},
				{
					"id": 730800123,
					"content": "...I did. Sudabeh is a good kid who cares about Amadhiah. I recall mentioning it to her one day, but I also said...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800124
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800124,
					"content": "Yeah, Paimon knows! She said you told her not to wander the forest alone. But she really cares about Amadhiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800125,
					"content": "Any other questions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800126
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800126,
					"content": "So, who was the second that went missing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800127,
						730800128,
						730800130,
						730800132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800127,
					"content": "Kavus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800135
					]
				},
				{
					"id": 730800135,
					"content": "Kavus... He said he was going to see a \"friend\" in the forest for his missing sister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800136
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800136,
					"content": "Yeah, he did mention that! Do you know who Kavus' friend is, Alphonso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800138
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800138,
					"content": "How would I know? I didn't find Kavus or his friend in the woods. As you know, he came back suddenly not remembering anything, just like Sudabeh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800139
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800139,
					"content": "Any other questions? No more children went missing after that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800140
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800140,
					"content": "You got this, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800141
					]
				},
				{
					"id": 730800141,
					"content": "Eh? Okay. Ahem... Well, Iotham was supposed to go missing next, but we and Rana ran into him and brought him back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800142,
					"content": "How did it happen exactly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800143
					]
				},
				{
					"id": 730800143,
					"content": "According to him, he heard Alphonso say there were huge mushrooms in a cave, so he wanted to get some for Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800144,
					"content": "Then the Fatui followed him. He got scared, ran, and ended up trapped in a Withering Zone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800145,
					"content": "What, he went into a Withering Zone? How come he never told me that? That's unacceptable...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800146
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800146,
					"content": "Wait, if he was in the Withering Zone, how did he make it back? I understand that you can master the elements without a Vision, but still...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800147
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800147,
					"content": "(Uh, should we tell Alphonso about Arana?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800148,
						730800149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800148,
					"content": "(That should be fine.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800150,
					"content": "You'll probably find this hard to believe, Alphonso, but there are fairies called Aranara in the forest. Iotham and the gang are friends with them, so the Aranara helped him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800151,
					"content": "Aranara...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800152
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800152,
					"content": "But going after the kids... the Fatui are so despicable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800154
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800154,
					"content": "Hmm, we still don't know who the bad guy hiding in Vimara Village is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800155,
					"content": "I think someone's watching us over there, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800156
					]
				},
				{
					"id": 730800156,
					"content": "Where? Don't tell Paimon it's the bad guy we're looking for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800157,
					"content": "Go check it out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800158
					]
				},
				{
					"id": 730800158,
					"content": "Just Paimon alone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800159,
						730800160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800159,
					"content": "Yell if you're in trouble and I'll be right there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800161,
					"content": "#Fine. Can't have {NICKNAME} do everything, anyway. Paimon's got this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800162,
					"content": "Paimon leaves excitedly.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730800163
					]
				},
				{
					"id": 730800163,
					"content": "Why bother?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800164,
						730800165
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800164,
					"content": "She'll be happier if she doesn't know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800166,
					"content": "Let's talk elsewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800165,
					"content": "Some things are better left untold.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800160,
					"content": "You're small and can fly. Perfect for scouting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800149,
					"content": "(He ought to know.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800128,
					"content": "Sudabeh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800129
					]
				},
				{
					"id": 730800129,
					"content": "No, no, didn't we just get done with Sudabeh? Paimon remembers it was her brother... Kavus, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800130,
					"content": "Iotham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800131
					]
				},
				{
					"id": 730800131,
					"content": "Paimon doesn't think that's right... We saved Iotham when he got lost. The second should be Sudabeh's big brother Kavus, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800132,
					"content": "Changchang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800133
					]
				},
				{
					"id": 730800133,
					"content": "Changchang is in Liyue! What's this got to do with Changchang!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800134,
					"content": "#...Are you okay, {NICKNAME}? Paimon remembers, the second kid was Sudabeh's big brother named Kavus, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800111,
					"content": "Kavus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800112
					]
				},
				{
					"id": 730800112,
					"content": "That should be Sudabeh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800113,
					"content": "Iotham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800114
					]
				},
				{
					"id": 730800114,
					"content": "No, Iotham was the last one that went missing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800115,
					"content": "It's Sudabeh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800116,
					"content": "Timmie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800117
					]
				},
				{
					"id": 730800117,
					"content": "Timmie? No, this has nothing to do with Timmie! Isn't he in Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800118,
					"content": "Who's Timmie? Sudabeh should be the first one that went missing, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonso"
				}
			]
		},
		{
			"id": 7308002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308002",
							"2"
						],
						"stepId": 7308002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alphonso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800201,
					"content": "When did you start suspecting me? Is it because Sudabeh and Iotham both mentioned me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800202
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800202,
					"content": "You know my name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800203
					]
				},
				{
					"id": 730800203,
					"content": "But Rana never told you my name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800204
					]
				},
				{
					"id": 730800204,
					"content": "Or maybe I have great hearing and overheard your name when Rana introduced you to Amadhiah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800205
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800205,
					"content": "She never told Amadhiah that, either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800206
					]
				},
				{
					"id": 730800206,
					"content": "How careless of me. But besides the Fatui, the Adventurers' Guild also has an extensive network, so why don't you think I'm an adventurer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800207,
						730800210
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800207,
					"content": "You seem to know me very well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800208
					]
				},
				{
					"id": 730800208,
					"content": "You know I could control the elements without a Vision.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800209
					]
				},
				{
					"id": 730800209,
					"content": "You're quite famous for your exploits. I don't have to be a Fatuus to know that. The bottom line is, you don't have anything concrete to prove that I'm with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800212,
					"content": "True, but that's not important.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800213
					]
				},
				{
					"id": 730800213,
					"content": "You're right. Only the court demands proof, whereas a keen hound needs merely a scent to track the prey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800214
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800214,
					"content": "Of course, a clever hound would avoid the scent it shouldn't sniff, as to not run into a dragon at the trail's end. But, from your track record, you're not one to quit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800215
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800215,
					"content": "You warned Rana not to patrol the forest...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800216
					]
				},
				{
					"id": 730800216,
					"content": "Because you didn't want her to interfere with the Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800217
					]
				},
				{
					"id": 730800217,
					"content": "There's truth to that, but more importantly, I didn't want her to get hurt. The other Fatui aren't like me. They felt nothing toward her or Vimara Village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800218
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800218,
					"content": "Who are you really, \"Alphonso\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800219
					]
				},
				{
					"id": 730800219,
					"content": "The name given to me at birth is buried in freezing snow. The name granted me by the House of the Hearth is Trofin Snezhevich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800220
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800220,
					"content": "Trofin Snezhevich of the House of the Hearth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800221
					]
				},
				{
					"id": 730800221,
					"content": "Your reaction tells me you probably encountered my \"brothers and sisters\" before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800222
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800222,
					"content": "Oh, don't tell me who you ran into or their status. Should they have revealed their identities to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800223
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800223,
					"content": "Assuming they are still alive, then they would have betrayed Her Majesty already. If they're dead... I'd rather not know about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800224
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800224,
					"content": "House of the Hearth is a shelter founded by \"The Knave.\" Children raised in the House aren't related, but our bonds are tighter than blood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800225
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800225,
					"content": "After coming of age, those with potential undergo training to become agents, then infiltrate different locations to await orders. Unfortunately, I was deemed as \"having potential.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800226
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800226,
					"content": "What is your order?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800227
					]
				},
				{
					"id": 730800227,
					"content": "Capture Aranara. It's an order from \"The Doctor,\" so that he can study the connections between Aranara, dreams, and The Withering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800228
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800228,
					"content": "Weaponizing dreams and The Withering seems to be one of his projects. Of course, I and every Fatuus you defeated are his \"source of study.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800229
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800229,
					"content": "We can't see Aranara, but Kavus, Sudabeh, and Iotham have what it takes to befriend them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800230
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800230,
					"content": "So you let the Fatui abduct them to lure the Aranara out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800231
					]
				},
				{
					"id": 730800231,
					"content": "Correct, and the Aranara did show up. But their power truly was amazing, able to free those kids right under the nose of heavy security...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800232
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800232,
					"content": "The Doctor has eyes on something truly incredible this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800233
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800233,
					"content": "#I've got a question for you too, {NICKNAME}. Why would the Aranara erase the abduction and rescue from Kavus and Sudabeh's memory? To avoid being exposed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800234
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800234,
					"content": "Arana doesn't want the children to remember anything like that at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800235
					]
				},
				{
					"id": 730800235,
					"content": "Arana doesn't want them to be violent when they grow up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800236
					]
				},
				{
					"id": 730800236,
					"content": "I see. So that Aranara is named Arana? That sounds a lot like Rana, a very pretty name. Please thank her on my behalf when you get a chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800237
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800237,
					"content": "Why would you thank her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800238
					]
				},
				{
					"id": 730800238,
					"content": "Vimara Village feels like a real home to me. Rana and Iotham feel like blood relatives I should've had. Kavus and Sudabeh are my precious siblings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800239
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800239,
					"content": "I hope they will grow up happy, healthy, righteous, and kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800240
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800240,
					"content": "So, even though Arana has made my \"job\" that much more difficult, I appreciate what she did very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800241
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800241,
					"content": "Oh, I finally get it. Just like you distracted Paimon, the children ought not to know the dirty deeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800242
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800242,
					"content": "\"Youngster, you should enjoy childhood, do what you like, see what you want to see. But also remember the dark days...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800243
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800243,
					"content": "That's the House's teachings. Because facing the darker side of life is inevitable for grown-ups, you need to be prepared as a child, so you can protect yourself and those you love.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800244
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800244,
					"content": "Maybe what you're doing also makes sense. If I hadn't grown up in the House of the Hearth and became a spy in Vimara Village... If only I were born in Vimara Village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800245
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800245,
					"content": "All this talk is meaningless.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800246
					]
				},
				{
					"id": 730800246,
					"content": "I know. I just feel sorry. I wish I'd always been \"Alphonso,\" not \"Trofin Snezhevich.\" I wish I really was Iotham's big brother.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800247
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800247,
					"content": "I want to be a good person, but I belong to an organization. I want to be family to Rana and the kids, but I've already got a \"family\" I can't turn my back on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800248
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800248,
					"content": "Many of my fellows have powers rivaling the Lord Harbingers and are not subject to any city or state. That's something even a free, honorary knight like you probably couldn't comprehend...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800249,
						730800251
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800249,
					"content": "I do comprehend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800250
					]
				},
				{
					"id": 730800250,
					"content": "But what you did is inexcusable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800253,
					"content": "Well, that's all I've got to say. So, what are you going to do with me now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800254,
						730800262
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800254,
					"content": "Don't come near Vimara Village or let me see you again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800255
					]
				},
				{
					"id": 730800255,
					"content": "I see. Got it. You won't see me again. I'm not returning to the Fatui, either, since I blew my mission and brought shame to my \"siblings.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800256
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800256,
					"content": "Iotham will probably be waiting for \"Alphonso\" to come back forever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800257,
						730800259
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800257,
					"content": "Go now. Paimon should be here any minute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800258
					]
				},
				{
					"id": 730800258,
					"content": "Goodbye. No, farewell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800259,
					"content": "(Battle) I changed my mind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800260
					]
				},
				{
					"id": 730800260,
					"content": "#I've foreseen the ending for the wicked, but I won't go down without a fight. You might be {NICKNAME} and I might not have a chance, but I'll still fight, because...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800261
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800261,
					"content": "I'm the evil amidst good, the poison amidst the herbs, the wolf in sheep's clothing, the mercury in a golden chalice... My name is Snezhevich. Do your worst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800262,
					"content": "(Battle) Arana and I both agreed...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800263
					]
				},
				{
					"id": 730800263,
					"content": "That the wicked must be punished.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800264
					]
				},
				{
					"id": 730800264,
					"content": "#I've foreseen the ending for the wicked, but I won't go down without a fight. You might be {NICKNAME} and I might not have a chance, but I'll still fight, because...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800265
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800265,
					"content": "I'm the evil amidst good, the poison amidst the herbs, the wolf in sheep's clothing, the mercury in a golden chalice... My name is Snezhevich. Do your worst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800251,
					"content": "I don't comprehend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800252
					]
				},
				{
					"id": 730800252,
					"content": "Nor will I even attempt to.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800210,
					"content": "You seem to know a lot about the Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800211
					]
				},
				{
					"id": 730800211,
					"content": "They are notorious, enough for most people to know that. The bottom line is, you don't have anything concrete to prove that I'm with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "Alphonso"
				}
			]
		},
		{
