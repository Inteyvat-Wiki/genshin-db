				"points": []
			},
			"dialogs": [
				{
					"id": 220270401,
					"content": "Let's go with Tricolor Dango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Really? Okay! I happened to have brought one with me. My mom made it for me and I haven't even eaten it yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270403,
					"content": "Let's offer it up, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270601,
					"content": "O Archon, bless me and help my wishes come true...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270602,
					"content": "#Thank you for staying with me until now, {F#big sis}{M#big bro}. Please have these. They're for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270603,
					"content": "I'll come back here tomorrow to check again. I hope that I'll receive a reply...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
