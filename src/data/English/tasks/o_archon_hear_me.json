				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270301,
					"content": "I mean, Nanatsuki said that I should, didn't she? But what should I offer, exactly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "Speaking of things that I like, it's gotta be Tricolor Dango. I love them so much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "But would it be disrespectful to offer Tricolor Dango? I offered Konpeito Candy before as well, but I got no reply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "I've also heard that some people will pack fresh petals into sachets and offer those. That sounds more appropriate than Dango...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "#What should we do? What do you think we should offer, {F#big sis}{M#big bro}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202704,
			"completionStepIds": [
				2202704,
