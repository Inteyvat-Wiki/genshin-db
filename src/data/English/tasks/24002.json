						"pointId": 4427
					}
				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "Ah, these are the documents I need! Oh, thank the Archon, they're all here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020402,
					"content": "Why were you doing accounts at the cafe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "W—Well, I need lots of coffee to make sure I'm counting it all right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020404,
					"content": "This is the expenses of all the offices within the Palais, mind you — counting it up's supposed to be five people's work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020405,
					"content": "But apart from me, everyone in the office is often being borrowed by some other office, sent out on work, or is busy with some visitation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020406,
					"content": "So when it came time to count expenses, it was just me doing it — I haven't slept in days!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020407,
					"content": "Not only did the expenses need counting up, but even the settling of the bills got left to me. My vision's practically swimming over here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020408,
					"content": "Regardless, it's good that we found those accounts. If you'll allow me, Ms. Isadora, I'll accompany you back to the Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020409,
					"content": "Thank you, Officer Muirne. *sigh* I swear, you and the Traveler are the only two good souls I've met these last three months.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020410,
					"content": "Everyone else is either yelling at me or pushing me to work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020411,
					"content": "Ugh, no, no, I need to stop complaining. I need to go back, or Ms. Keiser's going to yell at me again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				}
			]
		}
	]
}