			"dialogs": [
				{
					"id": 751310301,
					"content": "B—Burning... biological... rain!? You mean the fire's gonna swoop down on our heads like it's alive? Why are Natlan's volcanoes so terrifying!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310302,
					"content": "Paimon's a little curious, she's gotta admit... Hehe, why don't we go explore the area up ahead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7513104,
