				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "Burning biological rain... Wait, could it really be as the legends say? Volcanoes evolving and spreading like living creatures, turning everything around them into more volcanoes? Oh no, no, no! That'd be a disaster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310102,
					"content": "Volcanoes don't work like that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "Right, right. No magma, no volcano. They can't just pop up out of nowhere. If they could, this place would've been a danger zone ages ago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310105,
					"content": "But... what if the legend is true? Ugh, if only that self-recording Kamera actually worked properly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310106,
					"content": "Wait! What if the Kamera glitches and doesn't catch anything? That'd be a total mess! Nope, I need to go check it out myself, just to be sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310103,
					"content": "Oops, sorry for interrupting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "Okay, bye... Or wait, is there something else going on here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "So, the biological fire rain is actually those Flowfire Birds falling from the sky? Ah, no wonder they cover way more ground than a normal eruption!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310202,
					"content": "Oh no, what if one of them crashes into my house someday? No, I gotta figure out a plan for this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310203,
					"content": "Well, it's probably just a rare thing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "Yeah, yeah, those Flowfire Birds only get up there because of volcanic eruptions. My house isn't anywhere near a volcano, so I'm probably fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310205,
					"content": "But... what if — just what if — there's some crazy, massive eruption one day? Wouldn't that mean nowhere is safe? Ugh, no, I still need to come up with a plan... just in case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310206,
					"content": "Oops, sorry for interrupting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "No worries, you're not interrupting... Anyway, let's start by reinforcing the roof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
