					},
					{
						"sceneId": 100,
						"position": [
							999.515,
							217.253,
							708.308
						],
						"pointId": 296
					},
					{
						"sceneId": 100,
						"position": [
							998.811,
							216.884,
							711.991
						],
						"pointId": 297
					}
				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "No matter how many times you ask, Rozel, I will not go out venturing with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "You're my friend, yes, and that will never change. I do not dislike you. But... I do not enjoy traveling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir. It is nowhere near as frightening as you imagine. It's just a trip, that's all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "The outside world plays host to many flowers that cannot be found in our village and many people we've never met — even the shapes of the clouds are different there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "Remember the seed I brought you from outside? I can guarantee that you've never seen any flower with its shape or color before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "It's still a seed now. I'll plant it, and then we'll see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "If you're willing to go with me, we might be able to see this flower with our own eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel... I'm sorry, I have no wish to travel abroad, nor do I want to become like those venturers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "They always fret about the value of carpets, and pay no mind to beautiful hats...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "This is how your travels change you, and it scares me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "That is true. But have you noticed the maps, the plant samples, and the travelogues that fill their luggage to bursting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "We surge through different bushes and shrubs like a gust of wind, like rivers passing through another lake... We encounter different things, and we, too, become different people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "This is how travel changes you, and it scares me too... But I'm thankful for those changes as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "I'd compare it to a slice of bread with cream slathered on both sides. You're going to make a mess no matter how carefully you try to hold it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "In that case, I'd spread the cream on separately. That way, I can even smear on different flavors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "Not a bad call. I'm sure it'll be a filling meal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "Ah, it's you, here at last! Rozel has been telling me how wonderful the outside world is, inviting me along to venture...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "Do you know much of that world? Is it... as he says it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Not a bad idea. That should keep your hands clean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906101",
							"2"
						],
						"stepId": 7906101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Yes, it is. In the <color=#FFCC33FF>outside world</color>, there's no lack of new things to discover.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Right! There's lots to eat, and many fun things to do, and you'll even get to encounter many interesting things and awesome people. For example...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "You'll find those who focus on the beautiful essence of all things.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Really? Dear me. I'd believed the outside world to only be conscious of \"value,\" and to be full of those who wish to wear hats but dare not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "Hmm, well, you can think of it... Like a cake with various chocolates scattered on top! Every bite's a whole new experience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "That's way better than having all the chocs taste the same — 'cause that would make for a super ordinary cake, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "Well said, Paimon, well said.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Well, who wouldn't after listening to it for this long?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "Is that so? Well, I... I'll need more time to think about this. But perhaps a little... Just a little venturing couldn't hurt, surely?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "No need to rush into things, Esnoir. There is still much time before my next voyage. Until then, let us consider this issue together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "You've mastered the local lingo, I see.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "You'll bear witness to radiant, unfading ideals.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "You'll get to meet those who work hard to realize their dreams.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
			"completionStepIds": [
				7906101
			],
