						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "The <color=#FFCC33FF>world inside</color> isn't too bad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "That's true. This is your home, after all, Esnoir. Paimon's sure you like it here. Also...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610303,
					"content": "Friends you are familiar with live here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "Indeed! I worry about losing these, and I fret about them constantly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610307,
					"content": "This is all good. Wonderful, even. I have no wish for them to change, nor do I wish to change.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610308,
					"content": "But... Venturing abroad will cause everything to change. Won't it? Rozel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610309,
					"content": "Yes. It definitely will. I will not deceive you, nor do I wish to sadden you, dear Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610310,
					"content": "Alright... Alright. I understand where you're coming from, as I'm sure you do me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610311,
					"content": "I need time to consider your invitation before making my decision. If nothing else, let us simply enjoy this spot of tea in peace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610312,
					"content": "Alright. I will accompany you, Esnoir. There is still much time before my next voyage. Until then, let us consider this issue together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610304,
					"content": "There are many pretty flowers...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "And delicious cakes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906102",
