			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20337,
						"position": [
							529.233,
							11.86,
							435.322
						],
						"pointId": 3
