			"dialogs": [
				{
					"id": 716620401,
					"content": "Wow! That was pretty impressive. You got the hang of this place really quickly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620402
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620402,
					"content": "In that case, we're counting on you. Use all your wits and imagination to transform this Domain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620403
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 716620403,
					"content": "I do hope that we'll be able to understand the rules behind the changes of this Domain soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				}
