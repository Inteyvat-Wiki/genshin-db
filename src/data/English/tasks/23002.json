					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "The mushrooms here don't look too bad. I'll put them on my shopping list...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020102,
					"content": "Hanbei? Now that's a familiar name. Paimon's sure we've heard that one somewhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020103,
					"content": "...Was it the guy at Tatarasuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "Yikes! He's the guy who made a complete mess of the Mikage Furnace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020106,
					"content": "I think he's here as a foreign attaché...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "So he really is here in Sumeru. Paimon thought that whole foreign attaché thing was just a joke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020109,
					"content": "#Eh? {M#Blond}{F#Blonde} hair... and a small flying thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020110,
					"content": "Are you the Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020111,
					"content": "That's right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "Haha, so it really is you. Yousuke's letter mentioned how you helped Mr. Xavier deal with the Mikage Furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020115,
					"content": "*sigh* I feel so ashamed. I was tied up with administrative work when the two of you were fixing the Mikage Furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020116,
					"content": "Is administrative work really more important than the Mikage Furnace...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "You've got your priorities all wrong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020118,
					"content": "The Mikage Furnace's maintenance wouldn't have progressed so smoothly without administrative work, you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020119,
					"content": "I was evacuating the people nearby, prepping the materials for repairs, redirecting the appropriate manpower, and even coordinating production...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020120,
					"content": "All these things would have been a complete mess without administrative support.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020121,
					"content": "It's just like Toranosuke said...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "You live up to your reputation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020123,
					"content": "Toranosuke... That man has such blatant disregard for administrative work. I always end up with extra work when working with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020124,
					"content": "But I'm not in charge of the Mikage Furnace anymore. I'm serving as foreign attaché in Sumeru now, and I manage the mushroom trade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020125,
					"content": "Ah, Traveler, I've heard about your deeds from Yousuke, and I do believe that you are a truly reliable person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020126,
					"content": "If you don't mind, could you help me with something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020127,
					"content": "I've been searching for a reliable mushroom supplier, and I've met with many merchants here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020128,
					"content": "But they always select only their best to put on display...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020129,
					"content": "I think a visit to their farms is necessary to assess the quality of their supply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020130,
					"content": "But as you can see, I have no experience in conducting surveys in the wild. And I don't think I'll make it out of the forest alive if I go alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020131,
					"content": "So, I would like you to help me go there and gather some mushrooms...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020132,
					"content": "Well, I can do that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "You'll do it? Wonderful! Don't worry about your payment, I've even prepared the contract documentation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020135,
					"content": "Take a look at this. Yes, this document. This is your hiring contract, compensation breakdown, and a disclosure and confidentiality agreement. Oh, I almost forgot, here's a map of the mushroom farm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020136,
					"content": "You are exhausted after carefully looking through all the documents with Hanbei...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "Good, now you're fully informed. I'll be sending a report to the Shogunate, and we can finalize everything once I have the Shogunate's approval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020138,
					"content": "But I'll pay you out of my own pocket until then. After all, I can't delay this any longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020139,
					"content": "Of course, I'll be filing the necessary documents for this as well. Your compensation does come with tax implications.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020140,
					"content": "I... I'm going to gather mushrooms now!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "Eh? Oh... I'll leave it to you then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020142,
					"content": "We won't get caught up in some trouble again, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020143,
					"content": "We won't if I keep an eye on him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "Really? Okay, you do have a point...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020147,
					"content": "Eh? Why do you look so doubtful... Don't you worry, I've made very thorough preparations, so there won't be any issues during this process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020148,
					"content": "We're not talking about that kind of trouble... *sigh* Let's just get his mushrooms for him, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020145,
					"content": "I wonder what kind of trouble he'll cause this time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "Hey! If that really happens, we won't have anyone to help us out here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020133,
					"content": "Let's talk about payment first...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "This is Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "Paimon's Paimon! Not some \"small flying thing\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020107,
					"content": "I think he's here for the mushrooms...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "Toranosuke and Yousuke both mentioned him...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
