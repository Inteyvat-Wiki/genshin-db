				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020301,
					"content": "Wonderful. This is plenty. They look pretty good too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020302,
					"content": "Here's your payment, thanks for the help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020303
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020303,
					"content": "Is this before or after taxes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020304
					]
				},
				{
					"id": 230020304,
					"content": "After taxes, of course. Don't worry, I wouldn't make you go all the way back to Inazuma just to pay for overdue taxes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020305
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020305,
					"content": "But I can't guarantee there haven't been any changes to the Shogunate's tax policies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020306
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020306,
					"content": "Hmm... I should write a letter to Yousuke regarding this matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanbei"
				}
			]
		},
