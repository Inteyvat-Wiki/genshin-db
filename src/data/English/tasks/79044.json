			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440101,
					"content": "Let us give thanks to fate, dear travelers, for your wanderings have finally brought you here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440102
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440102,
					"content": "Surely you must be searching for a serendipitous encounter beyond your wildest dreams, an astonishing journey that is beyond your mundane imagination?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440103
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440103,
					"content": "Now, the opportunity for us to fulfill all of our desires has been laid before you, right here, right now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440104
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440104,
					"content": "Dive into the brand new \"Daiya's Three-Day Reverie\"! Step onto the grand stage, and you can experience something beyond your wildest dreams!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440105
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440105,
					"content": "Swim freely in a pool of Mora... exorcise the phantoms haunting ancient castles... break free from the shackles of gravity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440106
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440106,
					"content": "Whisper the passphrase: \"Take us to the world of reverie\" to declare your curiosity and passion, and begin your journey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440107
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440107,
					"content": "Wow, that speaker really knows how to work a crowd! Though Paimon didn't understand the details...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440108,
					"content": "Journey? Show? Stage? And something about... A pool of Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440109,
						790440110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440109,
					"content": "Seems like a new attraction.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				},
				{
					"id": 790440111,
					"content": "Oh! When you put it like that... Paimon's definitely heard of that kind of activity before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440112,
					"content": "So, is the person making the announcement Daiya? She must be the director of the play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440113,
					"content": "So if we register, we can become the characters of some of the plays?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440114,
						790440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440114,
					"content": "Are you interested, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440116,
					"content": "It definitely sounds cool! Paimon's especially interested in the pool of Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440117,
					"content": "Uh... that's not it! Paimon just wants to see what kind of mystery attraction is deserving of such a special spot in the Veluriyam Mirage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440118,
					"content": "Then let's say the passphrase together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440119,
					"content": "Take us to the world of reverie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440120
					]
				},
				{
					"id": 790440120,
					"content": "Take us to the world of reverie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440121,
					"content": "Really? Just like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440122
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440122,
					"content": "*ahem* Perfect! Your registrations have been confirmed, and Daiya's Three-Day Reverie will begin shortly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440123
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440123,
					"content": "\"An ancient legend resurfaces, and new clues to a priceless treasure are found. A band of chivalrous pirates hones their weapons and hoists the sails...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440124
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440124,
					"content": "\"A town floating in the sky encounters an unprecedented crisis, and a miracle-working architect must act quickly to prevent the soaring city from crashing to the ground...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440125
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440125,
					"content": "\"To save their fallen friends, a lone Hydro Eidolon must break into the haunted fortress, and find a way to lift the curse...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440126
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440126,
					"content": "There are three different shows, each with their own theme. Please choose one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440127
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440127,
					"content": "Find an announcement speaker like this, and follow the instructions to go to the place of reverie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440128
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440128,
					"content": "#Come on, {NICKNAME}! Let's look for an announcement speaker and give it a whirl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440115,
					"content": "Shall we kickstart our acting careers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440110,
					"content": "Like having guests act onstage in a play.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				}
			]
		},
		{
			"id": 7904406,
			"completionStepIds": [
				7904405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904405",
							"2"
						],
						"stepId": 7904405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440601,
					"content": "Whoa! Why are there so many Water Droplets here... what are they doing gathered around that giant machine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440602,
					"content": "Paimon's confused, what's this machine for? And where's Daiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440603,
					"content": "Welcome to the Three-Day Reverie! Surely, you must be confused by the scene unfolding before your eyes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440604
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440604,
					"content": "Then allow us to demonstrate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440605
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440605,
					"content": "C'mon, Loafer, stop napping! Now, Place 1, Action 2!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440606
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440606,
					"content": "\"Let us give thanks to fate, dear travelers, for your wanderings have finally brought you here!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440607
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440607,
					"content": "Is that Water Droplet using the announcement speaker to... play a recording?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440608,
					"content": "It sounds so familiar... where has Paimon heard it before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440609,
						790440610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440609,
					"content": "It's the announcement we first heard regarding this attraction.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				},
				{
					"id": 790440611,
					"content": "Hustler, you're up! Place 3, Action 7!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440612
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440612,
					"content": "\"The Chief Mate that appears in front of the new recruits is dressed raggedly, covered in bandages from head to toe. It is readily apparent that they barely survived an intense battle not long ago...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440613
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790440613,
					"content": "Paimon remembers! This is from \"The Black Nacre and the All-Devouring Kraken\"! This is the part right after we meet the Chief Mate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440614,
					"content": "The narration we heard then was also played like this... what amazing timing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440615,
					"content": "The Harum-Scarum and Black Nacre are about to reach the pass where the treasure is hidden, hurry up and prep the scenery and props, don't you dare screw this up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440616
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440616,
					"content": "That Water Droplet is... operating that device? Paimon can't see how...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440617,
						790440618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440617,
					"content": "Monitoring, broadcasting, and operating the mechanisms...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440619,
					"content": "Correct! The function of this massive device is to control the timing of all the mechanisms in every play!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440620
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440620,
					"content": "Our diligent Hydro Eidolons are constantly monitoring the progress of each show, so that whenever tourists arrive at the designated spots, they hear the proper narration and each prop and device is activated on time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440621
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440621,
					"content": "As long as guests follow procedure, a fantastical \"Three-Day Reverie\" will play out before your eyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440622
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440622,
					"content": "Of course, if guests try to leave partway through or behave too unexpectedly, then it'll really impact their enjoyment of the show.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440623
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440623,
					"content": "We just don't have enough staff to handle things like that right now... Anyway, I think all the guests will behave themselves, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440624
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440624,
					"content": "Th-That's so amazing! We were having so much fun, we never realized how much was going on behind the scene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440625,
					"content": "So many props and mechanisms have to be carefully controlled, it must be really hard to pull off these shows...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440626,
						790440627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440626,
					"content": "The design is brilliant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440628,
					"content": "So... Is this Daiya talking to us now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440629,
					"content": "Are you using these Hydro Eidolons to control the \"Three-Day Reverie\"? Why not just come explain things yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440630,
					"content": "Paimon still has so many questions for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440631,
					"content": "Correct, but there's more to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440632
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440632,
					"content": "Everything you have seen, and everything inside this Broadcasting Station, including the Chief Director, Fake Playwright, Loafer, Hustler, and the Harum-Scarum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440633
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440633,
					"content": "As well as the other unseen and unheard Hydro Eidolon maintenance staff, of course...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440634
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440634,
					"content": "Combine all of these and that is \"Daiya\"— not a person, but the entire system itself, creator and controller of the show.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440635
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790440635,
					"content": "Daiya is not a person... but a system?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440636,
					"content": "Wait a sec. That's overloading Paimon's brain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440637,
					"content": "Paimon knows that Water Droplets are smart, but can they actually design such a complicated... system... by themselves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440638,
						790440639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440638,
					"content": "There must be a designer behind the curtain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440640,
					"content": "Yes, that was the case at first. Your surprise is expected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440641
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440641,
					"content": "Long story short, Daiya's Three-Day Reverie started with the passionate Director Zosimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440642
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440642,
					"content": "During his short stay in Veluriyam Mirage, Director Zosimos poured his energy into putting on exciting plays, and never had time for anything else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440643
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440643,
					"content": "As he spent more time with the Hydro Eidolons, he discovered their intelligence and rich emotions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440644
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440644,
					"content": "Hydro Eidolons enjoyed his plays, and looked forward to the next show. They also wanted to share their enjoyment with visitors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440645
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440645,
					"content": "An idea grew inside Zosimos's head — Could Hydro Eidolons direct, or even design a show?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440646
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440646,
					"content": "So bold! That sounds like... teaching a group of children to be directors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440647,
					"content": "Indeed, it was difficult. Fortunately, everyone worked together, our joint efforts overcoming all obstacles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440648
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440648,
					"content": "Director Zosimos trained some of the Hydro Eidolons most passionate about plays, teaching them the critical concepts involved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440649
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440649,
					"content": "After some trial and error, Zosimos wrote several sample plays with detailed explanations regarding the thought behind them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440650
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440650,
					"content": "With Idyia's help, he built the controller, as well as all the mechanisms connected to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440651
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440651,
					"content": "In addition to the lines from the plays themselves, Director Zosimos also recorded lots of commonly used words that we could combine into sentences to communicate with guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440652
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440652,
					"content": "After a lot of practice, we finally learned to put on all three sample plays without a hitch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440653
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440653,
					"content": "The three plays are indeed \"The Black Nacre and the All-Devouring Kraken,\" \"Petrifying Gaze,\" and \"Skycastle Saviors\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440654
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440654,
					"content": "That is to say... Director Zosimos prepared the foundation and infrastructure for Daiya's Three Day Reverie, as well as left the scripts with accompanying instructions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440655,
					"content": "We definitely never noticed the whole thing was controlled by Water Droplets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440656,
					"content": "That's quite the compliment! We appreciate you validating our hard work, and proved many of our ideas correct...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440657
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440657,
					"content": "This is the reason why we wish to provide you with a token of our gratitude, and show you everything that went into the production of the show.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440658,
						790440659
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440658,
					"content": "Don't mention it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440660,
					"content": "That's right! We experienced a really special attraction and broadened our horizons! We should be thanking you, Daiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440661,
					"content": "Ahaha! Then we continue onwards to our next goal— writing our own scripts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440662
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440662,
					"content": "To do this, we improve our understanding of \"plays\" and keep collecting new materials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440663
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440663,
					"content": "The one called Fake Playwright here collects stories from visitors, and enhances our ideas with those.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440664
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440664,
					"content": "Even if it can't meet suitable guests itself, Fake Playwright talks to other Hydro Eidolons about their encounters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440665
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440665,
					"content": "Oh! So when we tell our stories to Fake Playwright, it helps you write new plays!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440666,
					"content": "Exactly! If you have time, please talk with Fake Playwright more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440667
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440667,
					"content": "Also, please continue to enjoy your time in Veluriyam Mirage, and please talk more with the other Hydro Eidolons here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440668
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440668,
					"content": "#No worries! Paimon and {NICKNAME} love it here, we'll definitely provide you with lots of great material!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440669
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440669,
					"content": "Hmm... Actually, there's something else... Paimon's been curious about it for a while!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440670,
					"content": "Why is it called \"Three-Day Reverie\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440671
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440671,
					"content": "Could it be that... Director Zosimos spent three days on each play? Or maybe, like, three days in total?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440672,
						790440673
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440672,
					"content": "Haha, I know this one!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440674,
					"content": "\"Yesterday,\" \"today,\" and \"tomorrow\"? Sounds reasonable to Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440675
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440675,
					"content": "That means Director Zosimos... I mean, all of Daiya, is working so very hard on the plays, day after day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440676,
					"content": "Nice one! Unfortunately, it's not quite that deep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440677
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440677,
					"content": "Actually, the true meaning behind \"three days\" is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440678
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440678,
					"content": "\"Eh, plenty of time left to do it tomorrow,\" \"Maybe I'll really be in the zone tomorrow,\" and \"If I don't finish it tomorrow I'm dead meat\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440679
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440679,
					"content": "Seriously!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440673,
					"content": "It refers to \"yesterday,\" \"today,\" and \"tomorrow,\" right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440659,
					"content": "We enjoyed ourselves.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440639,
					"content": "And someone to look over the scripts, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440627,
					"content": "Great timing and teamwork.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440618,
					"content": "Those capabilities are enough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440610,
					"content": "It was playing this recording.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				}
			]
		},
		{
			"id": 7904407,
