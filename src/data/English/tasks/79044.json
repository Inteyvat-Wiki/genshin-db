						],
						"pointId": 59
					}
				]
			},
			"dialogs": [
				{
					"id": 790440801,
					"content": "Paimon knew it! A hidden chamber, filled with secrets!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440802,
					"content": "Hehe! Ready or not, here we come!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
