						],
						"pointId": 59
					}
				]
			},
			"dialogs": [
				{
					"id": 790440701,
					"content": "Hmm... Wait, how come we didn't notice this secret door before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440702,
					"content": "Oooh! Paimon knows! Let's say the passphrase again, then a new path will open!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440703,
					"content": "Together now!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440704
					]
				},
				{
					"id": 790440704,
					"content": "Okay! We did it to register, and times like this are perfect to have a little ceremony!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440705,
					"content": "You recite the passphrase together with Paimon: Take us to the world of reverie!",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790440706
					]
				},
				{
					"id": 790440706,
					"content": "With the clinking of machines, a door opens, revealing a tunnel.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7904408,
			"completionStepIds": [
				7904404
			],
			"beginWay": "TALK_BEGIN_NONE",
