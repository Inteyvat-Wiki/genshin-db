			"dialogs": [
				{
					"id": 731580101,
					"content": "\"...Patient age: 65. Gender: Male...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580102
					],
					"speakerTitle": "Khayyam's Medical History"
				},
				{
					"id": 731580102,
					"content": "\"Symptom: Short-term dysmnesia. Gets worse over time. Emotionally unstable, kept talking about adolescence and childhood memories...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580103
					],
					"speakerTitle": "Khayyam's Medical History"
				},
				{
					"id": 731580103,
					"content": "\"...Brain disease of unknown cause. Brain exams show the patient's brain cells have been suffering inactivation from the age of 60, leading to gradual loss of memory faculties...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580104
					],
					"speakerTitle": "Khayyam's Medical History"
				},
				{
					"id": 731580104,
					"content": "\"...Applied for retirement from Amu{RUBY#[S]Biology}rta in Akademiya, in the hope that a stable and comfortable life and psychological environment could slow down the deterioration of the patient's condition...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580105
					],
					"speakerTitle": "Khayyam's Medical History"
				},
				{
					"id": 731580105,
					"content": "\"Amurta announced that the sage Siman Farrokhzad would ensure the patient's treatment is underway...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam's Medical History"
				}
