			},
			"dialogs": [
				{
					"id": 750013201,
					"content": "I can't believe that worked. That was truly a scene from out of story and song.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013202,
					"content": "The cacophony fell silent... and the Pin returned to its original state. Then, its giant form crashed to the ground...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013203,
					"content": "Hoo... To think that someone could really accomplish this... This isn't a dream, is it? You're all real, aren't you? Not figments of my imagination?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013204,
					"content": "Wake up, wake up... You've got to fix this yourself!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "Hey, there's no need to be so mean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013206,
					"content": "#But anyway, didn't Paimon tell you? {NICKNAME}'s super strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013207,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#Hehe, you think so, don'cha, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013209,
					"content": "#You weren't affected by the Abyss, were you, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013210,
					"content": "Relax, it's just the Abyss...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#Even our strongest warriors must remain vigilant and then some in the face of the Abyss. You're no ordinary person, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013213,
					"content": "Haha, who knows, the story I spin from this material might even surpass those by Sanhaj!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013214,
					"content": "Ehrrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "Well, that sure sounds impressive, but who's Sanhaj?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013216,
					"content": "Haha, for \"those who tell stories in their tribes,\" Sanhaj of the Masters of the Night-Wind is worthy of reverence indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013217,
					"content": "Alas, time is short. I'll tell you more about Sanhaj when we've got more time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013218,
					"content": "Alright then. Let's head for the next floating Shadow Pin. I want to fix this issue and start writing by nightfall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013219,
					"content": "Woohoo! Let's go, let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013220,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "I'm alright for now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7505702",
							"2"
						],
						"stepId": 7505702,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500107",
							"2"
						],
						"stepId": 7500107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "Wow. Here I'd thought to come over and check on the frightening noises I'd heard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010802,
					"content": "Telling myself \"Come on, Titu, it's probably nothing\"... But this is quite something! Quite something indeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010803,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "There's even a little Tepetlisaurus here... Was it you who brought these outlanders here, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010805,
					"content": "And... was it you who brought this Shadow Pin down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010806,
					"content": "...Should we not have done that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#Eh? Wait, did we do something bad, {NICKNAME}? If we act fast, while there's only one witness...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010808,
					"content": "#Haha, come on, no need for that! It's not serious, and if anything, I'd say you've done us a favor! So, you're {NICKNAME}, then? Who's your friend over there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010813,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#And this is {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "And Titu's my name, a teller {RUBY#[D]storyteller}of tales for our tribe. I'm also responsible for \"caring\" for the stone pillars in this valley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010816,
					"content": "And of course, this Shadow Pin you've plunged into the earth is one of three little pins, and its care is within my jurisdiction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010817,
					"content": "J—Jurisdiction... Uh oh, looks like we're going to have to compensate the locals for dropping that stone pillar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010818,
					"content": "Ugh, Paimon wouldn't have used our real name's if she'd known sooner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010819,
					"content": "Compensate... \"Titu had a flash of inspiration. Perhaps he might use this to coerce these people into helping him achieve his goals...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010820,
					"content": "That's how I'd slot a bit like this into the plot, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010821,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "Ah, sorry, got a bit carried away thinking about stories there. Telling{RUBY#[D]storyteller} tales is my responsibility here in the tribe, and after so many years, it's time for me to come up with some originals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010823,
					"content": "And of course, something just had to go wrong with the Shadow Pin just as I was a few days into my musing... Because why would it ever rain when it could pour?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010824,
					"content": "Ahem! Anyway, I'm not gonna blackmail you. I—I mean, I wouldn't have spoken my thoughts aloud if that was the case, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010825,
					"content": "Look, we exchanged names, but we haven't come to blows, so that makes us friends, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010826,
					"content": "In that case... could you listen to a friend's request?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010827,
					"content": "Sure... as long as it doesn't involve compensation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "No, no, surely not! Hmm, how should I put this? ... When you passed through the valley, did you see some sort of giant block of solid phlogiston with golden patterns carved into it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010829,
					"content": "It's in the center of this place. You can't miss it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010830,
					"content": "That rings a bell...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "This whole business I'm talking about has to do with that huge stone pillar. We call it a Shadow Pin... and we've had problems with it recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010834,
					"content": "To be honest, I'd all but given up before meeting you. I had the line all ready: \"The Shadow Pins could not be saved, dooming the tribe to calamitous destruction\"... It didn't sound too bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010835,
					"content": "Wait, it's just a stone pillar. How could it destroy the tribe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010836,
					"content": "Also, what's so special about these \"Shadow Pins\" anyway? And the one we dropped, it was a... lesser pin? But it seemed pretty big to Paimon, so why's it called that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010837,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "Hmm... Since you're both outlanders, I suppose a more detailed explanation is in order. This is related to a legend handed down through our tribe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010839,
					"content": "The stories say that the Wayob hung the Pins here to seal the shadow of the Volcano Lord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010840,
					"content": "But that which is sealed beneath them is, in truth, the Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010841,
					"content": "That's how most tales in Natlan are. They're embellished narratives held up as warnings, and all their rhetoric is a kind of metaphor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010842,
					"content": "Wait, so you mean the Abyss is actually sealed below here!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010843,
					"content": "That's right. And recently, two out of the three little Shadow Pins have floated upward. Perhaps if the third floats too, all the evil beneath the earth will come surging up like a tide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010844,
					"content": "So to be honest, it's an unexpected boon that you've managed to push one back in. So, no compensation required.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010845,
					"content": "If anything, I was hoping to ask if you'd mind pushing the other one back in as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010846,
					"content": "#Huh... What do you think, {NICKNAME}...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010847,
					"content": "...Where the Abyss is involved, we can't stand idle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Even you're up for it, {REALNAME[ID(2)|SHOWHOST(true)]}? Well, alright then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010851,
					"content": "Ah, like a flame that appears in the darkness, so too will heroes rise up in times of great peril. Human possibility shines through in glory at moments such as this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010852,
					"content": "#You know what? This could make for a great story, too — indeed, {NICKNAME}, you've got some traits that even those storied heroes don't have. I'm looking forward to this, I must say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010853,
					"content": "Let's go, then, dear heroes. Let's go and check on the last floating Pin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010848,
					"content": "Perhaps I could lend a hand?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "Nope, don't recall anything like that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "Huh. I thought it was obvious enough. That's fine, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010809,
					"content": "Paimon did it. I was just walking over here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "Hey! You're always like that! Paimon'll get mad if you don't cut it out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010811,
					"content": "#Haha, relax. If anything, this is a huge relief. So your name's Paimon, then? In that case, how about this {M#good fellow}{F#good lady} over here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010812,
					"content": "#Call me {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
