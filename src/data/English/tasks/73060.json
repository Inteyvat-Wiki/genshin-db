			"dialogs": [
				{
					"id": 730600401,
					"content": "The Grove of Dreams... A quiet melody, the sound of the water, the sound of birds flapping their wings, the sound of stepping onto a branch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "Talking to Nara and Paimon... Paimon is fun. Sadly, Paimon doesn't want to become a seed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "That's because Paimon isn't an Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "The Grove of Dreams is fine now. Arabalika is in the Ruins of Dahri, but Arapandu's not worried. However, there's lots of Fungi at the Yasna Monument. Arapandu's worried about Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
