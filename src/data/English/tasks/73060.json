				"points": []
			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika is doing fine, but Arabalika is still worried about Aranakula at the Yasna Monument and Arakunti in the Grove of Dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Aranakula... There are too many bad mushrooms, if Aranakula was caught once again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "Worrying too much won't do any good. The Golden Nara is strong and knocked down that Big Iron Chunk like a great wind blowing over rotten wood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "We just need to heal the Varuna Contraption...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
