				"objectNames": [
					"Aranakula",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600201,
					"content": "You don't seem to be afraid of anything, Golden Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "The Golden Nara is a courageous Nara. Just like Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "Although Arapandu does worry about Arabalika in the Ruins of Dahri and Arakunti in the Grove of Dreams, with the Golden Nara's help, everything will be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "#Once the Varuna Contraption has been healed, no more bad guys will go disturb the nurseries. Aranakula would like to give the flowers there to {F#her}{M#him}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
