			"dialogs": [
				{
					"id": 730600601,
					"content": "There were a lot of bad guys at the Yasna Monument, but Aranakula has returned. Good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600602,
					"content": "The Golden Nara evaded the bad guys with Aranakula and cleaned the Memory of Stone up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600603,
					"content": "Once the Varuna Contraption is healed, the nursery flowers can be brought back. Aranara won't forget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600604,
					"content": "All that's left now is Arakunti in the Grove of Dreams. When Arakunti returns, we can go get rid of the bad bugs gnawing at the roots of the Varuna Contraption...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
