					"nextDialogs": [
						190961104
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 190961104,
					"content": "The meeting concerns research and development of new beverages, and involves collaboration between several different wineries. It makes more sense for me to attend, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190961105
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 190961105,
					"content": "Kaeya can answer any questions you might have while I'm not here. He's quite familiar with the winery.",
