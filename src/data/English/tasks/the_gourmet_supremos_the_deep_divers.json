				"points": []
			},
			"dialogs": [
				{
					"id": 721700501,
					"content": "The Seagrass here is pretty good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700502
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700502,
					"content": "I wouldn't call this \"picking Seagrass.\" It's more like \"pulling Seagrass\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700503
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700503,
					"content": "If we used a small knife, we'd get them all in no time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
		{
