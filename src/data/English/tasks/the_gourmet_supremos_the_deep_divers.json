			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700301,
					"content": "Now then. Seagrass... Fish... and Rice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700302,
					"content": "This should be how it goes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700303,
					"content": "Yup, that should be it! I present to you all, the Onigiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700304,
					"content": "How very... plain. Well, I'll take this one. I doubt I could finish any more...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700305,
					"content": "Well, I say it's all good as long it tastes good! I'll have this one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700306,
					"content": "This serving's yours, Traveler — and of course, here's a copy of the recipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700307,
					"content": "They seem like the most simple thing in the world, these Onigiri, but there's some real technique to making them well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700308,
					"content": "Well then. I should have some myself. All that work's made me hungry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700309,
					"content": "Hey, Parvaneh, I thought you said you couldn't finish!? Leave some for me, come on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
