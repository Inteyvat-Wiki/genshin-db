			"dialogs": [
				{
					"id": 721700601,
					"content": "Hmm... There wouldn't be any ruins beneath this place by any chance, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700602
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700602,
					"content": "R—Ruins? Well, it certainly would be nice if there were...",
