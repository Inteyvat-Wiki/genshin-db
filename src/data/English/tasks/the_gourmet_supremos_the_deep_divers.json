				"points": []
			},
			"dialogs": [
				{
					"id": 721700401,
					"content": "Are we really going to have to find a way to dive down there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700402
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700402,
					"content": "Can't we switch locations? Do we really have to get our Seagrass here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700403
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700403,
					"content": "Oh, come on, why does that mechanism have to be inside that barrier again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
