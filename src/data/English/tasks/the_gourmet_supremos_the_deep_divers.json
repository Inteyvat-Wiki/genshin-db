				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700701,
					"content": "It looks like the area below has been flooded before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700702
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700702,
					"content": "Yup, and the water marks very obvious, too. This place was definitely flooded up till not long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700703
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700703,
					"content": "But why did the water suddenly retreat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700704
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700704,
					"content": "Ugh, this place is all wet. The water's going to get into my shoes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700705
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700705,
					"content": "Well, forget it. Let's just gather some Seagrass as quickly as we can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700706,
					"content": "What are you doing over here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "Oh? Would you look at that! So we meet again, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700708,
					"content": "We just went down to collect some Fresh Seagrass to make a dish known as Onigiri. It was pretty tough going down there. My shoes are soaked...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700709,
					"content": "But that aside, Traveler, could you help us get some more Seagrass?",
