			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700201,
					"content": "Have you gathered any Seagrass, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700202,
					"content": "Aha, yes, this is it. Thanks for your help, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700203,
					"content": "Well, time to make that dish that they call... Onigiri, was it? I've heard that it's a simple enough dish to make...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700204,
					"content": "Alright, hang on while I prepare the food. It's going to take a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7217003,
			"completionStepIds": [
				7217004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
