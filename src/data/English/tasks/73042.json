			"dialogs": [
				{
					"id": 730420601,
					"content": "So much fun! Arakanta is very happy playing games with Golden Nara! And Nara is so fast! So amazing! Like a real tiger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "It is fun playing with other Aranara and real Rishboland Tigers, but playing with our new friend, our Nara friend, is even more fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "Why would the Rishboland Tiger chase Aranara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "The Rishboland Tiger and Aranara are friends, and friends play together. But Arakanta noticed that Nara are afraid of the Rishboland Tiger. That's why Arakanta came up with a new game for Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "Thank you, Nara. Here is an Aranara flower for Golden Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
