			"dialogs": [
				{
					"id": 730420101,
					"content": "Golden Nara, Arakanta has heard so much about you. You are a good Nara. Will you play with Arakanta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420102,
					"content": "Arakanta's game is simple and fun! Listen to the rules, Nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420103,
					"content": "Arakanta will summon a lot of Dendro particles, which are \"Aranara\" hiding in the circle. Nara is a big and powerful \"Rishboland Tiger.\" Come and chase \"Aranara\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420104,
					"content": "If the \"Rishboland Tiger\" catches all the Aranara in a short time, then Nara wins!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420105,
					"content": "Good? Nara willing to play game with Arakanta now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
