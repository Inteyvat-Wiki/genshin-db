			"dialogs": [
				{
					"id": 751781401,
					"content": "Eh? A little Koholasaurus? Why is it here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781402,
					"content": "Ki'o-ki'o...! So you were here after all... If you guys hadn't come out when you did, I-I'd have...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781403,
					"content": "What if you'd gotten hurt? Don't just run off like that again, okay? *sniff*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781404,
					"content": "H—Hey, cheer up! Look, your little saurian's fine, see? Super full of energy, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781405,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "Ah, um... I'm okay now. Oh! I forgot to introduce myself. I'm Linaha, from the People of the Springs. I'm usually assigned to take care of the little Koholasaurs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781407,
					"content": "Alone? That's pretty impressive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781408,
					"content": "N—Not really... If I were more like you, Ms. Paimon, they probably wouldn't have run off like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781409,
					"content": "I was thinking that they might've all gone to play near the vents, and it turns out I was right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781410,
					"content": "So the hot spring got cold because the little Koholasaurs had the phlogiston vents all blocked up, huh? No wonder the spring caretaker didn't notice anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781411,
					"content": "Actually... there are still two more Koholasaurs I haven't found yet. I think they're probably hiding in the phlogiston vents too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781412,
					"content": "Leave this to us! We'll find the other little Koholasaurs while we adjust the water temperature, don't you worry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781413,
					"content": "Really? Thank you! It's great to have Ms. Paimon around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781414,
					"content": "Hehe, of course! You can always count on a legendary adventurer like the Great Paimon — this is a piece of cake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781415,
					"content": "Wow! Ms. Paimon, you're amazing! I want to be just like you someday!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781416,
					"content": "I agree. The Great Ms. Paimon is indeed amazing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				},
				{
					"id": 751781418,
					"content": "(Hey, can you not put Paimon on the spot like that in front of everyone? How about this — Paimon'll let you have the best dish tonight, okay?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781419,
					"content": "Ahem! Anyway, let's get going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781417,
					"content": "Alright then, I'll leave the next fight to you, oh Great Ms. Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				}
			]
