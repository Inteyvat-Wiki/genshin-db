				"points": []
			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "Can someone lend a hand!? Someone just fainted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#Oh no, looks like the master's passed out! Let's go help too, {NICKNAME}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "It seems like the master only fainted from the heat and isn't seriously injured. With your help, Yoleehe carries the unconscious master away...\\nLooks like the master's own ability to handle \"intensity\" still has some room for improvement...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
