			},
			"dialogs": [
				{
					"id": 751780101,
					"content": "Hello there! Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780102,
					"content": "#Such overwhelming \"intensity\"! As expected of the legendary {NICKNAME} and Paimon! You've come all this way — don't tell me you're here to compete for the title of the \"strongest in the Collective of Plenty\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780103,
					"content": "\"Strongest in the Collective of Plenty\"? Isn't this just the regular \"Warrior's Challenge\"? Look, there's a whole line of people waiting over there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780104,
					"content": "Haha, they're nothing compared to you two. To claim the title of \"strongest,\" you must defeat the current \"strongest.\" Ordinary people don't even qualify for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780105,
					"content": "So, it is good that you are here... though your timing is less stellar, I fear. The master presently has no time to deal with worldly affairs, so a face-to-face meeting is not on the cards for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780106,
					"content": "Where is he, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "Oh? Are you planning to seek the master out for a battle? A bold move! In that case, I wouldn't mind sharing his whereabouts with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780110,
					"content": "Journey along training's rugged path, and you'll come across a mountainous region brimming with the \"Waters of Intensity.\" There, perhaps, you'll find traces of the \"strongest.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780107,
					"content": "Alright, then we'll wait for him to return.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "Indeed, indeed. \"Intensity\" draws \"intensity,\" and the \"strongest\" will surely cross paths with the \"strongest.\" So yes, waiting is certainly one option.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
