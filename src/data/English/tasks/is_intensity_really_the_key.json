			"dialogs": [
				{
					"id": 751780901,
					"content": "#Oh hey, {NICKNAME}, it's you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780902,
					"content": "Why do you look so down?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "Actually... the hot spring water still feels colder than it used to. I really messed up this time. What am I gonna do when I go back...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780905,
					"content": "Don't worry, just give it a bit more time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "Alright, got it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 751780903,
					"content": "See you around.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#Um... take care on your way, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
