			"dialogs": [
				{
					"id": 751781001,
					"content": "Hmm... Well, we already agreed to help out, but where should we even start?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781002,
						751781005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781002,
					"content": "How about giving our magical mystical phlogiston a try?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781003
					]
				},
				{
					"id": 751781003,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781004
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781004,
					"content": "That's never going to work! The area's way too big!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781009,
					"content": "*sigh* Isn't there a more realistic solution we can try?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781010,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#Wait, {REALNAME[ID(2)|SHOWHOST(true)]}, don't go wandering off like that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781005,
					"content": "There's probably a lot of magma in the volcano nearby...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "Oh, Paimon gets it! We could have our little guy dig a tunnel, then use the volcanic magma to heat the hot spring, right? Not a bad idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781007,
					"content": "Rawr! Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#...Yeah, right! Get serious, would you? We could get people killed doing that! Worse, {REALNAME[ID(2)|SHOWHOST(true)]} believed you for a second back there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				}
			]
