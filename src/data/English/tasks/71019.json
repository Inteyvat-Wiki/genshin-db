			"dialogs": [
				{
					"id": 710190201,
					"content": "There's a big stone inside that basin. Paimon guesses this is a \"rockery.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "But aren't they usually put inside gardens or yards? What's the point of putting one out here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "Huh. The top of this rockery has something strange on it. It seems to be a mark of some kind... Paimon's quite concerned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Well, since we're on a journey... let's just look out for mountains that look like this rockery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
					"content": "It'll be nice if we find something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
