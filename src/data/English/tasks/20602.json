			"dialogs": [
				{
					"id": 206020501,
					"content": "You're back. What's the situation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020502,
					"content": "There are still monsters out and about...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206020503
					]
				},
				{
					"id": 206020503,
					"content": "Monsters are still in the area, eh? So it seems that the effects of the Storm have yet to disperse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020504,
					"content": "Hahaha! So there's still time, then — time for the Adventurers' Guild to show its quality.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020505,
					"content": "It is up to us to take those monsters out in the wild on, while the Knights of Favonius are still focused on defending the city and the area around Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206020506,
					"content": "I understand. Thanks for your help in investigating. I will reconsider the commissions that we will be sending out. Take these as your reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
