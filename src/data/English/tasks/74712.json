			"dialogs": [
				{
					"id": 747120101,
					"content": "#{NICKNAME}, Paimon, I have some wonderful news. Everything's finally in place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120102,
					"content": "Operation Aggro-Fish De-Escalation has been a huge success!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120103,
					"content": "Once the divers have cleared away all the underwater debris and our patients are a bit more relaxed, we'll be able to return them back to the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120104,
					"content": "Thanks so much for all your hard work.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "Hehe, you've been working just as hard as us, Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120106,
					"content": "I've written an incident report and submitted it to the Palais Mermonia. A specialist in this field should be drafting relevant regulations and will notify the appropriate agencies soon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120107,
					"content": "I've also heard that some reporters, and at least one director, have shown great interest in this matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120108,
					"content": "Who knows, maybe we'll even get to see a film about the importance of protecting aquatic environments one day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120109,
					"content": "That would be awesome! You can talk to people all you want, but there'll always be careless or stubborn folks who simply won't listen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120110,
					"content": "They need to see something really scary... Make them think that if the environment gets completely ruined, the fish will... mutate into giant, invincible monsters and destroy everything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120111,
					"content": "Give everyone who throws junk in the sea the scariest, most terrifying nightmares. That'll teach 'em to respect nature!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120112,
					"content": "What a wonderful idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		}
	]
}