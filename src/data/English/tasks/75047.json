			},
			"dialogs": [
				{
					"id": 750470301,
					"content": "So sleepy. I want to sleep... But we have to stand here together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
					],
					"speakerTitle": "Huruk"
				},
				{
					"id": 750470302,
					"content": "Why... Do humans want to stand here all day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huruk"
				}
			]
		},
		{
			"id": 7504704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
