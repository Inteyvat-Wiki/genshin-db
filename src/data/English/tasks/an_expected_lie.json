				]
			},
			"dialogs": [
				{
					"id": 741361101,
					"content": "#Miss Fusilier! {NICKNAME}! You're back! You must've handled things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361102,
					"content": "Oh, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "Whoa! Mr. Choiseul is really about to faint!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "I didn't think you'd be back at the Institute, Choiseul. I figured you'd be stuck dealing with paperwork forever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "This... This is impossible! Goodness gracious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimondo, how does it feel taking over my job? Anything worth reporting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "...What a wonderful reunion, Mr. Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361108,
					"content": "Ha! Look around you. You really do seem suited for janitorial work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "...Hmph! He didn't even clean it up properly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Mainly because he didn't clean you up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Thank you for bringing those two back, Honorary Senior Researcher {NICKNAME}, Miss Fusilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361112,
					"content": "Hopefully, this marks the end of the Fontaine Research Institute's series of unfortunate events and turmoil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361113,
					"content": "Hahaha! Great. The Fontaine Research Institute will now fall into deathly stillness where all inspirations wither and die.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "You certainly have already sparked much inspiration around the Institute. It's time to calm things down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361115,
					"content": "Raimondo Havenport, you know nothing about research. You are not fit to lead the Fontaine Research Institute of Kinetic Energy Engineering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "But I know how to keep it up and running properly, Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361117,
					"content": "What you need to do right now is to stay away from research and Arkhium. It's better for all of us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361118,
					"content": "Some time later, the Maison Gardiennage's personnel arrives and take both Nacker and Edwin. It is for the best that they finally leave the Institute for good...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Thank goodness, my nightmare has finally ended...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Mr. Chaussivert, Mr. Lemarcq, yes? I've heard about the assistance you rendered to our institute. Please take a well-deserved rest here while your compensation is being arranged.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Hahaha! I didn't think someone like me would ever be associated with the Institute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "Don't say that about yourself, dear sir! You're sincere and kind-hearted, so you're definitely a good person. Maybe we'll enlist your help in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "As for you... Honorary Senior Researcher, you did us a great favor once again. How should we ever repay you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Just don't get blown up again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "By the way... Where's Miss Fusilier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "...We should give her some room to calm down. Looks like the image of Edwin Eastinghouse she had created in her head has completely shattered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361130,
					"content": "Edwin and Nacker need to calm down as well... I hope they can reflect on their own mistakes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361131,
					"content": "Will they stay in the Fortress of Meropide all their life?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Judging by how dangerous they are, I hope they never leave that place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361133,
					"content": "However, given the state of things here at the Fontaine Research Institute... I can only hope I don't run into situations that would require their expertise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361134,
					"content": "I thank you again on behalf of the Fontaine Research Institute, Honorary Senior Researcher. If you have any further questions, I'm at your service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361125,
					"content": "What about a promotion?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Well... theoretically, your current title already resides at the top... But let me see what I can do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "How about something like... Chief Honorary Senior Researcher? Hahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
