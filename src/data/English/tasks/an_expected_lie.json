			"dialogs": [
				{
					"id": 741360601,
					"content": "A huge empty space with... nothing inside... Did we come up empty-handed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360602,
					"content": "The plants have been intentionally cleared, and the trimming seems relatively recent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360603,
					"content": "...All the trouble I went through for him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360604,
					"content": "Anyway, I'll go down alone and take a look. You stay with Miss Institute Lady. If things get out of hand... take her and go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360605,
					"content": "But there's nothing here. How could things get out of hand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360606,
					"content": "Squeak! Beep beep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360607,
					"content": "Whoa! Look out! Something's coming!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
