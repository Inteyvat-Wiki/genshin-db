			"dialogs": [
				{
					"id": 741360901,
					"content": "Institute dogs! How much did Choiseul and Raimondo pay you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Just a title.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "You... You... Listen to me, let me go. My \"Field Generator\" is almost done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Once I successfully synchronize it with the Arkhium Kinetic Core, then... Then I'll be the greatest kinetic engineer ever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "...Taking credit for someone else's work and claiming to be the greatest engineer. Shame on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Now I finally know why Mr. Ed... Edwin never wanted you to take part in the core research project.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "Edwin doesn't know a thing about what to do with it! You're also from the Institute... You know the true value of this thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Help me! I can... develop it with you! Then, we'll both be famous, and incomparable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Edwin, Raimondo, Choiseul... None of them can surpass our fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Looks like what Raimondo said was true.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Edwin... Mr. Edwin's achievements... belong to the Institute. I'm only here to claim them, nothing more, nothing less.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Miss Fusilier... suddenly changed how she addresses Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "Don't be a fool, girl! You don't know what Concini can give us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "We'll never get such benefits even if we run errands for Edwin for a million years! Edwin and the Institute only wanted to use us... We have to think for ourselves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "I had enough of this nonsense. Shut up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "And who the heck are you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "The one who watches over Lumidouce Harbor. One more word, and you'll taste my fist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, help me tie him up and take that core or whatever. It's time we head back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "It must've been tough for you, Nacker, to hold all of that in for such a long time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "Not one Mora. I volunteered.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
		{
			"id": 7413610,
