				{
					"id": 741363401,
					"content": "Why are you... You're back again. Told you. You can try five times and still won't find him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "It's not working out for you, clearly, so why don't you just sit down and have some tea? I just bought five cups... and a few bowls.",
