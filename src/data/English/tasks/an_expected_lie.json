			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin... I knew it! You lured them over... You've always been jealous of me! Afraid that my research would surpass yours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "You're right. I am so jealous of how totally oblivious and ignorant you are. No wonder you led such a blissful life back at the Institute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Only if Choiseul was here to see this... He'd faint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "He better never wake up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "You go back to the Institute with them and repent... I need to get back to my research... You didn't break anything, did you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "Who said you can go back to your research!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "What are you gonna do? Take me back to the Institute? How am I supposed to continue my research, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "That fool Raimondo will definitely turn the Institute into a mess. And that idiot Choiseul... Ugh! The mere thought of it gives me a headache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "You're the one who turned the Institute into a mess! Stop shifting the blame to someone else!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "Me? Fine. You want to blame me for the explosion at the Central Laboratory, right? But you know what? I wasn't even there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "The institute is full of fools! Even someone knocking over a cup of coffee can trigger an equipment malfunction, so I'm not surprised they managed to cause an explosion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "Then why didn't you try to explain that to them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "Explain? I'm not gonna be their scapegoat. I have a lot of research on my hands, and my time cannot be wasted on them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "And so you decided to get mixed up with the likes of Concini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Oh, he's no better... He couldn't even get his hands on a piece of precision equipment. I had to do all the work. At least he's willing to fund the research, so everything went smoothly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "But I didn't expect our dear Nacker to come here with that incomplete core prototype.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "I've modified it! With my tech you can never develop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Haha! Mr. Nacker, Concini is not here for you to suck up to, so why don't you stop lying to yourself? Don't you have an ounce of dignity as a researcher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "You...! It's \"incomplete\" only because you don't know how to complete it! But I know how, and I can do it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Right. Now, just take this piece of junk back to the Institute and keep leeching off it. I have something more important that requires my attention. You... Fusi-something, I'll leave this to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "Will those two ever stop arguing...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "...Enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "What? Can you stop wasting my time? I need to get back to work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "I said... enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "Edwin Eastinghouse! You, you are the one who blew the Institute up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "And you, Nacker, you stole the Institute's assets!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "And blew the Institute up a second time!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "Both of you harmed the interests of the Institute... As the special investigator of the Fontaine Research Institute, I am taking both of you back to the Institute where you shall be dealt with accordingly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Darn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Oh, please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Lemarcq and I will escort those two back. Say, we've been the errand boys for a long time, so the Institute will definitely compensate us, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "Remember, keep your mouths shut along the way, or you might meet an early end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "Stop right there! I'm warning you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "I'm about to faint, too...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
