			},
			"dialogs": [
				{
					"id": 80200601,
					"content": "Just as I suspected... The false memories were a trap. The Abyss Order just wanted to follow us here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200602,
					"content": "Now that they're in the vicinity, we should have a chance to see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200603,
					"content": "Argh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200604,
					"content": "Dain? What's wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200605,
					"content": "Can you feel that? There's been a disturbance in the Ley Lines. It must be the work of the Abyss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200606,
					"content": "Wow, you must be really sensitive to that sort of thing. Paimon doesn't feel it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200607,
					"content": "You two, do as I say... Use that mechanism over there and leave this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200608,
					"content": "Leave you here on your own? Will you be alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "The Abyss Order is putting something in motion. If you return to Vimara Village, I suspect you might finally have the opportunity to locate the missing villager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200610,
					"content": "...Just think of it as a way to divide and conquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200611,
					"content": "Alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "(Dain does have a point...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "(But, something still feels off... What am I missing...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "Hmph... I knew going along with your trap would be the only way to meet with you face to face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200615,
					"content": "You risked your safety and that of the eye...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "That's quite the gamble, Dainsleif... But I believe that I am the one walking into a trap laid by the Twilight Sword.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "So you came here all on your own? What about those followers of yours?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200618,
					"content": "When the Twilight Sword is prepared for battle, any army I could send would only be marching to their doom... Better that I face you alone.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "I know you must have a lot to say...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "...But, if it's a conversation you want, you'll have to defeat me first.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
