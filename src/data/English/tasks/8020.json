			"dialogs": [
				{
					"id": 80200501,
					"content": "Looks like we can't go any further...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200502,
					"content": "Be on your guard. I sense the presence of the Abyss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200503,
					"content": "It's the Abyss Order! They're here!",
