	"talks": [
		{
			"id": 7112703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112708",
							"2"
						],
						"stepId": 7112708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270301,
					"content": "Speaking of which, this should be your abode, right, Fujin? It feels a bit different from the other adeptal abodes we've been in... How should Paimon put it... it feels more... pragmatic?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270302,
					"content": "There are no weird mechanisms or transparent floating bridges...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270303,
					"content": "I am very sorry... I was just too embarrassed before, and so never explained clearly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270304,
					"content": "I cannot create new adeptal realms like the adepti of the south. \"Carp's Rest\" is no \"abode.\" At best, it's just a \"cave\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270305
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270305,
					"content": "Cave, realm, whatever! They're all \"abodes\" where adepti live, aren't they? Still, we don't even know when you can turn back into your human form...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270306,
					"content": "All the power she accumulated has dispersed across this land. She will be unable to revert to human form for some time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270307,
					"content": "I am the same way when I've exhausted my power. After Master died, the snow fell, melted, and then it fell once more after melting, and did so countless times before I could regain human form.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270308
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270308,
					"content": "Oh, so that's it... huh? Wait a sec, Lingyuan, you can turn into a person too!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270309,
					"content": "Why, of course! There is much you two know not! Why, back then, on Mt. Yaojun, Lingyuan's looks were—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270310
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270310,
					"content": "Fujin. No need to speak of such things. It has nothing to do with the present topic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270311,
					"content": "Eh? So, the whole thing about eating too many teacakes at the temple fair in human form, and crying to Herblord about brewing weight-loss tea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270312
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270312,
					"content": "Or the incident where you accidentally drank the celebratory libations and hauled forest boars in to ask them \"Who's prettier, me or Herblord?\"... Ah! But I needn't speak of such things after all, do I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270313
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270313,
					"content": "...Fujin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270314
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270314,
					"content": "Wow! After all that, Paimon's getting curious. What does your human form look like, Lingyuan? Would you be as blue as you are now? Or would you be... Uh, a slightly lighter shade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270315,
						711270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270315,
					"content": "Now I'm curious too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270316
					]
				},
				{
					"id": 711270316,
					"content": "I do not understand your curiosity. You are people too. If you are interested in human forms, just look at yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270321,
					"content": "#Hehe... Anyway, thank you, {NICKNAME} and Paimon. I never imagined the day would come when I would be able to talk to others like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270322
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270322,
					"content": "*cough*— As one has found oneself in such a joyous state of mind, one is willing to bestow protection upon you two for your journey, guaranteeing success and great fortune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270323
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270323,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270324,
					"content": "...Sorry, I got a bit carried away. I wanted to try being like those adepti, so I thought I'd try out a phrase or two...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270325
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270325,
					"content": "Anyway! I'll be staying here and praying for your journey to go smoothly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270317,
					"content": "Lingyuan, could you turn human, just for a second?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270318
					]
				},
				{
					"id": 711270318,
					"content": "I refuse. Human bodies are weak. They lack fangs to rend and rip prey, and claws to hound and hunt enemies. I would not do such a thing unless commanded to by Fujin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270319,
					"content": "...Eh? R—Really? I—In that case, I think maybe we should just respect Lingyuan's wishes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270320
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270320,
					"content": "I do not have any wishes. If you have some, tell me so directly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
