				]
			},
			"dialogs": [
				{
					"id": 711270501,
					"content": "#Huh? {NICKNAME}, Paimon, and Lingyuan... Why did you all come here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270502
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270502,
					"content": "Whoa, that's Fujin's voice! And it's... coming from down below?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270503,
						711270505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270503,
					"content": "I'm a little worried about you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "Yeah! We're all worried about your health, so we just came here without giving you a heads up — you did the same thing to us first, so Paimon thinks we're square now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270509,
					"content": "Huh? Ah! Sorry! When I returned here to rest, I think I forgot to unlock the entrance...! I am so sorry. You came here to see me, but I made things harder for you instead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270510,
					"content": "Oh, it wasn't much of a hassle! But why are you... uh, hiding in a puddle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270511,
					"content": "Hmm, how should I put it...? Because I can't return to the form I prefer yet, and with you guys always seeing me in my Carp form, I can't help but feel a bit... embarrassed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270512,
					"content": "You are aware that we've already seen it many, many times, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "Ahaha... But before, I could turn back into human form whenever I wanted, so I thought moving around as a Carp was just a matter of convenience. But now, all I have is this slick and slippery self, so I find it a bit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270515,
					"content": "Whoa, that's a bit of a strange thing to be so insistent about... But anyway, all that matters is that you're okay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270516,
					"content": "But Lingyuan said that your adeptal energy wasn't consumed, it was just dispersed around the mountains, forests, and rivers of Chenyu Vale, and that's why you've been weakened so much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270517,
					"content": "So if we were to collect the scattered adeptal energy, just like when we were finding the Golden Carp in Yaodie Valley, then you'd get better, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270518,
					"content": "Yes... At least, in theory, that's correct, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270519,
					"content": "Right, right? So if we see similar Carp, we should just bring them back here! That way, you'll recover much faster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270520,
					"content": "Th—That would be far too much trouble for you! My power is not yet that feeble. If I simply rest here for some time, it will be enough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270521,
					"content": "It's not that much of a hassle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "...We'll just keep our eyes peeled if we run into any.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "Thank you, then. However, I really don't want to trouble you anymore on my behalf. You've already done so much for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270524,
					"content": "If the two of you should happen to find any more adeptal energy during your travels, please simply transfer it into the jade here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270525
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270525,
					"content": "Though balance has been restored to the water and soil, if we can add more power to the Rainjade, we can ensure favorable weather and prosperous years to come.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270526,
					"content": "...And what about you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270527
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270527,
					"content": "Really now! I already told you, all I need to do is rest here for a bit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME}, Paimon, I really am quite grateful, and quite happy, that you came to visit me. This is the first time anyone has come here since Herblord left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270529,
					"content": "And thank you as well, Lingyuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270530,
					"content": "I have done nothing worthy of your thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270531
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270531,
					"content": "#Alright, enough of that! Then just think of it as me thanking you for bringing {NICKNAME} and Paimon here! Really, now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270532,
					"content": "#And lastly... Let me say thank you once more, {NICKNAME} and Paimon. For all you have done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270513,
					"content": "So there's no need to hide yourself, is there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270505,
					"content": "Lingyuan is a little worried about you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270506
					]
				},
				{
					"id": 711270506,
					"content": "I am not. I just...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270507
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270508
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270508,
					"content": "Yeah! Lingyuan's been so worried about your health that she can barely speak, so we just came here without giving you a heads up — but you did the same thing to us first, so Paimon thinks we're square now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7112709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112709",
							"2"
						],
						"stepId": 7112709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Mao",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270901,
					"content": "Bluey, Bluey, you didn't tell me the ending to that story you were telling me last time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270902
					],
					"speakerTitle": "Little Mao"
				},
				{
					"id": 711270902,
					"content": "Yes. I remember. However, I've changed my mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270903
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270903,
					"content": "\"Changed your mind\"? What's that supposed to mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270904
					],
					"speakerTitle": "Little Mao"
				},
				{
					"id": 711270904,
					"content": "I'll leave the ending of the story... to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270905
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270905,
					"content": "Ehhh!? C'mon, Bluey, that's cheating! You promised that you'd tell me a story if I told you one! How come I'm the one telling both stories now!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270906
					],
					"speakerTitle": "Little Mao"
				},
				{
					"id": 711270906,
					"content": "I'm just a simple-minded beast. I cannot think of a good ending.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270907
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270907,
					"content": "The ending I came up with was a bad ending. The story is also a bad story that wouldn't make anyone happy. So, I'll let you tell the ending of the story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270908
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270908,
					"content": "But that's still cheating!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270909
					],
					"speakerTitle": "Little Mao"
				},
				{
					"id": 711270909,
					"content": "I do not deny that. As compensation, I can take you to see the hidden sights of Mt. Lingmeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270910
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270911
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270911,
					"content": "Don't make that face. I will give you special permission to... Sit on my back, for five minutes or so. Ten minutes will do, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270912
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270912,
					"content": "In... In that case, then it's a deal! I'll think of an ending for the story...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Mao"
				}
			]
		},
		{
			"id": 7112710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112710",
							"2"
						],
						"stepId": 7112710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711271001,
					"content": "Huh? Lingyuan, is that you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271002,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271003
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271003,
					"content": "Ah, sorry! Are you hunting? Did we disturb you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271004,
					"content": "I was not hunting. You did not disturb me either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271005
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271005,
					"content": "Uh... Then were you just... spacing out? Like, thinking about tasty food and stuff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271006,
					"content": "I wasn't thinking about you either. I was just thinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271007
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271007,
					"content": "Thinking... Hang on, wait! What did you mean by that first part!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271008,
					"content": "#I am thinking about the question {NICKNAME} asked before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271009
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271009,
					"content": "\"If human activities are part of the laws of nature, how would you view humanity?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271010
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271010,
					"content": "It has been too long since I last had contact with the humans constituting the settlement — I have not been there since Fujin and the snake left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271011
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271011,
					"content": "Hey, you're making it sound like Little Mao doesn't count as a human!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271012,
					"content": "#Little Mao is a human that belongs to the settled humans, but is not a human who constitutes the settlement. You and {NICKNAME} \"constitute\" travel companions, but you do not \"belong\" to {NICKNAME}. That is the difference.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271013,
						711271015
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271013,
					"content": "You don't consider Little Mao a part of the social order?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271014
					]
				},
				{
					"id": 711271014,
					"content": "Not in full. Most human young are like this until they are completely absorbed by the order, just as it is in nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271017,
					"content": "It has been too long since I have been in contact with the humans who constitute the settlement. It could be because of hatred, fear, or maybe even both.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271018,
						711271019
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271018,
					"content": "Because they have encroached on the land that belongs to nature?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271020,
					"content": "I don't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271021
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271021,
					"content": "Or perhaps no obvious differences exist that separate \"us\" from \"them,\" but I cannot be sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271022
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271022,
					"content": "The young of the humans walk with me. Similarly, a youngling of our kin walks with a human out of curiosity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271023
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271023,
					"content": "Eh? A youngling of your kind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271024,
					"content": "That child encountered a mortal in the mountains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271025
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271025,
					"content": "So, I still cannot answer your question. I must continue to observe humanity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271026
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271026,
					"content": "There are many things I do not understand. I will try to understand until I can answer your question, as I promised to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271019,
					"content": "Because Fujin chose to sacrifice herself for them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271015,
					"content": "I wouldn't be too sure...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271016
					]
				},
				{
					"id": 711271016,
					"content": "Hey! Don't say weird things like that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "Paimon"
				}
			]
		},
