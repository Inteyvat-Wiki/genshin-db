					}
				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME} and Paimon. You're here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270402,
					"content": "Huh? Lingyuan? Why are you over here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270403,
					"content": "Because I can't get in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270404,
					"content": "Can't get in? Uh, where can't you get into?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270405,
					"content": "Carp's Rest. Where Fujin is resting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270406,
					"content": "Carp's Rest... Oh! You mean the place Fujin dragged us off to way back when?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270407,
					"content": "It is an abode sealed by her adeptal energy. I don't have her adeptal energy. Thus, I cannot go to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270408,
					"content": "Huh? But you didn't mention anything before she went back to rest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270409,
					"content": "It escaped my mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270410,
					"content": "Do you need help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "The adeptal energy you possess is sufficient to open the gate of Carp's Rest. So yes, I need your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270416,
					"content": "Huh? Wait a sec, so you've been waiting here for us this whole time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270417,
					"content": "I was not waiting for you. I was looking for a way into Carp's Rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270418,
					"content": "That seems like pretty much the same thing to... Uh, anyway, we're a bit worried about Fujin's condition too, so why don't we go see her together?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270419,
					"content": "Fine. Thank you both.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270420,
					"content": "Follow me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270412,
					"content": "Bit late now, Bluey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "Yeah, how could you forget something as important as that!? Really, now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270414,
					"content": "It is because I am a slow-witted beast. Seeing her, I think of many things, and forget many things. It is my fault.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270415,
					"content": "The adeptal energy you possess is sufficient to open the gate of Carp's Rest. So yes, I need your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
