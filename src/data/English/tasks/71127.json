			"dialogs": [
				{
					"id": 711271101,
					"content": "Listening to Mountain, it sounds like Fontaine's operas are pretty similar to ours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271102
					],
					"speakerTitle": "Little Mao"
				},
				{
					"id": 711271102,
					"content": "Knights, magicians, brave warriors, and evil dragons, you kill me, I kill you, and in the end, everyone's dead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271103
					],
					"speakerTitle": "Little Mao"
				},
				{
					"id": 711271103,
					"content": "What's important isn't the ending! It's the process — how you get there! Not every tragedy can be seen as a mere sequence of fight scenes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271104
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711271104,
					"content": "Oh, oh! And the \"Ray-more-young Golems\" Mountain was just talking about sound really, really cool too! I wonder if they're bigger than Bluey?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271105
					],
					"speakerTitle": "Little Mao"
				},
				{
					"id": 711271105,
					"content": "Eh? Bluey?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271106
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711271106,
					"content": "Oh, right! I never told you about Bluey, did I... How about this? You tell me more about \"Ray-more-young Golems,\" and I'll tell you about Bluey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Mao"
				}
			]
		},
