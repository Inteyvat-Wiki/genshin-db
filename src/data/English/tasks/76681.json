			"dialogs": [
				{
					"id": 766810401,
					"content": "Vital signs detected. Invoking identification sequence: <color=#FF5E41FF>ERROR</color>. Commencing kernel security check...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766810402
					],
					"speakerTitle": "Ancient Terminal"
				},
				{
					"id": 766810402,
					"content": "Kernel security check: <color=#FF5E41FF>FAILED</color>. Central module damaged or missing. Please contact Nin-Kiggia for maintenance. Initiating backup safety mode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766810403
					],
					"speakerTitle": "Ancient Terminal"
				},
				{
					"id": 766810403,
					"content": "My apologies. The identification sequence is currently unable to verify the visitor. Consequently, I cannot address you by your proper title. Commencing universal greeting playback.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766810404
					],
					"speakerTitle": "Ancient Terminal"
				},
				{
					"id": 766810404,
					"content": "Welcome to the Ia-I{RUBY#[S]No. 59}limmu Storage Array. This array is primarily used to regulate the operation of the Engraving and to store various research resources.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766810405
					],
					"speakerTitle": "Ancient Terminal"
				},
				{
					"id": 766810405,
					"content": "<color=#FF5E41FF>ERROR</color>: Critical component failure has resulted in service dependency anomalies. Main functions are currently unavailable. Please execute a self-diagnostic command to restore critical data nodes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766810406
					],
					"speakerTitle": "Ancient Terminal"
				},
				{
					"id": 766810406,
					"content": "Oh, Paimon didn't really get what it was saying, but it sounds like we just need to follow the instructions on the screen to fix this thing, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766810407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766810407,
					"content": "And if this place is for \"storing resources,\" that just means it's a \"storehouse\"! Paimon bets there are all kinds of super-amazing treasures nearby! Come on, let's give it a shot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
