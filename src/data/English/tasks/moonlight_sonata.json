			},
			"dialogs": [
				{
					"id": 760290101,
					"content": "Greetings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290102,
					"content": "Huh? Are you heading out, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Yes. I need to get a lyre repaired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290104,
					"content": "...What?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "One of the kuuhenki's lyres is broken. She greatly values this lyre, so I wish to have it restored.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290106,
					"content": "Man, kuuhenki sure are multi-talented...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Of course. This little one often performs around here, and I sometimes sing along.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290108,
					"content": "Y'know, Paimon's been thinking this for a while, but you sure do spoil the kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Well, it's only right. They have kept me company all this time, and often bring me amusing objects as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290110,
					"content": "(Lauma told me about this before — the natural instinct of kuuhenki to make the Moon Goddesses happy.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "If you don't mind Paimon asking, how do you plan to fix this lyre? Didn't you say you didn't want to be seen by others?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Hmm... In the past, small animals or kuuhenki would help deliver broken objects to an artisan's doorstep for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290113,
					"content": "All I had to do was wait for the artisan to find it. Of course, sometimes, that would take a few days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290114,
					"content": "Seems like a roundabout way of doing things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "Why don't you let us handle it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290117,
					"content": "Yeah, just leave it to us. Who knows, we might even be able to get this done today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290118,
					"content": "...Very well. Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290119,
					"content": "Our pleasure! By the way, what artisan do you usually bring your stuff to?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290120,
					"content": "I don't know her name, but there's a large mechanical hand by her door, and she lives in a round, conch-like home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290121,
					"content": "(Wait, she must mean...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "The aroma of krumkakes often wafts from within as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760290123,
					"content": "Yep, that clears it up for sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}