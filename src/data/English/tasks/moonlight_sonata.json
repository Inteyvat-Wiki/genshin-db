			},
			"dialogs": [
				{
					"id": 760290401,
					"content": "(Hmm? Music from a lyre? It seems Columbina is playing for the kuuhenki.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290402
					]
				},
				{
					"id": 760290402,
					"content": "(The last time we popped by, the lyre hadn't been repaired yet. That was well before Columbina got to know everyone...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290403
					]
				},
				{
					"id": 760290403,
					"content": "Not long ago...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7602905,
