	"talks": [
		{
			"id": 7418101,
			"completionStepIds": [
				7418102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418102",
							"2"
						],
						"stepId": 7418102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Melo Lombroso",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "What are you doing here? Madame Melo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810102,
					"content": "Oh, it's you. I heard that no-good husband of mine has a little spot around here, so I figured I'd drop by and check up on him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810103,
					"content": "But look what I've found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810104,
					"content": "He actually keeps the photo with him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810105,
					"content": "Heh, Uncle Rocher cares deeply about you, Madame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810106,
					"content": "We've had our suspicions on you, and Uncle Rocher was the sole voice of dissent. He alone assured us that you could never have committed the crime. We were wondering where he found the confidence to stand up to us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810107,
					"content": "Probably used up every last ounce of masculinity he had in him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "Oh... Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810109,
					"content": "Yeah! And didn't he tell you that he lost your locket in gambling? That's not true. He was merely too ashamed to tell the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810110,
					"content": "Oh, that? I heard that story a long time ago, but I never believed it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810111,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810112,
					"content": "My husband is many things. He may be timorous, somewhat cowardly, and a bit awkward, but he's also a salt-of-the-earth individual. He could be bamboozled, but he's no degenerate gambler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810113,
					"content": "I didn't call him out because I was waiting for him to tell me the truth of his own accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810114,
					"content": "Wow, how nice of you. If only we could find him right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810115,
					"content": "(Shush... Look over there! I'm 100% certain that he's hiding in that box.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810116,
					"content": "(...Huh?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810117,
					"content": "(It's an old habit of his. Whenever we'd get into a tiff, he'd go and hide in the nearest closet. And to think he thought I didn't know.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810118,
					"content": "(Do you want us to fetch him for you?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "(No need to inconvenience yourself. Let's see how long he can hold out in there.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810120,
					"content": "Right, there's one other thing I could use your help with. If you ever run into Curve and Agent Talochard, please tell them the following:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810121,
					"content": "I've tidied up a few of the rooms, so they're welcome here any time. Of course, the House of Lombroso is also open to the two of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810122,
					"content": "#But... {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810123,
					"content": "Alright, we get it, Madame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "Okay... then we'll get out of your hair. Paimon does hope Uncle Rocher will come out soon. Have a nice day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810125,
					"content": "Thank you. And best wishes to you, too. May you find the answers to all your questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Melo Lombroso"
				}
			]
		},
