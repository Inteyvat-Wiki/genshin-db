			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "How did I end up doing this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "Xiao Lanterns don't just vanish into thin air after each Lantern Rite, you know? They have to be recovered manually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210104,
					"content": "Sure, they are quite a view, floating majestically in the air, but at the same time, they can also be quite a nuisance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210105,
					"content": "If its lampshade is poorly made, a lantern will break mid-air, leaving only a chunk of Plaustrite that flies all over the place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210106,
					"content": "Some Xiao Lanterns also get blown away by the wind and end up stuck in random nooks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210107,
					"content": "The former creates safety concerns, while the latter litters the city landscape. So the Ministry of Civil Affairs usually delegates the responsibility of recovering Xiao Lanterns to a specific person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210108,
					"content": "As it happens, it's my turn this year...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210109,
					"content": "But the amount of Xiao Lanterns released during the festival is overwhelming... If I were to retrieve them all the day after the celebrations end, I'd be done for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210110,
					"content": "So the only feasible way is to remove the broken and misplaced lanterns gradually, as people release them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210111,
					"content": "Even so, I doubt I can collect them all on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210112,
					"content": "Traveler, would you mind checking a few spots for Xiao Lanterns that need to be recovered?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210113,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "I've marked the locations on the map for you. Thanks for your help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182102,
			"completionStepIds": [
				7182108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
