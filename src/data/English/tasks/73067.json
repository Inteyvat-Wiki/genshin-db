							"7306705",
							"2"
						],
						"stepId": 7306705,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306706",
							"2"
						],
						"stepId": 7306706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(The first few pages contain very small and scribbled writing...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670202,
					"content": "\"Ohhh... I can't believe there is a Nara willing to be Arashakun's friend. What a good Nara! The good Nara didn't mind timid Arashakun, and even taught Arashakun how to write Nara words...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670203,
					"content": "\"...Good Nara comforted Arashakun when Arashakun was frightened by a leaf that fell on his head. Good Nara is Arashakun's friend forever!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670204,
					"content": "(The handwriting becomes tinier and more flustered in the following pages...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670205,
					"content": "\"Oh no... Nara friend was taken by Furry Mask Demon King! It has such long arms. So scary...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670206,
					"content": "\"But... must save Nara... Ohh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670207,
					"content": "(The following pages are written in big, forceful handwriting...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670208,
					"content": "\"The Furry Mask Demon King has been defeated! Saved Nara friend, and Nara friend gave Arashakun 'courage'! Arashakun is not the same old timid Arashakun anymore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670209,
					"content": "\"Arashakun has 'courage' now and bravely fought the furry masked monsters. No Nara nearby will ever have to worry about getting bullied by the furry masked monsters again!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670210,
					"content": "(The handwriting shrinks back down in the latest pages...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670211,
					"content": "\"Oh no... How did this happen? Arashakun's 'courage' is missing... The 'courage' Nara gave to Arashakun... It must have been stolen by the Furry Mask Demon King.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Inconsistently-Written Notes"
				},
				{
					"id": 730670212,
					"content": "\"Furry Mask Demon King, arms very long, very scary. But Arashakun can do nothing after losing his 'courage'... Arashakun will go looking for it in <color=#00E1FFFF>the cave to the east</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inconsistently-Written Notes"
				}
			]
		},
		{
			"id": 7306703,
			"completionStepIds": [
				7306714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306714",
							"2"
						],
						"stepId": 7306714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670301,
					"content": "Uh, so, is \"Arashakun\" the Aranara who wrote all this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "The writing in this journal is big at times and real tiny at others. The big letters are fine, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "Gotta say, the small ones hurt Paimon's eyes a little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "Our little Paimon's having trouble reading those small letters?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Hey, Paimon reads letters in normal size just fine, thank you! Paimon's just not used to reading tiny letters, that's all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Hmm, did this Arashakun not return after writing these most recent pages...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Let's check out that cave in the east. The journal said that his courage is missing... Can \"courage\" really go missing? Paimon's curious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306704,
			"completionStepIds": [
				7306713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
