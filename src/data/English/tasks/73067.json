			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "Huh? These hilichurls dropped something strange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670102,
					"content": "It seems to be made out of flowers. Weird, but these flowers are ordinary and were picked quite some time ago, yet they still haven't wilted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670103,
					"content": "Paimon can sense quite a lot of Dendro energy on it, and it's been discarded here, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670104,
					"content": "It must belong to Aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "Yeah, must be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670108,
					"content": "Hmm, this flower thing has so much Dendro energy that it didn't even wither in the hands of the hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670109,
					"content": "Maybe they carried it with them all the time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "Yep, let's return this to the Aranara as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670112,
					"content": "#Let's go inside the house, {NICKNAME}. Maybe whoever lost it is super bummed out right now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670110,
					"content": "Maybe it's something very precious.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "It might be from a Dendro hilichurl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "What are you saying? It must be from an Aranara who lives here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306702,
			"completionStepIds": [
				7306705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
