						],
						"stepId": 7306708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arashakun",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "Yes, this is it, this is it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "This is the \"Talisman of Courage\"! The flower has faded a bit after being apart from Arashakun for a few days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "But it's okay! Arashakun will guard it well from now on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "\"Arashakun is a good Aranara with courage, not a timid Aranara!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#Thank you so much, Nara {NICKNAME} and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "Arashakun now has \"courage\" back. Nothing can stop me! I beat Furry Mask Demon King once before and I shall do it again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(Whoa, Arashakun's attitude and tone are completely different now.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#The Furry Mask Demon King has done a lot of evil things. Please come with me, Nara {NICKNAME} and Paimon. With your help, we'll defeat it for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
					"content": "Arashakun can feel it. Today... will be the day it meets its end!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670610,
					"content": "#Okay then, {NICKNAME}, let's go and see what on earth that Furry Mask Demon King is supposed to be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306707,
			"completionStepIds": [
				7306711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306711",
							"2"
						],
						"stepId": 7306711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arashakun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Paimon had her guesses... But as it turns out, the Furry Mask Demon King really was a hilichurl all along.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670702,
					"content": "A hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670703,
					"content": "Yes, the \"Furry Mask Demon King\" is actually a hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670704,
					"content": "Are all Hillychuchu \"Furry Mask Demon Kings\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670705,
					"content": "Uh, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670706,
					"content": "But that's all you need to know, Arashakun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Okay, Arashakun understands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670708,
					"content": "#Yes, with help from Nara {NICKNAME} and Paimon, Arashakun will lead the charge and be invincible! Even the devious Furry Mask Demon King will be no match!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670709,
					"content": "Arashakun shall mark today with a big entry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670710,
					"content": "A big entry...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "Yeah, a big entry in big writing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670712,
					"content": "Arashakun with \"courage\" and without sure feel like two completely different Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670713,
					"content": "Arashakun with no \"courage\" has weak arms and legs, but Arashakun with \"courage\" can do all sorts of amazing feats!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670714
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670714,
					"content": "\"Courage\" is not just the best gift from Nara friend, but also the most important thing to Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670715
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670715,
					"content": "Well, make sure you keep it safe and don't let the hilichurls steal it again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670716,
					"content": "Arashakun understands. Arashakun will never let \"courage\" go missing again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				}
			]
		}
	]
}