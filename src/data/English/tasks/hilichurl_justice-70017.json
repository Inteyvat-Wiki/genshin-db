						700170204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170204,
					"content": "Mi mito du, du ya mito Wei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170205
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700170205,
					"content": "And now it's pointing to the Map, saying that someone it knows over here may have seen the Unusual Hilichurl before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700170206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700170206,
					"content": "Valo, mimi tomo!",
