						750101612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101612,
					"content": "Still, it's kinda dangerous for this Alpaca to be out here completely on its own. We'd better go tell Wactana what's going on.",
					"roleType": "TALK_ROLE_NPC",
