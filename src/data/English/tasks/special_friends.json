					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101605,
					"content": "#Faced with {REALNAME[ID(2)|SHOWHOST(true)]}'s enthusiasm, the timid-looking Alpaca seems unafraid, instead bending down and gently touching {REALNAME[ID(2)|SHOWHOST(true)]} with its nose...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
