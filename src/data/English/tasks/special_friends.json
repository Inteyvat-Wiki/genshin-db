						750101613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101613,
					"content": "#Also, Paimon's sure she'll be happy to hear that {REALNAME[ID(2)|SHOWHOST(true)]}'s made a friend, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
