				"points": []
			},
			"dialogs": [
				{
					"id": 750100101,
					"content": "\"I have neither goals I must reach, nor have I urgent desires. I am a happy shepherd. I care only for alpacas, for the seasons and things that grow, for the cool breeze and rains...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100102
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100102,
					"content": "That's my favorite song. What do you think? Pretty good, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				}
			]
		},
