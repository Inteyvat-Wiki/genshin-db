			"dialogs": [
				{
					"id": 750101201,
					"content": "I see you're back, little fella. How did it go? Make any Alpaca friends?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101202
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101202,
					"content": "Rawr! Rawr rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101203,
					"content": "Haha, aren't you a happy camper? Why, you're even making me feel all jolly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101204
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101204,
					"content": "#Hey, Wactana, shouldn't you be a bit more concerned about what happens to the Alpacas? The one {REALNAME[ID(2)|SHOWHOST(true)]} made friends with was in a real tight spot back there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101205,
					"content": "That so? Guess I gotta talk to Half-Baked real quick then, tell it to take more care.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101206,
						750101208
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101206,
					"content": "You're way too chill about this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101207
					]
				},
				{
					"id": 750101207,
					"content": "I mean, I am living the dream! C'mon, be happy for me and stuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101211,
					"content": "#Ah, yes. If {REALNAME[ID(2)|SHOWHOST(true)]}'s fond of the Alpaca toy over by the side, I can let y'all have it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101212
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101212,
					"content": "Rawwr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101213,
					"content": "#Guess {REALNAME[ID(2)|SHOWHOST(true)]} doesn't know what \"standing on ceremony\" is, huh. Thanks then, Wactana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101214,
					"content": "Eh, no biggie. And if you wanna drop by again, you're always welcome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101208,
					"content": "Half-Baked has it rough, huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101209
					]
				},
				{
					"id": 750101209,
					"content": "Sure... But he was always a massive worrywart. If I took him off Alpaca guard, he'd start losing fur from stress, I tell you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101210
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101210,
					"content": "So this arrangement's best. Job satisfaction for him, free-and-easy living for me. Win-win, wouldn't you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				}
			]
		},
