						750101608,
						750101610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101608,
					"content": "#A friend of yours, {REALNAME[ID(2)|SHOWHOST(true)]}, is a friend of mine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101609
					]
				},
				{
					"id": 750101609,
					"content": "And Paimon's too... Wait, when did this become a competition?",
