			"dialogs": [
				{
					"id": 765040701,
					"content": "#Hello, {NICKNAME}, Paimon. Have you eaten? Do you have any special plans today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040702,
					"content": "We're just looking around.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Understood. Walking around and capturing what you see in the frame is a reasonable way to relax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040705,
					"content": "However, I do not detect a Kamera on your person. Did you leave it somewhere in your hurry to leave home?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040703,
					"content": "And looking for some photo-op material while we're at it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				}
			]
		},
