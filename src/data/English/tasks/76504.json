					"Ineffa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#Greetings, {NICKNAME}, Paimon. Have you eaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "Ineffa? What're you doing up here on the roof? Are you... observing cloud shapes to calculate the probability of rain... or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "I am performing a task that is experiencing an... unexpected deviation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "The original plan was to purchase a \"high-precision gear\" and \"special hexagonal screw\" as stipulated in Aino's list.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "However, I encountered an... unforeseeable supply interdiction incident during the return trip. A falcon, flying at high speed, snatched the specially-made screw from my hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "So you came up to the roof to look for that falcon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "Affirmative. This species' habits indicate a propensity to use rooftops as temporary stopping points. Response: Comprehensive visual and audio scan. Objective: locate the target.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "However, I have not found any traces of my target thus far. Initial deduction: Target has escaped detection radius, or may have brought its \"prize\" to a more secluded nest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Commencing backup plan: Return to designated supplier and purchase a new screw of the same model.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "Anyway. Are you two also here in pursuit of some small animal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "Oh, no, not at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Yeah. We originally wanted to find a spot with a good view so we could snag some panoramic shots of Nasha Town in all its hustling, bustling glory!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "We didn't expect to run into you while you were on the hunt for a \"thief.\" Guess that's a super-rare \"unexpected deviation\" too, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "And since the opportunity's presented itself...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "Yes. Please indicate preferred standing position, facing, and recommended facial expression. I will do my best to comply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "Estimation: The odds of my coming to the roof, meeting you, and having my picture taken by you are even lower than that of the falcon returning me the screw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "So please, be sure to accurately capture this rare \"pleasant surprise.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "Could we take a picture of you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "We're just looking for some photo-op material.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
