			"dialogs": [
				{
					"id": 760810101,
					"content": "I've heard that the legendary Starshyna, Sigurd, wielded a longsword, and his monster-slaying prowess was one of a kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810102,
					"content": "He vanished in the wake of a great battle, and so this empty grave was built in his honor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810103,
					"content": "A purple blade and golden hair... He must be the wandering warrior who clashes with the Wild Hunt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810104,
					"content": "It seems his spirit has not been able to find rest in his grave, just like the many spirits in the Final Night Cemetery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810105,
					"content": "Raising his sword against the Hunt, the hero's spirit remains unwavering, even after death.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810106,
					"content": "...Sir Sigurd, you are a man worthy of my respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810107,
					"content": "Yet, to fight in solitude for naught but hatred and one's sense of duty is far too cruel a fate for a warrior such as you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810108,
					"content": "Do you miss the days you shared drinks and songs with your fellow Lightkeepers, Sigurd? Have you any reason to wield your blade now, save a hunger to slaughter your foes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810109,
					"content": "If so, then show yourself. Let us spar, just like old times, just as it was in your days as a Lightkeeper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608102,
