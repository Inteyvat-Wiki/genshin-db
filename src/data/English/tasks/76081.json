					}
				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Well fought, Mr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "Rest assured. After you and your comrades fell, my father Nikita took up the mantle of Starshyna and led the people you saved to rebuild the order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Today, we are strong enough to protect this land even under the shadow of the Wild Hunt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Your sacrifice was not made in vain. Your deeds and your will shall live on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Farewell, Mr. Sigurd. I'll visit you from time to time. May you find your peace at last.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608199,
