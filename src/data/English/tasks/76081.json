				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "The way he vanquishes monsters... No, that figure of legend has long since given his life in the line of duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "Could he have awakened again, somehow? Hmm... If you have a moment, go to the beach to the northeast of the Barrowmoss Barrens. That's where his grave is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "The old man once told me stories of the legendary Starshyna Sigurd, the one he fought beside years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "The violet blade, the golden hair... he's exactly as the tales described. The person I've seen these past days... could that really be him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "His resting place lies on the beach northeast of the Barrowmoss Barrens. If I have the time, I should go there for a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}