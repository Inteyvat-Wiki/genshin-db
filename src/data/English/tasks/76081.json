							9077.054
						],
						"pointId": 13645
					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "Mr. Sigurd, I owe you my life. If you hadn't led the Lightkeepers south to hold the line back then, I might have died without even knowing how, and my body would be nowhere to be found...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810302,
					"content": "But why has your spirit not found rest? Why are you still wandering, still fighting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810303,
					"content": "Tainted by the Wild Hunt's corruption, with your very form shattered... It seems you never truly left that battlefield, did you? For you, the war has never ended.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810304,
					"content": "In that sense, perhaps I'm not so different from you. None of us will find true peace until the Wild Hunt is gone for good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810305,
					"content": "It's an honor to meet you, Mr. Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810306,
					"content": "I understand now. For a Lightkeeper, the best form of communication is done with blades in hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810307,
					"content": "Then allow me to show you the strength of the new generation of Lightkeepers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608104,
