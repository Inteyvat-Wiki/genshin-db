						],
						"pointId": 13989
					}
				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "That was an excellent battle, Sir Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Regrettable that this should be a hero's end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "To wander alone in the land you sacrificed your life for... Did you see this day coming when you first answered the Lightkeepers' oath?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Perhaps you did, and yet did not hesitate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "I will visit you again in the future. Farewell, Sir Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608103,
			"completionStepIds": [
				7608102
			],
