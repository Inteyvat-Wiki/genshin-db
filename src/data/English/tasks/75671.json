			"dialogs": [
				{
					"id": 756710101,
					"content": "Chirp chirp! Coo coo! Chirp chirp chirp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710102,
					"content": "Um... what's going on here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710103,
					"content": "Are you sending... some kind of secret message?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "Sort of! This is a technique I use to communicate with the cute little finches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710106,
					"content": "Oh, I seem to have forgotten to say hello to you folks. And the all-important opening line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710107,
					"content": "Kind Travelers passing through, I, Basima the Fifth, Amurta researcher, rising mercantile star, and expert on adorable animals, offer my heartfelt greetings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710108,
					"content": "Please. Relax thy body, clear thy mind, and listen closely, for I have a matter of utmost importance to share with you—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710109,
					"content": "\"Finches are the cutest\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710110,
					"content": "You're absolutely correct! Congratulations, looks like the Finch's cuteness got to you too. You're even jumping to answer right away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710111,
					"content": "This is odd. Paimon's not sure why, but when she saw the game on the table, this line just popped into her head.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710112,
					"content": "#Does this feel familiar to you too, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710113,
					"content": "We've met this lady before, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "You're right! And it wasn't just a brief encounter either. It warms my heart to see you both still so full of life!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710117,
					"content": "Anyway, would you like to try this game? This is version 17 from the third generation of \"Bing-Bang Finchball!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710118,
					"content": "As you unwind and enjoy the game, you'll also get to hear wonderful stories of how the little finch, alongside the much, much bigger Ancient Scarlet-Plume Finch, triumphed over the gulls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710119,
					"content": "Sounds awesome! We've always been huge fans of relaxing games!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710120,
					"content": "Let's play right now!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "Alright! I hope you find the way of playing that suits you best and enjoy a one-of-a-kind experience!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710121,
					"content": "Game start! Game start!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "We can start the \"finches are the cutest\" thing now, if you want.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "You got it! And even if you can't remember the past right now, that's fine. What matters is that you enjoy the present...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima the Fifth"
				},
				{
					"id": 756710104,
					"content": "Or speaking in some kind of... code?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}