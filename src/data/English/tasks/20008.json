				"points": []
			},
			"dialogs": [
				{
					"id": 200080101,
					"content": "Thank you! You saved my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Those slimes came out of nowhere. I didn't think they would show up around these parts... Before I knew what was happening, I was surrounded!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "Please don't tell my father... He's already been nagging me to stay at home, saying the slimes 'round here are supposed to be getting more hostile recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "With slimes appearing closer to the city, I've been stuck at home for days now. I managed to slip out today without him noticing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "If you don't mind, could you check if the coast is clear now? And if not, get rid of the slimes for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "Sure, it won't take me long.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Great! Looks like my father will never have to find out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "Sorry, I've got too much on my plate right now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "B—But... I cannot get my father involved... Please, you're the only one who can help me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				}
			]
		}
	]
