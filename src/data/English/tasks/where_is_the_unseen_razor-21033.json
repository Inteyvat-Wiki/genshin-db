					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "I have an idea that may or may not pay dividends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330102,
					"content": "Are you still looking for that sword of yours?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "Oh, it's you, Traveler. Indeed, I am still seeking the Unseen Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330104,
					"content": "But, even now, I have yet to find any worthwhile leads.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330105,
					"content": "Searching for a sword in Liyue is like trying to find a straw from a haystack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330106,
					"content": "Someone said to me that the sword may have been destroyed long ago by a monster. But even if it were so, I would find and claim each and every last shard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330107,
					"content": "Apologies. I've been rambling. The location I need you to check this time has been marked on your map. I thank you for your aid, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330108,
					"content": "I just hope the sword isn't really broken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
