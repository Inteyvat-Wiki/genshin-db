			"dialogs": [
				{
					"id": 210330401,
					"content": "How did it go, Traveler? Have you found something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330402,
					"content": "I found this sword hilt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2103306,
			"completionStepIds": [
				2103306
