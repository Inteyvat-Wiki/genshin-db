			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210330403,
					"content": "This sword hilt... looks still intact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330404,
					"content": "Does it have anything to do with the Unseen Razor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "I must examine it in detail to know... Ah. I forgot to mention that I've already been scouring the lands for these weapon fragments for quite some time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330406,
					"content": "I gathered countless pieces from the marketplace, the wilds, and even bought some off adventurers. I thought that they could perhaps lead me to the Unseen Razor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330407,
					"content": "Yet, till now, I haven't found even a hint of its shadow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330408,
					"content": "Ah, no matter. We have a saying in Liyue: \"Where there's a will, there's a way.\" I'll keep searching... Till I find the Unseen Razor, that is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330409,
					"content": "Here, Traveler. Take these as a reward for your efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
