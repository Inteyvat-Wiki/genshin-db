			},
			"dialogs": [
				{
					"id": 4870101,
					"content": "...So, yours is the cat that went missing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870102,
					"content": "Venti! Have you come to help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870103,
					"content": "Me, here to help you? Why, on the contrary, it is I who needs helping!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "But Paimon just saw you talking to Margaret about Prince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "Aha! So, Prince is the name of the feline fiend who thieved my spare <color=#00E1FFFF>astral iron strings</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Though it gladdens my heart to see that the free-spirited ethos of Mondstadt is alive and well in creatures great and small... Still, it's a bit audacious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870107,
					"content": "Haha, Prince is a mischievous little rascal alright!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870108,
					"content": "Spoken just like a parent who chooses to spoil said rascal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870109,
					"content": "Indeed. Just like Barbatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Ahaha, yes, quite... quite... Ahem! Now, let's see about getting ourselves an audience with his little highness, Prince Rascal of Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "I have a performance tonight, and without my spare strings, I shall have to disappoint my audience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "What would a kitty cat want with lyre strings anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "Everyone knows cats go crazy for a ball of string!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "What!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "These lyre strings are made of astral iron, which contains Anemo energy. That makes them extremely durable, so I normally just roll them up in a ball to make them easier to carry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "That's a trick of the trade from a traveling bard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "The strings contain Anemo energy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#That'll help us! {NICKNAME}, it's time for you to use your <color=#00E1FFFF>Elemental Sight</color> again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "Paimon's sure there must be some elemental footprints or something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870122,
					"content": "Thank you all. Prince should be somewhere around the marketplace or the residential area. It's a black cat you're looking for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "Oh— Take this <color=#00E1FFFF>fish</color>, it's little Prince's favorite food. Maybe it will help you find him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		}
