				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870501,
					"content": "Wow, Prince has very keen senses. It didn't take much to scare him off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870502,
					"content": "See if you can approach him crouching <color=#00E1FFFF>from behind</color>. That way, your footsteps will be quieter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870503,
					"content": "It must be difficult not being able to float, hee-hee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870504,
					"content": "If you're anxious to find Prince, why not coax him to you with some <color=#00E1FFFF>Fish</color>? Kitty cats do love eating fish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870505,
					"content": "If you've run out of <color=#00E1FFFF>Fish</color>, go grab some more from the lake. Now, back to it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
