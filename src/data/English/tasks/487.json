			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870301,
					"content": "Prince! Where did you go running off to? Thank goodness you're safe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870302,
					"content": "He made sure we had our work cut out for us looking for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870303,
					"content": "Oh Princey, how could you leave me like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870304,
					"content": "Looks like those two need some time to themselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870305,
					"content": "And here are your astral iron strings, Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870306,
					"content": "You found them! Wonderful! I was not optimistic they would turn up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870307,
					"content": "I daresay that a private performance played using these very same strings would not be an excessive way to show my gratitude! ...Ah, ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870308,
					"content": "Ah what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870309,
					"content": "ACHOO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870310,
					"content": "*cough* Haha... Apologies. At this distance, my cat allergy seems to be rearing its head...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870311,
					"content": "Oh, now Paimon gets why you didn't go looking for your strings by yourself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870312,
					"content": "Hehe, anyway, thanks for the help, I'll be going now— a—achoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
