					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112510",
							"2"
						],
						"stepId": 4112510,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112511",
							"2"
						],
						"stepId": 4112511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Reckless Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250201,
					"content": "Well, looks like I've shaken them off for now. Still, what on earth is going on here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250202,
					"content": "Did you come to investigate the meteorites?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Yes, I did. Took a commission from the Guild and all to investigate matters related to the meteorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250204,
					"content": "But monsters near the spots where meteorites have landed have starting acting up all of a sudden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250205,
					"content": "Their strength, movements, and a whole host of other things are totally abnormal, and there's more of them than you usually see, as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250206,
					"content": "I was discovered, and didn't dare stay in the area, and so I took a few lesser-tread paths to shake them off my trail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250207,
					"content": "I have to report these abnormalities to Cyrus as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250208,
					"content": "Is there anything else of note?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Anything else? Well, if I had to say it, it's that quite a few scholars are refusing to return to the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250210,
					"content": "No matter how hard I tried to convince them, they insisted on continuing their research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250211,
					"content": "There aren't enough of us adventurers out here either, so we can't simply send them reminders every few days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250212,
					"content": "This is such a headache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 411250213,
					"content": "Well, Traveler, if there's nothing else, you should be seeking shelter in the city too. We haven't the time to be dallying out here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Reckless Pallad"
				}
			]
