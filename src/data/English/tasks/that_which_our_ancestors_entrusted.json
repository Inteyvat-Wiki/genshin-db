				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "A breeze from the south blew across Watatsumi Island today — a sure sign that friends would come visit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610102,
					"content": "Every time you say something like this, that means things are about to get busy... for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610103,
					"content": "Oh, don't say that. Haven't we had a fruitful partnership? The most fruitful sort, in fact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610104,
					"content": "That said, I do have something to ask of the two of you today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610105,
					"content": "It is told in my family that apart from the Watatsumi Goryou Matsuri, we also added a different set of trials. One unrelated to Watatsumi Island's survival, but instead, related to the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610106,
					"content": "Another... set of trials?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610107,
					"content": "Now that the island is no longer under existential threat, I would just like to tell you this. Consider it our clan's duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610108,
					"content": "You can go to the place they call the Serpent's Heart. The clues to this second set of trials is hidden there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610109,
					"content": "...Well, that's a relief! Guess I can safely hand this crushing responsibility on to my future daughter now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610110,
					"content": "...Is that how you pay respect to your ancestral mission?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610111,
					"content": "Paimon still doesn't get you even after all this time, Tsuyuko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}