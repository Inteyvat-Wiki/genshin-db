			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "There's a diary here, and it looks really well preserved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790510102,
					"content": "Whew... now that's a relief!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790510103,
					"content": "He untangled the knot in his heart, and improved his painting skills! Paimon thinks he'll definitely be really successful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790510104,
					"content": "Though he left his Water Droplet friends behind, which sounds a bit sad to Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790510105,
					"content": "Not all artists can accept imitations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Hmm, Paimon can understand that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790510108,
					"content": "There's still something that confuses Paimon. He mentioned in the diary that the mural can lose its shape and shift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790510109,
					"content": "But even after such a serious accident... the mural seems alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790510110,
					"content": "It's these Water Droplets.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "Ooh, that's right! No wonder the Water Droplets are so familiar with the Streaming Projector and restoring the mural...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790510113,
					"content": "It's so moving... Water Droplets may not look that bright, but they are really considerate and loyal friends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Read"
				},
				{
					"id": 790510111,
					"content": "They protected their friend's mural.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Insisting on one's own uniqueness makes sense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
