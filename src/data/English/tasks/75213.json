				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752130201,
					"content": "Anything I can help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "Hmm? You want to help? Well, if you insist... We've already dispatched all our staff, but we've still got an urgent delivery order that needs completing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "There's a note on the order for it to be sent to <color=#00E1FFFF>a guest with blue pants on the beach</color>. All's well as long as it gets there in time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "But seriously, thank you for your help. In addition to the delivery fee, I'll also throw in our drink recipe as compensation for your help. I'm counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
