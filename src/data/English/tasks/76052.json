				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520102,
					"content": "Columbina, are you okay? You look a bit out of sorts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Oh, it's you two. I'm alright...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520104,
					"content": "(Is she thinking about the moon again...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Is there anything we can do to help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520108,
					"content": "It's okay! Just tell us! Even if it's something small, you'll feel much better once it's off your chest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "I... would like to try a drink from the tavern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520110,
					"content": "...What!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "...*sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520112,
					"content": "Sorry... Paimon was just a little surprised. You never talk about wanting things for yourself, so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "And, that's it? Just... a drink?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "What, were you expecting her to think bigger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Yeah, kinda. At least something a bit more monumental... Like, \"Bring me the moon.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "But, on second thought, it does kinda make sense. Columbina can't go wherever she wants right now, so a trip to the tavern might as well be a trip to the moon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "It's not just how things are now. Even back when I was with the Fatui, when there was no order to capture me... everyone still kept their distance whenever I went out for a walk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520118,
					"content": "(Third of the Fatui Harbingers... That title alone is enough to scare off people who don't know her.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Wait a sec, come to think of it... Maybe this isn't as hard as Paimon first thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#A tavern is kind of out of the question, but a drink... Now, that we can do! {NICKNAME}'s got this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "...Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520122,
					"content": "Uh, but don't set your expectations too high...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "Any flavor preferences?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Flavor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520125,
					"content": "I don't have much experience ordering drinks, so I'm not sure where to start...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520126,
					"content": "Perhaps something that isn't too... heavy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520127,
					"content": "Umm, what do you mean by \"heavy\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "Heavy like... a Fatui overcoat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520129,
					"content": "That comparison makes it even more confusing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "Something light and delicate, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "Okay. Whatever you think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520131,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
			"completionStepIds": [
				7605203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
