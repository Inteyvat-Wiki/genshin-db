					}
				]
			},
			"dialogs": [
				{
					"id": 760520401,
					"content": "Hm, I've smelled something like this before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520402,
					"content": "Oh, really? Where?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "In Sandrone's room. She had a drink that smelled like this. The aroma caught my interest, and when she noticed... she just held on to the drink for ages without finishing it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520404,
					"content": "It was like... she was waiting for me to ask about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520405,
					"content": "So... did you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520407,
					"content": "What did you ask?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "Shouldn't you be drinking engine oil instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520409,
					"content": "And... how did she respond?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520411,
					"content": "She said something quite unpleasant. It doesn't bear repeating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520413,
					"content": "You lost interest after a single sip!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
					"content": "Sorry, it was a little bitter... all in all, not very good. No wonder Sandrone looked so sour when she drank it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760520415,
					"content": "Paimon thinks there might've been other reasons for that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
