			},
			"dialogs": [
				{
					"id": 221030201,
					"content": "Is it done?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030202,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "Time is of the essence here. The young gentleman tends to show up without warning and disappear without a trace. There's no telling when he'll be here next.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030204,
					"content": "And in the event he does show up, that'll be us out of business for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 2210303,
