			},
			"dialogs": [
				{
					"id": 221030301,
					"content": "Is it done?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030302,
					"content": "Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "Wonderful! Well, that's a load off my mind. Business as usual once again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030304,
					"content": "Here. Your compensation, as agreed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030305,
					"content": "Hmm? Oh, the young gentleman? I would have thought you'd seen him around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030306,
					"content": "Perhaps you've noticed him resting on the roof of the inn? He does that occasionally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030307,
					"content": "But if you do notice him, try not to disturb him. He prefers to be left alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		}
	]
