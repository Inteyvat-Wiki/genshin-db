				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221030101,
					"content": "What a colossal nuisance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "Oh, is that one of our guests? My apologies, things have been awfully unusual around here lately...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030104,
					"content": "Our guests keep getting attacked by monsters nearby. Naturally, many are now less inclined to stay here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030105,
					"content": "If this pattern continues, things will eventually escalate out of control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030106,
					"content": "Judging by your attire, you are a traveler, correct? Would you mind taking care of this on the inn's behalf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030107,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "Thank you. You're very kind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030113,
					"content": "So it's better that you deal with it instead. I will be sure to arrange adequate compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030108,
					"content": "How dangerous are the monsters?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "Not very. In fact, they are the lesser of my concerns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030111,
					"content": "The bigger issue is... if any of them was unfortunate enough to run into a certain young gentleman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030112,
					"content": "His method of dealing with monsters tends not to consider the best interests of the surrounding area or the people in it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 2210302,
