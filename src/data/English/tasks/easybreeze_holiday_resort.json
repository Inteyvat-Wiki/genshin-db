			"dialogs": [
				{
					"id": 752420401,
					"content": "Hello, and welcome to the Easybreeze Holiday Resort! I'll get you all checked into your accommodations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420402
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420402,
					"content": "Please take this map, along with a special commemorative photo album we've prepared for our guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420403
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420403,
					"content": "The resort is made up of four main areas: Colorfall Cliffs, Guiztli Ridge, Wavey Bay, and Tete Isle. Feel free to explore them at your leisure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420404
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420404,
					"content": "Well, your accommodations are in that direction. Feel free to head there if you need some rest. And, if you're looking to do some shopping, the Easybreeze Market — our busiest attraction — is right over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ukucha"
				}
			]
		}
