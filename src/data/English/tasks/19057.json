				"objectNames": [
					"Etsu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "I apologize for earlier, I don't know what came over me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "Oh, Detective Heizou? He can't stand people like me, I'm sure of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Although he sounds polite and friendly, I can tell that he treats inmates convicted of fraud differently... He's really got something against us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "Do you think he may have been defrauded himself before? Impossible, who could ever be cunning enough to fool Detective Heizou like that, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
