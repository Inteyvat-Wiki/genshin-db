			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "Getting on the wrong side of Heizou really was a mistake...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570902,
					"content": "Eh? You two want to know what happened? There's not much to it, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570903,
					"content": "As soon as I heard that Heizou was on the case, I knew it was over. I took the easy way out and confessed to everything. After all, what else can you do when a \"Cyclone\" is heading your way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570904,
					"content": "\"Cyclone\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "Heizou's nickname. It's what all the prisoners call him, haven't you heard it before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570906,
					"content": "There's nowhere to run, nowhere to hide... For criminals, Heizou is a force of nature nobody can contend with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570907,
					"content": "Alas, if only I'd known...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iba"
				}
			]
		}
	]
