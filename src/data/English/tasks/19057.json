			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kano Nana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "Hello there, Traveler. I must apologize for my cousin — he must have been causing you all kinds of trouble? He's always been quite a handful... but I promise he doesn't mean any harm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Kano Nana"
				},
				{
					"id": 190570802,
					"content": "If he goes too far, please by all means put him in his place. And if he dares protest, just tell him he either does as he's told or he'll have me to answer to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kano Nana"
				}
			]
		},
		{
			"id": 1905709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
