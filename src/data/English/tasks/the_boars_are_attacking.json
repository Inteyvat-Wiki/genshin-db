			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "Is there anything I can do to help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "You are...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680203,
					"content": "...Ah, travelers. How kind of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680204,
					"content": "Now is the ripening season for grapes. But a herd of boars came out of nowhere and they have their eyes set on the vineyard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680205,
					"content": "I can't chase them away by myself and my son is not with me now, so all I can do now is to watch them wreck my land...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680206,
					"content": "If you can help me kick those boars out, I'll repay you handsomely!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
