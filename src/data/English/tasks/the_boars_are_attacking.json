				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "Hello. Do you have any message from my son?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680601,
					"content": "And you are...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "Me? Pals in the winery call me Old Tunner. I'm a farmer here at the Dawn Winery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680603,
					"content": "My family has been farming here for generations. Most of the good wines you've had were probably fermented using the grapes here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680604,
					"content": "Every owner of the winery has been treating our family very generously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680605,
					"content": "But I don't think it's a good thing for my son to inherit this land and become a farmer for his whole life...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680701,
					"content": "Your son?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "Guy! His name is Guy, my beloved son!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680703,
					"content": "What? You've never heard of him? Hahaha, that's fine. Sooner or later, you'll know him. The whole Mondstadt will know him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680704,
					"content": "My son, Guy, told me he was going to be the strongest Knight of Favonius! I believe in him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680705,
					"content": "I spent all my hard-earned money for his sake, to give him a better future than mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680706,
					"content": "Guy is determined to fulfill his dream! He became a squire at 16, so our household has been relying on him since.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680801,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "Goodbye! If you meet my son, please tell him to come home once in a while!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
