			},
			"dialogs": [
				{
					"id": 4680301,
					"content": "I've got something else to do...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "Well then, guess I can only wait until my son's back to punish those boars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
