					"nextDialogs": [
						730560502
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560502,
					"content": "Haha, Mawtiyima you old pal! Still active, aren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560503
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560503,
					"content": "Wow, Mr. Khayyam seems to get younger all of a sudden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560504,
					"content": "And Paimon seems to know what to say all of a sudden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "Hey! What's that supposed to mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560508,
					"content": "Hmm... These should be enough. Thanks for coming all the way here with me. Since we have done everything planned, we should go now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560509,
					"content": "Haha, this is excellent... These samples might really help my research on the secrets and weaknesses of The Withering...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560510,
					"content": "Thanks for your hard work, let us take the same route back... I have something for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560511,
					"content": "Yay! Rewards!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560512,
					"content": "Hehe, it could be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560506,
					"content": "Yay!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "Paimon's not sure what you mean, but yay!",
