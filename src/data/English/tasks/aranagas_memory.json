					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560301,
					"content": "Interesting... The plants here seem to be... reviving. So Mawtiyima is back in effect... Magical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560302,
					"content": "Eh... So Mr. Khayyam knows about Mawtiyima, too? Paimon thought only Aranara know that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560303,
					"content": "Paimon, shush!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "Aranara, right? So you have also seen them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560306,
					"content": "Huh...? Um... Y—Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560307,
					"content": "What's the matter, Mr. Khayyam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "\"Iram indeed is gone with all its Rose, and Jamshyd's Sev'n-ring'd Cup where no one Knows.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560310,
					"content": "We should proceed to the next site.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560308,
					"content": "Have you seen Aranara, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "Paimon...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
			"id": 7305604,
