			"dialogs": [
				{
					"id": 730560801,
					"content": "The plants here are growing pretty nicely...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560802,
						730560804
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560802,
					"content": "About the plants...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560803
					]
				},
				{
					"id": 730560803,
					"content": "I never thought soil that had been tainted by Marana could ever provide nourishment for plants again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560804,
					"content": "About those \"imaginary friends\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560805
					]
				},
				{
					"id": 730560805,
					"content": "Dismissing the unique lifeforms that kids call Aranara as \"imaginary friends\" is undoubtedly incorrect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560806
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560806,
					"content": "Since the Akademiya sensors couldn't detect them either, only young kids could prove that they exist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560807
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560807,
					"content": "Hence, Amu{RUBY#[S]Biology}rta has classified them as \"unidentified lifeforms.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				}
			]
		}
