			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Ha! Here! Look at this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560402,
					"content": "Eh? New plant? Why are you so excited?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "No, not that, but even better! Look at it, our secret castle! Ha! What a mess it is now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560404,
					"content": "Eh...? \"Secret castle\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "Haha! Here returns Scholar Omar! He came with the celestial secrets! Irfan, Siman, where are you! Aren't you bidding a welcome to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "Ah... Ahem, my apologies, children. I... I was carried away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560409,
					"content": "Old age always does this to me, blurring the present, and endearing the past, more and more... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560410,
					"content": "Irfan and Siman, they are friends of mine. We built the castle together, the three of us together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560411,
					"content": "Back then, Irfan was the great musician, Siman was the supreme commander, and I was the astrology scholar. We switched our roles sometimes, you know... Children would play something different after getting bored.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560412,
					"content": "Irfan was talented in music; Siman was tall and strong, beyond comparison; and me? Haha, I was just an avid reader born in a family with a little extra Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560413,
					"content": "Is this where you played house in childhood?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "No, this is our secret world — I'm serious about it. We made a promise together, saying that we will never forget each other, and will lead the Reconquest Army to take back the castle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560418,
					"content": "Hehe, 20 years have passed, and they might have forgotten our promise... It became my own research campsite in the forest, which was kept in operation till 30 years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560419,
					"content": "After that, even Marana had come, but the Reconquest Army never showed up. Hehe, that's understandable... How could those childish promises stand up against death itself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560420,
					"content": "But... Since you still remember them, they must be doing the same! Please don't lose your heart, Mr. Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "Lose heart? No way. The childhood memories, shared \"imaginary friends,\" and the world closed to adults. It may be a pity, but... Time won't reverse itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560422,
					"content": "\"Imaginary friends\"... Do you mean Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "Paimon, shush!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560426,
					"content": "Haha... I almost forgot, I asked you to help me sample these newly-grown plants, not for chit-chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560427,
					"content": "Please forgive this old man for talking too much nonsense. Let's continue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560424,
					"content": "You talk too much, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Did you and your friends make all this...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "No, not all of these. We promised that we will lead the Reconquest Army to take back the castle... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560417,
					"content": "I grew up to be a botanical researcher in the Akademiya, and I happened to return here for some reconstruction. I visited multiple times, bringing and taking away plenty of rubbish here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
