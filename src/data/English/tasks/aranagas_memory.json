			"dialogs": [
				{
					"id": 730560601,
					"content": "Thank you both, Javans. It must've been hard, traveling with this old man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560602,
					"content": "Right, if you don't mind... This is hardly anything precious, but take it as a souvenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560603,
					"content": "Wow... What is it? What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560604,
					"content": "You should have seen it before, this little dried flower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560605,
					"content": "Ehhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560606,
					"content": "This is...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "Yes. If I'm right... They must have gifted you the same thing, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560609,
					"content": "Hehe... I knew it, our encounter is by no means coincidental... I never believe in chances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560610,
					"content": "I'm trusting this flower with you. Please, take it to our friends in common.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560611,
					"content": "Sure, we can do that, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560612,
					"content": "They might have forgotten me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560615
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560615,
					"content": "I can't see them, either... I can't even believe in their existence. Maybe... they are just my childhood fantasies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560616,
					"content": "But I am not giving up. Take this to them, children... Before the day you can never meet, before the possibility of a miracle fades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560614,
					"content": "They might have forgotten you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560615
					]
				},
				{
					"id": 730560607,
					"content": "Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				}
			]
		},
