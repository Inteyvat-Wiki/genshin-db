						730560706
					]
				},
				{
					"id": 730560706,
					"content": "Even if you have forgotten many things, you should know that we don't mean any harm! We're always on your side, and we'll always help Mawtiyima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560707,
					"content": "Mawtiyima... You know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560710,
					"content": "Hmph, don't look like bad guys, you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "But please don't stay, here. Leave soon. Still recovering, the forest... So, no staying here, new guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560712,
					"content": "Hey, wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560713,
					"content": "We have something for you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
				{
					"id": 730560714,
					"content": "Something, for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560715
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560715,
					"content": "Give me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560716
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560716,
					"content": "Here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560717
					]
				},
				{
					"id": 730560717,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560718
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560718,
					"content": "See? Remember? You gave us the same flower before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560719,
					"content": "Really... are friends with me? Very important flower, why here, with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560720,
						730560721
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560720,
					"content": "Uh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560722,
					"content": "You explain all the adventures in detail to Aranaga, as well as how you saved Mawtiyima from The Withering.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730560723
					]
				},
				{
					"id": 730560723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560724
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560724,
					"content": "What about that? Rings a bell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560725,
					"content": "Don't understand, don't remember...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560726
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560726,
					"content": "Whaaat!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560727,
						730560728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560727,
					"content": "*sigh*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560729
					]
				},
				{
					"id": 730560729,
					"content": "But, thank you. My garden, if remember. Please come.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560730
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560730,
					"content": "Very important flower, will plant, Aranaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560731
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560731,
					"content": "Aranaga leaves with the flower.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730560732
					]
				},
				{
					"id": 730560732,
					"content": "Aranaga just... left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560733,
						730560735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560733,
					"content": "Yeah, he left.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560734
					]
				},
				{
					"id": 730560734,
					"content": "Well, Aranaga invited us to his garden, though... That means he didn't refuse to be friends with us, right? Let's pay him a visit sometime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560735,
					"content": "But he invited us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560736
					]
				},
				{
					"id": 730560736,
					"content": "Hmm... That's right. Let's visit Aranaga sometime, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560728,
					"content": "That's not unexpected...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560729
					]
				},
				{
					"id": 730560721,
					"content": "It's a long story...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560708,
					"content": "We're friends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560709
					]
				},
				{
					"id": 730560709,
					"content": "Friends...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				}
			]
