				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030201,
					"content": "Hey, c—could that be...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030202,
					"content": "#{F#Aether}{M#Lumine}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{F#Lumine}{M#Aether}...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "I've finally found you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "#W—Wait, {NICKNAME}... {F#He}{M#She} just blocked an attack against the Abyss Herald...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030207,
					"content": "#Your {F#brother}{M#sister}, and the Abyss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030208,
					"content": "#{F#Lumine}{M#Aether}, why are you with Dain?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "...What?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "(We've been separated for so long...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030214,
					"content": "#Your {F#brother}{M#sister}... knows Dain, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030216,
					"content": "#{F#Aether}{M#Lumine}. We meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030217,
					"content": "#Wh—What's going on here? Dain knows {F#him}{M#her}, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030218,
					"content": "You shouldn't team up with this man.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "He is my enemy.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{F#Aether}{M#Lumine}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030221,
					"content": "Hold on a second!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "But it must be said... Don't try to stop me. Don't try to stop the Abyss.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "That man, Dainsleif, was the \"Twilight Sword,\" one of the royal guards of the final dynasty of Khaenri'ah. 500 years ago, he failed to prevent the destruction of Khaenri'ah.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "#A curse of immortality was laid upon him, to forever wander the wilderness... while he watched the people he was supposed to protect turn into {F#the monsters}{M#monsters} of the Abyss.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "You're saying... Dain is from Khaenri'ah!? The same Khaenri'ah that was destroyed 500 years ago!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030228,
					"content": "And you said the people turned into monsters... You're trying to tell Paimon that the Abyss Order is not only related to Khaenri'ah but is actually the people of Khaenri'ah themselves!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030229,
					"content": "Uh... and the whole thing about Dain being your enemy? Ohh... Paimon's so confused...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030230,
					"content": "#Come with me, {F#Aether}{M#Lumine}! Let's go home!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "Home...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "Yes, of course. \"Home\" is wherever we are together.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "But I cannot go with you to the next world to find a new home... at least, not yet.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "Until the Abyss has engulfed the thrones, my war with destiny will see no end...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "Destiny...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#Listen to me, {F#Lumine}{M#Aether}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "I have already traveled through this world once. Once you reach the end of your journey as I did, you will see for yourself the true nature of this world.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "You can tell me all this later. Let's go home!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#Stop saying things that don't make sense, {F#Aether}{M#Lumine}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "(Why are you asking about something that doesn't matter...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "You're asking about... Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "Let's get out of here, it's too dangerous!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
		{
			"id": 800303,
			"completionStepIds": [
				800307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800307",
							"2"
						],
						"stepId": 800307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "This is it, right? Okay then, use your Elemental Sight to look for the eye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030302,
					"content": "Ooooh... So what did you see?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030303,
					"content": "Huh? ...Nothing? But Paimon was so excited...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030304,
					"content": "What's going on...? Are you sure you did it right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030305,
					"content": "This requires another method.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030306,
					"content": "Using Elemental Sight on a Field Tiller is of no use because it is not powered by the elements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030307,
					"content": "Let me give it a try.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030308,
					"content": "...And done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030309,
					"content": "Wowwww! It's, it's the...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030310,
					"content": "The very thing the Abyss Herald has been seeking all along — the eye of the first Field Tiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030311,
					"content": "All of the Ruin Guards today are just replicas of this machine. As the prototype, its combat capability was unrestricted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030312,
					"content": "\"Prototype\"? ...Paimon doesn't know that word, is it another ancient term from Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030313,
					"content": "As the Abyss Order has surmised, if this eye is placed in the hands of the Defiled Statue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030314,
					"content": "And if the limbs of Osial, Overlord of the Vortex, are attached to the statue... there you have a mechanized god.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030315,
					"content": "And this newly born god will have the power to \"topple the divine thrones of Celestia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030316,
					"content": "What an extreme and dangerous operation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030319,
					"content": "Th—Then... What should we do with this eye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030320,
					"content": "Hide it somewhere no one will find it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "No. I'll guard it myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030323,
					"content": "Huh!? You!? Dain... You won't go and do anything crazy with it, will you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030324,
					"content": "You may doubt me if you wish, but I must ensure it does not fall into the wrong hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030325,
					"content": "No matter where we may hide it, they will find it. And as for the Church of Favonius — well, you know I don't trust them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030326,
					"content": "Oh, hehe... right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030327,
					"content": "But our work isn't done yet. To avoid any further repercussions, we must also take care of that Defiled Statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030328,
					"content": "By doing what, exactly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "We can't have the Church get involved. Let's handle it ourselves. As for what I mean by take care of it... naturally, I mean to completely destroy it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030331,
					"content": "D—Destroy it!? That's a Statue of The Seven! As well as being a really important cultural relic, they're actually divine, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030332,
					"content": "Ugh, well, good thing we didn't tell Barbara earlier. Otherwise, she'd be going completely bonkers right now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030333,
					"content": "Hmph... Do The Seven really expect me to help them look after what belongs to them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030334,
					"content": "Let's go back to <color=#00E1FFFF>those ruins</color> and destroy the inverted statue. If we are lucky, we will also run into that Abyss Herald.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030335,
					"content": "I'll make sure it doesn't get away this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030329,
					"content": "Can we let the Church take care of this one?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "Put it under the guardianship of the Church of Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "The Abyss Order must be stopped.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
		{
			"id": 800304,
