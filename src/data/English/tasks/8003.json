					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030401,
					"content": "So, after all that running around, we end up right back here again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030402,
					"content": "Look at us... We barely escaped this place last time, and now we're strolling right back in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030403,
					"content": "Gee, surely we must be some of the bravest adventurers in all of Teyvat! That or the stupidest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 800305,
