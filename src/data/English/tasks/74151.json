					"nextDialogs": [
						741511210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511210,
					"content": "And our word is our sacred bond.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511211
					]
				},
				{
					"id": 741511211,
					"content": "Hehe, Paimon knows you always keep your promises! Well, you've got a good brain, too, so what's our next move?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511212,
					"content": "Let's do some investigating.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511213
					]
				},
				{
					"id": 741511213,
					"content": "Yeah, let's get to the bottom of this case! Hmm... What should we investigate, specifically?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
