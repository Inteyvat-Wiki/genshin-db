					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511208,
					"content": "Hmm, that's true, that's true. But in the end, we're here to help him, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511209,
					"content": "Molli asked us to tell Benoit that his snacks were super tasty, and we gave her our word.",
