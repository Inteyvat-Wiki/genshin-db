				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Ms. Paimon, {M#Mr.}{F#Ms.} {NICKNAME}, I've fed the cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510302,
					"content": "Nice! Okay, let's go see Mr. Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "I'm worried, though. Maybe he won't come out? When I've come by to see him lately, he hasn't even spoken to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510304,
					"content": "Before you arrived, I went and knocked, but just as he came out, that scary son-in-law of his came and dragged him back inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510305,
					"content": "He then gave me some sweets and told me to go back to my parents. Then he shut the door.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510306,
					"content": "Geez. Benoit's such a chill guy, so why are his family members such a chilly bunch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "Mr. Leroy's son-in-law said that Mr. Leroy was ill and couldn't see me, but I thought he looked fine, so why couldn't he speak to us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510308,
					"content": "Honestly, I'm more worried about Mr. Leroy than I am about my essay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510309,
					"content": "He must feel terrible if he's ill. Mama told me that sick people need our care and concern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510310,
					"content": "So, could you come with me to ask that son-in-law what sort of illness Mr. Leroy has?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510311,
					"content": "Maybe he ate too much cake, or he slept without a blanket? I can ask my parents about what to do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510312,
					"content": "Regardless, let's knock on the door first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "I know, I'm just... a bit scared of that scary son-in-law, because he's... well, scary. Could you help me speak to him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510315,
					"content": "Don't be afraid, Molli. We've got this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "Well, we made an agreement, didn't we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
