			"dialogs": [
				{
					"id": 741510501,
					"content": "Athos, the man you saw before, opens the door and walks out.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "You again? What in the world do you want?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510503,
					"content": "Could we ask if Benoit's home? We heard he fell ill, so we're kinda worried about his health.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510504,
					"content": "My father is home, but he's in no condition to be receiving guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510505,
					"content": "Could we ask what he's come down with? I could ask my parents to help get him some medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510506,
					"content": "No need. We'll buy what medicines are needed ourselves — not that he has any lack of medicine, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510507,
					"content": "We're just concerned for his health. You don't have to be so cold...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510508,
					"content": "(Athos just doesn't want to let us see Benoit!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510509,
					"content": "(This is past cold, he's downright frigid...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "You concern yourself too much with business that is not your own. Very well. Was there anything else? If not, I'll be heading back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510512,
					"content": "Wait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510514,
					"content": "Is Benoit really ill?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "Of course he is. Very seriously, in fact. Morticia and I will think of something, though. There's no need for you — or anyone else, for that matter — to worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510518,
					"content": "Athos, what's that disturbance outside?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510519,
					"content": "Nothing, Morticia, just a few kids saying that they want to see Dad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510520,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510521,
					"content": "You really do get along well with children, don't you, Dad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510522,
					"content": "Well, since these kids want to see you, why don't you go say hello to them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510523,
					"content": "...I'd like to... Can I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510524,
					"content": "Of course you can, Dad. You're in charge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510525,
					"content": "The door opens and Benoit slowly emerges.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "Ah, it's you again, little ones. You're back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510527,
					"content": "How are you feeling, Mr. Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510528,
					"content": "Me? *cough* Oh, I'm not doing quite so fine, but not to worry, I'm doing my best to rest up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510529,
					"content": "My daughter and son-in-law are taking very good care of me, so all is well — just run along home, if you would.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510530,
					"content": "Are you sure you're alright, Dad? If it's too much for you, you should go back inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510531,
					"content": "Benoit sees Athos give him a meaningful glance before silently going back indoors.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "Well? So you've seen him for yourselves, then. My father really is unwell. Does that satisfy you? If there's nothing else, I'm going back inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510533,
					"content": "We...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510534,
					"content": "Athos ignores all of you.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "Well, at least we got to say a few words to Mr. Leroy. *sigh* I do hope he gets better soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510536,
					"content": "Looks like I caused trouble for other people, Ms. Paimon. That... wasn't what I wanted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510537,
					"content": "Don't think that way! You weren't any trouble at all! In fact, Paimon thinks that Athos guy is the real problem here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510538,
					"content": "Hmph. The entire time, he was just...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510539,
					"content": "You should go home first, Molli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#Eh? {NICKNAME}, you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510542,
					"content": "True, I should head back as well. My parents don't like it when I come here, you know? They'd get mad if they knew I came today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510543,
					"content": "I don't know if we'll get to see Mr. Leroy again. I really wanted to tell him that his snacks were super tasty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510544,
					"content": "Well, could you help me tell him that if you see him — after he gets better, I mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510545,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "And Paimon's, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510548,
					"content": "#Alright. Thank you, {M#Mr.}{F#Ms.} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510549,
					"content": "I've gotta go home now. See you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510550,
					"content": "#What do you think, {NICKNAME}? Paimon noticed you had \"I've got something to say\" written all over your face as soon as she looked at you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510551,
					"content": "Let's talk over there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "Sure, let's go talk somewhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510552,
					"content": "Best not to speak too loudly right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "You have my word.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "Paimon and I will be heading back as well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "Why are you trying to prevent us from seeing Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "And why must I allow completely unrelated people to see my father? Like I said earlier, he's in no condition to see guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510510,
					"content": "(He sure turned down the temperature quickly...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
