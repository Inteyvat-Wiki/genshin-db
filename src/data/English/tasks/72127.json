			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "Hello, you're here. Do you see a lot of flowers in bloom? Aren't they pretty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270102,
					"content": "Very pretty indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "Hehe...that's for sure. I'm taking good care of them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270106,
					"content": "By the way, can you do me a favor again? Now that the flowers are blooming so well, I was going to pick some flowers and make them into dried flowers, and send them along with letters to those who have yet to return to Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270107,
					"content": "But... I don't know if it's because I had too little sleep, I just went out to pick a few flowers and I'm already so tired...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270108,
					"content": "Could you please help me pick some Sweet Flowers around here? Just three will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270109,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "I'll leave it up to you, then. I'm gonna take a breather...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270112,
					"content": "I just want the lovely fragrance of Sweet Flowers, other dried flowers will be included in the letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270113,
					"content": "I do believe that those who read this letter, surrounded by as pleasant a scent as it is, might at least be put in a better mood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270114,
					"content": "I'm counting on you, then. I'll take a short break here... After you pick the flowers, please bring them to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270111,
					"content": "Sweet Flowers seem to be everywhere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "How long have you been planting?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "It's not that long, it's just... I just sleep a little less.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
		{
