	"talks": [
		{
			"id": 1102303,
			"completionStepIds": [
				1102303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102303",
							"2"
						],
						"stepId": 1102303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "Look at this. It's filled halfway with salt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230302,
					"content": "Just looks like a fancy salt holder. Seems like the God of Salt was a god lacking in treasures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230303,
					"content": "According to my knowledge, it's no ordinary vessel. Although it is only half-full, it is also forever half-full — that is to say, it is bottomless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230304,
					"content": "What!? You're saying that even if I pour the salt out, the amount inside won't change!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230305,
					"content": "Exactly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230306,
					"content": "Able to produce endless salt... The God of Salt is powerful indeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230307,
					"content": "Finally, after all that effort, I've found precious treasure! I claim this as mine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230308,
					"content": "I just need to pour the endless salt into a thousand, or ten-thousand bags... I can sell it and make a fortune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230309,
					"content": "Hey! How can you use a relic of the God of Salt for such a shallow pursuit!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230310,
					"content": "If Mr. Kliment wants this salt chalice, then the next object we find will belong to Miss Wanyan, according to the contract agreed upon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230311,
					"content": "Of course, as we agreed, hehe. But how can anything be worth more than this rare find?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230312,
					"content": "Since we have a contract, it's no use for me to fight with him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230313,
					"content": "Then let's move on, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "Ha, just a simple ruler. Doesn't look to be worth anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230502,
					"content": "This... if I remember correctly, this is some kind of measuring tool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230503,
					"content": "Indeed. But the God of Salt imbued it with another power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230504,
					"content": "When you stick this ruler in the ground, the surrounding area will become covered in salt, much like a rising tide covers the earth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230505,
					"content": "The deeper it is stuck in the ground, the more salt will appear. It is essentially a \"bumper harvest\" of salt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230506,
					"content": "Wh— Th—That's even better than the salt chalice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230507,
					"content": "Well then, according to our contract, the salt ruler goes to Miss Wanyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230508,
					"content": "No! Unacceptable! I paid for and organized this entire expedition. Why should I get the short end of the stick?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230509,
					"content": "And this girl has been useless. Why would she get anything!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230510,
					"content": "Oh boy, here we go again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230511,
					"content": "*sigh*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "So you are saying, you want to break the contract?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230514,
					"content": "So what if I break it? Now that I've seen how the mechanisms in this ruin work, I no longer need you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230515,
					"content": "Let's not forget who hired who here. Why should I let YOU make the rules?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230516,
					"content": "Because you agreed to a contract.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230517,
					"content": "Rex Lapis once said: \"Ones who break their contracts shall suffer the Wrath of the Rock.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230518,
					"content": "That is one of your Liyue gods. I am from Snezhnaya, I—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230519,
					"content": "—Will \"suffer the Wrath of the Rock\" — you may find it rather unpleasant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230512,
					"content": "While we're on the topic of \"useless\" people...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "I shall confiscate your treasure as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230702,
					"content": "You are not worthy to continue any further into the ruin. Leave this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230703,
					"content": "Darn you... Just you wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230705,
					"content": "Some \"archaeological survey...\" He could only pretend for so long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230706,
					"content": "At least we had our guard up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "Yeah, good thing Paimon can smell a liar from a mile away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230710,
					"content": "Kliment's wrongdoing stemmed from greed, yes. But besides greed, there are many other things that may tempt us to break contracts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230711,
					"content": "When people see the object of their dreams, how many are really able to control their desire and follow the contract...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230712,
					"content": "I think we should be honest with each other now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230713,
					"content": "Huh? Be honest about what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230714,
					"content": "That in truth, not a single member of this \"archaeological expedition\" came here for archaeology.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230715,
					"content": "Wh—Why do you say that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230716,
					"content": "Miss, you lack even the most basic archaeological knowledge and can recognize naught but a few simple relics. However, you are an expert when it comes to anything regarding the God of Salt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230717,
					"content": "You aren't interested in archaeology or relics — what you're really interested in is the God of Salt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230718,
					"content": "I believe those legends about the God of Salt that you mentioned on the Pearl Galley are passed down between generations at Yinyuan Hall...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230719,
					"content": "Okay, that's enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230720,
					"content": "...Sir, you are indeed a man of great knowledge and talents. I seem to have been right to seek you out, once I plucked up my courage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230721,
					"content": "You're right. I'm not a scholar of archaeology. I come from one of the Eight Trades under the jurisdiction of the Qixing — Yinyuan Hall of the salt industry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230722,
					"content": "Our ancestors were those protected by the God of Salt all those years ago, when the Archon War engulfed the land in chaos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230723,
					"content": "Come to think of it, I've never heard you say \"Rex Lapis...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "Oh, right. Now that you mention it, the people of Liyue very seldom use the name \"Morax...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230726,
					"content": "During the war, Morax assassinated our god out of envy for her power! He left us alone and lost in the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230727,
					"content": "We— We hate him! But this is Morax's Liyue, after all, and its history is written as he wishes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230728,
					"content": "So, I seek proof of Morax's guilt! He has blood on his hands, and cruelty in his heart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230729,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230730,
					"content": "We agreed to a contract that we will face the truth head-on, didn't we, Mr. Zhongli!? You must judge this history fairly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230731,
					"content": "Naturally, of course. But I must add, Liyue is no longer Morax's Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230732,
					"content": "Come with me. All the answers you seek lie ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230724,
					"content": "Hmm, I've never heard you say \"Lord of Geo...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "I hope you never become as greedy as him, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "Hey! Paimon likes Mora, but Paimon doesn't do bad things!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "This is... a sword?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230902,
					"content": "Aha! It's a broken sword, this is proof! This proves that the God of Salt had to fight back, fight back against the evil Morax! But sadly, she was defeated...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230903,
					"content": "The power of this sword surely is much greater than that of the salt chalice and the salt ruler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230904,
					"content": "If we can repair this sword, then we can show the world the mighty power of the God of Salt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230905,
					"content": "Hmm... It does look like something left behind after being defeated in battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230906,
					"content": "Two pieces of a broken sword. From an archaeological perspective, these are two separate relics. According to the contract, you can only claim one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230907,
					"content": "Wh—Why? We were alternating claims to treasure, true, but Kliment is no longer here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230908,
					"content": "Yes, but the \"only one object per claim\" clause still holds true. You cannot take two relics at the same time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230909,
					"content": "Th—This logic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230910,
					"content": "Um... Zhongli, she seems like a good person, and no one is fighting over the treasure. How about you let this one slide, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230911,
					"content": "When there's a contract, nothing can be allowed to \"slide.\" If the contract is not followed, then it is broken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230912,
					"content": "No! If I only take one half, then it can't be repaired, and the power of the God of Salt cannot be restored...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230913,
					"content": "No matter what, I must be faithful to her...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230914,
					"content": "Even if it breaks the contract, I don't care.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230915,
					"content": "So you are already decided? Hmm... Then there is a price to pay for breaking the contract.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230916,
					"content": "Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230917,
					"content": "That is to say, you consign yourself to \"suffer the Wrath of the Rock.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230918,
					"content": "That... that's okay. The God of Salt gave up her life to protect her people. My sacrifice is nothing compared to that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230919,
					"content": "Punish me however you want. Just let me take this proof of my faith!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230920,
					"content": "No, you can't hit her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230921,
					"content": "...Perhaps that punishment would be easier for her, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230922,
					"content": "As punishment, I will tell you the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230923,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230924,
					"content": "The truth? You mean the truth is my punishment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230925,
					"content": "Yes. The truth that I am about to tell you shall be your price to pay for breaking the contract.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230926,
					"content": "I'm afraid to say that the God of Salt, Havria, was not the powerful god you imagine her to be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230927,
					"content": "Rather, she was a small and weak god who yielded to all other gods. When it came to war, she lost... never able to win a seat among The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230928,
					"content": "Wh—What...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230929,
					"content": "During the Archon War, the gods of this world used all their strength and cunning to vie for control of Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230930,
					"content": "But Havria instead chose to flee. She thought that by giving up before a fight could start, she could save herself and her people from the war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230931,
					"content": "However, during such a long war, there is no end to the advances of aggressors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230932,
					"content": "After making countless concessions, Havria had lost all of her lands until only one small haven remained.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230933,
					"content": "No... no... it can't be so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230934,
					"content": "In her last days, she had not even a single blade to defend her people with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230935,
					"content": "\"Not even a single blade?\" Then, this sword...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230936,
					"content": "This sword is not a relic belonging to the God of Salt... but is instead the murder weapon used to kill her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230937,
					"content": "Murder weapon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230938,
					"content": "No! That's not true, that can't be true! You are trying to test my faith in the God of Salt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230939,
					"content": "As I said before, I only state the facts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230940,
					"content": "Preposterous! Y—You are a follower of Morax, don't try to trick me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230942,
					"content": "Hey! Heyyy! Come back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230943,
					"content": "That was too much for her to take.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "It is a punishment, after all. I did not want to tell her such cruel facts, but the contract was broken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230947,
					"content": "Let's follow her deeper into the ruin. There, I fear, we will find something that will leave her no choice but to face the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230945,
					"content": "What you said really is true, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "Indeed. Otherwise, why would I use the truth as punishment? I did not want to tell her such cruel facts, but the contract was broken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102310,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102310",
							"2"
						],
						"stepId": 1102310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231131,
					"content": "...What are all these?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231132,
					"content": "What did they see... What did they do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231133,
					"content": "What... What happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231134,
					"content": "Since you do not trust me, let us continue onward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231135,
					"content": "That which lies beyond this door will show you all that happened back then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102311,
			"completionStepIds": [
				1102311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102311",
							"2"
						],
						"stepId": 1102311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "This is the scene of the crime. Havria's body dissipated, leaving nothing but these traces of salt. Her dying moments have since been frozen in time to this very day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231103,
					"content": "The story continues that some among her people realized at last that this gentle, kind, but weak god could never protect anyone in wartime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231104,
					"content": "The Archon War was cruel in the extreme. Instead of consigning her to the agony of defeat, they thought, perhaps it would be better to give her a quick release.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231105,
					"content": "But... what about these statue thingies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231106,
					"content": "No matter how weak the god, the power that flows forth when they are slain is beyond the strength of mortal coils to bear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231107,
					"content": "Those who could not flee were thus transformed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231108,
					"content": "Those of her people who were untouched by this disaster left for Liyue, where they sought refuge with Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231109,
					"content": "Their descendants feared Havria's remnants and lived in terror that she had laid upon them an eternal curse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231110,
					"content": "So they risked their lives to come here to break the sword, and offer up obeisances in hopes that her anger might be appeased.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231111,
					"content": "But they need not have done so. For how could a god who had never once resisted — even till the end — nurse hatred for her people in her heart?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231112,
					"content": "I—I... Even if this is so, I can't...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231113,
					"content": "This must be a lie... a false history... all of it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231114,
					"content": "Don't you dare try to... shake my faith!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231116,
					"content": "Yikes, Zhongli didn't show any mercy this time, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231117,
					"content": "This is the price she must pay... Yet I would not call it a bad thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231118,
					"content": "Judging by how she appeared, I fear that she will struggle for a time. But even if she may not escape that struggle immediately, simply recognizing the truth is good enough for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231119,
					"content": "You seem all too familiar with what happened to the God of Salt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "Indeed. In ages past, Havria's story served as a warning to me as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231123,
					"content": "Faith in a god who has already passed will do you no good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231124,
					"content": "So it is for Havria, and so it is for Morax also.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231125,
					"content": "The people of Liyue will understand that one day.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "Alright, then. Now, would you like to accompany me in taking a trip to Guyun Stone Forest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231127,
					"content": "Huh? What do you want to do, Zhongli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231128,
					"content": "*sigh* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231129,
					"content": "Treading old ground, telling old stories...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231130,
					"content": "...One cannot help but be reminded of old acquaintances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231121,
					"content": "You didn't just hear rumors about the way to break the seal, did you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "No, indeed. How sharp of you — yet this is not a matter of wisdom. Only age.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}