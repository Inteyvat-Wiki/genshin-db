			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "All are welcome to join the \"Claw Convoy\" animal rescue society...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680102,
					"content": "Greetings!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#Ah, {NICKNAME}, it's you. How do you do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680105,
					"content": "Our guild is currently holding an event. Might that interest you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680106,
					"content": "What sort of event are we talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "Simply put, we're asking people to join the Claw Convoy, an animal rescue society sponsored by the Feiyun Commerce Guild, and help us take care of abandoned or endangered animals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680108,
					"content": "The Guild has been working with volunteers from the various nations, helping to solve the widespread problem of stray animals through communal adoption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680109,
					"content": "We've seen major expansion in recent years, which led us to start thinking about working with researchers like Ms. Lamiya in the field of endangered animal conservation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680110,
					"content": "Honestly, I'm glad to see my research bear fruit in this way too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680111,
					"content": "Haha! Then we're of the same mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680112,
					"content": "Thanks to our volunteers and visionary researchers like Ms. Lamiya, many stray animals now have a home, and endangered species are being protected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680113,
					"content": "Aside from Liyue, the Claw Convoy's animal care facilities may be found everywhere the Feiyun Commerce Guild is active, like in Mondstadt and Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680114,
					"content": "As such, we're running this event to show our gratitude to our volunteers and to let everyone know just how many Convoy companions we've got out there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680115,
					"content": "You can head over to the area where the adopted animals are staying to check on their actual living conditions, and take a small gift to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680116,
					"content": "The gifts were prepared by our staff and other animal adopters. Of course, before you claim a gift, you'll need to prepare something for other adopters as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680117,
					"content": "When the time comes, all gifts will be retrieved by a professional and delivered to the original adopter. No need for expensive gifts — they're just meant to convey your feelings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680118,
					"content": "#So how about it, {NICKNAME}? Interested?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680119,
					"content": "Sure, I'll give it a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "Wonderful! It would be amazing to have a celebrity like you taking part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680122,
					"content": "If you're ready, you can hand over your gift now. Our staff will pass it to the relevant adopter once the event ends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680123,
					"content": "By the way, based on my personal experience, some of our adopters are interested in regional specialties, and others prefer good food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680120,
					"content": "Absolutely, sign me up!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
		{
