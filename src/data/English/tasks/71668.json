				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680301,
					"content": "Okay, we'll pack these specialties into a gift box.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				}
			]
		},
		{
			"id": 7166804,
			"completionStepIds": [
				7166804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166804",
							"2"
						],
						"stepId": 7166804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "Alright, we'll pack this food into a box and send it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680402,
					"content": "Each animal behaves in its own unique way. We don't lock them away in cages. Instead, we employ professional caretakers to monitor their physical condition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680403,
					"content": "Tracking them down is no easy task. You'll need the special Inscribed Tracker that Ms. Lamiya has developed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680404,
					"content": "I'm not as knowledgeable as she is in this area, so I'll leave the explaining to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680405,
					"content": "Agreed. Allow me to explain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680406,
					"content": "The underlying tech behind the Inscribed Mirror is related to the Akasha, and the operational specifics are quite complex, but don't worry, it's tested and safe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680407,
					"content": "We've already attached micro-transmitters to all the animals, so we just need to read the device's signal, and the mirror will reveal all that can be seen from the animal's perspective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680408,
					"content": "This device may need some improvements, but this footage will suffice for us to locate active animals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680409,
					"content": "That's all there is to it. If you're ready, then we're happy to welcome you to the Claw Convoy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680410,
					"content": "Use the Inscribed Mirror to find our animal friends. Both our adopters' gifts and the animals themselves will be waiting for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				}
			]
		},
