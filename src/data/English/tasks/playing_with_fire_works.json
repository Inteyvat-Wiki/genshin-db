			"dialogs": [
				{
					"id": 220490301,
					"content": "Ah, you're back! How were the fireworks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490302,
					"content": "They were lovely.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "Glad that you enjoyed them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490306,
					"content": "Well, I need to get back to manning the store now. Business has really picked up recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490307,
					"content": "Heh, why isn't that girl back yet. Where has she gone to do her tinkering, I wonder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490304,
					"content": "I didn't quite have enough...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "Oh, you really liked it, didn't you? Don't worry. I'll pass you some more next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		}
	]
