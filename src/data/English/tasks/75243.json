			"dialogs": [
				{
					"id": 752430101,
					"content": "Ah, my dear customer, you really saved my day. Thank you for chasing those Fatui away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430102,
					"content": "I don't know where those fools came from, but they didn't even bother to threaten me — just stuck their hands straight into my bag! They're robbers, I tell you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430103,
					"content": "Thank goodness you stepped in! I would've lost so much if not for you... Please, you must accept my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430104,
					"content": "Ah, yes, I almost forgot to introduce this place. This is the Sunnyshine Alpaca Park, where we showcase gentle Alpacas. There's also a bunch of related toys for sale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430105,
					"content": "But those goons just scared off my staff and the guests... Now, I gotta go deal with the mess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430106,
					"content": "If you're interested in visiting the Alpaca Park, please come back tomorrow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
