				"points": []
			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "Oh, have you come to take pictures? Foreign tourists have come here before, wishing to do the same. That floating island is quite the view, after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270102,
					"content": "It's just a shame we didn't have Kamera previously — I had to ask a foreign merchant I knew to get me one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270103,
					"content": "How about it, dear guest? Care for a picture? But you'll have to do it yourself. I'm not exactly a dab hand at photography...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270104,
					"content": "Strange, there's fog over the sea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "Fog? What do you mean? There can't be fog with such a strong sea breeze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270106,
					"content": "I have never seen fog over the sea since the day I was born.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270107,
					"content": "Might you have confused this place with the fog-shrouded area that Tezcatepetonco Range overlooks, by any chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270108,
					"content": "Perhaps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "Hehe, if you ask me, I'd say you're just too nervous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270110,
					"content": "You should loosen up — you're touring Natlan, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				}
			]
		}
	]
