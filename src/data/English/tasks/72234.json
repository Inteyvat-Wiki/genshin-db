				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "How's things going? Sitting pretty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "Whoa, that was sudden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Oh, uh, terribly sorry. That wasn't my intention to scare you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "I'm Kabayama, and I often sit in the spot where you're sitting now. It's a nice, quiet place where you can just think about life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "Would you like it back?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Thanks, but it's alright. By the way, you're not from here, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "That's right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "Then you must be quite knowledgeable indeed. I've never seen the outside world, though I've had a lot of experience moving house.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "*sigh* Speaking of that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "We moved so often when I was young that I never really had the chance to make good friends. I saw many a fine sight while wandering about, but there was no one to share them with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "You know what? Why don't I show those places to you? If you pass by spots like this, take a seat and have a look about — then come back and tell me what you think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "One such place is beneath a stone gate at the highest point in The Narrows. One of them is an open space surrounded by corals near the Evernight Temple, and the last one is beside the towering ruins at the Serpent's Heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "I've left markings on all these places, and hung a lamp there to light my way. You should find them, easy-peasy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
