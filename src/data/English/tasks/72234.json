	"talks": [
		{
			"id": 7223401,
			"completionStepIds": [
				7223402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223402",
							"2"
						],
						"stepId": 7223402,
						"stateName": "QUEST_STATE_UNFINISHED"
