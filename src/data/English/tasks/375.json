			"dialogs": [
				{
					"id": 3750202,
					"content": "Man, this stinks. Having to stand around here all <color=#00E1FFFF>day</color> long, having to guard this entrance.\\nHey! Don't move! You can't go down there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750203
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3750203,
					"content": "Seems we're gonna have to wait until <color=#00E1FFFF>nightfall</color> to sneak in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
