					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Salsa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230301,
					"content": "#Hello, {NICKNAME} and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230302,
						740230304
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230302,
					"content": "Did you manage to recruit new members for the alliance?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230303
					]
				},
				{
					"id": 740230303,
					"content": "I found prospective members who are willing to participate, but I need to carry out a rigorous assessment to make sure they have the right qualifications. After all, Fontaine's future is at stake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230304,
					"content": "Not rushing home today?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230305
					]
				},
				{
					"id": 740230305,
					"content": "I've finished my homework, so I thought I'd hang around a little longer before heading home...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Salsa"
				}
			]
		}
	]
}