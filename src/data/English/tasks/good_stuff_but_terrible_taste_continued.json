					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230201,
					"content": "Hmm... Paimon can't stand how these objects look... Somehow, it reminds Paimon of those ugly things we saw last time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230202,
					"content": "<color=#00E1FFFF>Why is there a Hydro Monument buried underground</color>? Paimon doesn't get it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230203,
					"content": "#{NICKNAME}, should we rearrange it? Just like how Salsa taught us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7402303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
