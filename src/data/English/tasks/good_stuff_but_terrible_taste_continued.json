	"talks": [
		{
			"id": 7402301,
			"completionStepIds": [
				7402303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402303",
							"2"
						],
						"stepId": 7402303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Salsa",
					"Ubu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "Phew, this looks so much better. Salsa would be proud of us if she saw this, don't you think so, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230102,
					"content": "Robbers! A robbery in broad daylight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230103,
					"content": "Huh!? Robbers? Where?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230104,
					"content": "I'm talking about you two! Not only did you destroy my masterpiece, you even took the chest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230105,
					"content": "So it really was the work of an Adventurers' Guild member...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "What work on earth? I should be asking you guys about what you did!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230109,
					"content": "So, these ugly things are your \"masterpieces\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230110,
					"content": "The audacity! What do you mean \"ugly things\"? Haven't you heard of installation art?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230111,
					"content": "Looks like Fontaine's art education still has a long way to go... Oh, but you two don't look like you're from Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230112,
					"content": "#That's because we are not from Fontaine. Paimon's Paimon, and {M#he}{F#she} is {NICKNAME}. We are also members of the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230113,
					"content": "We are members of an evil organization... *sob*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "Yeah, but we don't have to wear uniforms. So we're not bad guys in green, yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230117,
					"content": "I'm Ubu, an adventurer and installation artist. Seeing how you guys are making zero sense, I'm guessing you're often up to crazy shenanigans... I won't pursue this matter this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230118,
					"content": "Huh? Actually...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230119,
					"content": "What? I need to restore the work, so if you want to say thank you, do it quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230120,
					"content": "I have nothing to thank you for, but I sure have a million things I wanna yell at you for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230121,
					"content": "Salsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230122,
					"content": "With me around, you don't have to be scared, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230123,
					"content": "Evil green guy, we have destroyed all of the traps laid by you! Stop trying to ruin our beautiful Fontaine with your sinister traps!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230124,
					"content": "Ruin? Wait, \"destroyed all\"? ...You destroyed all of my artworks!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230125,
					"content": "Umm, we didn't exactly destroy them... We just rearranged them to suit the surrounding scenery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230126,
					"content": "You...! You brats and plebeians! How could you hope to understand art! To turn my installation art, my works into something so mediocre and mundane...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230127,
					"content": "But is it really art? Paimon doesn't know much about it, but can you really call something that looks so out of place art?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230128,
					"content": "Of course, the boundaries of art are set by the artist. A work created by an artist is naturally called a work of art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230129,
					"content": "Who's the artist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230130,
					"content": "It is I, Ubu, the extraordinary installation artist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230131,
					"content": "In that case, as the founder of the \"Alliance of Artists to Overthrow the Evil Organization and Protect the Future of Fontaine,\" I declare that I do not recognize it as art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230132,
					"content": "\"Overthrow the E—\" ...What?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230133,
					"content": "Overthrow the Evil Organization.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "It refers to the Adventurers' Guild that is ruining the scenery with, umm, installation art...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230136,
					"content": "What a joke, I've never heard of such an alliance. Kid, what gives you the right to say that my work isn't art?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230137,
					"content": "I'm a painter, so you could say I'm an artist. Of course I'm qualified.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230138,
					"content": "Huh? Look, kid, being an artist isn't some child's play. You can't say you're an artist just because you want to become one. You gotta have works that are recognized by people...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230139,
					"content": "So what makes you qualified? Your works, the installation art you speak of... Those evil traps? Do people clap when they see them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230140,
					"content": "That's because there are too many plebeians who can't comprehend the charm of my works. True art is always the least understood...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230141,
					"content": "You should start from making art that people can actually understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "Yeah, if no one understands, it's either too avant-garde, or simply...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230145,
					"content": "No... It can't be! My works are perfect! There is absolutely nothing wrong with them! You guys just don't understand, people just don't understand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230146,
					"content": "Darn it, I'm not giving up! This isn't over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230147,
					"content": "Ubu stumbles away...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "What a stubborn enemy! But I'm not giving up either! The future of Fontaine's art rests on my shoulders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230149,
					"content": "We all have a goal to work towards.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "Is this a good thing? It probably is, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230143,
					"content": "Simply put, no one understands it at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "Which sounds like a failure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230135,
					"content": "Basically, we have to take you down.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "Well hello there, buddy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "Paimon doesn't think you can call someone buddy when you don't even know their name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230107,
					"content": "Wait, it's the evil green guy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "Hah, a robber who is spouting nonsense. What a day it is today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Ubu"
				}
			]
		},
		{
			"id": 7402302,
			"completionStepIds": [
				7402304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
