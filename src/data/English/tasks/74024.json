			"dialogs": [
				{
					"id": 740241301,
					"content": "Ah, I see, I see... This is the \"Berry\" you spoke of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241302,
					"content": "It is cold and hard, yet supple... and it stings the eyes like the sunlight of a winter afternoon. Surely this must be a metal that humans forge to make their weapons! Thank you very much. I shall remember this item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241303
					],
