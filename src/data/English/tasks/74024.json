					"nextDialogs": [
						740240701
					]
				},
				{
					"id": 740240701,
					"content": "Thank you very much. With this, I'm sure I shall be able to make pigments \"as bright as the sun,\" which I may then give her as a gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240702
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240702,
					"content": "Will this really work...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240703,
					"content": "Or rather, can you really make \"bright colors\" using such base materials?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240704,
						740240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240704,
					"content": "I suspect not.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "But Sluasi sure does look happy, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "Whatever the case, I thank you two for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Please, take these as my thanks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "Sh—Shiny gems — and components, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Hehe. I am glad you like them. If you desire any ornaments in the future, you know where to find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "It's not utterly impossible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "That's true, the colors Mamere uses are pretty weird too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				}
			]
