							252.729,
							4986.404
						],
						"pointId": 340300093
					}
				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "Huh. What are you doing here all by yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240102,
					"content": "Gah! Don't suddenly talk to people while standing behind them! You almost made me scatter this powder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240103,
					"content": "Powder? Err, what's this stuff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240104,
					"content": "Gems!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240105,
					"content": "Gems? But why would there be any here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240106,
					"content": "Wouldn't it be stranger to not find them here? I mean, this is my workshop, in which I process gems... Although I must admit that it doesn't have an official name yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240107,
					"content": "I did consider calling it \"Studio Sluasi\" in the past, but I'm not sure if using my name so directly is such a good idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240108,
					"content": "What do you mean by \"processing gems\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "That means that I turn gems into various pretty ornaments... and stuff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240110,
					"content": "Unfortunately, I won't be able to take new commissions for a while. I need to concentrate on making paints... Well, I am still using gems for that, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240111,
					"content": "You're gonna make paints out of gems? Are you serious?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240112,
					"content": "Yes. What's wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240113,
					"content": "Um, well, it just feels like a waste... You could just give them to Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240114,
					"content": "But still, why do you need to make paints? Paimon's pretty sure there's no such step in using gems to make ornaments, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240115,
					"content": "Well, a child who loves painting came to ask me if I could make paints as shiny as gems and as bright as the sun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240116,
					"content": "Moreover, she recently saved my younger sister when the village was shaking very violently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240117,
					"content": "That's why I've decided to try to fulfill her wish by creating a \"paint as bright as the sun\" and giving it to her as a thank-you gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240118,
					"content": "Wait, you must be referring to...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "Is the girl who enjoys painting you spoke of named Mamere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240120,
					"content": "Hmm? Yes... Do you two know her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240121,
					"content": "You tell Sluasi about your previous experiences with Mamere...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "So... So the two of you are the esteemed ones who saved Puca alongside Mamere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240123,
					"content": "Esteemed ones...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240124,
					"content": "Yes, that was us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "Thank you. Thank you both so much! If it weren't for you, Puca might have been...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240127,
					"content": "Please, take these... If you don't mind, that is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240128,
					"content": "(Beautiful jewels...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#Can we really take them, {NICKNAME}? They look really expensive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240131,
					"content": "Still, Paimon didn't think Mamere would go commission people of her own accord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240132,
					"content": "Well, she didn't really commission me to do anything, did she? She just asked if I could do it. In fact, she ran off before I could even reply...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240133,
					"content": "That... Yeah. That sounds like something she would do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240134,
					"content": "#Speaking of which, esteemed {NICKNAME} and Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240135,
					"content": "What would you call \"the closest thing to the sun in color\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240136,
					"content": "I have tried to observe the sun myself, but I am not sure what materials I should use to recreate its tones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240137,
					"content": "Hmm... \"closest to the sun in color,\" you say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240138,
					"content": "...Gold, perhaps?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "Well, Canotila did tell me once that \"gold is the tears of the sun,\" or something like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240140,
					"content": "But wouldn't that be way too luxurious? There has to be something more normal we could use...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240148,
					"content": "Just think. We have to have seen something that most \"resembles in the sun in color\" and that can be found just about anywhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240141,
					"content": "...The sun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "...That is true. The closest thing to the sun is indeed the sun itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240143,
					"content": "But how do I grind the sun into powder, I wonder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240144,
					"content": "What? Are you seriously discussing something this ridiculous?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240145,
					"content": "In that case, you could probably use my hair...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "...Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240147,
					"content": "C'mon, you can't use hair to make paints!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240130,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "I wouldn't call us the \"esteemed\" anything...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
