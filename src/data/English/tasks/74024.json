					"nextDialogs": [
						740241002
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241002,
					"content": "Ah, it is so warm... it smells so good and feels so soft — it truly is as gentle as the sun itself. Surely, humans must use these to make food? Anyway, thank you so much. I will remember this item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241003
					],
					"speakerTitle": "Sluasi"
				},
				{
