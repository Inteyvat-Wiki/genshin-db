			"dialogs": [
				{
					"id": 730750101,
					"content": "#Nara {NICKNAME} and Paimon, thank you. Now Viparyas is growing across the gardens in Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750102,
					"content": "The Viparyas here are happy. So Arakara is happy too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750103,
					"content": "Festival Utsava is over. Before the Golden Nara leaves Vanarana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750104,
					"content": "You obtain a Viparyas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#I gave the happy Viparyas to the Golden Nara. Hope Nara {NICKNAME} and Paimon will be happy too. The Viparyas doesn't wither, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750106,
					"content": "Remember to talk to it occasionally. Better play music for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750107,
					"content": "#The land and Aranara will not forget. Hope Nara {NICKNAME} and Paimon will not forget...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
