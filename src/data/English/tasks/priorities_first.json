			"dialogs": [
				{
					"id": 760000801,
					"content": "It looks like they really were doing experiments here, but this isn't the only place. There are three more sites up on the surface.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000802,
					"content": "#They're collecting data from those sites and then sending it down here for analysis. Hey, {NICKNAME}, what if we made off with all their data?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000803,
					"content": "Oh, actually, Paimon's kinda curious about what they found out. How about... how about we collect the data from all three sites, check the results, and then take everything with us!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000804,
						760000806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000804,
					"content": "Why do we need to take the results?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000805
					]
				},
				{
					"id": 760000805,
					"content": "Duh! So the Fatui don't get their hands on them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000808,
					"content": "#Besides, aren't you the least bit curious about the results, {NICKNAME}? Come on, let's give it a try!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000806,
					"content": "Feels like it'd be simpler to just destroy everything...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000807
					]
				},
				{
					"id": 760000807,
					"content": "Th—That'd cause way too much of a scene, wouldn't it? Let's not go overboard here and create a bunch of needless noise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000808
					],
					"speakerTitle": "Paimon"
				}
			]
