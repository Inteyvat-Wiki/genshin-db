			"dialogs": [
				{
					"id": 760000601,
					"content": "So many jars! And inside them... could it be kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000602,
					"content": "What are the Fatui doing, placing these things so deep underground?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000603,
						760000605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000603,
					"content": "So they can use them, of course...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000604
					]
				},
				{
					"id": 760000604,
					"content": "Obviously, Paimon knows that! But what are they using them for? Presumably, it's not for bathing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000607,
					"content": "#{NICKNAME}, let's investigate around here first. Maybe we'll uncover some clues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000605,
					"content": "It must be some kind of evil experiment!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000606
					]
				},
				{
