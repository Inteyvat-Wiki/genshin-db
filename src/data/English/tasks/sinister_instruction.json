					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "Thank you for forgiving my sins. Please let me return to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411804,
					"content": "Are you talking to me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "What... But why...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411806,
					"content": "I presided over every sacrifice, and I accepted every one of your blessings!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411807,
					"content": "But she, branded by you, established by your hand, has fled from your blessings. She has betrayed us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411808,
					"content": "What are you talking about...",
