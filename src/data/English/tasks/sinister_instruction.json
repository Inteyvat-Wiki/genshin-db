					"Washizu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411201,
					"content": "\"He\" is coming! Don't stop worshiping! We must not stop worshiping!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411202,
						721411203
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411202,
					"content": "Are you alright...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				},
				{
					"id": 721411204,
					"content": "\"He\" is sullen. \"His\" anger shall soon burst forth!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411205,
					"content": "What?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "And why? Why, because of that woman! The one who refuses to pay tribute! The evil one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411208,
					"content": "A woman...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "She flees even now, but how can she escape him? Eighteen pairs of blood-red eyes! Thousands of sharp, venomous fangs! Countless mouths and numberless tongues, ever thirsting after blood!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411211,
					"content": "She can't hide, she can't hide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411212,
					"content": "Ah, the desert nation of arid sentiment! And you, the foolish beggar who hides in the forest, claiming to be wise — none of you can protect her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411213,
					"content": "Please calm down!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "You have the blessing! Go and worship! Go and worship!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411214,
					"content": "Oh yes, well said, good sir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "Oh yes, darn her, am I right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
					"content": "Oh yes, it shall soon burst forth!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411203,
					"content": "Oh, \"he\" is coming!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				}
			]
		},
