			"dialogs": [
				{
					"id": 721410101,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410102,
					"content": "Hello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410106,
					"content": "Are you listening to me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410108,
					"content": "Hello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "...Please do not disturb me anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410111,
					"content": "\"He\" is unhappy. \"He\" is displeased with the disturbance caused by \"words of the tongue,\" which drown out the wisdom of the \"words of the heart.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410112,
					"content": "\"Words of the tongue\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "The \"words of the tongue\" are like pouring rain. They shake the eardrums and disrupt the heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410114,
					"content": "The \"words of the heart\" are like fog. They seep in naturally, enshrouding...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410116,
					"content": "Shh...! \"He\" is listening. \"He\" is speaking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410117,
					"content": "Do not use your tongue. Do not use your ears. Listen with your heart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410118,
					"content": "Come here. Worship. Pray. And listen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410119,
					"content": "Remember, worship three times. Three times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410120,
					"content": "(Give it a try.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "I think I'll pass...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "Nod your head if you can speak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
