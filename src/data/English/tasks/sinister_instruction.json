					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "Ah! Uh, sorry... Sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411810,
					"content": "I should not doubt \"his\" choice. Continue to endure, continue to worship...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411811,
					"content": "Can you hear me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "Continue to endure... Continue to worship...",
