			"dialogs": [
				{
					"id": 721410701,
					"content": "Compared with \"his\" great blessings, this is but a small reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410702,
					"content": "Pray. Worship. Listen to \"him,\" and let \"him\" listen to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410703,
					"content": "Then, like me, you will hear \"his\" words coming from your heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410704
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410704,
					"content": "Then \"he\" will lead you out of suffering and grant you a great reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410705,
						721410706
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410705,
					"content": "Well...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				},
				{
					"id": 721410707,
					"content": "Remember. Worship three times a day and you will be rewarded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410708,
					"content": "Remember, remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410706,
					"content": "Whatever you say.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				}
			]
		},
