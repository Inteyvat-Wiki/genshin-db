					"content": "Remember, some will try to cheat you with masks, but \"he\" will help you. \"He\" will always help you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411704,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "That woman is like the kitsune demons of legend. I let her go. \"He\" is very angry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411707,
					"content": "\"He\" is angry again... This is my sin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411708,
					"content": "Please forgive me... I will sacrifice again. I will find a sacrifice for the \"returning\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411709,
					"content": "Please forgive me, please forgive me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411710,
					"content": "Please forgive me, please forgive me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411705,
					"content": "Sure, I guess...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
