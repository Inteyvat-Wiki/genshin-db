			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Washizu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721410601,
					"content": "How is it? Were you fortunate enough to hear \"his\" teachings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410602,
						721410603
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410602,
					"content": "I heard nothing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				},
				{
					"id": 721410604,
					"content": "Ah, it is alright. It is alright. \"He\" sees. \"He\" hears.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410605
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410605,
					"content": "\"He\" is comforted, and those who delight in \"him\" shall be rewarded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410606,
					"content": "\"His\" reward is not on yonder shore. It is tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410607,
					"content": "Do you know what you're talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "Next time you're here, you can see for yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410608,
					"content": "Excuse my shallowness, but I do not understand you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410603,
					"content": "I have not had the fortune to hear anything.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				}
			]
		},
		{
