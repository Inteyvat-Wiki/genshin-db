			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Washizu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411101,
					"content": "Worship, listen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411102,
					"content": "\"He\" is strong because \"he\" listens. \"He\" sees and hears everything because \"he\" is strong. Thus \"he\" sees all there is. Hears all there is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411103,
					"content": "Neither the fools in Sangonomiya nor the madmen of Narukami Island understand it, feel it. So all they know is to fight each other and let the blood blind their eyes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411104,
					"content": "But you must understand that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411105,
					"content": "This logic's a mess...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "The answer lies in worship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411108
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411108,
					"content": "Remember. Worship three times a day and you shall be rewarded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411106,
					"content": "I get it, more or less.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				}
			]
		},
