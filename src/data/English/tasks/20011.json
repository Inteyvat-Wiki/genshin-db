					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200110301,
					"content": "Now the way ahead is clear. Thanks, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110302,
					"content": "Anna's illness never fully goes away. But since we don't have much money, I often come here and gather what medicinal herbs I can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110303,
					"content": "I managed to get the herbs I was looking for, but then that bunch started attacking me out of nowhere. You got here just in time to save me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110304,
					"content": "This is for you. I make tea for Anna with it all the time, it helps with her coughing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110305,
					"content": "You seem like the outdoors type too. Make sure you look after yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
