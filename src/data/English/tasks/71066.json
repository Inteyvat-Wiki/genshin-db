			"dialogs": [
				{
					"id": 710660201,
					"content": "You're back. Did you find it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660202,
					"content": "Take a look. Is this your ring?",
					"roleType": "TALK_ROLE_PLAYER",
