					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "Yes, it is! Thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660302,
					"content": "Please take these as your reward. It isn't much, but please don't feel offended. I'll compose verses to eulogize your deeds!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
