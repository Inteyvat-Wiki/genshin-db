				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "Ahem... My bad. As a poet, I have a propensity for dramatic language and novel tales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "Hehe, truth be told, I found the ring in a Weasel Thieves' nest... It was well-preserved and eye-pleasing, so I kept it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "Hmph, so you're a thief too, you just stole from thieves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Don't say that... I chanced upon it! That's right, it was chance! And though chance it be, the ring is quite precious to me all the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "Do you have any clue concerning the ring's whereabouts?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Yeah... I've heard that Weasel Thieves are often spotted around here. They might've stolen my ring while I was sleeping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Huh, so there really are people who take their rings off before going to bed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "I'd never heard of such people before, either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "Anyway, Paimon doesn't have that habit! You need to think about where to put the ring once you take it off, or you'll be wasting good beauty sleep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "Do they even make rings tiny enough for you, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Hmph, of course they do! There's much you still don't know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Enough. Please refrain from judging other people's way of living before proceeding to ramble on about your own! It's very rude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "...Anyway, if you want to help out... Please keep an eye out for Weasel Thief nests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "I've heard that there is a camp of suspicious Treasure Hoarders around here on the map... I've marked the location out for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "It's said that Weasel Thieves are often spotted around here. Those sneaky Treasure Hoarders probably have something to do with them... Anyway, please take a look there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Hmph... A ring stolen from the Weasel Thieves, which was then stolen again by other Weasel Thieves. Paimon'd say it has gone back to its rightful owner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "Oh, come on, just stop it already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
