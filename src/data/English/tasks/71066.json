			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "Hey there, has something happened recently?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660802,
					"content": "About Weasel Thieves...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "Oh, you mean the ones in The Chasm... I was assigned to take care of them, but I messed up, so there's really nothing much to say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660804,
					"content": "Eh... It's impossible for me to capture them again. They are, after all, masters of hide-and-seek. It's so hard to track them down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660805,
					"content": "But I can help you a bit if these annoying creatures happen to have stolen things from people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660806,
					"content": "Weasel Thieves trained by Treasure Hoarders are fed at fixed hours in a day. There are three types of Weasel Thieves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660807,
					"content": "The Golden Weasel Thief is the most cunning one... Then, there's the more common Hoarder Weasel Thief. The dumbest of all is the Amateur Weasel Thief. Well, as for when they show up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660808,
					"content": "*sigh* There should be a training manual somewhere with the feeding timetable on it, as no one really bothered to remember the exact time. The manual should be in the camp frequented by Weasel Thieves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660809,
					"content": "Ah... I almost forgot this! Give a whistle if you want to summon them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660810
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660810,
					"content": "Give a whistle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660811
					]
				},
				{
					"id": 710660811,
					"content": "Yep, just any old whistle will do. It's not some complicated trick. The key is the timing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		}
	]
}