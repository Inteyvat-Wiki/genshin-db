			"dialogs": [
				{
					"id": 721840301,
					"content": "Traveler, you've returned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840302,
					"content": "How did it go, any feedback?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840303,
					"content": "About the customers' feedback...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Pizza made with Lavender Melon... That's not too complicated...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840305,
					"content": "The rest of the ingredients just need to be prepared as usual. Well, since the feedback said to \"incorporate some of Inazuma's local ingredients,\" then I can add some other ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840306,
					"content": "Hmm, Sea Ganoderma? Naku Weed? Oh, how about Fluorescent Fungus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840307,
					"content": "Umm, need some help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "Oh! I'm sorry, I was busy thinking about what ingredients to put in! Let's see, I don't think there's much Lavender Melon left in the store...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840309,
					"content": "Traveler, please help me get a Lavender Melon. When it comes to ingredients...this should be all that's missing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840310,
					"content": "I'm on it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "Mm, I'm counting on you, then. Just one Lavender Melon will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840312,
					"content": "Do you need other ingredients?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "There are still some other ingredients in stock in the store. Just bring back a Lavender Melon, please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
