					"nextDialogs": [
						721840503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840503,
					"content": "It's done!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840504,
					"content": "This pizza looks... pretty good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840505,
					"content": "Thanks for your help, Traveler. Here, these are for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840506,
					"content": "I'll make sure to savor this pizza's taste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840507,
					"content": "If it's not bad...it should be officially launched as a new dish soon.",
