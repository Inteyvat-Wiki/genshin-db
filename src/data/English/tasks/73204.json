	"talks": [
		{
			"id": 7320401,
			"completionStepIds": [
				7320401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
