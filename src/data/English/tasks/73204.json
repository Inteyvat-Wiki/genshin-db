			"dialogs": [
				{
					"id": 732040601,
					"content": "Phew, commission complete! Paimon's a little hungry after all that running around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040602,
					"content": "I was the one running though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040603
					]
				},
				{
					"id": 732040603,
					"content": "Well, Paimon was providing running commentary. That takes energy too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040604,
					"content": "Don't sweat the small stuff! How about we use our payment to buy ourselves a treat, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040605,
					"content": "C'mon, let's see how much we got and how many meals we can buy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040606,
					"content": "Let's see...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040607
					]
				},
				{
					"id": 732040607,
					"content": "Ah, most of the stuff here is food instead of Mora... Shawarma, Tahchin, and lots of vegetables.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040608,
					"content": "This is way too much. Did we take a whole day's rations away from Grandpa Affan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040609,
					"content": "But he lives alone outside the village. It can't be easy for him, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040610,
					"content": "Never mind the Mora. If he gave us all his rations, then... It just feels wrong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040611,
					"content": "And he was planting seeds that looked like stones, saying that he was planting... a wish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
