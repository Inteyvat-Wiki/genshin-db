					}
				]
			},
			"dialogs": [
				{
					"id": 747020101,
					"content": "Oh, you've been bringing back so many fish lately. The aquarium is starting to look like a real ocean habitat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020102,
					"content": "Hehehe, we're practically pro fishie-fetchers already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "You appear to take great pride in your work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020104,
					"content": "You betcha! But behind the sense of accomplishment, there's something else... something more like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "Regret?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "Yeah, that's it! That's how Paimon's feeling underneath.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "Why is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020109,
					"content": "Paimon's not sure... It just feels like something's missing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "Maybe a restaurant?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "Hey! Don't say stuff like that! How could anyone bear to eat such beautiful fishies!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "We're missing visitors to come and admire our amazing handiwork!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "You're saying... you want to open the aquarium to visitors?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020116,
					"content": "Would that not be okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "Are you worried it'll be too noisy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "If that's the case, just leave everything to us! We'll take care of advertising and all the day-to-day stuff — you just focus on your own work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "If that's what you want...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020121,
					"content": "We can split the revenue 30/70!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "Huh...? We only get 70%?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "No, Sandrone gets 70%.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Oh, right, of course... Sandrone is the one renting this boat, after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "Ugh, you make me sound like some sort of tyrannical landlord. You're putting in the work, so you should get the lion's share. I'm not stingy like Pantalone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020126,
					"content": "So that means... you're giving us the all-clear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Sure, you have my blessing. Just make sure it doesn't get in the way of my research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020128,
					"content": "Woohoo! The Wingalet Gloop-Gloop Funderwater Fisharium is officially open for business!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "*sigh* Of course you already thought of a name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020118,
					"content": "Are you worried it'll cause lots of problems?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "Maybe visitors?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "Oh! That's it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020106,
					"content": "Loneliness?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}