			},
			"dialogs": [
				{
					"id": 10213101,
					"content": "So, have you made your choice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213102,
					"content": "You don't have to confirm it with me. Just choose one and take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213103,
					"content": "Afterwards, why not sit down for a while in the Jade Chamber, or have a short stroll? Rest is also an integral part of any journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213104,
						10213106
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213104,
					"content": "Thank you for your hospitality.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "Come now, there's no need to stand on ceremony. Loosen up a little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213106,
					"content": "It's time we made a move. See you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213107
					]
				},
				{
					"id": 10213107,
					"content": "Alright then. I hope the next time we meet, you will either have already done the right thing... or, will be about to make the right call.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		}
