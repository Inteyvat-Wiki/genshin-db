			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210201,
					"content": "Huh? Is it just Paimon, or is there a sweet fragrance in the air...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210202,
					"content": "Huh... Did you hear that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210203,
					"content": "It sounded like someone calling for help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "It seemed like it came from those ruins over there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210207,
					"content": "Uh oh, it looks like the Treasure Hoarders have locked someone inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210205,
					"content": "It sounded like someone was singing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "Uh, no! That was definitely someone in trouble! It came from those ruins over there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102103,
			"completionStepIds": [
				102103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102103",
							"2"
						],
						"stepId": 102103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bu'yun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(According to Keqing, this is what we should say...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Excuse me, do you sell the moon here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "Yes. How many would you like?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210304,
					"content": "It is not convenient to speak of numbers here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "Ah, well said. Please, use this to ascend to the Chamber... Ah, yes. Speaking of which — are you two the guests that Lady Ningguang has arranged to meet with today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210306,
					"content": "Yup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(And yet the code they used was not the one for guests, but for the Yuheng. What's going on here...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bu'yun"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102104",
							"2"
						],
						"stepId": 102104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "I've been waiting for you, returnee from Jueyun Karst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210402,
					"content": "Ah, it's Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210403,
					"content": "Since this is our first meeting, um, we've prepared a gift! Hope you like it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210404,
					"content": "Oh, for me? You have my thanks. It seems that I have made things difficult for you, considering that you were supposed to be my guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210405,
					"content": "Hehe... Oh no, it's nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210406,
					"content": "Nice place, this Jade Chamber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "Haha. I'm glad you like it too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210409,
					"content": "This palace floats in the skies, higher than the peak of any mountain. From this vantage point, one may survey all of Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210410,
					"content": "I have been gathering the funds necessary to build it from the time I began learning the merchant's craft. And since becoming the Tianquan, I have spared no effort in hiring the best craftsmen to constantly extend it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210411,
					"content": "At first, it was but the size of one room. Now, it is large enough to blot out the moon in the skies above Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210412,
					"content": "One day, I believe it will overshadow all seven nations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210413,
					"content": "(This Tianquan does not lack for ambition...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "Not many from outside Liyue earn the right to ascend to the Jade Chamber. But I have been in correspondence with the Acting Grand Master of the Knights of Favonius, who spoke highly of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210415,
					"content": "As such, I have been putting eyes and ears out ever since you reached Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210416,
					"content": "What!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210417,
					"content": "And I finally got wind of your movements when you were on the way to Wangshu Inn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210418,
					"content": "...Wait. Was Verr Goldet one of your people!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210419,
					"content": "Just Verr Goldet? ...No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210420,
					"content": "Everyone at Wangshu Inn is one of ours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210421,
					"content": "##@&%*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210422,
					"content": "We also ran into the Yuheng not long ago...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "At the Guizhong Ballista, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210424,
					"content": "Uh... you weren't peeking on us from the skies the whole time... were you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210425,
					"content": "Haha... I fear that peeking would have been a little difficult from this altitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210426,
					"content": "Our eyes and ears are more than sufficient. You two are very interesting people, after all. It would be natural to take an interest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210427,
					"content": "Keqing said that the Qixing would not wish ill on Rex Lapis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "Well, I wouldn't expect you to trust us, considering that you have had far more interactions with the adepti. The reason I invited you here was to clear up some misunderstandings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210408,
					"content": "It's my first time coming to a place this high up...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
			"completionStepIds": [
				102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102106",
							"2"
						],
						"stepId": 102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "Wowee! What a huge hall! Paimon's never seen such a fancy place before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210602,
					"content": "Be at ease, you two. Make yourselves at home if you wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210603,
					"content": "Can we really!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210604,
					"content": "I have invited you two here as friends. And when friends come over to play, our enjoyment comes first, naturally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210605,
					"content": "Is that what I think it is...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "Ooh! Isn't this that legendary wall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210607,
					"content": "Why, you've kept your ear to the ground, I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210608,
					"content": "That's because even the storytellers are talking about it... Everyone's after a piece of paper from that wall. It's super famous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210609,
					"content": "That's because that wall records Liyue's secrets. Merchants have always been attracted to secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210610,
					"content": "But the secrets of the mercantile world are of no interest to you, are they, Traveler? You're rather special, really — and I think you're quite aware of that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210611,
					"content": "If possible, I'd like to have your trust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210612,
					"content": "But if you were to choose the more trustworthy person between myself and Keqing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210613,
					"content": "Well, between your orthodoxy and her heterodoxy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "Haha... You'd pick Keqing? I had a feeling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210616,
					"content": "I originally thought her a bit too... hard-headed. With someone of her character on the Qixing, I've had some extra messes to clean up behind the scenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210617,
					"content": "But after she said those words: \"The time of the adepti has long passed. If even the Liyue Qixing don't want to face that truth, then what future is there for Liyue...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210618,
					"content": "Well, I must say that quite a few of my doubts have been dispelled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210619,
					"content": "I won't deny that Rex Lapis' passing seems advantageous to us. But for Liyue's sake, we cannot allow ourselves to be shackled by rumors of our usurpation of power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210620,
					"content": "I surmise that the Fatui has a hand in these rumors?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "Indeed... It seems that you understood what I meant to say from the very beginning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210622,
					"content": "I called for the gag order and for the Exuvia to be hidden to temporarily stabilize the situation, and also to prevent something similar to the incident in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210623,
					"content": "With Rex Lapis' death, the Fatui have busied themselves with many clandestine actions beyond their diplomatic remit. As the Tianquan, one responsible for Liyue, I cannot be too concerned with appearances when opposing them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210624,
					"content": "Allowing the Rite of Parting to take place was also meant to buy some time for us to take control of Liyue's administration...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210625,
					"content": "Ugh... It's exactly as Zhongli said. The Qixing only provided the venue for the rite so they could use us for their own ends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210626,
					"content": "Wait, that's right! Speaking of ends... Could Paimon say one other thing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210627,
					"content": "Of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210628,
					"content": "Paimon's heard that anyone who sends a greeting gift gets a little something in return... So, does that include us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210629,
					"content": "Seriously, Paimon? Seriously?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "Hmm-hmm, It's alright. I like direct people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210631,
					"content": "Well, we have made quite a bit of trouble for you recently. How about this? You can pick any one object here as you please, and you may take it with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210632,
					"content": "Yay! Paimon was just waiting for you to say that! Let's see, what should we get...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210633,
					"content": "One of the <color=#00E1FFFF>sheets</color> on that wall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210634,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "Don't look at Paimon like that! One of these sheets of paper will sell for crazy prices, even if it's only as large as Paimon's fingernail!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210636,
					"content": "Just imagine... how much Mora a whole, untorn sheet would sell for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210614,
					"content": "I'd go with Keqing and her skepticism of the divine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
		{
			"id": 102108,
			"completionStepIds": [
				102108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102108",
							"2"
						],
						"stepId": 102108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Meng Dan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210801,
					"content": "Phew... Thank you for your help, kind travelers. If you hadn't come to my aid, I surely would have rotted in this cell! Those Treasure Hoarders... when their mood was good, they'd rearrange those pots of Sweet Flowers. But when they were in a bad mood, they'd rearrange my face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210802
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210802,
					"content": "Aw, it was nothing. No need to thank us all at once or anything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210803,
					"content": "Haha, I understand. Don't worry, I will compensate you both.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210804
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210804,
					"content": "There's really no need.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210805
					]
				},
				{
					"id": 10210805,
					"content": "Don't say that! I only escaped this predicament because of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210806
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210806,
					"content": "I'm Meng Dan, a supplier for Mingxing Jewelry in Liyue Harbor. I often walk around these mountains in search of antiques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210807
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210807,
					"content": "I never expected that those Treasure Hoarders would have their eyes on the same ruins that I had. Before I knew it, they'd caught and imprisoned me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210808
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210808,
					"content": "Is there anything that you lack? Antiques, treasure, various knick-knacks, you name it! Well, as long as you want what I have to offer, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210809
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210809,
					"content": "Your goodwill is good enough for me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210810
					]
				},
				{
					"id": 10210810,
					"content": "Wait a moment! Actually, we are looking for something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210811,
					"content": "Oh? And what might that be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210812
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210812,
					"content": "Do you have a box that can store presents? We'd like a pretty one... the kind that you can use to store snacks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210813,
					"content": "Of course we do — how can one sell antiques without gift boxes? At <color=#00E1FFFF>Mingxing Jewelry</color>, we have the best gift-wrapping service in the seven nations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210814
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210814,
					"content": "Now, just give me a moment, and I'll let the boss know. You can go see her whenever you require that box.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210815
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210815,
					"content": "Great! Paimon's Sugar-Frosted Slime now comes in a beautiful package!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102111,
			"completionStepIds": [
				102111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102111",
							"2"
						],
						"stepId": 102111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211101,
					"content": "Hey there! A guy called Meng Dan told us that we could get a nice and shiny box from your store...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211102,
					"content": "Uncle Meng already told me about it. Thank you both for saving him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211103
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211103,
					"content": "Many of the best goods in our store were found by Uncle Meng. If anything were to happen to him, it would be impossible for us to continue doing business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211104
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211104,
					"content": "Here, this container is itself an antique, with at least 140 years of history. It's already been cleaned... Will it do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211105
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211105,
					"content": "Yup-yup-yup! It's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211106,
					"content": "Hang on a moment. Could we borrow one other thing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211107,
					"content": "Sure, please help yourselves — as long as it's on our shelves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211108
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211108,
					"content": "#{NICKNAME}, this clay pot looks really awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211109,
					"content": "If we use an antique as our mixing bowl, we should be able to make a great snack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211110,
					"content": "It's done! The one and only Sugar-Frosted Slime! Carefully now. Into the box it goes, and dust it over with a bit more powdered sugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211111,
					"content": "Oh yes. You might want to use these two freshly-picked flowers as decorations too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211112
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211112,
					"content": "Woohoo! It looks beautiful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211113,
					"content": "(I'm still not sold on this gift idea...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211114
					]
				},
				{
					"id": 10211114,
					"content": "Great! Now that we've put all that we've got into this box, let's go to the Jade Chamber to see Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102112,
			"completionStepIds": [
				102112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102112",
							"2"
						],
						"stepId": 102112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211201,
					"content": "Huh? Well that was an easy search. The biggest sheet is right up there in the most obvious spot. Let's go with that one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211202,
					"content": "La la-la la-la... Let's see what's written on it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211203,
					"content": "Huh? There's a place marked with a circle on here. Ooh, could it be treasure!? Whatever it is, it better make us filthy rich! Let's see what's written over here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211204,
					"content": "\"Sigil...\" \"of Permission...\" Something, something... \"Fatui...\" \"research...\" \"copy...\" Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211205,
					"content": "Aw, that doesn't sound like treasure at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211206,
					"content": "This piece of paper shows that a Qixing spy discovered traces of classified Fatui research on the <color=#00E1FFFF>Sigil of Permission</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211207,
					"content": "Oh, Ningguang did say that the Fatui have been up to all kinds of mischief in the shadows of Liyue... Spreading rumors, wanting to get their hands on the archon's body, and what not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211208,
					"content": "But research on the Sigil of Permission? Paimon wonders what they're up to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211209,
					"content": "#Speaking of which, there's also some connection between you and the Sigil of Permission, {NICKNAME}. Seems there's still more for us to find out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211210,
						10211211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211210,
					"content": "It's all unfolding a little too perfectly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				},
				{
					"id": 10211212,
					"content": "Oh? You really think so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211213,
					"content": "Well... should we not go, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211214,
					"content": "No, what I mean is...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211215
					]
				},
				{
					"id": 10211215,
					"content": "Oh, so you're saying that it's precisely because we can't completely trust Ningguang that we should confirm the truth of what she says for ourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211216,
					"content": "Hmm... That's way out of Paimon's league, Paimon thinks she's been nothing but good to us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211217,
					"content": "Anyway, we'll see if you're on to something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211218,
					"content": "Um, before we look for Zhongli at Dihua Marsh, let's go to the place marked out on these papers and see if the Fatui really are up to no good there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211211,
					"content": "Ningguang is clearly trying to steer us there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				}
			]
		},
		{
			"id": 102113,
			"completionStepIds": [
				102113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102113",
							"2"
						],
						"stepId": 102113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "I believe that you've heard of the Archon War?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211302,
					"content": "Umm... Rings a bell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "Many gods used to walk this earth, and many long wars were fought between them that did not abate until 2,000 years ago. Much blood was shed, and many lives were lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211305,
					"content": "In the end, only seven victors remained standing in Teyvat. They built cities and nations on the corpses of the vanquished, and thus began the era of The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211306,
					"content": "You can see Guyun Stone Forest from here, I trust? It is no natural rock formation — those are giant spears of rock, hurled by Rex Lapis during the war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211307,
					"content": "Beneath the spears lie those cast down by Rex Lapis in those days: gods that failed to seize the title of Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211308,
					"content": "Not only is it true that gods may die, but so too has the membership of the Seven changed over the last two millennia. Rex Lapis' passing is an unimaginable disaster for Liyue, but the order of The Seven will not collapse simply because of that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211309,
					"content": "Another Lord of Geo will arise sooner or later, yet how are we to forget Rex Lapis? When that time comes, the relationship between the people of Liyue and the gods and adepti will surely be different from before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211310,
					"content": "Even in a new era, the Liyue Qixing remain Rex Lapis' former subjects... Do you really think us capable of having played a part in his demise? Of lacking the foresight to see the certain repercussions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211311,
					"content": "Why hide the Exuvia, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "Heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211313,
					"content": "That day at Yujing Terrace — it was all so very sudden. Even I was caught completely off guard. You were there, you no doubt saw.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211314,
					"content": "But our enemy has long lain hidden within the harbor. If we do not act against them now, they will surely gain the upper hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211315,
					"content": "Hiding the Exuvia was a necessary maneuver to take the initiative back, to play the spider while our foes scurry about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211316,
					"content": "Who's this \"enemy\" you're talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211317,
					"content": "What do you think, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211318,
					"content": "Is it \"him\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "Eh? What are you two talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211321,
					"content": "Well answered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211322,
					"content": "...Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211323,
					"content": "Hah... The scenery out here is fine indeed, but the wind is a little strong. Our preparations to receive guests within are complete — so please, this way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211319,
					"content": "It's \"him,\" isn't it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "Only in the broadest of strokes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
