			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090201,
					"content": "That Prayer Rack looks like it's been kaput for a very long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "Oh, hello there, Traveler. Miss Etsuko and I are currently investigating the area around this shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Even though the various shrine facilities have long fallen into ruin... It does have them all nonetheless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "People from the nearby villages must have all come to this place to pay respects. I suppose that its ruin must have something to do with the abandoned Koseki Village...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220904",
							"2"
						],
						"stepId": 7220904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "Meow, meow, meow... That wooden shelf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090302,
					"content": "I've fixed it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "Oho! Have you indeed? Ah, this shrine looks yet more the part now! Meow, meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090304,
					"content": "Now then, go and tell those two green humans that the shelf has been fixed, and that they can now hang wooden blocks on it. And while they are at it, they can bring some other people to come and pay respects and stuff the box with Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090305,
					"content": "Not going to tell them yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "No! Th—That green, tall human is very scary. H—He can read the hearts of cats... My guise is no match for his keen eyes! Meow, meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090307,
					"content": "Not to mention how he gets far too excited each time he talks to me... Meow, meow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220905",
							"2"
						],
						"stepId": 7220905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "Hello there, Traveler. What can I do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090402,
					"content": "The Prayer Rack's been fixed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "It is? You fixed it? You're a kind soul, aren't you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090404,
					"content": "I was commissioned by the provisional head priestess.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "L—Lady Neko commissioned you to do it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090406,
					"content": "Has she noticed our actions, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090407,
					"content": "I wouldn't totally say so...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "Miss Etsuko! Let's go over to where the Prayer Rack is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090410,
					"content": "First the Offering Box, now the Prayer Rack...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090411,
					"content": "This provisional head priestess really is serious about repairing the shrine, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090412,
					"content": "But the inhabitants around these parts all migrated long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090413,
					"content": "In short, no one on this island's coming to pay respects at this shrine but us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090414,
					"content": "What are you trying to say, Miss Etsuko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090415,
					"content": "...Has that provisional head priestess realized this yet? What motive does it have for repairing that shrine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090416,
					"content": "...Never mind, maybe I'm just letting my suspicion get the better of me. We can go over to that Prayer Rack, no problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090417,
					"content": "But I'd call remaining on guard the right option.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090418,
					"content": "Miss Etsuko, Lady Neko is just a cat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090408,
					"content": "You could say that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
		{
			"id": 7220905,
			"completionStepIds": [
				7220906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
