			},
			"dialogs": [
				{
					"id": 722090601,
					"content": "I have espied those two green humans preparing to hang up Prayer Plaques. You are indeed a reliable pair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090602,
					"content": "Well, once they're done, I am sure that they will inform other humans, and that those will visit this shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090603,
					"content": "Meow, meow, meow... It seems that besides \"cleanup\" and fixing that box, this rack, too, is very important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090604,
					"content": "Good, very good. Meow meow meow! At this rate, the shrine will surely be restored to liveliness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090605,
					"content": "Why do you want to restore the shrine, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "Unya, meow... Why, indeed... I am the provisional head priestess, after all. It is my duty to care for the shrine, to have many people pay respects here, to make this shrine a lively place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090607,
					"content": "Also, Hibiki would be most grieved should she return and find this shrine all broken-down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090608,
					"content": "Meow, meow, but with your aid, it shall surely return to its former glory in no time at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090609,
					"content": "I might still require your help from time to time, meow. Don't you decline when the time comes, now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
