			"dialogs": [
				{
					"id": 740310101,
					"content": "Young warrior, will you spar with me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310102
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310102,
					"content": "Uh, this is super sudden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740310103,
					"content": "#Whatever you say, {M#lad}{F#lass} with golden hair. I can tell that you're a veteran with just one look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310104,
					"content": "I'm really bored, because no one has been sparring with me. If you will, I'll give you Coupons! I won a lot of those from Roussimoff, and I haven't figured out how to spend them yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310105,
					"content": "How about it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				}
			]
		},
