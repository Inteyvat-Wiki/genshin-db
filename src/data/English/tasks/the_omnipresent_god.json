			},
			"dialogs": [
				{
					"id": 20210101,
					"content": "So what did you guys do in the Raiden Shogun's Plane of Euthymia anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210102,
					"content": "Is the Vision Hunt Decree abolished?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210103,
						20210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210103,
					"content": "It was all thanks to Yae Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				},
				{
					"id": 20210105,
					"content": "Oh, gotcha... Paimon was super worried, y'know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210106,
					"content": "So maybe the reason Yae Miko is looking for us now is 'cause she wants to thank us? Let's go find her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20210104,
					"content": "We conveyed the wishes of the people.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210105
					]
				}
			]
		}
	]
