	"talks": [
		{
			"id": 202003,
			"completionStepIds": [
				202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202003",
							"2"
						],
						"stepId": 202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raiden Shogun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Indulge my curiosity. What is the reason that I find you standing here before me once again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200302,
					"content": "Do you hope your foolhardiness will shelter those people? Or... was it simply a means of seeking an audience with me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200303,
					"content": "The Fatui have deceived the Raiden Shogun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "Oh? Surely you didn't rouse me from my state of eternal meditation only to tell me this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200306,
					"content": "If so, then you underestimate me. I am quite well-informed about the Vision Hunt Decree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200307,
					"content": "You know everything that's going on outside?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Not so. Only everything that pertains to eternity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200309,
					"content": "The Vision Hunt Decree has my tacit approval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200310,
					"content": "The Fatui's actions thus far do not constitute a threat to eternity, otherwise... they would have been purged long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200311,
					"content": "But the Vision Hunt Decree is damaging.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "Individual ambition is inherently incompatible with eternity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200314,
					"content": "What you might not realize is that all too often... people have far more to lose by chasing their dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200315,
					"content": "Consider this — no one will lose their life on account of having their Vision taken away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200316,
					"content": "Rather, those who have lost their lives are the ones who insisted on pursuing their own aspirations, are they not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200317,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "Traveler, your existence is unique in my eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200319,
					"content": "There seems to be limitless uncertainty in you. To put it another way, you are the furthest thing from eternity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200320,
					"content": "So I won't insist that you comprehend the meaning of my actions. What matters is that I tread the path of eternity on my people's behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200321,
					"content": "This is your Plane of Euthymia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "It is created by your consciousness, yes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "That's right. I'm surprised you understand it so well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200324,
					"content": "Anyway. You're looking for a chance to shake my will... aren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200325,
					"content": "I'm not here to debate your ideas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "I'm here to demolish them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200328,
					"content": "So be it. Well then, you who would defy eternity... Time for you to enlighten me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200312,
					"content": "It comes at a great cost to the people of Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "The Vision Hunt Decree should never have existed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Raiden Shogun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "You've lost, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200503,
					"content": "...Yes, I have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200504,
					"content": "Why can you not trust your people, and in the power of their ambitions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "These ambitions have transcended space and time. They are something that no one can snuff out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "When people move forward with all their might...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "Is this the lesson you learned from your journey in Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "There are nations where humans cast their god aside and stride forward...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "So, are we to just abandon the notion of progress... for the sake of wishful thinking?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "...You and I have both witnessed the great loss that progress can bring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200514,
					"content": "Eternity... eternity is the only way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200515,
					"content": "The Heavenly Principles... Irrelevant nonsense as far as I am concerned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "When all's said and done, all you really want is to protect your beloved Inazuma, forever and ever. Isn't that right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "That would be something of an oversimplification.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200518,
					"content": "But is this nation worth existing for eternity?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Stripped of ambitions, stripped of the potential for change, it does nothing more than simply... exist. It is a hollow shell of a nation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Huh. I wonder what loss would it really be to anyone if such a nation were destroyed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Miko, retract your words.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200522,
					"content": "Never-changing eternity is the promise I made to my people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200523,
					"content": "But what your people need from you is not your promises. They want your attention... your divine gaze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "...You mean Visions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200525,
					"content": "Humans have a lifespan of barely a hundred years. They cannot afford to bear any extra losses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200526,
					"content": "But I have experienced it all. That is why I have chosen to guide them along the correct path toward eternity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200527,
					"content": "*sigh*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "But eternity is far too cruel a fate for you, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "For me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200530,
					"content": "Not only have you stopped paying attention to the world, but you have stopped paying attention to yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "It must have been terribly lonely here, all alone, for centuries on end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "But it is necessary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200533,
					"content": "You will miss much by refusing progress... You seek to prevent loss, but have you considered all you are losing by remaining here in stasis for all eternity?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "You are obviously lonely, and yet for the sake of eternity you choose to stretch your loneliness out to infinity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Tell me this. Why is the sky here that was once so dark glowing again? Why now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "This is your Plane of Euthymia. It's your inner world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "So it can only mean... that you are happy to see me again. You have found the loneliness here unbearable for a long time now, haven't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "I... have nothing to say to that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200539,
					"content": "Hehehe, oh, but I have so much to say to you. Let me tell you all that has happened over the last few centuries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "How long will that take?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200541,
					"content": "As a fox envoy, I have an excellent memory. I recall every detail of the last few centuries with perfect clarity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "So it will probably take me another few centuries to relay it to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Heh... hehe... Miko, I never thought I would have the chance to meet with you like this again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200544,
					"content": "*sigh* Seeing you again is a change to eternity... and a very nice surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200545,
					"content": "Hehe, since you are willing to admit that, I suppose that means we can still be friends?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "What a childish conversation this is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200547,
					"content": "Anyway. Now that I have been defeated by you and your plan, I will honor your wish to abolish the Vision Hunt Decree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200548,
					"content": "But with regards to eternity and the question of whether this nation should move forward, I need time to give it some thought.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Raiden Shogun"
				},
				{
					"id": 20200549,
					"content": "Hehe, you are the one who's been acting like a child from the very beginning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "They can surpass the gods' expectations.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "And even take over the work of the gods.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
