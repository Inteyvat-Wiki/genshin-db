			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400201,
					"content": "Huh, looks like Timaeus isn't here today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400202,
					"content": "(Customers!?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400203
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400203,
					"content": "Oh! Um... Pardon me, are you looking for Timaeus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400204
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400204,
					"content": "No no! Just strange for him to not be around. Paimon always sees him standing here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400205,
					"content": "I see. He was called away by Albedo a little while ago. I was called over to attend to the store.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400206
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400206,
					"content": "I'm Sucrose, Albedo's assistant. If you have any alchemy-related queries, you could always ask me. I'd... do my best to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400207,
						110400209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400207,
					"content": "Again, with confidence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400208
					]
				},
				{
					"id": 110400208,
					"content": "I... Actually, I'm not very good at this kind of thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400211,
					"content": "M—My apologies, I don't get out too often. I'm usually in the laboratory, where there aren't many others to talk to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400212,
					"content": "If you need any help, just call my name. If not, I'll... I'll be reading a book — over there. Mm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400213
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400213,
					"content": "#Mm-hmm, thanks! No worries, we're all clued up on the basics of alchemy, aren't we, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400214,
						110400215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400214,
					"content": "Mm-hmm, no need to trouble you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400216,
					"content": "#{NICKNAME}... Hey, aren't you the legendary Traveler? The one who repelled Stormterror?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400217,
						110400218
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400217,
					"content": "\"Legendary\" is a bit much.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400220
					]
				},
				{
					"id": 110400220,
					"content": "I've heard so many stories about you! Always wanted an opportunity to research you up close!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400221,
					"content": "Uhh, what do you mean, \"research\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400222,
					"content": "Ah! Sorry, don't mind me, what am I saying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400223
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400223,
					"content": "Still, you'd definitely be able to help Albedo. It is you after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400224
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400224,
					"content": "There's that name again! \"Albedo.\" Is he also an alchemist in Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400225,
					"content": "Not a name I'm familiar with.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "Apologies, I never introduced him. Albedo is the Knights of Favonius' Chief Alchemist. He's also Timaeus' and my teacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400228,
					"content": "But Paimon's only ever seen Timaeus teaching alchemy. So that means... Albedo is a teacher-teacher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400229,
					"content": "Yes, he's dedicated himself to investigating the truth of this world, and has made many an important breakthrough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400230,
					"content": "We often get alchemists coming to Mondstadt from all over Teyvat, seeking his help. They say that the subtlest of guidance from Mr. Albedo helps them to solve the most unfathomable of problems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400231,
					"content": "Wow, Paimon didn't know he was such a big deal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400232,
					"content": "Mm-hmm. Still, it seems that he's encountered a problem in his research recently. Every time I see him, he has a concerned look on his face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400233,
					"content": "I'm not sure someone as smart as him could use my help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "I'm sure that Albedo would love to hear about your incredible exploits. I know it would bring him lots of new inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400236,
					"content": "Albedo is a true gentleman. He'll be sure to pay you back in equal measure for helping him out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400237,
					"content": "Can he make me stronger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "I don't see why not. Testing the limits of living beings' capabilities is one of Albedo's areas of research after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400241,
					"content": "Albedo and Timaeus will be conducting research in the mountains right now. I'd love to take you both to see him, but somebody has to attend to the store.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400242,
					"content": "I'm afraid you'll have to go to the entrance to the pass and look for him by yourselves. Look out for a refined gentleman with the presence of a true scholar, and... umm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400243,
					"content": "...Sorry, that's the best I can do. You'll have to do your best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400244,
					"content": "Hey, stop worrying! We got this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400239,
					"content": "Can he make Paimon stronger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "Uhh, Paimon doesn't need any help in that department. But if Albedo wants to pay Paimon back for helping him, a few Mora might settle the score. Tee-hee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400234,
					"content": "My knowledge of alchemy stops at basic crafting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "Think I might have heard of him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400218,
					"content": "And I don't even charge for autographs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400219
					]
				},
				{
					"id": 110400219,
					"content": "Ah! Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400220
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400215,
					"content": "I... might need a refresher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400209,
					"content": "No need to be nervous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400210
					]
				},
				{
					"id": 110400210,
					"content": "Huh? D—Do I look nervous?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
			"id": 1104003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104002",
							"3"
						],
						"stepId": 1104002,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104003",
							"2"
						],
						"stepId": 1104003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400301,
					"content": "My apologies, I don't really know how else to describe him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400302
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400302,
					"content": "If I could sketch you his portrait I would, but my pencil strokes are no match for his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
			"id": 1104004,
			"completionStepIds": [
				1104004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104004",
							"2"
						],
						"stepId": 1104004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rosaria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400401,
					"content": "S—Sister Rosaria, so here you are! Choir practice is about to—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400402
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400402,
					"content": "I've told you already, I don't go in for that kind of thing. I've got more important matters to attend to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400403,
					"content": "But... this event has commemorative significance. The church hopes that all sisters will be present...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400404
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400404,
					"content": "\"Hopes\"!? That's odd, 'cause I don't recall a \"fulfill the hopes of others\" clause in my job description.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400405
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400405,
					"content": "I— I mean sure, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400406
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400406,
					"content": "But what? You're the event organizer, aren't you? Do you not find it the least bit odd...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400407
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400407,
					"content": "Wh—What do you mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400408
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400408,
					"content": "This far out from Mondstadt, at this hour? Even if you set out right now, I'll wager you'd still miss the opening ceremony.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400409
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400409,
					"content": "Who knows? Maybe this is someone's grand plan to make a fool out of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400410
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400410,
					"content": "Huh!? Th—That can't be! People aren't like that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400411
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400411,
					"content": "Hah! Evidence decides what people are like, not your feelings. *sigh* Maybe you're a little too trusting of other people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400412
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400412,
					"content": "Don't fret, nobody's gonna blame you if you go back empty-handed. I can't imagine anyone else was delusional enough to think I was gonna show up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400413
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400413,
					"content": "But if you dally any longer, you really won't make it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400414
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400414,
					"content": "...You're right! It's a very important commemorative event. If I'm late, then... R—Right, I've got to get going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400415
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400415,
					"content": "Hmm, seems like that sister's an expert in making people believe anything she wants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400416,
					"content": "I thought I heard something — who are you, and why are you eavesdropping?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400417
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400417,
					"content": "We'd better watch out! She seems like a dangerous villain... Or a trickster at best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400418,
					"content": "Oh really? I'm a member of the long-standing Favonius Church. You're an eavesdropping pixie from who knows where, and you think I'M the trickster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400419
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400419,
					"content": "Wait, she heard that!? But Paimon was whispering so quietly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400420,
					"content": "And as for this outlander you seem to be following... Huh — so it's you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400421
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400421,
					"content": "The Honorary Knight that saved us from Stormterror. Well, then, given your status, I won't press you on your reasons for eavesdropping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400422
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400422,
					"content": "Otherwise, depending on your answer, I could've arrested you on the spot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400423
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400423,
					"content": "What!? Do the sisters of Mondstadt have the authority to arrest people now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400424,
					"content": "We can't go turning a blind eye to hidden dangers can we? Why shouldn't Sisters have a sense of justice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400425
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400425,
					"content": "Hmph, that doesn't sound right. But Paimon can't think of a good comeback...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400426,
					"content": "Let's talk about you. What are you doing in the mountains?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400427,
						110400428
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400427,
					"content": "We're looking for Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400431
					]
				},
				{
					"id": 110400431,
					"content": "If it's him you're after, I made a point of noting his tracks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400432
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400432,
					"content": "Many people have made their way up after the snowstorm. Let's hope they're still there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400433
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400433,
					"content": "So... are you also looking for him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400434,
					"content": "No, this is just a professional habit of mine. I sensed elemental traces in these tracks. Never hurts to be vigilant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400435,
						110400436
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400435,
					"content": "As far as sisters go, you're fairly mysterious.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400437,
					"content": "I couldn't care what you think. Come on then, I'd like to see what he's up to anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400436,
					"content": "You're more like a detective.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400428,
					"content": "We're investigating the truth of this world.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400429
					]
				},
				{
					"id": 110400429,
					"content": "But you're only a traveler, I doubt you have any great skill in alchemy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400430
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400430,
					"content": "Whatever, I had a notion of who you were seeking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400431
					],
					"speakerTitle": "Rosaria"
				}
			]
		},
		{
			"id": 1104005,
			"completionStepIds": [
				1104002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104002",
							"2"
						],
						"stepId": 1104002,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066501",
							"3"
						],
						"stepId": 7066501,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400501,
					"content": "Huh? Looks like Timaeus isn't here today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400502,
					"content": "(Hm? Wait, are these two...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400503
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400503,
					"content": "#Oh! Um... Hello, {NICKNAME} and Paimon. Pardon me, are you looking for Timaeus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400504
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400504,
					"content": "No no! Just strange for him to not be around. Paimon always sees him standing here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400505,
					"content": "I see. He was called away by Albedo a little while ago. I was called over to attend to the store.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400506
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400506,
					"content": "If you need any help, just call my name. If not, I'll... I'll be reading a book — over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400507
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400507,
					"content": "#Mm-hmm, thanks! No worries, we're all clued up on the basics of alchemy, aren't we, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400508,
					"content": "Mm-hmm, no need to trouble you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400509
					]
				},
				{
					"id": 110400509,
					"content": "I guess it's no surprise coming from the one who repelled Stormterror...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400510
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400510,
					"content": "Actually, since it's you... I bet you're someone who'd be able to help Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400511
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400511,
					"content": "There's that name again: \"Albedo.\" You and Timaeus mentioned him the last time we met, right? Is he also an alchemist in Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400225,
					"content": "Not a name I'm familiar with.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "Apologies, I never introduced him. Albedo is the Knights of Favonius' Chief Alchemist. He's also Timaeus' and my teacher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400228,
					"content": "But Paimon's only ever seen Timaeus teaching alchemy. So that means... Albedo is a teacher-teacher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400229,
					"content": "Yes, he's dedicated himself to investigating the truth of this world, and has made many an important breakthrough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400230,
					"content": "We often get alchemists coming to Mondstadt from all over Teyvat, seeking his help. They say that the subtlest of guidance from Mr. Albedo helps them to solve the most unfathomable of problems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400231,
					"content": "Wow, Paimon didn't know he was such a big deal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400232,
					"content": "Mm-hmm. Still, it seems that he's encountered a problem in his research recently. Every time I see him, he has a concerned look on his face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400233,
					"content": "I'm not sure someone as smart as him could use my help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "I'm sure that Albedo would love to hear about your incredible exploits. I know it would bring him lots of new inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400236,
					"content": "Albedo is a true gentleman. He'll be sure to pay you back in equal measure for helping him out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400237,
					"content": "Can he make me stronger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "I don't see why not. Testing the limits of living beings' capabilities is one of Albedo's areas of research after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400241,
					"content": "Albedo and Timaeus will be conducting research in the mountains right now. I'd love to take you both to see him, but somebody has to attend to the store.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400242,
					"content": "I'm afraid you'll have to go to the entrance to the pass and look for him by yourselves. Look out for a refined gentleman with the presence of a true scholar, and... umm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400243,
					"content": "...Sorry, that's the best I can do. You'll have to do your best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400244,
					"content": "Hey, stop worrying! We got this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400239,
					"content": "Can he make Paimon stronger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "Uhh, Paimon doesn't need any help in that department. But if Albedo wants to pay Paimon back for helping him, a few Mora might settle the score. Tee-hee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400234,
					"content": "My knowledge of alchemy stops at basic crafting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "Think I might have heard of him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				}
			]
		}
	]
}