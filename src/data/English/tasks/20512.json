						205120302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120302,
					"content": "I sure have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120303
					]
				},
				{
					"id": 205120303,
					"content": "This... really does look quite rich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120304,
					"content": "Can you really use this to make medicine? I'll try it myself once it's done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120305,
					"content": "If anything happens to me, please take Anna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120306,
					"content": "...and place her in the care of Sister Grace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120307,
					"content": "Tell her that I've gone to work somewhere far abroad. Please, that is my final request.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120308
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120308,
					"content": "Hey, hey. You're giving yourself a scare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120309
					]
				},
				{
					"id": 205120309,
					"content": "But this medicine does look that scary! Whatever the case, take this first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120310
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120310,
					"content": "And remember what I said!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
