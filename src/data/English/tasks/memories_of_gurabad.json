				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050402,
					"content": "Hmm... Liloupar, are you alright? Why are you so quiet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050403,
					"content": "Shh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "Wait... Look. She's glowing. Well, differently from normal, anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050406,
					"content": "The Jinni's bottle shimmers, seemingly in tune with the vibration of the chess piece.\\nYou can hear the passing of time like drops of water in a prison... It seems to last a lifetime, or perhaps just for a moment.\\nLiloupar doesn't say a word.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "Then, out of the mist, you see a great city, big, bloated, and cold.\\nThe earth opens up, swallowing everything in Gurabad...\\nAnd there stands its gate, set in the mountain wall. It is loathsome, seeming almost to contain all the filth of the ancient world that somehow escaped the people's gaze...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "That's Gurabad over there. I remember it now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050409,
					"content": "My head really hurts...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "Whoa, what's the matter with you guys... Can't you let Paimon know in advance next time? These surprises are bad for Paimon's heart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050411,
					"content": "Sorry, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "Hmph! That's what you get for cheesing Paimon off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050415,
					"content": "#Heh... What a child you are. Worry not, I will give {M#him}{F#her} back, little one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050416,
					"content": "#And when the time comes, {M#he}{F#she} shall see you compensated with all the food you may desire, and that... currency of yours. \"Mura,\" was it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050417,
					"content": "It's \"Mora\"... wait, what am I even correcting you for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "Hehe, that's more like it! Paimon's noted it all down! Delicious food and Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050420,
					"content": "Alright, playtime is over. Let us go to Gurabad, my master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050421,
					"content": "Why do we have to go there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "Why, you ask? In truth, I know not... Perhaps the reason does not even matter, but I must make my way there. So...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050423,
					"content": "If there must be a reason, my master, it would be because I want you to witness my past and the lessons I learned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050429,
					"content": "This does sound kinda ridiculous... and Paimon really doesn't get it, but what you're saying almost sounds like a farewell. Did something happen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050430,
					"content": "Ah, nay. I just wish to show you some things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050431,
					"content": "What's that supposed to mean!? You're talking in riddles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050432,
					"content": "In short, please follow me. I shall lead you to Gurabad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050424,
					"content": "Gurabad... What is over there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "There's nothing left. Nothing at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050426,
					"content": "All that remains are the memories of ghosts, broken dreams that can never be recovered, and the sweet aftertaste of revenge... or so I would say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050427,
					"content": "This is a sizable request, and of that I am aware... but I wish for you to witness my past and the lessons I had to learn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050418,
					"content": "Don't put words into my mouth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "I'm fine, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "That's what you always say!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050404,
					"content": "Liloupar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
		{
			"id": 7330506,
			"completionStepIds": [
				7330506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330506",
							"2"
						],
						"stepId": 7330506,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330505",
							"3"
						],
						"stepId": 7330505,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "Whoa! We were just next to that chess piece. Then things went \"whoosh,\" and now we're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050602,
					"content": "How did this happen? That's really awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050603,
					"content": "Hehe, and would you like a repeat performance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050604,
					"content": "Again, again!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "Hey, show some restraint! What are you, a kid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050608,
					"content": "That is normal. The coordinates are somewhat off. Perhaps the device is showing its age...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050609,
					"content": "Hey... Isn't this the valley we first went to? What are you bringing us here for? Is there anything worth seeing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050610,
					"content": "You ask too many questions, little one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050611,
					"content": "Strange... It was supposed to be here... Ah, here it is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050606,
					"content": "No, I'm a little dizzy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "Now that you mention it... Paimon's head feels a little woozy, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "As the shard of light merges with Liloupar's magic bottle, you feel a little of your own power being pulled away...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "\"Shiruyeh is Khorramdin.\" \\nThus says the man in the brass mask.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "\"There will be no heirs to your name. I will do away with the many idols in your temples. I will consign you to your grave, for such does one as despicable as you deserve.\"\\nSays the man in the brass mask.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "Through the Jinni's entranced eyes, you bear witness to Gurabad as it is engulfed in darkness... \\nThe city of Gurabad has long been a reservoir of water, but now its inhabitants scatter like a torrent. \\nThe Jinn, devoid of intellect, pour out from cold machine husks, from the soldiers' weapons... And the scarlet wine, the juice of the pomegranate, bursts forth...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "The pomegranates are crushed and cracked, and they are trampled into a mass of mud... Plump or withered, rich or humble... The scarlet fruits, with hue and cry, tell of the Khorramdin's coming — the joy of life and the joy of vengeance.\\nThe juice tastes as sweet and mellow as sweet wine, and flows through the city, turning the reservoir into a vast red sea... \\nThe sea first drowns the slaves, and then their masters howl as they flounder amidst the roiling waves of night.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "Finally, you see the brass-masked king. He flees into the shadows — into Shirin's arms... \\nHer face is old and dim, all traces of life and reason having vanished from it like dust in the night's wind.\\nAnd then there is King Kisra, who turned into a dark monster... they all are your flesh and blood, yet you rejoice, and you exult in that retribution.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "O Gurabad, you are mortally stricken, your shame shown to all...\\nAll who receive these tidings shall clap and shout for joy...\\nFor is there anyone who has not felt your unending tyranny?",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "\"O Gurabad, you are mortally stricken, your shame shown to all...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050909,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "Ormazd was once the lover of the one called Liloupar. It was by the Jinni's love that he rose from a lowly shepherd to become a king amongst mortals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050912,
					"content": "I once believed that he was no mere mortal companion. Foolishly, I fell for those eyes of his... But the vanity and selfishness that kings are wont to have seized him in the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050913,
					"content": "He turned out to be no different from those mortal rulers who live one day and die the next, wandering amidst dreams of conquest and persecution, building their palaces upon quicksand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050914,
					"content": "So, you brought him low...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "Like I said, I punished him — handed ruin down from father to son, across three generations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050916,
					"content": "Kisra Parvezravan, Shirin, they are my blood... It was by schemes of blood, honeyed execution, and raging ambition that I punished them all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050917,
					"content": "But that was not all... *sigh* That was not all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050918,
					"content": "About the \"punishment\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "Vain Parvezravan, my dear child... He wanted unlimited power, and so I gave it to him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050921,
					"content": "I designed for him machines driven by the remnants of Jinn spirits, and in a dream of pitch-black darkness, I inspired him to build a colossal machine that could swallow up and spit out a torrent of artificial objects...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050922,
					"content": "They brought him untold wealth, but they also robbed the laborers of their lives and the farmers of their property.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050923,
					"content": "Thus the lords and the rich men wept, crying: \"Verily this is the triumph of mortals, the end of slavery!\" But only I knew. Only I understood...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050924,
					"content": "This abolition of slavery was itself the beginning of endless and cruel servitude — slave owners were freed from the obligation to raise their slaves, and the slaves were deprived even of small mercies like a full stomach...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050925,
					"content": "Uh, you're starting to lose Paimon here... What are you talking about!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050926,
					"content": "Poverty is accompanied by hatred, and hatred begets ambition... Riches lead to greed, and greed also fuels ambition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050927,
					"content": "It was ambition that drove him to force his queen, Shirin — his elder sister by blood — to create Jinn, mindless and malformed... And her suffering pleased me... it empowered me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050928,
					"content": "...And I was thus able to foster their flesh and blood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050929,
					"content": "You refer to Shiruyeh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "Yes, Shiruyeh, brass-masked Khorramdin. The smallfolk and the slaves saw him as an emissary of my mistress, as a savior to them in their misery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050931,
					"content": "So he led them to embrace justice... To embrace death.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050935,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050936,
					"content": "Hmm? So you're still here, little one... Why are you silent?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050937,
					"content": "Hmm... it's just, Paimon doesn't understand... And what you just said sounded really terrifying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050938,
					"content": "Oh, it's alright... I was only talking about my past... and of my destiny.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050939,
					"content": "Uh... Paimon... Paimon doesn't know what to say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050940,
					"content": "Thanks to your company, I was able to return to my mistress's garden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050941,
					"content": "Wait, what made you say this all of a sudden...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050942,
					"content": "Gurabad is, for me, a fated land. I must therefore return back to this city, where my destiny awaits me still.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050943,
					"content": "Um... Do you have to go back and make amends for all the wrong things you've done or something...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050944,
					"content": "Done wrong? Ha! I have done nothing wrong. But my children are still there. She and Shiruyeh... they must be rather lonely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050945,
					"content": "So what you're saying is...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "The power of the darkness is growing stronger... only a mother's power can face it head-on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050947,
					"content": "I thought I could use the dark abyss to punish that which I hated... But what goes around, comes around... It shall also be my destiny to enter Gurabad and face its retribution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050948,
					"content": "My master... I am sorry that I couldn't stay by your side for long, and that I could not have more time to get familiar with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050949,
					"content": "But I know that fate will arrange for us to meet again. You possess an incorruptible quality. I believe... that I will have made the right choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050950,
					"content": "The right choice...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "Generally speaking, the master doesn't choose the Jinni. Instead, the Jinni chooses their master. Even should we part ways here, I doubt our connection will be easily severed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050953,
					"content": "So... please accept this final gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050954,
					"content": "Please... hold me close to your ear once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050955,
					"content": "You hold the magic bottle to your ear...\\nThere is a chuckle, and you hear someone whispering in your ear in a gentle and delicate language...\\nShe speaks of things as unknowable as a deep spring, but you comprehend it all.\\nAnd at last, the words dissipate, leaving only a cool tingling in your ear...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "Through her guidance, you have become familiar with the ancient verses... \\nBut she speaks no more.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "Eh, look! The light in the bottle has dimmed... Liloupar! Are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050958,
					"content": "Liloupar? Liloupar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050959,
					"content": "(The light of the bottle fades, then the flickering gradually returns — but she speaks no more.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050960,
					"content": "She's gone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "Is that how it is... Seems like it really was goodbye... Will we ever see her again...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050963,
					"content": "And uh, should we... go now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050961,
					"content": "Gurabad... It awaits her.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "You're leaving?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "\"The Brass Mask\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "Ah, yes... Khorramdin, brass-masked King Shiruyeh. \"The Emissary of the Mistress\"! \"Savior of the Commoners and Slaves\"! Haha. A gifted charlatan, that one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050934,
					"content": "And in the end, he led those who followed him to their doom... The earth swallowed them whole, and they fell into a dark chasm together with the entire city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050919,
					"content": "About the fall of Gurabad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "So...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
		{
			"id": 7330512,
			"completionStepIds": [
				7330512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330512",
