			"dialogs": [
				{
					"id": 706680201,
					"content": "Meow! (How wonderful! Congratulations on completing the Ascension Challenge. You're now a Master player!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680202,
					"content": "Meow. (Being a Master player means... that your technique has surpassed that of many people who have been studying the game. Those who don't put in enough effort will never be able to reach such level.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680203,
					"content": "(Of course, they fail to understand why we would spend so much time on a game that they just play for fun...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680205,
					"content": "Meow! (Should the players invited by you learn that you have obtained the title of Master, they will surely take games against you more seriously.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680206,
					"content": "(Perhaps some players are only willing to let you challenge the games set up by them after hearing that you have become a Master player... There are such strange guys in the tavern as well.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680207,
					"content": "#Meow... ({NICKNAME}...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680208,
					"content": "(May the fun be with you in the world of Genius Invokation TCG!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
