			},
			"dialogs": [
				{
					"id": 741570301,
					"content": "This house is for sale. Very reasonable price — purchase before it's too late!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "House-for-Sale Notice"
				},
				{
					"id": 741570302,
					"content": "#{M#Mr.}{F#Ms.} {NICKNAME} and Ms. Paimon! Are you guys here to talk to Mr. Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570303,
					"content": "Is Benoit at home?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "He isn't here. Father said Mr. Leroy will never live here again — he's gone to live underground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570308,
					"content": "In the Fleuve Cendre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "Is it the same Fleuve Cendre we went to before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "If so, then no, not that place. Father said he's gone much deeper underground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570311,
					"content": "The Steambird said that Mr. Leroy fell from a very high place while climbing a mountain, and went tumbling down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570312,
					"content": "Though to be honest, I don't really know how having a bad fall and moving are connected...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570313,
					"content": "By the way, I saw Mr. Leroy's son-in-law! And there was a very nice lady too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570314,
					"content": "The lady really liked me, and she has the same eyes as I do! Our eyes are both lavender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570315,
					"content": "She even asked me where I lived, and said she'd come see me if she had time, and be my good friend! I guess everyone in the Leroy family is a good person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570316,
					"content": "*sigh* I even brought some Bulle Fruit over for Mr. Leroy, but since he isn't there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570317,
					"content": "Can I give it to you, instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570318,
					"content": "Thank you, Molli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "Don't mention it! Mama and Papa always say we should be generous with our friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570320,
					"content": "I did another good thing today! I'm going to go back and write it in my diary, yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570321,
					"content": "As you watch the happy Molli leave that street behind, the story of the Leroy family draws to an end.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "We were just passing by.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "I was just thinking if I should tell you that Mr. Leroy moved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570307,
					"content": "Father said Mr. Leroy will never live here again, and that he's gone to live underground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				}
			]
		},
