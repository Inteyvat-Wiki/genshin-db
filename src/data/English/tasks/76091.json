					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "A flying fae! My notes... The Fatui took my precious notes! Could you help me get them back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Well, Paimon's not really a fae... but something like this should be a piece of cake! Still, what do the Fatui want with some kid's notes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "Maybe they're afraid I'll show them to the world... If you help me get them back, I'll let you in on their secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "But we can talk about that later. Right now, please help me get my <color=#00E1FFFF>notes</color> back. <color=#00E1FFFF>Some pages might've fallen out</color> from my notebook... They should be over there, where the Fatui are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
