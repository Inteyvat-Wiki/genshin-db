					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "You hand over the notebook and the pages you found...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "Let me see... Yup! These are the ones. Thank you so much! There's a lot of evidence about the Fatui's crimes in here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910205,
					"content": "...Crimes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910206,
					"content": "Just look at all those facilities they built on Paha Isle, and the mechanical devices they brought in... That place used to be home to so many animals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910207,
					"content": "I just got back from Maroon Basin. It must be because of the Fatui's machines, all the jellyfish there are barely hanging on... I have to let everyone know about this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910208,
					"content": "Huh? You mean Valberry Jelly and the others? But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910209,
					"content": "You tell him what happened at Maroon Basin...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "So it's already too late... Nevertheless, this needs to be reported!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910211,
					"content": "I'll leave these notes with you for now. I need to hurry back and put everything else I've learned in order. I need to turn all this into an article.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910213,
					"content": "Oh, and if you tell anyone else about this, make sure to say it was me, Semyon, who told you. After all, it's going to take a while before I can write it all up and publish it in the paper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910214,
					"content": "Anyway, thanks a lot! See you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
