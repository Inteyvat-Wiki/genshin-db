			"dialogs": [
				{
					"id": 750351201,
					"content": "Paimon had a guess when she saw the pillars outside, but she really didn't expect to end up here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351202,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351203,
					"content": "Looks like you like this place, at least! Though it does make sense, after all, you must've spent a lot of time here before you met us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351204,
					"content": "Paimon wonders if those glowing pillars will disappear after we leave this time... Still, let's clean up a bit first, then rest for a while!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351205,
					"content": "#You, {REALNAME[ID(2)|SHOWHOST(true)]}, and Paimon tidy up the place together.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351206
					]
				},
				{
					"id": 750351206,
					"content": "Hehe, now it's looking pretty good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351207,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#Hmm, you're pretty excited, aren't 'cha, {REALNAME[ID(2)|SHOWHOST(true)]}? Do you have something you wanna tell us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351209,
					"content": "Wrroh... Rrrawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351210,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351211,
					"content": "Huh? Do you want us to turn around?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351212,
					"content": "You didn't prepare a surprise for us, did you? Heehee, you're as easy to read as an open book!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351213,
					"content": "Alright, then, we'll play along!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351214,
					"content": "#You and Paimon turn around, and all you can hear is the continuous clinking and jingling.\\nIt sounds like {REALNAME[ID(2)|SHOWHOST(true)]} is tinkering with something...\\nAfter a short while, {REALNAME[ID(2)|SHOWHOST(true)]} lets out a \"Rawr rawr!\". It's probably time to turn back around...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "Whoa, that's a lot of stuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351216,
					"content": "Let Paimon have a look! Let's see, a super straight branch, a really round rock... And some strange food with a weird color and smell. Well, that's probably been left out for who knows how many days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351217,
					"content": "You carefully selected and collected all these, didn't you? Are they gifts for us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351218,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351219,
					"content": "Still, we can't eat food that's been left out for too long! Whoever eats it — and that includes you — would get an upset stomach! So we've gotta deal with that first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351220,
					"content": "Arroooo... Rooooawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351221,
						750351223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351221,
					"content": "But this branch is really something!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351222
					]
				},
				{
					"id": 750351222,
					"content": "Yeah! It feels like it'd be every bit as impressive as a master sword when you wave it around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351225,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "Mmmhmm, we'll happily take it all! Hehe, just put it all in Paimon's secret stash's backpack pouch! Maybe they'll come in handy someday!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351227,
					"content": "#Hmm, since {REALNAME[ID(2)|SHOWHOST(true)]} gave us a gift, we should give him a gift in return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351228,
					"content": "Let Paimon see what she's got in her secret stash...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351229,
						750351231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351229,
					"content": "Wow. Your seldom-seen generous side makes an appearance...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351230
					]
				},
				{
					"id": 750351230,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} went out of his way to show us how much he cares, that's not something to take lightly! Also, if it gets too heavy, Paimon can't really fly, so maybe Paimon can give him some...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351233,
					"content": "#Ta-da! It's a super shiny gem! Do you like it, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351234,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351235
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "Ooh! Guess Paimon's picked just the thing, huh? Hey, be careful now! Don't drop it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351236,
					"content": "...Oh boy. Why does Paimon feel like you'll lose the gem if you hold onto it like that...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351237,
					"content": "Why don't we go find the Children of Echoes? If anyone's got gemsmiths who could shape it for us, it'd be them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351231,
					"content": "Just what have you squirreled away, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351232
					]
				},
				{
					"id": 750351232,
					"content": "#Paimon said it's her secret, private stash! Even if we're the bestest of buddies, that's not something Paimon can just tell you, you know! Anyway, there's plenty enough to give {REALNAME[ID(2)|SHOWHOST(true)]} a gift!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351223,
					"content": "This rock is really round!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351224
					]
				},
				{
					"id": 750351224,
					"content": "And it's shiny, too! Hehe, we've crossed a lotta rivers, and we've seen lots of round rocks, so you can believe us when we say this stone is a gem amongst rocks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}