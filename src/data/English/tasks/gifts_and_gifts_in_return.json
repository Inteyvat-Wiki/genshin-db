			"dialogs": [
				{
					"id": 750350601,
					"content": "They're all perched up there on the tree... Could they be planning to build a nest with my tools?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350602
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350602,
					"content": "My brave friends, it's all up to you! Ah, the pain of being without the means to earn my own bread...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
