					}
				]
			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "Ah, you're here. Master Kulahaw has already left your processed gem in the shop, leaving instructions that I personally deliver it to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "Huh? Master Kulahaw isn't here today either?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "That's right, he's out gathering inspiration yet again. By the way, he also made a set of locks to carry with him, saying it was to prevent his tools from being stolen... Which is weird... Would anyone want to steal our cutting tools and sell them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "Of course they wouldn't! It's becau—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(...So Imix still doesn't know they were stolen by birds... Let's spare Kulahaw the embarrassment!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "Because... Because there's someone who thinks they can steal his skills that way too, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "Forget it... Anyway, we'll take the gem! The shape is so pretty. That's what you'd call a \"masterwork,\" huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#Looks like {REALNAME[ID(2)|SHOWHOST(true)]} really likes it too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "#Allow me to thank you on {REALNAME[ID(2)|SHOWHOST(true)]}'s behalf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Hey now, as long as your little Saurian likes it! I'll be sure to pass on your compliments to Master Kulahaw, please come again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
