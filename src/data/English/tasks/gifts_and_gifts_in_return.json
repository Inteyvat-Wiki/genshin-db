			"dialogs": [
				{
					"id": 750350101,
					"content": "Excuse me... Um, are you Master Kulahaw?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350102,
					"content": "That is, in fact, my name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350103,
					"content": "Hehe, so you're the Gem Master who is looking for inspiration! We came looking for you based on Imix's recommendation. We noticed you were staring at the tree just now. Were you in the middle of mining for gems of creativity?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350104,
					"content": "Uh, actually... Forget it. It's not important anymore... *sigh* Is there something I can help you with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350105,
					"content": "#We've brought a beautiful gemstone, and we were hoping you'd process it for {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350106,
					"content": "#Hehe, c'mon, {REALNAME[ID(2)|SHOWHOST(true)]}, show him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350107,
					"content": "Rawr! Rawr—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "Ehhh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350109,
					"content": "#You hear the fluttering of avian wings by your ears...\\nBy the time you recover, the gem has vanished from {REALNAME[ID(2)|SHOWHOST(true)]}'s claws without a trace.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "Raaaaah! Roaaaargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Wha— Waitasec, where's the gem? Where could such a huge gem have gone off to?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350112,
					"content": "Seems like a bird nicked it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "What the heck? The birds here steal stuff? Rude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350114,
					"content": "Roooawr! Rooooawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "Actually, what I was about to say was, even if the gem hadn't just been stolen, I still couldn't help you cut it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350116,
					"content": "...Since all my tools were also stolen by those damn birds! I was actually just carefully looking at those birds, going over them one by one, to see which one of them had their dirty claws on my tools.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350117,
					"content": "#Is... Is that even possible? These birds are just the worst! C'mon, {NICKNAME}, let's go get that gem back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350118,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "And don't forget about my tools too—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
			]
		},
