			"dialogs": [
				{
					"id": 750350801,
					"content": "Can this be!? My tools are back! Oh, this is amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350802,
					"content": "I didn't get a good look before, but I must say, now that's one pretty gem! It's got the same fleshy yellow as a bird's tarsus... Bah! I shan't use those blasted scoundrels in my analogies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350803,
					"content": "Like the sky just brightening at dawn, like the first rays of the sun, that kind of early morning sky color... Yeah, that's a good description...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350804,
						750350806
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350804,
					"content": "For a master, your metaphors aren't very masterful...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350805
					]
				},
				{
					"id": 750350805,
					"content": "Hey, I'm no storyteller! Really, all I need to do is remember the beautiful colors of nature... Using pretty words to describe them isn't my forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350808,
					"content": "Either way, just leave the gem to me. As I said before, I'll process it for free. Consider it a gift for your help in retrieving my tools. As for how long it'll take... Drop by the Gemporium in two days' time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350806,
					"content": "So that's the meaning of \"gathering inspiration\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350807
					]
				},
				{
					"id": 750350807,
					"content": "Oh? So you've heard of the practice before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				}
			]
		},
