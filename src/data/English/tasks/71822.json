			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "Mt. Tianheng... Skybracer... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220102,
					"content": "What are you thinking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "Ah, I'm currently researching the history and legends of Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220104,
					"content": "I've heard that this year's Mingxiao Lantern is modeled after an adeptus named Skybracer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220105,
					"content": "From what legends I've been able to gather, this adeptus also fought alongside Rex Lapis for a time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220106,
					"content": "The exact times and the enemies they faced have differed from text to ancient text...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220107,
					"content": "But all the sources concur that Skybracer has already passed on, and it has been stated that this adeptus once held Mt. Tianheng up with their own antlers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220108,
					"content": "That's why I came to Mt. Tianheng to see for myself, thinking that if I got lucky, I might find something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220109,
					"content": "But as it turns out, Mt. Tianheng is crawling with monsters. After ascertaining the site for my investigations, I found it to be so full of monsters as to be impassable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220110,
					"content": "Traveler, if you're willing, could you help me investigate and take some soil samples?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220111,
					"content": "Soil... samples?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "Well, that's what we'd say at the Akademiya, but what we really mean is some soil from the area in question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220113,
					"content": "Local legends hold that Skybracer held Mt. Tianheng up with their own antlers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220114,
					"content": "From an academic perspective, it stands to reason that the ground here might have an unusual composition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220115,
					"content": "So please, help me go there and retrieve a soil sample.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 7182202,
