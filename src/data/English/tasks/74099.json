			"dialogs": [
				{
					"id": 740990101,
					"content": "About catching monsters instead of fish...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "Oh! Now that I come to think of it... it was quite a unique experience that my own bait attracted monsters instead of fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Though I'm not really scared of monsters. I used to commute alone between the Fontaine Research Institute and Court of Fontaine, so I often fought against bandits along the way. I won most of the time too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "However, I am now a director of the Fishing Association, so I must behave like one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "If I scare off the fish or cause any trouble to the people fishing nearby, I would see it as failing to meet people's expectations for a director either way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "That's why I must proceed with self-constraint and caution!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
		}
	]
}