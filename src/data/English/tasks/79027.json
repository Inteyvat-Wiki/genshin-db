				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miitoboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "Whew, that was close. Paimon was sure we were gonna sink!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270602,
					"content": "Kosekimaru, you're amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270603,
					"content": "#Haha, a talking ship is still just a ship. {NICKNAME}'s superb sailing skill was what saw us safely through the storm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270604,
					"content": "Do you wanna go again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "Haha, I'd rather not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270607,
					"content": "*sigh* I'm afraid I may have triggered the thunderstorm. These waters are less stable than they once were...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270608,
					"content": "#But... we've arrived! {NICKNAME}, Paimon, the treasure is right up there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270609,
					"content": "Isn't this the place we first visited when we were looking for treasure? There was nothing here but half of Kosekimaru's hull!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270610,
					"content": "I am certain that there's treasure up there this time. It's... What did I call it again? It's the intuition of a mighty pirate ship!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270611,
					"content": "Wait a minute... You said you had two things to tell us, right? And the first one was that you'd remembered your name. What was the other one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270612,
					"content": "Hahaha, I thought you'd already forgotten. I'll tell you when you come back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270605,
					"content": "You're too kind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
		{
			"id": 7902710,
			"completionStepIds": [
				7902708,
				7902710
			],
			"beginWay": "TALK_BEGIN_AUTO",
