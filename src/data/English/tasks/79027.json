						],
						"stepId": 7902710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miitoboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "Kosekimaru, Kosekimaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271002,
					"content": "We found the treasure. Look, it's a model pirate ship! Your intuition finally worked this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271003,
					"content": "So, what's the other thing you wanted to tell us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271004,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790271005,
					"content": "Kosekimaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271006,
					"content": "(The ship named Kosekimaru does not respond...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271007,
						790271008
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790271007,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				},
				{
					"id": 790271009,
					"content": "...Hmph, but he said he'd tell us when we returned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271010,
					"content": "Kosekimaru... you're a big fat liar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271008,
					"content": "Kosekimaru can't speak anymore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				}
			]
		}
	]
}