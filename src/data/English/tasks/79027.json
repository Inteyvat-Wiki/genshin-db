				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miitoboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "Ahoy, here you are. I thought you'd be too busy flying around the islands with those wings o' yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270102,
					"content": "Bet you've long forgotten your old mate Miitoboru, sitting there slowly soaking away in the ocean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270103,
					"content": "We're here now, aren't we!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270104,
					"content": "So, you said you needed our help. What's up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270105,
					"content": "It's not that important... Remember when you helped me find the missing pieces of my body?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270106,
					"content": "How can I put it... I'm not sure if it's because I've fulfilled my wishes, or if these waters are slowly diminishing my ability to talk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270107,
					"content": "Recently, I find myself sleeping most of the time rather than staying conscious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270108,
					"content": "Is it because the machine was turned off...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "#I see... So it's because of some contraption that I became your Waverider and could communicate with you, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270111,
					"content": "Oh... Does that mean that once the effects of the machine wear off, Miitoboru won't be able to talk anymore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270112,
					"content": "#We gotta do something before it's too late, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270113,
					"content": "Haha, there'll be no need for that, Paimon... I am quite content that I had the chance to talk to you at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270114,
					"content": "Argh... The more I think about it, for me, as a ship, to have gotten to talk to you in the past few days... It really is a wondrous thing, the stuff dreams are made of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270115,
					"content": "But now, I need to ask you for one more favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270116,
					"content": "Tell us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "Remember when I told you that once we found my body, I'd take you for a cruise? Well, it seems my body was reduced to a slew of sorry shipwrecks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270125,
					"content": "And most of the treasure was taken away, leaving nothing good for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270118,
					"content": "But this time, I swear as a mighty pirate ship, there be treasure ahoy, and a fine treasure at that! Or else may I be strangled by seagrass and fed to the fish! Just trust me one last time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270119,
					"content": "#Well, {NICKNAME}, since Miitoboru probably won't be able to speak soon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270120,
					"content": "#And... Since there really is treasure this time... Let's go, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270121,
					"content": "Paimon, you never change.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "Time to set sail!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270124,
					"content": "Argh! Come on then, me hearties! Time to come aboard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miitoboru"
				},
				{
					"id": 790270122,
					"content": "Oh, go on then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "Is Miitoboru also affected by the machine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902706",
							"2"
						],
						"stepId": 7902706,
						"stateName": "QUEST_STATE_UNFINISHED"
