			},
			"dialogs": [
				{
					"id": 751770101,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770102,
					"content": "#Hey, {REALNAME[ID(2)|SHOWHOST(true)]}, where'd you get this Kamera from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770103,
					"content": "Did you sneak up on someone and... No way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770104,
					"content": "Rrooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770105,
					"content": "Mrrraa... Rawr! Rawr! Groooah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770106,
						751770108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770106,
					"content": "That move looks familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770107
					]
				},
				{
					"id": 751770107,
					"content": "Oho! Isn't that the \"Mighty Meaty Fireball\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770110,
					"content": "Hehe, back in the Children of Echoes, wasn't there this guy who wanted to be a director, but used his Kamera the wrong way round... Ah! Is that where you got your Kamera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770111,
					"content": "Rawr! Ehrr... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770112,
					"content": "You wanna take a picture with us, right? Hehe, Paimon gets you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770113,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770114,
					"content": "Yeah... we've been adventuring for so long, but haven't taken any pictures together! Now that the little one's curse has been lifted, he can finally grow up big and strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770115,
					"content": "#Paimon isn't sure how long it takes for Tepetlisaurs to grow up... If {REALNAME[ID(2)|SHOWHOST(true)]} turns into an adult tomorrow, we won't get to see him as a baby anymore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770116,
						751770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770116,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770117
					]
				},
				{
					"id": 751770117,
					"content": "Come on, hehe, let's take that picture!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770119,
					"content": "Master Photographer Paimon's set everything up, this should be just right! And the Kamera's definitely facing us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770120,
					"content": "Everyone, say \"Mighty Meaty Fireball\" in three, two, one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770121,
					"content": "\"Mighty Meaty Fireball\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770122
					]
				},
				{
					"id": 751770122,
					"content": "Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770123,
					"content": "#There we go. Wow, {REALNAME[ID(2)|SHOWHOST(true)]} is really striking an impressive pose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770124,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770125
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770125,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} takes one of the photographs, turns around, and carefully tucks it away beneath the hard shell on his back.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770126
					]
				},
				{
					"id": 751770126,
					"content": "#But why did {REALNAME[ID(2)|SHOWHOST(true)]} suddenly want to take a picture?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770127,
					"content": "Groooah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770128,
					"content": "Wroooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770129
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770129,
					"content": "Wroooh... Roooah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770130
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770130,
					"content": "#What's wrong, {REALNAME[ID(2)|SHOWHOST(true)]}? Are you feeling unwell? Hmm... He doesn't look very happy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770131,
					"content": "Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770132
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770132,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770133
					]
				},
				{
					"id": 751770133,
					"content": "You want to set off on your own adventure...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770134
					]
				},
				{
					"id": 751770134,
					"content": "Huh? Your... own adventure? Don't you wanna keep traveling with us? Uh oh, did Paimon do something to make you mad...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770135,
					"content": "P—Paimon won't call you greedy again! Please, d—don't leave us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770136,
					"content": "Wroooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770137
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770137,
					"content": "...Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770138
					]
				},
				{
					"id": 751770138,
					"content": "*sniff* P—Paimon knows... Everyone's gotta grow up someday... and *sob* everyone has places they wanna go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770139,
					"content": "But... Paimon doesn't want to say goodbye... Not all of a sudden like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770140,
					"content": "Don't cry. We'll meet again someday...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770141
					]
				},
				{
					"id": 751770141,
					"content": "#Really? Wh—When we need help in the future, you'd better come find us right away, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770142,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770143
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770143,
					"content": "#And... if you run into trouble on your adventures, {REALNAME[ID(2)|SHOWHOST(true)]}, you can come find us then too! Don't try to act tough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770144,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770145
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770145,
					"content": "...Don't eat too much, and don't pick fights you can't win. Paimon said not to eat too much, but you should still eat plenty of meat stew...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770146,
					"content": "A—A—And...! Th—The most important thing of all... is that you should...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770147,
					"content": "Grow up happy and healthy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770148
					]
				},
				{
					"id": 751770148,
					"content": "Yeah! Happy and healthy and big! Till you're the size of at least three mountains!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770149,
					"content": "Rawr! Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770150
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770150,
					"content": "Y—Yup! Th—That's the spirit! *sob* D—Don't you dare forget about us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770151,
					"content": "In the tranquil serenity of the forest, you share a parting plate of Blazed Meat Stew. Thereafter, you tidy away your pop-up campsite.\\nYou prepare some mementos for your little friend, who is about to set off on his own journey. You can't help but reminisce about your adventures together — the Yumkasaurus blocking the way in a cave, the Blubberbeast by the shore, and all the curious characters you've met along the way...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770152
					]
				},
				{
					"id": 751770152,
					"content": "Lastly... you linger briefly on the one who communicates in strange golden script...\\nAs Paimon puts it, \"He was just using us! He never even showed his face.\"\\nIt makes you think back to the complex mix of emotions reflected in the eyes of your young saurian companion at the foot of the Sacred Mountain.\\n...Although he is still small, he will surely grow up to become a mighty saurian indeed.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770153
					]
				},
				{
					"id": 751770153,
					"content": "In the very, very end, he presses his horn against Paimon's forehead, before nuzzling tenderly at your outstretched palm.\\nThen, after a long pause, in which he seems to be mustering up the courage...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770154
					]
				},
				{
					"id": 751770154,
					"content": "The young saurian resolutely turns around and plods off into the distance.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751770118,
					"content": "Yeah, let's take it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770119
					]
				},
				{
					"id": 751770108,
					"content": "It's the \"Mighty Meaty Fireball\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770109
					]
				},
				{
					"id": 751770109,
					"content": "Now that you mention it, Paimon sorta remembers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}