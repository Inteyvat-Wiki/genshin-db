			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "You guys are back! The Honorary Knight returns triumphant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980102,
					"content": "#Yup, {NICKNAME}'s back from tussling with Dvalin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980103,
					"content": "You just returned yesterday, right? Jean got back first, and she told us all about your heroic deeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980104,
					"content": "*sigh* I wonder if I'll ever get an opportunity like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980105,
					"content": "All thanks to your referral.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "That doesn't come into it. You guys deserve all the credit for how you resolved this crisis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980107,
					"content": "When I brought you into the city that day, I was just doing my duty as an Outrider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980111,
					"content": "You're welcome! ...But, have you been waiting for us here this whole time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980112,
					"content": "Of course not! Just because I'm not out on the front line doesn't mean I don't have work to do... In fact, I'm dealing with the aftermath of the crisis as we speak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980113,
					"content": "Aftermath? Here? What happened in Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980114,
					"content": "While Master Jean was away, the monsters lurking nearby made a coordinated attack on the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980115,
					"content": "Fortunately, we weren't completely taken by surprise. I detected the hilichurls were moving closer to the city a while back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980116,
					"content": "Oh yeah! Paimon remembers. When we first met, you were clearing out one of their camps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980117,
					"content": "Exactly. And if we hadn't started making preparations back then, Mondstadt would be in much greater danger by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980118,
					"content": "Glad you held them off.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Me too. But I have a strange feeling that we're not out of the woods yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980120,
					"content": "Hilichurls aren't usually capable of coordinating like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980123,
					"content": "Our best guess is that the Abyss Order is behind it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980124,
					"content": "They've taken over the hilichurls? Hmm... Good thing we saved Dvalin, or they might've taken him, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980125,
					"content": "That's right. And since I'm the Outrider, it's up to me to keep eyes on the Abyss Order from now on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980126,
					"content": "Ugh, I'm sorry. You should be celebrating your victory, not listening to all this somber talk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980127,
					"content": "Hmm... I promised to take you out for some Sticky Honey Roast, didn't I? Before everyone got caught up in the Stormterror crisis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980128,
					"content": "There's no time like the present, right? You guys hungry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980129,
					"content": "You bet! You may have forgotten till just now, but it's been on Paimon's mind this whole time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980130,
					"content": "Awesome, let's go! It's been way too long since I last ate a Sticky Honey Roast myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980131,
					"content": "Wait for me at <color=#00E1FFFF>Good Hunter</color>. I'll be right there, I just have to clean up here real quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980121,
					"content": "Why would the hilichurls do this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "I know, it's strange. Hilichurls aren't usually capable of coordinating like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980108,
					"content": "Trust me, it's not an opportunity you'd want too often...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "You're right, actually. Peace is hard-won, and we shouldn't take it for granted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980110,
					"content": "And this time, you're the one we should all be grateful to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				}
			]
		},
