					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "Long live the heroes! Thank you, it's finally over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Many trade routes have closed due to the Stormterror incident. We can cope for now without fresh fruit and vegetables... But if the wine supply dries up, we're all doomed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "I cannot imagine a world without wine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "I hope they get the trade routes back up and running soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
