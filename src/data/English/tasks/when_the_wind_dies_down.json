					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3981001,
					"content": "Now I have to submit a full damage report on the disaster to Lisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3981002
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3981002,
					"content": "There were no casualties, but they still want a record of every scraped knee and every broken roof tile for some reason...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Otto"
				}
			]
		},
		{
			"id": 39811,
			"completionStepIds": [
				39811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39811",
							"2"
						],
						"stepId": 39811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3981101,
					"content": "Thanks for helping us clean up the battlefield... You really didn't have to, you know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3981102
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3981102,
					"content": "This work ethic of yours really puts me to shame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3981103
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3981103,
					"content": "I know this paltry sum doesn't begin to pay you back for everything you've done for the Knights, but... for what it's worth, please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Otto"
				}
			]
		},
		{
