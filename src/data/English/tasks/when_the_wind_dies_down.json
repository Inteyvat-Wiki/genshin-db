			"dialogs": [
				{
					"id": 3982101,
					"content": "I salute you, Honorary Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982102,
					"content": "The Acting Grand Master gave a public address on the Stormterror incident. It was truly inspiring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982103,
					"content": "The truth was... incredible. And to think the Knights nearly approved a plan to slay the dragon... We were too quick to jump to conclusions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982104,
					"content": "Still, it could take a long time for those who suffered to forgive Dvalin. And who knows whether they can forgive him fully...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982105,
					"content": "As ever, we must let the wind lead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
