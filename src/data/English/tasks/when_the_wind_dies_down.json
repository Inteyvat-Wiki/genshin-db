			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "Here we go! This is it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980402,
					"content": "Crisis! Danger! The thrill of adventure!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980403,
					"content": "Adventurers' Guild! Finally, our days of rescuing kittens and finding lost puppies are over! The age of adventure is upon us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980404,
					"content": "Roll up, youngsters, join the Adventurers' Guild today! In this time of great upheaval, we must rally together, take on the dragon, and save our great city of Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980405,
					"content": "Yeah, about that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "...What!? WHAT!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980407,
					"content": "The Stormterror threat is resolved? I missed the Acting Grand Master's speech?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980409,
					"content": "...Bah! Stormterror should have put up more of a fight! We didn't get to join in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39807",
							"2"
						],
						"stepId": 39807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "Greetings, may I take your order?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 3980702,
					"content": "Why so cold? I've always thought that we enjoy quite the intimate friendship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980703,
					"content": "Oh hey, I didn't see you there...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "Hahaha... It seems your great battle sharpened not only your combat skills but your wit as well. A knight after my own heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980707,
					"content": "To bask in the presence of Mondstadt's new big hero is quite the morale boost. And that's coming from a knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980708,
					"content": "Sweet-talking sugar-coated Captain Kaeya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980709,
					"content": "Haha, nonsense! I speak from the heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980710,
					"content": "What are you doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "Just looking for a quiet spot to collect my thoughts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980712,
					"content": "While all the other knights are working hard to clean up after the battle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980713,
					"content": "Thinking can be an arduous task, you know. Believe me, I'd much rather be taking out the trash.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980717,
					"content": "So, whatcha thinkin' about, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980718,
					"content": "The Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980719,
					"content": "A dragon wreaks havoc in Mondstadt, and the Acting Grand Master leaves the city to combat the threat. Strategically, that's the perfect moment for the Abyss Order to make their move.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980720,
					"content": "If you were the Abyss Order, would you squander this golden opportunity by sending in nothing more than a few hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980721,
					"content": "You're right, it doesn't add up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "To get to the bottom of it, I decided to wait. So I waited, and watched for their next move.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980724,
					"content": "Then came the day you made all hell break loose in Stormterror's Lair, just as the hilichurls' cries sounded from the city gates...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980725,
					"content": "That same day, I saw shadowy figures lurking in the city itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980726,
					"content": "Inside the city!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980727,
					"content": "Well, all the other knights were outside, fighting the enemy. As you can imagine, that left the inside of the city completely unguarded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980728,
					"content": "Except for me, of course. And so I approached the Abyss Order infiltrators for a bit of... hmm, let's call it fraternizing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980729,
					"content": "Through various means, I managed to gather some rather interesting intel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980730,
					"content": "The situation is this: The Abyss Order... they are united under a single leader.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980731,
					"content": "The Abyss Order has a leader?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980732,
					"content": "Yes. And it was this very leader who devised the plot to turn Dvalin into a weapon of war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980733,
					"content": "What exactly did you have to do to find this out!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980734,
					"content": "Hehehe... Let's just say I'm blessed with certain linguistic powers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980735,
					"content": "#There's more... The Abyss Order has a name for this leader... They call {F#him \"The Prince.\"}{M#her \"The Princess.\"}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980736,
					"content": "#{F#Prince...}{M#Princess...}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "Now, I'm sorry to cut this intelligence briefing short, but I do believe I spy Amber heading this way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980738,
					"content": "I think she's still angry with me for my absence from the defense effort during the attack... I'd better slip away before she notices me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980739,
					"content": "One minute I see Kaeya, the next he's slipped away! Clear sign of a guilty conscience...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980740,
					"content": "He does a lot behind the scenes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "Are you sure? Because that sounds like exactly what he'd say to talk himself out of trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980744,
					"content": "But let's forget about him. I worked super hard today and my tummy's rumbling. Let's order!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980745,
					"content": "Hi Sara! One Sticky Honey Roast, please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980742,
					"content": "I know! What a scoundrel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "I agree. He sets a terrible example for someone who's Cavalry Captain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980722,
					"content": "There must be more to this story.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "What are you plotting this time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "Me? Nothing. On the contrary, I'm trying to work out what others are plotting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980716,
					"content": "That's why I'm here — somewhere quiet, where I can collect my thoughts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980705,
					"content": "Ah, the handsome Mr. Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "Ah, so you do feel something for me. And people say my charm is fake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39809",
