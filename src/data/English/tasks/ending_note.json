			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960001,
					"content": "The Fatui were the ones who attacked you? That's too much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960002
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960002,
					"content": "Master Jean has already returned to the Knights Headquarters. She said that she will look for evidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960003
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960003,
					"content": "But she also said that if no traces were left behind, the Knights might find it difficult to lodge a complaint against the culprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
			"id": 39602,
			"completionStepIds": [
				39602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39602",
							"2"
						],
						"stepId": 39602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960201,
					"content": "This is Barbara, the Deaconess of the Church. She is here to retrieve the Holy Lyre der Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960202
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960202,
					"content": "May the Anemo Archon protect you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960203
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960203,
					"content": "I'm not really in a position to speak compared to our Acting Grand Master...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960204
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960204,
					"content": "But I still want to thank you all on behalf of all of Mondstadt for your assistance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960205
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960205,
					"content": "Fortunately, everything was resolved peacefully... I can't imagine how an all-out war between the military and the dragon would have ended...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960206
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960206,
					"content": "Now the Fatui have no choice but to keep their mouths shut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960207,
					"content": "They must be annoyed that things didn't turn out as planned for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960208,
					"content": "This time, they even lost their best excuse to pressure the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960209,
					"content": "Diplomatically speaking, they gained nothing, and on the contrary simply proved just how vexatious they can be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960210,
					"content": "Sounds like quite the story. So, did you bring the Holy Lyre with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960211
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960211,
					"content": "We cannot ask you to keep defending the lyre forever. The Seneschal has been pressing me for a while now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960212
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960212,
					"content": "We ahh... did bring it with us... Ummm... It's just... it's a little...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960213,
					"content": "Oh, don't worry! I'm not here to collect rent! The Church has always received special funding...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
			"id": 39605,
			"completionStepIds": [
				39605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39605",
							"2"
						],
						"stepId": 39605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960501,
					"content": "Ah! Honorary Knight, you're awake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960502,
						3960505
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960502,
					"content": "Venti... is he alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960503
					]
				},
				{
					"id": 3960503,
					"content": "Um... I wouldn't say he's \"alright,\" exactly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960504
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960504,
					"content": "I found you lying unconscious outside the Cathedral, and used my elemental powers to heal you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960510,
					"content": "That bard awakened first, but strangely, my healing powers had almost no effect on him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960511,
					"content": "This is the first time I've encountered such a patient. But he just said \"it's completely normal,\" and then got up and left the Cathedral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960512,
					"content": "He left? Already? Where'd he go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960513,
					"content": "<color=#00E1FFFF>The Symbol of Mondstadt's Hero</color>, that's what he said.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960514,
					"content": "I wanted to stop him, but Jean— I mean, Master Jean said to let him leave. How strange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960515,
						3960516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960515,
					"content": "(I think I understand...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960517,
					"content": "Paimon remembers Venti healing under <color=#00E1FFFF>that tree</color> before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960518,
					"content": "(It's probably due to the connection between Windrise and the Anemo Archon. Master Jean has figured it out as well, but we can't tell Barbara...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960516,
					"content": "(I think Jean understands...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960505,
					"content": "What planet... are we on?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960506
					]
				},
				{
					"id": 3960506,
					"content": "Planet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960507
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960507,
					"content": "#Ah! Don't listen to {F#her}{M#his} nonsense, Miss Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960508,
					"content": "Ahh... Um, okay, well basically, I found you lying outside the Cathedral, unconscious, and used my elemental powers to heal you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960509
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960509,
					"content": "Paimon thinks you could still use a final splash of ice-cold water to the face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 39606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39604",
							"2"
						],
						"stepId": 39604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960601,
					"content": "The wind amongst the branches is good, I love the way it smells...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960602,
					"content": "Haha, I said the exact same thing the last time. *sigh* Why do I only say these things when I'm down on my luck?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960603,
					"content": "So... what is a Gnosis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960604
					]
				},
				{
					"id": 3960604,
					"content": "Ah, so you noticed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960605,
					"content": "*sigh* This isn't something I'm meant to discuss with ordinary people. But I suppose I can let you in on the secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960606,
					"content": "As you know, Visions are external magical foci that only a small minority of people possess. They use these Visions to channel elemental power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960607,
					"content": "In truth, every wielder of a Vision is one who can attain godhood and ascend to Celestia. We call such people allogenes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960608,
					"content": "Allogenes? Paimon's never heard of them before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960609,
					"content": "Hehe, that's because this is a secret that only archons are privy to. We don't need primitive tools like Visions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960610,
					"content": "Instead, each archon has an internal magical focus that resonates directly with Celestia itself... known as a Gnosis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960611,
					"content": "What about the thing hanging off your hip?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960612
					]
				},
				{
					"id": 3960612,
					"content": "Eh-he. It's just a glowing glass ball I carry around to avoid suspicion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960613,
						3960614
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960613,
					"content": "Huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				},
				{
					"id": 3960615,
					"content": "So who was that nasty woman who sent Paimon flying and stole your Gnosis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960616,
					"content": "Her name is Signora, No. 8 of the harbingers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960617
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960617,
					"content": "She and the rest of the harbingers have been given god-like executive authority by the Tsaritsa of Snezhnaya, and with it, strength surpassing that of other mortals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960618
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960618,
					"content": "The Tsaritsa of Snezhnaya? Isn't that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960619,
					"content": "Indeed. She is one of The Seven, the Tsaritsa who reigns from the Zapolyarny Palace, and the one person that the Fatui Harbingers all answer to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960620
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960620,
					"content": "The Seven don't always get along well, but still — I never thought that she would plot to steal another archon's Gnosis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960621
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960621,
					"content": "What sort of god is the Tsaritsa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960622
					]
				},
				{
					"id": 3960622,
					"content": "Ah... How should I put this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960623
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960623,
					"content": "Five hundred years ago, I knew her well. But I can't say the same is true now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960624
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960624,
					"content": "You see, a certain catastrophe happened five hundred years ago, and after that, she cut off all ties with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960625
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960625,
					"content": "But we can save discussion of the Cryo Archon and the Fatui for another day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960626
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960626,
					"content": "#{NICKNAME}, if you seek the rest of The Seven, many difficulties lie ahead of you still.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960627
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960627,
					"content": "You should head for Mondstadt's neighboring nation of Liyue. The Geo Archon who reigns there, unlike me, administrates his entire region personally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960628
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960628,
					"content": "He only descends once every year to give his divine predictions, which set the direction for Liyue for the rest of that year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960629,
					"content": "Even so, it sounds like he works much harder than a certain someone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960630,
					"content": "Eh-he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960631
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960631,
					"content": "...In any case, this year's Rite of Descension is soon to begin. If you miss it, you'll just have to wait another year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960632,
					"content": "#WHAT!? Why didn't you tell us before? Well then bye. {NICKNAME}, we're going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960633,
					"content": "One moment, Windborne Outlander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960634,
						3960636
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960634,
					"content": "You mean me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960635
					]
				},
				{
					"id": 3960635,
					"content": "Yup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960638,
					"content": "Traveler, as you set off on your journey once again, you must remember that the journey itself has meaning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960639
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960639,
					"content": "The birds of Teyvat, the songs and the cities, the Tsaritsa, her Fatui and the monsters... they are all part of your journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960640
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960640,
					"content": "The destination is not everything. So before you reach the end, keep your eyes open. Use the chance to take in the world around you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960641,
						3960642
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960641,
					"content": "Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960643,
					"content": "Great. So that's that for the Anemo Archon's admonishments! Back to Venti Time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960642,
					"content": "I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960636,
					"content": "Sorry for borrowing the statue's Anemo power without asking...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960637
					]
				},
				{
					"id": 3960637,
					"content": "Haha, just use it gratefully — or, better yet, treat me to a glass of dandelion wine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960614,
					"content": "I feel cheated... but I guess I'm used to that by now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				}
			]
		},
		{
			"id": 39608,
			"completionStepIds": [
				39604
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "If you want to chat, now's the time — a bard stays not always in a single clime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960702,
					"content": "About Dvalin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "Up till the end, Dvalin remembered his duty as one of the Four Winds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960704,
					"content": "As such, I don't intend to forcibly strip him of that duty and force my ideals of freedom onto him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960705,
					"content": "I just hope that Dvalin will be able to choose for himself and understand what freedom is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960706,
					"content": "Before I became an archon, I too was taught the meaning of freedom in this way by a friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960707,
					"content": "About the Abyss Order...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "Kaeya shared some new intelligence, you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960709,
					"content": "#...I see. So, the Abyss Order has a {F#Prince}{M#Princess} who orchestrated the plan to corrupt Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960710,
					"content": "#They were probably trying to turn Dvalin into a weapon of war for the Abyss. But that said, I have never heard of any such {F#Prince}{M#Princess} of the Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960711,
					"content": "Not an Abyss Order tradition, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "I think so, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960714,
					"content": "#Apparently, but how does a {F#Prince}{M#Princess} come out of nowhere and take command over the entire Abyss Order?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960712,
					"content": "So this is a recent development...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "About Signora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "That Fatui lady didn't hang around, did she? She just grabbed your Gnosis and left!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960717,
					"content": "She wanted to avoid any eyewitnesses from the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960718,
					"content": "The slightest slip-up here would have destroyed the Fatui's diplomatic relations with the Knights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960719,
					"content": "So they're just gonna keep acting like Mondstadt's allies as if nothing happened!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960720,
					"content": "*sigh*... If only the seven nations had banded together against the Abyss Order in the first place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960721,
					"content": "The Fatui possess the strongest military among the seven nations. Yet they've used it to steal the Holy Lyre, covet the power of gods, and use Dvalin as a bargaining chip against the Knights...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960722,
					"content": "Speaking of the Lyre... didn't Diluc say something like this before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960723,
					"content": "He said that the Fatui can only run amok across the seven nations and threaten the Knights because of the harbingers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960724,
					"content": "Yes. As I said earlier, the Cryo Archon has given them authority and strength beyond that of other mortals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960725,
					"content": "The Tsaritsa... I haven't seen her in five hundred years. What is she thinking? What's her plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960726,
					"content": "Whatever the answer is, I have a feeling it's only going to make your search for The Seven all the more difficult...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960727,
					"content": "About deities...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "As I said before, Vision wielders are known as allogenes and may ascend to Celestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960729,
					"content": "A Gnosis is a higher-order nexus of elemental manipulation and is emblematic of an archon's status as one of The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960730,
					"content": "#But as for which of The Seven took your {F#brother}{M#sister}... I'm sorry, I don't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960731,
					"content": "...Wait, as one of the Seven, I'm not clear of suspicion yet either, am I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960732,
					"content": "You don't look like that god at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "Hang on a hot second! Tone-Deaf Bard is just one of Barbatos' many incarnations, who's to say—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960734,
					"content": "We've known you long enough to trust you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#Haha, we're a great team indeed! Say, once you find your {F#brother}{M#sister}, how would you like to become one of the new Four Winds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960736,
					"content": "Perhaps...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#Hmm, you don't seem too into it, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960738,
					"content": "Hey, Tone-Deaf Bard... If being one of the Four Winds means free food, you can consider Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960739,
					"content": "Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960741,
					"content": "There's nothing else...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "Well then, best be off to <color=#00E1FFFF>Liyue</color>. If the descension ritual you fail to tally, then another year you must dally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}