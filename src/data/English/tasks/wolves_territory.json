			"dialogs": [
				{
					"id": 4510601,
					"content": "Haha! Told you we could do it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510602,
					"content": "I— thanks, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510603,
					"content": "...Wolves catch five or six every hunt... *sigh* Tonight, they go hungry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510604,
					"content": "Uh-oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510605,
					"content": "Don't worry. You tried.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510606,
					"content": "At least you did better than other knight friend... the red one, burny girl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510607,
					"content": "If she was here, whole mountain is fire. Can't catch even one boar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510608,
					"content": "I must go now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510609,
					"content": "Here is not safe. Careful. Always watching.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510610,
					"content": "What a weirdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510611,
					"content": "\"Burny girl\"? From the Knights of Favonius? What is he—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}, who do you think it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
