			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "What a romantic tradition. Now this is worth researching!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000102,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "Oh, it's you, Traveler. Have you come to the library due to your interest in Mondstadt's romantic songs as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000104,
					"content": "Still, words on a page can be read any time, but the history that happens all around us will slip by in but an instant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000105,
					"content": "The people of Mondstadt have many special rituals during this cozy, romantic time known as the Windblume Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000106,
					"content": "What form do these traditions take, and what of the history behind them? These are both most promising research angles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000107,
					"content": "I'm currently writing a research report, and I believe that descriptions alone will not suffice. Could you help me take some pictures of the sights around the Windblume Festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000108,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "Thanks for helping with my research. I will certainly cite you in my acknowledgments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000113,
					"content": "All of the following deserve to be recorded: <color=#00E1FFFF>the floral decorations in the fountain plaza</color>, <color=#00E1FFFF>the Anemo Archon statue adorned with flowers in front of the Cathedral</color>, and the <color=#00E1FFFF>flower shop owner, hard at work</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000115,
					"content": "Please help me take pictures of these sights, and pass those photos to me afterward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000110,
					"content": "Best you go yourself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "No, no, I can't leave now. I just drafted the outline of my report. If I were to leave now, my train of thought would be interrupted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000112,
					"content": "I'm counting on you, Traveler. Though it isn't much, I will prepare compensation for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				}
			]
		},
		{
