				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000401,
					"content": "Welcome to Floral Whisper. Do you need anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000402,
					"content": "So, about Sayid's photograph...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "Hmm, I suppose it's true that the Windblume Festival is unique to Mondstadt. The people of Sumeru probably don't celebrate it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000404,
					"content": "He wants to take a photo of me and my flowers? Sure. Mr. Sayid really has a unique way of thinking. I suppose that's researchers for you, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 7000005,
			"completionStepIds": [],
