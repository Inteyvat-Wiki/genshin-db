				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "Have you finished taking those pictures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000602,
					"content": "Got them all right there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "Oh, these are very well shot. I'm sure that they'll come in handy in my research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000604,
					"content": "Seeing such lovely sights reminds me of the festivals in my hometown, Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000605,
					"content": "What do you celebrate there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "Ah, I suppose you're not familiar with our traditions. Every year, we celebrate the Sabzeruz Festival to commemorate the birth of Lesser Lord Kusanali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000607,
					"content": "But if we want to compare the atmosphere, I'd say that there's some difference between the festivities now and the ones back home...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000608,
					"content": "Speaking of which, I wasn't able to take part in this year's Sabzeruz Festival either. It's been so long — I wonder how things are at the Akademiya nowadays...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000609,
					"content": "Well, I'm getting off-topic. Regardless, thank you for your help. Please accept these as payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				}
			]
		}
	]
