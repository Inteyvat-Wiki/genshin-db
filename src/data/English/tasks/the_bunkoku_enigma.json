			"dialogs": [
				{
					"id": 722760801,
					"content": "That's weird. Where is he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760802
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760802,
					"content": "There's a Shade of Tokoyo here, huh? Could he be... Bunkoku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760803,
					"content": "Don't you dare take me for that despicable, craven traitor! My name is Koyanagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760804
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760804,
					"content": "But since you know the name Bunkoku, you didn't follow me here with ill-intent, did you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760805
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760805,
					"content": "It took my friend tons of reading and careful analysis to locate Bunkoku's Secret Treasure. By no means will I allow you to snatch it away from me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760806
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760806,
					"content": "You're mistaken. We just, uh... got down here by chance! Yup, it was just pure luck, yes-siree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760807,
					"content": "Hmph. Then scram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760808
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760808,
					"content": "(To think that someone made it down here in the past...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760809,
					"content": "(Did they beat us to the treasure?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760810,
						722760812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760810,
					"content": "Not likely.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760811
					]
				},
				{
					"id": 722760811,
					"content": "Paimon thought so too. Had they successfully found the treasure, the Bunkoku Puzzle wouldn't have remained a mystery till today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760814,
					"content": "What are you two murmuring about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760815
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760815,
					"content": "N—Nothing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760816,
					"content": "(Anyway, let's keep investigating this place.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760812,
					"content": "It's possible.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760813
					]
				},
				{
					"id": 722760813,
					"content": "No, no. Had they successfully found the treasure, the Bunkoku Puzzle should've been solved long ago. It wouldn't have remained a mystery till today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760814
					],
					"speakerTitle": "Paimon"
				}
