					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "You're done, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110202,
					"content": "Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "Thank you very much. Leave the fortune slips to me and I'll hang them up in the right place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110204,
					"content": "Please take these as thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110205,
					"content": "I understand that people are desperate to get rid of bad luck and to get good luck...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110206,
					"content": "But I think that if they really want to solve their problems, their own actions will be more effective than fortune slips.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110207,
					"content": "How do they expect the gods to offer help if they don't take any action themselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				}
			]
		},
