			"dialogs": [
				{
					"id": 751340301,
					"content": "Phew... It's finally over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340302,
					"content": "The Secret Source Automaton protecting it has also calmed down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340303,
					"content": "Now let's see what's inside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340304,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340305,
					"content": "Paimon hopes it won't let her down... Huh, another Pyrophosphorite chunk? There's more than one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340306,
					"content": "Wait, the woven scrolls wrapped around it look familiar. They're just like the notes we found in the tower outside the ruins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340307,
					"content": "Rawr... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340308,
					"content": "#That's pretty strange. Don't you think so too, {REALNAME[ID(2)|SHOWHOST(true)]}? {NICKNAME}, what's written on them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340309,
					"content": "Wow, these notes really were left behind by the same adventurer. So this must be the Core of Chu'ulel, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340310,
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340310,
					"content": "There are other possibilities.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340311
					]
				},
				{
					"id": 751340311,
					"content": "True, and we did find a new hunk o' Pyrophosphorite here. Maybe there are more to be found elsewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340312,
					"content": "There are too many things here that make little sense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340313
					]
				},
				{
					"id": 751340313,
					"content": "True, and Coco did point us here. Did he know there was a Pyrophosphorite chunk and wanted us to have it? Paimon doesn't get it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340314,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340315,
					"content": "We should head back first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340316
					]
				},
				{
					"id": 751340316,
					"content": "You're right, Coco probably knows what's going on, and we did promise Bona that we'd go back no matter what we found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340317,
					"content": "Let's take this back to Bona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340318
					]
				},
				{
					"id": 751340318,
					"content": "You're right, maybe Bona will know what's going on, and we did promise her that we'd go back no matter what we found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340319,
					"content": "Let's get out of here, and quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
