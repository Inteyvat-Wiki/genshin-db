					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270301,
					"content": "What were you doing out there?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "Oh, come on. What's with that look of suspicion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270303,
					"content": "I just went out for a stroll, really! I legged it back here the moment those meteorites started falling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270304,
					"content": "Well, whatever. Go out there and have a look. <color=#00E1FFFF>Come back and look for me if you really can't find it</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270305,
					"content": "I'll give it a bit more thought. Maybe I'll remember something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 4112704,
			"completionStepIds": [
				4112706
			],
