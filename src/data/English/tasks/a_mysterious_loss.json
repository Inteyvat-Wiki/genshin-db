				"points": []
			},
			"dialogs": [
				{
					"id": 411270401,
					"content": "What's in the box?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "That's, uh, none of your business. Just a few odds and ends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270403,
					"content": "Come on! Don't look at me like that. I'm not some kind of villain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270404,
					"content": "But you're with the Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "Fatui this, Fatui that... So all of us are the bad guys now? What sort of logic is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270406,
					"content": "Well, whatever. Go out there and have a look. <color=#00E1FFFF>Come back and look for me if you really can't find it</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270407,
					"content": "I'll give it a bit more thought. Maybe I'll remember something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
