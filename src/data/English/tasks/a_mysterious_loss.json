			"dialogs": [
				{
					"id": 411271101,
					"content": "So, what do you know about the meteorites?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411271102
					]
				},
				{
					"id": 411271102,
					"content": "The meteorites... Well, not that I don't want to tell you, but I have no clue either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271103,
					"content": "All I do is stand here in Mondstadt, unable to leave or move. What do I know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271104,
					"content": "But my gut feeling tells me that those meteorites don't bode well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411271105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411271105,
					"content": "I'd stay out of this one if I were you. It can only mean trouble.",
