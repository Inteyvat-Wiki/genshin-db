			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270101,
					"content": "Oh, this is terrible. I'm finished for sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270102,
					"content": "Something wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270103
					]
				},
				{
					"id": 411270103,
					"content": "Gah! Staying here was just too boring, what with the weird looks the sisters give me and all, so I decided to get out, get some fresh air...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270104,
					"content": "But just as I left the city, thinking to go to the Thousand Winds Temple for a stroll... all these meteorites started raining down from the sky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270105,
					"content": "There was no way I was staying out there, so I ran back into the city... And that's when I realized that I left a box behind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270106,
					"content": "Given all the chaos out there, I didn't dare to go out to look for it, either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270107,
					"content": "And, well... I'm Fatui. If I were to make any sudden moves, I'd be suspected of doing something untoward for sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270108
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270108,
					"content": "Bah, enough nonsense. Could you help me look for that thing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270109,
					"content": "Our transactions have been quite amiable so far, and I plan to continue doing good business with you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270110,
					"content": "Stop saying such suspicious stuff.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270111
					]
				},
				{
					"id": 411270111,
					"content": "What? Come now, there was nothing suspicious about the stories I told you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270112,
					"content": "Well, how about it? Will you help me out, or won't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
