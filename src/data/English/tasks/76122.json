					"The Damselette",
					"Luonnotar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761220301,
					"content": "Now, I know how fond you are of them, but let's not cause them any trouble now, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220303
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220303,
					"content": "Come back here to rest, should you find yourself tired from playing outside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220302
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220302,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luonnotar"
				}
			]
		},
