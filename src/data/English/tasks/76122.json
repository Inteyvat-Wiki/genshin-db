			"dialogs": [
				{
					"id": 761220101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "Huh. That's odd. Paimon's positive she heard Columbina's voice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "...Hyah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220104,
					"content": "Aaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Greetings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220106,
					"content": "Another jumpscare? Not cool! If you were here, you should've just said so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "I thought that since you were already so familiar with this game, I should increase the difficulty this round...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220108,
					"content": "Hmph! Paimon's gonna get you next time, just you wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "Great! I look forward to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220110,
					"content": "What happened to your eye mask, Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Oh. I guess the kuuhenki must've swiped it when we were playing earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220112,
					"content": "I don't usually need to use my eyes, so the mask makes little difference. Let them play with it if they like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220113,
					"content": "Oh! On that note, don't you want to go out more often?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "You no longer need to hide from anyone, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Yes... I have plenty of time now. I can go where I wish, when I wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220116,
					"content": "However, I was concerned that you might worry if you came looking for me but found that I had left without saying goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220117,
					"content": "In this kind of situation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "Yeah! After all, we only need to know that you're okay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "I see. I will consider it, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220121,
					"content": "You'll only \"consider\" it...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "Or maybe this is just where you want to be.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Everything that has happened here... I find them to be happy memories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220124,
					"content": "That said, I do have another reason for waiting for you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220125,
					"content": "And what's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "To give you a pleasant surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220118,
					"content": "You can just leave a note.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
