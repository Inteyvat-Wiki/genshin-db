			"dialogs": [
				{
					"id": 761220201,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220202,
					"content": "Luonnotar! It's really you! You're back! In the silvery flesh! Paimon thought she'd never see you again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220203,
					"content": "The painting we drew...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "We used moonlight to trace this child's form, and I poured new power and new blessings therein, causing her to be reborn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220205,
					"content": "She no longer needs to bear my spirit. Her will is hers alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220206,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220207,
					"content": "Ah, she's flying over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220208,
					"content": "Yes. I have awakened all the memories of the time you spent together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220210,
					"content": "...! ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220211,
					"content": "*sniff* Paimon's so glad to have you back, Luonnotar. She promises to be nicer to you from now on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220212,
					"content": "Paimon wasn't expecting the surprise to be this pleasant... Paimon loves it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220213,
					"content": "Thank you, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "It wasn't much. I, too, am glad to see her again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220216,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220217,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220218,
					"content": "(She's still very attached to Luonnotar, but her expression is different from before.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "(She looks at Luonnotar not as merely a created familiar, but as a familiar friend.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "Go. You must miss them, surely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220221,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220222,
					"content": "You're welcome to come back any time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
		{
			"id": 7612203,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
