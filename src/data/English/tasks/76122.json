				]
			},
			"dialogs": [
				{
					"id": 761220401,
					"content": "Wow! This must be the place you were talking about, right? Paimon wasn't there last time, so she didn't get to see it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220402,
					"content": "It truly is lovely.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220403
					]
				},
				{
					"id": 761220403,
					"content": "Can Paimon fly around and check it out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220404,
					"content": "Of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220405
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220405,
					"content": "If it pleases you, I could bring you back again someday.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220406
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761220406,
					"content": "So, this is the \"pleasant surprise,\" then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220407
