					"content": "Now, all we need to do is wait for our beacons to collect enough data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170402,
					"content": "Once we have that data on hand, I will make a few tweaks to this device accordingly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170403,
					"content": "Once all is ready, let us put a decisive end to this incident.",
