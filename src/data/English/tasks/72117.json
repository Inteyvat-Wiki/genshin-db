				"points": []
			},
			"dialogs": [
				{
					"id": 721170101,
					"content": "Ah, such perfect timing, Traveler! The data has almost all been gathered, and it is now time to retrieve our beacons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "That I shall, that I shall. Best to be quick, and sneaky too. Don't let those Fatui spot you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "How do you know?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "These beacons always come with very detailed instruction manuals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "These describe various different circumstances and the amount of time required for data-gathering in each circumstance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "As for unknown forms of energy like Tatarigami, I will simply consider them to require the longest duration. Either way, the task of retrieving those beacons falls to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7211702,
