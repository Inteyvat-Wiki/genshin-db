				"points": []
			},
			"dialogs": [
				{
					"id": 721170301,
					"content": "How did it go? Do you have all our beacons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170302,
					"content": "Got them all right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "Bravo! Now, just give me a moment while I modify this device.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170304,
					"content": "I must say, the Fatui have been acting more and more strangely recently. They seem to be gathering around the core of the furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170305
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170305,
					"content": "Hopefully, they aren't hatching some other dastardly plot. Or should I say, trying to do something that we won't be able to mitigate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
