			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280801,
					"content": "(Hand over \"Ballads of the Squire.\")",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280802
					]
				},
				{
					"id": 708280802,
					"content": "Oh, the story about the Ragnvindr Clan, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280803
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280803,
					"content": "But it doesn't really work as a love poem. That Fontaine musician never actually falls in love with the squire knight. They both just end up dead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280804
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280804,
					"content": "And romance is really something best left to the living. So... got any other poetry collections?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
