			},
			"dialogs": [
				{
					"id": 708280601,
					"content": "Oh! Golden-haired adventurer! Did you bring any love poetry worthy of inspiring a genius like me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082807,
			"completionStepIds": [],
