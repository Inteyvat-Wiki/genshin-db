	"talks": [
		{
			"id": 7082801,
			"completionStepIds": [
				7082801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082801",
							"2"
						],
						"stepId": 7082801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "Ah! Excuse me! You, the golden-haired adventurer! Please wait a moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "Do you need our help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "Oh, no, it's nothing like that! I just wanted to ask if you happen to have a collection of poems about love.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "Look, I'm an incredible bard — maybe the most incredible in all of Mondstadt after Lord Barbatos himself! Seriously, I'm amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "But there's Linus... that pesky bard never seems to admit I'm better! He shows up all the time, reciting poems at me nonstop! No matter how you look at it, he's obviously trying to one-up me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "And the worst thing? Every single poem is about love and romance... things I've never even touched!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "So I'm taking matters into my own hands. I'm going to write a love poem so epic that Mondstadt will never forget it! That'll teach him what real talent is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Of course... since I've been dedicating all my time to the pursuit of truly great art, I haven't had a chance to experience love myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "So if you happen to have a poetry collection about love, please sell it to me! I just need to flip through them for a bit. Once I do, inspiration will start pouring in. With talent like mine, that's practically inevitable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "I'm afraid I can't help. I have other things to attend to. Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "No, no! I didn't mean for you to help. After all, if everyone asked a stranger for help every time something went wrong, nobody would ever dare travel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "Ahem. I just wanted to ask if you happen to have a book of love poems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
