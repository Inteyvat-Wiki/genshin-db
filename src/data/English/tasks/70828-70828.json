			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280701,
					"content": "(Hand over \"Breeze Amidst the Forest.\")",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280702
					]
				},
				{
					"id": 708280702,
					"content": "Haha, Breeze Amidst the Forest? Come on, I'm a brilliant bard. You think I wouldn't know that one? I've read it cover to cover more times than I can count! Haven't you got something new?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082808,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
