						"rawParams": [
							"121562",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "(Hand over \"The Song of Ay-Khanoum.\")",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "Whoa, what a beautiful book! Alright, let's see what it says...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "\"...No throne stands without serpents beneath it, no rose blooms free of thorns. Drink the bitterness to the final drop, Ferigees, and with those sweet eyes of yours, promise me... promise me...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "Uh... wait, how do you pronounce this one again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "Yeah, that's definitely too profound for me! My tongue's already in a knot! I'll just take it home and read it slowly later... Thanks, golden-haired adventurer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082803",
							"2"
						],
						"stepId": 7082803,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_GREATER",
						"rawParams": [
							"121563",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "(Hand over the \"Revelations of Divine Love.\")",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "Oh! I've heard of this one before. It's a poetry collection from the Church of Favonius, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "Let me see... \"Her soul is a field aflame, pouring its fiery song into the wind. Between the stars, the moon, and the radiant sun, even my own light is burned by her glow...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "What kind of poem is that? It's honestly a bit unsettling... and the Church of Favonius clearly doesn't know much about poetry. I mean, stars, the moon, and the sun all appearing together? As if!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "Well, that settles it! My confidence is back. If that's the level of poetry in this book, then even I could do better. I'll buy it. Thanks, golden-haired adventurer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082804,
			"completionStepIds": [
				7082804
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
