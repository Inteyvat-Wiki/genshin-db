			"dialogs": [
				{
					"id": 230050601,
					"content": "This is that tycoon's apple cider, yes? Ah, what an extraordinary aroma. It truly clears the mind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "Great! This is the good stuff indeed. It shall surely bring about a shift in the market!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "I won't forget the help you two have given me! I'll see you around!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
