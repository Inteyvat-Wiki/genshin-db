			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050402,
					"content": "Hi! Hatim, how have you been?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050403,
					"content": "Oh... It's you guys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050404,
					"content": "Well, I guess you can tell from my expression, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050405,
					"content": "I'll be honest, my wallet has been rendered half empty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050406,
					"content": "Strange... This isn't how things should have gone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050407,
					"content": "But then again... I have a suspicion that this is a sign that the market's about to take off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050408,
					"content": "It's like how people have to bend down before they can leap high.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050409,
					"content": "The same goes for the futures trading market. The entire market just fell to an all-time low and it's about to bottom out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050410,
					"content": "In other words, now is the best time to go bargain-hunting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050411,
					"content": "Maybe it hasn't hit the bottom yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "No. I am pretty sure this is a once-in-a-lifetime chance, and Hatim never misses any chance to gain wealth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050414,
					"content": "That would be worthy of my name as Kalimi's exceptionally wealthy Hatim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050415,
					"content": "Come, friend, help me out one more time, will you? Please choose another \"Golden Dish\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050416,
					"content": "Still from the original options?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050417,
					"content": "Hm... Wait, no! Since we're going bargain-hunting, I need a dish that is extra special to turn the tide on the market.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050418,
					"content": "I heard that Mondstadt has a tycoon who runs a super profitable alcohol business...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050419,
					"content": "Do you mean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "Master Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050421,
					"content": "But how did you know about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050422,
					"content": "Hahaha, how could I not know of him, when I even know about \"Pile 'Em Up\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050423,
					"content": "He owns a tavern where they sell something wonderful known as Apple Cider. If I down some of that, I believe I shall imbibe some of his affinity for wealth as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050424,
					"content": "So please, help me get a bottle of Apple Cider!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050412,
					"content": "Some people get leg cramps when they bend low...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
