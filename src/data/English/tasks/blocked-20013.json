				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200130301,
					"content": "Thank you so much, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "I was on my way to check out somewhere Stanley once went on an adventure. Had I known they would show up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "I'm just not strong enough... I know for a fact that Stanley would have had no problem dealing with a group like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "Why don't you join me? Join me! ...Ugh, never mind, I can't have someone else doing even my adventuring for me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "I'm going to get moving. This is for you, I've gathered loads on the way to supplement my rations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130306,
					"content": "...Even though they're not exactly rations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
	]
