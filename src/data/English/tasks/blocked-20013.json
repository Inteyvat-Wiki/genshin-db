				"points": []
			},
			"dialogs": [
				{
					"id": 200130201,
					"content": "Traveler, it's you! Thank you so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130202,
					"content": "Can I ask you for a favor...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130203,
					"content": "This roadblock here is the only thing getting between me and my adventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130204,
					"content": "Can you get rid of it for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130205,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "*sigh* I wish I was more like you... I'd be a veteran Adventurer by now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130206,
					"content": "I'd love to, but I have to get going.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "Please, I'm begging you... I can't let this be where my adventure ends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2001303,
