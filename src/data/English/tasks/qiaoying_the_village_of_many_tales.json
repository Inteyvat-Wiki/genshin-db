			"dialogs": [
				{
					"id": 700501501,
					"content": "...Don't think the character would be able to return to the village alone like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501502
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501502,
					"content": "Guijarro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501503,
					"content": "Let's help her up first...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501504
					]
				},
				{
					"id": 700501504,
					"content": "You help Guijarro up so she's sitting properly on the ground.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501505
					]
				},
				{
					"id": 700501505,
					"content": "So that's how it feels... It's quite awful, indeed. Not only am I exhausted... I feel like even my mind's gotten all sluggish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501506
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501506,
					"content": "Mission accomplished, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501507
					]
				},
				{
					"id": 700501507,
					"content": "Of course. I finally know how it feels to be tied, strung up, and left to the elements for a night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501508
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501508,
					"content": "That protagonist of yours is pretty tough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501509,
					"content": "That's right. I've also figured out how the protagonist is going to chase the Xuanwen Beast away. If we conclude the story that way, it will surely... Surely...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501510,
					"content": "Ooh? Are they going to pull off a super cool trick?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501511,
					"content": "It will surely... be really awesome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501512,
					"content": "Guijarro faints once again...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501513
					]
				},
				{
					"id": 700501513,
					"content": "Hey! Hey! Guijarro, you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501514,
					"content": "Couldn't you have said how this would work *before* fainting?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501515
					]
				},
				{
					"id": 700501515,
					"content": "A—Anyway, let's get her to a doctor... Back to the village!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501516,
					"content": "Ms. Hung Fan was right. This lady really shouldn't have left the village...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
