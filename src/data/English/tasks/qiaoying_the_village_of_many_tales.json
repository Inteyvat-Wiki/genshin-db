						],
						"pointId": 311400056
					}
				]
			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "...See? Paimon said it was just an ordinary kitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "Huh. To think that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500503,
					"content": "Meow? Meow... meow, meow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Confused Kitty"
				},
				{
					"id": 700500504,
					"content": "Do you know of any Xuanwen beasts?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "Meow...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Confused Kitty"
				},
				{
					"id": 700500508,
					"content": "The cat turns and leaves, looking frustrated...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Still... Do you think that this kitten could be the young form of the mythical beast, lying low here in Qiaoying Village till it is fully grown, and can destroy all the tea trees in one fell swoop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500510,
					"content": "Ms. Guijarro, not this again... Anyway, haven't I told you before that Xuanwen beasts are hardly that gentle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Ah, Ms. Hung Fan! What a coincidence. What brings you here today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500512,
					"content": "*sigh* Please stop mentioning things like \"criminal cases\" around here — what if the children begin to take you seriously?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "You know each other?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Yes. When I came here, it was this lady who I hired to help me carry my baggage. I also consulted her regarding all manners of folklore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500515,
					"content": "If I've told you once, I've told you countless times that Xuanwen beasts won't appear here, but you just won't believe me. What was that thing you said...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Even if they won't appear, I'll still have many ways to collect information on them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500517,
					"content": "There you go again... I know my hopes of dissuading you were slim, but still, I must ask you not to leave the village willy-nilly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "The beasts are actually quite dangerous, so if you do end up encountering one... *sigh* Anyway, please do not leave the village on your own!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan leaves, looking even more exhausted and resigned than the cat from earlier...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Well, since Ms. Hung Fan said so, we're going to have to go elsewhere to get our material. Come then, follow me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500506,
					"content": "Sorry, we've got the wrong cat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Meow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Confused Kitty"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
							"2"
						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "What do you think? This...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "A tea cauldron.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "That's right, and it does... something with the tea... that makes it kinda special... Whatever the case, it's been placed smack dab in the middle of this place, too! If you ask me, it must hold some special significance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "Hmmm. Now then, what if... our Xuanwen Beast has been using this as its hiding place all along?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "You'll be writing a fantasy story at this rate, you know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Feels like the next thing you know, you'll introduce some Adepti into the story...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "I dunno if that's the right kind of plot to write for a crime story...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "...Hmm, those are some fine expressions you've got there. Are you thinking, perhaps, that a crime story centered around a Xuanwen beast might feel too \"absurd\" to be taken seriously?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "Well, uh, yeah, kinda? Can you really use something like that to move the plot forward?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Wait, don't tell me you're...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Haha, aren't you a sharp one, {NICKNAME}? You sure do live up to your fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "Exactly! I intend to write about a \"crime too absurd to be possible.\" Your reactions, along with Ms. Hung Fan's, are very interesting. I'll include them into my novel for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "As for the Xuanwen beast... It shall be my \"perpetrator.\" A creature that has never been seen, but is said to devour the village's evil-doers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "During a certain festival, a villager is found to have met their end at the hands of some wild beast outside the settlement...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "But during the second festival day, the main character encounters the victim, who should be dead — only for yet another victim to soon emerge afterward...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "Wait, and then what? Then what!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "Well, I haven't thought that far yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "...I'm leaving now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "Oh, come on! Once I finish, I'll send you two autographed copies for sure. In fact, I've still got a big favor I'll need your help with!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "Ms. Hung Fan has said that I shouldn't leave the village by myself, right? Well, I've taken her advice to heart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "But... now that you're here, I'm no longer alone! That means I can go outside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "We're not going to go too far off, of course! So, are you willing to help me out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "Well, sure... We'll do it so you can tell us the end of your story.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Well, then! Let's head over there, shall we? There's a place I'd like to go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "Please follow the standardized payment model, thanks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Of course. Don't you worry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500606,
					"content": "I don't think this is a crime story anymore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
