			},
			"dialogs": [
				{
					"id": 700500801,
					"content": "So these are \"lanterns\"? These ones look like fish — how very fascinating!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500802,
					"content": "So these handles can be used to raise the lanterns up? Hmm... With this detachable structure, someone with a head for engineering design can easily have a section or two secretly added without being discovered...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500803,
					"content": "The space within is pretty large. You should be able to insert a few...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500804,
					"content": "Stop! Jolly well keep those thoughts to yourself!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "Eh? Oh... Right! Hahaha, sorry. I just can't stop myself from thinking aloud upon seeing these fascinating things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500806,
					"content": "Hmm. Yes, I'm sure of it — the addition of \"lanterns\" will add much to my novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500807,
					"content": "Could I trouble you to go to the side, and take a picture of this \"fish lantern\" for me? I'd like to have a reference picture for later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500808,
					"content": "Well, time to hone my Kamera skills some more, I guess...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "I'm leaving the photo-taking in your hands, then... Ah, yes. Please make sure you'll grab a shot of the entire lantern — this is incredibly important to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500811,
					"content": "...Cooking up a scheme related to \"dimensions\" will be quite interesting... The question now is how they will solve the weight problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500809,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
		{
			"id": 7005010,
