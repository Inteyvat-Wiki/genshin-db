			"dialogs": [
				{
					"id": 761410501,
					"content": "I understand if you want to stay a while. After all, the scenery here exists only in my memories — you won't find it anywhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
