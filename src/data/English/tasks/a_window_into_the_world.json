				]
			},
			"dialogs": [
				{
					"id": 761410101,
					"content": "Welcome back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410102,
					"content": "But it's not time for a drawn-out, deeply emotional, tearful goodbye just yet... After all, you haven't finished your tour of my little lodge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410103,
					"content": "But Paimon could swear we've been in all the rooms already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410104,
					"content": "Well, I never actually said there were no secret hidden rooms, did I? Us mages like our little fancies, you know — you should be used to this by now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410105,
					"content": "This way, if you please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614102",
							"2"
						],
						"stepId": 7614102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "As one of the fixed observation points for changes in the world, I require it to have excellent visibility. Just as a sculptor needs a chisel, a writer needs both pen and ink...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410202,
					"content": "My achievements in those two fields of art may well be up for debate, but when it comes to my main line of work, I take things very seriously indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410203,
					"content": "#The \"fate\" of Teyvat has been shaken more and more frequently as of late. I'm sure you've felt it too, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410204,
					"content": "Sometimes I can't help but think, if I still had the form, power, and abilities I once possessed, I'd be able to do so much more than I can right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410205,
					"content": "But I soon shake those thoughts from my head. If things were how they were before, I'd have so many more restrictions placed on me by the heavens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410206,
					"content": "The thought of having that many things I can't even talk about makes it seem like a terrible trade-off. I mean, how would I tell stories without the freedom to say what I want?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410207,
					"content": "That's why I've never once regretted the price I paid, or any of the choices I've taken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410208,
					"content": "I wanted to become human, to live like a regular person... but such a life is a luxury. I can't forget that I am an angel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410209,
					"content": "Even if I were stuck being an angel in silence, I'd still fulfill my duties — defending civilization, defending life...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410210,
					"content": "Oh dear, have I started talking too seriously again? Perhaps it's because of where we are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410211,
					"content": "I'm actually quite happy with my angelic side. You could even say I'm proud of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410212,
					"content": "So you should be! You don't get involved much, but when you do, we all know we're in safe hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410213,
					"content": "You deserve to be proud.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "You really feel that way? Hehe, as long as you see me as someone to rely on, then I know I'm doing a fantastic job!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410215,
					"content": "It's getting late. Here, take my blessings and continue on your adventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410216,
					"content": "Never be afraid of losing your way, and never forget you have an angel watching over you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
