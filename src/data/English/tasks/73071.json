				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710101,
					"content": "Strange, what's this kid doing here? Hey kid! Why are you here all alone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710102,
					"content": "Ah! A weird person, and a weird flying person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710103
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710103,
					"content": "Hey, hey! That's rude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710104,
					"content": "Yeah, that's right. Rude's my middle name. Didn't even have parents to teach me \"manners,\" don'cha know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710105
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710105,
					"content": "(There's a story behind this for sure...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710106
					]
				},
				{
					"id": 730710106,
					"content": "Hmm... Anyway, we aren't weird people, and we definitely aren't bad guys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710107,
						730710109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710107,
					"content": "We're just a pair of kind travelers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710108
					]
				},
				{
					"id": 730710108,
					"content": "Exactly. And that's why we don't leave those who are troubled behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710111,
					"content": "#Paimon's name is Paimon, and this is {NICKNAME}. Might we know your name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710112,
					"content": "My name's Varsha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710113
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710113,
					"content": "And why are you here all alone, Varsha? We can escort you back if you're lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710114,
					"content": "No. The past should stay in the past. I've decided to move on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710115
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710115,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710116,
					"content": "I can't rely on adults. I must go my own way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710117
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710117,
					"content": "What's with this old-person talk...? You are just a kid! Anyway, the forest can be pretty dangerous. A kid like you isn't gonna be able to handle it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710118,
					"content": "Some bad guy tried to take me away earlier... But it's okay. I'm more careful now. I'll be able to avoid danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710119
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710119,
					"content": "He was a guy from Vimara Village, and he looked nice enough. But as it turns out, he was no different from those adults I met before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710120
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710120,
					"content": "You almost got taken away by some bad guy!? You haven't learned your lesson at all, then! Wait, and how did you manage to get away last time, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710121,
					"content": "Some small creature whisked me to this place. I've never seen something this small in Gandharva Ville, so I believe that it had to be a forest spirit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710122
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710122,
					"content": "(It could be an Aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710123
					]
				},
				{
					"id": 730710123,
					"content": "(That said, could \"that guy from Vimara Village\" refer to...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710124,
					"content": "Anyway, it's still not safe for kids to be alone in the forest. You might encounter all kinds of dangers, like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710125,
					"content": "Running into dangerous Fungi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710126
					]
				},
				{
					"id": 730710126,
					"content": "Yeah! And villains such as Nara Marana. Ugh, no, Paimon meant to say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710127,
					"content": "You might run into bad guys that might try to kidnap you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710128
					]
				},
				{
					"id": 730710128,
					"content": "#Yup! What {NICKNAME} said! Or... or you might starve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710129,
					"content": "It's impossible to starve in a forest full of nature's gifts. Starshrooms, Sweet Flowers, and Mints are everywhere, and I eat like a bird anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710130
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710130,
					"content": "And I've always been pretty good at taking care of plants, so finding a safe place to plant some Sweet Flowers or Mints to feed myself won't be a problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710131
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710131,
					"content": "Haha, a garden full of Sweet Flowers... Wouldn't that be paradise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710132
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710132,
					"content": "What a sweet daydream she's having, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710133,
					"content": "Anyway, I am much happier now than when I was in Gandharva Ville, and I don't get beaten... I appreciate your kindness. But right now, it'd be for the best if you left me alone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710134
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710134,
					"content": "Hmm... Paimon doesn't know what she's been through, but it seems like it would be hard to convince her to return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710135,
					"content": "To be fair, things don't look too dangerous around here... Let's come back and see her later if chance allows. Maybe she'll have changed her mind by then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710109,
					"content": "#We're looking for my lost {F#brother}{M#sister}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710110
					]
				},
				{
					"id": 730710110,
					"content": "Yes. So of course we got worried when we saw a little girl like you here all alone! We just can't leave you like this knowing that you might need help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307102",
							"2"
						],
						"stepId": 7307102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710201,
					"content": "As long as there are seeds, I can grow more Sweet Flowers. But bread is different. You can't plant bread.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710202
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710202,
					"content": "If bread could break in half and grow back again, no one would ever go hungry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varsha"
				}
			]
		},
		{
			"id": 7307103,
			"completionStepIds": [
				7307103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307103",
							"2"
						],
						"stepId": 7307103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710301,
					"content": "Hi Varsha! You're still here, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710302,
					"content": "#Paimon. {NICKNAME}. Good to see you. I'm doing well here. There's nothing for you to worry about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710303
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710303,
					"content": "You've persevered, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710304,
					"content": "Are you still trying to persuade me? I'm not going anywhere with you. Not at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710305
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710305,
					"content": "Well... we're not gonna force you to do anything. Remember what you said about \"a garden full of Sweet Flowers\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710306,
					"content": "Ah... It was a wishful thinking actually. I know there isn't such a place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710307
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710307,
					"content": "Hmm... This maturity still feels weird coming from a kid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710308,
					"content": "Guess what? We've got good news!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710309,
					"content": "There really is a garden full of Sweet Flowers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710310
					]
				},
				{
					"id": 730710310,
					"content": "Yes! And believe it or not, the \"forest spirit\" that saved you is from a species called Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710311,
					"content": "We know this, 'cause we've helped plant many Viparyas for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710312,
					"content": "We helped the earth to remember.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710313
					]
				},
				{
					"id": 730710313,
					"content": "That's right. According to Aranakula, Vanarana remembers everything, so the Viparyas can sprout in the garden once the land remembers them again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710314,
					"content": "...I've heard a lot of stories like this before, and only kids take them seriously. But I know you said this with good intentions, Paimon, so thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710315
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710315,
					"content": "Aren't you a kid as well? And Paimon's not telling stories. Paimon means it for real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710316,
					"content": "Yeah. That's what every storyteller says.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710317
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710317,
					"content": "If you don't believe us... Well, seeing is believing! Come with us and see for yourself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710318,
					"content": "Wait, you've really prepared a place to fit your story? Now I'm getting curious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710319
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710319,
					"content": "Ugh, Paimon's telling you the truth...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710320,
					"content": "#Let's take her to the Aranara's garden, {NICKNAME}. That should silence her doubts once and for all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307104,
			"completionStepIds": [
				7307105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307105",
							"2"
						],
						"stepId": 7307105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710401,
					"content": "#Did you prepare all this, Paimon and {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710402
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710402,
					"content": "Ugh... Yes and no. It's Aranakula and Arakara who tend to this garden together. We just helped out a little on the side. It is not built just for made-up stories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710403,
					"content": "Aranakula and Arakara... They are the \"Aranara,\" the forest spirits?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710404
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710404,
					"content": "Yes! You finally believe Paimon now? Not only did we help to take care of the garden, but we also went on adventures with the Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710405,
					"content": "The Aranara are the ones who take the kidnapped kids back to Vimara Village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710406,
					"content": "It's still hard to believe the stories though... But if I stay here, will I have a chance to see them too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710407
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710407,
					"content": "Vanarana is not actually dangerous, but are you sure you don't want to go back to Gandharva Ville?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710408,
					"content": "You have a memory like a sieve, Paimon. I said I couldn't rely on adults and that I want to go my own way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710409
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710409,
					"content": "But...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710410
					]
				},
				{
					"id": 730710410,
					"content": "Alright, don't worry about me. I've managed to live on my own so far, remember?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710411
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710411,
					"content": "And I am a great caretaker of plants. The Aranara would be happy to see the garden flourishing here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710412
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710412,
					"content": "Well, if you insist...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710413,
					"content": "You're such a worrywart, Paimon. No one has cared about me this much for as long as I can remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710414
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710414,
					"content": "Uh... Listen here, Varsha, you are safe here in Vanarana. But you are still a kid, so please take care of yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710415,
					"content": "I know, I know. You two take care as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varsha"
				}
			]
		},
		{
			"id": 7307105,
			"completionStepIds": [
				7307107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307107",
							"2"
						],
						"stepId": 7307107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710501,
					"content": "Strange, what's this kid doing here? Hey kid! Why are you here all alone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710502,
					"content": "Ah! A weird person, and a weird flying person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710503
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710503,
					"content": "Come on, that's rude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710504,
					"content": "Yeah, that's right. Rude's my middle name. Didn't even have parents to teach me \"manners,\" don'cha know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710505
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710505,
					"content": "(There's a story behind this for sure...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710506
					]
				},
				{
					"id": 730710506,
					"content": "Hmm... Anyway, we aren't weird people, and we definitely aren't bad guys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710507,
						730710509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710507,
					"content": "We're just a pair of kind travelers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710508
					]
				},
				{
					"id": 730710508,
					"content": "Exactly. And that's why we don't leave those who are troubled behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710511,
					"content": "#Paimon's name is Paimon, and this is {NICKNAME}. Might we know your name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710512,
					"content": "My name is Varsha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710513
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710513,
					"content": "And why are you here all alone, Varsha? We can escort you back if you're lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710514,
					"content": "No. The past should stay in the past. I've decided to move on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710515
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710515,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710516,
					"content": "I can't rely on adults. I must go my own way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710517
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710517,
					"content": "What's with this old-person talk...? You are just a kid! Anyway, the forest can be pretty dangerous. A kid like you isn't gonna be able to handle it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710518,
					"content": "Some bad guy tried to take me away earlier... But it's okay. I'm more careful now. I'll be able to avoid danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710519
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710519,
					"content": "He was a guy from Vimara Village, and he looked nice enough. But as it turns out, he was no different from those adults I met before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710520
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710520,
					"content": "You almost got taken away by some bad guy!? You haven't learned your lesson at all, then! Wait, and how did you manage to get away last time, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710521,
					"content": "Some small creature whisked me to this place. I've never seen something this small in Gandharva Ville, so I believe that it had to be a forest spirit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710522
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710522,
					"content": "(That should be an Aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710523
					]
				},
				{
					"id": 730710523,
					"content": "(That said, could \"that guy from Vimara Village\" refer to...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710524,
					"content": "Anyway, it's still not safe for kids to be alone in the forest. You might encounter all kinds of dangers, like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710525,
					"content": "Running into dangerous Fungi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710526
					]
				},
				{
					"id": 730710526,
					"content": "Yeah! And villains such as Nara Marana. Ugh, no, Paimon meant to say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710527,
					"content": "You might run into bad guys that might try to kidnap you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710528
					]
				},
				{
					"id": 730710528,
					"content": "#Yup! What {NICKNAME} said! Or... or you might starve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710529,
					"content": "It's impossible to starve in a forest full of nature's gifts. Starshrooms, Sweet Flowers, and Mints are everywhere, and I eat like a bird anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710530
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710530,
					"content": "And I've always been pretty good at taking care of plants, so finding a safe place to plant some Sweet Flowers or Mints to feed myself won't be a problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710531
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710531,
					"content": "Haha, a garden full of Sweet Flowers... Wouldn't that be paradise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710532
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710532,
					"content": "A garden full of Sweet Flowers, huh... Ooh, Paimon remembers that there were many in the garden we took care of for the Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710533,
					"content": "Wait. Are you saying that there really is a paradise like that out there, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710534
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710534,
					"content": "Yup! And believe it or not, the \"forest spirit\" that saved you is from a species called the Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710535,
					"content": "We know this, 'cause we've helped plant many Viparyas for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710536,
					"content": "We helped the earth to remember.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710537
					]
				},
				{
					"id": 730710537,
					"content": "That's right. According to Aranakula, Vanarana remembers everything, so the Viparyas can sprout in the garden once the land remembers them again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710538,
					"content": "...I've heard a lot of stories like this before, and only kids take them seriously. But I know you said this with good intentions, Paimon, so thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710539
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710539,
					"content": "Aren't you a kid as well? And Paimon's not telling stories. Paimon means it for real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710540,
					"content": "Yeah. That's what every storyteller says.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710541
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710541,
					"content": "If you don't believe us... Well, seeing is believing! Come with us and see for yourself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710542,
					"content": "Wait, you've really prepared a place to fit your story? Now I'm getting curious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710543
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710543,
					"content": "Ugh, Paimon's telling you the truth...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710544,
					"content": "#Let's take her to the Aranara's garden, {NICKNAME}. That should silence her doubts once and for all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710509,
					"content": "#We're looking for my lost {F#brother}{M#sister}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710510
					]
				},
				{
					"id": 730710510,
					"content": "Yes. So of course we got worried when we saw a little girl like you here all alone! We just can't leave you like this knowing that you might need help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307106,
			"completionStepIds": [
				7307108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307108",
							"2"
						],
						"stepId": 7307108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710601,
					"content": "Wow, there are so many Sweet Flowers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710602
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710602,
					"content": "Don't run so fast, Varsha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710603,
					"content": "The flowers are coming along very well here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710604
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710604,
					"content": "#Come on over, Paimon! You too, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710605
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710605,
					"content": "#Varsha just can't sit still for even a second... Let's go, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}