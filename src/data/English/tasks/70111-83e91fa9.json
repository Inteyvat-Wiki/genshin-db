					}
				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "Honored traveler. A word, if you please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "I shall spare you the unnecessary particulars. There is a matter in which I require assistance. Some days ago, the eminent Yu Huangyi of Liyue sent me a treasure of extraordinary rarity. Yet even now, it has failed to reach my hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "I have reason to believe the guardian of this region has intercepted it. Should you find this \"treasure,\" I would ask that you recover it on my behalf. Rest assured, you shall receive proper recompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "We're back! Take a look. Is this the \"treasure\" you meant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "Ah! You have my sincerest gratitude, truly! I cannot thank you enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Very well. There's no reason to delay. Allow me to open it at once —",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "Th–This is...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "Whoa! Is that thing about to explode!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "Nay, the good Yu Huangyi would never seek to harm me... Then could it be that the guardian seized it and transformed it into a bomb!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "I regret to say, I know naught of dismantling such devices... We have no alternative! Throw it clear!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "Not to fear! I remember now. A certain noble from Hyperborea once mentioned the proper method of casting a sacred bomb!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "\"One shall count to three. Not more. Not less. Three shall be the number counted. Four is forbidden. Two may not be lingered upon. Five is entirely out of the question. And once the number three is reached...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "Stop explaining and throw it already! It's about to go off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7011103,
			"completionStepIds": [
				7011103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
