			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							361.8,
							202.397,
							620.8
						],
						"pointId": 230
					}
				]
			},
			"dialogs": [
				{
					"id": 701110301,
					"content": "Huh? Wait. That's it? We freaked out over fireworks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110302,
					"content": "S–Such brilliance... Even in my years serving beneath Her Excellency, the Almighty Narukami Ogosho, never have I witnessed such a radiant blossom of flame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110303,
					"content": "I see, so this is the sight Sir Yu wished me to behold... This is more than I could have hoped for. I am deeply honored...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110304,
					"content": "\"In the night dark as raven jade, the blossoms bloom bright among the clouds. The body, like foam on the water, must but return to silence in an instant. As the stars depart and the rain disperses into the void...\" Verily, what refined elegance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110305,
					"content": "Well, Paimon doesn't really get the whole \"elegance\" part, but at least it wasn't dangerous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}