			"dialogs": [
				{
					"id": 722610401,
					"content": "Thank goodness we found you! Are you alright, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610402,
					"content": "*whimpers*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610403
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610403,
					"content": "Don't worry, it's okay. But don't run off by yourself next time, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610404,
						722610408,
						722610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610404,
					"content": "You're like his big sister, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610405
					]
				},
				{
					"id": 722610405,
					"content": "Paimon's older than Kichiboushi. Of course Paimon's the big sister!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610406,
					"content": "Though I could hardly tell...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610407
					]
				},
				{
					"id": 722610407,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610412,
					"content": "#Mm-mm! Thank you, {NICKNAME}. Thank you, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610413,
					"content": "Kichiboushi, almost sealed! Very scary. But Paimon calling Kichiboushi, so not so scary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610414,
					"content": "Ah, right, Ioroi did say that some smaller tanuki were also sealed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610415,
					"content": "Inside amber, very scary. Dark, cannot see. Cannot talk. Cannot move. Cannot \"kapow\"! Like becoming stone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610416,
					"content": "Ioroi is stone, but still very powerful. Can talk, can see. But cannot move.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610417,
					"content": "Would you like to help Ioroi, Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "Mm. Then, help other stone tanuki too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610419,
					"content": "But we're here with you right now, Kichiboushi. We won't let you be sealed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610422,
					"content": "Yey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610423,
					"content": "But you mustn't be too naughty, either!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610424,
					"content": "Mm. Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610425
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610425,
					"content": "That's a good boy! Shall we stop here for now? You must need some rest too, Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610426,
					"content": "Not tired!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610427
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610427,
					"content": "Ooh, isn't this a pickle. If Kichiboushi won't be good, then Paimon doesn't know where we should go next...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610428,
					"content": "Mm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610429
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610429,
					"content": "Kichiboushi begrudgingly admits to being tired...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610430
					]
				},
				{
					"id": 722610430,
					"content": "Phew! Kichiboushi really is like a child.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610431,
					"content": "And you're getting better at dealing with then, eh, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610432
					]
				},
				{
					"id": 722610432,
					"content": "Really? Maybe that's because Paimon's been traveling with you for so long! Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610433,
						722610435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610433,
					"content": "Oh, treating me like a kid now, are we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610434
					]
				},
				{
					"id": 722610434,
					"content": "No, no! Haven't we been accompanying kids a lot? You know, like Dusky Ming and Changchang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610437,
					"content": "Paimon's definitely learned a lot from traveling with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610438,
					"content": "And this time, the lesson is... Bake-danuki and adepti might not get along.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610439,
					"content": "We've got to give our next destination some thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610435,
					"content": "Hmm, come to think of it, we have had to take care of many children...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "Exactly! Like Dusky Ming and Changchang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610420,
					"content": "Aye, we'll protect you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610421
					]
				},
				{
					"id": 722610421,
					"content": "That's right! With us around, there's no way you'll be sealed, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610408,
					"content": "You're like his mom, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610409
					]
				},
				{
					"id": 722610409,
					"content": "What!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610410,
					"content": "Paimon's like his granny.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610411
					]
				},
				{
					"id": 722610411,
					"content": "#\"Ooh, {NICKNAME}, you've got to eat more. You're still growing! How will you grow unless you eat more?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				}
			]
		},
