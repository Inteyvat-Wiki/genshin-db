			},
			"dialogs": [
				{
					"id": 722610101,
					"content": "Hello— Mountain Shaper—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610102,
					"content": "Hello— Mon-Mon—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610104,
					"content": "Argh, seems like the adeptus isn't at home...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610105,
					"content": "Let's not be impolite to the adepti, now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "Paimon, what are adepti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610107,
					"content": "Hmm... They're very special people... Or very special animals?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610108,
					"content": "Like Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610109,
					"content": "Uh, not exactly! They have mystical powers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610110,
					"content": "They can \"kapow\"? Then, Kichiboushi also adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610111,
					"content": "Um, adepti are much more ancient, and they have a certain... Prestige? Dignity?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610112,
					"content": "Oh. Then Kichiboushi, not adeptus. Ioroi is adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610113,
					"content": "Ugh, this is pretty hard to explain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610114,
					"content": "The adepti are ancient powers who defend Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "Kichiboushi understands. Ioroi protects Chinju Forest, so not adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610116,
					"content": "Paimon's pretty sure that's not how it works, but if it clears up any misunderstandings...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610117,
					"content": "But since we've got this adeptus' abode in front of us, let's take a picture of Kichiboushi right here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610118,
					"content": "Mm! Kichiboushi, pose for picture!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610119,
					"content": "Good Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7226102,
			"completionStepIds": [
				7226104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
