							"7226104",
							"2"
						],
						"stepId": 7226104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"\"Kichiboushi\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "That was a great shot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610202,
					"content": "Mmhaha! Kichiboushi, handsome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610203,
					"content": "This kid's got zero humility...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610204,
					"content": "Ooh. Paimon, adepti use what magic?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610205,
					"content": "The adepti are super powerful. For example...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610206,
					"content": "Let's start with the amber around here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "What is amber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610208,
					"content": "Oh, Paimon remembers this one. Mountain Shaper has flowers that can create amber to trap bad things that invade his land inside them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610209,
					"content": "Mon-Mon, very powerful. Defends Liyue by trapping bad things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610210,
					"content": "Long ago, the very, very bad Four Oni of Ogata came into the forest and bullied many bake-danuki. Ioroi transformed into an official, gave them bake-danuki food to eat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610211,
					"content": "Later, Ioroi and Otogi King threw them into paper and sealed them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610212,
					"content": "Huh, so there's that sort of story too. No wonder Ioroi panicked when he saw that picture of Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610213,
					"content": "Ioroi is not adeptus, not defending Liyue. But Ioroi protects the forest. He protects tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610214,
					"content": "Different people have different things they need to defend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610216,
					"content": "You'll figure it out once you're older, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "That's why you've gotta train hard and become a super strong bake-danuki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610218,
					"content": "Mm! Of course! The world-famous bake-danuki, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610219,
					"content": "Paimon's really curious to know what Ioroi used to look like before he was sealed. He was probably a ball of fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610220,
					"content": "Huh, Paimon's suddenly reminded of those Treasure Hoarders who were trapped in amber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610221,
					"content": "They even took us for adepti messengers...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "That feels like it was so long ago now. But at the same time, it wasn't, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610223,
					"content": "Mm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610224,
					"content": "Ahem. Well, when we came to Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610225,
					"content": "#\"The Rite of Descension only happens once a year! Ahaha, I, {NICKNAME}, am gonna have all that delicious food! Come on, Paimon, let's go!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610226,
					"content": "\"And all the offerings, too! Paimon's flying over there right now!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610228,
					"content": "Best we stop misrepresenting events...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "Okay, okay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610230,
					"content": "You explain what happened in Liyue in simpler terms.\\nYou stop at the point where you went to seek the adepti out in Minlin.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#...As for what happened next, {NICKNAME} and Paimon went to that Liuli Pavilion place we were at earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610232,
					"content": "Mon-Mon and Clow-Clow, very powerful! They built a moving house!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610233,
					"content": "Clow-Cl— Cloud Retainer really loves gourmet food as well! We had to make lots of delicious stuff before we could meet with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610234,
					"content": "Greedy, like Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610235,
					"content": "Like Paimon indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610238,
					"content": "Is Paimon adeptus? Paimon is very powerful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610239,
					"content": "Uhh, this is kinda complicated. That was praise, sure, but Paimon doesn't feel so good about it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610240,
					"content": "But either way, Paimon isn't an adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610241,
					"content": "Want to play with adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610242,
					"content": "The adepti don't generally appear before people. But we can have a look around. It's pretty nice here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610243,
					"content": "Kichiboushi, go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610236,
					"content": "She can fly, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				}
			]
		},
