			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "There you are, sorry to bother you again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630102,
					"content": "You look well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "Haha, thanks for the compliment. I kind of thought it through.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630104,
					"content": "Perhaps, some things just can't be forced.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630105,
					"content": "Can you accompany me to the western beach tonight? I have something for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630106,
					"content": "Wow, is it some kind of sea treasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630107,
					"content": "You'll see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "We're here. This is where my father went to sea for the last time that year. It was a night like this too, and I never saw him again after that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630202,
					"content": "You miss him a lot, don't you? Is your wish to see your father again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630203,
					"content": "Haha, I do miss him, but the people of the sea will have to return to the sea one day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630204,
					"content": "But my wish is to become a fisherman who surpasses my father.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630205,
					"content": "When I was young, I always wanted to sail with my father, but he would only let my mother take me back. He sometimes even took the neighbor's son, and was not willing to take me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630206,
					"content": "He always said, \"Momiji, don't hang around on the beach, go do something girls should do.\" Or he would say, \"Take the money and buy a dress, don't run to the boat all the time.\" ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630207,
					"content": "But I didn't understand. Why? What are things that girls should do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630208,
					"content": "I can buy candy, pick flowers, and be a little princess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630209,
					"content": "But can't I go on an adventure, go far out to sea, or explore the ocean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630210,
					"content": "The more my father didn't want me to do it, the more I wanted to. After my father left, I became a fisherman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630211,
					"content": "Those seas he couldn't explore, I'll explore then. Those large fishes he couldn't catch, I'll catch them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630212,
					"content": "I will inherit the fishing methods of the Kujirai family. I will carry on the name of the Kujirai family of fishermen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630213,
					"content": "Even if the legend of the \"Lunar Leviathan\" is just a legend, I won't stop there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630214,
					"content": "I believe you will succeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630216,
					"content": "Since the divine fish is not here, I will pour my wishes into the sea. I think my father will see it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630217,
					"content": "Do you have any wishes? Let's do this together, write down your wishes, stuff them into a drifting bottle, and throw it out with all your might. They will come true one day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630218,
					"content": "Wow— Does this really work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630219,
					"content": "But Paimon has so many wishes, which one to write... Paimon's so torn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630220,
					"content": "Sorry for bothering you during this time! I don't even know how to thank you. Here are some gifts, I hope you don't mind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630221,
					"content": "Wow— Look, what's that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630222,
					"content": "What a big school of fish! They're glowing, they seem to like our drifting bottles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630223,
					"content": "When these guys gather together, it's like a big moon in the sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630224,
					"content": "These...these fish, they are \"Moonfins\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630225,
					"content": "Oh! I know...I know! So this is the \"Lunar Leviathan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630226,
					"content": "Eh? This is the \"Lunar Leviathan?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630227,
					"content": "That's right, I would never forget the way it looked. Its starry moonlit dots...That year that \"Lunar Leviathan\" also appeared under Jiawei when he dropped the drift bottle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630228,
					"content": "No wonder, after all these years, no one's been really able to catch the \"Lunar Leviathan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630229,
					"content": "Because it turns out, it is just composed of a school of \"Moonfins.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630230,
					"content": "Those \"Moonfins\"...Who would have thought they would like an ordinary drifting bottle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630231,
					"content": "Hehe, maybe they like the wishes that people pour into the bottles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630232,
					"content": "Haha! Perhaps, well then watch me Kujirai Momiji catch them all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630233,
					"content": "We want to come too! Let us help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630234,
					"content": "In that case, allow me to give you this fishing rod. It was specially made by the Kujirai family in pursuit of the \"Lunar Leviathan\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630235,
					"content": "Although it is far from being able to express my gratitude to you, but it is a small token of my appreciation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630236,
					"content": "Let's use it to catch all the \"Moonfins\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		}
	]
}