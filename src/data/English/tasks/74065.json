						"position": [
							4488.273,
							4.66,
							4617.159
						],
						"pointId": 6252
					},
					{
						"sceneId": 3,
						"position": [
							4488.052,
							4.66,
							4619.021
						],
						"pointId": 6253
					}
				]
			},
			"dialogs": [
				{
					"id": 740650101,
					"content": "#Well, well! If it isn't {NICKNAME} and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650102,
					"content": "Do we know you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "Don't be so cold. I'll never forget what you did for me that other time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650105,
					"content": "That other time... Ah! We still have so much to ask you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650106,
					"content": "I—Is that so? Ugh, oh, what's this? My memory, it's acting up again! What happened then, I wonder? I can't remember a thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650107,
					"content": "The wise say it's better to look toward the future than look back into the past. So let's talk about our future collaboration, and let bygones be bygones, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650108,
					"content": "I have a few jobs on hand that pay quite well, but I don't have anyone to help out. If you're free, would you like to have a go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650109,
					"content": "Hmph! Don't you go thinking we're that easy to dupe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650110,
					"content": "And just how good is the compensation?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650112,
					"content": "This is why I'm so fond of talking business with people like you. What do they call it again? Right, being quick to catch on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650113,
					"content": "How about I state a number that's guaranteed to satisfy you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650114,
					"content": "A hundred Coupons! What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650115,
					"content": "A hundred!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650116,
					"content": "Mmm, I see you are moved by my generosity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650117,
					"content": "That won't even buy us a bottle cork.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "Yeah! Paimon can't believe you had the gall to make that offer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650121,
					"content": "Am I not being generous enough? You young 'uns really are so... You just don't know what's good for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650122,
					"content": "You should know, there're hordes of poor wretches who'd give an arm to do easy and profitable work like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650123,
					"content": "Decembre, you slippery little fraud, I've finally caught you! Last time I caught you hanging around the mail room, you were also swindling newcomers into commissions for you for a fraction of the actual fee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME} and Paimon? You didn't fall for his lies, did you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650125,
					"content": "I'm devastated... We've already been tricked once!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "*sigh* Then I'm too late.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650130,
					"content": "Anyways, don't believe a word he says. He targets newcomers or anyone unaware of the rules and cheats them. There's already a long list of victims.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650131,
					"content": "My word, \"swindle\"!? You make it sound so awful. Is there any difference between us? Don't you guards use Coupons to make people do miscellaneous work for you, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650132,
					"content": "We don't pocket a portion of their compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650133,
					"content": "What are you hinting at? Don't slander me without any proof!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650134,
					"content": "Oh, you want to see some proof? Let's go then. Solitary is quiet and spacious — a perfect place for you to peruse all the proof. Seriously, I still have trouble to deal with at the Geode Mine Shaft after this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650135,
					"content": "#Oh, {NICKNAME} and Paimon. If possible, could you help me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650136,
					"content": "Hey, it's not like we have all the time in the world, either!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650137,
					"content": "I'm sure you pay handsomely — I'll do it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650139,
					"content": "Haha! Payment will be provided in accordance with regulations, of course. I'm sure you know the standards, and you know I won't try to defraud you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650140,
					"content": "Anyway, some Fontemer Aberrants have been spotted in the Geode Mine Shaft... They may pose a threat if left unchecked, so they must be dealt with as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650141,
					"content": "I'll take this guy to solitary first. Handing him over to my colleagues will take some time... I'll meet up with you as soon as I'm done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650142,
					"content": "Alright, but don't take too long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650143,
					"content": "I'll do my best. But the paperwork... It's not something I can speed up. I'll leave the business at the mine shaft to you then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650127,
					"content": "But not this time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "This time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650129,
					"content": "Uh... Things happened before this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650119,
					"content": "I'll pay you 100, you work, and I'll profit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "Whoa! Is that what you were planning!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650103,
					"content": "I have a bad feeling about this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
		{
			"id": 7406503,
			"completionStepIds": [
				7406503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406503",
							"2"
						],
						"stepId": 7406503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maupoil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "You're only just arriving here now? We've already driven away all the Fontemer Aberrants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650302,
					"content": "So, it's finally happened to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650303,
					"content": "What's finally happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650304,
					"content": "Arriving at the scene and finding out that all the work has been done by someone else, of course! I mean, there's nothing for me to do here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650305,
					"content": "This is for you. Thank you so much! I'll certainly manage to get a good night's sleep tonight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		}
	]
}