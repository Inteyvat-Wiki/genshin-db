			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071701,
					"content": "Dead leaves...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071702
					]
				},
				{
					"id": 221071702,
					"content": "Seriously? Even Paimon knows that dead leaves and love have nothing in common!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071703,
					"content": "On the contrary... they are intimately related!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071704
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071704,
					"content": "You may look at these dead leaves and dismiss them as withered and lost... But I see potential. Boundless potential.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071705
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071705,
					"content": "All it takes is one tiny spark to turn them into a roaring fire, and the slightest gust of wind can send them soaring majestically up into the sky!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071706
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071706,
					"content": "An apt analogy for my unrequited love... Stored up in my heart all this time... Always hoping for something, something that will change everything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071707
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071707,
					"content": "*sigh* Alas, such things are for fate to decide. Who knows when the turning point will come, and how it will happen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071708
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071708,
					"content": "I should not lose heart. Everything happens for a reason, I just need to have patience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071709
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071709,
					"content": "Analogies aside, I was the turning point for those leaves.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071710
					]
				},
				{
					"id": 221071710,
					"content": "...Excuse me? What on earth do you mean by that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071711
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071711,
					"content": "Wait, you don't mean... Surely you didn't... Please don't tell me you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071712
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071712,
					"content": "Oh no... That's it, it's all over! If you disrupt the natural timing of the turning point... it ruins everything! Fate and love will be plunged into chaos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071713
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071713,
					"content": "Who do you think you are, playing god with the fate of these leaves!? Maybe you were trying to help, but I assure you, you have done more harm than you can possibly imagine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071714
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071714,
					"content": "What am I going to do... Ugh, get out of here, go and ruin someone else's life! I need some time to cool down...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
