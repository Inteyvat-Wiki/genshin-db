					"nextDialogs": [
						221071502
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071502,
					"content": "That's all for now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071503
					]
				},
				{
					"id": 221071503,
					"content": "Okay... I suppose I should get some more input from Qiming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210716,
			"completionStepIds": [
				2210716
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210716",
							"2"
						],
						"stepId": 2210716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071601,
					"content": "A couple of birds on the roof.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071602
					]
				},
				{
					"id": 221071602,
					"content": "I see... Splendid! This is a good sign!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071603
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071603,
					"content": "Two pigeons who both forsake their own flocks to be together... All they care about is each other as they soar off, wing to wing, into the horizon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071604
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071604,
					"content": "This sign can only mean one thing: I shall soon meet the one who loves me, and me alone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071605
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071605,
					"content": "...And she will fight against the odds, tear down all obstacles to break free from those that would seek to deter her; then, finally, we shall be together and it will be us against the world...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071606
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071606,
					"content": "Ahem! I, uh... Thank you, thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071607
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071607,
					"content": "I wonder what twist of fate led them to meet... to understand one another... and to experience true love together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071608
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071608,
					"content": "*sigh* Oh, what a pity that I am not a dove... I shall never know the sweet taste of another dove's love upon my beak... Oh, what a cruel fate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071609
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071609,
					"content": "Would you settle for the taste of dove itself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071610
					]
				},
				{
					"id": 221071610,
					"content": "The taste of dove? What are you... No, you didn't... Surely you didn't...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071611
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071611,
					"content": "What did you do!? It was a metaphor, you buffoon! A metaphor! You don't seriously think I was talking about physically eating the abstract concept of romantic love!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071612
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071612,
					"content": "I know some people are naturally unromantic, but you just took it to a whole other level! And my goodness, how will this impact my fortune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071613
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071613,
					"content": "I just... Never mind, forget it. I need some time alone to calm down. Why don't you just get back to whatever it was you were doing today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210717,
			"completionStepIds": [
				2210717
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210717",
							"2"
						],
						"stepId": 2210717,
						"stateName": "QUEST_STATE_UNFINISHED"
