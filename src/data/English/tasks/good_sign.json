			"dialogs": [
				{
					"id": 221071301,
					"content": "A cat and a fish made friends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071302
					]
				},
				{
					"id": 221071302,
					"content": "My goodness, what a wondrous sign. You clearly knew what to look for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071303
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071303,
					"content": "Such a triumphant friendship... Both the cat and the fish are truly admirable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071304
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071304,
					"content": "Is this not precisely the meaning of love!? Truly, the power of love transcends all boundaries!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071305
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071305,
					"content": "I, for one, have nothing but the utmost respect for both of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071306
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071306,
					"content": "Clearly, this sign is telling me... Fear no obstacle in the pursuit of love; only then will Qiming see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071307
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071307,
					"content": "...Anyway, thanks! Thanks a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210714,
			"completionStepIds": [
				2210714
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210714",
							"2"
						],
						"stepId": 2210714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
