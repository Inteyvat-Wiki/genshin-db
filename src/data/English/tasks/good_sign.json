						"rawParams": [
							"2210701",
							"2"
						],
						"stepId": 2210701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "\"True love may be impossibly far away, or it may be right under your nose. You cannot force it. But when its day comes, it will reveal itself to you right before your very eyes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070102,
					"content": "What is?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "Why, it's my fortune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070104,
					"content": "This is what Qiming the fortune-teller advised me regarding my love life: it may be impossibly far away, or it may be right under my nose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070105,
					"content": "I daresay she must be hinting at something... But whatever could it be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070106,
					"content": "I have heard storytellers say that you can tell when your fortune is about to come true, because signs appear all around you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070107,
					"content": "And I have a strong sense that true love is on its way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070108,
					"content": "Could you examine the surrounding area for me and check for signs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070109,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "Yay! Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070110,
					"content": "Why me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "You know the saying, \"Lookers-on see most of the game\"? Well, were I to look for signs myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070113,
					"content": "...I fear that I would interpret anything and everything I saw as a sign that true love is on its way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070114,
					"content": "That's why I need your help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
