			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071401,
					"content": "A pack of dogs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071402
					]
				},
				{
					"id": 221071402,
					"content": "Oh no... What portent of doom is this? Is my love life to end before it begins?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071403
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071403,
					"content": "Wait, what? Those doggies looked like the best of friends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071404,
					"content": "I know that group of dogs. They are indeed friendly to one another, and they stick together all year round.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071405
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071405,
					"content": "That might sound like a good thing, but the fact is... None of those dogs has ever found a mate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071406
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071406,
					"content": "Sooner or later they'll grow old, and then it'll be too late...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071407
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071407,
					"content": "Is this sign really trying to tell me to while away the time until I die with my buddies, because I will never find a partner!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071408
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071408,
					"content": "I—I need to have a seat... and a long, hard think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210715,
