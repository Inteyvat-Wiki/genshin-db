			"dialogs": [
				{
					"id": 740510301,
					"content": "Great! The Film Kamera is intact, and the film hasn't been destroyed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510328,
					"content": "Thank the Archons. I thought we were gonna have to start shooting all over again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510302,
					"content": "Why are you filming here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Seems you aren't from Fontaine either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "It's a long story...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510304,
					"content": "Let's keep it brief. We three are from Qiaoying Village in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510305,
					"content": "Most people there are in the tea business but we... don't have any interest in tea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510306,
					"content": "So, we changed professions and started filming dokumentari films to help promote tea vendors in the village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510307,
					"content": "In truth, there are too many people in the tea business, and we just couldn't compete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "The skilled helpers we had at the store left one by one to work elsewhere, so if we just stuck to making tea, we'd be starving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "Can't you two... not make things sound so depressing!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510310,
					"content": "We've made plenty of Mora shooting these tea dokumentaris in the village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510311,
					"content": "But recently, some others in the village have also started to shoot their own promotional films.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "Some of them are even performing an opera in them. They're making a real big show of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "So that's why we're in Fontaine. We're trying to seek advice from master filmmakers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510314,
					"content": "So, you're here to learn about filmmaking in Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Yeah. We found this \"lighting expert\" called Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510316,
					"content": "He's real good at using lighting to film... what was it again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510317,
					"content": "\"Narratives.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "Yeah! Applying lighting to his \"narratives.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510319,
					"content": "With Mr. Geisert's advice, we can definitely shoot the best films in all of Qiaoying Village!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510320,
					"content": "Boss, last month you said we were going to shoot the best films in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "You have to adjust your expectations realistically when doing business... What do you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510322,
					"content": "Anyway, thanks for your help, Traveler. Here, take this Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng, pack that up quick! We gotta finish shooting our sample and show it to Mr. Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510324,
					"content": "Watch the lighting! The Kamera's gotta be angled toward the light source in this way. We gotta capture that... high-definition lighting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510325,
					"content": "You all read that book, right? The lighting's gotta have a sense of texture? You get what I'm saying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 740510326,
					"content": "Boss, we might've read Mr. Geisert's book...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "But with what we got, we're not going to be able to capture that high-definition lighting tactility you want no matter how much we struggle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
