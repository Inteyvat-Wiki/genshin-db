			"dialogs": [
				{
					"id": 737100101,
					"content": "♪~ ♪♪~ ♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "Bongo-Head"
				},
				{
					"id": 737100102,
					"content": "♫♫~ ♫~ ♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "Kindlejoy"
				},
				{
					"id": 737100103,
					"content": "Haniyyah, Souka, we're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100104,
					"content": "I could already hear Bongo-Head and Kindlejoy's cheerful steps from a distance. Looks like you really had a blast this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100105,
					"content": "You can tell they're having fun from that far away? I still can't read the emotions in our Fungi friends' footsteps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100106,
					"content": "Guess I've got a lot to learn... There's always more to learn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100107,
					"content": "Hehe, this trip really did feel different!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100108,
					"content": "Running around with our Fungi friends, then coming back to the Lil' Fungi Playground, it feels like coming home to a nice meal after a long day of playing outside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100109,
					"content": "How about we take a photo together right now? Paimon remembers reading in The Steambird that many famous travel journals line up all the little snapshots from a trip in chronological order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100110,
					"content": "Now that Silver Companion mentions it, I've gotten so used to having these Fungi friends around all these years... We've never really taken a proper photo together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100111,
					"content": "Mmhmm! You two big shots really know how to wrap up an adventure nicely!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100112,
					"content": "♪♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "Bongo-Head"
				},
				{
					"id": 737100113,
					"content": "♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "Kindlejoy"
				},
				{
					"id": 737100114,
					"content": "Alright, let's use Bongo-Head's Kamera, set it on the tripod, and take a timed group photo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100115,
					"content": "Once Haniyyah and Souka are less busy, we can all go out and have fun together like this again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100147,
					"content": "Yippee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100116,
					"content": "Speaking of which, Bongo-Head is really talented at taking photos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100117,
					"content": "Paimon picked a few good shots and put them together with our group photo. Haniyyah and Souka can check them out too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100118,
					"content": "Wow... you really thought of everything...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "Oh, and... Paimon brought some souvenirs for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100121,
					"content": "Here! The macarons you didn't get to try before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100122,
					"content": "Aww, I only said it in passing, and you actually remembered it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100123,
					"content": "Silver Companion... I'm so touched...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100124,
					"content": "To avoid troubling you like this in the future, I really need to fix my bad habits. I'll plan trips properly in advance... and not just on paper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100125,
					"content": "You know, when friends are hanging out and chatting freely, even offhand comments can show what's truly on your mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100126,
					"content": "When did you get it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "Oh, back when we were taking photos in Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100129,
					"content": "While you were watching the scenery with Bongo-Head, Paimon got a newsy to help out and gave her a little tip for the trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100130,
					"content": "Don't worry, Paimon prepared your share too! Paimon wouldn't forget, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100131,
					"content": "Paimon even reminded the newsy to go straight for your favorite flavor as soon as she got inside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100132,
					"content": "But we've already tried almost every dessert in Fontaine, so Paimon's not sure how much of a surprise this will actually be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100133,
					"content": "Anything Paimon picks out is bound to be delicious.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "Really? Hehe... then Paimon will buy you treats more often!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100136,
					"content": "Too bad there aren't any sweets made especially for our Fungi friends... How amazing would it be if we could cuddle up with them and enjoy a table full of delicious food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100137,
					"content": "No need to worry about that. In the process of refining On Fungi Communities, I've been conducting foundational research on the food that Fungi enjoy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100138,
					"content": "My goal is to identify ingredients that both Fungi and humans can eat, so our buddies don't have to live off every flavor of Marvelous Jelly all year long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100139,
					"content": "One day, I'll find the ingredients that satisfy both human and Fungi tastes, and design delicious dishes we can all enjoy together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100140,
					"content": "And when it comes to putting theory into practice, I'll be our master chef! Just in case Haniyyah ends up ruining our eleventh pot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100141,
					"content": "Sounds like the day we sit in a circle and share a meal with our Fungi friends isn't far off, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100142,
					"content": "We'll be waiting for your good news, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "In that case, please do come back and visit the Lil' Fungi Playground when you get the chance. We, and all our Fungi friends, will always be here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100145,
					"content": "Who knows? The surprise might arrive even sooner than you expect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100146,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bongo-Head"
				},
				{
					"id": 737100143,
					"content": "We can't wait for Souka's feast!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "It's a treat you bought for me on your own. That makes it special!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "I didn't even notice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "You're so thoughtful, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
}