			},
			"dialogs": [
				{
					"id": 760920201,
					"content": "\"The night sky has been devoured by deathly silence. We knead blood and bone for fuel, and so proclaim: The Long Night flows dark and deep. With these lanterns we wield, no specter shall stir from their sleep. By the lunar spirits, this pact is sealed.\"",
					"roleType": "TALK_ROLE_NPC",
