				"objectNames": [
					"Rolf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "You'd better keep running, friend! This place is very dangerous. If the Wild Hunt shows up, I can't guarantee I'll be able to protect you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920102,
					"content": "How do you know that the Wild Hunt will appear?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "As a Lightkeeper, dealing with the Hunt is my sworn duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920104,
					"content": "See that Tideseal Stone? To ensure that the Hunt is completely and utterly eradicated, I have to stand guard here for three days and nights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920105,
					"content": "Tideseal Stone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "These stones are seals placed by us Lightkeepers to dispel the permeation of the Wild Hunt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920107,
					"content": "Although I'm not sure how it works, such suffusion will, if left unchecked, tend to draw the Hunt back to the same location.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920108,
					"content": "That's why we usually place down these stones in areas where the Wild Hunt has been pushed back. If the Hunt returns, the stones can also protect us in battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920109,
					"content": "I ain't scared of no Wild Hunt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "I'm not sure where you get your confidence, but the Hunt is not an enemy to be taken lightly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920111,
					"content": "Let me give you a word of advice. When you come across places with these Tideseal Stones, you'd best tread carefully.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920112,
					"content": "I shan't disturb you any longer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "See you. Take care on the road.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				}
			]
		},
