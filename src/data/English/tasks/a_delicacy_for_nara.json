				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "...So difficult to talk to Nara, and they are so tall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130202,
					"content": "Hello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#Eek! It's Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130204,
					"content": "Arapacati not scared. Brothers are very brave, so they definitely not scared too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130205,
					"content": "You should find them if you move towards <color=#00E1FFFF>the pillars of smoke</color>. If they are acting strange, go splat them with <color=#00E1FFFF>the power of Dendro</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "Arapacati is sooo mad! Argh! More mad than mad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130302,
					"content": "Forest is very dangerous as Marana is rampant there. When they left, Arapacati reminded brothers to work together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130303,
					"content": "But you started arguing right after leaving. Arachatora, you even ate strange thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130304,
					"content": "*sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130305,
					"content": "Arapacati has decided. Arachatora not allowed to pick mushrooms until Sunsettias have ripened ten times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130306,
					"content": "Noooo... *sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130307,
					"content": "Exactly! What would we do if he brought back bad spores and mushroom monsters grew here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130308,
					"content": "Araphala, you too! You went so far away from Vanarana to collect fruits. There are many bad things over there! Araja told us about it especially!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130309,
					"content": "*sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130310,
					"content": "That's right. Fruits need to drink water and Aranara need to drink water, so water is the best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130311,
					"content": "Arapas, of all places, you had to go to the Varuna Contraption. Don't you know that even Nara Varuna said the water of Vanarana is the most delicious?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130312,
					"content": "*sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130313,
					"content": "Y—You see, only the \"taste of happiness\" can bring happiness to our little sister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130314,
					"content": "#Arasaka, I heard you caused a lot of trouble for Nara {NICKNAME} because of your \"taste of happiness\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130315,
					"content": "E—Everything I did was for the \"Supreme Delicacy\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130316,
					"content": "The purpose of making the \"Supreme Delicacy\" is to show the fruits of the \"cooking training\". Alas, what's the point of the training if you could only complete it with someone else's help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130317,
					"content": "Arapacati thinks Arasaka needs to reflect on himself the most.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130318,
					"content": "*sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130319,
					"content": "Arapacati! We're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130320,
					"content": "Oh, it's you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130321,
					"content": "#Nara {NICKNAME} shared Arapacati's trouble with Paimon and solved the problem at its source...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130322,
					"content": "Arapacati no longer needs to worry about brothers missing Festival Utsava or being in danger outside. It's all thanks to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130323,
					"content": "Arapacati and brothers are all thankful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130324,
					"content": "That's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130325,
					"content": "But there's something Paimon has always been curious about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130326,
					"content": "Who is this Nara Varuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "#{F#He}{M#She} is our friend, a friend of Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130328,
					"content": "#A friend of Aranara from a long, long time ago. A Golden Nara just like Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130329,
					"content": "Huh. But Paimon's still got another question for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130330,
					"content": "Is it about her brothers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "Yes. Arapacati, which one of them is your biggest brother, and which one's the smallest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130332,
					"content": "Hmm? The biggest and the smallest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130333,
					"content": "Their ages...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "Ages... Ah, Arapacati understands. Just like tree rings. Hmm, the children of the forest aren't distinguished by age.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130337,
					"content": "Huh? Then why are they your brothers and why are you their younger sister?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130338,
					"content": "#Oh, this. We once had a Nara friend. Nara Varuna. {F#He}{M#She} said {F#he}{M#she} had a \"{F#sister}{M#brother}.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130339,
					"content": "#When Arapacati and brothers listened to {F#him}{M#her} talk about the \"{F#sister}{M#brother},\" Nara Varuna looked happy and sad at the same time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130340,
					"content": "That's how we understood. To an \"older brother,\" a \"younger sister\" is an important Nara. To a \"younger sister,\" an \"older brother\" is an important Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130341,
					"content": "We thought it was great, so Arapacati and brothers decided to become brothers and sister. Nara Varuna said this was great. We should cherish our family.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130342,
					"content": "That's right, we must cherish our family.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130344,
					"content": "There's one more thing Paimon's been wondering... Do Aranara need to eat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130345,
					"content": "Humans cook ingredients into food, and the children of the forest can also make ingredients into food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130346,
					"content": "Nara Varuna taught us how Nara eat. That's why Arapacati and brothers started doing cooking training...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130347,
					"content": "Okay, but that's certainly unusual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130348,
					"content": "It's like you're playing a game...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "Arapacati and brothers are very serious because Nara Varuna said that to be able to share food is a very happy thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130351,
					"content": "#Oh and Arapas said that Nara {NICKNAME} knows how to cook too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130352,
					"content": "#Yeah! {NICKNAME}'s cooking skills have been tested by time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130353,
					"content": "#Arapacati gets it... Nara {NICKNAME} must come to Festival Utsava and cook with Arapacati's bush-league brothers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130354,
					"content": "Impress them once again with real cooking skills and food that only Nara can understand and Aranara will never understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130355,
					"content": "Try not to be surprised by then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "Arapacati is looking forward to it. This Festival Utsava will be really great and amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130356,
					"content": "I'll show you what I've got!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130349,
					"content": "It's like you're playing house...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130334,
					"content": "Their sizes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130335
					]
				},
				{
					"id": 730130335,
					"content": "No! Paimon is asking about their ages!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130336
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"3"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130401,
					"content": "#Thank you for everything, Nara {NICKNAME}. When the time comes for Festival Utsava, you must come as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				}
			]
		},
		{
			"id": 7301305,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"3"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130501,
					"content": "I can't pick any mushrooms until the Sunsettias have ripened ten times. *sob* I know it's not a long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130502
					],
					"speakerTitle": "Arachatora"
				},
				{
