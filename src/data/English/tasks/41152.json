					"nextDialogs": [
						411520303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411520303,
					"content": "This hash brown is particularly fragile. If you shake it too much, it might fall apart. <color=#00E1FFFF>Please deliver it in time</color> so that it can maintain its crumbly mouthfeel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411520304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411520304,
					"content": "If something happens to you out there, please bring that serving back, and I'll prepare a new one for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
