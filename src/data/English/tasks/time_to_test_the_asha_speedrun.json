			"dialogs": [
				{
					"id": 150480301,
					"content": "You did it! See, it wasn't that tricky after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480303
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480303,
					"content": "Well done, buddy! You were quite the athlete out there! I was blown away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480304
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480304,
					"content": "It's Bennett's turn next, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480305,
					"content": "Yep! I've done my warm-up, finished my stretches, and I'm ready for action. Trust me, I've got this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480306,
					"content": "Be careful out there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480307
					]
				},
				{
					"id": 150480307,
					"content": "#Thanks for looking out for me, {NICKNAME}! But, don't worry, I will be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
