						150480402
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480402,
					"content": "You're saying... You'd be willing to lead the way and coach me through it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480403
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480403,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480404
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480404,
					"content": "You're the best! Now, I feel even more confident than before. After you, Coach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480405
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480405,
					"content": "Go, Asha! Go, Bennett!",
					"roleType": "TALK_ROLE_NPC",
