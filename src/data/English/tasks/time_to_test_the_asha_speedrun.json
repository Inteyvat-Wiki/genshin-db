			},
			"dialogs": [
				{
					"id": 150480801,
					"content": "Whew, my heart's racing so fast... Gotta take a while to catch my breath...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480802
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480802,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480803
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480803,
					"content": "Let's give it up for Bennett and his Asha buddy! You guys make such a great team!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480804,
					"content": "Especially the way you worked together at the end. Your special bond made all the difference!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480805,
					"content": "You turned the tide of misfortune together.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480806
					]
				},
				{
					"id": 150480806,
					"content": "We sure did!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480807
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480807,
					"content": "#I owe a big thanks to you in particular, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480808,
					"content": "If you hadn't believed in me and helped convince the staff, I never would have had the chance to even compete in the challenge, let alone face it alongside our Asha friend...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480809
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480809,
					"content": "Mr. Bennett, the final safety test has been completed, which means that Asha Speedrun is now officially ready to open. Your help was much appreciated!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480810
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480810,
					"content": "Did you hear that, Asha? We did it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480811
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480811,
					"content": "I'll remember your name, Mr. Bennett — the brave and kind-hearted adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480812,
					"content": "I know this adventure isn't over yet, but just the idea of saying goodbye is getting harder and harder to bear...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
