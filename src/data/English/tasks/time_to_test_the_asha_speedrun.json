			"dialogs": [
				{
					"id": 150480601,
					"content": "Okay, just a little further. Stay calm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480602,
					"content": "Wait, what!? Where did the finish line go...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480603
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480603,
					"content": "Oh no, did I just jinx myself? Or use up all my luck? ...No, c'mon, I can't lose hope now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480604
					],
					"speakerTitle": "Bennett"
				},
				{
