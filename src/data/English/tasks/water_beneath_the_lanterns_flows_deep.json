			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020501,
					"content": "Ooh... These are some fine pieces of Azurite and Vermillionite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020502,
					"content": "My thanks to you both. Here's your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020503,
					"content": "None of your efforts are wasted. Every piece adds that bit more luster and color to Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020504,
					"content": "Since you're staying in Liyue during the festival, make sure to keep an eye on the Mingxiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020505,
					"content": "As the work progresses, the construction site at the harbor will become more and more magnificent to behold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020506,
					"content": "#Sounds fascinating. {NICKNAME}, how about we take a look now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000214,
			"completionStepIds": [
				4000214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
