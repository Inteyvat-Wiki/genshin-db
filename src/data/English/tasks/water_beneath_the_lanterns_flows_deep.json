			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "Oh, hello you two. Many thanks for your donation to Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020202,
					"content": "Today, I have another matter to discuss with you. Not a donation this time; more of a sales and purchase situation. Interested?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020203,
					"content": "Sure beats working for free, like last time! Paimon's interested.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020204,
					"content": "Haha, wonderful! I appreciate the help. Now, let me explain the situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020205,
					"content": "I need two kinds of Plaustrite for official festival use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020206,
					"content": "One is called Azurite. It is occasionally found in the northern part of Mt. Tianheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020207,
					"content": "When Azurite gets caught in the roots of ordinary vegetation, it sometimes produces Bloatty Floatties, which have floating seeds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020208,
					"content": "The other one is called Vermillionite, which is extremely dangerous as far as most people are concerned...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020209,
					"content": "In Guili Plains, old Ruin Hunters who have lost the power of flight use Vermillionite to keep themselves airborne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020210,
					"content": "Got it! So, Azurite and Vermillionite, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020211,
					"content": "(Actually, they're just blue and red varieties of Plaustrite... Gemstone merchants only gave them fancy names to try and impress their customers...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020212,
					"content": "That's right. Please get some of each for me. Good luck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixin"
				}
			]
		},
		{
			"id": 4000205,
			"completionStepIds": [
				4000205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
