			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021001,
					"content": "On the final day of the Lantern Rite festival, huge crowds come out to watch the Mingxiao Lantern being released.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021002,
					"content": "It can't be a good sign if there's a suspicious character lurking around somewhere so dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021003,
					"content": "If he's been tampering with the stockpile of lantern supplies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021401,
					"content": "This is a matter for the authorities! Quick, let's go to the Liyue Ministry of Civil Affairs and report it at once!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021406,
					"content": "Paimon, you're taking this very seriously. Why?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "Because... Because... Everyone in Liyue has worked really hard for this! No-one should be allowed to spoil it, period!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021408,
					"content": "...What's the real reason?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "Because... Near the harbor is that Zhongyuan Chop Suey place! Take one bite, hooked for life! The original and best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021410,
					"content": "Clearly their marketing campaigns have been effective.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "Ehehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000215,
			"completionStepIds": [
				4000215
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
