							"4000215",
							"2"
						],
						"stepId": 4000215,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021501,
					"content": "Hold up! This is the Liyue Ministry of Civil Affairs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021502,
					"content": "We are here to report some suspicious activity.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "Yeah, we saw a shady-looking guy snooping around near the stockpile of highly flammable Mingxiao Lantern supplies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021504,
					"content": "We absolutely cannot let this be the end of Zhongyuan Chop Suey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021505,
					"content": "Hmm, goodness! This is a serious matter indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021506,
					"content": "Exactly what Paimon thought! Liyue Harbor's cuisine is the heart and soul of the city—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400021507,
					"content": "...It seems we disagree on where the seriousness of the matter lies. But you're not wrong, my little friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021508,
					"content": "I have noted your concerns and will pass them on diligently to my superiors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021509,
					"content": "Thank you. You were right to report this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021510
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400021510,
					"content": "Make sure it's given top priority! It needs to be dealt with properly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}