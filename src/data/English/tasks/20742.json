				},
				{
					"id": 207420602,
					"content": "Once I'm done sowing the dandelion seeds into the new pot, I'll have to decide on a good place to put it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420603
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420603,
					"content": "...Well, maybe I'll just display it outside again.",
					"roleType": "TALK_ROLE_NPC",
