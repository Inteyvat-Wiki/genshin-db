					]
				},
				{
					"id": 207420502,
					"content": "Did you get my Dandelion Seeds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420503,
					"content": "These are for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420504
					]
				},
				{
					"id": 207420504,
					"content": "...Thanks. I'll plant a new pot later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420505,
					"content": "But I'm never, ever leaving it outside again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
