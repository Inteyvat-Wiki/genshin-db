					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420702,
					"content": "So, uh, did something happen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420703
					]
				},
				{
					"id": 207420703,
					"content": "You! Donna told me all about it — she saw you blowing my dandelions away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420704
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420704,
					"content": "Uh, sorry about that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420705
					]
				},
				{
					"id": 207420705,
					"content": "I know — Donna told me all about it. You were the one who blew all my dandelions away, weren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420706
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420706,
					"content": "If you needed Dandelion Seeds that much, you could just have gathered some out in the wild. I was caring for these ones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420707
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420707,
					"content": "Need I mention that these dandelions were the ones you helped me gather? Is this is really how you're going to treat them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
