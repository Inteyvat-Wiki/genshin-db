				{
					"id": 207420202,
					"content": "Growing flowers isn't that easy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420203
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420203,
					"content": "...How about this, then? Find me some more Dandelion Seeds, and I'll plant them again myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
