			"dialogs": [
				{
					"id": 731941201,
					"content": "\"Be careful if you're planning a trip to the rainforest. My mentor sent me there to collect some herbs the other day, and I almost lost my life to a Rishboland Tiger.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731941202,
					"content": "\"I was lucky to be saved by a Forest Ranger nearby. She called herself a Trainee Forest Ranger, but she seemed really experienced. Most importantly, she gave me delicious food to help ease my shock.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731941203,
					"content": "\"I've heard that she's Tighnari's student. It's just as they say — like teacher, like pupil!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
