					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "Please do not carry too much Mora in crowded areas as a precaution against theft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940802,
					"content": "If you find your properties stolen, please do not seek help from the Eremites patrolling in the vicinity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940803,
					"content": "Because it's very likely that they are the culprit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319409,
