			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941001,
					"content": "Bounty Notice: Mustah",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731941002,
					"content": "This man disguises himself as a Mahamata to engage in extortion and robbery around the port of the Bazaar. The Citadel of Regzar is now conducting investigations on him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731941003,
					"content": "There are reports of him hiding in the jungle. Please report any sightings of him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319411,
			"completionStepIds": [
				7319411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319411",
							"2"
						],
						"stepId": 7319411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Since the Mahamata won't be using this to post announcements anymore, it's perfect as a message board for our tavern. Please feel free to leave a message here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731941102,
					"content": "\"Have the ten crates of wine that I ordered arrived? I came yesterday only to find out they didn't arrive.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731941103,
					"content": "\"That's impossible! A blond person came in here earlier claiming to be your roommate and took it all. I even remember both of you coming in together the other day. You must have made a mistake.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731941104,
