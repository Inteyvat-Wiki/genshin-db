				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "This Bulletin Board is set up by the Mahamata to publicize important matters in Sumeru City. Questions or doubts regarding the notices on the Bulletin Board can be posted here as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "\"Have you heard? The Forest Watchers found a magnificent palace that came into being from nowhere in the north of the forest.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940202,
					"content": "\"But everyone who went there got cheated out of all the money they had. All they had left is their underwear when the Forest Watchers found them.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940203,
					"content": "\"And they were crying and refused to say what happened. It's absolutely horrifying.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940204,
					"content": "\"It's best not to wander around in the forest.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "The announcements throughout Sumeru are being displayed via the Akasha now. Please wear your Akasha Terminal at all times to avoid missing any important notices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940302,
					"content": "This Bulletin Board will be temporarily kept for the convenience of foreign merchants, the elderly, and children. It may be removed anytime in the future. Please refrain from relying on it too much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "Distribution of this year's Anahitian Blessing has begun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940402,
					"content": "In principle, distribution will be carried out according to last year's policies and requirements. Details of relevant information have been posted in the Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940403,
					"content": "If there are any changes, please contact your nearest Mahamata in advance to submit a modification request to the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "Cases of Eleazar have been on the rise in the city. If you experience symptoms including numbness of the skin, weakness in the limbs, or gray and black scales forming on the torso, please go to Bimarstan to receive treatment immediately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940502,
					"content": "Missing the best window for treatment and allowing the condition to take a turn for the worse will lead to severe consequences, such as incapacitation. Please take heed of this notice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319406",
							"2"
						],
						"stepId": 7319406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Special reminder: The Eremites are the only authorized mercenary organization in Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940602,
					"content": "Please do not trust strangers easily in case of getting cheated by scammers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940603,
					"content": "If you wish to hire bodyguards, security staff, or have any other requests, please contact Parchamdar Rukh Shah from the Corps of Thirty or post a commission via the Akademiya's liaison, Effendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319407",
							"2"
						],
						"stepId": 7319407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Bimarstan is a medical facility under Amurta that provides free medical care to all residents of Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940702,
					"content": "Bimarstan's doctors are licensed by Amu{RUBY#[S]Biology}rta. Our diagnoses and treatment plans are reviewed multiple times by the Akasha. We provide the safest, most professional medical services for all Sumeru residents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940703,
					"content": "Please do not trust unidentified or unlicensed doctors to avoid financial losses and irreversible harm to your health.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319408",
							"2"
						],
