			},
			"dialogs": [
				{
					"id": 731940901,
					"content": "Bounty Notice: Kasim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940902,
					"content": "This man claims to be a renowned bandit who travels across nations, but he is in fact a fraud who has never appeared in the power rankings of the Eremites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731940903,
					"content": "Many fraud cases linked to him have been reported lately. Please stay vigilant and avoid falling for his scams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319410,
			"completionStepIds": [
				7319410
			],
