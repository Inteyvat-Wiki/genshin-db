				"points": []
			},
			"dialogs": [
				{
					"id": 735140101,
					"content": "That was close... Even the Wenut have come to mess up our plan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140102
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140102,
					"content": "Hey! If we hadn't deactivated the ignition, we could have killed it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140103,
					"content": "Now that the Wenut has escaped, it'll be at least one more day before it lets its guard down again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140104
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140104,
					"content": "You're not planning to argue over the tiniest detail and let it go again tomorrow, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140105,
					"content": "Um, but what about the parameters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140106
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140106,
					"content": "I have tested them all, and although the charging speed is a little lower than the calculated value, it does not affect use, and there are no safety risks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140107,
					"content": "Shriya, I know you want to consider and analyze everything before acting, but you know, things don't always go according to plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140108,
					"content": "If you keep getting hung up over the small details, you'll miss the best opportunity to act! Remember that time our mid-term thesis defense got delayed? Hesitating won't get us anywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140109
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140109,
					"content": "*sigh* Okay. Here's your ignition module.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140110
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140110,
					"content": "Alright! Tomorrow, we'll finally be able to put the Wenutslayer Cannon into action!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140111
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140111,
					"content": "I'd like to bring them back to Aaru Village and tinker around with them a little more. We gotta make sure we're properly ready for the Wenutslayer Cannon's first ever official appearance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140112,
					"content": "...But why is there a deviation in the environmental parameters? What caused the Wenut to suddenly act out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140113
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140113,
					"content": "#You really can't just let these matters rest... {M#Mr.}{F#Ms.} Adventurer, could you please come back tomorrow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140114,
					"content": "By then, we should be facing the Wenut directly, and hopefully we'll have some sort of clue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				}
			]
		}
	]
}