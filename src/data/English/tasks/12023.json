			"dialogs": [
				{
					"id": 120230601,
					"content": "Hey there, care for some fresh fruit and vegetables? Nature's remedy when you overdo the barbecue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230602
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230602,
					"content": "What's new? Anything to report?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230603
					]
				},
				{
					"id": 120230603,
					"content": "Are you referring to the thing about the Tenryou Commission and the Fatui? I've heard rumors, but nothing too detailed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230604
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230604,
					"content": "It's funny you should say that the soldiers seem excitable, though. I've had the same feeling. See that guy over there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230605
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230605,
					"content": "He's been acting strange these days — always shouting and waving his spear around when he's got nothing to do. He's scared the heck out of me a few times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230606
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230606,
					"content": "Ugh... It's a miracle the fighting has finally come to an end. I really hope we don't go making any more trouble for ourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230607
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230607,
					"content": "Sorry, I'm afraid I don't have much information. If you still have questions, you may as well go and talk to him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230608
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230608,
					"content": "#Sounds promising. Let's go see what that guy's deal is, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
