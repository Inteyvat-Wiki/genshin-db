				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Denjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "It looks like everything's in place for the feast. But I still need to give a quick speech before the festivities begin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230102,
					"content": "Oh... How much energy will that take? D'you think you've got enough?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230103,
					"content": "Don't worry, I've got plenty. Thanks to you two, I recovered more quickly than usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230104,
					"content": "That's great! We'll be rooting for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230105,
					"content": "Welcome everyone. Today is the day that we celebrate our victory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230106,
					"content": "Recently, our war with the Shogun's Army came to an end, and we finally saw the abolition of the Vision Hunt Decree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230107,
					"content": "None of us can know what the Inazuma of the future will look like. But tomorrow, I meet with the Tenryou Commission for peace talks. I give you my word that I will strive for peace for Watatsumi Island, once and for all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230108,
					"content": "Thank you all for your valiant efforts throughout. Truly, it is only through those efforts that we have been able to prevail in this trying war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230109,
					"content": "This feast is held in honor of each and every one of you gathered here today. I hope all of you get to relax and enjoy our hard-won victory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230110,
					"content": "Woohoo!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120230111,
					"content": "Tonight seems to have gone off without a hitch. I'm so glad it's all going smoothly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230112,
					"content": "#People tend to be more open when they're in a good mood. Could I ask you to go around and see what information you can gather, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230113,
					"content": "I still have no further leads regarding the issue of potential collusion between the Tenryou Commission and the Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230114,
					"content": "And I'm concerned that something might happen at tomorrow's peace talks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230115,
					"content": "Okay, sure. We'll go ask around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202302,
