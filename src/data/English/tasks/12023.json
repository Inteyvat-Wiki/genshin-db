					"Hirai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "Watatsumi Island is finally at peace, and it's all thanks to Her Excellency, Sangonomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230502,
					"content": "What's new? Anything to report?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "Recently? Um, lemme think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Well, the biggest thing for us is that we can finally get back out on the ocean to fish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "During the hostilities, the open sea was full of warships. We just had to make do with what little fish and shrimp we could get our hands on closer to shore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "When the catch wasn't good, we'd all go hungry. The poor kids were crying all day and night, but there was just nothing I could do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "We'd go to bed ravenous and be tossing and turning all night long, trying to keep it together until the morning. At least things are finally improving now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "I hear you're Captain of Swordfish II, is that right? Well, thank you for your service. Here, have a fish! It's freshly caught, so it's a bit, uh, fishy, but it's fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "Oh... no, no, no, w—we couldn't possibly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "Ah, come on, take it! Without you, we'd probably still be going to bed hungry tonight. Her Excellency always teaches us to repay kindness with gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#Okay, well, thanks. Come on, {NICKNAME} let's go talk to some others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
