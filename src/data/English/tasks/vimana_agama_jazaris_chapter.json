					"Jazari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730261301,
					"content": "And what did I say about following the instructions...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261302
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261302,
					"content": "We didn't really get it to do anything...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261303
					]
				},
				{
					"id": 730261303,
					"content": "Its arm just, y'know, fell off! Paimon's pretty sure the machine itself is to blame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261304,
					"content": "Fine, I'll record it as an experimental accident, then. Ugh... I do hope that this won't diminish my report in any way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261305
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261305,
					"content": "Anyway, it seems like we won't be able to start the Ruin Golem again, so there's no point in me keeping you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261306
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261306,
					"content": "I know you're here to investigate the contamination of the underground ruins, but I'm afraid that the Ruin Golem won't be of much use to you now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261307
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261307,
					"content": "Even so, you may see some unexpected progress as a result of what you did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261308
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261308,
					"content": "Well, I shall not keep you any longer. I have my research to get done here, in any case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261309
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261309,
					"content": "You can come and look for me once your work is done... if I haven't been disciplined for destroying the Ruin Golem yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261310
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261310,
					"content": "Once that happens, I can help you apply for the research project on the Chaos Cores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261311
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261311,
					"content": "I'll be the one in charge of the project, of course. But don't worry, I'll give you half the funds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261312
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261312,
					"content": "Anyone can embark on an academic career as long as they have the desire to learn, so go for it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				}
			]
		}
