			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730261101,
					"content": "Ugh... Besides this dark stone slate, nothing else here seems to be of value.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261102,
					"content": "Stone slate? Don't underestimate it. If we can get the control system running, then we can see the outside world through it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261103
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261103,
					"content": "The control system here looks like it can still work. Ancient Khaenri'ah's creations really are amazing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261104
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261104,
					"content": "I never thought I would have this chance in this lifetime. But now it seems that once I complete this research report, winning the Pir Kavikavus Prize is only a matter of time now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261105
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261105,
					"content": "Then let's try and start this machine. Paimon can't wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261106,
						730261107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261106,
					"content": "A capital notion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261108
					]
				},
				{
					"id": 730261108,
					"content": "Now, now, we shouldn't rush anything. We need to follow the instructions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261107,
					"content": "Yes, time's a-wastin'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261108
					]
				}
			]
		},
