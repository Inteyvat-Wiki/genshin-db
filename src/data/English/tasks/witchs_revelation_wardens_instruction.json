					}
				]
			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "Hello there, Lady Trismegistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950102,
					"content": "Oh? Such perfect pronunciation... I can only assume we share a friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950103,
					"content": "A certain Miss Columbina recommended your services.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950104,
					"content": "A very unpredictable lady, that Miss Columbina. I'm sure your encounter must have been full of surprises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950105,
					"content": "It sure was. \"Unpredictable\" is the perfect word.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950106,
					"content": "Pleased to make your acquaintance. The name's Wriothesley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950107,
					"content": "Le duc sous l'eau, in the flesh. It's a pleasure to meet you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950108,
					"content": "I wouldn't have thought such a great mage as yourself would have heard of me. I'm honored.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950109,
					"content": "Or perhaps you saw my arrival in the stars, Lady Trismegistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950110,
					"content": "Hehe... Since we're already acquainted, let's dispense with the formalities. You can call me Barbeloth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950111,
					"content": "Then please, call me Wriothesley. This isn't official business, so there's no need for titles. I'm just a regular citizen of Fontaine enjoying some time off the clock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950112,
					"content": "I came across some freshly baked Conch Madeleines on my way here. I hear mages enjoy a good tea party. Please, take one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950113,
					"content": "Oh my, this is a very popular dessert at our parties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950114,
					"content": "I've been here for quite some time now, and read the fortunes of a fair few people, but this is the first time anyone's come bearing gifts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950115,
					"content": "Thank you, Mr. Wriothesley. I'll make sure to share it with Alice and the others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950116,
					"content": "...Is that my ears I feel tingling? Barbie! You simply have to save some for me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950117,
					"content": "Don't let Nicole scarf the lot down before I get there — it's not like she hasn't done it before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950118,
					"content": "Ahem! Yes, yes, I'll make sure she leaves some for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950119,
					"content": "Honestly, you could have timed this better. Here I am, hoping to maintain the Hexenzirkel's dignity in front of our new friend...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950120,
					"content": "It's quite all right. Where's the harm? Powerful people don't have to be serious all the time. Everyone's entitled to a little personality.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950121,
					"content": "Exactly! As a matter of fact, optimism and cheerfulness are core entry requirements of the Hexenzirkel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950122,
					"content": "This is the first I've heard of it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950123,
					"content": "It's a new rule I just came up with! The Hexenzirkel is supposed to bring joy to the world. It's only natural that we're cheerful and optimistic!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950124,
					"content": "Speaking only for myself, I support everyone enjoying life however they please — provided no laws are broken, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950125,
					"content": "That's a provision you might struggle to get Alice to stick to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950126,
					"content": "Oh my, well this is a concern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950127,
					"content": "Hah, you two do realize I'm still here, right!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950128,
					"content": "Besides, I'm not going to do anything criminal in front of the Administrator of the Fortress of Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950129,
					"content": "...And even if I was, I imagine your rooms are more spacious than the Knights of Favonius's solitary confinement room. Isn't that right, Mr. Wriothesley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950130,
					"content": "Haha! As though a mere solitary confinement room could hold a legendary mage such as yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950131,
					"content": "I'm sure Lady Alice has willingly accepted her punishment, no doubt due to her humility and unimpeachable trustworthiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950132,
					"content": "Exactly — you couldn't be more right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950133,
					"content": "Please stop, Mr. Wriothesley. You really shouldn't encourage her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950134,
					"content": "Once she's in a good mood, there's no telling what Alice might do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950135,
					"content": "I know exactly what you mean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#That's right! {NICKNAME}'s the Honorary Knight of the Knights of Favonius, y'know! No talking bad about the solitary confinement room behind its back, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950138,
					"content": "Does that mean it's up to the Honorary Knight to chase down escaped mages? That would make for a wonderful show. Please be sure to invite me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950139,
					"content": "You just love watching the drama unfold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950140,
					"content": "Still, Paimon didn't expect you to come here by yourself, Wriothesley. That saves us a trip underwater to fetch you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950141,
					"content": "This must be the power of divination.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "Ah, speaking of which, it's about time we got down to business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950143,
					"content": "Mr. Wriothesley, whether out of respect for Miss Columbina or as thanks for your confectionery, please draw a Lunar Arcanum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950144,
					"content": "Perhaps a gift from fate lies hidden within.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950145,
					"content": "Does that count as a prophecy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950146,
					"content": "You could say that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950147,
					"content": "Then no Fontainian would fail to take it seriously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950148,
					"content": "Having said how seriously he would take it, Wriothesley goes straight for the topmost card...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "I'm not too familiar with these cards. This one appears to be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950150,
					"content": "The upright Emperor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950151,
					"content": "You seem lost for words... Is this card bad? There's no need to worry, I can handle whatever you tell me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950152,
					"content": "...Quite the opposite. This card signifies eternal dominion and unshakable authority.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950153,
					"content": "If this represents your future, then you have already reached your destination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950154,
					"content": "But... Hehe, your fate keeps rolling forward, forever changing, which can only mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950155,
					"content": "Perhaps it's not the person who changes, but their environment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950156,
					"content": "Mmhmm... At least for now, such a tendency does seem to exist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950157,
					"content": "Then I guess I can be a bit more confident in my intuition from now on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950158,
					"content": "I previously visited Nod-Krai on official business and gained quite a bit of insight. Since then, I can't help but keep an eye on the local news.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950159,
					"content": "Then, one night, as I was gazing at an unusually bright moon, I found myself thinking that the world is changing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950160,
					"content": "The world is constantly changing, but with the introduction of such huge variables, we must all be prepared to face the unknown.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950161,
					"content": "That said, judging by the card you picked, you shouldn't have much to worry about. No matter how your environment changes, you have the means to either adapt or resist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950162,
					"content": "Such wonderful news! Looks like I didn't take that punch for nothing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950163,
					"content": "It was a punch filled with beautiful wishes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "As a matter of curiosity, I have a somewhat presumptuous question to ask... I hope you don't mind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950166,
					"content": "How sly! You're deliberately trying to pique our curiosity, Mr. Wriothesley! Now, we have no choice but to insist that you ask.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950167,
					"content": "Then permit me to be frank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950168,
					"content": "I've always wondered... How exactly does a prophecy ensure its own fulfillment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950169,
					"content": "Take me, for example. My reading says I'll remain stable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950170,
					"content": "But what if, after hearing this prophecy, a sudden rebellious urge takes hold, and I immediately do something impulsive? What would happen then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950171,
					"content": "For example, what if...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950172,
					"content": "You blew up the Fortress of Meropide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "Sure, let's go with that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950174,
					"content": "Are you really dragging that back up again!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950175,
					"content": "Oooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950176,
					"content": "No, don't you even...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950177,
					"content": "Ahaha! What a happy coincidence! I just so happen to know a very skilled explosives expert. I can't recommend her highly enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950178,
					"content": "But then the Honorary Knight will surely act as her guardian, stepping in at the critical moment to stop anything bad from happening!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950179,
					"content": "...And that is how the prophecy is fulfilled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950180,
					"content": "She sounds like quite the destructive force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950181,
					"content": "And cute. Very cute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "Huh, are we talking about Klee!? Wriothesley probably doesn't know that Klee is Alice's daughter, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950183,
					"content": "Well, actually, I think you'll find her full title is Daughter of the Great Adventurer of the Realms, Dodo-King, Defender of Old Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950184,
					"content": "We don't have time for all that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950185,
					"content": "Fine... She's the Most Adorable Child of Alice, the Dodo-King, the Veritable Spark Knight, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950186,
					"content": "Honestly, we really should go back to my original plan and throw a fabulous party for everyone where I can introduce you all properly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950187,
					"content": "That way, when Klee goes to Fontaine, she'll have plenty of new friends to drink tea with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950188,
					"content": "That sounds like a wonderful plan. I'm looking forward to it already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950189,
					"content": "After all, it's not like I can turn down a good pot of tea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950164,
					"content": "Good fortune comes to those who survive great disasters.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "Please show some respect for the solitary confinement room.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
