							2560.522,
							232.133,
							4711.404
						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "Well. Here we are again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401302,
					"content": "What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401303,
					"content": "I feel really bad for saying this since everyone's so nice to me, all of you, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401304,
					"content": "Don't you feel the real world is so frighteningly dull? Don't you think the world in the Book is far more beautiful?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401305,
					"content": "I think so, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "Really? You think so too, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401311,
					"content": "I still feel the world in the Book of Revealing is much more appealing. There are dew-covered petals everywhere, and I've finally made friends with the puppy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401312,
					"content": "That puppy... Uh, Canotila, can you communicate with dogs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401313,
					"content": "Hm? Of course not. However, the puppy in the Book of Revealing is special. Or maybe, I'm special?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401314,
					"content": "I've been meditating to travel to the world in the Book, and then one day, the puppy's usual barking turned into something I could understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401315,
					"content": "As for what we talked about... He asked me to go and never come back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401316,
					"content": "But... I still want to see the sunflowers bloom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401317,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "I—Is that so... Take care, Canotila! We'll be going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401307,
					"content": "I don't think so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "Is that so...? Maybe that's right. I'm not normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401309,
					"content": "There's no difference to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#Looks like {M#Mr.}{F#Ms.} {NICKNAME} is the toughest of all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				}
			]
		}
	]
}