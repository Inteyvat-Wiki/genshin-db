			"dialogs": [
				{
					"id": 741401101,
					"content": "Hey, we meet again. Hmm? You're with Paimon this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401102,
					"content": "Huh? Paimon was here when we meditated here the last time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401103,
					"content": "Is that so? I don't remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401104,
					"content": "No matter. It's all thanks to you that I found the location of the Looking Glass and the flowers that are about to bloom, and deepened my understanding of this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401105,
					"content": "Hmm... Talking to Canotila is as confusing as ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401106,
					"content": "Woof!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "Hmm? But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401108,
					"content": "Woof, woof!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "Okay, okay! I hear you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401110,
					"content": "(Hmm...? She's talking to the puppy? Could it be that Melusine can generally communicate with dogs?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401111,
					"content": "(How incredible.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "Well, I guess that's that. I'll see you next time. Hmph! Even if you said that, I'm still coming back to play with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401113,
					"content": "#Let's go, {M#Mr.}{F#Ms.} {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7414013,
			"completionStepIds": [
				7414013
			],
