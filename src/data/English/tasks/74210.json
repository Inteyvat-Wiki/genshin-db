			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Choiseul"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361301,
					"content": "Phew... It's okay. It's okay. The nightmare is over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361302,
						741361305,
						741361309
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361302,
					"content": "How do you feel about Edwin's \"coming back to life\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361303
					]
				},
				{
					"id": 741361303,
					"content": "Whoa! You scared me! How I feel? Nothing, to be honest. I only hope that irresponsible scoundrel pays for what he's done!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361304
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361304,
					"content": "Personally, I'd tie his hands and legs up and blindfold him to stop him from getting his hands on Arkhium if I could!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361305,
					"content": "Do you feel relieved, now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361306
					]
				},
				{
					"id": 741361306,
					"content": "A bit more relieved, yes, compared to before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361307
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361307,
					"content": "But, to be honest, locking Nacker and Edwin up together? Gosh! I can't even imagine what those two would be up to!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361308
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361308,
					"content": "Explosion has been past and done. So what's next? Flooding the entire Fontaine with Fonta? I can't even imagine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361309,
					"content": "I hope you have a good day.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361310
					]
				},
				{
					"id": 741361310,
					"content": "You too, Honorary Senior Researcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				}
			]
		},
		{
			"id": 7413614,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7413611",
							"3"
						],
						"stepId": 7413611,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fusilier",
					"Lemarcq",
					"Chaussivert",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361401,
					"content": "No value... My research has no value...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361402
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361402,
					"content": "Miss, please don't think that way. Your invention saved my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361403
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741361403,
					"content": "But... But... Mr. Edwin... *whimper* *sob* Edwin said this thing is worthless...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361404
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361404,
					"content": "That just means that that Edwin's blind! This thing is a treasure! Worthless? Ha! I'd give an arm to have one for each of my men!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361405
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361405,
					"content": "Edwin's a bad person. He's full of baloney.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361406
					]
				},
				{
					"id": 741361406,
					"content": "Mr. Edwin is not a bad person! He... He... Anyway... He can't even remember my name! I even showed him my designs so many times...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361407
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361407,
					"content": "Miss Fusilier, you are very talented! Why do you let that Edwin guy judge your worth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361408,
					"content": "He doesn't see what I see in you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361409
					]
				},
				{
					"id": 741361409,
					"content": "R—Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361410
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361410,
					"content": "Of course. Take it from all of us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361411
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361411,
					"content": "But... you don't know research... *sobs*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361412
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361412,
					"content": "Miss Fusilier... she's no longer coherent. I think we better leave her alone for a bit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361413,
					"content": "Okay... Lemarcq and I will be right here. Call us if you need anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				}
			]
		}
	]
}