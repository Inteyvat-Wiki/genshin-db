			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raimondo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361201,
					"content": "Any questions? Honorary Senior Researcher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361202,
						741361208,
						741361220
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361202,
					"content": "What will happen to Nacker and Edwin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361203
					]
				},
				{
					"id": 741361203,
					"content": "They will temporarily stay at the Fortress of Meropide where they will repent for their misconduct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361204
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361204,
					"content": "That said, the Edwin I know doesn't do \"repent.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361205
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361205,
					"content": "No matter, as long as Edwin is kept away from research equipment and Arkhium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361206
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361206,
					"content": "As for Nacker... I don't believe he'll cause more trouble for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361207
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361207,
					"content": "I... I can only hope I don't run into situations that would require their expertise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361208,
					"content": "Did Fusilier use to worship Edwin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361209
					]
				},
				{
					"id": 741361209,
					"content": "...Edwin Eastinghouse is a genius. People in the same field either gave up on themselves or became his followers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361210
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361210,
					"content": "Miss Fusilier is a very passionate and creative researcher, often achieving great results with minimal resources.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361211
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361211,
					"content": "After joining the Tech Sect III of the Arkhium Research Project, she was put in charge of the structural design of the suppressor and had frequent run-ins with Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361212
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361212,
					"content": "Maybe that's when she started idolizing Edwin. Just like the other followers, Edwin's approval became her only pursuit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361213
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361213,
					"content": "After the explosion, she refused to believe that Edwin was the one who caused it, so she applied to join the investigation in an attempt to clear Edwin's name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361214
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361214,
					"content": "Now that you've dealt with Edwin, what do you make of him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361215
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361215,
					"content": "A freak of nature who cares only for his research! He always tries to push the blame to others, and he can't even remember Miss Fusilier's name!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361216,
					"content": "That sounds like him, all right. Other than his research, there's rarely anything that's worth a second of his attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361217
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361217,
					"content": "And he cares for nothing else as long as his research runs smoothly. Not even when his own subordinates stole the Institute's assets to sell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361218
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361218,
					"content": "I only approved Fusilier's application to join the investigation... so she would come to realize she was chasing an image of him she fabricated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361219
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361219,
					"content": "Now that image has finally been shattered, I can only hope she picks herself up soon... The Fontaine Research Institute cannot afford to lose more of its people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361220,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361221
					]
				},
				{
					"id": 741361221,
					"content": "Goodbye, Honorary Senior Researcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				}
			]
		},
		{
			"id": 7413613,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
