	"talks": [
		{
			"id": 4111101,
			"completionStepIds": [
				4111101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
