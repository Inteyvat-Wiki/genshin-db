			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "Hello, Traveler. You couldn't have come at a better time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110102,
					"content": "What do you mean? Has something bad happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110103,
					"content": "I'm afraid so. It's quite serious... We need all the help from our adventurers that we can get.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110104,
					"content": "So, I have an extremely urgent commission for you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110105,
					"content": "Whoa... That does sound pretty serious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110106,
					"content": "Truth be told, we have never encountered anything like this before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110107,
					"content": "The Adventurers' Guild is currently stretched beyond capacity. We are relying on our members across the land to rally together and support the relief effort at this trying time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110108,
					"content": "I will surely do my part.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "One moment, safety must come first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110111,
					"content": "Katheryne! Vassal of the Immernachtreich, do mine ears deceive me, or didst thou cry out mine holy name in earnest supplication not one moment ago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110112,
					"content": "Ah, you've arrived.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110113,
					"content": "A pleasure to meet you again, Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110114,
					"content": "Ah! Did that raven just speak!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110115,
					"content": "Haha, nice to meet you too, my friend... Though I'm sure you must have seen phenomena far stranger than myself before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110116,
					"content": "My loyal subjects, I see your faces are filled with fear and trepidation at the vile and villainous evils that once again seek, albeit in vain, to disturb the peace and tranquility of our beloved Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110117,
					"content": "Traveler, allow me to introduce Miss Fischl, a senior member of the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110118,
					"content": "Fischl, Oz, this is the Traveler of whom I have spoken to you previously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110119,
					"content": "Oh? You are the Traveler? Hmm... One finds the look in your eyes to be most agreeable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110120,
					"content": "Honorary Knight of the Knights of Favonius, and travel companion Paimon, we are honored to meet you both. We have heard much about you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110121,
					"content": "Traveler, do you also mean to confront these cryptic crystals of darkness and doom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110122,
					"content": "Uh... Cry—Crystic cryptals of... doomness and... What?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110123,
					"content": "Katheryne, is that the same thing you were talking about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "I believe that mein Fräulein does indeed refer to the <color=#00E1FFFF>meteorite strike</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110126,
					"content": "The Adventurers' Guild has so far been unable to ascertain the cause of the meteor shower, or the precise side effects of the meteorites. Hence, we recommend that adventurers travel in pairs for safety.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110127,
					"content": "Traveler, Fischl, please look out for one another on your journey, and exercise extreme caution at all times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110128,
					"content": "Hm. Very well then. You have always been a pious vassal, Katheryne, and thus I shall acquiesce to your heartfelt plea for mine assistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110129,
					"content": "Rejoice! For to join the Prinzessin der Verurteilung on her majestic mission for but a fleeting moment is surely cause for an eternity of elation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110130,
					"content": "This young lady is my master, Princess Fischl. She hails from a world beyond known as Immernachtreich. I am mein Fräulein's humble familiar, Oz the Raven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110131,
					"content": "Wow... That all sounds very impressive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110132,
					"content": "#My name's Paimon, and {NICKNAME}'s a traveler. We look forward to working with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110133,
					"content": "Did you say... \"a world beyond\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "In time, you will understand... The more time you spend with Miss Fischl, the clearer everything will become...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411110136,
					"content": "Hmph, blind to the glory of the Immernachtreich, realm of everlasting night... Though, one could hardly expect more from a lowly traveler... Hence, it is not blasphemy, but ignorance, that be the cause of this transgression. One will therefore show clemency.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110137,
					"content": "Clemency?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110138,
					"content": "Mein Fräulein means to say: \"Hello.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110139,
					"content": "These guys are the weirdest double act Paimon's ever seen... The girl sounds strange enough as it is, but every time her pet bird talks, it gets even weirder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110140,
					"content": "I am sure that you must have many questions. Perhaps we can walk — or indeed fly — and talk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110141,
					"content": "Oh, and that's another thing... What's all this about traveling in pairs? This is clearly a party of four!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110134,
					"content": "\"Immernachtreich...\"? Never heard of that place before.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "Thanks for the info! I'd better hop to it~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
		{
			"id": 4111105,
			"completionStepIds": [
				4111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111105",
							"2"
						],
						"stepId": 4111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110501,
					"content": "We're in Springvale now. Katheryne said that this is the closest impact site to the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411110502,
					"content": "The situation looks even worse than we imagined.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411110503,
					"content": "So many people have fainted.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110504
					]
				},
				{
					"id": 411110504,
					"content": "Ring the bells, sound the trumpets, for the day of judgment is upon us! Rejoice, all ye who cry out for salvation, for the Prinzessin der Verurteilung has come!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110505
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411110505,
					"content": "This princess lady seems really enthusiastic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111106,
			"completionStepIds": [
				4111106
			],
