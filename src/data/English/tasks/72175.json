			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Ah, so you're still on this island as well. That's great.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750102,
					"content": "How have you been lately? Any shocking discoveries? Let's hear them, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750103,
					"content": "Nothing earth-shaking, I'd say.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "Ah, but that's normal. Don't sweat it, I'd say. Islands like this never lack for mysteries, and I have full confidence that you'll stumble upon something eventually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750107,
					"content": "Actually, Paimon's got a question. What are you doing here, Roald?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750108,
					"content": "Me? Oh, I was just packing my things up and preparing to leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750109,
					"content": "The fog here is too bizarre. Step into it for a bit, and you lose your way... And before you know it, you're right back where you started.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750110,
					"content": "I'd forgotten the path that Kama pointed out to me before, so I tried looking for some natives to show me the way, but I couldn't find any path no matter how I tried...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750111,
					"content": "My compass, the shadows on the ground... None of these help in telling directions here... I've even tried using my shoes, but nope! I couldn't take a single step further into the fog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750112,
					"content": "Your... shoes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750113,
					"content": "He means that he used them as waymarkers.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "What...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750115,
					"content": "#Haha! As expected of you, {NICKNAME}! You're well-versed in adventuring tricks, indeed! You've got much to learn, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750116,
					"content": "Yes, much to learn you have, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Oh, come on, that's just called trying your luck! Paimon doesn't have to learn that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750118,
					"content": "Either way, my progress has ground to a halt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750119,
					"content": "*sigh* If I had tied a rope to a nearby tree and tried to advance while holding on to its other end tightly, I could probably have made a few more attempts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750120,
					"content": "So why didn't you try again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750121,
					"content": "I used up the backup shoes that I brought along to help tell which way I was going...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750122,
					"content": "So they were one-and-donesies, huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "Well, they shouldn't have been, but I, uh... I threw too many of them and kept forgetting to retrieve them, so... I ran out over time, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750126,
					"content": "Wait. That's right! I finally remembered! I've got something to ask of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750127,
					"content": "Well, well, what a surprise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750128,
					"content": "Haha, uh, sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750129,
					"content": "As you know, I have a rather shameful habit of constantly forgetting things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750130,
					"content": "My poor memory has gotten me into hot water more than a few times, especially since I'm an adventurer and all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750131,
					"content": "And one of my goals for coming to Tsurumi Island was to collect something known as Fluorescent Fungi. According to Sango, these fungi can help improve one's memory and relieve strain on one's brain. It's said that they can even improve visual acuity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750132,
					"content": "The last time I came here with Kama, I was so preoccupied with \"meeting the locals\" that I forgot to collect any... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750133,
					"content": "I also didn't expect that I would encounter so much trouble after coming to the island on my own. It's a real shame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750134,
					"content": "So if you still have adventuring plans in this area, could you help me pick a few of these Fluorescent Fungi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750135,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750137,
					"content": "Just don't forget about me when the time comes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Haha! I won't, don't worry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750124,
					"content": "That's a shame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "*sigh* It is, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750105,
					"content": "We're still exploring this place.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Is that so? Haha! Well, don't let me slow you down, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "Hmm, this should be enough, yes! Thank you ever so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750302,
					"content": "By the way, if you find anything interesting near the island's ceremonial site, do give me a shout as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750303,
					"content": "Hmm. Ah, yes. I do believe that you have a Fontaine-built Kamera with you, right? That's a rather expensive gadget to be sure... I should really get myself one of those, should my budget allow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750304,
					"content": "I've heard local historians say that the ancient natives of Tsurumi Island would use paintings to depict ancient, now-unremembered history onto the rock walls of caves, and that most of these murals have lasted over a thousand years now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750305,
					"content": "During my previous trip here, I was able to catch a glimpse of these images by ceremonial fire-light... They occupied my thoughts for several restless nights, and were most hard to forget indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750306,
					"content": "I don't believe that anyone has ever witnessed the murals in full, but if you could bring back proof of their existence, this will surely constitute a major breakthrough for the Adventurers' Guild in the field of historical academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750307,
					"content": "If you find those legendary murals, take as many clear pictures of them as you can. I will purchase the photos from you for use in my diaries for a fair price and reward you for your trouble to boot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750308,
					"content": "What do you say? Is this arrangement acceptable?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750309,
					"content": "It'll do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Thank you very much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750311,
					"content": "As long as you don't lose your diary again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "I'll... I'll try my best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"3"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_FINISHED"
					}
