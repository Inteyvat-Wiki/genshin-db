			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750401,
					"content": "Hello there, you two! Found anything lately?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750402,
					"content": "Not yet, no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "No rush. I'll be here waiting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750404,
					"content": "Thanks for the Fluorescent Fungi you gave me, by the way. They're really fresh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750407,
					"content": "Yeah, yeah, easy for you to say. Didn't we give you those mushrooms in the first place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750408,
					"content": "Ah, come now, don't sweat the small stuff. I mean, I've been eating them, haven't I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750409,
					"content": "...You... You forgetful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750405,
					"content": "We're working on it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "Rest here for a bit if you're tired, maybe have a Fluorescent Fungus or two!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217501",
							"3"
						],
						"stepId": 7217501,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"2"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7217510"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750601,
					"content": "#Hello there, {NICKNAME}! And hello there, {NICKNAME}'s gabby fairy friend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750602,
					"content": "And hello to you too, Mister Forgetful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750603,
					"content": "Paimon. Is. Paimon! Don't you forget that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750604,
					"content": "I won't, Little Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750605,
					"content": "...Wait, were you just playing Paimon!? Where did your manners go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750606,
					"content": "#You know what, {NICKNAME}? Just give this guy those weird mushrooms already. Paimon's not talking to him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750607,
					"content": "Will this be enough?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7217518,
			"completionStepIds": [
				7217509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217502",
							"3"
						],
						"stepId": 7217502,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217509",
							"2"
						],
						"stepId": 7217509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#We meet again, {NICKNAME}, and your, uh, um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "Could I ask what you'd sell this flying fellow for? I think she's quite interesting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "Eh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "Are you alright...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "He's clearly not alright! This guy's having that amnesia thing again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "What on earth are you saying... *hurk*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "*hurk*... Ahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Hahahaha! *cough* Ahahah! Just... Just look at the looks on your faces! Hehahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "I'm done... I'm out of breath... S—Sorry... This... Ahahaha... This is a favored \"joke\" of mine, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "It's not funny at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "I'm afraid I don't get your sense of humor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "*cough* Alright, alright, no more jokes. I'm sorry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "Really! Paimon thought a famous adventurer like you would be a more serious person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Haha. It might be best not to have too fixed a view of adventurers. The Guild is well-known as a circle of oddities. I'd even call myself \"normal\" amidst their ranks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "...Not by much, Paimon thinks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Still, thank you for those mushrooms. Their effects haven't been all that evident so far. Perhaps they need long-term use to really take effect, or maybe they don't have medicinal properties at all... But either way, they taste pretty good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "I should be careful not to finish all of these. I need to leave some for my friend in Sumeru who can help to research any medicinal properties that they may have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "I feel like you're just going to forget this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "*cough* Ahem, well, back on topic. Have the two of you gone looking for the murals yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "Well, here's the photos that you wanted.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Ooh, my thanks for your most generous aid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Let's see. Interesting, very interesting. Hmm... Did you find any other murals?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "This is all of them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Hmm, that's even more interesting, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "What do you mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "The people of Tsurumi Island used to worship a monstrous bird that wielded the power of Electro, and their civilization was centered around rituals and other ceremonial affairs to this effect. Most people who know something of history do not contest this view...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "But the murals that you've provided show no sign of the Thunderbird's presence at all. It seems that the people worshiped something else altogether—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "That is to say, the sun, moon, and stars... and whatever these strange symbols represent. Perhaps Tsurumi Island's natives already had a certain degree of civilization before the Thunderbird's descent...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "Other than those, the fog and the moonlight, the stars and the darkness... Hmm, I can't explain these...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "Best not to use your head too much, Roald. Who knows what that'll do to your memory...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "...Ah, yes. Sorry. I was lost in thought. Barely even noticed you two, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Thanks once again for your hard work. I think this much is enough for me to write my next diary... If it gets picked up by some historians, I won't forget to add the two of you to the acknowledgments section!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "Alright then. I think it's time I reported back to the Guild. Sorry for all the time I've taken up. May we meet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "What a busy guy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "Ah, right. There is one other thing. Nothing major, mind, but I hope that you could help me look out for someone. It's that child I mentioned earlier, whose name was... Um... Give me a moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "Right, \"Ruu.\" That was his name. I brought some things along this time for him to eat... I hope they're still fresh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751844,
					"content": "Ever since the last time I came here, I've been thinking about that kid. I can't imagine that life has been easy for him on such a perilous island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751845,
					"content": "#Alright, you'll hear no more from me. Let us meet again on the next leg of our respective journeys, {NICKNAME}! Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751830,
					"content": "These were all we could find.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "I guess this is how forgetful people survive, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "Did the Fluorescent Fungus from before work?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "That's right! Why does it seem like he's gotten worse instead!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}