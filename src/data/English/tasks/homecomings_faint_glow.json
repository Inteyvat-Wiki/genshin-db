			"dialogs": [
				{
					"id": 760300101,
					"content": "Hmm. The atmosphere's a little unusual today. Are you decorating this flower field, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Ah, that wasn't me. It was them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300103,
					"content": "You mean... the kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Yes. These stones emit a faint light upon absorbing kuuvahki. The kuuhenki are quite fond of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300105,
					"content": "So they just... put them on the ground and play with them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Not exactly. Come over here and look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300107,
					"content": "Huh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "Ooh! It forms a picture when you look at it from above!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "Looks like we're a chunk short, though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "That's right. I need to go collect some more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300111,
					"content": "Oh, so you're heading out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Yes, I know just the place — it's graced by the moon, so these kinds of stones are abundant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300113,
					"content": "Want us to come with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "Sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300115,
					"content": "Alright, then let's get collecting! We wanna see what the finished picture looks like, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
