			"dialogs": [
				{
					"id": 760300501,
					"content": "*whimper* ... Huh? What's this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300502,
					"content": "It's... so pretty...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300503,
					"content": "That should do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300504,
					"content": "And off she goes. That trail of stone should lead her back to the Frostmoon Enclave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300505,
					"content": "(Columbina says she doesn't want to be treated like a god, but she helps those in need all the same...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Wait, but what about the painting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300507,
					"content": "It's alright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300508,
					"content": "We can finish it some other time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760300509,
					"content": "I like watching people find their way back home, to the place where they belong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		}
