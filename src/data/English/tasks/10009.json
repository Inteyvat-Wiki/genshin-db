			"dialogs": [
				{
					"id": 100090801,
					"content": "That's it... Your execution was perfect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090802,
					"content": "Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Yes, I don't see any flaws in the brewing at all... Let me extract some and test the product's composition. One moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090804,
					"content": "Sucrose extracts some of the potion and uses a device to examine its composition...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Yes, like I said — flawless execution. The potion is perfect. It's exactly what I was expecting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090806,
					"content": "So, was the seventh time the charm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "Upon examination, it seems identical to the previous six iterations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090808,
					"content": "Oh... Wouldn't that make the results identical?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "Not necessarily. Experimental outcomes can differ even with similar variables all around. You never know what the result will be — that's what makes experiments valuable in the first place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090810,
					"content": "Come, let's test this thing out. I planted some Sweet Flowers beforehand which we can use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090811,
					"content": "We just need to douse them with the potion and see what happens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
			"id": 1000909,
