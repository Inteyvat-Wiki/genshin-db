			},
			"dialogs": [
				{
					"id": 100090601,
					"content": "Alright, the ingredients are ready, and the cauldron is just over there, so we should be good to go. But, um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090602,
					"content": "Is something wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "No, no. It's just... Do you mind if I watch from the side? Just for the purposes of accurate recording, I mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090604,
					"content": "I know lots of people don't like being scrutinized during experiments, so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090605,
					"content": "That's no problem at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "Thanks. Then, I'm ready to go whenever you are. I'll make sure to take detailed notes, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090607,
					"content": "So, are you ready to start the experiment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
