			},
			"dialogs": [
				{
					"id": 100090101,
					"content": "Hmm... Given previous results, I should make a few adjustments to the experiment, and ensure that the materials and equipment are all in order...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090102,
					"content": "#As for the potion I need to make... Oh, {NICKNAME}, Paimon! What brings you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090103,
					"content": "We're here to help with your \"task.\" We wanted to see if you could use some extra hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090104,
					"content": "My \"task\"... Oh, you mean the one Mr. Albedo told me about? The one from the Hexenzirkel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090105,
					"content": "Well, you're just in time. The experiment is ongoing, and I was just about to work on it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090106,
					"content": "Ongoing? So, you've been working on it all this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090107,
					"content": "Yes. It aligns with other research topics I've been working on, so it hasn't been too much extra work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090108,
					"content": "Still...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090109,
					"content": "What? Is there a problem with the experiment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090110,
					"content": "I've been \"unsuccessful\" so far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090111,
					"content": "Oh, so it keeps failing, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090112,
					"content": "It's not as simple as just \"failing.\" The whole theoretical framework behind this task is a bit more complicated than I imagined...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090113,
					"content": "So, what's this task exactly...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "Oh, right! You still haven't told us what kind of experiment it is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090115,
					"content": "One meant to develop a potion that can transform Sweet Flowers into a variant 16 times its normal size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090116,
					"content": "That is to say, the formulation of \"Botanical Augmentation Reagent Type IV, Iteration VII\" — as you can probably guess, this is my seventh time running the experiment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090117,
					"content": "Wow! So, basically, we need to make growth serum! Or, the seventh version of one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090118,
					"content": "W—Well, yeah... That's about right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090119,
					"content": "This is my seventh attempt, but I didn't make many adjustments to the formula this time, because both the theoretical principles behind this experiment and the products of the process prove there's nothing wrong with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090120,
					"content": "But you haven't \"succeeded\" yet, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090121,
					"content": "Yes. I'm thinking that it's not my current formula that is wrong, per se, but rather... Some other key element is missing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090122,
					"content": "Ohhh... Hehe, then Paimon knows just what to do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090123,
					"content": "Let us help!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "Yeah! We came here to do just that, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090127,
					"content": "Um, we could try, it's just... I would need to adjust the ratios in the original formula, and that might make the potion even more unstable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090128,
					"content": "No, we are NOT trying that! Just show us the original!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090129,
					"content": "Here it is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090130,
					"content": "That said, I'm still missing two ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090131,
					"content": "Now that we can help with. What do we need to get?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090132,
					"content": "I need spring water from Springvale to use as the base, as well as Eye of the Storm fragments... But, that last one could be tricky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090133,
					"content": "We've got this! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090125,
					"content": "Perhaps we could try adding a little essence of Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "Hehe, well that's why we're helping ou— Wait a second, Paimon is NOT an ingredient!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				}
			]
		},
