			"dialogs": [
				{
					"id": 401540101,
					"content": "You continue to run the potion shop. Thanks to all your hard work, your earnings surpass expectations...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "Wow, I have to hand it to you, cuties. I never imagined that you'd be able to bring in so much Mora in such a short amount of time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540103,
					"content": "You're practically geniuses when it comes to business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540104,
					"content": "It's all thanks to your help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "Hehe, always so humble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540106,
					"content": "Although, with results this impressive, I would say you could stand to take a bit more credit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540109,
					"content": "If I had your help all the time, I bet I could take double the amount of vacation without a care in the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540110,
					"content": "With all your hard work up to this point, we've already collected enough sales data for our research. Thank you so much for all your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540111,
					"content": "Of course, if you're interested in continuing to run the shop, you'd make me a very happy Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540112,
					"content": "In either case, I should already have more than enough to report back to Jean with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540113,
					"content": "#{NICKNAME}, Paimon, it's been a long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540114,
					"content": "Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401540115,
					"content": "Oh, you're here! I wrapped up some business with my cuties, and was just about to go report back to you at headquarters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540116,
					"content": "No need. I already talked to some other knights, so I think I have fairly good understanding of the situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540117,
					"content": "#Looks like you've troubled {NICKNAME} to help you once again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540118,
					"content": "Hehe, how could I not? When it comes to work as important as this, a smart and capable partner is simply a must have — especially if we want good results.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540119,
					"content": "Look at the success of the shop! I could have never produced that kind of result on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540120,
					"content": "Well, I do have to admit, your success is remarkable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540121,
					"content": "I've been meaning to come see you for some time now, but work kept getting in the way, and I simply couldn't find the time... Regardless, I just knew I had to come thank you in person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540122,
					"content": "We should thank you for your support as well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "It's truly reassuring to have such outstanding members among our ranks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540125,
					"content": "Hehe, once this is all over, I do believe I'm due for a vacation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540126,
					"content": "I've lost quite a few strands of hair to all the stress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540127,
					"content": "Of course. Thank you for all your hard work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540128,
					"content": "Seeing you cooped up in that library all the time, I was worried you might be bored. So I thought I'd give you an opportunity to truly make use of your talents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540129,
					"content": "Perhaps I put too much on your plate at once...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540130,
					"content": "#It wasn't that bad. After all, it's not like I was in it alone. All the help from the Knights and {NICKNAME} really helped to lessen the load.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540131,
					"content": "Plus, it was fun to get back into research. It's nice to relive those days every once in a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540132,
					"content": "I'm glad to hear that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540133,
					"content": "#Thank you again for all your help, {NICKNAME}. Please take this as your compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540134,
					"content": "Ah, speaking of compensation, I've also prepared a little memento for you. Here, I hope you like it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540123,
					"content": "It was a group effort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "We just got the hang of it along the way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "Hm, a testament to your ability to learn on the job.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				}
			]
		}
	]
}