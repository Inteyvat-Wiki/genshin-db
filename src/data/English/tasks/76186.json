				"points": []
			},
			"dialogs": [
				{
					"id": 761860201,
					"content": "A truly delicious herbal tea, Miss Sandrone. It's like I can taste your sincerity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860204,
					"content": "Alright. Next time, I'll have to invite you for tea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
