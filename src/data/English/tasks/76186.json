			"dialogs": [
				{
					"id": 761860101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860103,
					"content": "...So, how have the Frostmoon Scions been faring lately?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860104,
					"content": "Quite well. The return of the Moon Goddess has strengthened our resolve to walk our given path.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "Really? Well, that's good to hear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Hah... I suppose we really do have nothing to talk about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860109,
					"content": "I'm afraid that... is because there's far too much history between the Frostmoon Scions and the Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Speaking purely for myself, I'm grateful for your efforts in protecting Nod-Krai and welcoming back the Moon Goddess, Miss Sandrone. But as for your associates...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "I understand. For various reasons, we failed to establish friendly relations — or even mutually beneficial ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860112,
					"content": "But the Fatui no longer seek to take anything from the Frostmoon Scions, and I have reminded my subordinates not to make things difficult.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860113,
					"content": "From where I stand, seeing as we're neighbors, even if we can't coexist in perfect harmony, it would be nice if we could at least treat each other with mutual respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860114,
					"content": "I'm afraid that will take time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Undoubtedly. But we can start by taking one small step at a time. Would you like to try this herbal tea I prepared?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860116,
					"content": "Oh? Herbal tea...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Hmm... Such rich flavor. Did you brew this the Frostmoon Scions' way? Most outsiders I've met don't like our tea. How did you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "By learning. And showing respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860119,
					"content": "Hah... Not a bad first step.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "I hope it suits your tastes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860121,
					"content": "I like it a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Amicable exchanges over hot pots of tea have always been a great way to strike up friendly relations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "I have a feeling this time will be no exception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
