				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700201,
					"content": "Isn't that Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700202,
					"content": "Seems she's talking to someone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700203,
					"content": "Let's let her finish, then go say hi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700204,
					"content": "...which is what has brought us to this point in the first place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700205,
					"content": "If you are unable to promptly deal with the Stormterror threat, then leave the defense of Mondstadt to the Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700206,
					"content": "We can put an end to Mondstadt's dragon issues. All we need to do is bring that monster to the—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700207,
					"content": "\"Monster\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700208,
					"content": "Yes. What's your point?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700209,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700210,
					"content": "I'd expect a more professional attitude from your diplomats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700211,
					"content": "Yet here you are saying you want to \"put an end\" to one of The Four Winds of Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700212,
					"content": "I won't have any of this nonsense in front of the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700213,
					"content": "Heh... Hehehe... It's not as crazy as you make it sound.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700214,
					"content": "Fine. That's enough negotiation for today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700215,
					"content": "At this stage it's simply... an amicable exchange of constructive opinions, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700216,
					"content": "I'll be sure to make... thorough notes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "Anastasia"
				},
				{
					"id": 3700217,
					"content": "#Oh, {NICKNAME}, you're back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700218,
					"content": "Thanks for your help. The elemental flow is finally stable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700219,
					"content": "The aftermath of Stormterror's last attack is finally settled for the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700220,
					"content": "However, the pressure from the delegation has become too big to be ignored...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700221,
					"content": "Delegation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700222,
					"content": "From Liyue Harbor or Inazuma City?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700223,
					"content": "Snezhnaya. They choose to follow the God of Cryo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700224,
					"content": "Their envoys go by a particular name: The Fatui. Heard of them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700225,
					"content": "Oh, them. They are super famous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700226,
					"content": "Wait, infamous is more the word...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700227,
					"content": "I don't think killing Stormterror is the right course of action.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700228,
					"content": "The Cryo God's Fatui have always coveted the Anemo God's power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700229,
					"content": "I don't believe they have Mondstadt's best interests at heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700230,
					"content": "Speaking of power...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#What is it, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700232,
					"content": "There's something I need to show the Knights of Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "Oh? Let us head back to headquarters then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700234,
					"content": "We shouldn't discuss important matters... out in the open.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 37005,
			"completionStepIds": [
				37005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37005",
							"2"
						],
						"stepId": 37005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "It's a crystal embedded with some kind of power... Lisa, are you able to analyze it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700402,
					"content": "Let me take a look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700403,
					"content": "Hmm... I can see impurities in the crystal, but upon further inspection...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700404,
					"content": "No, I'm sorry, I can't make a proper analysis at the moment. Give me some time. I'll take a look through the library's restricted section.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700405,
					"content": "Right. I'll leave the research to you then, Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700406,
					"content": "Understood. I'll notify you all if I make any progress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700407,
					"content": "Though I wouldn't go getting your hopes up. They are incredibly ancient texts, not to mentio— Ouch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700408,
					"content": "Gosh, that hurt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700409,
					"content": "The impurities in the crystal... It hurts when I get close...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700410,
					"content": "I see... It appears to react to Visions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700411,
					"content": "The impurities and the elemental energy we embody repel each other.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#It's strange, though. {NICKNAME} has elemental abilities as well, but doesn't seem to be affected in the same way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700415,
					"content": "Cutie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "Okay. I will keep it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "Anyway, the crystal would be better left in the hands of my cutie. It will just be a pain if left with us — both literally and metaphorically.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700417,
					"content": "...Fascinating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700418,
					"content": "Do you know anything about what makes you special?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700420,
					"content": "I do not know what to make of it either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700421,
					"content": "#Well, then, {NICKNAME}... The Knights of Favonius have another favor to ask of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700422,
					"content": "Please accept the title of Honorary Knight... and the gratitude of the Acting Grand Master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700424,
					"content": "Honorary Knight... of Favonius!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700426,
					"content": "We ask for your continued assistance in finding some answers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700427,
					"content": "Stormterror's rage... and strange crystals... I know Mondstadt's peace hangs in the balance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700428,
					"content": "May the wind open your eyes to the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700429,
					"content": "We'll meet back here if you find anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 4820221,
					"content": "Okay then. You just need to follow the <color=#00E1FFFF>marked route</color> to the finish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}