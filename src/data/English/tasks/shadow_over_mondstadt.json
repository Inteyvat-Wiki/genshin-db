	"talks": [
		{
			"id": 37002,
			"completionStepIds": [
				37002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37002",
							"2"
						],
						"stepId": 37002,
