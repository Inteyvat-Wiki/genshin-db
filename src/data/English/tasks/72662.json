				"points": []
			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "How...how did this happen, even my father's bait formula didn't work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620302,
					"content": "Don't be sad, it's that Ruin Guard's fault! It must have scared the \"Lunar Leviathan\" away! Let's try again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620303,
					"content": "Yeah, let's try again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620306,
					"content": "Let's forget it for now, I'm a little tired. Maybe Nantuck is right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620307,
					"content": "*sigh* I want to go and take a stroll outside. I have to think about what happens after this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620308,
					"content": "Here's your payment. Whatever the case, thank you very much for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620309,
					"content": "Looks like Ms. Kujirai wants to be left alone now, let's come back to see her later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
