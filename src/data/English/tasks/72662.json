			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "You found them so quickly? You're a powerful adventurer indeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620202,
					"content": "Will these be enough?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "Well, watch me next, I just have to do this...this...and this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620204,
					"content": "This should be it, that's all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620205,
					"content": "The next step is to scatter the bait and wait for the \"Lunar Leviathan\" to appear, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620206,
					"content": "Yes, I purposely chose this place, from where we reached the shore back then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620207,
					"content": "The \"Lunar Leviathan\" that guided us back to the ship also disappeared here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620208,
					"content": "So, is everyone ready? Don't forget to make a wish when you see the \"Lunar Leviathan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620209,
					"content": "What if it doesn't work?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620211,
					"content": "Don't say such discouraging things, it will work. The \"Lunar Leviathan\" will definitely come.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620212,
					"content": "Yeah! It will work! Big fish, big fish, you must be good and bite the bait! I'm counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620213,
					"content": "Look! Look at this! It's glowing under the water! Something's coming!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726620214,
					"content": "Really? Is the \"Lunar Leviathan\" really here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620215,
					"content": "Help, it's a Ruin Guard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726620216,
					"content": "Why is it this guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
