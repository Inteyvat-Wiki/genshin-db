				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300601,
					"content": "How did it go? Did you defeat that monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300602,
					"content": "Sure did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "That's great... I suppose we can finally rest easy now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300604,
					"content": "Thanks for your help, Traveler. Here's a token of our appreciation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300605,
					"content": "...Still, it doesn't add up. Why would such a creature suddenly show up near Qingce Village?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300606,
					"content": "Regardless, I'll have to report this matter to the Ministry of Civil Affairs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300607,
					"content": "I hope that they'll be able to send us more people...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		}
	]
}