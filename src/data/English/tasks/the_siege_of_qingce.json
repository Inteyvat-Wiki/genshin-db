			},
			"dialogs": [
				{
					"id": 411300501,
					"content": "I have other matters to attend to.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300502
					]
				},
				{
					"id": 411300502,
					"content": "Um... Alright then. It's fine, we'll think of another way to deal with those monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
