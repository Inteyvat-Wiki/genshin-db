						],
						"stepId": 4113001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "Traveler, over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300102,
					"content": "What's up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "It's about Qingce Village again. Those meteorites that came down have caused the monsters around the village to go wild. They've been rampaging across the roads, and Qingce Village is on the verge of being surrounded by them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300106,
					"content": "While no major harm will befall Qingce Village so long as we guard it, the supplies we get from the city need to come in from the outside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300107,
					"content": "Under the present circumstances, the Ministry of Civil Affairs can't send too many troops to escort those supplies. They would be in trouble if attacked by large groups of monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300108,
					"content": "I and some of my compatriots gave this some thought... and while we can't go too far from Qingce Village, we can help to defeat the monsters near the village itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300109,
					"content": "This way, we can help those who are escorting our supplies. However, our scouts tell us that there are quite a few points of monster concentration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300110,
					"content": "We'd be hard-pressed to take all these camps out in good time by ourselves. And I worry that something might happen to Qingce Village if we take too long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300111,
					"content": "Could you help us with a portion of the monsters, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "That won't do... We need reinforcements...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300202,
					"content": "I've cleaned the monsters out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "Thank you very much, but I'm afraid there's been an emergency.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300204,
					"content": "I'd assumed that the monsters around Qingce Village were all the ordinary sort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300205,
					"content": "I'd just led some troops to clean out one monster camp, and we were looking to get some rest before continuing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300206,
					"content": "But that was when a Stonehide Lawachurl came charging out of the nearby woods...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300207,
					"content": "It was upon us before we could even react, and many were injured... We were forced to fall back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300208,
					"content": "That monster is too huge a threat to be left alone, but the other detachments have yet to return from clearing their targets out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300209,
					"content": "Could you help us defeat that monster, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300210,
					"content": "You can count on me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "I will, thank you. I'm really sorry... This should have been our task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300212,
					"content": "How are the wounded?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "We were able to get help in time, so no one is in serious danger... But they'll have trouble moving about for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300214,
					"content": "As such, I'm afraid it's all up to you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300215,
					"content": "I'm very sorry. This should have been our duty...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113003,
