				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300401,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300402
					]
				},
				{
					"id": 411300402,
					"content": "Great! I'll call the others, and we'll head out immediately. The quicker we settle this, the better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300403,
					"content": "Let's meet back here once we've defeated them all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113005,
