			},
			"dialogs": [
				{
					"id": 50280501,
					"content": "The lives of the Descenders are more valuable than you can imagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280502
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280502,
					"content": "You have destroyed this world's hope with your own hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280503
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280503,
					"content": "If I was fated to fail, then why do you fear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280504
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280505
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280505,
					"content": "(We embark on a pilgrimage, for the wishes of the people.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280506
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280506,
					"content": "(We choose to battle, to earn a glorious name.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280507
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280507,
					"content": "(And in the end, we burn to cinders for a dream.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280508
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280508,
					"content": "(And so this cycle continued, time after time...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				}
			]
		},
