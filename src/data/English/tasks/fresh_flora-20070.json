					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200700101,
					"content": "How are the flowers that we stored away on Dragonspine earlier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700102,
					"content": "I only managed to retrieve one container...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700103
					]
				},
				{
					"id": 200700103,
					"content": "The others couldn't be retrieved? Um... Well, alright then. It is quite hard to predict conditions on that mountain, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700104,
					"content": "But if we only have one, then we can't make any comparisons. I suppose we'll just have to wait for another opportunity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700105,
					"content": "Thank you for taking the trouble, though. Here, I prepared these as compensation — I might need to call upon your help in the future as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007002,
			"completionStepIds": [
				2007007
			],
