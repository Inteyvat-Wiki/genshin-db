						200700402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700402,
					"content": "I could only retrieve these.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700403
					]
				},
				{
					"id": 200700403,
					"content": "Well, these experiments have produced good results. It seems as though preservation at low temperatures is a viable solution, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700404,
					"content": "The only problem is that Dragonspine is really far from Mondstadt. I can't be troubling you every time, either. I have to find some other way in future...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700405
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700405,
					"content": "Thank you very much, all the same. Here's your compensation, please take it!",
					"roleType": "TALK_ROLE_NPC",
