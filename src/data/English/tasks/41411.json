						414111303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111303,
					"content": "I... I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111304
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111304,
					"content": "...Interesting... such an exquisite gift box. What's it doing out here in the wilderness?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111305,
					"content": "...Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111306,
					"content": "Wow, what a beautiful Windwheel Aster wreath! And so many paper stars!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111307,
						414111308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111307,
					"content": "Is this a prank?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				},
				{
					"id": 414111309,
					"content": "Hmm... looks like our \"perpetrator\" is really just one of Barbara's fans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111310,
					"content": "There's a note! What does it say? Hmm, let's see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111311,
					"content": "\"So sorry to get your attention this way. Please accept this Windblume as a sign of my sincere admiration for your virtue and sweetness.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111312,
					"content": "Huh? So it's... fraudulent intimidation, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111313,
					"content": "Be it for the gods or that special someone, flowers should be offered in utmost sincerity. It's the most important ceremony of the Windblume Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111314,
					"content": "Flowers of love and blessings, sent on such a special occasion... No effort should be spared to make it spectacular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111315,
					"content": "Behind the questionable methodology... here we have a meticulously thought-out and heartfelt gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111316
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111316,
					"content": "Heh... laying it on a little thick, aren't we...? Still seems like someone with a few screws loose to Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111317,
					"content": "Hahaha, maybe you're right. I think I have a suspect in mind who fits that description...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111318
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111318,
					"content": "Who? Who?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111319,
					"content": "(I think I know the answer too.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111320
					]
				},
				{
					"id": 414111320,
					"content": "Shh! No telling, now... I'd like Paimon to make a few guesses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111321
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111321,
					"content": "Ah!? You're so annoying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111308,
					"content": "Is this just someone's way of getting your attention?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				}
			]
		},
		{
			"id": 4141114,
			"completionStepIds": [
				4141114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141114",
							"2"
						],
						"stepId": 4141114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111401,
					"content": "*sigh* What should I do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111402
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111402,
					"content": "You must be Nimrod! Kaeya mentioned there was something you wanted him to take care of. He's busy right now, but we can help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111403,
					"content": "...Huh? Oh, Traveler... I didn't realize it was you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111404
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111404,
					"content": "...It's like this: I'm planning to give a gift to my wife for the Windblume Festival, and I wanted my drinking buddy, Kaeya, to come up with a gift idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111405
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111405,
					"content": "...I—I'm afraid I'm a bit of a drunkard, I'm nearly always in the tavern. My wife hates me drinking, so we're constantly arguing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111406
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111406,
					"content": "Another day, another drunkard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111407,
					"content": "I can empathize, I don't mind a drink or two myself! Then again, and I'm not one to judge, but by the looks of your drinking habits... hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111408,
					"content": "I know... She's right, of course. I feel like I have to make it up to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111409
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111409,
					"content": "...Traveler, can you help me gather some materials? I want to make a gift for her myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111410
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111410,
					"content": "...I should have made preparations in advance, but I've barely been sober these last few days. I fell asleep, and when I woke up the celebrations had already begun! Now I'll never have time to finish it by myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111411
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111411,
					"content": "Yeesh, this guy is a mess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111412,
					"content": "...Single folks in Mondstadt would never dare get others to help them during the festive period. It's lucky you're already married, Nimrod.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111413,
					"content": "Uh-huh... you're telling me... *sigh* I'm sorry... Here I am making a fool of myself in front of all of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111414
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111414,
					"content": "*sigh* What's done is done. Spit it out then, how can we help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111415,
					"content": "I'm going to look for wood in the city, and we'll need plants to place inside. Those only grow in the wild, could I ask you to retrieve them? I need two stems of Small Lamp Grass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111416
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111416,
					"content": "Small Lamp Grass and wood... what are you making, exactly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111417,
					"content": "I want to make her a little wooden house, with glowing flowers and handmade furniture inside...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111418
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111418,
					"content": "Aww, such a thoughtful gift!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111419,
					"content": "A token of my love, haha. ...Back when I'd only just gotten to know her, I used to make handmade gifts for her all the time... She loved them, she even used to say that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111420
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111420,
					"content": "Oh! Uh — ahem, excuse me. Let's put the past aside for the moment. Thank you all for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111421
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111421,
					"content": "Lucky you came across such kind-hearted assistants, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111422,
					"content": "Alright, let's go and find those materials!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
