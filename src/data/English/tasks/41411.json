		},
		{
			"id": 4141103,
			"completionStepIds": [
				4141103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141103",
							"2"
						],
						"stepId": 4141103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110301,
					"content": "...Thank you, thank you so much! With these materials, I can get to work straight away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110302,
					"content": "Remember, a gift can't solve everything! You need to start being fair to your wife, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110303,
					"content": "I will, I will!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110304,
					"content": "*sigh* I do hope she likes my gift, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110305
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110305,
					"content": "Everyone likes a gift given with love, don't worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110306
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110306,
					"content": "Make it a good one! Don't go wasting those materials, they weren't easy to find y'know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141105,
			"completionStepIds": [
				4141105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141105",
							"2"
						],
						"stepId": 4141105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110501,
					"content": "We're back! Kaeya, have you finished?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110502,
					"content": "Time to hand in your homework!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110503,
					"content": "Welcome back, I'm just finishing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110504
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110504,
					"content": "Go, go, go, hand it in, hand it in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110505,
					"content": "Alright, alright... Now then, no hurting my feelings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110506,
					"content": "Hmm... Mm? Ooooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110507,
					"content": "Tone-Deaf Bard, what grade did he get?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110508,
					"content": "Kaeya, may I read this out loud?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110509
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110509,
					"content": "Feel free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110510,
					"content": "*clears throat*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110511,
					"content": "\"Mi muhe ye\\nMeans I love you\\nIn the language of the hilichurls.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110512
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110512,
					"content": "Eh? Ehh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110513,
					"content": "That's it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110514,
					"content": "That's it!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110515,
					"content": "Coherent and to the point. Plus, the length seems about right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110516,
					"content": "What!? Are you writing a Hilichurlian phrase book!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110517,
						414110518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110517,
					"content": "Ridiculous. Where's the romance?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				},
				{
					"id": 414110519,
					"content": "Hahaha, a love poem has to convey the style of its author, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110520
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110520,
					"content": "I'm not sure you took the exercise seriously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110521,
					"content": "Wait... so we're just gonna gloss over the fact that Kaeya can speak Hilichurlian? Weird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110522,
					"content": "Haha, don't underestimate the hidden knowledge of the Knights of Favonius' Cavalry Captain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110523
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110523,
					"content": "Alright then, time to collect the next student's homework...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110524
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110524,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110525
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110525,
					"content": "I just caught sight of a suspicious figure, I must go and investigate. Traveler, I have another small task for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110526,
					"content": "The Church has applied to us for a hunting license. Please take these official documents to the Cathedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110527,
					"content": "*sigh* Running errands again...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
