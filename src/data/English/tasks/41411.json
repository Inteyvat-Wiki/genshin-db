				"points": []
			},
			"dialogs": [
				{
					"id": 414110701,
					"content": "Lisa, we need to establish some ground rules... If we do end up apprehending any drunken troublemakers, no electrocutions. Okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110702
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110702,
					"content": "Oh Jean, you misunderstand me. That intoxicated fellow you witnessed last time was practically begging me to be shocked. It makes me wonder if some people don't actually quite enjoy getting—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110703
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110703,
					"content": "Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110704
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110704,
					"content": "*sigh* Very well then, if you insist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110705
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110705,
					"content": "Jean, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110706,
					"content": "Greetings, ladies! It's been a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110707,
					"content": "What are you two doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110708
					]
				},
				{
					"id": 414110708,
					"content": "A while indeed. As you can see, Lisa and I are on duty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110709
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110709,
					"content": "Aww, it's cutie and friends. Did you see any suspicious people on the way here? If you do see anything, report straight to the Knights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110710
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110710,
					"content": "Since when do librarians go out on patrol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110711,
					"content": "Rarely, but this is the Windblume Festival, and they need all hands on deck. Even the humble clerical staff, like me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110712,
					"content": "Lisa, \"humble clerical staff\" do not wield Electro the way you do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110713,
					"content": "*sigh* Please do not be alarmed, I will keep my eyes on Lisa. Especially since she seems to enjoy electrocuting people just to break up a scuffle. Not to mention shocking drunkards until they beg for mercy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110714,
					"content": "If you don't like it, I can happily refrain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110715
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110715,
					"content": "Is that a promise? Good. Otherwise, I'm going to have to reconsider whether I want a librarian on patrol with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110716
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110716,
					"content": "Paimon never knew being on patrol could be so exciting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4141108,
