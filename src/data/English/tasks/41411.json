			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110801,
					"content": "Barbara, Kaeya sent us to deliver the—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110802,
					"content": "How dare they! This is sheer intimidation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110803
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110803,
					"content": "How could somebody do this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110804
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414110804,
					"content": "Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110805,
					"content": "What's happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110806
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110806,
					"content": "I... *sniff* I—I received a letter... *sniff* It says... I—It says...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110807
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414110807,
					"content": "Let me. I just came back from the wilderness. As usual, I came by the Cathedral to ask the sisters to patch me up. That's when I saw Barbara running out, white as a sheet. She was holding a letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110808
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110808,
					"content": "I've never received a letter like this before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110809
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414110809,
					"content": "Can I take a look?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110810
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110810,
					"content": "Hm... \"Dear Barbara, I've stolen the thing most precious to you and buried it.\" Huh... Could this be an attempt at intimidation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110811
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110811,
					"content": "It's awful... is it a joke? If so, we don't need to worry. But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110812
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110812,
					"content": "...But... what if it's real...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110813
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414110813,
					"content": "There's a map on the back, isn't that out in the wilderness?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110814,
					"content": "Hmm... the thing most precious to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110815
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110815,
					"content": "Hm, buried...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110816
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110816,
					"content": "Huh... that location on the map is familiar, I've definitely been there before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110817
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110817,
					"content": "So what is the thing most precious to you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110818
					]
				},
				{
					"id": 414110818,
					"content": "I can't think straight right now, nothing makes sense... *whimpers*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110819
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414110819,
					"content": "It's coming to me... It's coming to me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110820
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110820,
					"content": "The thing most precious to me... W—Wait, could it be? Oh no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110821
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414110821,
					"content": "Barbara! Hey! Slow down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110822,
					"content": "Aha! I've got it! The Thousand Winds Temple!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110823
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 414110823,
					"content": "Bennett — hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110824
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110824,
					"content": "Why are they in such a hurry? Let's catch up with them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
