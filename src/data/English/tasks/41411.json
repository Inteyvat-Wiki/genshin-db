					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110101,
					"content": "Hiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110102,
					"content": "Traveler, Paimon, you're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110103
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110103,
					"content": "I was just thinking about you two, and now here you are. How fortuitous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110104,
					"content": "Kaeya, did you do your homework?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110105,
					"content": "I'm afraid I must disappoint you... I haven't even started writing it yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110106,
					"content": "Hmm, students that don't hand in their homework on time aren't exactly model students now, are they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110107,
					"content": "And what excuse does Kaeya have for not handing in his homework?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110108,
					"content": "Well, as you can see, I'm helping Master Jean take care of various matters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110109,
					"content": "Mondstadt is a hive of activity over the festive period. Accordingly, there's a multitude of things that need sorting. *sigh* I've been at it for a good while now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110110,
					"content": "Traveler... can I ask for a favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110111,
					"content": "I have a drinking buddy that wants me to help him with something, but I'm much too busy. Can I entrust this matter to you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110112,
					"content": "A drinking buddy? A friend you met at the tavern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110113,
					"content": "That's right. I often go to the tavern when not on duty. Somehow, I seem to have made quite a few acquaintances that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110114,
					"content": "His name is Nimrod, he's never far from the tavern. He should be free right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110115,
					"content": "Thanks for the help. I'd better stay behind and get started on my homework.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110116,
						414110117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110116,
					"content": "Good luck, Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 414110117,
					"content": "I'll consider it part of my Windblume experience.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4141102,
			"completionStepIds": [],
