			"dialogs": [
				{
					"id": 414111501,
					"content": "Venti might be here already, let's take a look inside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111502,
					"content": "Halt! Citizens, what noble errand brings you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111503
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 414111503,
					"content": "Is Kaeya here? We need him for something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111504,
					"content": "Captain Kaeya? He's on duty in Jean's office.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111505
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 414111505,
					"content": "Eh? Why is he in Jean's office?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111506,
					"content": "The Windblume Festival celebrations have always been hosted by the Knights of Favonius. During the festivities, Master Jean personally goes out on patrol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111507
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 414111507,
					"content": "Captain Kaeya takes over her administrative duties during that period.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111508
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 414111508,
					"content": "Huh, is that right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
