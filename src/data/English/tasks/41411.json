			},
			"dialogs": [
				{
					"id": 414111001,
					"content": "...My sister!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111002
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111002,
					"content": "Slow down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111003
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111003,
					"content": "Rosaria! I just—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111004
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111004,
					"content": "Calm down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111005
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111005,
					"content": "I ran into Jean a moment ago, Lisa was with her. She's fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111006
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111006,
					"content": "*gasp* R—Really? A—Are you sure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111007
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111007,
					"content": "Whew...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111008
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111008,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111009
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111009,
					"content": "That letter. Give it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111010
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111010,
					"content": "Sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111011
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111011,
					"content": "...If they're not talking about Jean in the letter... then what are they talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111012
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111012,
					"content": "Did you really think they'd buried Jean underground!? What a horrible thought!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111013,
					"content": "So, Sister, have you found any leads?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111014
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111014,
					"content": "Looking at the map, the perpetrator seems to have marked out an area around Dawn Winery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111015
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111015,
					"content": "That's open land, so hiding something there... Hmm, what could it be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111016
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111016,
					"content": "Nice work! How did you figure that out so quickly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111017,
					"content": "Although... Dawn Winery? That's not the place we were thinking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111018,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111019
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111019,
					"content": "Barbara, rather than letting your imagination get the better of you, stand up and face this head-on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111020
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111020,
					"content": "...You're right, it's just...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111021
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111021,
					"content": "Hehe, it's a little scary, right? That's why we're going with you. What do you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111022,
					"content": "Uh? Th—That's very kind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111023
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111023,
					"content": "And you, Sister? Will you be accompanying us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111024,
					"content": "No need... I knew straight away there was nothing to worry about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111025
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111025,
					"content": "Eh? And what does that mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111026,
					"content": "...Nothing. Get going, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111027
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 414111027,
					"content": "Barbara, are you feeling a bit better now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111028
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111028,
					"content": "Mm-hmm! I'm... I'm okay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111029
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111029,
					"content": "Rosaria is right, better to know the ways of the enemy than stand here scaring myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111030
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111030,
					"content": "That's right! Let's get moving!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111031,
					"content": "Thank you, all of you. Let's get to the location and see what we find.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111032
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111032,
					"content": "Yup, yup! Go, Barbara, go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
