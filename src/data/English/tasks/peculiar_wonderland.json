			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Plauen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706560101,
					"content": "Welcome! Did you come here to challenge the domain in front of your very eyes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560102,
					"content": "I wouldn't say no to that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "You've found the right guy, then. Allow me to introduce it to you. I'm Plauen of the Adventurers' Guild, in charge of securing the entrance to this domain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560105,
					"content": "According to our records, it seems to only appear at specific times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560106,
					"content": "It's the Windblume Festival at the moment, so we made a few modifications to the interior to turn it into a unique challenge before opening it to the public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560107,
					"content": "Isn't that dangerous?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "Not to worry. This is a special event organized to celebrate this festival. We'll have seasoned adventurers accompanying anyone who doesn't have any adventuring experience.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560109,
					"content": "I doubt that you'll need any help on that front, though, veteran that you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560110,
					"content": "You can explore this Domain alone or invite some friends to come along. Either way, you'll receive a reward if you can make it to the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560111,
					"content": "Will do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "Then I shan't delay you any longer. Have fun in there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560112,
					"content": "Will do — so long as there's a reward.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "Seems like a special one.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
}