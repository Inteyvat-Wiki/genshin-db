			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7065601",
							"2"
						],
						"stepId": 7065601,
						"stateName": "QUEST_STATE_UNFINISHED"
