			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "This is the message board of Puspa Café. For some reason, I will be the Acting Manager of Puspa Café for the time being. If you have anything that you want to let us know, please feel free to leave a message.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "\"The legendary story of Antara will continue this week!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010202,
					"content": "\"Presented to you by Puspa Café's special resident storyteller, Maddah! Stay tuned!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010203,
					"content": "Mr. Maddah... We'll offer you a cup of coffee free of charge if you stop posting ads here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "\"Hehe... Gata, hehehe...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010302,
					"content": "Gata seems to be really fond of you too, Miss Nilou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "\"The Puspa Card Club is recruiting members who play Genius Invokation TCG!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010402,
					"content": "\"If you'd like to discuss deck setup and techniques, come find me at the card table!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010403,
					"content": "Mr. Nayab, at least order a cup of coffee if you're going to play cards here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "\"There have been several cases of Canned Knowledge smuggling recently.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010502,
					"content": "\"Matra's special reminder: Please go through the authorized procedure when applying for and obtaining the knowledge you seek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010503,
					"content": "\"Forbidden knowledge obtained through illegal channels will result in the revoking of your right to study in the Akademiya. Please be aware.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "\"The atmosphere here is much more friendly than a tavern for a student like me who is preparing for an exam.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010602,
					"content": "\"There's coffee to keep me going and seniors to seek guidance from.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010603,
					"content": "\"Even the owner predicted that I'll get in the Akademiya this year!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010604,
					"content": "May your wish come true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "\"Be careful, everyone! My friend ran into the Rishboland Raja in the middle of the night in the northwest forest! He was lucky to make it back in one piece. Still, don't go out after sunset!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "\"The great researcher Pursina's latest research suggests that drinking coffee improves your cognitive ability.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010802,
					"content": "\"If you're trying to get in the Akademiya, then visit this coffee shop often.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010803,
					"content": "I'm very grateful that you're advertising our shop, but coffee will only give you a little more energy... Besides, the Mahamata might take action against unfounded statements like this, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "\"If you're here to play cards, please learn a lesson from me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010902,
					"content": "\"I shouldn't have made up a non-existent card to deceive my fellow players while playing Genius Invokation TCG.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010903,
					"content": "\"Lord Jackal has helped me realize my mistakes, and I'm here to confess.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732010904,
					"content": "\"Most people can't even realize their mistakes. But... who's this Lord Jackal again?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320110,
			"completionStepIds": [
				7320110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320110",
							"2"
						],
						"stepId": 7320110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011001,
					"content": "\"I heard many bandits have been popping up in the desert, and many merchants are refusing to travel the routes there. The price of Ajilenakh Nuts might start to skyrocket.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011002
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011002,
					"content": "\"Awesome! I'm selling all my mushrooms for Ajilenakh Nuts right now! Haha! Perhaps this is the courage and vision of the Alkindi Clan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011003
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011003,
					"content": "I'd love to see your wealth multiply, but I'd like to state that my shop is not responsible for any losses that may arise from the information on this board.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320111,
			"completionStepIds": [
				7320111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320111",
							"2"
						],
						"stepId": 7320111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "\"After retiring from the Corps of Thirty, this is where I get my cup of coffee every day.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011102,
					"content": "\"The acting manager makes me the same coffee every day, and the storyteller tells the same story.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011103,
					"content": "\"Perhaps the essence of life in Sumeru lies in repetitions like this.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "\"The stories Mr. Maddah tell may be old-fashioned, but he's quite skilled when it comes to controlling their pace.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011202,
					"content": "\"But everyone's used to getting their information from Akasha now, so they unconsciously overlook such sophistication of technique and artistic maturity.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011203,
					"content": "\"You need to be more realistic. No art form is eternal. The day when all of its value has been exploited is the day it loses its reason for existence.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011204,
					"content": "\"Like how overripe fruits fall to the earth and provide nourishment for new plants.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011205,
					"content": "\"And that is exactly why I've always despised materialists like you. Art is a precious fruit of leisure. You can't compare it to production and exploitation for commercial purposes!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011206,
					"content": "\"Leisurely people are like people walking on a spherical ground — they don't exist. Why don't you use your brain and think for a moment? Can the production of anything exist without commercial exchange?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011207,
					"content": "\"What a sharp clash of theories... Anyway, it's time for Mr. Kaveh to settle his bill for the month. Should it be put on your tab as usual, Mr. Alhaitham?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011208,
					"content": "\"No. That spoiled guy needs to experience the brutality of the business world.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011209,
					"content": "\"Miss Acting Manager, please put it on Lord Sangemah Bay's tab. After all, one can't make art without coffee!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7320113,
			"completionStepIds": [
				7320113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320113",
							"2"
						],
						"stepId": 7320113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "\"After so many years, this place is still so lively! Every time I come to this coffee shop, I can't help but recall that afternoon I spent arguing with him about the interpretation of a single word.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732011302,
					"content": "Our shop wouldn't be so lively without your patronage. Please do visit often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		}
	]
}