				"points": []
			},
			"dialogs": [
				{
					"id": 101100901,
					"content": "Whew! Thank you. It's clear I still have a long way to go in my training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100902
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100902,
					"content": "So modest! I for one think you're quite the pro at this already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100903
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100903,
					"content": "Well, I'm exhausted from training, so clearly my fitness needs some work. One day, though... I'll smash all the training dummies in Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100904
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100904,
					"content": "Ellin, Ellin, she's our girl! If she can't do it... um, hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100905,
					"content": "Thanks... Shoot, I got so caught up here I forgot there's something I was supposed to do today!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100906
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100906,
					"content": "Ugh... But I'm so sore from training, I can hardly move...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100907
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100907,
					"content": "Honorary Knight, could you deliver a message to Jack for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100908,
						101100913
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100908,
					"content": "Who's Jack?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100909
					]
				},
				{
					"id": 101100909,
					"content": "He's a friend of mine. Recently started as an adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100910
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100910,
					"content": "We were gonna meet up tonight and discuss adventure plans... Could you let him know it'll have to be another day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100911
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100911,
					"content": "If I'm not mistaken, you should find him at the <color=#00E1FFFF>Temple of the Lion</color>. He's adventuring with Stanley today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100912
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100912,
					"content": "Stanley's a truly legendary adventurer, renowned in all of Mondstadt. He once set foot in the Mare Jivari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100917
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100917,
					"content": "Temple of the Lion? Sure, I miss that place!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100918
					]
				},
				{
					"id": 101100918,
					"content": "Great! Thank you so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100913,
					"content": "Sure. Where can I find him?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100914
					]
				},
				{
					"id": 101100914,
					"content": "He's gone adventuring at the <color=#00E1FFFF>Temple of the Lion</color> with Stanley today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100915
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100915,
					"content": "Stanley's a truly legendary adventurer, renowned in all of Mondstadt. He once set foot in the Mare Jivari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100916
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100916,
					"content": "We were gonna meet up tonight and discuss adventure plans... Could you let him know it'll have to be another day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
