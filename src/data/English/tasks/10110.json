				"objectNames": [
					"Diluc",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100404,
					"content": "The thing about wine is, you have to drink it at the tavern or you miss out on half the fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100405
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100405,
					"content": "Seems to me you'd find some way of keeping yourself amused even if you drank alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100406,
					"content": "Haha, if I didn't know any better, I would say you're being deliberately uncivil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100407
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100407,
					"content": "Just... drink responsibly on my premises, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100408
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100408,
					"content": "Oh? And if I did have one too many, what then? You'd throw me out along with the trash, is that it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100409
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100409,
					"content": "\"Throw you out\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100410
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100410,
					"content": "You know... the same way you threw out Father's legacy? You sold off his mansion — or maybe you've forgotten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100411
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100411,
					"content": "I see no reason to cling to things that have outlived their purpose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100412
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100412,
					"content": "Is that so? Then I trust you were most swift indeed to part with a certain vase?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100413
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 101100413,
					"content": "Sorry, I have no recollection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100414
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101100414,
					"content": "That's odd. Master Diluc, I'm sure I saw such a vase in your home — a beautiful one, unmistakable, in fact...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100415
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 101100415,
					"content": "Seems our suspicions were right... Grown-ups don't appear to have imaginary friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100416,
					"content": "Like I said — a lack of childlike wonder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100417,
					"content": "Seems adults are the same everywhere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100418
					]
				},
				{
					"id": 101100418,
					"content": "So people just stop dreaming when they grow up? Okay, well, Paimon for one never wants to grow up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100419,
					"content": "Hmm... This raises an interesting question: At what age, exactly, do people's imaginary friends disappear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100420,
					"content": "Let's... go and check.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
