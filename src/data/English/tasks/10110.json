			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#Hey, {NICKNAME}... look over there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100102,
					"content": "She's... all by herself, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100103,
					"content": "Because she's acting as if she's talking and laughing with somebody else... Uhhh! Paimon's creeped out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100104,
					"content": "I had an imaginary friend too when I was a kid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#What? You mean you used to act like that too, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100106,
					"content": "Uh... so is this... an invisible friend who hangs out with you sometimes? Or... do they just exist in your imagination?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100107,
					"content": "\"Imaginary\" means \"in your imagination.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "Imaginary... imagination...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100111,
					"content": "...Oh, you must mean \"imagined friend,\" right? Why didn't you just say so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100112,
					"content": "So, this \"imaginary friend\" of yours... When does Paimon get to meet them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100113,
					"content": "We, uh, don't hang out anymore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "Seriously? So imaginary friends just... disappear when you grow up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100116,
					"content": "Exactly, yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#Oh... Paimon was looking forward to meeting yours... Hey, don't suppose your {M#sister}{F#brother} has an imaginary friend, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100119,
					"content": "Sure they do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "No way! You guys are so lucky...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100121,
					"content": "Because they have this game in Liyue — have you heard of it? It's a four player game, but it seems you guys could play it with just the two of you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100122,
					"content": "Traveler! Fancy meeting you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100123,
					"content": "Tone-Deaf Bard! What are you doing here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100124,
					"content": "Haha, I'm here because Lisa has been making some exciting new contraptions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100125,
					"content": "Why does the thought of Lisa's contraptions make Paimon so nervous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100126,
					"content": "Come now, that's no way to speak about the elegant Miss Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100127,
					"content": "For this particular contraption, Lisa had to import some dangerous materials from Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100128,
					"content": "D—Dangerous!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100129,
					"content": "A monocle equipped with some sort of... detector?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "That's right! Looks like a monocle, but actually it's called a nirnama detector.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100133,
					"content": "Sadly, Lisa isn't able to use it herself, so I'm borrowing it for a while. ...And also, I'm testing it out for her, to see if it actually works.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100134,
					"content": "Huh? Why can't Lisa use it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100135,
					"content": "Hmm... Perhaps it's because she lacks a certain childlike sense of wonder? Or maybe there's some other reason for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100136,
					"content": "If you want to know for sure, just ask her yourself sometime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100137,
					"content": "So you can see them? Go on, tell us — what does this imaginary friend look like?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100138,
					"content": "Haha... That would be telling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100139,
					"content": "Anyway, it's all yours now, Traveler. Take a look, see if you can see Nora's imaginary friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100140,
					"content": "Do you see 'em? Do you see 'em?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100141,
					"content": "Wow, it really works!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "So, it does work for you too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100144,
					"content": "Paimon wants to see~! ...Wait, but this gizmo isn't in Paimon's size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100145,
					"content": "#Alright then, you'll have to be Paimon's eyes on the ground, {NICKNAME}! Let's go see what <color=#00E1FFFF>everyone's</color> imaginary friends look like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100142,
					"content": "Yeah! Seems like they're best friends.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "Looks like a regular monocle to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "I know, right? Apparently, though, it's called a nirnama detector.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100117,
					"content": "Tragically, yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "They're... invisible now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "\"In your imagination\" means \"imaginary.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "Imagination... imaginary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "There it is. Behold, a floaty imaginary friend for floaty-headed Flora: A Bloatty Floatty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100204,
					"content": "Wait, imaginary friends can be plants now!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100205,
					"content": "Hehehe, hi Traveler, hi Bard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100206,
					"content": "Hi Flora. Can I ask a question?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "Sure. How can I help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100209,
					"content": "Who's your... friend?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "Hmm? Oh, you mean Mr. Floatty? Most people can't see him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100211,
					"content": "Mr. Floatty is my bestest friend. We grew up together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100216,
					"content": "(*grumble* No fair! Paimon hates feeling left out...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100217,
					"content": "Flora... Why exactly are you friends with a Bloatty Floatty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100218,
					"content": "What's wrong with it? I always wanted to be friends with a plant who could fly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100219,
					"content": "Friends with a flying plant? Why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100220,
					"content": "Hehehe, because then when it's windy, you and your friend can fly off into the sky together! You gotta admit that's pretty cool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100221
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100221,
					"content": "...Isn't that called being blown away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100222,
					"content": "Hehehe, that's what some people like to call it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100223
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100223,
					"content": "I only found out this plant existed from an explorer who told me stories of his adventures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100224
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100224,
					"content": "I think his name was... Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100225,
						101100226
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100225,
					"content": "Oh, I know Stanley.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100227,
					"content": "Stanley's an adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100228
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100228,
					"content": "And you can tell he's an expert at it from the stories he tells! Hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100229
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100229,
					"content": "\"The amazing adventures of Stanley\" are super famous in Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100230
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100230,
					"content": "He's in the city at the moment. You should go ask him to tell you some of his stories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100231
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100231,
					"content": "That sounds like a fun idea for next time! But right now we have other things to attend to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100226,
					"content": "Not someone I know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100227
					]
				},
				{
					"id": 101100212,
					"content": "Are you two family, or...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100213
					]
				},
				{
					"id": 101100213,
					"content": "Hehehe, you mean me and Mr. Floatty?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100214
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100214,
					"content": "Mr. Floatty is my bestest friend. We live together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100215
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100215,
					"content": "Say hello, Mr. Floatty! They can see you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100207,
					"content": "Hi. Have you got a minute?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				}
			]
		},
