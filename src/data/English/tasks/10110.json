			"dialogs": [
				{
					"id": 101100703,
					"content": "Jean! What is Jean doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100704,
					"content": "Is Master Jean Ellin's imaginary friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100705,
						101100707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100705,
					"content": "Ellin is a conscientious child.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100706
					]
				},
				{
					"id": 101100706,
					"content": "So she's so determined to become a knight that she... Okay, that's kinda weird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100709,
					"content": "Hmm? Oh, hello. What are you guys doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100710
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100710,
					"content": "Are you always training here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100711,
					"content": "You bet. Today, I heard Stanley talking about his adventures. It was incredible! It got me really pumped up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100712
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100712,
					"content": "I hope I can be as outstanding as him one day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100713
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100713,
					"content": "So that you can fight shoulder to shoulder with Master Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100714,
					"content": "I—I mean, obviously I want to become a knight! ...And if I got to go on an adventure with Jean herself... Well, even better!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100715
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100715,
					"content": "Seems Ellin reeeally looks up to Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100716,
						101100717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100716,
					"content": "There's nothing wrong with that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100718
					]
				},
				{
					"id": 101100718,
					"content": "Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100719
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100719,
					"content": "I was thinking, it's not every day I get to hang out with the Honorary Knight... Would you join me for some <color=#00E1FFFF>sword training</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100717,
					"content": "I believe you'll succeed, Ellin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100718
					]
				},
				{
					"id": 101100707,
					"content": "Ellin is really determined to become a knight.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100708
					]
				},
				{
					"id": 101100708,
					"content": "Yeah, she's so conscientious it's... terrifying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
