			"dialogs": [
				{
					"id": 101100304,
					"content": "N—No way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100305,
					"content": "Well. That... is unexpected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100306
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100306,
					"content": "Timmie's imaginary friend is a R—Ruin Guard!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100307,
						101100308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100307,
					"content": "Am I... seeing things...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100309
					]
				},
				{
					"id": 101100309,
					"content": "Paimon's freaking out right now... That thing is sure to attack us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100310,
					"content": "Haha... What say you we postpone our conversation with Timmie for the time being?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100311,
						101100312
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101100311,
					"content": "Paimon, it's time to say the line.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100313
					]
				},
				{
					"id": 101100313,
					"content": "Huh? Paimon has a favorite line?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100314,
					"content": "The one about exploring the area ahead of us later.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100315
					]
				},
				{
					"id": 101100315,
					"content": "Seriously? Oh, alright then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100316,
					"content": "How about we explore the area ahead of us later?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101100312,
					"content": "That line you love to say so much.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100313
					]
				},
				{
					"id": 101100308,
					"content": "I've heard of \"guardian angels,\" but come on...",
					"roleType": "TALK_ROLE_PLAYER",
