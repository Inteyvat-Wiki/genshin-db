			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "What have you learned, my liege?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090402,
					"content": "A fair bit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "Oh, verily? Please, do share.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090404,
					"content": "There are lots of dogs by the south wharf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "Oh, good, good. Most lively indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090406,
					"content": "The Bubu Pharmacy hosts many finches nearby.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "Finches, yes... A sign of peaceful times. Lovely poetic imagery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090408,
					"content": "Some only care for eating...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "Haha, there is nothing wrong with that. Eating is one of the prime needs and joys of life — especially in a city such as Liyue Harbor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090410,
					"content": "Yes, this too is quite fascinating. I will record this. It may yet be of use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090411,
					"content": "Some feel that things are changing too quickly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "Hmm, that too is as we should expect. To some, Liyue must almost seem to be shedding its skin with every passing day. Even I find it hard to keep up or accept every single shift...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090413,
					"content": "But this is a matter most broad — I fear that a single poem may not capture it adequately. Still, I shall write it down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090414,
					"content": "That should do for now. I see that I chose wisely in seeking your aid, my liege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090415,
					"content": "I believe that this will add at least a few new entries to my next anthology.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090416,
					"content": "Ah, yes, apart from some material goods, I have also prepared a little gift for you. Please take it as thanks for your succour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090417,
					"content": "Once my new anthology is published, you may exchange this signature for a free copy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
