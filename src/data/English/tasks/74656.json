					"nextDialogs": [
						746560106,
						746560104
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560106,
					"content": "Bulle Fruit is ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746560104,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560105
					]
				},
				{
					"id": 746560105,
					"content": "I even did as advised, and set aside some Mora to thank you for the Bulle Fruit. I suppose I should wait until you've got the fruit to give it to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
