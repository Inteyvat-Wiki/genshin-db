					"nextDialogs": [
						746560103
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560103,
					"content": "Statues are wordless poems, so one shouldn't appreciate them on an empty stomach. A duelist told me so, during the final duel of his life.",
