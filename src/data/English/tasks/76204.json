				]
			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "Congratulations! Now, let me take a look... Mhm, good job!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Unlike the current Witch's Garden, I stayed in this shrine when I was still an angel. This was my home for quite some time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "So many angels! It looks like you were super popular, Nicole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "I don't want to blow my own trumpet, but everyone used to love listening to my stories — especially the ones about living among humans, sending them omens, and guiding them to build great civilizations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Every time I got to a good bit, the other angels would stop what they were doing and hold their breaths, hanging onto my every word. You couldn't hear so much as a harp string tremble or a paintbrush scratch on the surface of a canvas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "And then, the interwoven colors and hues would bloom. There would be music and light, illuminating everything in its golden splendor — a rapture of jubilation and joy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "Ohh, that sounds wonderful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Oh, it was, Paimon... It was.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "Even though those wonderful days are gone, life remains full of happy surprises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Wait a second... Someone actually had the gall to steal my sculptures while I was reading my newspaper? Oh, that's it for you, my foolish little friend! I'm going to guide you all the way to the Fortress of Meropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Wait a second... Someone actually had the gall to steal my sculptures while I was reading my newspaper?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "Oh, that's it for you, my foolish little friend!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "I'm going to guide you all the way to the Fortress of Meropide!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		}
