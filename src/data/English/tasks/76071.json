			"dialogs": [
				{
					"id": 760710301,
					"content": "Wonderful, thank you! With this fresh wheat, I can finally make warm, comforting bread again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710302
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710302,
					"content": "Now, as promised, I'll teach you how to make Mushroom Phantasm. Make sure you remember this...",
					"roleType": "TALK_ROLE_NPC",
