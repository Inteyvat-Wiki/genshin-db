			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "If I could make some delicious bread, I'm sure it'd lift everyone's spirits. But with things the way they are, it's not that easy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710102,
					"content": "Having some trouble?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "I'm trying to recreate a kind of bread my mother used to make for me when I was little. It looked a bit like a mushroom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710106,
					"content": "From what I remember, you first cook down mushrooms and berries into a thick filling, then wrap it in freshly kneaded dough and bake everything together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710107,
					"content": "The most important part is using flour made from freshly harvested wheat. That's what gives the bread its taste of warmth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710108,
					"content": "I came here hoping to gather some wheat, but it looks like no one's had time to tend the fields lately. Now, there are all sorts of odd little creatures wandering around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710109,
					"content": "If Mr. Valdis were here, I'm sure he could deal with them. But I'm really not good at that kind of thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710110,
					"content": "So, um... could you help me gather some wheat? I only need a little. In return, I can teach you how to make warm mushroom bread. Please?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710103,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "Hey, don't leave yet. Could you lend me a hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				}
			]
		},
