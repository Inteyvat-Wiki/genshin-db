				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "Get up, lazybones! The sun's so high, it's right in your eyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680202,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "Paimon, it's fine, I sleep with my eyes closed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "Yeah, that's why you couldn't see that the sun's in your eyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680205,
					"content": "#I trust you slept well, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680206,
					"content": "Well enough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "Sounds like the same story for everyone. I got up first today, so I took a walk around and picked some fruits for our breakfast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680209,
					"content": "And Paimon's been waiting for you to get up so she can finally dig in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680210,
					"content": "You all enjoy breakfast together and get chatting...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "Huh? Fischl left first thing in the morning?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680212,
					"content": "Yeah, she seemed unwilling to stay with us. She said she had some other work to do for the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680213,
					"content": "A likely story! What happened to coming here to restore the glory of the Immernachtreich? Now she has Guild work to do all of a sudden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680214,
					"content": "Alright, Paimon, keep it together...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "Judging by that look on her face... there was probably something on her mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680216,
					"content": "We tried sending Mona to comfort her, like before... but she said Mona doesn't understand the work of the Adventurers' Guild, and can't go with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680217,
					"content": "She didn't even make up some excuse about the Immernachtreich to get some time alone? That's out of character for her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680218,
					"content": "Then she must be feeling quite troubled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680219,
					"content": "I'd love to help her as a friend... but she was right about one thing. We're going to explore another island today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680220,
					"content": "Oh? Is that so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "Yup, votes are in, it's unanimous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680222,
					"content": "But I wasn't there for the vote!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "Oh, yeah, about that... Paimon went ahead and voted for you. She said since you're always together, her opinion counts as yours, and vice versa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680224,
					"content": "Hehe, well, you are an adventurer, after all. Paimon knew you'd wanna go exploring!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680225,
					"content": "(Aah, Paimon... well, guess it's happening now...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "Fischl said there's something she wants to investigate, and suggested that we all go ahead in the meantime. She told me not to worry, she'll catch up with us when she's done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680227,
					"content": "Despite her... quirks, she's still an experienced adventurer. I think we should trust her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680228,
					"content": "I haven't known her for long, so this is just an observation, but... it seems like she's struggling with some internal conflict.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680229,
					"content": "Hmm, that seems about right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680230,
					"content": "In conflict with others, you either resolve it or let it be. But when the conflict is within yourself, it's much harder to do either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680231,
					"content": "...I've also had a time like that in my life, so I understand what she's going through. It may be best to give her some space.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680232,
					"content": "I agree. Still, it's a pity for today's adventure. Adventuring is always more fun when everyone's together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680233,
					"content": "Xinyan always has great team spirit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680234,
					"content": "#Oh, one other thing. This morning, we saw a mirage on the island in the north. We can go take a look once you're done with your breakfast, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680207,
					"content": "I slept great!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
			"id": 4006803,
