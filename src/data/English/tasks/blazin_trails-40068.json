			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 400681501,
					"content": "This should be the Glacial Spring Water we're looking for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681502,
					"content": "So if you drink this, you can suddenly sing like an angel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681503,
					"content": "You should give it a try, if you're curious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681504,
					"content": "No no no, I'm terrible at singing... it would be extremely embarrassing if it didn't work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681505,
					"content": "Haha, Mona, I actually think you've got a sweet voice that's well-suited for singing! If you're interested, I can teach you a few things about vocals once we get back to camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681506
					],
					"speakerTitle": "Xinyan"
				},
				{
