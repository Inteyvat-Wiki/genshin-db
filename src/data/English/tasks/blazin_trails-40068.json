			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680401,
					"content": "*cough* *cough* Paimon just got a mouthful of dirt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680402,
					"content": "Paimon, are you okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680403,
					"content": "Just as we thought... we've been sent to another place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680404,
					"content": "Why does this place feel so bleak? ...Xinyan, are you sure this is your mirage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680405,
					"content": "I think so, yeah, but... you're right, why is it so bleak here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680406
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680406,
					"content": "Look, there's something really bright over there. It's almost like it's inviting us to go check it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680407,
					"content": "Okay, let's go have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680408,
					"content": "Wait, wait, wait! This is too obvious. Surely it's gotta be a trap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680409,
					"content": "That may well be, but there's also nowhere else for us to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680410,
					"content": "Indeed...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680411
					]
				},
				{
					"id": 400680411,
					"content": "If this mirage belongs to Xinyan, I don't think we will find any traps there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680412,
					"content": "Now you're talking! You know that wouldn't be my style.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680413
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680413,
					"content": "Hmm, that makes sense. Alright, let's go then, but let's also make sure to be careful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
