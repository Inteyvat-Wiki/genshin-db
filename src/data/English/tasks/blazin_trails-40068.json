			"dialogs": [
				{
					"id": 400680501,
					"content": "The door is locked.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680502,
						400680504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680502,
					"content": "Mona, do that thing where you turn into water, and slide under!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680503
					]
				},
				{
					"id": 400680503,
					"content": "Keep your nonsense to yourself, thank you very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680506,
					"content": "Xinyan, why did you lock the door?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680507,
					"content": "You'd think I'd know this... Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680508
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680508,
					"content": "Oh, actually... I usually put my key under the flower pot next to the door. So... maybe the key is nearby.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680509
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680509,
					"content": "Oh! Is there a flower pot around here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680510,
					"content": "There are no pots, but there is... a flower.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680511
					]
				},
				{
					"id": 400680511,
					"content": "I guess it's worth a shot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680504,
					"content": "Kazuha, lift yourself into the air and jump over it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680505
					]
				},
				{
					"id": 400680505,
					"content": "...Let's keep thinking this through.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680506
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006809,
			"completionStepIds": [
				4006809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
