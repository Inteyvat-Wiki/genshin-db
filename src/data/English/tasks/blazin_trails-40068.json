					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "This island looks pretty normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680302,
					"content": "...I smell something burning on the wind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680303,
					"content": "Ugh... my scryglass is getting clearer, but I still can't see much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680304,
					"content": "Hey, look what I found!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680305,
					"content": "It's a... well, is it a drum, or a plant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680306,
					"content": "An instrument made of a plant? Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680307,
					"content": "Xinyan, do you think this could be your island?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680308,
					"content": "Oh, you mean this instrument could have been put here just for me? Okay, let me give it a try...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680309,
					"content": "Hold on. When I touched the rock garden in the bonsai yesterday, we were all transported to another space. Xinyan, do you want to take some time first to get ready?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680310,
					"content": "You're right, but it's all good. I'm always ready to make some music!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006804,
