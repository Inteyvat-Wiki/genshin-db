			"dialogs": [
				{
					"id": 400681001,
					"content": "Oh, we're out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681002,
					"content": "It's much brighter here. I didn't mind that hot cave, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681003,
					"content": "Glacial Spring Water can be found on one of the mountains around here. Let's all look for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681004
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681004,
					"content": "Wait, how can there be light coming from below the ground here? Is this... a water vein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681005
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400681005,
					"content": "According to that flower, the water vein is related to the plants, and the plants will lead us to that spring. So I guess we should follow the water veins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006812,
			"completionStepIds": [
				4006812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
