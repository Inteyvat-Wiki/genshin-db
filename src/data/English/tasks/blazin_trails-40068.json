					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Blazing Heart",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680901,
					"content": "Wow, that flower is huuuge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680902,
					"content": "It's so hot here... is it because of that flower?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680903,
					"content": "Heck yeah, I wasn't expecting visitors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680904,
					"content": "Aaaah!!! It talks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680905,
					"content": "So did the squirrel from yesterday.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "Paimon knows! But this is different!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680908,
					"content": "Hi, we touched those drum-like plants growing on the beach outside, and were transported here. Are you the owner of this place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680909,
					"content": "This is the hall of music, and I'm merely its gatekeeper. Tell me, my friends, are you here to pursue the ultimate expression of music?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680910,
					"content": "Ohh, you betcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680911,
					"content": "Then tell me, what do you hope to express with music?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680912,
					"content": "The spirit of resistance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680913,
					"content": "Right on, great answer! I'm so glad to hear that. I consider myself very lucky to meet another musician with the same ideals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680914,
					"content": "Even giant flowers get along well with Xinyan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680915,
					"content": "People who are easy to get along with make friends wherever they go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680916,
					"content": "If you've made it this far, you must wish to venture deeper into the hall of music. However, I must apologize. My singing voice is required for entry, but unfortunately my pipes are a little dry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680917,
					"content": "Are you alright? Do you need... uh, some cold medicine or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680918,
					"content": "It's just that I haven't had any Glacial Spring Water in a very long time. If I could drink some of that, my voice would be rocked and loaded, and ready to clear your path.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680919,
					"content": "Glacial Spring Water?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680920,
					"content": "Yeah. With one sip of that, anyone could sing the most beautiful song, no matter if they were a weary adult, a sleepy bird, or even an ignorant child...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680922,
					"content": "Okay, I'll find some for ya. Where is this spring?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680923,
					"content": "Thanks, you're the best! Well, spring water helps plants grow up strong so that they can scale the mountains that lie in their way... so, I imagine the spring can be found somewhere on the mountain range protected by plants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680924,
					"content": "You mean we have to go hiking? Oh, Paimon thought some seawater would be enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680925,
					"content": "Spring water and seawater could not be more dissimilar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680926,
					"content": "Oh, but you may need my powers in order to see the spring. Give me your hand, friend, so that you can see through my eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "Blazing Heart"
				},
				{
					"id": 400680927,
					"content": "Thanks! You shook my hand — guess that makes this friendship official!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680906,
					"content": "So did the boat from yesterday.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
