				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400681201,
					"content": "Everyone, I found a note here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681202
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681202,
					"content": "Oh, so that's how it is. What an interesting island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681203,
					"content": "Look at this style and signature... it's from Albedo! He's one of our friends from Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681204,
					"content": "He's an amazing alchemist who's visited this island before. He left this note here for future adventurers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681205,
					"content": "Oh? So it's him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400681206,
					"content": "He's saying this whole island has been turned into an instrument!? Amazing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681207
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400681207,
					"content": "And the underground water veins play an important part too... Oh, maybe we need to clear all the water veins to \"play\" this island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400681208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400681208,
					"content": "Clean your instrument before the performance! Makes a lot of sense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006815,
			"completionStepIds": [
				4006815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
