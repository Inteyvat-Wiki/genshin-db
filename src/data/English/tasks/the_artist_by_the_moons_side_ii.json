			},
			"dialogs": [
				{
					"id": 760510301,
					"content": "That should do it, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "~~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "Oh! There she goes, painting away already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "Ahem... Dear judges, prepare to be amazed! What kind of masterpiece will our talented kuuhenki artist bring us toda—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "Huh? You're done already!? Paimon didn't even get to finish her intro...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "Well, let's see here. Oh! Another drawing of Columbina. No surprise there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "It's beautiful.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "Is that... a forest somewhere in Nod-Krai? There are so many little animals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "I'm afraid... you would have to go back to the time before I left the Frostmoon Scions to see a scene like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510312,
					"content": "Wow, Paimon's so jealous! Did cute little animals really gather around you like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Yes, most of them were drawn to the kuuvahki around me. They felt safe curling up next to me like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510314,
					"content": "That's so awesome! You could pet them all you wanted without them running away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Hm... I would say the chic badgers were the nicest to pet. They're the ones with the big, fluffy tails.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510316,
					"content": "The fur on a rimehorn deer's neck is quite soft as well. It makes a very comfortable pillow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510317,
					"content": "Which do you prefer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510318,
					"content": "Um, we don't really have the same kind of experience to go off of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "But, Paimon would probably choose to pet a chic badger's tail.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Chic badgers can be quite timid. If you want to pet them, they need to feel safe first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510321,
					"content": "Ah... But I would exercise caution, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510322,
					"content": "Why? Do they... bite, or something? P—Paimon promises to be super gentle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "No. I'm referring to danger from above.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510324,
					"content": "Danger from above...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Yes... Longplume ibises often hunt little animals like these. I had to issue them a warning to get them to stop going after the kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510326,
					"content": "You're just telling Paimon this now!? It's a miracle she hasn't been carried off yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Ah... Then, the next time I see one, I'll advise them that you are off limits as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510328,
					"content": "Next time? No, you need to find one right now, or Paimon'll be too scared to even fly out that door!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Ah, I see. In that case, I will be sure to tell them that Paimon is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510330,
					"content": "The best companion ever.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Exactly! They can't just go around snatching up people's travel companions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "The little one... seems strangely curious about the idea of Paimon being carried off by a longplume ibis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760510338,
					"content": "Don't even think about painting a picture like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "The greatest travel guide in Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Uh... Paimon's glad you see it that way, but... They probably don't even know what a \"travel guide\" is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "A food source that would just upset their stomachs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "No, don't even put that thought in their heads! What if they try their luck!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510309,
					"content": "Just looking at it makes me feel happy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
