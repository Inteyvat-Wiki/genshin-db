				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}, you're finally back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050102,
					"content": "How are your investigations going?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "The Spike's adjustments have been completed. I'm still a little worried, but we can only leave it there in the tunnels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050104,
					"content": "I've asked Khedive to make some medicine for Tu and Hao as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050105,
					"content": "#It's all up to you now, {NICKNAME}... initialize the Spike and seal the openings through which the dark mud is gushing out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050106,
					"content": "Honestly, when Khedive first came to me for help, I thought to myself that I'd just pack the Spike up and head to Sumeru if things didn't work out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050107,
					"content": "In any case, we had done enough experiments on the Pursina's Spikes already, more than enough to have data that could support a full report.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050108,
					"content": "But Tu and Hao... If I just left them here, they would have to deal with this dangerous dark mud for the rest of their lives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050109,
					"content": "I decided that if my research could not help them, and was only good for publishing reports, then it would not be worth very much at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050110,
					"content": "That's why I decided to find some way to stop the Ley Lines from spewing this mud. I must admit... that coming into contact with this dark mud was something of a wake-up call for me as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050111,
					"content": "#I believe in your strength, but the areas where the mud flows freely are still very dangerous, so be careful, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050112,
					"content": "Got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "Hahaha—hurk *cough* *cough*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050115,
					"content": "I was talking about you. The Spike can indeed decrease the effect the mud has on the monsters if deployed at the Ley Line ruptures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050116,
					"content": "But the monsters that have been attracted thereto are just too numerous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050117,
					"content": "So please, you have to take care of yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050113,
					"content": "I'll take care of the Spike.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}