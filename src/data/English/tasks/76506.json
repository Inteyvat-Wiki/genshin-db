				{
					"id": 765060701,
					"content": "#Oh me, oh my, if it isn't {NICKNAME} and Paimon? Fancy meeting you here — my luck must be turning, I just know it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060702
