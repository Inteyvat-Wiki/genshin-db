					"nextDialogs": [
						765060705
					]
				},
				{
					"id": 765060705,
					"content": "Ahh, so you're here to take pictures of Nod-Krai's unique scenery, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060706
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060706,
					"content": "Well, then, you've come to the right person! Beautiful memories are priceless treasures. Though, of course, converting these memories into a best-selling album would make them more valuable still, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060707
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060707,
					"content": "That said, I don't see you carrying a Kamera — in which case, might I interest you in the newest, most high-end models of such?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060704,
					"content": "And looking for some photo-op material while we're at it.",
					"roleType": "TALK_ROLE_PLAYER",
