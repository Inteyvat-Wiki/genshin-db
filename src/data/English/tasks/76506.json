			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#Oh me, oh my, if it isn't {NICKNAME} and Paimon? Fancy meeting you here — my luck must be turning, I just know it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "Dori? What are you doing here all alone? Planning to set up shop? ... Hmm, don't see you carrying any goods, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Ah, my sincerest apologies, but the renowned traveling merchant Dori is taking the day off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "You can say I'm taking a page out of the locals' books and enjoying a normal, carefree day in this Elysium we call Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Huh? Seriously? You, not busy making Mora? Next you'll say it's been raining all year in the desert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Hehe, I'll tell you what — even if I myself take a break, my assiduous, adept employees are still constantly growing our revenue streams!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "So there's nothing to worry about — so long as the account numbers go up, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Speaking of that... Might you two be having some trouble? I might be on vacation, but far be it from me to reject any business that comes knocking at my door.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "We're just looking around.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "Ahh, so you're here to take pictures of Nod-Krai's unique scenery, hmm? Well, then, you've come to the right person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "I know this place like the back of my hand — not quite as well as the locals, certainly, but if it's recommendations you need, I have them right here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "And since we're friends, I'll personally serve as your guide, with a hefty friend discount to boot. Soooo... how does 500,000 Mora a day sound, mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "Wow, that's Dori for you. Never a few phrases away from helping yourself to the Mora in our pockets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "Oh no, no, I'm doing this so that you, my dear valued customers, can have a lovely, wonderful, unforgettable time here in Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Well, if you're so passionate about helping us out...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "Hmm? An interesting idea, to be sure. But mind you, such photos can't be used in for-profit advertisements. The rights to my likeness are most valuable, I'll have you know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Oh, don't worry, it's just a photo of an old friend — y'know, for old times' sake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Ah! Of course, of course! Since it's you who've requested this personally, {NICKNAME}, I'll make an exception. Just one — and make sure I look splendid, that's all I ask!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Let me think... How's \"Dori, Lord Sangemah Bay, and Her Paradise Vacation\" sound for a caption? Brilliant, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "Could we take a picture of you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "And looking for some photo-op material while we're at it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
