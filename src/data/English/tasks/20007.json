			},
			"dialogs": [
				{
					"id": 200070601,
					"content": "That should do it. It feels like it could fall apart at any moment, but as long it gets me back to Mondstadt I'll be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070602,
					"content": "Thanks for everything! I'm good to go now. Get in touch next time you're in Springvale and let's get a drink!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070603,
					"content": "...As long as you don't drink like Draff, that is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 2000707,
