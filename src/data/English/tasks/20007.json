			"dialogs": [
				{
					"id": 200070301,
					"content": "That's plenty, in just two seconds I'll have this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070302
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070302,
					"content": "Ahhh! They're back, Traveler, they're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 2000704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
