				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200070101,
					"content": "#Th—Thank you, {NICKNAME}, I can't believe my luck... I was sure I was done for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070102,
					"content": "This cart is loaded up with everything the hunters managed to catch. Draff had me deliver it to the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070103,
					"content": "I'm... not the best hunter in the world, but a simple delivery is something I should be able to handle. Or so I thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070104,
					"content": "I very nearly messed the whole thing up. This attack was completely out of the blue. I guess they must have been after the goods. It's a good thing you showed up when you did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070105,
					"content": "Erm, it's not easy for me to ask, but... My cart was damaged in the attack, and it's my only way out of here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070106,
					"content": "I'm sure the woods around here would have the materials I need for any repairs, but I just can't bring myself to leave my goods unattended.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070107,
					"content": "If it's not too much hassle, would you be able to take a look around and help me find a <color=#00E1FFFF>Sturdy Plank</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 2000702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
