				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200070201,
					"content": "It just needs patching up here and there, just enough so it can make it to Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070202
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070202,
					"content": "There's bound to be some useful timber in the woods around here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 2000703,
