			"dialogs": [
				{
					"id": 200070801,
					"content": "Come on, you've got this!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200070802
					]
				},
				{
					"id": 200070802,
					"content": "Please, I'm begging you! They might still be nearby... I need to disappear as soon as possible, and you're the only one who can help make that happen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
