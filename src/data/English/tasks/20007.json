			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200070401,
					"content": "You're a life-saver! They are awfully persistent, aren't they? I wonder what those hunters caught that is so irresistible ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070402,
					"content": "I have nothing but admiration for Draff, managing to hunt such fine specimens. *sigh* If only I could learn to hunt like him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070403,
					"content": "Well, first things first. Better get this old thing into the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070404,
					"content": "Argh, you're not going to believe this... I was almost done repairing the cart, but they did a little bit more damage when they attacked again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070405,
					"content": "Things can only get worse the longer I stay here. I need to fix this as soon as possible. There was some rope in the back, but the hilichurls must have nabbed it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070406,
					"content": "Traveler — may I trouble you to look around the area and see if you can find some <color=#00E1FFFF>rope</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
