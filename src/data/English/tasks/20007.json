			"dialogs": [
				{
					"id": 200070701,
					"content": "Don't worry, I've got this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200070702
					]
				},
				{
					"id": 200070702,
					"content": "Fantastic! I'll be waiting right here. Please don't be too long though, I feel like they might come back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
