				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150101,
					"content": "Ah, bravo! All six Evermotion Mechanical Painting parts, now returned to us! Now then, all we need to do is to splice them together again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150102,
					"content": "All... of them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150103
					]
				},
				{
					"id": 705150103,
					"content": "Why, of course! All these six smaller parts can be reunited as one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150104,
					"content": "Together, they will form a gigantic and beauteous Evermotion Mechanical Painting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150105,
					"content": "Come, come, all we need to do now is to join them up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150106,
						705150107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150106,
					"content": "Don't we need to cast it or anything?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				},
				{
					"id": 705150108,
					"content": "No, no, not at all. My machine is not some hastily cobbled-together amalgam of scrap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150109,
					"content": "Every part is wonderfully, intricately meshed together like a... like a... Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150110,
					"content": "Eh, never mind. I've never been the best at analogies. I swear Xavier stole all the talent in rhetoric for himself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150111,
					"content": "Either way, give it a go. It'll be interesting, I guarantee it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150107,
					"content": "Is there any other work that needs to be done?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				}
			]
		},
		{
			"id": 7051502,
			"completionStepIds": [
				7051503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051503",
							"2"
						],
						"stepId": 7051503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "Perfect! Why, it's lovely! Skilled in both mind and hand, you are, and more so than I could have expected, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150202,
					"content": "Hah. I do recall that several ludicrous manuscripts from The Steambird described you as... as...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150203,
					"content": "As a, uh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "Heh... As a straight-shooting knight-errant who prefers to let their blade do the talking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150206,
					"content": "Ah, how ridiculous and foolish those reporters were! How much ado they made about so little! After all, who are you, if not a sharp, smart, humble... and well, straight-shooting knight-errant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150207,
					"content": "When I get the time, they shall hear from me. Oh yes, they will!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150208,
					"content": "Ah, right. Please take this particular device. You can take it out for a little leisure, should you, well, be at leisure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150209,
					"content": "As for me, I've got to start raising the Mora I'll need to travel to Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150204,
					"content": "Yes, go on...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
		{
			"id": 7051503,
