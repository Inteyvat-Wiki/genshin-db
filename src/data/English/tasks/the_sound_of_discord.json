			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suspicious Citizen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "Wonderful, this place is positively bustling!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "Suspicious Citizen"
				},
				{
					"id": 700010302,
					"content": "When the wind blows the flowers about...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "Oh? Hmm... that's when bystanders should watch out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "Suspicious Citizen"
				},
				{
					"id": 700010304,
					"content": "Ah, so you're one of ours. You're just in time: I've got my eyes on a pair of careless little lovebirds. What say we go get us some Mora, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "Suspicious Citizen"
				},
				{
					"id": 700010305,
					"content": "You attract their attention, I'll cut their purses. Once we've got 'em, let's head back to Windrise to meet up with the rest. Wonder how they're doing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "Suspicious Citizen"
				},
				{
					"id": 700010306,
					"content": "Oh, sure. You're just going to have to go on a little trip with me first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "Eh!? Wait, you ain't a Treasure Hoarder. Who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "Suspicious Citizen"
				},
				{
					"id": 700010308,
					"content": "Just a friendly neighborhood Knight.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "Well, guess that's one guy in Knight custody. But Paimon wonders how they got here so fast...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010310,
					"content": "Well, guess that's not too important. Didn't he say that they were going to meet up at Windrise? Let's go check it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000104,
			"completionStepIds": [
				7000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000106",
							"2"
						],
						"stepId": 7000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Restless Citizen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "Eh? What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "Restless Citizen"
				},
				{
					"id": 700010402,
					"content": "When the wind blows the flowers about...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "Wind? Flowers? You mean the Dandelions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "Restless Citizen"
				},
				{
					"id": 700010404,
					"content": "What about that? It's totally normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "Restless Citizen"
				},
				{
					"id": 700010405,
					"content": "Um, it's nothing. Sorry for disturbing you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010406,
					"content": "Well, that seems to have been an ordinary citizen. Let's go ask someone else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000107",
							"2"
						],
						"stepId": 7000107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Crestfallen Citizen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "I wonder if I still have a chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "Crestfallen Citizen"
				},
				{
					"id": 700010502,
					"content": "Hmm? Is something the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "Crestfallen Citizen"
				},
				{
					"id": 700010503,
					"content": "When the wind blows the flowers about...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "Well, yes, that's this time of the year for sure. I know, I know, I should be enjoying it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "Crestfallen Citizen"
				},
				{
					"id": 700010505,
					"content": "Actually, that's true. Why should I be so down just because I got rejected? This festival isn't over yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "Crestfallen Citizen"
				},
				{
					"id": 700010506,
					"content": "Thanks for your encouragement. I'll pick myself back up for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "Crestfallen Citizen"
				},
				{
					"id": 700010507,
					"content": "Looks like that person misunderstood. Well, at least they're not someone suspicious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000111",
							"2"
						],
						"stepId": 7000111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010601,
					"content": "How goes the matter of the Treasure Hoarders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010602,
					"content": "They won't be giving us any trouble.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "Ah, as expected of the Honorary Knight. Well done. You did well chatting that Treasure Hoarder up previously as well... as expected of the one that gentleman has his eye on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010604,
					"content": "Excuse me, have you been watching us this whole time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010605
					]
				},
				{
					"id": 700010605,
					"content": "Why, of course! How else was I going to call the Knights over in the nick of time, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010606
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010606,
					"content": "All in all, thank you for your help. Please take these, and don't be shy about it. These are funds that our dear gentleman set aside for me to use.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010607
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010607,
					"content": "I'll see you around, then. Have a nice day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
