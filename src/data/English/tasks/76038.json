			"dialogs": [
				{
					"id": 760381001,
					"content": "(Would <color=#FFCC33FF>Illuga</color> be interested in some sugar sculptures...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381002
					]
				},
				{
					"id": 760381002,
					"content": "Well, since I'm already here... Hello, one sugar sculpture, please!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381003
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381003,
					"content": "Oh! Could you make it a bit smaller? I'm worried something might come up and I won't be able to finish it in one go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381004
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381004,
					"content": "No problem at all! Don't worry — even the small ones taste just as good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381005
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381005,
					"content": "Still, you Lightkeepers really do have your hands full... even a sugar sculpture might go unfinished.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381006
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381006,
					"content": "Um... Ahaha... Well, it's not just the duties. Sometimes it's because I run into someone who needs help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381007,
					"content": "You know how it is — half-eaten sugar sculptures are hard to keep. All I can really do is wrap it up in cloth and tuck it into my pocket...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381008,
					"content": "But by the time I'm done helping and take it back out, the whole thing's melted away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381009,
					"content": "I see... Let me think. A small sugar sculpture... hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381010,
					"content": "Got it! I can make a small sculpture with multiple flavors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381011,
					"content": "Layer this flavor on the bottom... then this one on top...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381012,
					"content": "All right! Here you go, a mini, multi-flavor sugar sculpture! Does this suit your needs, dear customer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381013,
					"content": "Ah, it's perfect! Thank you, Ms. Hunajatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381014,
					"content": "Oh, don't mention it. I may not be able to help you Ratniki with your work... but if you ever want sugar sculptures, I can make as many as you like!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
