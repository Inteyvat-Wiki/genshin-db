					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380409,
					"content": "(Might <color=#FFCC33FF>Flins</color> have an interest in sugar sculptures...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Miss Hunajatta. If I might impose, would you make me a sugar sculpture?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Oh, sure. You're... Flins, the Ratnik, am I right? I think I've seen you in our store before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "Indeed you have. I do sometimes swing by to purchase supplies. It is an honor and a privilege to be remembered so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "As for today, I just happened to be passing through when I witnessed your sugar-shaping mastery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
					"content": "And after much consideration, I decided that I must have you sculpt me a serving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380406,
					"content": "Oh, please, no need to be so polite. You're embarrassing me here~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380407,
					"content": "Just hold on a moment, one serving coming right up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380408,
					"content": "Hmm. Perhaps we should do something special for our good Ratnik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
