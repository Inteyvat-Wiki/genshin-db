					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381015,
					"content": "That's our job. You're too kind, Ms. Hunajatta... I'll take my leave now, there's still work waiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381016,
					"content": "Okay, take care! And next time you want a sugar sculpture, just come straight over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
