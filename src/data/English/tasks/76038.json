			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(Perhaps <color=#FFCC33FF>Lauma</color>'s interested in sugar sculptures...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Could you make me a few, please, Miss Hunajatta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "No problem, Miss Lauma. Did the kids like the batch you brought back last time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Hehe, that they did. In fact, some of them could only be convinced to ruin their beautiful treats once they had almost melted away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "I see... You know what? I'll bring my tools and go to you all next time. You know, set up a live station for the kids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Ah, that would be lovely. The children will be so happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "Oh, and uh, guess we're getting off topic, huh? I'll go make your sugar sculptures. Once they're done, I'll have someone deliver it to the Scions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "But before that... Hehe, I have a good idea~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "One moment, Miss Lauma. I'll whip something special up for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
