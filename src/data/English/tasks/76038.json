			"dialogs": [
				{
					"id": 760380201,
					"content": "One sugar sculpture, please.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380202
					]
				},
				{
					"id": 760380202,
					"content": "Here you go. Eat it quick once you open it, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
