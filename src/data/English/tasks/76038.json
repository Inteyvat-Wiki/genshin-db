			"dialogs": [
				{
					"id": 760380701,
					"content": "(Would <color=#FFCC33FF>Jahoda</color> be interested in some sugar sculptures...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380702
					]
				},
				{
					"id": 760380702,
					"content": "An extra-large one, please, boss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380703
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380703,
					"content": "It's not your first time here, Jahoda. You know the size of our sugar sculptures is fixed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380704,
					"content": "Come on, everything's turning up roses today! Hurry it up, just a little bigger than usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380705,
					"content": "Turning up roses? Your commission went well then, I suppose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380706,
					"content": "Hehehe, of course. Just a simple escort mission. Easy peasy, done and dusted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380707,
					"content": "Not a single hair harmed on the client's head, not a single scratch found on the cargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380708,
					"content": "Okay, I'm done talking. Speed it along, let's get that sugar sculpture on the go, I'll take it to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380709,
					"content": "No problem. Give me a moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
