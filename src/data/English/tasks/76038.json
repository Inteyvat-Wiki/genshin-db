			"dialogs": [
				{
					"id": 760380901,
					"content": "(Would <color=#FFCC33FF>Columbina</color> be interested in some sugar sculptures...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380902
					]
				},
				{
					"id": 760380902,
					"content": "Sugar sculpture... I think I've tried it before. Could you make one for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380903
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760380903,
					"content": "No problem! Just wait a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380904
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380904,
					"content": "(Hmm... Have I seen this girl somewhere in town before...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380905
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380905,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380906
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760380906,
					"content": "(Wow! She looks so full of anticipation... Ah, think, think! What style would suit her best?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380907
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380907,
					"content": "(Go with your instinct... follow your gut... okay, okay! I've got this!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380908
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380908,
					"content": "Umm... I'm done. Take a look — do you like it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380909
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380909,
					"content": "It looks great. Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380910
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760380910,
					"content": "Hehe, I'm glad you like it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380911
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380911,
					"content": "(Yes, my instinct was right — this light, airy style suits such a light, airy kid!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380912
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380912,
					"content": "Mmm, it's really tasty too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380913
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760380913,
					"content": "Could you make two more? I want to take them back for the kuuhenki to try as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760380914,
					"content": "For... the kuuhenki too? Well, I could, but I don't have enough ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380915,
					"content": "Then I'll come back tomorrow and bring them with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380916
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760380916,
					"content": "No problem... See you then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
