			"dialogs": [
				{
					"id": 760380601,
					"content": "(Might <color=#FFCC33FF>Ineffa</color> be interested in some sugar sculptures...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380602
					]
				},
				{
					"id": 760380602,
					"content": "Excuse me. Could I trouble you to make me one sugar sculpture?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380603
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380603,
					"content": "Sure. For Miss Aino, I presume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380604,
					"content": "Negative. Aino requested that I come and buy myself a beautiful sugar sculpture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380605,
					"content": "According to her, this is part of my \"social activity\" training, which will make shopping more convenient in future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380606,
					"content": "I see~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380607,
					"content": "Though I do not understand. I do not require this much sugar intake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380608,
					"content": "I suspect that Aino may wind up eating this sculpture in secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380609
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380610
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380610,
					"content": "Miss Hunajatta, could you construct a sugar sculpture with smaller dimensions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380611
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380611,
					"content": "Aino loves candy, but I believe she should eat somewhat less.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380612
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380612,
					"content": "Don't worry, I've got this... Now, let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
