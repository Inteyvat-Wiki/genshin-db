			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "(Might <color=#FFCC33FF>Nefer</color> be interested in some sugar sculptures...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "I'll have one sugar sculpture, Hunajatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380103,
					"content": "Lady Nefer, what an unexpected surprise. What brings you here today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380104,
					"content": "I find getting out and taking a walk every now and then is good for both body and mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380105,
					"content": "Besides, having something sweet helps my thought process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380106,
					"content": "Wonderful! Give me a minute, I'll rustle you one up right away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380107,
					"content": "Many thanks. And while I'm here, take this money. The next time Jahoda comes by...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380108,
					"content": "Make her an extra-large one? Make it even sweeter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380109,
					"content": "...Give the money to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380110,
					"content": "And tell her, \"Nefer's paying double, so once you're done lazing around, head back. And grab a sugar sculpture for the boss while you're at it.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		},
