			"dialogs": [
				{
					"id": 760380508,
					"content": "(Would <color=#FFCC33FF>Aino</color> be interested in some sugar sculptures...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "Hiya Boss! One sugar sculpture, please!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380502,
					"content": "Oh, Miss Aino! It's been a while~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380503,
					"content": "Hehe. Rolled into town to help fix some stuff. Thought I'd pop by and snag some candy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380504,
					"content": "Also, Ineffa isn't around, so... make me a few extras, would ya? And make 'em extra sweet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380505,
					"content": "Well, sure... but you gotta brush your teeth once you're done eating, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380506,
					"content": "Yeah, yeah, I know, I know. I always brush my teeth after eating candy! My teeth are super dee duper great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380507,
					"content": "Haha... Hold on a moment, then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
