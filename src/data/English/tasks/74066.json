			"dialogs": [
				{
					"id": 740660201,
					"content": "The \"Art of Negotiation\"...? Hmph! Even the title is boring! Paimon's not interested in that... Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "Eh? There's a note here? Hmm... \"Go to the registration counter at the front desk to participate in the Coupon Cafeteria's internal satisfaction survey for a chance to win Coupon rewards...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "Coupons... Whoa! See this? We can get Coupons! Paimon didn't expect something this good at all! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
