					}
				]
			},
			"dialogs": [
				{
					"id": 740660901,
					"content": "(Paimon is ready now! Do your worst!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660902,
					"content": "Question one. Do you think it is reasonable to maintain the prices for the food in the Coupon Cafeteria at the current low level?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660903,
					"content": "(Hmm... How do we answer this? Let Paimon look it up... Found it! Let's try the universal formula.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660904,
					"content": "(According to the book \"I agree with your views, but...\" can be used in any situation. Even an Abyss Mage would be willing to respond positively. It sounds really amazing.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660905,
					"content": "Reasonable. Paimon quite likes it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "Ah...? Paimon wouldn't touch that horrible stuff even if it was free!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660907,
					"content": "But what if our food budget runs out...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "Hmm... When you put it like that... N—NO! Paimon would rather starve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660918,
					"content": "*Cough* Excuse me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660919,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660920,
					"content": "According to the rules, the survey must be answered quickly. Let's move on to the next question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660921,
					"content": "F—Fine... Rules are rules...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660922,
					"content": "Question number two. Is adequate food available during dining hours in the Coupon Cafeteria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660923,
					"content": "There's plenty of food... But it just tastes awful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660924,
					"content": "Yeah, it has more Mint than grows on all of Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "Paimon would rather just eat Mint directly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660926,
					"content": "Really? Then you can have a Mint Salad today.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "No! Paimon doesn't want either of those! *sobs* Paimon wants Sweet Madame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660928,
					"content": "Anyway... Can we get back to the survey? I'll just put it down as a yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660935,
					"content": "Ugh... This is so tiring. Let's move on to the next question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660936,
					"content": "Before we move on to the third question, I'd like to remind you that this survey requires you to answer quickly. So...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660937,
					"content": "Now for the third question. Do you think the current randomized meal system is interesting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660938,
					"content": "Pay more attention to the taste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660939,
					"content": "I agree with your views, but... Doesn't randomized meals create the feeling of a pleasant surprise, of not knowing what you'll get next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660940,
					"content": "That's true... When you put it like that, it does sound really interesting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660941,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "What? Miss Monglane made a lot of sense. It's very difficult to disagree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660943,
					"content": "Ahem, please answer quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660944,
					"content": "It's interesting, including the fortune slips.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "Yeah! Every meal comes with a fortune, and it's like drawing lots, it's really nice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660946,
					"content": "\"Hard work begets success!\" Paimon thinks it's awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660947,
					"content": "It is hard work to guide others.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660957,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660958,
					"content": "Question number four. Do you think it's reasonable to sell addictive foods in the Coupon Cafeteria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660959,
					"content": "(Huh? What? Why is she suddenly speaking faster?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660960,
					"content": "(Gain the initiative? Steer the conversation? No! No! None of these seem correct. Maybe... We should go back to the universal formula...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660961,
					"content": "(That's not quite right... These questions...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "Ahem, please do not overthink it or engage in idle chatter. As I mentioned previously, please answer quickly and intuitively.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660964,
					"content": "It's very reasonable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "Alright, thank you for your feedback. Now, it's time for the final question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660968,
					"content": "Did she just completely ignore us? Are our answers not important at all!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660969,
					"content": "Based on the answers you've just provided, are you satisfied with the current state of the Coupon Cafeteria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660970,
					"content": "What were they again? Paimon can't remember all of them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660971,
					"content": "It's alright, then I'll just write down that you're satisfied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660972,
					"content": "Okay... But something doesn't feel quite right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660973,
					"content": "I should probably mention that you will not receive any Coupons if you answer \"no.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660974,
					"content": "That's way over the line!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660975,
					"content": "#Then what about you, {M#sir}{F#madam}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660976,
					"content": "Don't ignore Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660977,
					"content": "Yes, I'm very satisfied.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "Very well. Thank you for your cooperation. Your support is our motivation to improve. Please sign here to claim your Coupons. The intelligent flying clockwork device by your side can sign for the Coupons too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660983,
					"content": "Huh? Paimon gets some too!? But Paimon didn't even participate! Is that really okay? Wait! Paimon is Paimon! Not some intelligent flying clockwork device!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660984,
					"content": "Very well. Anyway, we respect all input, so everybody... er, all people and meka are eligible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660985,
					"content": "Didn't you hear Paimon!? Paimon isn't a flying clockwork device! Paimon is Paimon! Don't ignore Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660986,
					"content": "Understood... Anyway, in order to help save your precious time, I can fill in the survey for you. Don't worry, the number of Coupons you'll receive won't change.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660987,
					"content": "I'm sure you'll be answering \"satisfactory\" to every question, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660988,
					"content": "Yes! Coupons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660989,
					"content": "In that case, just sign here and leave the rest to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660990,
					"content": "Cool! This way we'll get the Coupons and save the trouble. Thanks, Ms. Monglane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660991,
					"content": "Thank you for your support. Please take your Coupons and we hope you'll participate in the next survey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660992,
					"content": "After getting the Coupons, you and Paimon bid farewell to Ms. Monglane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "In retrospect, Ms. Monglane didn't really care at all about our responses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660994,
					"content": "The problem is with the questions themselves.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "Yeah, you're right. The questionnaire really was weird, and Ms. Monglane seemed so exhausted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660996,
					"content": "The Art of Negotiation failed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "Art of Negotiation, pshaw! Books like that are all completely useless after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660998,
					"content": "You're right, the book is the problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "Yeah, totally! So you also think the problem is with the book, right? But since we got some Coupons, Paimon will let it slide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661000,
					"content": "Nope, the problem is with Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "Huh? But Paimon followed all the books instructions exactly! See, \"Loud and proud...\" It's all the book's fault after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661002,
					"content": "I agree with your views, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "Hey, don't you go mocking Paimon now! Hmph, some \"Art of Negotiation\"... It really was totally useless after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660978,
					"content": "No, I'm not satisfied at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "Wait, wait! No! Write down that we're satisfied! Even if just for the Coupons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660980,
					"content": "You're satisfied, huh? Understood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660981,
					"content": "I'm generally satisfied, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "It's not reasonable, because...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "I agree with your views, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(Is this... Steering the conversation?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "Not interesting, because I can't eat what I want to.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "It always tastes weird. The surprise isn't pleasant at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660951,
					"content": "I agree with your views, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "It would be great if you got a complimentary delicious meal every eighteen meals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660953,
					"content": "Why eighteen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "Paimon heard that from someone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660955,
					"content": "It was something like... Uh... Because there's three meals each day, and there are six days before Sunday, that makes eighteen meals in six days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660956,
					"content": "So there will be delicious food on the seventh day! And you'll be in a good mood every week!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660929,
					"content": "Not enough! Even Wolsey doesn't get to eat any!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "He just doesn't want to eat it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660931,
					"content": "I see, so that means there isn't enough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660932,
					"content": "I agree with your views, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "But we refuse to eat it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660934,
					"content": "*sigh*... I know you've read the book... Anyway, I'll just put it down as a yes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660909,
					"content": "Unreasonable, I want the prices to be raised!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660910
					]
				},
				{
					"id": 740660910,
					"content": "Huh!? Why!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660911,
					"content": "Forget the best, we want the most expensive!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "What kind of crazy talk is that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660913,
					"content": "A—Are you alright...? You don't seem normal at all. Did you eat something strange?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660914,
					"content": "I agree with your views, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
