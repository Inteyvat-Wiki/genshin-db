			"dialogs": [
				{
					"id": 742480201,
					"content": "This \"Tabletop Troupe\" game really is quite fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480204,
					"content": "Yes. I think the big, bad vampire should be heading home, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}