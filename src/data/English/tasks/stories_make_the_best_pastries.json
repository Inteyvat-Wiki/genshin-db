			},
			"dialogs": [
				{
					"id": 742480101,
					"content": "Ah! Miss Columbina, Miss Sandrone! Thank you for taking the time to join our Tabletop Troupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480102,
					"content": "The pleasure's all ours. We haven't really played this before, so we'll be counting on you to show us the ropes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480103,
					"content": "Don't worry, there's no pressure. The most important thing is that everyone has fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480104,
					"content": "That's great! I'm really looking forward to this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480105,
					"content": "Then let me briefly explain the story...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480106,
					"content": "\"This is an era where vampires and humans coexist. Our story occurs in a city shared by the two races...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Played by Clorinde"
				},
				{
					"id": 742480107,
					"content": "\"While not openly hostile, the relationship between humans and vampires is far from harmonious. Now, a murder in the dead of night has completely shattered the delicate balance...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Played by Clorinde"
				},
				{
					"id": 742480108,
					"content": "Vampires?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480109,
					"content": "They're a race that survives by drinking human blood. They're a common trope in fantasy novels. Have you read any stories like this before, Miss Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480110,
					"content": "Hmm, I think I may have heard of them. So what do we do in this story?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480111,
					"content": "First, everyone needs to decide what character they want to be. You can choose any identity and profession you like, provided it fits the setting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480112,
					"content": "What character do I want to be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480113,
					"content": "If you're having trouble deciding, you can team up with someone else and let them think of a character for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480114,
					"content": "Oh? You mean... we can let someone else create our backstories?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480115,
					"content": "Oh, that sounds like fun! Let's all do that! I'll leave my character sheet to you, Clorinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480116,
					"content": "Then you can decide my character, Sandrone, and I'll think up the perfect role for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480117,
					"content": "Hah... Works for me. I wasn't sure what profession to pick anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480118,
					"content": "Ooh, is everyone finished? Hehe, I can't wait to see what mine says...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480119,
					"content": "\"I'm a merchant who plies her trade in a city where vampires and humans coexist...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Traveling Merchant"
				},
				{
					"id": 742480120,
					"content": "...Wait a minute. Game Master, this character sheet is suspiciously similar to my last one... Even the stats are the same! You just copied the whole thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480121,
					"content": "No matter what I give you, you'll still find some weird way to derail the story. Besides, I think this type of shrewd, boisterous character suits you right down to the ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480122,
					"content": "...Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480123,
					"content": "Haha. Let me see who I am...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480124,
					"content": "\"I'm a big, bad vampire. During the day, I like to sleep at home, only going outside to take strolls in the garden at night when the moon is out.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "The Damselette",
					"speakerSubtitle": "Big Bad Vampire"
				},
				{
					"id": 742480125,
					"content": "\"I like to sing, and I use my voice to lure in my prey. No one who's seen into my eyes has ever lived to see the sunrise.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "The Damselette",
					"speakerSubtitle": "Big Bad Vampire"
				},
				{
					"id": 742480126,
					"content": "Hmm... Is this how you see me, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480127,
					"content": "Hehe, don't you think it suits you? Plus, it's a fascinating character.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480128,
					"content": "Alright, but I still want to try my best to be a slightly... kinder-hearted vampire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480129,
					"content": "Whatever you think is best. Right, let's see mine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480130,
					"content": "\"I'm an elegant, noble lady who likes to tinker with inventions in my room. I go to sleep very late, and keep a highly irregular schedule...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Vampire Hunter"
				},
				{
					"id": 742480131,
					"content": "Hey! What sort of person introduces themselves like this!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480132,
					"content": "Hmph... \"But I'm also a vampire hunter. When someone in the city is in danger, I bravely use my inventions to save them...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Vampire Hunter"
				},
				{
					"id": 742480133,
					"content": "...Huh? This is nothing like me at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480134,
					"content": "You don't think so? I think it's exactly like you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 742480135,
					"content": "But based on these introductions, it seems like Miss Columbina and Miss Sandrone's characters should be sworn enemies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Traveling Merchant"
				},
				{
					"id": 742480136,
					"content": "Hmm, well it certainly seems like this story is going to throw up some fascinating developments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Played by Clorinde"
				},
				{
					"id": 742480137,
					"content": "Oh! I can't wait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Traveling Merchant"
				},
				{
					"id": 742480138,
					"content": "Hah... I feel like this story is gonna throw up a lot of headaches...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Vampire Hunter"
				},
				{
					"id": 742480139,
					"content": "You're worried how this'll play out, aren't you, Sandrone? Is it because I'm an evil, bloodsucking vampire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "The Damselette",
					"speakerSubtitle": "Big Bad Vampire"
				},
				{
					"id": 742480140,
					"content": "Hah! The only thing I'm worried about is missing my chance to set your character straight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Vampire Hunter"
				}
			]
		},
