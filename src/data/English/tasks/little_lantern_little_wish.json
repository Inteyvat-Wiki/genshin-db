	"talks": [
		{
			"id": 4134101,
			"completionStepIds": [
				4134101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134101",
							"2"
						],
						"stepId": 4134101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mengmeng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "Xiao Lanterns are soooo hard to make...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "Do you know how to make Xiao Lanterns? I keep trying but I can't do it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410104,
					"content": "Through the hole, then back around, and then... I drop it. Or it breaks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410105,
					"content": "I really wanted to make a Xiao Lantern for Yu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410106,
					"content": "Yu always has to look after the tea shop, so he never has any time to play or to make a lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410107,
					"content": "But I bet he still has a wish. So I wanna make a lantern for him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410108,
					"content": "I can make one for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "But, but... I wanted to be the one to make it for him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410111,
					"content": "And, and... I wanna know the secrets to making them so I can tell Yu, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410112,
					"content": "Could you... teach me how to make them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410113,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "Yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410115,
					"content": "So, so... Then the Xiao Lantern is ready, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410116,
					"content": "Thanks! I'm gonna go make one for Yu now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410109,
					"content": "I'll make one for him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134102",
							"2"
						],
						"stepId": 4134102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "H—Hi... Sir or Madam, um, um... Please put your feet up, and please have some tea, and...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410203,
					"content": "We're here to give you a Xiao Lantern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "...Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410205,
					"content": "Yu, the Xiao Lantern's for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410206,
					"content": "Mengmeng? Oh, did you make this...? Wow... thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410207,
					"content": "#This {M#nice man}{F#nice lady} taught me how to make them. Actually, it's one of my first, so I didn't do a great job... D—Do you like it...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410208,
					"content": "Are you kidding? It's great, I love it! I was just starting to worry when I'd have the time to make one for myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410209,
					"content": "Thanks, Mengmeng. I'll find someone to hang it on my door in a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410210,
					"content": "Hang it up? What for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "Well, the thing is... My dad's not in great health, so he can't hang it up for me. And I'm too short, so I wouldn't be able to reach...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410213,
					"content": "So, if I wanna hang it on the door, I gotta ask someone around here if they can help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410214,
					"content": "We can help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "Really? You sure you don't mind helping? ...That's great, thanks! Now I don't need to worry about who'd watch the shop if I went off looking for someone to help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410215,
					"content": "Let us help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "Can't someone in your family help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134104",
							"2"
						],
						"stepId": 4134104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "#This Xiao Lantern looks so pretty! Thanks so much, {M#Sir}{F#Ma'am}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410402,
					"content": "Come on, Yu... Let's go and play. I know a great place with the prettiest flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410403,
					"content": "#This {M#nice man}{F#nice lady} taught me how to make Xiao Lanterns, and when we get there I can teach you, too. C'mon, wouldn't that be great?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410404,
					"content": "I, uh... I can't. I need to watch the shop. Even though there's no customers, I've gotta keep the place spick and span, just like my dad always says.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410405,
					"content": "Okay, well... Scrap the Xiao Lanterns, how about we just go there, have a quick chat, then come back straight away? That way, it won't waste too much of your time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410406,
					"content": "But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410407,
					"content": "I can clean the shop for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "...Oh? Y—You sure? That, uh... That's asking a lot of you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410410,
					"content": "We'll be really quick, we'll just go straight there and come straight back. Promise it won't take too long!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410411,
					"content": "Thanks soooo much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410408,
					"content": "Leave the cleaning to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "It looks like the two of them are still playing. Guess we don't have to worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410702,
					"content": "But given the atmosphere... Maybe we shouldn't disturb them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410703,
					"content": "I wanna eavesdrop on them...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "If we made a garland for your dad, do you think he'd get better quicker?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410706,
					"content": "I... I don't know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410707,
					"content": "I read in a book that if you stay happy, even if you get sick, you'll get better really quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410708,
					"content": "I think that you're so grown-up, the way you help your dad watch the shop every day... And I'm sure that must make him very happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410709,
					"content": "But sometimes he tells me off... \"Stop lounging around in the shop, go off and play\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410710,
					"content": "\"If you don't go and play with Mengmeng, she'll pick the whole neighborhood bare of flowers\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410711,
					"content": "That would never happen, there's soooo many flowers around here... Wait a second, I'll make a garland for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410712,
					"content": "Thanks, Mengmeng. I should be getting back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410713,
					"content": "Huh, okay... Well, once your dad's recovered, you'll have more time, right? Then I can come play with you again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410714,
					"content": "Yep, I'm sure dad will make a quick recovery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410715,
					"content": "What the...!? Wh—When did you get here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410716,
						413410717
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410716,
					"content": "Only just arrived.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410718
					]
				},
				{
					"id": 413410718,
					"content": "Uhh... Uhhhh... I—I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410719
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410719,
					"content": "Happy Lantern Rite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410720
					]
				},
				{
					"id": 413410720,
					"content": "Happy Lantern Rite to you, too!",
					"roleType": "TALK_ROLE_NPC",
