			"trigger": {
				"objectNames": [
					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "Ah, you've come. A moment, if you please. This should be the last time that I ask a favor of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820102,
					"content": "Well then, what do you need help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "It is Tadhla. She wants to talk to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820106,
					"content": "Eh? Why so formal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820107,
					"content": "The ruins in the north, around where you first met each other.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820108,
					"content": "What did you say?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "The ruins in the north, around where you first met each other. Don't forget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820110,
					"content": "I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "Yes. Please, treat her well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820104,
					"content": "I have other things to do...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "Please, hear me out. Tadhla wants to talk to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				}
			]
		},
		{
			"id": 7328202,
			"completionStepIds": [],
