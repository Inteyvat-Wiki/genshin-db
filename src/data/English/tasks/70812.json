				{
					"id": 708120501,
					"content": "Have you gotten them all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120502
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120502,
					"content": "Yes, sir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708120503
					]
				},
				{
					"id": 708120503,
					"content": "You have my utmost thanks. I'll take these posters and return them to the matching merchants in a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120504
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120504,
					"content": "As for that signboard, it's from the Angel's Share. I've already notified Charles — he'll send someone over to take it back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120505
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120505,
					"content": "Here's a little remuneration for your help. Please take it. As for me, I need to move on to other tasks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120506
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120506,
					"content": "Though the storm has ceased, its effects will remain with us for a while...",
