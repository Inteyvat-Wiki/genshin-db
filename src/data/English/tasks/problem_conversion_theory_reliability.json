			"dialogs": [
				{
					"id": 230200501,
					"content": "Oh! Thanks, Traveler. Here's your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200502,
					"content": "But this material is really unexpectedly heavy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200503,
					"content": "I'll start working as soon as possible. This won't take long, so this ship should be ready for a seaworthiness test soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200504,
					"content": "...You'll have to have your life jackets on ready when you test the ship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200505,
					"content": "Oh, it will be fine, for sure! Have some faith in me.",
					"roleType": "TALK_ROLE_NPC",
