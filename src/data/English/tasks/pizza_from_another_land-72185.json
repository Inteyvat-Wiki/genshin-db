			},
			"dialogs": [
				{
					"id": 721850201,
					"content": "*sigh* Is there anything in the world that will satisfy my taste buds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850202,
					"content": "About Kiminami Restaurant's pizza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "Oh, the pizza you mentioned tastes really good, and it also has a lot of local ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850204,
					"content": "However, I have tried the authentic Mushroom Pizza before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850205,
					"content": "I remember that the pizza was made of Cheese, Cabbage, and Mushrooms...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850206,
					"content": "Hahaha, I just feel that for such outland delicacies, it's better to retain it's authentic flavor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matsumoto"
				}
			]
		},
		{
			"id": 7218503,
