						721850502
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850502,
					"content": "The original Mushroom Pizza from Mondstadt, I don't know if I can make it successfully...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850503,
