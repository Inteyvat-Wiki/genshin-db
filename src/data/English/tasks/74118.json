			},
			"dialogs": [
				{
					"id": 741185001,
					"content": "#At your service, dear {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185002,
						741185008,
						741185014
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185002,
					"content": "What do you plan to do next?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "It appears we must ascertain the identity of those people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185004,
					"content": "Although we've already reported the case to the Gardes, there's little they can do without any leads to follow up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185005,
					"content": "Plus, the Court of Fontaine is far too large for the Gardes to protect us everywhere we go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185006,
					"content": "And now that we've gotten Kaia involved... it's become even more complicated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185007,
					"content": "I hope Mr. Garcia can convince Ms. Kaia to leave Fontaine. That way, we can proceed with our original plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185008,
					"content": "Anyway, isn't Garcia's research at a dead end?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "It's only a \"dead end\" insofar as there's no way to further increase performance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185010,
					"content": "In terms of practical applications, this Numbering Machine still has many great things to accomplish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185011,
					"content": "It's just, Mr. Garcia has never really concerned himself with such practicalities...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185012,
					"content": "I suspect this may be one of the reasons he suffers so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185013,
					"content": "But it could also be why he plays the part of the frustrated researcher so perfectly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185014,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "Thanks, I'm counting on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 7411851,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
