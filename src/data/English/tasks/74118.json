					}
				]
			},
			"dialogs": [
				{
					"id": 741180501,
					"content": "Hello, how may I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180502
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180502,
					"content": "Well, long story short...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180503
					]
				},
				{
					"id": 741180503,
					"content": "You tell Officer Menthe all that has happened...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "Ah, so it's about Mr. Garcia. I understand, let's head over together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180505
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180505,
					"content": "At the very least, let's scare off that suspicious fellow first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Menthe"
				}
			]
		},
		{
			"id": 7411806,
			"completionStepIds": [
				7411806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
