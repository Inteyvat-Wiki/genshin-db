	"talks": [
		{
			"id": 7411801,
			"completionStepIds": [
				7411801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7411801",
							"2"
						],
						"stepId": 7411801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_HIDE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3535.805,
							430.426,
							4553.841
						],
						"pointId": 5693
					}
				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "...Sir, perhaps we should go to Petrichor Village first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180102,
					"content": "Though Messrs. Xavier and Félix are not there, Messrs. Mécantre and Babisse should still be in the village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180103,
					"content": "Mayhap they can give you some suggestions or inspire you. Even in the worst-case scenario, you'll have two receptacles to pour your troubles into.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180104,
					"content": "No, my dear Lutong, no... Mécantre and Babisse's research is now blazing brightly, blazing a trail like a wildfire through dry tinder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180105,
					"content": "In their last letter to me, they indicated that an intelligent man from the Fontaine Research Institute had arrived in Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180106,
					"content": "This Mr. Bossuet fellow is quite knowledgeable and perceptive, and helped them resolve a number of issues...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180107,
					"content": "And as for me... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180108,
					"content": "Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#Truly an unexpected meeting, {NICKNAME}. We never imagined we'd see you in Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180111,
					"content": "Though... your timing is... as impeccable as always.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180112,
					"content": "#Indeed, truly impeccable timing... But still, we are happy to see you, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180113,
					"content": "Whoa, they look exhausted! Such dark circles around their eyes... It's like they don't have any energy left at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180114,
					"content": "What's wrong, Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Our... erm... His research encountered some... unprecedented problems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180116,
					"content": "But it's a very long story... Now, we're planning to go to the Opera Epiclese to help them close their books.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180117,
					"content": "After our work is done, we can all find a quiet place to sit down and have a chat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180118,
					"content": "You still have other work to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "It can't really be called work. Just being hired here and there to assist with various calculations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180120,
					"content": "The Opera Epiclese recently hosted a whole host of troupes, and urgently need to settle their accounts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180121,
					"content": "So, to earn enough to cover the costs of returning to Petrichor, we... I, in place of Mr. Garcia, will accept the commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180122,
					"content": "Tch! It's like using a cannon to eradicate an anthill! \"Calculations\" like those are so simple a child could do them. I could do it all in an afternoon even without using the Numbering Machine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180123,
					"content": "So this is an excellent way to raise funds. Let's set off right away, Sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180124,
					"content": "#By the way, {NICKNAME}, could I trouble you to accompany us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180125,
					"content": "With your reputation preceding us on the road, perhaps we'll manage to avoid running into any unnecessary trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180126,
					"content": "Rest assured, we'll pay you appropriate remuneration for the trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180127,
					"content": "Alright then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "If I were you, I wouldn't make any hasty assumptions... hehe. At any rate, we should get going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180128,
					"content": "You shouldn't run into any trouble in the city.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "You've returned to Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
			"id": 7411802,
			"completionStepIds": [
				7411802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7411802",
							"2"
						],
						"stepId": 7411802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia",
					"Kaia"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3490.198,
							461.138,
							3643.4
						],
						"pointId": 5696
					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "Though it must be said, this opera house is magnificent. It must bring in quite the pretty sum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180202,
					"content": "The opera house... *sigh* Let's set off and get to work. Once we're done, we'll return to Petrichor Village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180203,
					"content": "When we're back, I'll open up a bakery there and never touch another Numbering Machine again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180204,
					"content": "Uh... Sir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180205,
					"content": "What's wrong, Lutong? You look like you've seen a ghost!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180206,
					"content": "It really is... a ghost...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180207,
					"content": "Garcia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180208,
					"content": "Ms. Kaia!? What's she doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180209,
					"content": "Isn't this quite the coincidence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "Sir, what you just said wasn't particularly polite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180211,
					"content": "Oh, shut it, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180212,
					"content": "#Garcia... Such a pleasure to bump into you, and you too, {NICKNAME}. Let me guess, you've come to help the opera house settle their accounts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180213,
					"content": "Could it be that the account he's planning to settle is...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "Of course not! Our troupe has never performed here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180215,
					"content": "From what I know of Garcia though, he's not the type to watch opera in his spare time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180216,
					"content": "So the only reason he'd come to the opera house would be... because he was hired to work here, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180217,
					"content": "From the bottom of my heart, I feel you are more suitable to accompany this gentleman than I am, Ms. Kaia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180218,
					"content": "Every one of us is irreplaceable, my dear Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180219,
					"content": "I... uh... I'm very happy to see you Kaia, I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180220,
					"content": "...You don't look all that happy, I must say. I presume your research hit a snag?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180221,
					"content": "How'd you figure that out?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "Well, he certainly wouldn't be unhappy to see me, or because of you or Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180223,
					"content": "The only thing that could make him this unhappy is that Numbering Machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180224,
					"content": "How do you know Garcia so well, Ms. Kaia? You haven't seen each other for so long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180225,
					"content": "Perhaps it's her intuition.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "Perhaps we should find a café where we can sit down and have a nice leisurely chat? This isn't really something that can be explained in just a few words.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180228,
					"content": "I still need to... Uh, I mean, I'm very happy... But we...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180229,
					"content": "Relax, Sir. Those calculations are quite simple, I can handle them all myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180230,
					"content": "...After all, you can't just make Ms. Kaia stand there and wait for us to finish, can you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180231,
					"content": "Thank you, Lutong, you're very considerate. We'll bring you back a cup of coffee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180232,
					"content": "Thank you, Miss. Enjoy your drink with Mr. Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180233,
					"content": "Kaia and Garcia leave together...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "So they're off for coffee, just like that...? This whole thing had nothing to do with us from the start!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180235,
					"content": "Nothing to do with us at all...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#Not so, {NICKNAME}. What comes next is your actual commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180238,
					"content": "Do I have to fetch cooking ingredients?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "Very amusing. But I don't intend to waste your time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180242,
					"content": "Mr. Garcia and I... We're actually in danger right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180243,
					"content": "Eh... Eh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180244,
					"content": "Let's discuss it over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180239,
					"content": "Do I have to fetch parts?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "Why don't I go take some pictures for them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "...So what are we even doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "Perhaps Garcia's not the toughest nut to crack.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
			"completionStepIds": [
				7411803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7411803",
							"2"
						],
						"stepId": 7411803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3508.936,
							459.464,
							3665.876
						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "...We should be fine here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180302,
					"content": "Let me start from the beginning. Since you helped us with the Numbering Machine in Sumeru, its performance has come on leaps and bounds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180303,
					"content": "Naturally, Mr. Garcia was very excited, and wanted to continue improving it. But as he said, the transmission structure of traditional mechanisms is actually quite limited...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180304,
					"content": "We were no longer making any new performance breakthroughs with this Numbering Machine, so we decided to return to Fontaine to search for new inspiration and research ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180305,
					"content": "But after we returned, Mr. Garcia was approached by a strange fellow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180306,
					"content": "He claimed he could provide research funds, and even help Mr. Garcia find other research partners.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180307,
					"content": "But there was a catch — he wanted Mr. Garcia to share all of his designs and data with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180308,
					"content": "There's no way Garcia would accept that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "Yeah! Asking someone to hand over their research findings right from the get-go, surely that's just theft plain and simple!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180311,
					"content": "Exactly. So Mr. Garcia emphatically refused the offer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180312,
					"content": "But afterwards, it seemed as though there was someone following us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180313,
					"content": "Someone even broke into our room while we were out and searched our belongings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180314,
					"content": "They took great care to put everything back in place as it was, but Mr. Garcia discovered traces of their actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180315,
					"content": "S—Scary... So because you wouldn't give it to him, now he just wants to take it!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180316,
					"content": "After we discovered our room had been searched like that, we decided to raise enough money to get out of here and return to Petrichor as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180317,
					"content": "Once we arrive, our plan is to contact the other esteemed gentlemen of the Daydream Club and find a way to solve this problem together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180318,
					"content": "And Petrichor is... hehe, well let's just say it's Mr. Garcia's home turf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180319,
					"content": "For him, there's no safer place to be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180320,
					"content": "Today is the day that we planned to set off for Petrichor, so we hoped you would come along as protection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180321,
					"content": "We never thought we'd run into Ms. Kaia here... For safety's sake, all I could do was have Mr. Garcia take her back to the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180322,
					"content": "What can I do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "It appears we must delay our departure. Please go find Mr. Garcia, and quickly. Just like I said before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180325,
					"content": "With your reputation preceding us on the road, perhaps we'll manage to avoid running into any unnecessary trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180326,
					"content": "I'll go over there right away.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "Mr. Garcia will apprise Ms. Kaia of the situation. As for what comes next... that will be for Ms. Kaia to decide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180331,
					"content": "Anyway, we should head back to the city as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180327,
					"content": "They're not in any real danger, are they?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "No, I shouldn't think so. Mr. Garcia is still within the Court of Fontaine, and there are numerous Gardemeks on patrol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180329,
					"content": "If they intend to use violent means, then we can trust the Maison Gardiennage to take care of the greater part of the problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180323,
					"content": "How can I help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "Sounds like he was up to no good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
