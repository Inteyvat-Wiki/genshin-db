			"trigger": {
				"objectNames": [
					"Kaia",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741185101,
					"content": "...What's up? Why do you look so upset?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185102
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741185102,
					"content": "I... I'm just... It's nothing. Perhaps this coffee is a bit too strong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
