					]
				},
				{
					"id": 706810421,
					"content": "Yeah! Time to forge ahead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810414,
					"content": "Do something he'd be proud of.",
					"roleType": "TALK_ROLE_PLAYER",
