			},
			"dialogs": [
				{
					"id": 706810301,
					"content": "Phew... Saved at last... Thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810302,
					"content": "I am called Gesine. As you can see, I am an Adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810303,
					"content": "#Someone as skilled as you is surely no ordinary person! Are you a well-meaning knight? Or perhaps an errant {M#hero}{F#heroine}, wandering the land?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810304,
					"content": "I am but a passing traveler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#Paimon's name is Paimon, and {M#he's}{F#she's} {NICKNAME}, who also happens to be a member of the Adventurers' Guild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810310,
					"content": "So you are an adventurer after all, and quite the experienced one at that! You were able to dispose of such powerful monsters so easily... there really always is a bigger fish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810311,
					"content": "Whereas for me... In training, I can easily remember what to do, but the second I have to do it for real, my body just doesn't listen to me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810312,
					"content": "Do I really have to train for another three to five years like my teacher said? But it'll be totally humiliating if I go back empty-handed like this... *sobs*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810313,
					"content": "Aww, it's probably just because we have more experience! It took us a long time and a lot of battles before we got this strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810314,
					"content": "First, you need to be able to stay calm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "Yeah! Rookies often panic when they get into a real fight, so they tend to perform way worse than they might have otherwise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810316,
					"content": "No matter how strong the enemy looks, you've gotta keep a cool head while you observe them and find their weak point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810317,
					"content": "And then you can take 'em down in a flash with a good ol' one-two, whap, ka-pow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810320,
					"content": "I see... Now that's experience talking! It seems I still need to hone my skills as I travel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810321,
					"content": "Are you on a journey as well?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "Yes... I'm planning a trip to <color=#00E1FFFF>Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810323,
					"content": "Have you heard of the martial arts of Liyue? I've heard people can fly from rooftop to rooftop and run up walls, harden their skin so weapons can't pierce them, and even split iron like it was kindling!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810324,
					"content": "If I could find a master to teach me a thing or two, I bet this whole adventuring thing would be a lot easier for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810325,
					"content": "But to be perfectly honest, though I've been a member of the Adventurers' Guild for quite some time now, this is my first time going on a long trip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810326,
					"content": "*sigh* And no sooner had I left the city than I found my way blocked by monsters. Can I really make it to Liyue in one piece...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810327,
					"content": "We're on our way to Liyue too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "Really? Or is it possible someone as experienced as you is also seeking someone of great prowess?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810330,
					"content": "Not really! We're just traveling across all the nations of Teyvat for... reasons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810331,
					"content": "Though we don't know Liyue all that well, we were planning on going there sooner or later anyway!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810332,
					"content": "Since we're heading the same way, we can watch each others' backs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810333,
					"content": "Wow! I never imagined I'd be able to work with an adventurer as accomplished as yourself... There's hope for my journey after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810334,
					"content": "Let me lead the way then. I studied the map carefully before I left, so there's no way I'll get lost!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810328,
					"content": "Care to join us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "It's also important to judge the situation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "Yeah! If you can tell the enemy is way above your pay grade, it's better to get out while you still can. Don't try and be a hero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810305,
					"content": "I would prefer not to reveal my identity...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "I understand! You must be charged with a secret mission, and must be discreet in your dealings...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810307,
					"content": "Yep, that's pretty much it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "Okay, that's enough with the mysterious act!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
