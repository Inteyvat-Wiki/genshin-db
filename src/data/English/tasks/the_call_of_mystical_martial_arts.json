			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine inquires after the menu with the innkeeper, and orders several dishes as expensive as they are famous...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "I've heard that Liyue cuisine has a holistic focus on appearance, smell, and taste! It really does look so different.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810802,
					"content": "And Paimon's mouth is watering just looking at it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "Together, you savor the delicacies of Wangshu Inn...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Wowowow, this is delicious too, and this, and that... Ahhh, I'm too stuffed to eat another bite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "Now that was great!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "I'm completely recovered from traveling!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "Thank you so much for everything you've done! If it weren't for you, I can't imagine how much more difficult it would've been for me to get here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810808,
					"content": "One of the staff here told me that if I stay on this road, <color=#00E1FFFF>Liyue Harbor</color> will be just up ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810809,
					"content": "I plan to rest here for a few days, and ask around about where I can find legendary experts, then decide where I should go next.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810810,
					"content": "Though I really enjoyed traveling with you, I can't keep imposing on you like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810811,
					"content": "Moving forward, it's up to me to get stronger, so that I can become an Adventurer just as reliable as you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810812,
					"content": "Hehe, though we didn't spend that much time together, we had a good time too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810813,
					"content": "I hope we'll meet again sometime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810814,
					"content": "May we meet again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "I hope you find what you're looking for!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "Yeah! You too, I hope your travels go well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810817,
					"content": "Gesine waves goodbye.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "Well, since we're here, why don't we take a look around the area?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810819,
					"content": "Maybe there are more exciting encounters awaiting us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810820,
					"content": "Gesine said <color=#00E1FFFF>Liyue Harbor</color> was just up ahead. We should go check it out when we have time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
