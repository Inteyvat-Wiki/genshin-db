							1874.555,
							201.412,
							-142.334
						],
						"pointId": 9404
					}
				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "Sorry! Can you wait here for a moment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810402,
					"content": "What is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "Did you forget something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810404,
					"content": "No, that I didn't. But looking at the map, if we go any further, we'll have left Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810405,
					"content": "And there's no way to know when I'll return... When my teacher sees my message, he'll flip his lid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810406,
					"content": "You've mentioned your teacher before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "Yes... When he first became an Adventurer, he ran into some Mitachurls out in the wild. During the melee, he let his guard down and got knocked out by an axe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810409,
					"content": "He was lucky a passing Knight saved him and took him back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810410,
					"content": "He was so ashamed, he decided to train his combat skills to the absolute max before he went out again. He's now been training for a decade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810411,
					"content": "He always says the basics are the most important, but I just can't stand hacking away at wooden dummies every day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810412,
					"content": "So I went out alone, without telling him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810413,
					"content": "Go back once you're stronger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "Yeah! That's exactly what I was thinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810416,
					"content": "Ah, I've got it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810417,
					"content": "Gesine takes out some Dandelion Seeds from her pack, placing them on her palm. She speaks softly to them, and then releases them to be scattered by the wind...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "According to our customs, Dandelions can carry wishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810419,
					"content": "I just wished that everything will go smoothly on my journey, that I'll reach my goals, and that my teacher will understand me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810420,
