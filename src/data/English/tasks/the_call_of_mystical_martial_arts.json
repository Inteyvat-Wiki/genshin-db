			"dialogs": [
				{
					"id": 706810501,
					"content": "That's <color=#00E1FFFF>Dihua Marsh</color> up ahead, right? It's so beautiful! You won't see anything like this in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
