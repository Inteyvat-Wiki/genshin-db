				"objectNames": [
					"Gesine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "I'll treasure this photo of us together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810702,
					"content": "Ah! I didn't realize how hungry I was until I relaxed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810703,
					"content": "Now you mention it, Paimon's tummy is starting to rumble too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810704,
					"content": "Let's find a place to rest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "Let's take a look around, find a place we can score some food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810709,
					"content": "There don't seem to be any suitable restaurants nearby... Given how much you've helped and how much I look up to you, I'd feel bad eating at just any old place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810710,
					"content": "Speaking of food, might that building on top of that giant rock up ahead be the famous <color=#00E1FFFF>Wangshu Inn</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810711,
					"content": "I heard from a Liyue merchant who does business in Mondstadt that the food there is simply superb!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810712,
					"content": "Let me treat you to a feast as thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810713,
					"content": "Woo-hoo! Let's go get some food!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810705,
					"content": "Paimon, light a fire and start cooking!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "Hey! You can't just order Paimon around like that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810707,
					"content": "Besides, it's not like you don't know what Paimon's cooking is like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
