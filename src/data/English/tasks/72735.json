				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "Hey, which one of you's the ringleader? Step up! It's time to fight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350102,
					"content": "I am Grand Rook Sennichi, a giant among giants. Grandmaster Hanakado has demanded the head of the Arataki Gang's leader... and I am here to collect it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350103,
					"content": "Whoa, he looks fierce... And sounds it, too! Seems like we're up against a really strong opponent this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "Where do you get off, huh!? And what's the big idea, putting \"Grand\" in your name? You tryin' to steal my limelight, you little punk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Okay, \"giant among giants,\" time to cut you down to size!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "S—So tall! And you're... you're an oni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350107,
					"content": "Y—You look like you could eat me for breakfast! ...Why is a guy like you into beetle-fighting? It's just a kids' game... Argh, what have I gotten myself into!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350108,
					"content": "Uh, excuse me? \"Kids' game\"? Oh, you did NOT just say that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Seems to me like you don't know the first thing about beetle-fighting. Your misconception begs correctin' by a veteran, my dude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "School him!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "Yeah! Go take him down a notch! You can do it, Bull-Chucker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Looks like this is happening... Fine, bring it on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grand Rook Sennichi"
				},
				{
					"id": 727350111,
					"content": "This guy's overdue for an attitude adjustment!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}