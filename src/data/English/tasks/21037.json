			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Que'er",
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "He must've been on purpose, Zhiruo! He just... He just doesn't want to be with me! *whimper*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 210370402,
					"content": "Que'er, you and he have spent so much time together, he must know what you're thinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "This time, he's determined to leave Liyue and travel abroad, he must have his reasons. So what's the harm if you travel with him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "I just don't want to leave here! What's wrong with us staying here forever? The Guhua Clan... I couldn't care less about the Guhua Clan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 210370405,
					"content": "Then why don't you tell him that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "I... *sigh* He's been drawn to the whole idea of reviving the Clan. If he knew I'd said that, he must hate me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Little Que'er"
				},
				{
					"id": 210370407,
					"content": "*sigh* Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
