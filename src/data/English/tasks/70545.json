			"dialogs": [
				{
					"id": 705450101,
					"content": "Meow, meow meow—meooooow~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "Meow! Meow meow meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "Bunny"
				},
				{
					"id": 705450103,
					"content": "Hmmm... Both Bunny and Amber have a point...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "Oh, so that's it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "A most astute observation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "Actually, Paimon doesn't really get it either, but she can tell that Amber and Bunny have reached an understanding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}, Paimon! You're here! I was just thinking about going to look for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "I've already heard all about how you're helping Valerina with the Furball Fortress!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#That's {NICKNAME} and Paimon for you! The second you're back in Mondstadt, you're already being such a huge help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "I, the Honorary Knight, will fulfill my mission, no matter its nature.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "Speaking of which, what were you and Bunny discussing just now? You seemed to be having a really fun conversation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Meow, meow meow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "Bunny"
				},
				{
					"id": 705450115,
					"content": "Oh! I was just asking Bunny about the weather, and whether or not it would rain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "Huh? Do cats know that kind of thing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Hehe, Lisa said something about that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "According to a book she read, cats are very sensitive to humidity, and don't like the feeling of being wet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "So, if they notice a sudden increase in the humidity, they'll start nervously pawing their faces and licking their fur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Once a cat does something like that, it's a sign that a large rainstorm is likely on its way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "Whoa, Paimon had no idea, that's so cool! Guess we just learned something amazing by accident!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#In that case, {NICKNAME}, let's pay more attention to cats during our travels! That way, we won't... keep getting soaked by huge downpours from those big black clouds!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "I suppose we'll have to pay more attention going forward.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "I originally came here to ask Valerina about something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "But just as I was talking to her, this little kitty snuggled up close to me and yawned so loudly! It was just too cute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Since she was so affectionate towards me, then... Well, then I need to show how friendly I am, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "That's when I remembered what Lisa told me, so I went ahead and asked Bunny about the weather.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "But she responded by rubbing her face, then wagging her tail, then lying on the ground snuggling against my hand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "*sigh* So is it actually going to rain or not over the next few days...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "Since when haven't I paid close attention to cute kitties?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "The defense of the cats of Mondstadt is one of my many responsibilities.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "Hold on, I'm a bit lost.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}