					"Ms. Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310501,
					"content": "Great, that should be just enough. Ah yes, I'll also need you to help me go to Pops Kai and tell him to bring all the chairs and tables over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310502
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 413310502,
					"content": "I plan on making lots of dishes, so if we wait too long to set up the tables, I'm afraid that the food might start getting cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ms. Bai"
				}
			]
		},
		{
