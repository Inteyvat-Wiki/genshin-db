			"dialogs": [
				{
					"id": 413310601,
					"content": "Oh? Are you looking for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310602
					],
					"speakerTitle": "Pops Kai"
				},
				{
					"id": 413310602,
					"content": "We'll be needing the tables and chairs soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310603
					]
				},
				{
					"id": 413310603,
					"content": "Ah yes, the tables and chairs... I remember now. I've already prepared everything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310604
					],
					"speakerTitle": "Pops Kai"
				},
				{
					"id": 413310604,
					"content": "Ah, but there should still be some more inside the shop. Alrighty, let's just bring them all out then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310605
					],
					"speakerTitle": "Pops Kai"
				},
				{
					"id": 413310605,
					"content": "That should be enough tables and chairs for everybody.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310606
					],
					"speakerTitle": "Pops Kai"
				},
				{
					"id": 413310606,
					"content": "I never expected that you'd come all the way here to help me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
