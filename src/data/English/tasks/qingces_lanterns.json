			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Granny Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "*sigh* The Lantern Rite is here once again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310202,
					"content": "Is there something on your mind, Granny Ruoxin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "Things should be festive and lively during the Lantern Rite, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310204,
					"content": "But in Qingce Village, the elderly are too old and the young are too young.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310205,
					"content": "All those young workers that have since flocked to the big city are either too busy and can't get time off work to celebrate the festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310206,
					"content": "Or they're too far away to make it back home in time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310207,
					"content": "Lantern Rite is a lively festival, it's a time when everyone should gather together to celebrate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310208,
					"content": "Sure, I understand that it mustn't be easy for them either, but... *sigh* What about all the festivities?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310209,
					"content": "Ugh, there's no use in complaining. That's no way to celebrate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310210,
					"content": "If you'd be so kind, I'm sure Ms. Bai could use a hand right about now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310211,
					"content": "The young lady said that she wanted to prepare a table full of food for everyone and is already hard at work on the preparations. I'm afraid that she won't be able to manage on her own...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310212,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "Oh, thank you. You're too kind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413310213,
					"content": "Don't worry, I'll go lend her a hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
		{
			"id": 4133103,
