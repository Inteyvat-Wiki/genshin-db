				},
				{
					"id": 413313709,
					"content": "Won't you be joining them, Granny Ruoxin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "Oh, me? I'm in no hurry. Besides, I'd like to watch the Xiao Lanterns awhile longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413313711,
					"content": "Which reminds me, these are for you, dear. It's my way of saying thank you for helping prepare all the festivities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413313712,
					"content": "Thank you, Granny Ruoxin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "You're most welcome. From the looks of it, you must still be quite young. I imagine that all this running around must have left you quite tuckered out indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413313714,
					"content": "Why don't you stay with us for a while and join the festivities?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413313715,
					"content": "It's good to have a rest after rushing about all year long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Ruoxin"
				}
			]
