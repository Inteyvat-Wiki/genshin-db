			"dialogs": [
				{
					"id": 413311001,
					"content": "Ah, you're back. Sorry for making you do so much work on a festive day like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311002
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413311002,
					"content": "I'm glad I could help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413311003
					]
				},
				{
					"id": 413311003,
					"content": "Thank you, you're too kind. I've also been doing my part and managed to make quite a few Xiao Lanterns for the people of Qingce Village.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311004
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413311004,
					"content": "If you'd like, you can find me near the gate later this evening. We'll release the Xiao Lanterns and celebrate the festival together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311005
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413311005,
					"content": "But who knows where the children have run off to... There's no way I could go and find them with these old legs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311006
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413311006,
					"content": "Could I trouble you to round them up for me? They've always loved releasing the Xiao Lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413311007
					],
					"speakerTitle": "Granny Ruoxin"
				},
				{
					"id": 413311007,
					"content": "And be sure to tell anyone else you find along the way to head back to the village... The more the merrier, you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Granny Ruoxin"
				}
			]
		},
