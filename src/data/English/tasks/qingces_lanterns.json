					"nextDialogs": [
						413312003
					]
				},
				{
					"id": 413312003,
					"content": "We get to release the Xiao Lanterns tonight? Awesome! Lemme go tell my big brother!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312004
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 413312004,
					"content": "I heard grandpa say that we get to make a wish when we release the lanterns. Is that true?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312005
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 413312005,
					"content": "I have a big wish that I've been thinking about for a long time now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312006
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 413312006,
					"content": "Oh really? What's your wish?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413312007
					]
				},
				{
					"id": 413312007,
					"content": "It's that I... Ah wait, I shouldn't tell you... Grandpa says that if we tell others our wishes, they'll never come true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312008
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 413312008,
					"content": "Just wait till I tell my big brother, I'm sure he'll have a wish too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413312009
					],
					"speakerTitle": "Little You"
				},
				{
					"id": 413312009,
					"content": "Oh wait, it seems we have to write our wish on a lantern... So I guess just thinking about it won't be enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little You"
				}
			]
