				"objectNames": [
					"Ms. Bai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310301,
					"content": "Seems we still need quite a few more ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310302
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 413310302,
					"content": "Let me lend you a hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "Huh? Oh, are you willing to help? You've come right on time! I was just starting to worry that we wouldn't manage to get all the ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 413310304,
					"content": "Let me see here... If you could, please help me get three chunks of Raw Meat and three pieces of Fowl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "Ms. Bai"
				},
				{
					"id": 413310305,
					"content": "In the meantime, I'll think of a way to procure the other ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ms. Bai"
				}
			]
		},
