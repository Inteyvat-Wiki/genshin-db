			"trigger": {
				"objectNames": [
					"Effendi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730101,
					"content": "Greetings, welcome to the Citadel of Regzar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730102
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730102,
					"content": "This is where the Corps of Thirty get in touch with each other and coordinate. I can see from your outfit that you are not one of them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730103
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730103,
					"content": "Oh, I see, you came for the recruitment, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730106,
						736730104
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730106,
					"content": "That's right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730107
					]
				},
				{
					"id": 736730107,
					"content": "Very well then. I'll brief you on the gig in case it's not clear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730108,
					"content": "I am Effendi, a liaison sent by the Akademiya to coordinate the cooperation between the Akademiya and the Corps of Thirty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730109
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730109,
					"content": "You may have known that the Corps of Thirty is hired by the Akademiya to guard the whole Sumeru City.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730110
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730110,
					"content": "They are additionally responsible for dealing with some problems residents encounter in daily life, which compounds their workload.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730111
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730111,
					"content": "To ease the pressure, I decided to recruit an assistant after consulting with the Parchamdar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730112
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730112,
					"content": "You don't need to worry about city defense, just help us complete the residents' commissions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730113
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730113,
					"content": "As to the specifics, most of them are cumbersome and detailed. I'll elaborate with examples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730104,
					"content": "Recruitment?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730105
					]
				},
				{
					"id": 736730105,
					"content": "You came without having a look at it? Never mind, I'll explain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "Effendi"
				}
			]
		},
		{
			"id": 7367302,
			"completionStepIds": [
				7367302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367302",
							"2"
						],
						"stepId": 7367302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Effendi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730201,
					"content": "That's the commission in general. It'd be great if you're willing and free to take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730202
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730202,
					"content": "The logistics officer and I have agreed that you will be paid fairly for every gig you do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730203
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730203,
					"content": "Trivial as these commissions may be, I do hope you recognize the importance of this job.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730204
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730204,
					"content": "You will be appreciated and respected by all who you have helped with their life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730205
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730205,
					"content": "If you stick to it, you'll surely heighten your Reputation among the residents, and they'll be more willing to accept you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730206
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730206,
					"content": "And I'll offer you more important and complicated jobs by then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730207
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730207,
					"content": "That's the general picture of this job. I hope you can think it over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730208
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730208,
					"content": "If you decide to take the job, feel free to register for the commissions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effendi"
				}
			]
		}
	]
}