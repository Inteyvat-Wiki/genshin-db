			"dialogs": [
				{
					"id": 722030501,
					"content": "Haha, you found me again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "Y'know, I'll miss you, but... I came this time to say goodbye. The golden man says we've gotta go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "But don't worry about me! Where I'm going, there's tons of people to play with! I wish you could come too, but the golden man says that it's not time yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "It's totally fine, though! Totally! I'll just wait for you there... and if I can't wait, I'll turn into little bits of light and look for you in your dreams!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "Have a good trip, now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Yeah, I will! It was fun playing with you. Thanks a bunch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030507,
					"content": "I won't be alone anymore, this is great...",
