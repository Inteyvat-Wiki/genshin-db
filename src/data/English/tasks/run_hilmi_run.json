			"dialogs": [
				{
					"id": 230390401,
					"content": "*huff* I—I won!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390402,
						230390403
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390402,
					"content": "C—Congratulations...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390404
					]
				},
				{
					"id": 230390404,
					"content": "Hehe, I told you how good I am! You underestimated me, didn't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390405
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390405,
					"content": "But even if we can run this fast, we can't outrun Habachi. I just don't understand why.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390406,
						230390407
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390406,
					"content": "There might be a shortcut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390408,
					"content": "Is that so? But I don't think there's any shortcut around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390409
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390409,
					"content": "#{F#Miss}{M#Mister}, can you play with us next time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390410
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390410,
					"content": "I mean... train with us! Um... Let's train that \"tracking in the wilderness\" thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390411
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390411,
					"content": "You're right! Since we can't outrun Habachi, we can get around him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390412
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390412,
					"content": "We tried that before, didn't we? But it never worked...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390407,
					"content": "He might be playing some trick.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390403,
					"content": "You were... almost flying...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390404
					]
				}
			]
		},
