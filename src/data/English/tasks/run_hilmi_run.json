			"dialogs": [
				{
					"id": 230390501,
					"content": "Huff... You ran so fast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390502,
						230390503
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390502,
					"content": "Because I—I'm an adventurer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390504
					]
				},
				{
					"id": 230390504,
					"content": "We aren't fast enough. Habachi can definitely catch us... What do we do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390505
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390505,
					"content": "Besides, he's not even out of breath each time he catches us. He doesn't even look like he was running.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390506,
						230390507
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390506,
					"content": "There might be a shortcut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390508
					]
				},
				{
					"id": 230390508,
					"content": "Is that so? But I don't think there's any shortcut around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390509
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390509,
					"content": "#{F#Miss}{M#Mister}, can you play with us next time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390510
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390510,
					"content": "I mean... train with us! Um... Let's train that \"tracking in the wilderness\" thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390511
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390511,
					"content": "You're right! Since we can't outrun Habachi, we can get around him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390512
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390512,
					"content": "We tried that before, didn't we? But it never worked...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390507,
					"content": "He might be playing some trick.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390508
					]
				},
				{
					"id": 230390503,
					"content": "Because I've run many, many times.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390504
					]
				}
			]
		}
