			"dialogs": [
				{
					"id": 722430102,
					"content": "I've got some treasure I want to sell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "You want to sell treasure? That's quite a surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430104,
					"content": "I imagine that an adventurer as skilled as you must have some truly rare goods to sell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430105,
					"content": "Let me have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430106,
					"content": "You tell Marjorie about the Dragonbone Orb.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "Huh, isn't this what the bards called the \"Fretnaught Fruit\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430108,
					"content": "To think that it really exists... So its real name is the Dragonbone Orb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430109,
					"content": "If its effects are as you say, I'd be willing to pay 80,000 Mora and some specialty dishes for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430110,
					"content": "Hmm... How does 80,000 Mora and 5 Moon Pies sound to you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430111,
					"content": "...What will you use it for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "Hehe. I mean, it's such a unique treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430113,
					"content": "Why, it has abilities straight out of a fairy tale! I doubt those alchemists would be loath to part with their Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430114,
					"content": "A fair price. Done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "I'll take this, then. Thanks for your patronage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430116,
					"content": "Ah yes. Such beads formed from condensation tend to evaporate slowly in the wind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430117,
					"content": "As such, it might be best to cover it with a diaphragm or place it within a sealed container to ensure its quality.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430118,
					"content": "I'll give you this tip free of charge. Hopefully, it'll be of some use to you in your adventures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430119,
					"content": "If you encounter such treasures in the future, always remember that you'll have a loyal buyer in me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430120,
					"content": "Let me think about it a bit more.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "Sure, no problem. Nonetheless, I have confidence in my estimation of this item's value.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430122,
					"content": "You can come to me again once you've mulled the matter over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
