					]
				},
				{
					"id": 223070903,
					"content": "Nice one! I said you looked like a real adventurer, didn't I? Well, now you've proven it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070904
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070904,
					"content": "Right, let's see what we have in this box... What's this? Map fragments?",
