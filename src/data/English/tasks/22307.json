				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070201,
					"content": "Hello there, my friend! What can I get you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070202,
					"content": "Treasure Maps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070203
					]
				},
				{
					"id": 223070203,
					"content": "Treasure Maps? Oh, you must mean Zhang Shun's maps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070204,
					"content": "So, you're really going to look for this treasure, eh? I must say, I only ever saw them as a bit of fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070205,
					"content": "You, though, I can tell with one look that you're the real adventurer type. The sort whose eyes light up as soon as someone mentions the word \"treasure.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070206,
					"content": "I don't have much use for these Treasure Maps at the end of the day, so you might as well have them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070207,
					"content": "That said, if you do find any treasure, let's split it evenly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070208,
					"content": "After all, I have been looking after these maps for a while. It's only fair to contribute something in the way of storage fees...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 2230703,
