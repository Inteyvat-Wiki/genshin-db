			"dialogs": [
				{
					"id": 223070301,
					"content": "Yes please.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070302
					]
				},
				{
					"id": 223070302,
					"content": "Alright... There you go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070303,
					"content": "Have a good one. And don't forget to bring the treasure back here when you find it — we split it three ways, as agreed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
