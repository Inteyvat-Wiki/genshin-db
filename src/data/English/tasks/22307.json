					"nextDialogs": [
						223070603
					]
				},
				{
					"id": 223070603,
					"content": "Nice one! I said you looked like a real adventurer, didn't I? Well, now you've proven it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070604
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070604,
					"content": "Right, let's see what we have in this box... Hmph. What a pile of junk...",
					"roleType": "TALK_ROLE_NPC",
