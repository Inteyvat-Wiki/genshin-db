				"points": []
			},
			"dialogs": [
				{
					"id": 223030301,
					"content": "I will experiment a bit to start with, and see if I can add Dandelions in to a Liyue-style brewing process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Oh, and this is for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "I'm not expecting to get this right the first time. It will probably take me many attempts. If I run out of Dandelions, I may have to ask you to do another run for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
