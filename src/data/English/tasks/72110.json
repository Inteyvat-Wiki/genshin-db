	"talks": [
		{
			"id": 7211001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Mitsunari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "Why did I leave the dojo to become Lord Kujou's instructor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100102,
					"content": "Yanagiha and Okazaki, as well as Mifune... why did they all leave me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Mitsunari"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "...now, the blade of Iwakura Kouin is the only thing we're missing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "The ancestral \"Hakuen Michimitsu Amenoma\" of the Iwakura Clan, huh... Say, do you remember, when you and Kunihiko were first adopted, while Master Eiin wasn't looking...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "We have already been expelled. There's no need to call him \"Master.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "But Okazaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "\"When you weigh affection against righteousness on a scale, a real swordsman must walk the path of righteousness.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Since Master said so, it means he was not willing to expel us, but had no other choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "Of course he was unwilling. But since he has already decided to become the sword of the Shogun and carry out the Vision Hunt Decree, then we can only...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "We can only choose our own righteous path. After all, \"a real swordsman must walk the path of righteousness.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "And yet, Master's own righteousness was defeated in the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "That's right. We must avenge them all. Kunihiko, the others — even Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Such is the righteousness of expelled disciples like ourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "This must also be Master's blessing. Our first object of vengeance came to us, just like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#You are right. You must be {NICKNAME}. I've heard about your story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "In the world of swordsmen, only blood can cleanse blood. I assume you are prepared to face the Ex-Iwakura Art Menkyo Kaiden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Mitsunari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "Why did I leave the dojo to become Lord Kujou's instructor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100302,
					"content": "Yanagiha and Okazaki, as well as Mifune... why did they all leave me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100303,
					"content": "I've encountered the disciples of the Iwakura Art.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "Is that so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100305,
					"content": "Are there still people who claim to be from Iwakura? Their Master was such an incompetent soul, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100306,
					"content": "I am Iwakura Mitsunari. You could consider me a sword instructor here. And who might you be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100307,
					"content": "#I'm {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tanba... did you see them? The Okazaki brothers, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100309,
					"content": "Ah, yes, there's also Katayama. He always loved coming up with names for duels before they started.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100310,
					"content": "He'd say, \"If I become a real master swordsman in the future, then all these duels can written into stories.\" Hahaha, such nonsense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100311,
					"content": "Right, and we mustn't forget Shimada, who spent the entire \"Eiin\" and \"Kouin\" eras training, yet could never advance beyond the rank of Shoden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100312,
					"content": "They fled and became bandits because they could not fathom the power of the Almighty Shogun's Vision Hunt Decree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100313,
					"content": "I miss the good old days of teaching them how to wield a sword. Why in the world did I shut the dojo down and join the army?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, how're their abilities?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100315,
					"content": "I'm sorry to say this, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "Really...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100318,
					"content": "#Then, {NICKNAME}, who is your master? Is it Domon? Or Shousen? Or perhaps Narukami herself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100319,
					"content": "I think I might be considered \"self-taught.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100321,
					"content": "It seems like the Iwakura Art has waned under my watch. None of my students were able to defeat a self-learned swordsman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "Is that so? I understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100324,
					"content": "Whatever your school of swordsmanship is, it doesn't matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100325,
					"content": "It seems like the Iwakura Art has waned under my watch. None of my students were able to defeat someone who is unwilling to reveal the name of their school.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100326,
					"content": "I truly am an incompetent Master of the Iwakura Art. As a swordsman, they call me Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100327,
					"content": "Although I have forgotten the key to our secret blade technique and my Vision was surrendered to the Almighty Shogun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100328,
					"content": "...If you asked me if I still wish to avenge those disciples of mine who could not bear to see my degradation and wound up pursuing the path of wicked ghosts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100329,
					"content": "...Yet who were incompetent and lost to you, then I do still have some of that fire within me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100330,
					"content": "This space is too small. It would be no place for even you to show off your swordsmanship. Come, follow me down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100316,
					"content": "I learned quite a bit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				}
			]
		}
	]
}