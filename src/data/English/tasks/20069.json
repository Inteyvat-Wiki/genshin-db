				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "These flowers aren't looking so good, either. What a shame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "Something the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Well, lots of people tend to buy single flowers to give as gifts, so I usually cut some flowers specifically for that purpose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "But the flowers I trim don't stay fresh for long. If they don't sell out, they'll wilt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "I've tried many methods in the past, but the flowers degrade by the end of the day all the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "I wonder if there's any way to preserve those flowers for longer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Preservation, you say...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "I've heard Sara from Good Hunter say that they put unused ingredients in a cool place, or preserve them using blocks of ice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "I've tried these methods too, but flowers stored using ice blocks always end up looking weird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "They won't have withered, but I wouldn't call them fresh either... and either way, they wouldn't be presentable anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "I asked a lot of people, and Mr. Sayid... You know who he is, right? He's that researcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "One day, when he came to buy flowers, he told me that he once read about putting flowers in cold storage in a book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "Specifically... it involves using a container to store the flowers before placing that container near blocks of ice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "He also mentioned that if I wanted to do some experiments, the most suitable place would be the low-temperature environment on Dragonspine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "But I've heard that Dragonspine's a very dangerous place, and I couldn't find any adventurers willing to help me on such short notice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "Traveler, could you help me bury these three flower containers in the Dragonspine snow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Consider it done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Thanks for your help. Let me think... I've heard that Dragonspine is huge, and has a lot of different regions, which could lead to very different results...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Perhaps a comparison might be in order...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "Please help me place these flowers <color=#00E1FFFF>beside the Statue of The Seven</color>, <color=#00E1FFFF>beside the water</color>, and... <color=#00E1FFFF>at a cavern entrance</color>, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "Where should I bury them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "Best to sell them all on the day itself, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "That would be best. But there are always one or two flowers that don't get sold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "I know it's only one or two, but I don't want to just let them wither away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
