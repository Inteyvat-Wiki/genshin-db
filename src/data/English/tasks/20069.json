				{
					"id": 200690201,
					"content": "How are the flowers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690202,
					"content": "Snugly underground.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "Thank you. We'll leave them there on the mountain for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690204,
					"content": "Hehe, thanks so much for helping me out. Please, take these for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "Flora"
				}
			]
		},
