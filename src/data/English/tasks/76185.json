			"dialogs": [
				{
					"id": 761850201,
					"content": "Tea tastes so much better when paired with useful intel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850204,
					"content": "Oh, take care. And remember to drop by whenever you're free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Marionette"
				}
			]
