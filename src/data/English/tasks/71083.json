					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "What? You seriously broke the Seven-Star Array? Ugh, looks like I'll have to write this into the weekly report...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Make sure you make it sound cool, alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "*cough* Please, this is a very serious situation. It's so serious, in fact, that the Qixing themselves will decide its exact seriousness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "Which is to say that once report gets sent up, someone from the Qixing might personally come down here to stop you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "Even I won't be able to save you then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "(This guy is way too obvious with his hints...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "Scared, huh? Alright, move along, then! There's still someone waiting for you, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
