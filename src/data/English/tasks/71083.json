				"points": []
			},
			"dialogs": [
				{
					"id": 710830201,
					"content": "How is everything down there? Did you encounter any danger?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830202,
					"content": "(You describe your experiences to Muning.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "Ah, I see. That does sound rather dangerous. I'm afraid I'll have to ask you to help take care of Jinwu and Zhiqiong, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830204,
					"content": "Aren't you supposed to stop me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "Well, that is my duty, yes. But you always run off too quickly for me to stop you, so I can't.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830206,
					"content": "I don't run that fast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "No, you do. That's what the report says, and what the report says is the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830208,
					"content": "Alright, guess I'm really, really fast, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "Exactly. As such, please do be careful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830210,
					"content": "All goes well, don't you fret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "That's good, that's good. As long as things go well, the Qixing will have no reason to come down too hard on me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		}
	]
