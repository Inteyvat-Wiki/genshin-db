			"dialogs": [
				{
					"id": 105010301,
					"content": "There's no need to spend all that effort on me, I'm not in dire need of food...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010302,
					"content": "I am a little hungry... but it's not a big deal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1050104,
			"completionStepIds": [
				1050107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050107",
							"2"
						],
						"stepId": 1050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010401,
					"content": "Phew. That was tiring, but we're finally in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010402,
					"content": "The quest to plumb the wondrous depths of knowledge is indeed arduous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010403,
					"content": "Paimon's not tired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010404,
					"content": "Ugh, that's because you float.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010405,
					"content": "Well, it doesn't look like an astrologist is all that amazing either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010406,
					"content": "That's because you have too many unrealistic fantasies about astrology.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010407,
					"content": "Are you also resting your feet here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010408,
					"content": "Who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010409,
					"content": "Oh, my brothers and I are all merchants. We just finished doing business in Liyue, and we're preparing to head back to Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010410,
					"content": "You look rather tired. The cart we hired will be coming in a while — what say you to coming along for the ride?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010411,
					"content": "Well, I am a little tired...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "Do I need to pay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "Haha, let's go, then. We can make conversation along the way, the more the merrier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010414,
					"content": "No need, no need, we're already heading that way anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010415,
					"content": "There's no need. Now shoo. Get out of our way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010416,
					"content": "Eh? Miss... Is there something wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010417,
					"content": "Cease your pretensions, bandit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010418,
					"content": "Picking up people on the road who appear vulnerable, robbing them blind once they've gotten on the cart, and then taking them to some archon-forsaken place — is that your deal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010419,
					"content": "Wh—What are you saying? We came over here to make conversation, and this is how we're rewarded? With insults?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010420,
					"content": "If you don't want to get on, don't! Crazy girl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010421,
					"content": "Well then, shall I tell you now which objects you have on you that are stolen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010422,
					"content": "If you have any quibbles, we can bring people to corroborate what I've said, and all will come to light.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010423,
					"content": "If I lose, I'll pay you twenty thousand Mora. But if I win, then you'll be eating prison rations in Liyue Harbor tonight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010424,
					"content": "How about it? If you're real legitimate businessmen, there's nothing to fear, is there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010425,
					"content": "You... You!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010426,
					"content": "You've pushed it too far, brat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010427,
					"content": "I don't know how you found out, but as long as we get rid of you, no one will have to know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010428,
					"content": "Careful, Mona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "You will not touch her!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "Don't fret, it's just a few bandits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010431
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010431,
					"content": "You said earlier that there was nothing amazing about astrologists... Well then, this is a good time to show you what your master can do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
