					"nextDialogs": [
						105011513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011513,
					"content": "Ah, it's nothing. Nothing at all. Now that we've eaten and drank our fill, we should be off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011514,
					"content": "If we travel north from here, we should reach the <color=#00E1FFFF>Stone Gate</color>, and from there, we will be within the boundaries of Mondstadt.",
