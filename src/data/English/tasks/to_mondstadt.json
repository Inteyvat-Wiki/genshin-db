				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010501,
					"content": "Hmph, what did you think? Did that satisfy your expectations?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010502,
					"content": "Your combat abilities were amazing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "Such things are elementary for an astrologist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010505,
					"content": "Lies are worthless before astrology. Destiny and truth are written in the stars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010506,
					"content": "Though it may take more time to garner the specifics, I can read the gist of a situation at a glance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010507,
					"content": "But you did hit some bumps in the road...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010508,
					"content": "That's because Teyvat's stars can only display the fates and truths of \"this world.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010509,
					"content": "Anything related to you becomes like a fog that even I cannot penetrate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010510,
					"content": "That is why I must meet that successor. With our knowledge combined, I might be able to gain new insight into your fate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010511,
					"content": "I'm a little excited.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "Ha. Whatever the case, you've got everything to gain from this trip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010514,
					"content": "Alright, I'm rested. Let's get this journey to <color=#00E1FFFF>Mondstadt</color> over with!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010515,
					"content": "*sigh* If only we had a cart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010516,
					"content": "I thought you weren't tired!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010512,
					"content": "I'm not getting my hopes up...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "It's impressive that you saw through those bandits.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
		},
