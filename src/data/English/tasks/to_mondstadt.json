			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "Hello, how may I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010202,
					"content": "We'd like to borrow the kitchen here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010203,
					"content": "A friend of mine would like to eat a special dish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "Ah, I see. In that case, sure. As long as you've prepared your own ingredients, feel free to use the kitchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010206,
					"content": "If I may... You must be well-versed in the art of cooking, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010207,
					"content": "Of course. If I make it, it's delicious!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "Haha, talented indeed. Actually, I have a small suggestion to make...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010211,
					"content": "From your clothes, you're most likely not from around these parts. But since you've come to Liyue, would you like to try making Liyue-style cuisine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010212,
					"content": "I have a recipe for Golden Crab with me. It's a Yue cuisine classic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010213,
					"content": "It's crab meat that's been rolled in flour, deep-fried, and then pan-fried together with ginger and garlic. When you finally plate it up, the crab seems to be lying on gold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010214,
					"content": "Golden... Crab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010215,
					"content": "That sounds a little complicated.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#Golden Crab, {NICKNAME}! Golden Crab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010218,
					"content": "I got it, I got it. Golden Crab.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "Heh-heh. Then let's get to it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010221,
					"content": "With your skills in the kitchen, this'll be a cinch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010219,
					"content": "...I guess I'm learning it for your sake, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "Learning a whole new dish for Mona's sake is a bit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "Not really...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "Haha, how humble of you. Actually, I have a little suggestion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010204,
					"content": "My friend would like to eat something made by me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
		{
			"id": 1050103,
