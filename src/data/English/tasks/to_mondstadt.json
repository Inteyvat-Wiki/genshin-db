					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011506,
					"content": "Fine. Since my disciple has put in so much time and effort, I must — with great difficulty — accept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011507,
					"content": "...Aah! It's delicious! It's the most delicious thing I've eaten recently!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011508,
					"content": "Ah, uh, I mean... *cough* I never knew that my disciple was this skilled. As your master, I am most comforted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011509,
						105011510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011509,
					"content": "As long as you're eating a full meal.",
