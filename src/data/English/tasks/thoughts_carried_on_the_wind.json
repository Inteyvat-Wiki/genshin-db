			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "I wonder how Glory is getting on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350102,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "Ah, it's you, Traveler. It's dangerous out here right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350104,
					"content": "If you'd like to seek shelter somewhere safe, you should return to Mondstadt as soon as you can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350105,
					"content": "You're not heading back?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "Well, I... I'm staying out here for now. I am a Knight of Favonius, after all — I cannot abandon my post at a moment like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350107,
					"content": "I can't return to Mondstadt for various reasons, but I can still stay here and help out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350108,
					"content": "After the meteorites fell down, many monsters came under their influence, becoming exceedingly aggressive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350109,
					"content": "If left unchecked, they will definitely make huge trouble for us later. I was just getting ready to wipe them out, in fact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350110,
					"content": "Can you do it by yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "Uh, so they do have great numbers... But as long as I'm careful, I should be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350112,
					"content": "But if I were to go alone, who knows how long it would take to defeat them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350113,
					"content": "If you don't mind, Traveler, could you help me clear their camp out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350114,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "Thank you, that would be a great help to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350116,
					"content": "Why not ask the Knights for help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "Ask the Knights for— Well... Suffice it to say that I have my own private troubles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350118,
					"content": "Please lend me a hand in destroying that monster camp. You may consider it as a favor done for the Knights as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113502,
