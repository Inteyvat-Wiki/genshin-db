			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350201,
					"content": "Where in the world is the Grand Master... I wonder if he's received any word that something like this has happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350202,
					"content": "*sigh* But even if he received the news, he wouldn't be able to return so soon, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113503,
			"completionStepIds": [
				4113505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113505",
							"2"
						],
						"stepId": 4113505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "Have you managed to wipe all the monsters out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350302,
					"content": "All clear.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "You have my thanks, Traveler. They should cease to be a threat for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350304,
					"content": "You should head back to the city. I'm very sorry for asking you to risk yourself out in the wild while all this is happening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350305,
					"content": "When you're back in the city... could you help me take note of something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350306,
					"content": "I—It's a very simple matter! You just need to help me look out for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350307,
					"content": "What might that be?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "Well... When you're back in the city, can you help me see how Glory is doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350309,
					"content": "She should still be safe in the city, but I can't help but worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350310,
					"content": "So could you check in on her for me, please?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350311,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "Thank you, Traveler. Oh, yes — could you also refrain from telling her that I'm here? Just... just tell her that I'm still on a mission in a faraway land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350313,
					"content": "I'm sorry, but I'm counting on you — you must tell her this. Again, my apologies, but I cannot share our private troubles with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
		{
			"id": 4113504,
			"completionStepIds": [
				4113506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
