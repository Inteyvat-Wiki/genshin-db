				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "I do hope Godwin is alright...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350402,
					"content": "Hey there. Godwin's asked me to check in on you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "Godwin? D—Do you know where he is? I haven't heard from him in a good long while, and I've been worried.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350404,
					"content": "He's still on a mission in a faraway land.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "Oh... I see. Alright then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350406,
					"content": "If not for these meteorites, I would have asked after his whereabouts with the Knights...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350407,
					"content": "I've been staying inside the city, so I've been safe so far. But he's probably still out there accomplishing his mission. If this phenomenon is occurring all over the world...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350408,
					"content": "*sigh* I hope that he's alright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350409,
					"content": "He will be.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "Thank you. That would be wonderful. Oh, yes. Could you help me with something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350411,
					"content": "I purchased a set of Dandelion Seeds from Flora, and I was looking for someone to help me scatter them from a high vantage point... to let the wind carry them to Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350412,
					"content": "But things being as they are, I don't think I'll be able to find someone who can help me at the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350413,
					"content": "Since you're here, could you help me bring these Dandelion Seeds to Godwin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350414,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "Thank you. He must be in a very faraway place right now. He did set out on that expedition with the Grand Master, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350416,
					"content": "Please take these Dandelion Seeds to him and tell him that I'm doing well. And then... remind him to take good care of himself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 4113505,
			"completionStepIds": [
				4113507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
