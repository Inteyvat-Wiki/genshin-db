				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350501,
					"content": "Traveler, did you meet Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350502,
					"content": "How is she? Is she well? Was she injured? Is she— Well, yes, I know that she's been in the city this entire time, but still—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350503
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350503,
					"content": "She sent you some Dandelion Seeds.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350504
					]
				},
				{
					"id": 411350504,
					"content": "Dandelion Seeds... That's just like her. *sigh* I hope she's not angry with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350505
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350505,
					"content": "Thank you for helping me this time as well. Please, take these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350506,
					"content": "*sigh* If only the Grand Master could return right now — this problem would be solved in no time at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
