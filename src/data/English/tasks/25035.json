			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Those bumbling fools... How've they lost another load of packages? I told them not to mess about when they're out delivering things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350102,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "A few of our Couriers ignored instructions yet again, and guess what? They've gone and lost a bunch of packages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350104,
					"content": "*sigh* Don't they realize that such carelessness damages the reputation of the Scions of the Canopy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350105,
					"content": "When you're out on the job, focus on delivering things! If you're going down a slope, just keep going as you normally would. Why would you suddenly drop into a slide like you're on vacation!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350106,
					"content": "I've told them so many times, but those youngsters just won't listen. All they care about is chasing cheap thrills...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350107,
					"content": "*sigh* Now I'll have to get someone to retrieve those packages. Let me think, who's free right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350108,
					"content": "I'll lend a hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "Y—You'd really help me out? That's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350110,
					"content": "It would take me quite a while to find someone who could help, and if I went looking myself, there'd be no one here to watch over the Courier's Longhouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350117,
					"content": "And don't worry, I wouldn't just leave you to find a needle in a haystack. I know the routes those kids usually take, so I can probably guess where those packages went missing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350118,
					"content": "I'll mark out those probable locations. Thanks in advance. I'm counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350111,
					"content": "Are those packages big?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "No, they're not. But that's what makes them a real hassle to find. *sigh* Those careless little...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350113,
					"content": "...So, if you have the time, would you be willing to help me track them down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350114,
					"content": "The Courier's Longhouse is a bit short on manpower right now, so if I went to find them myself, there'd be no one here to man the store.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350115,
					"content": "No problem, leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "That's amazing! Thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				}
			]
		},
