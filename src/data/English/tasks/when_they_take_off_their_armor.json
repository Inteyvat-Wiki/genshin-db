						"rawParams": [
							"7050402",
							"2"
						],
						"stepId": 7050402,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050403",
							"2"
						],
						"stepId": 7050403,
						"stateName": "QUEST_STATE_UNFINISHED"
