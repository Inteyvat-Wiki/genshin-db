				"points": []
			},
			"dialogs": [
				{
					"id": 400000201,
					"content": "Hello! Would you like to play a round of Theater Mechanicus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000202,
					"content": "Theater Mechanicus? What's that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Oh, never heard of it? Allow me to introduce it to you then. Theater Mechanicus is a kind of tabletop game invented by yours truly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000204,
					"content": "Do you see these things laid out on the table here? These are all important items used in Theater Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000205,
					"content": "Looks pretty complicated...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "It may seem complicated, but you'll get the hang of it after you play a couple of times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000207,
					"content": "So, how about it? Would you like to give it a try?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000208,
					"content": "Uh, well how much does it cost to play?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "No, not at all. It is the Lantern Rite, after all. Besides, I was hoping to collect everyone's initial impressions of the game.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000211,
					"content": "So all it'll cost you to play is a single Xiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000212,
					"content": "If you'd like to try, just bring me a Xiao Lantern and you'll be good to go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000213,
					"content": "C'mon, give it a try! I'll even let you play the first round for free and you can keep your Xiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000209,
					"content": "It must be pretty expensive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
