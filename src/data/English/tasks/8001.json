				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "So we meet again... a little sooner than I had expected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010102,
					"content": "Hey, it's Dain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010103,
					"content": "Judging by your expression, it seems you just experienced something quite strange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010104,
					"content": "Could it be that you encountered an Abyss Herald in those ruins?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010105,
					"content": "Huh!? How did you know that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010106,
					"content": "I've been on the Abyss Herald's trail. I didn't expect to find you here as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010107,
					"content": "Actually, the Abyss Herald wasn't all we encountered...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "An inverted Statue of The Seven... holding Abyssal power in its hands? No, I have never seen such a thing during my time fighting the Abyss... though I have had my suspicions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010110,
					"content": "Tell me the rest of what happened in there. So you escaped the ruin depths filled with Abyssal power, and then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010111,
					"content": "And then, as we got close to the exit, an Abyss Herald suddenly appeared and blocked our way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010112,
					"content": "We fought a big battle with that thing. Maybe it hasn't gotten too far yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010113,
					"content": "Yes, this is a rare opportunity indeed. Come, let's catch up to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010114,
					"content": "Yes, sir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "Let's go! A rare opportunity! With Dain helping out, maybe we'll be able to solve more mysteries about the Abyss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010115,
					"content": "Wait, I thought I was the one who commissioned you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "There was something even stranger than the Abyss Herald in the ruins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800103",
							"2"
						],
						"stepId": 800103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "Those Abyss Mages just now... were they trying to ambush us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010202,
					"content": "No, they were just digging through these abandoned Ruin Guards looking for something of value.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010203,
					"content": "Oh, is that so... The Traveler here seems to like doing that a lot, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010204,
					"content": "Looking for Chaos Devices, Chaos Circuits... You know, that kinda stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010205,
					"content": "Yep, those are important materials!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "They wouldn't be searching for such ordinary objects.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010208,
					"content": "In fact, I was nearby investigating precisely because Abyss Mages often come out from that ruin to explore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010209,
					"content": "They seem to be searching the remains of Ruin Guards for a certain valuable object to take back to the ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010210,
					"content": "However, they look disappointed, so it would seem they haven't found it yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010211,
					"content": "Well then, why didn't you grab one of them just now and ask what they were up to?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010212,
					"content": "Yeah, Master Diluc's done that before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "I certainly don't mean to be merciful towards these monsters of the Abyss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010215,
					"content": "But I have a feeling that their plan with this object is of major importance to the entire Abyss Order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010216,
					"content": "One cannot discover the truth behind it through interrogation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010217,
					"content": "Or rather, these Abyss Mages likely fear something else much more than they do a painful interrogation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010218,
					"content": "Fear...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "Uhh... Paimon is getting goosebumps thinking about all this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010221,
					"content": "Alright, we shouldn't waste too much time here. Let's continue our search.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010219,
					"content": "Something related to what we saw in the ruins?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "You should be rougher with them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "Abyss Mages probably weren't looking for stuff like that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800105",
							"2"
						],
						"stepId": 800105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "Wow... Besides the Abyss Order, Ruin Guards sure are active around here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010302,
					"content": "Seems wherever we find an Abyss Mage hideout, there's often a bunch of Ruin Guards roaming around too. Is that just a coincidence, or...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010303,
					"content": "There are no coincidences in the world. Everything is the fruit of seeds planted long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010304,
					"content": "Just like your appearance in that tavern... Time is just waiting for those seeds to sprout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010305,
					"content": "But I only heard about you by chance...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "Forget it. Just some needless musings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010308,
					"content": "The connection between the Abyss Order and the Ruin Guards is by no means incidental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010309,
					"content": "Rather, they are both branches that have grown out and up from the same roots below.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010310,
					"content": "\"Branches\"? \"Roots\"? What do you mean exactly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010311,
					"content": "Both originate from an ancient nation that was destroyed 500 years ago — Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010312,
					"content": "Huh? Khaenri'ah!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010313,
					"content": "Really!? The Abyss Order and Ruin Guards are left over from after the destruction of that nation!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010314,
					"content": "Oh... Speaking of Khaenri'ah, that's really a super ancient name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010315,
					"content": "Oh, right. As your guide, Paimon should explain a bit here. A long time ago, the nation of Khaenri'ah was...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010316,
					"content": "I know about Khaenri'ah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "...Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010318,
					"content": "Because I have memories of Khaenri'ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "You have memories of being there? But that nation was destroyed 500 years ago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010320,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010321,
					"content": "Is that so? Well, everyone has their secrets. You did not pry into mine, so I shall not pry into yours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010322,
					"content": "But if you would like to tell me, I will listen... So, the Khaenri'ah you saw, what was it like?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010323,
					"content": "(Well, I can't hide it from him any longer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "So that's the complete story, huh... Paimon thought that you ran into that unknown god first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010327,
					"content": "#I see... So your first memory after coming to this world was being awoken by your {F#brother}{M#sister} from within that meteorite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010328,
					"content": "#It seems your {F#brother}{M#sister} woke up first, but the question is, how long before you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010329,
					"content": "#And then, your {F#brother}{M#sister} told you that the destruction of Khaenri'ah plunged the whole world into chaos and that you two should leave this world called Teyvat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010330,
					"content": "#\"The destruction of Khaenri'ah\"? {F#He}{M#She} said that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010331,
					"content": "Correct.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "That destruction you witnessed, that's... history from 500 years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010334,
					"content": "It seems the first time you awoke in this world was indeed during that period.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010335,
					"content": "#Huh... So your {F#brother}{M#sister} must have understood this world better than you did because {F#he}{M#she} woke up first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010336,
					"content": "And it was shortly after that that you encountered an unknown god who blocked your path, so you couldn't escape...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010337,
					"content": "Oh, Paimon knows this part really well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010338,
					"content": "...I understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010339,
					"content": "When you awoke at that time and hurriedly tried to leave for another world, you didn't know anything about Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010340,
					"content": "But now, since you have come to gain some understanding of Teyvat, you are able to guess that the war you witnessed all those years ago must be the war that ended Khaenri'ah... Am I right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010341,
					"content": "Ah! If that's the case, you must've been flipping through all sorts of books during our adventure these past few months.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010342,
					"content": "Before going to Mondstadt, you had just looked at some vague materials. Later, we managed to gather a whole bunch of old books from all around Mondstadt and Liyue, but you told Paimon they were useless...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010343,
					"content": "#So the whole time you were just trying to learn more about Khaenri'ah so you could find your {F#brother}{M#sister}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010344,
					"content": "It's the second most promising lead after looking for The Seven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "Oh yeah... You can travel around the seven nations to find The Seven, but where can you go to find a nation that was destroyed 500 years ago...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010347,
					"content": "I probably know more about Khaenri'ah than both of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010348,
					"content": "Khaenri'ah was a nation without a god — not because it had a god that died or abandoned them, but because it never had a god to begin with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010349,
					"content": "It was a powerful nation built purely by humans, an unprecedented flourishing and glorious civilization — it was the pride of humankind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010350,
					"content": "A nation... without a god...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010351,
					"content": "Later events unfolded just as you remember — it was all destroyed... by gods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010352,
					"content": "You mean that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010353,
					"content": "500 years ago, the gods descended upon the world and brought desolation to Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010354,
					"content": "The \"pride of humankind\" was uprooted and crushed, like a weed removed from the garden of the gods...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010355,
					"content": "How could that be...? The history books don't say anything about that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010356,
					"content": "That's horrible...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "Yes. Well, continuing to discuss the past now will only dampen our spirits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010359,
					"content": "(But, the next time I see Venti or Zhongli...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "Let's keep moving. I will tell you more of what you want to know as we continue our search.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010360,
					"content": "(I need to hear what explanation the gods have for their actions.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#What a dangerous world... I need to hurry up and find my {F#brother}{M#sister}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "Despite only having a place name to go on.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "That's what I heard at the time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "(Dain and Khaenri'ah... It's worth a shot.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "(The person who woke me up...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "(And that sea of flames...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "I don't really understand...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800107",
							"2"
						],
						"stepId": 800107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "Huh? This Abyss Mage dropped a talisman... Could it be a communication of some kind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010402,
					"content": "Hmm, this talisman seems connected to the Abyss Herald. But why would an Abyss Mage be carrying it...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010403,
					"content": "Perhaps it really does contain information about their operation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010404,
					"content": "But, Paimon can't read the writing on it... *gasp* Is that the script of Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010405,
					"content": "#\"...Engulf the faith of the enemy in flame, and bring glory to {F#His Highness, the Prince}{M#Her Highness, the Princess}...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010406,
					"content": "Wha—!? Is that what it says?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010407,
					"content": "\"...'Loom of Fate,' initial operation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010408,
					"content": "They... the Abyss, seem to be carrying out a large operation. The keyword here is \"Loom of Fate.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010409,
					"content": "It seems like they are still launching the operation, or rather, are still conducting preliminary tests...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010410,
					"content": "\"Loom of Fate\"? What's that? Is it literally a... fate-weaving machine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010411,
					"content": "The Abyss Mage came from those ruins...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "From the horrible feeling Paimon's been getting, those eerie ruins are super likely to be related to this fate-weaving operation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010414,
					"content": "So Dain, what message does this talisman contain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010415,
					"content": "I'm reading it now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010416,
					"content": "Hmm... An ambitious operation, but some parts are difficult to understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010417,
					"content": "How so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010418,
					"content": "In short, the first phase of the plan is related to Osial, Overlord of the Vortex.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010419,
					"content": "The Overlord of the Vortex!? You mean that god in the ocean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010420,
					"content": "We weren't able to destroy it last time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "What do they want with Osial? Ohh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010423,
					"content": "Could it be the same as with Dvalin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "I know of your past heroics regarding Dvalin, and I also know of the Abyss Order's role in the Stormterror incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010425,
					"content": "Though you may not have been aware of it at the time, you were thwarting an Abyss Order operation similar to this one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010426,
					"content": "Last time it was Venti's old friend, this time it's a huge ancient god... The Abyss Order keeps setting their sights higher and higher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010427,
					"content": "Will the Abyss Order use their lies and dark magic to corrupt Osial, just as they did Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010428,
					"content": "No... From the contents of the talisman, this operation goes one step further.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010429,
					"content": "They won't just corrupt Osial's mind. They also plan to use the ancient technology behind the \"Field Tillers\" to completely transform Osial's body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010430,
					"content": "Is... that even possible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010431,
					"content": "So wait, the Abyss Order wants to make some sort of... Cybernetic Squid-God of Mass Destruction!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010432,
					"content": "Sounds about right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "Very few people today truly understand the civilization of Khaenri'ah, though of course, the accuracy of that understanding itself is difficult to judge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010435,
					"content": "Only the Abyss Order has consistently sought out the remnants of Khaenri'ah. Despite being far from human, they seek out this lost human civilization quite persistently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010436,
					"content": "The talisman's message states that they will use \"the Defiled Statue\" as a base, attaching Osial's limbs to construct a mechanized god.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010437,
					"content": "And the new core that shall replace the orb usually held by the Statue of The Seven... is the eye of the very first Field Tiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010438,
					"content": "\"The eye of the very first Field Tiller\"? ...Ohh, Paimon gets it! All those Abyss Mages are looking for this special eye, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010439,
					"content": "It would seem so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010440,
					"content": "They haven't found it yet. We still have time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "This whole thing keeps getting more complicated. But basically, it all has to do with that eerie Statue of The Seven we saw, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010443,
					"content": "Yes. According to the talisman, the eye should be placed in the hands of the Defiled Statue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010444,
					"content": "Thereby imbuing the newly born god with the power to \"topple the divine thrones of Celestia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010445,
					"content": "(Celestia...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "Oh boy... The Abyss Order sure isn't holding back with this plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010448,
					"content": "Hmm. Since no one knows where the first Field Tiller is, how about we take the information about the statue as the starting point for our investigation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010449,
					"content": "That statue... It looked like the Anemo Archon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "Yeah, that Tone-Deaf Bard is too difficult to track down anyway. Let's go to the <color=#00E1FFFF>Cathedral</color> first and ask around, maybe we'll learn something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010452,
					"content": "The Cathedral... Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010453,
					"content": "Huh? What's the matter, Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010454,
					"content": "Nothing. Let's get moving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010450,
					"content": "Should we ask the Church of Favonius about it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "(Topple the divine thrones...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "Let's find the eye before they do.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "These nicknames keep getting longer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "It was just crushed by the Jade Chamber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "Is it related to the inverted statue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
			"completionStepIds": [
				800108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800108",
							"2"
						],
						"stepId": 800108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "Over there! It's more Ruin Guards and Abyss Mages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010502,
					"content": "Dain was just saying how these ancient machines are from Khaenri'ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010503,
					"content": "So... did Khaenri'ah have a lot of ruins that needed to be guarded?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010504,
					"content": "No. \"Ruin Guard\" is the name modern people have given these machines. No one called them that 500 years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010505,
					"content": "These \"Ruin Guards\" were known as \"Field Tillers\" by the people of Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010506,
					"content": "\"Field Tillers\"? What a strange name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010507,
					"content": "They were farming equipment!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "It's not like you think. \"Field Tiller\" was just a code name. The people of Khaenri'ah liked to give code names to their weapons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010510,
					"content": "\"The land is not to be tilled with farming tools, but rather is to be fought for with steel and blood.\" —This is how the \"Field Tiller\" came about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010511,
					"content": "\"Fought for with steel and blood\"? Well that's an interesting way of understanding \"tilling\"... Paimon doesn't think it's a very positive interpretation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010513,
					"content": "After the destruction of Khaenri'ah, these masterless \"Field Tillers\" went completely out of control.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010514,
					"content": "They wandered aimlessly over the centuries, gradually spreading to every corner of Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010515,
					"content": "Perhaps resonating with the sorrow of other civilizations lost to time, they found their way to various ruins across the land, where they lie dormant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010516,
					"content": "That sounds... so sad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010517,
					"content": "Wandering aimlessly for 500 years...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
					"content": "Once you understand more, those details won't mean much to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010521
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010521,
					"content": "But no matter their past, all that remains of them now is the danger they pose... so destroy them all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010518,
					"content": "It seems... we should put an end to their suffering.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010519
					]
				},
				{
					"id": 80010519,
					"content": "Yeah... Paimon thinks you've been doing a real good job of that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010508,
					"content": "So what's with the lethal weapons...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				}
			]
		}
	]
}