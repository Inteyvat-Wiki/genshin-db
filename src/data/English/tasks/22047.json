					"nextDialogs": [
						220470405
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470405,
					"content": "W—Well, best not to dwell on that right now. Please take these as thanks for that demonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470406,
					"content": "I'll start training myself in a bit. Let's set our target at... seven out of ten shots, how about that?",
