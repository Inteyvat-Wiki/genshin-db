							211.687,
							-1015.558
						],
						"pointId": 15570
					}
				]
			},
			"dialogs": [
				{
					"id": 700740501,
					"content": "Hey! You've scared off all the pigeons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740502,
					"content": "...G—Grand Master?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740503,
					"content": "Hey, if it isn't little Timmie! Grown up quite a bit, haven't you? Been eating well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740504,
					"content": "Y—Yes Sir! I always remember what you told me — that I've gotta eat well and exercise hard if I wanna grow up big and strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740505,
					"content": "This kid's attitude...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "Well, guess that's the Varka effect... Honestly, Paimon would be shocked if there was a single kid in this city who didn't look up to our \"living legend\" over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740508,
					"content": "Sorry for scaring your pigeons away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740509,
					"content": "I was actually gonna ask... Is there a way to approach pigeons without spooking them... while keeping them happy at the same time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740510,
					"content": "Hmm... To be honest, I usually just walk up to them quietly and scatter some feed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740511,
					"content": "Boom, that's it! Say, you got any extra feed on you right now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740512,
					"content": "I do have quite a bit, but... Grand Master... Um... What are you planning to do...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740513,
					"content": "Don't worry, little man, we just need to borrow a feather or two... You have my word!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740514,
					"content": "Ah... Alright then, no problem! And thank you, Grand Master!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740506,
					"content": "It changed in a heartbeat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
