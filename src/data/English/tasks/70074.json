			"dialogs": [
				{
					"id": 700740201,
					"content": "So this is where we'll be getting those \"wood chips struck by knights,\" huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740202,
					"content": "Ah! Grand Master! Honorary Knight! Are you here to train as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740203,
					"content": "Well, maybe not in a traditional sense... But we're here to pursue a goal, so I guess that counts too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740204,
					"content": "You're already so skilled, yet you still strive for perfection... Please, train however you like! I'll be taking notes from the side!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
