			"dialogs": [
				{
					"id": 700740101,
					"content": "Y'know, since it was Varka who came up with the whole idea of holding a \"conference\" with the Hexenzirkel, how come we never found out what task they gave him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740102,
					"content": "Let's see... Varka, Varka... Wait, why's it blank?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740103,
					"content": "Why don't we just go ask him ourselves?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740104
					]
				},
				{
					"id": 700740104,
					"content": "Good point... Well, knowing what he's like, we'd better start by checking all the local taverns and restaurants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740105,
					"content": "...Still not here, huh? Looks like I'll have to figure this out on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740106
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740106,
					"content": "Speak of the devil, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740107
					]
				},
				{
					"id": 700740107,
					"content": "Hey, Varka! We wanted to ask you about your \"task\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740108,
					"content": "Oh, hey there, Honorary Knight and Paimon! My \"task\"...? What's all this about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740109,
						700740110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740109,
					"content": "The Hexenzirkel have set tasks for everyone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				},
				{
					"id": 700740111,
					"content": "Now that you mention it, I'm pretty sure Alice did tell me something about that... I think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740112,
					"content": "You \"think\"? That \"conference\" of yours is why those \"tasks\" even exist in the first place! ...Ugh, anyway, why *is* yours blank?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740113,
					"content": "...If I had to take a wild guess, probably 'cause it'd be too much for that little book of theirs to handle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740114,
						700740115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740114,
					"content": "Now I'm listening.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740116,
					"content": "My task... is to make the finest wine Teyvat has ever seen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740117,
					"content": "...How's that \"too much\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740118,
					"content": "Trust me, this is serious business... See this new scar on my arm? That's what it cost me just to get my hands on the recipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740119,
					"content": "There I was, venturing into a deep, dark Domain, battling some of the fiercest, most vicious monsters I've ever seen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740120,
					"content": "Seriously...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740121
					]
				},
				{
					"id": 700740121,
					"content": "Now we're just three special ingredients short of finishing this thing! Honorary Knight, Paimon, would you be willing to lend me a hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740122,
					"content": "Ugh, fine, why not... Since it's only three things, Paimon's just gonna pretend she buys your story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740123,
					"content": "Alright! Hehe... So, we still need \"wood chips struck by knights,\" \"pigeon feathers shed in joy,\" and \"medicinal broth brewed in a large cauldron.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740124,
					"content": "Wait a sec... Weren't we supposed to be making \"wine\"? This sounds like some kind of super suspicious potion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740125,
					"content": "Hmm, good point... Well, our taskmasters are a bunch of mages, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740126
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740126,
					"content": "We're following the recipe to the letter, so all three ingredients must adhere to their requirements. C'mon, let's get started with those wood chips!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740115,
					"content": "How \"much\" are we talking?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740110,
					"content": "But yours seems to be blank.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				}
			]
		},
