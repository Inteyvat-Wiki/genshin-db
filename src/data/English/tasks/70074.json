			"dialogs": [
				{
					"id": 700740401,
					"content": "Amazing! So THAT's how you do it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740402,
					"content": "Ugh... Why does Paimon feel like she's heard that reaction like a hundred times before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740403,
					"content": "Hmm... Yep, this'll do! The shape, the texture, the quality... brilliant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740404,
					"content": "How you can tell one wood chip apart from another is beyond Paimon... Whatever, as long as you're happy. Next up, those \"pigeon feathers shed in joy\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7007405,
			"completionStepIds": [
				7007405
