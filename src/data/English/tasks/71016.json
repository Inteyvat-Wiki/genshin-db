			},
			"dialogs": [
				{
					"id": 710160301,
					"content": "Regarding the Nameless Treasure...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "If my guess isn't off, the object you brought previously is one of three.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160303,
					"content": "It will only be complete once all three objects are gathered together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160304,
					"content": "If you could find them all, I would be more than willing to make you a generous offer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160305,
					"content": "I fear that they may be from too ancient a time, however, and that gathering them... could be difficult.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
