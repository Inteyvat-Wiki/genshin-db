			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Found all three.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "You... actually managed to put them together? Please, let me see... Indeed, these three patterns, when put together, do tell the story of Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "This crane must be the adeptus Mountain Shaper, and this deer might be Moon Carver. But this last one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "Eh? It seems like this pattern has been... intentionally ground away by someone, to the point where I can't make it out. Who was this third adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Forget it. These matters are beyond my knowledge. Regardless, this treasure is complete, and will definitely sell well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "So, would you like to take it for a keepsake, or would you prefer to sell it to me? I'll pay you a pretty sum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "It's yours.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Great. Please take this, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160509,
					"content": "Still, why was the image of one of the three adepti marred?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160510,
					"content": "Who made this thing, and who broke it and ground away the adeptus' image?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160511
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160511,
					"content": "Right, it seems as if Soraya has arrived in Liyue. I could write her a letter... she would definitely be interested in this object.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
