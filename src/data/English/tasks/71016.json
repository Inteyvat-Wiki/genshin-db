			},
			"dialogs": [
				{
					"id": 710160401,
					"content": "I'll give it a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "Alright. If you do manage to gather them, please bring them to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
