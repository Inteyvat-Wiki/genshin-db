						],
						"stepId": 7101602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "Regarding the Nameless Treasure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "This thing you've brought... It looks pretty good. This pattern also seems quite old indeed. Hold on while I open it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "There are some defects here and there, but if you're eager to have it taken off your hands, I can offer you a price. It'll be fair, but it won't be high.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "I just had a look at this one. These markings are definitely those of Liyue, and you can see inscribed here an anecdote about Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "They say that Azhdaha was a dragon spawned by a convergence of the spirits of Geo in Liyue, and that even Rex Lapis could not easily subdue it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "Rex Lapis thus summoned three adepti to his aid, and together they created a cavernous realm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "Rex Lapis then battled the creature, luring it into the realm, before ordering the adepti to seal the entrance, trapping Azhdaha within.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "The patterns on the thing you brought seem to describe the three adepti joining hands to create the cavernous realm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "I guess that there should at least be three relics of this kind. Combining all three should give us the complete item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "You know all this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Well, I do trade in items of all kinds. A little general knowledge here and there couldn't hurt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "Ah, but I digress. As I said earlier, there should be three of this item. One of them alone is likely not going to fetch a high price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "But if you could gather all three, that would be a different story. But this looks to be quite ancient. Gathering all three might be too tall a task...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue truly is a mystical place...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Now this I'm not certain of, but a senior of mine once told me that Liyue is too large, and its history is, similarly, far too long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "Don't be surprised if you find strange relics in Liyue. What we know of Liyue's lengthy history is but a single drop in the wide ocean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
