			},
			"dialogs": [
				{
					"id": 413420401,
					"content": "Hmm? Do you have some business with me, Traveler? I'm quite busy at the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420402
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420402,
					"content": "Here's a Xiao Lantern from Siyu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4134205,
			"completionStepIds": [
				4134205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134205",
							"2"
						],
						"stepId": 4134205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wrench Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "Siyu? She... she got me a Xiao Lantern? L—Let me see!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420502,
					"content": "Hahaha, she wrote this wish for me, didn't she? Yep, that was my greatest wish as a kid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420503,
					"content": "So many years have passed in the blink of an eye. Time truly flies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420504,
					"content": "Still, how come she asked you to deliver it to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420505,
					"content": "She has things to attend to at home...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "Ah, is that so... Good, good. Yes. Very good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420508,
					"content": "Sounds like she's got a good life now. That's all that matters... Haha... Heh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420509,
					"content": "It's a good thing. It's very good... I'm sorry, I've still got a lot of work to do. If you'll please excuse me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420506,
					"content": "She needs to return home to help her husband...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
		{
			"id": 4134206,
