			"dialogs": [
				{
					"id": 413420901,
					"content": "It's done. I hope I didn't keep you waiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420902,
					"content": "Oh, you've finished everything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420903,
					"content": "Aye. It was a small matter, and with this traveler helping, it was easy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420904,
					"content": "You... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420905,
					"content": "Oh, come on. It's the festive season, no need for the long face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420906,
					"content": "Yes, sure, whatever you say. Have you prepared a Xiao Lantern yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420907,
					"content": "A Xiao Lantern... Ugh, I forgot! What's with my memory today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420908,
					"content": "Ah well, never mind, eh? It's just a lantern. So what if we don't release one this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413420909,
					"content": "Hah, don't you try that with me. You're not seriously suggesting that we celebrate the Lantern Rite without a lantern, now, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420910,
					"content": "Traveler, could you make a lantern for my colleague ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420911,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "Thank you very much. We'll be waiting for you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hammer Li"
				}
			]
		},
