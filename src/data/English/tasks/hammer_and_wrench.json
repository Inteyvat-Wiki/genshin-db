				"objectNames": [
					"Wrench Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "Mm, these should do the trick. Many thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421203,
					"content": "There's still a few loose ends to tie up. Could I trouble you to go to the dock and take inventory of some newly arrived goods?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421204,
					"content": "There should be a total of three crates piled up at the dock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421205,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "You're a big help. In the meantime, I need to get a move on and finish up everything here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wrench Wang"
				}
			]
		},
