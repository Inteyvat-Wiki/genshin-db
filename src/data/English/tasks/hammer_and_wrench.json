					"nextDialogs": [
						413421002
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421002,
					"content": "Y—You sure you're alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421003
					]
				},
				{
					"id": 413421003,
					"content": "Hey! What are you trying to say? I'm fine! Why wouldn't I be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421004
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421004,
					"content": "I should get back to work now. Once I've finished... *sigh* Well, I'll see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421005
					],
					"speakerTitle": "Wrench Wang"
				},
				{
					"id": 413421005,
					"content": "Allow me to help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421006
					]
				},
				{
					"id": 413421006,
					"content": "Hmm? ...Well, if you really want to, you can bring me some wooden planks.",
