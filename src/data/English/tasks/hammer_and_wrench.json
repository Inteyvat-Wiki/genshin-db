			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Siyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "I suppose I should give him a Xiao Lantern after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420102,
					"content": "Give who a Xiao Lantern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "Oh, Traveler, it's you. Well, \"The Wrench\" has always taken good care of me. Even now, he helps me out all the time — he's almost like a real brother to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420104,
					"content": "This is supposed to be a festival, and yet he's still working non-stop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420105,
					"content": "So, I'd like to give him a Xiao Lantern as a gift. Hehe, we were childhood playmates, and he absolutely loved the sight of the lanterns when he was little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420106,
					"content": "I'm sure he'd love to get one now. Traveler, could you help me deliver this Xiao Lantern to him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420107,
					"content": "Don't you want to give it to him yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "I'd love to, but I've still got so many things to take care of at home...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420110,
					"content": "I've left my husband to do all the housework while I've been out shopping. I should get back to help him out as soon as I can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420111,
					"content": "So I'm leaving the matter of the Xiao Lantern to you. Once we've got some time, my husband and I will go see \"The Wrench\" together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420112,
					"content": "I do hope that he'll manage to get a little more free time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420108,
					"content": "It might mean more coming from you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
			"id": 4134202,
			"completionStepIds": [
				4134202
			],
