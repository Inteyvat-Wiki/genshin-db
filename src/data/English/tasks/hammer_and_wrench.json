				"objectNames": [
					"Hammer Li"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "That Xiao Lantern was from Siyu, wasn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420603,
					"content": "You overheard us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "Hah, I just know him well enough. There was no need to even guess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420606,
					"content": "He did exactly the same thing last year. Went off for a walk, then came right back and proceeded to hammer nails into a ship's hull the whole night through.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420607,
					"content": "I know why he does this, but still... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420608,
					"content": "Traveler, could you please go help him out? Tormenting oneself is no way to spend a festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420609,
					"content": "I'll do it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "*sigh* Sorry for troubling you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420611,
					"content": "I bet he's onboard a ship right now, working away... Best you go find him quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420612,
					"content": "I'll be preparing some food in a bit. Come back here once you're done and we'll eat together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420604,
					"content": "How did you know?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				}
			]
		},
