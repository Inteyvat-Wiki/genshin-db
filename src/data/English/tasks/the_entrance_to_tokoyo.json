			"dialogs": [
				{
					"id": 722420401,
					"content": "Wow! Paimon never thought that there'd be such a huge place underneath Watatsumi Island!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420402,
					"content": "Looks like our goal is that place in the middle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420403,
					"content": "#Alrighty then, {NICKNAME}. Let's head in. Steadily now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "Those ruins seem to be closer to us. Let's start there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "Buildings means people... once upon a time, anyway. And where there's people, there'll be writing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420406,
					"content": "And where there's writing and paper, there'll be those... hints that we can't even read.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
