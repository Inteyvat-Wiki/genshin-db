			"dialogs": [
				{
					"id": 752710601,
					"content": "Yopoyi! You came!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "Ziki? It's you... What's with the outfit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "I'm a Nanasian — your favorite! I rented the costume specially. How do I look? Oh, and these balloons — I prepared them just for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "Actually, there's something I've been wanting to say for a long time... Please go out with me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "...Are you for real?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "I am! My lovely lady, Yopoyi, please, say you'll go out on a date with me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "Did you hit your head getting into that costume or something? This is our third anniversary! We're MARRIED!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "I know that! It's just... you're always telling me how unromantic I am... and I never properly confessed my love before our marriage... I know it's late, but this is my confession to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Haha... So that's it, huh? Alright then, of course I'll go out with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "For real?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Yes, for real, you silly romantic fool, you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "A gust of wind blows by, and the lovers embrace.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
