			},
			"dialogs": [
				{
					"id": 3790222,
					"content": "Great! Try to use it on the Holy Lyre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790302,
					"content": "Let me give it a try.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 37904,
			"completionStepIds": [
				37904
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37904",
