			"dialogs": [
				{
					"id": 721160401,
					"content": "Thank you, truly! These shall form the basic structure of our device.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160402,
					"content": "Now, all we need to do is wait for our beacons to collect enough data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160403,
					"content": "Once we have that data on hand, I will make a few tweaks to this device accordingly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160404,
					"content": "Once all is ready, let us put a decisive end to this incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
