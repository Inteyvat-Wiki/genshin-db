			"dialogs": [
				{
					"id": 766580101,
					"content": "Heya, Ginette! Did you get all the robots we found?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580102,
					"content": "I did! Good work, you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580103,
					"content": "Speaking of which, we made some new discoveries!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580104,
					"content": "You did? Please tell me everything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580105,
					"content": "You and Paimon tell Ginette about what you witnessed not long ago.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "The behaviors you described... The robots seemed to like you very much, and thus sent you a message. An invitation to \"play together.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580107,
					"content": "Really? Whoa, that's so cool!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580108,
					"content": "Hmm-hmm... I knew it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580109,
					"content": "Knew what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580110,
					"content": "Now I'm certain — my vision can only be realized through interactions between these robots. The more units we can retrieve, the closer we get to my original plan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580111,
					"content": "Now, they can already communicate with others. All we have to do is find the rest of the robots, and... Yes! I can see my creativity bearing fruit...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580112,
					"content": "Well, well, someone's excited!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580113,
					"content": "Ah! Sorry, I'm getting a bit worked up... I'll still need your help for the rest. Here, I've marked out the next area on the map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580114,
					"content": "Then let's get going! Paimon's just as curious to see where this'll lead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
