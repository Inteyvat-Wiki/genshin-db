			"dialogs": [
				{
					"id": 761250201,
					"content": "(As expected, Columbina isn't here...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "Could Columbina really...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250203,
					"content": "(She stepped through the \"Moon Gate.\" No one knows what's inside, but it's a place that tore apart the extremely powerful Rächer of Solnari...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "(If only I'd...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250205
					]
				},
				{
					"id": 761250205,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250207
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250207,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250208
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250208,
					"content": "Ah, it's you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250209,
					"content": "~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250210
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250210,
					"content": "Are you... also waiting for Columbina to come back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250212
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250212,
					"content": "So, you too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250214
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250214,
					"content": "Hey... C'mon, don't be so sad. Keep your chin up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250215,
					"content": "If everyone was sad, that'd be like... like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250216,
					"content": "Paimon doesn't want to think about it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250217,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "(...I can't allow myself to wallow in guilt.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "(Columbina didn't sacrifice herself for us to end up like this, not to mention...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "I... haven't given up yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "Columbina, all of her friends... None of them would ever just give up like this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "Give us a little more time. I can't promise anything, but I'll do everything I can...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250223
					]
				},
				{
					"id": 761250223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250224
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250224,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250225
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250225,
					"content": "Are they... cheering for us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250226,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250227
					]
				},
				{
					"id": 761250227,
					"content": "Thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250228,
					"content": "Do you need us to help you with something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250229,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250230
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250230,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250231,
					"content": "This kuuhenki... Paimon thinks it's the one who likes playing the lyre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250232,
					"content": "This kuuhenki... Paimon thinks she looks a little flustered...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250233,
					"content": "Why don't you play something? If they hear a familiar melody, maybe they'll calm down a little bit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250234,
					"content": "A familiar melody...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "Let's try the one Columbina always sings...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "Aww... They're asleep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250237,
					"content": "Looks like they haven't had a good rest in a long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250238,
					"content": "Shh, let's leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250239,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250240,
					"content": "Sandrone! What are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250241,
					"content": "What, am I not allowed to take walks now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250242,
					"content": "She hasn't returned.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "Thought as much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250244,
					"content": "No such thing as a free miracle, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250245,
					"content": "Hey, which way are you headed? Er, Paimon means... We don't see much of each other, maybe we could join you for a bit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250246,
					"content": "Let's not. I'm not in a good mood today, and don't have anything nice to say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250247,
					"content": "Besides, comfort is the last thing this place needs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
