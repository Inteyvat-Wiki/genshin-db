			"dialogs": [
				{
					"id": 150120601,
					"content": "Anyway... I'm sure you've seen the state this place is in. It's all because the Shadow Pin suddenly came crashing to the ground and left behind a massive crater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120602
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120602,
					"content": "The seam I found was closer to the outside, so it survived the disaster. Still, the crash riled up the monsters in the area, and now they're everywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120603
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120603,
					"content": "I panicked, and ran up a narrow path to avoid them... But, by the time I was in the clear, I ended up running into those bandits... You showed up in the nick of time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120604
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120604,
					"content": "If the situation was so dangerous, why didn't you just drop the crystals and run?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120605,
					"content": "I left most of them behind, believe me. I only kept the purest chunk — I have to bring it back, no matter what.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120606
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120606,
					"content": "...For Tlazolli, and poor little Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120607
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120607,
					"content": "Who are they?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120608
					]
				},
				{
					"id": 150120608,
					"content": "Ah, right, you wouldn't know. Tlazolli is a former Ancient Name artisan, and Nechca is her daughter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120609
					],
					"speakerTitle": "Cheven"
				}
