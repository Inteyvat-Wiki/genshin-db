			},
			"dialogs": [
				{
					"id": 150120701,
					"content": "Why did she stop?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120702
					]
				},
				{
					"id": 150120702,
					"content": "...Because of her daughter. Poor Nechca contracted an awful illness and Tlazolli put everything aside to take care of her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120703
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120703,
					"content": "Even as Nechca's illness grew worse, Tlazolli never gave up. Like a torch in the night, she was determined to burn bright, even as darkness encroached from all directions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120704
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120704,
					"content": "Still, all's well that ends well! Thanks to the doctor's medicine and the Great Spirit's protection, Nechca's flame was rekindled!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120705
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120705,
					"content": "Her condition has been slowly improving ever since. She's still weak, of course, and has to recuperate at home... but she's well enough to write letters already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120706
					],
					"speakerTitle": "Cheven"
				},
