			"dialogs": [
				{
					"id": 250323001,
					"content": "You're back! Have you finished taking the pictures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250323002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250323002,
					"content": "I took a few extra shots for good measure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250323003
					]
				},
				{
					"id": 250323003,
					"content": "Wow, you're good. Much better than my assistant for sure. Whenever he takes pictures of the sites we're surveying, we're looking at several takes, minimum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250323004
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250323004,
					"content": "If we had you on the survey team, I bet we'd have ruined a few Kameras less.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250323005
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250323005,
					"content": "Can you really use these to help write poetry?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250323006
					]
				},
				{
					"id": 250323006,
					"content": "I... think so? Well, and if I can't make it work, I'll just use the pictures as postcards.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250323007
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250323007,
					"content": "I'll write some wish-you-were-heres on the back and have 'em sent to the Ministry. No one'll say nothin', not after the gifts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250323008
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250323008,
					"content": "*cough* That's the last resort, though. In the meantime, I'll give this \"writing a good poem\" business some thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250323009
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250323009,
					"content": "The five winds... surge? ... No, roil, perhaps... Wait a moment. How many tribes does Natlan have anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
