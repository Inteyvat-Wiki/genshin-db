						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250321101,
					"content": "I've heard that there's a beautiful stage over where the Children of Echoes are, at which people perform daily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250321102,
					"content": "Please, help me take a picture of that grand stage at noon — better still if you could get a shot with those performing in it as well...",
					"roleType": "TALK_ROLE_NPC",
