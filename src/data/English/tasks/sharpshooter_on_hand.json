				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "Ah, yes! I've heard people say that the People of the Springs have very distinctive shop signage, and amongst them, I believe, is \"Djembe Studios.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250321002,
					"content": "Please, help me take a picture of that studio in the early morning hours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
		{
			"id": 2503211,
