			"dialogs": [
				{
					"id": 746740101,
					"content": "Ancient Iron Coins... Ancient Iron Coins... Nice, very nice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740102,
					"content": "#With so many Ancient Iron Coins, I'm sure I can make a pretty pile of Mora! Thanks a ton, {NICKNAME} and Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740103
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740103,
					"content": "What do you plan on doing next?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746740104
					]
				},
				{
					"id": 746740104,
					"content": "Of course, I'm going to... think of a way to exchange these Ancient Iron Coins for Mora, or other convenient and useful items.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740105
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740105,
					"content": "But seriously, I really don't want to get tangled up with that middleman from before. He takes a huge cut every time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740106
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740106,
					"content": "Not only that, but it takes forever for him to get my money to me. I haven't got a clue what he's doing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740107,
					"content": "But... Other than him, I simply can't find anyone reliable to work with... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740108,
					"content": "Enough of that! These are for you, consider it a bonus for our fruitful long-term cooperation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740109,
					"content": "Once my business here in Fontaine is over, I'll need to think carefully about my next steps. I can't just keep traveling, that's way too tiring...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				}
			]
		}
	]
