					"nextDialogs": [
						735070504,
						735070505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070504,
					"content": "You're a real happy bean, eh, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070506
					]
				},
				{
					"id": 735070506,
					"content": "#You're here, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070507,
					"content": "How are things going with the Fungus Mechanicus trials?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070508,
						735070509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070508,
					"content": "The test period will still be on for a while yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070510
					]
				},
				{
					"id": 735070510,
					"content": "Ooh, so Haniyyah and our shroom buddies will be here for a while, huh? That's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070511,
					"content": "Paimon was planning to ask you to stay here for a day more so that we could spend more quality time with the Fungi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070512,
					"content": "But it looks like we can hit two birds with one stone — testing Fungus Mechanicus and playing with our shroom buddies at the same time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070513,
					"content": "You have a good, carefree time with Paimon, Bongo-Head, and Kindlejoy, and feed the Marvelous Jellies to them.\\nPaimon and your shroom buddies enjoy themselves very much.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735070514
					]
				},
				{
					"id": 735070514,
					"content": "Hehe, that was great, like Paimon's worries have all flown away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070515,
					"content": "Well, Bongo-Head, Kindlejoy... See you tomorrow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070516,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070517
					],
					"speakerTitle": "Bongo-Head"
				},
				{
					"id": 735070517,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pyro-1"
				},
				{
					"id": 735070509,
					"content": "We can play with them every day before it concludes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070510
					]
				},
				{
					"id": 735070505,
