							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Zurvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020701,
					"content": "The Tunigi Hollow from before... the epicenter of the disaster of years past...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020702,
					"content": "Wow! Paimon didn't think Sorush would really be able to extinguish the Sign of Apaosha and solve all the trouble happening here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020703,
					"content": "Extinguishing the Sign of Apaosha is but the duty of the Bloomguard. Sorush only did as she should.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020704
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020704,
					"content": "It was all thanks to Mihir and Rashnu's help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020705
					]
				},
				{
					"id": 737020705,
					"content": "Yeah. And we put in plenty of work too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020706,
					"content": "Splendid! It's so nice of you, my Yasnapati and the Pale Floater, to look beyond the person of greatest importance: me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020707
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020707,
					"content": "Whoa, Sorush's arrogance makes its grand return!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020708,
					"content": "Hmph. Why do both of you still harbor such doubt in me after our time together? My pride has never been born of blind arrogance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020709,
					"content": "Hmm. You should be well aware that I fully understand my past mistakes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020710
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020710,
					"content": "Before, I placed reputation above action, but now, as I have learned, this is an act of purest neglect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020711
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020711,
					"content": "Just as Simurgh became the divine bird through her sacrifice, I will become the Bloomguard by my deeds and hear my name rightfully sung in praise of my service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020712
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020712,
					"content": "Additionally, I have completed all the assignments you have given me, Elder. Now, even you must admit that I am one worthy of the title of Bloomguard, worthy of the Twin-Horned Chaplet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020713,
					"content": "I indeed have no objection to the choice made by the Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020714
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020714,
					"content": "...Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020715,
					"content": "What? Did you expect me to object?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020716
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020716,
					"content": "No... I merely... did not expect you to agree so easily, Elder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020717
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020717,
					"content": "I expected a few rough words at least?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020718
					]
				},
				{
					"id": 737020718,
					"content": "Ah, I'm not nearly so vicious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020719
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020719,
					"content": "About the responsibilities of a Bloomguard... I did not actually gain any knowledge from the Chaplet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020720
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020720,
					"content": "Is this because I still do not embody the traits of the Bloomguard fully? Do I still lack training?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020721
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020721,
					"content": "For this... The title of Bloomguard might be inherited, but the duties are always variable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020722
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020722,
					"content": "I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020723
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020723,
					"content": "To state it simply: there are no fixed rules, and even more, there are no specific judging standards. Usually, the Khvarena's choice is final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020724
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020724,
					"content": "Huh? So, you're saying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020725
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020725,
					"content": "I will not be taking the Twin-Horned Chaplet from you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020726,
						737020728
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020726,
					"content": "Now you don't need to worry about the top of your head getting cold.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020727
					]
				},
				{
					"id": 737020727,
					"content": "Missing the point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020732,
					"content": "I understand! This must be part of the test!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020733
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020733,
					"content": "Seems like Sorush is having an epiphany...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020734,
					"content": "You are a forgetful one, Pale Floater. I just said it! To pass these tests, besides competence and observation, the most important thing is understanding my past mistakes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020735
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020735,
					"content": "Even if the outcome was already determined, would it not be retreading the path of folly if I cast aside all that I have learned during training? So, I think this must be the last test my elder has left me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020736
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020736,
					"content": "To a worthy Bloomguard this is but a simple task. This is a sign of your complete trust in me, Elder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020737
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020737,
					"content": "I didn't expect you to see right through me. The Khvarena chose well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020738
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020738,
					"content": "#But your changes... I suppose {NICKNAME} and Paimon bear some credit for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020739
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020739,
					"content": "Indeed! My esteemed Yasnapati and the Pale Floater are both beings of merit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020740
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020740,
					"content": "Though I wish to say that I was potent enough alone... I think, truly, that only with their aid could I extinguish the Sign of Apaosha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020741
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020741,
					"content": "I didn't think that, in so short a time, Sorush could become so responsible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020742
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020742,
					"content": "Of course! As long as I hold my responsibilities close to heart, then my elder need not worry for my sake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020743
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020743,
					"content": "Paimon keeps thinking that Zurvan might have planned this... But seeing Sorush this happy, Paimon can't really complain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020728,
					"content": "Will not, or can not.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020729
					]
				},
				{
					"id": 737020729,
					"content": "Yeah, as Zurvan said herself, the Khvarena's choice is final. That means that Zurvan can't change it either, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020730,
					"content": "Oh, ho ho... You really think so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020731
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020731,
					"content": "Whoa... That's a little scary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}