	"talks": [
		{
			"id": 7370201,
			"completionStepIds": [
				7370201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370201",
							"2"
						],
						"stepId": 7370201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020101,
					"content": "You look much happier than when last we spoke. Seems things have gone well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020102
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020102,
					"content": "Hmm. From what I've learned doing these tasks, I have grown. For now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020103
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020103,
					"content": "You are worthy of being called Bloomguard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020104
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020104,
					"content": "No... not yet. There is still a final portion of the task that I need to complete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020105
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020105,
					"content": "Until all the tasks are done, until your respect is earned, I am not finished. Only then can the \"Twin-Horned Chaplet\" truly belong to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020106
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020106,
					"content": "Oh? Looks like you're actually beyond your rebellious phase after all, just as was claimed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020107
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020107,
					"content": "E—Elder, you... still remember that? Forget, I beg of you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020108
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020108,
					"content": "Haha. Regardless, it's good to see that your spirits have returned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020109
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020109,
					"content": "#{NICKNAME}. Paimon. Please be witnesses to the truth of whether Sorush is worthy of the Twin-Horned Chaplet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020110
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020110,
					"content": "Then I will await you at the end. See you soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				}
			]
		},
		{
			"id": 7370206,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020601,
					"content": "The Tunigi Hollow... this was the epicenter of the disaster. Though all seems calm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020602
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020602,
					"content": "It's not hard to think of how things were then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020603
					]
				},
				{
					"id": 737020603,
					"content": "These crystals are huge... A lot bigger than even Wenut! And to think it's Sorush's responsibility to handle future problems here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020604,
					"content": "Is this not the most essential duty a Bloomguard should uphold? In addition, Sorush should also expect this of herself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020605
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020605,
					"content": "That's what they say, anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020606,
					"content": "Do you not trust me? Hmph. I did not realize I was at the stage that even the Pale Floater thinks so little of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020607
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020607,
					"content": "Whoa, Sorush's arrogance makes its grand return!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020608,
					"content": "Not sure if that's a good thing or a bad thing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020609
					]
				},
				{
					"id": 737020609,
					"content": "Hmph. Why do both of you still harbor such doubt in me after our time together? My pride has never been born of blind arrogance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020610
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020610,
					"content": "Hmm. You should be well aware that I fully understand my past mistakes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020611
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020611,
					"content": "Before, I placed reputation above action, but now, as I have learned, this is an act of purest neglect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020612,
					"content": "Just as Simurgh became the divine bird through her sacrifice, I will become the Bloomguard by my deeds and hear my name rightfully sung in praise of my service.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020613
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020613,
					"content": "Additionally, I have completed all the assignments you have given me, Elder. Now, even you must admit that I am one worthy of the title of Bloomguard, worthy of the Twin-Horned Chaplet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020614
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020614,
					"content": "I indeed have no objection to the choice made by the Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020615
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020615,
					"content": "...Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020616
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020616,
					"content": "What? Did you expect me to object?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020617
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020617,
					"content": "No... I merely... did not expect you to agree so easily, Elder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020618
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020618,
					"content": "I expected a few rough words at least?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020619
					]
				},
				{
					"id": 737020619,
					"content": "Ah, I'm not nearly so vicious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020620
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020620,
					"content": "About the responsibilities of a Bloomguard... I did not actually gain any knowledge from the Chaplet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020621
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020621,
					"content": "Is this because I still do not embody the traits of the Bloomguard fully? Do I still lack training?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020622
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020622,
					"content": "For this... The title of Bloomguard might be inherited, but the duties are always variable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020623
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020623,
					"content": "I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020624
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020624,
					"content": "To state it simply: there are no fixed rules, and even more, there are no specific judging standards. Usually, the Khvarena's choice is final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020625
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020625,
					"content": "Huh? So, you're saying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020626
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020626,
					"content": "I will not be taking the Twin-Horned Chaplet from you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020627,
						737020629
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020627,
					"content": "Now you don't need to worry about the top of your head getting cold.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020628
					]
				},
				{
					"id": 737020628,
					"content": "Missing the point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020633,
					"content": "I understand! This must be part of the test!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020634
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020634,
					"content": "Seems like Sorush is having an epiphany...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020635,
					"content": "You are a forgetful one, Pale Floater. I just said it! To pass these tests, besides competence and observation, the most important thing is understanding my past mistakes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020636
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020636,
					"content": "Even if the outcome was already determined, would it not be retreading the path of folly if I cast aside all that I have learned during training? So, I think this must be the last test my elder has left me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020637
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020637,
					"content": "To a worthy Bloomguard this is but a simple task. This is a sign of your complete trust in me, Elder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020638
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020638,
					"content": "I didn't expect you to see right through me. The Khvarena chose well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020639
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020639,
					"content": "#But your changes... I suppose {NICKNAME} and Paimon bear some credit for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020640
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020640,
					"content": "Indeed! My esteemed Yasnapati and the Pale Floater are both beings of merit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020641
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020641,
					"content": "Though I wish to say that I am potent enough alone... I believe that with their aid, the extinguishing of the Sign of Apaosha will be no difficult task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020642
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020642,
					"content": "How very reliable. Don't forget, Mihir and Rashnu will also be able to assist you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020643
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020643,
					"content": "Worry not, Elder! Leave everything to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020644
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020644,
					"content": "Paimon keeps thinking that Zurvan might have planned this... But seeing Sorush this happy, Paimon can't really complain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020629,
					"content": "Will not, or can not.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020630
					]
				},
				{
					"id": 737020630,
					"content": "Yeah, as Zurvan said herself, the Khvarena's choice is final. That means that Zurvan can't change it either, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020631,
					"content": "Oh, ho ho... You really think so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020632
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020632,
					"content": "Whoa... That's a little scary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7370207,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
