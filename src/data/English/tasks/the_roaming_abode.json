			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "\"...I was worried about monsters from the start, but...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Someone's Notes"
				},
				{
					"id": 711050502,
					"content": "\"...So much... My thigh... Can't stop it...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Someone's Notes"
				},
				{
					"id": 711050503,
					"content": "\"...So sleepy... But Mt. Xuanlian is just up ahead... Xiangjun, I'll definitely get those blessed waters...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Someone's Notes"
				},
				{
					"id": 711050504,
					"content": "\"Xiangjun... I'll surely get those blessed waters...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Someone's Notes"
				},
				{
					"id": 711050505,
					"content": "Oh no... He was attacked by monsters and was badly wounded in the process... Wait, and he still wants to get water from Mt. Xuanlian even so!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "Let's hurry — Paimon hopes we can help him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
