			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "Hmm. This should be the place, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "Why isn't anyone here? No trail to follow, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "Could he have gone back already?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Paimon doesn't think that would happen. He's been injured — could he have walked far?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "But he's not around here either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "Could someone have met him on the road and rescued him? Paimon thinks that might have happened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "Shall we go back to Qiaoying Village and ask around?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Let's get a bit of this \"blessed water\" first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "Huh? Oh, right. If Xiangjun's Grandpa was rescued, he might still need this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#In for a Mora, in for it all, eh? You're so thoughtful, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
