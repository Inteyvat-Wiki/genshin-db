			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "\"I overslept! I have to get back before tomorrow, or no one's going to watch Xiangjun... Ah, I'm a fool...!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Someone's Notes"
				},
				{
					"id": 711050202,
					"content": "\"If I remember right, there's a shortcut — a small road leading from Yaodie Valley to Mt. Xuanlian. Just need to get through that plus one mountain cave, and I should be golden...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Someone's Notes"
				},
				{
					"id": 711050203,
					"content": "\"I've heard that there are monsters nearby, but I have to give this a shot...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Someone's Notes"
				},
				{
					"id": 711050204,
					"content": "This looks like something that her grandpa might've left behind. Seems like he took a small trail — let's go look for it as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
