			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang",
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080203,
					"content": "Well? H—How is it? This silence is making Paimon nervous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080204,
					"content": "Mmm... The bittersweet taste of nostalgia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080205,
					"content": "You mean the taste of going from rags to riches? Just what kind of taste is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080206,
					"content": "Hehe... It's mainly sour with just a tinge of sweetness, and a lingering aftertaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080207,
					"content": "Interesting... Does it taste like starting a little business then discovering that selling fruit isn't very lucrative?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080208,
					"content": "No need to get into the details. Let's leave the past in the past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080209,
					"content": "Haha, who'd have thought that the dignified Tianquan was once a fruit vendor on the street.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080210,
					"content": "On the other hand, I bet few can tell that I'm from an ordinary fishing village, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080211,
					"content": "Not necessarily. If you ask me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080212,
					"content": "I'd say that Captain Beidou has eyes that can pierce the sea. You're an adventure-seeking pioneer who tames the wind and the waves... Which is clearly indicative of someone who grew up by the sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080213,
					"content": "Hey, you're not mocking me, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080214,
					"content": "Come now, it wouldn't do any good to be sarcastic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080215,
					"content": "I know how fierce you can be with words. It's my treat today, so remember to take it easy on me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080216,
					"content": "Alright, then I'd like to have a few more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080217,
					"content": "Another drink for the lovely lady?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "We're here to serve you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "Well, you heard the good lady, bartender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080220,
					"content": "I like where this is going! I'll have another round, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080234,
					"content": "You give the two a refill immediately...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "Mondstadt's fresh fruit juice is hard to top. I wish I could enjoy some every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080222,
					"content": "Are you serious? Don't tell me you're gonna open a Sunsettia trade route now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080223,
					"content": "Hmm, an interesting proposition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080224,
					"content": "Wait... Huh, really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080225,
					"content": "I'm just joking, of course. There's already a whole industry established for that. They don't need me muscling my way in to their business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080226,
					"content": "#Thanks for the drinks today, {NICKNAME}. If you'd ever like a cushy job, I'd enjoy having you as my personal bartender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080227,
					"content": "You're also welcome aboard the Alcor. The crew loves to drink, you could come feast with us. I promise you'd have a blast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080228,
					"content": "My, my, Captain Beidou, are you competing with me for talent? That's hardly necessary. You may simply stop by the Jade Chamber whenever you want the Traveler to mix you a drink.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080229,
					"content": "(I'm so popular!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "Is it Paimon, or does it sound like they think you work for them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080231,
					"content": "When I have a chance...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "I'll visit you both. I promise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}