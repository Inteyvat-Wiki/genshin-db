			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chongyun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190250501,
					"content": "I never expected you to find me so easily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250502,
					"content": "It's only your first time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "I thought that this would be the perfect spot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250505,
					"content": "In fact, I'm well-versed in the methods of locating evil spirits, and I have lots of experience tracking down their hiding spots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250506,
					"content": "This spot is dusty and a bit gloomy, which gives off an unsettling energy. Evil spirits usually prefer such places.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250507,
					"content": "You're trying to use thaumaturgy to play hide-and-seek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "Yeah... I guess my experience as an exorcist doesn't apply very well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250511,
					"content": "Since I've been found, I guess I must admit my defeat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250512,
					"content": "It's a simple game, yet quite intriguing once you begin to play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250513,
					"content": "Maybe we could play it together again sometime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "Sure, we could invite more friends to join us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250517,
					"content": "Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250515,
					"content": "Good thing you weren't the ghost.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "Hehe, right. It might've taken me hours to find anyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250509,
					"content": "But you can be easily seen here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "Hmm... I guess I was so nervous that I neglected the most important thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250503,
					"content": "...Why would you hide here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
