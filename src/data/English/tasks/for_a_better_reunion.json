					"nextDialogs": [
						730310310,
						730310311
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310310,
					"content": "I wonder how Rana's doing...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#You know, we should go check on Rana, {NICKNAME}. Maybe she's better now! If so, we can bring her here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310316,
					"content": "You're right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "I'll go see Arana too, in a while. You guys go ahead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310321,
					"content": "#See you later, Nara {NICKNAME} and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310317,
					"content": "Let's hope so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "I'm not getting my hopes up...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310311,
					"content": "I can't wait either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "Yeah! Paimon wonders how it compares to the other festivals. Anyway, Paimon's so excited to spend this time with our friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310314,
					"content": "If only Rana were here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310315
					],
