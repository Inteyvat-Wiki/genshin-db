					"Landa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240901,
					"content": "Did you find the invoices?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240902,
					"content": "Found them all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "Thank you, truly! This is wonderful. I'm so glad that nothing went wrong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240904,
					"content": "If these invoices were lost, I have no idea how angry my boss would have been.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240905,
					"content": "You want to ask what business these invoices were written for, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240906,
					"content": "I'm sorry, I really can't tell you. It's a secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240907,
					"content": "Well, here's your remuneration, please take it... Wait a moment. Why has this box been opened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240908,
					"content": "...You met someone out in the wild who took a look at it after picking it up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240909,
					"content": "Oh, I'm dead. Dead. Dead! This... this won't do. I have to tell the boss quickly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240910,
					"content": "Oh, don't worry, I'm not suspicious of you. I mean, I did do my homework regarding your...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240911,
					"content": "Ahem. Well, I need to find a way to contact my boss. Please carry on with your business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Landa"
				}
			]
		},
