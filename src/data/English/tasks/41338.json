					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380201,
					"content": "This is where the track begins. See? The Xiao Lanterns are all in position.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380202,
					"content": "Alright then — you can begin whenever you're ready. Collect the Xiao Lanterns en route to your objective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 4133803,
			"completionStepIds": [
				4133806
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
