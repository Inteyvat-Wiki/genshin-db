			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "Hmm... Why didn't anyone come...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380102,
					"content": "Is something the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "Traveler! Could... could you hear me out? So it's the Lantern Rite right now, and the Guild was looking to hitch a ride on the festive cheer to do some advertising — to see if we could snag some new recruits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380104,
					"content": "I hear that Brother Qian's come up with a game called... called a somethingy-screen. I don't wanna be left out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380105,
					"content": "So I thought up a new activity. I call it... \"My First Adventure.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380106,
					"content": "Simply put, I wanted to use some Xiao Lanterns to mark out a gliding track.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380107,
					"content": "Then, anyone who wants to take part in this activity can just open up their wind glider and follow the Xiao Lanterns as they fly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380108,
					"content": "You'd get to feel the thrill of adventure and take in the beautiful sights of Liyue, with Xiao Lanterns at your side the whole way! Sounds good, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380109,
					"content": "I'd originally designed two tracks, but when I went to notify the Millelith, they said that I needed to find a test flier who could evaluate them from a safety perspective first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380110,
					"content": "You must have a lot of adventuring experience, right? Would you mind doing the evaluation for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380111,
					"content": "Let's have at it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "Thanks so much for your help! Let's go to Mt. Tianheng, then. That's where the first track starts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
			"id": 4133802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
