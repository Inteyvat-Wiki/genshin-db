				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380501,
					"content": "So, now that you've tested both tracks out, what's your overall impression?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380502,
					"content": "They're not bad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "Great! Guess I can report back to the Millelith now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380504,
					"content": "I'm sure that a fun activity like this will attract lots of people to join the Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380505,
					"content": "Ah, yes. Here's your remuneration for helping me evaluate those tracks. Please, take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
