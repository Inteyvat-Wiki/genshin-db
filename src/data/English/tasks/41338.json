			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "This is the finish line. You're pretty good at this, aren't you... So, how did you find it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380302,
					"content": "A very festive experience!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "Hehe, of course! I put them there myself, you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380305,
					"content": "Well then, let's go to the next track, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380303,
					"content": "The Xiao Lanterns were very pretty...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
		{
			"id": 4133804,
