			"dialogs": [
				{
					"id": 413380401,
					"content": "Alright! This is where the track begins. Once again, the Xiao Lanterns are all in place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380402
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380402,
					"content": "You can begin as soon as you're ready. Same deal as before, collect the lanterns as you head for the objective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
		{
