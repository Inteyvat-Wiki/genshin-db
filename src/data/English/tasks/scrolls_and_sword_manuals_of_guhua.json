					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "\"...Practicing the Light Piercer technique. Destroyed all the dummies by mistake... No money or resources... I've got an idea. I'll tie straws together to make my own...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080302,
					"content": "\"Gathering straw.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080303,
					"content": "\"Tying straw. Exhausting.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080304,
					"content": "\"...Practicing the Light Piercer technique. Destroyed all the dummies by mistake... I might as well train with the sword first.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080305,
					"content": "Continue reading.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "\"...Bored. As I sat before the courtyard, I felt slightly hungry... I pondered on what I saw the other day, and I suddenly felt enlightened. If I use the sword... (indiscernible) I'll call it Rain Cutter. I'll try it another day.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080308,
					"content": "\"...I accidentally fell while practicing Rain Cutter. Luckily, it's nothing serious... I thought of an idea. Why not dig a deep pond below the piles? Not only will it prevent injuries from falls, but I can raise fish for food...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080309,
					"content": "\"...I went to a fisherman and bought dozens of fish... I tried cooking them. Their deliciousness was unrivaled...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080310,
					"content": "(The next ten or so pages are dedicated to detailed records of cooking methods for fish, and some are even paired with illustrations.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080311,
					"content": "\"...Accidentally fell while practicing Rain Cutter.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080312,
					"content": "\"...Success.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080313,
					"content": "Continue reading.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "\"...The spear and sword must be wielded with the same mastery as... (Indiscernible. There is a comment from the 3rd Master beside it: second nature.) ... And that, is the truth... Yet there is none... How shall it be granted? How shall it be revealed?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080316,
					"content": "\"...Renovate the library. Design... within, and...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080317,
					"content": "\"...Look with the <color=#00E1FFFF>eyes</color>, and combine <color=#00E1FFFF>scrolls of knowledge from all places</color> with <color=#00E1FFFF>chambers of all corners</color>, then...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080318,
					"content": "(The next few pages are smudged and unintelligible. There is a comment from the 3rd Master at the side: This advises future generations to read extensively.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080319,
					"content": "Continue reading.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "\"...Recovered from injury. The little Bai kid visited with mutton and fish. Plump, delicious, and without any pungent smells. I asked for the recipe... Passed down the Life Ender technique... Recorded here.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080322,
					"content": "(The following pages contain detailed records of various methods of cooking mutton.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Guhua Notes\""
				},
				{
					"id": 711080320,
					"content": "I've had enough. It's such a mess...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "I've had enough. The training process isn't recorded at all...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "I've had enough of this nonsense...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
