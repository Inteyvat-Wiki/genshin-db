			"dialogs": [
				{
					"id": 413400701,
					"content": "Ah, you're here. I've already written my wish on the lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400702,
					"content": "This is good timing... Let's release this lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400801,
					"content": "As for my wish... I ultimately wished for everyone in Liyue to be healthy and well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400802,
					"content": "And as for Bubu Pharmacy's business?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "Well, this was my personal wish, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400804,
					"content": "I put prescriptions together because I do not wish for people to be tormented by illness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400805,
					"content": "There's an old saying that sums this up nicely: \"Dusty old medicine sat on the shelf, a small price to pay for a world of good health.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400806,
					"content": "Not to mention that I'd be less busy if everyone remained healthy! That'd be a good thing, in my books...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400807,
					"content": "...Oh no! I've suddenly remembered! There's still a customer I haven't delivered medicine to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400808,
					"content": "I'm sorry — I have to go! Happy Lantern Rite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herbalist Gui"
				}
			]
		},
