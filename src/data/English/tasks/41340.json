			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herbalist Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "Thanks for your help. Have all the medicines been delivered?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400402,
					"content": "I don't think any of them learned their lesson...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "Well, there's not much we can do about that. Stomach problems won't go away unless you watch your lifestyle. The best we can do is treat the symptoms whenever they show up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400405,
					"content": "But I suppose that I can rest easy for now, at least...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400406,
					"content": "So, what about Xiao Lanterns...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "Oh... We don't generally release lanterns. The whole point of Xiao Lanterns is to make a wish, right? Well... What sort of wish would Bubu Pharmacy even make?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400408,
					"content": "Other businesses may wish for their business to thrive and boom, but a pharmacy is in the business of curing disease and saving lives... we can't exactly wish for more sick people, can we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400409,
					"content": "You've got a good heart, Gui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "Heh... Well, on a more personal level, of course I'd love to join in. I mean, it is a festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400412,
					"content": "But I haven't made much headway in constructing a Xiao Lantern. These last few days have been much too busy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400413,
					"content": "I can only steal a few moments during my breaks to work on it, and even then I'm sure the Lantern Rite will be over by the time I finish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400414,
					"content": "I can help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "W—Will you really? Wow, thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400410,
					"content": "You're an honest man.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400403,
					"content": "You're likely to hear from them again soon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				}
			]
		},
		{
