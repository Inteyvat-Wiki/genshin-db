							"4134003",
							"2"
						],
						"stepId": 4134003,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134001",
							"3"
						],
						"stepId": 4134001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "Ugh, I must've eaten something that didn't agree with me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400202,
					"content": "Here's some medicine from Herbalist Gui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "Oh, thank you. This is that stomach medicine I asked him for, isn't it? I think I might be getting indigestion... my stomach's feeling mighty terrible right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400204,
					"content": "I was just strolling through the city streets, having a bite to eat here and there, and before I knew it, I'd overeaten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400205,
					"content": "What did you eat...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "Hmm, fried rice, raw fish, some fruit, lots and lots of shrimp... Ah yes, and some excellent wine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400207,
					"content": "Well, that explains it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "Well, that's what medicine is for, isn't it? Think about it — what's the point of a festival if you can't eat whatever you like?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400210,
					"content": "Thanks for bringing the medicine, either way. I should probably take this opportunity to rest as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400208,
					"content": "You shouldn't overindulge, even during a festival.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
			"id": 4134003,
			"completionStepIds": [
				4134004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
