			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanhai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "Ow, ow, ow... It hurts... Excuse me? D—Did you want something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400302,
					"content": "Here's some medicine from Herbalist Gui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "Wow, thanks! Just what I ordered... Fast turnaround time, I must say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400304,
					"content": "Ahh, I feel better already. Must've caught a chill last night from the sea breeze, I'll wager...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400305,
					"content": "No indigestion for you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "Hah, indigestion? Me? I'll have you know that I have an iron stomach — why, I ate three grilled fish in one sitting for my last meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400307,
					"content": "Even now, not one of my friends can match my prowess at eating and drinking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400308,
					"content": "Alright, enough about that. I'd better finish this medicine real quick — I've got a drinking session to get to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400309,
					"content": "Make sure to take care of yourself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "Hahaha, oh, don't worry about me. I'm not some old fogey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400312,
					"content": "Still, thanks for the concern. I'll be careful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400310,
					"content": "Don't wait until your health is ruined.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
		{
			"id": 4134004,
			"completionStepIds": [
				4134007
