	"talks": [
		{
			"id": 4134001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134001",
							"2"
						],
						"stepId": 4134001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herbalist Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "I'm sorry to trouble you during this festive time, Traveler, but we're a little in over our heads at the moment. The number of people requiring medicine from Bubu Pharmacy always peaks during the Lantern Rite period.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400102,
					"content": "Why does that happen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "During the Lantern Rite, everyone puts their work aside to spend time with their families. Of course, there will be all manner of banquets, with fine food and drink flowing all around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400104,
					"content": "Suddenly, everyone's got indigestion, or else they're coming down with some malady or other...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400105,
					"content": "I'm always encouraging people to not eat too much, but during a food-driven festival like this, my advice tends to fall on deaf ears.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400106,
					"content": "Just now, a few more customers contacted me, asking if I could bring them some medicine for indigestion and other stomach problems. But I can't simply stop manning the pharmacy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400107,
					"content": "Traveler, if it's alright with you, could you help me deliver some medicine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herbalist Gui"
				}
			]
		},
		{
			"id": 4134002,
			"completionStepIds": [
				4134003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
