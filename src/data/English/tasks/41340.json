			"dialogs": [
				{
					"id": 413400501,
					"content": "Ah, it's you. Have you finished that Xiao Lantern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400502
					],
					"speakerTitle": "Herbalist Gui"
				},
				{
					"id": 413400502,
					"content": "Here it is.",
