			"dialogs": [
				{
					"id": 102010301,
					"content": "A gateway to a domain! The Abyss Mage must have snuck inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010302,
					"content": "Then he has no way out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "*panting* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010305,
					"content": "Klee, do you need a rest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010306,
					"content": "Why don't you wait here while we get your treasure back for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010307,
					"content": "...No, I'm coming with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010308,
					"content": "It's my treasure that Mr. Fluffball stole, and it's up to me to get it back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010309,
					"content": "I admire your courage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "Hee-hee, don't worry. Klee is a big girl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010312,
					"content": "#Come on, {F#Miss}{M#Mr.} Honorary Knight! Let's goooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010310,
					"content": "But these domains can be dangerous.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "Let's keep up the chase.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
		{
			"id": 1020104,
			"completionStepIds": [
				1020111
