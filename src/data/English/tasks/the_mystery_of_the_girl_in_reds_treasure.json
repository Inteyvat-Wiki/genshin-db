			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "Hmph. You followed me. I must say, I'm impressed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010402,
					"content": "But this is as far as you will get.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010403,
					"content": "Oh yeah? What are you gonna do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "Mwuhahaha! Ahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010405,
					"content": "Oh, the human proclivity to gossip has provided us with everything we need...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010406,
					"content": "We learned that your little red friend had in her possession the most powerful treasure in all of Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010407,
					"content": "That treasure is now in my hands. There is nothing you can do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010408,
					"content": "Now your precious treasure shall be your undoing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010409,
					"content": "No, no, wait! D—Don't touch it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "Hah! Oh, how you fret now your predicament is finally clear to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010411,
					"content": "Now, what have we here — a flame symbol? Mwuhahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010412,
					"content": "*bang*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Abyss Mage"
				},
				{
					"id": 102010501,
					"content": "NO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010502,
					"content": "I broke the survival rules... \"Explosions can hurt people... Jean can be dreadful...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010503,
					"content": "This is it... This time I'm done for... *sobs*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010505,
					"content": "Wait, so Klee's treasure is a bomb!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010506,
					"content": "That was epic...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "No wonder Klee was rumored to be the strongest fighter in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010509,
					"content": "Paimon for one is never picking a fight with her. Ever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010510,
					"content": "Hold on... Why has she gone and run off?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010511,
					"content": "Something to do with the survival rules...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "Seems like it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010514,
					"content": "Well then, let's head to the <color=#00E1FFFF>Knights' headquarters</color> and report to Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010512,
					"content": "Something to do with Jean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010507,
					"content": "It made short work of that Abyss Mage!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				}
			]
		},
