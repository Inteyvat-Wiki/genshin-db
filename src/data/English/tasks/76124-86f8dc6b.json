				]
			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "Excellent! That's a wrap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240302,
					"content": "Thank you both, that was a real delight. Your skills are truly impressive, blond youngster. I daresay you're far stronger than that kid Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240303,
					"content": "Well done me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "Thanks to the two of you, I've had a rare moment of insight myself. Fish paste really does need a bit of freshly minced meat mixed in to bring out the flavor. Leave it too long, and there's no masking the fishiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240307,
					"content": "Ah, fair point... Hmm? Wait... that doesn't seem related at all, does it!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240308,
					"content": "Haha, never mind such trifles! Next time I have Castiglione paint me a few more fish, I'll treat you both to some proper fish paste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240304,
					"content": "It wasn't a big deal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "No need to be modest. Your swordplay is strong — that much I can tell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Jinggui"
				}
			]
		},
