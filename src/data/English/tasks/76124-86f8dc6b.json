					"content": "Among these bamboo dummies, some are <color=#00E1FFFF>dressed in blue</color> while others are <color=#FF5E41FF>dressed in red</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240205,
						761240206
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240205,
					"content": "Oh, like those at Wangshan Hall...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				},
				{
					"id": 761240207,
					"content": "Oh, Paimon remembered too! We have to attack the dummies <color=#00E1FFFF>in blue</color> without hitting a single dummy <color=#FF5E41FF>in red</color>, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240208,
					"content": "Exactly. In that case, I won't waste any more breath. Show me what your sword can do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240206,
					"content": "I know the rules.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				}
			]
		},
		{
