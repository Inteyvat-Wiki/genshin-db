				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "Huh? Looks like there's another painting over here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240402,
					"content": "Aha, very sharp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240403,
					"content": "A bunch of youngsters calling themselves heirs of the Guhua Clan once commissioned Castiglione to paint it. They claim it's their prized \"training ground.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240404,
					"content": "But they're an awfully proud lot. Think themselves peerless masters already, far above such basic drills. So they handed the painting off to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240405,
					"content": "Wait... Aren't you with the Guhua Clan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240406,
					"content": "Well, I'd love to claim that. Alas, that lad Guhua probably wouldn't dare take me in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240407,
					"content": "Back when we were clearing out bandits at Guili Plains, the boy nearly got himself killed for lack of proper training. I had no choice but to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240408,
					"content": "Ah, never mind. Old, uninteresting business. Though this painting, now... that's another matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240409,
					"content": "If you're curious, go on and unroll it. No great loss if you tear it — Castiglione's idle most days anyway. I'll have him paint another.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		}
	]
}