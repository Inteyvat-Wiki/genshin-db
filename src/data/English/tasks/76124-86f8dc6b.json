			"dialogs": [
				{
					"id": 761240101,
					"content": "Heh... No matter how many times I see it, it still makes no sense to me. I've never heard of anyone honing their swordsmanship by chopping bamboo. That lad Guhua really did have some strange ideas in that head of his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240102
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240102,
					"content": "Bamboo can be woven into baskets, carved into slips, shaped into flutes or tally rods, even made into writing brushes. But using it as stakes or training weapons? Now that's a new one. Quite the innovation, I suppose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240103
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240103,
					"content": "Alright then, you two! Since the scroll has been unrolled, I'll speak on behalf of those little Guhua Clan disciples and lay out the rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240104
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240104,
					"content": "Among these bamboo dummies, some are <color=#00E1FFFF>dressed in blue</color> while others are <color=#FF5E41FF>dressed in red</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240105
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240105,
					"content": "The first stage of this trial is simple: strike the ones in <color=#00E1FFFF>blue</color>, and do not hit the ones in <color=#FF5E41FF>red</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240106
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240106,
					"content": "If you're ready, you may begin at any time. Let me witness the sharpness of your blade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		},
