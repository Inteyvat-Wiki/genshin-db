			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ash"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718030301,
					"content": "Meow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030302,
					"content": "Huh? Why would there be a cat here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030303,
					"content": "Meow... Meeeow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030304,
					"content": "A gray cat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "A gray cat, lost in the wild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "Ah, Lan mentioned a commission to look for a gray cat. Maybe this is the one! Paimon remembers that it was called Ash or something like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "Who'd have thought that we'd find it here... Has it been hiding around here all this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Guess the Stonehide Lawachurl prevented anyone from searching for it here, and since it was too scared to leave, it just hid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "Sure is lucky that we came over, or it might've had to wait for a while longer, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Meow... Meow, meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030314,
					"content": "Meow... Meeeow...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Hey, what are you doing? Paimon doesn't think it understands what you're saying anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Let's just bring it back to Lan, and let her return it to the person who put the commission up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Meow... Meow! Meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030320,
					"content": "Meow... Meow! Meow!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Oh, come on! It's not going to understand you no matter how hard you try to copy it. Let's just bring it with us already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "It seems to agree with us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "How did you even— never mind. Let's just bring it back to Lan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "Let's take the cat back to Lan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Yup, guess that's all we can do right now. She'll return it to the person who put that commission up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030308,
					"content": "Maybe it's Ash...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "A gray cat, lost in the wild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030310,
					"content": "You're right! Lan mentioned that commission earlier, didn't she? Huh. Who'd have thought that we'd find that cat here... Has it been hiding around here all this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
