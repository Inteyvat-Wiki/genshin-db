			"dialogs": [
				{
					"id": 718030401,
					"content": "Have you defeated the Stonehide Lawachurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030402,
						718030404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030402,
					"content": "Sure did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "Thanks, you've done us a favor. With this commission under our belt, we'll have no problem proving the Guild's ability.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030404,
					"content": "We defeated it, and we also found Ash...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030405
					]
				},
				{
					"id": 718030405,
					"content": "Thanks, you've done us a fav— say what now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
