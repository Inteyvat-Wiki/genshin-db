			"dialogs": [
				{
					"id": 718030201,
					"content": "<color=#00E1FFFF>Ash</color>, huh... The description is detailed enough, sure, but it's not going to be easy finding a cat that's lost out in the wild.",
					"roleType": "TALK_ROLE_NPC",
