			"dialogs": [
				{
					"id": 718030501,
					"content": "Meow, meow... Meow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030502
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030502,
					"content": "This cat is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030503,
					"content": "It might be Ash.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030504
					]
				},
				{
					"id": 718030504,
					"content": "Give me a moment, let me check its features against the list of features written down in the commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030505,
					"content": "Let's see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030506
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030506,
					"content": "It mostly checks out. This seems to be the cat we're looking for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030508
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030508,
					"content": "The commissioner should be pleased.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030509
					]
				},
				{
					"id": 718030509,
					"content": "Hah. After all those twists and turns, we came right back to looking for lost cats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030510
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030510,
					"content": "I'm really not sure what to say...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030511,
					"content": "I'll report these commissions to their commissioners. Thank you very much — please accept this as compensation for doing us this favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030512,
					"content": "Hmm, it seems that the commissioner for the cat-related commission has since moved. It'll take some time to contact them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030513,
					"content": "Guess I'll just have to take care of this rascal in the meantime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030514
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030514,
					"content": "Meow-meow, meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ash"
				}
			]
		}
