			"dialogs": [
				{
					"id": 221020201,
					"content": "How's it coming along? All clear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020202,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020203
					]
				},
				{
					"id": 221020203,
					"content": "Okay, please be as quick as you can. The chef has run out of supplies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020204,
					"content": "I could go and sort it myself if it came to it, but that's a last resort.",
