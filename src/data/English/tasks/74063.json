							4576.324
						],
						"pointId": 6249
					}
				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "Huh? What's a Kamera doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630202,
					"content": "\"Where there's news, there's Kameras.\" Have you never heard that before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630203,
					"content": "I think I have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "But I just made that up, so where did you hear it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630205,
					"content": "Well, there really isn't anything new under the sun, anyway. No matter what I say or write, it is always but a parody of others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630208,
					"content": "The Kamera is here, so where's the news?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "Well... News is like fishing. It requires patience and making the right judgment at the right time. That's how you hook really big fish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630210,
					"content": "Oh! I mean... That's how you hook a scoop. Hmm? Wait, that doesn't sound right! Ugh! Forget it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630211,
					"content": "That sounds a bit amateurish. You're not a journalist, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "Then you've misjudged me, heh. I'm an amateur journalist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630222,
					"content": "Anyway, what's an amateur journalist like yourself doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630223,
					"content": "I'm here to complete the project assigned to me — to capture the most vivid moments of the Fortress of Meropide guards at work with my Kamera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630224,
					"content": "But I spent too much time completing the required compliance documents... Just take a look and you'll understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630225,
					"content": "Nelly takes out a stack of documents, all packed with various contractual clauses and signatures. Just looking at them makes you feel dizzy...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "By the time I completed all the procedural paperwork, I missed the guards at work during their shift! Or in fishing terms, there aren't any fish in the water right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630227,
					"content": "Huh? But there are guards on duty here right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630228,
					"content": "But I want to hook a Platinum Collection. I don't think an Initial Configuration or Water Body Cleaner has enough impact... That way, even if I complete my project, other photographers might not think it worthy of praise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630229,
					"content": "Stop being so picky if you don't want to return empty-handed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "You're right. I need to come to terms with my own limited abilities, and stop trying to catch fish that are beyond me... *sob* I'm such a useless angler... Oh, wait, I mean amateur journalist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630234,
					"content": "Alright, no more wallowing in self-pity. Time to cheer up! If it's alright with you... Could you do me a small favor? Please! I'll pay you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630235,
					"content": "Whoa! That was fast... Well, it depends on the favor. So, why don't you tell us what it is first?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630236,
					"content": "The guard over there, Grainville. Based on my judgment, his news value among guards is equivalent to that of a Situation Controller among maintenance meks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630237,
					"content": "I should be able to write a good report with him as my subject... Well, I can keep myself from getting criticized, at least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630238,
					"content": "But he just refuses to come over here! So, could you bring him to a suitable spot for me to take a snapshot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630239,
					"content": "Why don't you just explain it to him yourself and get him to come over that way?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "Knowing about the Kamera will make him focus on it and stiffen up, that would make the photo too staged!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630243,
					"content": "Let me think. It's best if we turn off the loudspeaker, report it to Grainville as a malfunction, and ask him to come have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630244,
					"content": "Then I'll definitely be able to capture a vivid moment of a Fortress of Meropide guard at work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630245,
					"content": "My project's completion depends on this! I'm counting on you! Please help me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630246,
					"content": "#It doesn't sound difficult, {NICKNAME}. Maybe we should help her out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630241,
					"content": "Can't you just take your Kamera over to him?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Well... The view is better here. And if he sees the Kamera, I'm sure he'll focus on it and leave me with nothing but a bunch of stiff poses to work with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630230,
					"content": "Well, you keep on waiting then. See ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "You're just leaving? Really? Aren't you going to help me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630232,
					"content": "Well... It's not like we can just magically conjure up the Platinum Collection you want!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630213,
					"content": "Never mind the news, I like fishing too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "Really? That's perfect! Actually, I'm just a novice angler, and I've got a bunch of questions but didn't know where to turn for advice. For example, if you hook a maintenance meka and it bites... What would you do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630215,
					"content": "Just release it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "I see, I see, so that's how you'd choose to handle it. Hmm, it's a very valuable reference. I will commit it to memory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630220,
					"content": "Huh!? How did we end up talking about fishing? You're really good at steering the conversation!, huh? It seems I have much to learn as an amateur journalist...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630221,
					"content": "But it was you who brought up fishing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630216,
					"content": "Beat it up and show it who's boss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "Cook it for Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#Whoa! Paimon really believes in your cooking, {NICKNAME}, but no matter how you look at it, those just aren't edible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630206,
					"content": "Nope.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "Oh! Well, you've heard it now! Don't forget that if you do happen to use it anywhere else, you must cite the source — namely, me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
			"id": 7406303,
