				"objectNames": [
					"Nelly"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630301,
					"content": "I must take a photo so good that all the other photographers will gain new levels of respect for me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630302
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630302,
					"content": "I still want the Platinum Collection though... Agh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
			"id": 7406304,
			"completionStepIds": [
				7406304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406304",
							"2"
						],
						"stepId": 7406304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grainville"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "Hi, we found a loudspeaker that seems to be malfunctioning... It's over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630402,
					"content": "Again? That's strange... I just got Clynes to repair it. Looks like he's not even as good at fixing things as I am. I mean, all you gotta do is give machines a couple of good smacks, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630403
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630403,
					"content": "Anyway, thanks, I'll go have a look.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630404
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630404,
					"content": "Thanks for your help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7406305,
			"completionStepIds": [
				7406305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406305",
							"2"
						],
						"stepId": 7406305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nelly"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4425.106,
							38.6,
							4575.071
						],
						"pointId": 4928
					},
					{
						"sceneId": 3,
						"position": [
							4425.029,
							38.634,
							4576.324
						],
						"pointId": 6249
					}
				]
			},
			"dialogs": [
				{
					"id": 740630501,
					"content": "I've finally completed my project! I'm a journalist in my own right now! Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630502
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630502,
					"content": "You must have snapped a really excellent picture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630503,
					"content": "Yeah, take a look at this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630504,
						740630506
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630504,
					"content": "It doesn't look very vivid, but it's artistic alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630505
					]
				},
				{
					"id": 740630505,
					"content": "Paimon doesn't understand art at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630508,
					"content": "Will it really be okay to just use this one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630509,
					"content": "What's wrong with it? I think it's a great shot! I'm sure no one would have expected me to snap a shot like this one! They will all be so surprised...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630510
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630510,
					"content": "Paimon really doesn't get your standards for artistic critique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630511,
					"content": "Oh, it's called \"symbolic meaning over substance.\" I'm sure all experienced photographers will understand once I submit it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630512
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630512,
					"content": "Anyway, thank you. This is for you. Hehe, it would be great if we could chat at a fishing spot next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630506,
					"content": "It's so vivid it almost seems like it will start moving any moment now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630507
					]
				},
				{
					"id": 740630507,
					"content": "Hmm, Paimon might get dizzy if she looks at it any longer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "Paimon"
				}
			]
