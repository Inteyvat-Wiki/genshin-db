				"objectNames": [
					"Lohen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "Oh? Let me see. Hmm... The concept's not bad. I'd give the creativity a six out of ten. As for practicality... maybe a four.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090502,
					"content": "I-Is this a crime plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090503,
					"content": "Haha. Funny enough, I came over from the base because I heard rumors that someone around here was plotting some strange \"master plan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090504,
					"content": "...But after reading this note, I think I understand how those rumors got started.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090505,
					"content": "I'll hand this over to the Knights just in case. And if you're free later, stop by my base. You might catch something worth watching.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		}
	]
}