			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "I... I sense \"reason.\" Visitors, are you the successors to Narzissenkreuz, or are you a threat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650102,
					"content": "You have drawn your weapons. I see your answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650103,
					"content": "Narzissenkreuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650104,
					"content": "Huh? This thing's Narzissenkreuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650105,
					"content": "If you have heard my name, then you know of my quest to save the world, and there is a chance that you can be saved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650106,
					"content": "You draw your weapons at me only because you have been misled by untruths. But this is no time for me to waste my powers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650107,
					"content": "Wonder and rejoice. When all is over, I shall explain, I shall demonstrate. But now, place the Holy Blade in my hand and flee to safety.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650108,
					"content": "We're not giving you the Holy Blade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650109,
					"content": "Foolish, foolish. But I forgive you and will save you nevertheless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650110,
					"content": "I can sense that the four orthants have been reversed. But the tree of flowing is not yet complete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650111,
					"content": "It is no longer possible to save everyone. I will extend my benevolence as far as possible, even if it makes an overdraft of my own life force.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650112,
					"content": "If only five in ten can be saved, I will strive to save six in ten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650113,
					"content": "Now, I shall come to take the Holy Blade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416502,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
