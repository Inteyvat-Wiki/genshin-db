							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					},
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "Impossible... I had already reached the stage of \"no return.\" How have I fallen to this point?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650202,
					"content": "And I have lost all control of the Primordial Sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650203,
					"content": "Why, why has this happened? Why, why did you do this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650204,
					"content": "The new world cannot be born. All will die in a shell, a husk of a dream!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650205,
					"content": "Paimon reckons you're the one who should try waking up from your dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650206,
					"content": "The end of the world is the kind of thing that everyone should work together to stop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650207,
					"content": "I see. The Holy Blade is not on my side. With each swing, it cuts through the universal will that surrounds me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650208,
					"content": "Until, at last, my weak, ordinary self has returned to its physical body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650209,
					"content": "The Primordial Sea won't overflow its banks so soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "Indeed, I can sense changes in the values originally entered into the world-formula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650211,
					"content": "Someone has seized control of the life-force, and someone has opened the beast-realm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650212,
					"content": "And then, there is one more variable. That is you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650213,
					"content": "The person fated to see the all-consuming whale put to flight. The one who shall witness all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650214,
					"content": "I see, I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650221,
					"content": "I once dreamed of becoming one just like you. But that dream is now shattered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650222,
					"content": "All I have done is meaningless. An empty dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650223,
					"content": "No, less than a dream, even. A dream is at least harmless. But I... No, you, and they... have paid so much for all I have done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650224,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650225,
					"content": "Oh, it's you. I didn't see you there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650226,
					"content": "Do you know who I actually am?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650227,
					"content": "Names are just labels. But yes, I am most familiar with the two colors that mix in your soul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650228,
					"content": "Director Lyris does not know what has happened. She just holds onto Mary-Ann, who herself still clings to life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650229,
					"content": "She cannot understand such a complex present and future, and hopes just to retain the past. And so, she does the only thing she can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650230,
					"content": "My name is Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650231,
					"content": "In that case, hello, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650232,
					"content": "I am willing to forgive you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650233,
					"content": "What an odd thing to say. From the very start, my plans have had lofty and sacred aims. Selfishness has never come into it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650234,
					"content": "None may judge or criticize me, nor do I need forgiveness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650235,
					"content": "Your aims may have been lofty, but your insanity has harmed many.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650236,
					"content": "You did not even enter the formula correctly... and what's wrong with being forgiven for a mistake?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650237,
					"content": "...You are right. I apologize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650238,
					"content": "So please, Narzissenkreuz, come back with us. There are other people you need to see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650239,
					"content": "This guy seems to have become much more cooperative. But a request like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650240,
					"content": "Of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650241,
					"content": "Huh? Doesn't this sorta thing usually require some inner struggle and hours of persuasion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650242,
					"content": "As I have said before, I do not feel that I have done anything wrong. My mission has failed, but the world has been saved nonetheless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650243,
					"content": "Let others mock and curse me. I am empty within now. Only one desire remains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650244,
					"content": "What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650245,
					"content": "I, too, wish to return to the very beginning — to the time before the Narzissenkreuz heroes set off on their journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650246,
					"content": "But that's impossible. We are not masters of our own fate. I no longer even have the power to determine my own dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650247,
					"content": "#Well, Knight {NICKNAME}, when you're ready, we'll proceed to reseal the primordial waters, and then we'll leave this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650215,
					"content": "That creature has already been defeated.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "I should have sensed the changes in the values originally entered into the world-formula. A \"variable\" has descended upon this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650217,
					"content": "Not everything from outside the universe can be called a \"presence\" or \"variable.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650218,
					"content": "But it seems I overlooked one nonetheless. You.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650219,
					"content": "The witness of all, the recorder of all, the designer of all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650220,
					"content": "Only one who is worth a world can bear that title.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416503,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7416505",
							"2"
						],
						"stepId": 7416505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650301,
					"content": "Impossible... I had already reached the stage of \"no return.\" How have I fallen to this point?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650302
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650302,
					"content": "And I have lost all control of the Primordial Sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650303
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650303,
					"content": "Why, why has this happened? Why, why did you do this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650304
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650304,
					"content": "The new world cannot be born. All will die in a shell, a husk of a dream!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650305
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650305,
					"content": "Paimon reckons you're the one who should try waking up from your dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650306,
					"content": "The end of the world is the kind of thing that everyone should work together to stop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650307,
					"content": "I see. The Holy Blade is not on my side. With each swing, it cuts through the universal will that surrounds me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650308
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650308,
					"content": "Until, at last, my weak, ordinary self has returned to its physical body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650309
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650309,
					"content": "The Primordial Sea won't overflow its banks so soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650310
					]
				},
				{
					"id": 741650310,
					"content": "Indeed, I can sense changes in the values originally entered into the world-formula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650311
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650311,
					"content": "Someone has seized control of the life-force, and someone has opened the beast-realm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650312
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650312,
					"content": "And then, there is one more variable. That is you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650313
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650313,
					"content": "The person fated to see the all-consuming whale put to flight. The one who shall witness all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650314
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650314,
					"content": "I see, I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650315
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650315,
					"content": "I once dreamed of becoming one just like you. But that dream is now shattered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650316
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650316,
					"content": "All I have done is meaningless. An empty dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650317
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650317,
					"content": "No, less than a dream, even. A dream is at least harmless. But I... No, you, and they... have paid so much for all I have done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650318
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650318,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650319
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650319,
					"content": "Oh, it's you. I didn't see you there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650320
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650320,
					"content": "Do you know who I actually am?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650321
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650321,
					"content": "Names are just labels. But yes, I am most familiar with the two colors that mix in your soul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650322
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650322,
					"content": "Director Lyris does not know what has happened. She just holds onto Mary-Ann, who herself still clings to life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650323
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650323,
					"content": "She cannot understand such a complex present and future, and hopes just to retain the past. And so, she does the only thing she can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650324
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650324,
					"content": "My name is Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650325
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650325,
					"content": "In that case, hello, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650326
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650326,
					"content": "I am willing to forgive you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650327
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650327,
					"content": "What an odd thing to say. From the very start, my plans have had lofty and sacred aims. Selfishness has never come into it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650328
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650328,
					"content": "None may judge or criticize me, nor do I need forgiveness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650329
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650329,
					"content": "Your aims may have been lofty, but your insanity has harmed many.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650330
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650330,
					"content": "You did not even enter the formula correctly... and what's wrong with being forgiven for a mistake?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650331
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650331,
					"content": "...You are right. I apologize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650332
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650332,
					"content": "So please, Narzissenkreuz, come back with us. There are other people you need to see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650333
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650333,
					"content": "This guy seems to have become much more cooperative. But a request like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650334,
					"content": "Of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650335
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650335,
					"content": "Huh? Doesn't this sorta thing usually require some inner struggle and hours of persuasion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650336,
					"content": "As I have said before, I do not feel that I have done anything wrong. My mission has failed, but the world is still fated to be saved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650337
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650337,
					"content": "Let others mock and curse me. I am empty within now. Only one desire remains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650338
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650338,
					"content": "What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650339,
					"content": "I, too, wish to return to the very beginning — to the time before the Narzissenkreuz heroes set off on their journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650340
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650340,
					"content": "But that's impossible. We are not masters of our own fate. I no longer even have the power to determine my own dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650341
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650341,
					"content": "#Well, Knight {NICKNAME}, when you're ready, we'll proceed to reseal the primordial waters, and then we'll leave this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		}
	]
}