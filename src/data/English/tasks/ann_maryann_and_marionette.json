			"dialogs": [
				{
					"id": 742530201,
					"content": "Life is best when all is peaceful and calm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530204,
					"content": "Is that the time? Haha. We should get together more often, Miss Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
