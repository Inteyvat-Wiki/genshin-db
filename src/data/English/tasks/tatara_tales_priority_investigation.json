		{
			"id": 7211503,
			"completionStepIds": [
				7211508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211508",
							"2"
						],
						"stepId": 7211508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150301,
					"content": "Have you placed those beacons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150302,
					"content": "Yep.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "Well done, now all we have to do is to let them collect the data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150304,
					"content": "How did you know where to put them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "I was part of the design team for the Mikage Furnace. By placing beacons in these locations, we can gather data on almost all the areas inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150306,
					"content": "Hmm, you know, if we set up purifying devices in these locations, our troubles would be over overnight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150307,
					"content": "If Mr. Flois knew half of what had happened here, he'd go completely ballistic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150311,
					"content": "Alright, thanks for your help. Please take these as compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150312,
					"content": "Ahem, one other thing... I may possibly, probably, definitely need you to help me retrieve the beacons again at some point over the next few days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150313,
					"content": "I don't have a Vision, after all, so I can't simply stroll into somewhere with such a high concentration of Tatarigami energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150314,
					"content": "Not to mention that those, hmm, rough-and-tough Fatui folks are still there. I honestly think you are the only person on this whole island capable of dealing with them and the furnace at the same time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150308,
					"content": "Are these beacons for sale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150309
					]
				},
				{
					"id": 721150309,
					"content": "You jest! Even if I sold them to you, what would I use then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150310,
					"content": "Seriously, though, if you ever visit Fontaine, I can put you in touch with someone who will sell them to you at a very fair price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Xavier"
				}
			]
		}
	]
}