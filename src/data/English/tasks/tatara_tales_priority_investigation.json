				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "#Hello there, my dear, gallant {F#girl}{M#boy}! I have good news and bad news regarding the Mikage Furnace. Which would you like to hear first?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150102,
					"content": "Let's have the good news.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "The good news is that the core's only suffered some minor damage. It is still within my power to fix it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150104,
					"content": "The bad news, however, is that the Fatui poking around in there don't seem to appreciate this piece of good news.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150105,
					"content": "They very much seem to be searching for a way to get their grubby hands on the Tatarigami core.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150111,
					"content": "But if we let them meddle any further, the Tatarigami's power will get out of control. This entire island will be blown sky-high with us still on it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150112,
					"content": "However, if we focus solely on the Fatui, the Tatarigami energy built up inside the containment dome will eventually reach its limit all the same...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150113,
					"content": "So we need to deal with both of them at the same time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "Well... Put simply, academically speaking, in an objective sense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150115,
					"content": "We are facing two separate problems here: the Fatui and the Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150116,
					"content": "But with how the situation is inside the Mikage Furnace, whichever problem we choose to tackle, we're likely to have to face the other in the process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150117,
					"content": "So, ultimately, the fact of the matter is—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150118,
					"content": "You mean to say, \"yes.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "Um, yes, that's correct. We need to deal with both of them at the same time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150120,
					"content": "But one step at a time. As the Liyue saying goes, \"don't rush to eat hot tofu, or you'll burn your tongue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150121,
					"content": "How come you know Liyue proverbs?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "We've been to Liyue before. I'd consider this little gem of wisdom a souvenir from the trip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150123,
					"content": "I have a lot more of these souvenirs where that one came from. I must confess to having imbibed all of my \"souvenirs\" from Mondstadt, though... they were really very good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150124,
					"content": "Let's get back on track. I have a teensy-tiny plan to fix this Mikage Furnace situation, but I will need your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150125,
					"content": "You got it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "Ha! Forthright and ready for a fight! That's what I like about you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150131,
					"content": "Ahem. I digress. Now, hold on to these Sensor Beacons, if you please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150132,
					"content": "I need you to place them in a number of locations for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150133,
					"content": "What these Sensor Beacons will do is gather data on the density and distribution of Tatarigami energy within the Mikage Furnace. Once armed with this data, I should be able to come up with a more detailed plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150134,
					"content": "Leave it to me, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "I shall leave it in your hands, indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150141,
					"content": "I will mark the locations for the beacons on your map. I'll be counting on you, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150136,
					"content": "How do these beacons work?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "The simplest way to explain it is that they are instruments that use elemental power to quantify and calculate all other sorts of energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150138,
					"content": "Well, I say \"simple,\" but it's not actually that easy to explain... But I suppose we could start from the theory of the seven elements! Now then—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150139,
					"content": "No, no, you don't need to go on.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "Well, as you wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150127,
					"content": "Well, what do I get out of this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "Hmm... how about the undiscovered treasures of this island, and some \"leftover materials\" from inside the Mikage Furnace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150129,
					"content": "I'm sure there must some things of note inside the Mikage Furnace, what with it being the largest smelting facility in Inazuma and all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150130,
					"content": "Of course, as someone who does not possess a Vision, I am unable to enter the Mikage Furnace at present, nor would I really know about what's going on in there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150106,
					"content": "*sigh* Let's hear the bad news.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "The bad news is that the Fatui are still poking around inside the Furnace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150108,
					"content": "They very much seem to be searching for a way to get their grubby hands on the Tatarigami core.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150109,
					"content": "The good news is that the core hasn't suffered much damage, so I can take care of it myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150110,
					"content": "Obviously, the Fatui will be none too pleased to hear that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				}
			]
		},
