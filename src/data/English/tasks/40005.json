			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050501,
					"content": "I see. Human stupidity is infinite in its randomness... But it is of no consequence to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050502,
					"content": "Now. I am here, at the place you insisted upon. The Mingxiao Lantern is in sight. Why did you summon me here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050503,
						400050504
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050503,
					"content": "To see the Mingxiao Lantern, of course.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "You are obviously one of the heroes this festival is all about... Why don't you want to get involved?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050506,
					"content": "I cannot be near crowds of people. Carefree, happy crowds of people... I simply cannot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050507,
					"content": "Too long have I spent suffering and slaughtering. It is all I know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050508,
					"content": "I will discuss it no further.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050509,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050510,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050511,
					"content": "Though, if while you are in Liyue you encounter any trouble of a supernatural nature, call my name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050512,
					"content": "Whether yours or Liyue's, I hear all cries for help, all prayers for peace, and all the wishes carried by the lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050513,
					"content": "Thank you... and Happy New Year.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050514
					]
				},
				{
					"id": 400050514,
					"content": "Happy New Year!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050504,
					"content": "To celebrate Lantern Rite, of course.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				}
			]
		}
	]
}