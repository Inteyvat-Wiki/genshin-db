			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050201,
					"content": "Alright, you folks from the Treasure Hoarders, yeah? I thought I insinuated in my letter there that you should have done like I done and put on a mask and a costume and so forth...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050202,
					"content": "...But it seems you didn't all get the memo. Hehehe... it's pretty cool though... gutsy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050203,
					"content": "Hmph! Well guess what? We don't need to go sneaking around everywhere wearing disguises! Because unlike you, we would never do anything so shameful that we would need to wear masks while doing it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050204,
					"content": "Really!? I was in the middle of my speech and everything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050205,
					"content": "I think he just enjoys dressing up...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "Wait a second now... You folks ain't no Treasure Hoarders! What game are you two playing!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 400050206,
					"content": "This get up is pretty cool, though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
		{
			"id": 4000504,
			"completionStepIds": [
				4000504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000504",
							"2"
						],
						"stepId": 4000504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050401,
					"content": "Tell us your diabolical plan, now! It's over, buster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050402,
					"content": "Okay! I give up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050403,
					"content": "Give up now or feel the wrath of my Paimonial... Huh? You're giving up just like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050404,
					"content": "I, uh... I'm just a lowly apprentice thief who really looks up to the Treasure Hoarders...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050405,
					"content": "An apprentice thief!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050406,
					"content": "Yeah... For a greenhorn like me, 'specially working on my own an' all... The Treasure Hoarders? Man, they're my heroes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050407,
					"content": "Wait a second, so—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050408,
					"content": "...So, I thought I'd try and set up some sorta lucrative opportunity, then submit my pledge of loyalty...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050409,
					"content": "Wait a second! None of this is making any sense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050410,
					"content": "Paimon was expecting a serial arsonist to be someone more... sinister! Evil-looking! But instead... We get you!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050411,
					"content": "...Arson? What the heck are you talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050412,
					"content": "Don't pretend! Paimon's seen you, loitering around piles of highly flammable materials!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050413,
					"content": "Oh... Oh yeah, yeah, I know where you're talkin' about. But I was only checking the place out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050414,
					"content": "My plan ain't got nothing to do with those lantern construction materials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050415,
					"content": "...Are you serious!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050416,
					"content": "I just wanted to nab me the biggest chunk of Plaustrite in twenty years is all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050417,
					"content": "I was gonna wait till nightfall, chop off half the tethers, float it out to sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050418,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050419,
					"content": "Then all I'd have to do is find some way or another of bringing it down, so I could hide it underwater in the shallows. The perfect crime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050420,
					"content": "Uhh, for a perfect crime, it sure has a lot of holes... For example, how exactly were you planning to bring down the Plaustrite once it was airborne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050421,
					"content": "I was still in the process of figuring out the details, hence why I hadn't made my move yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050422,
					"content": "This guy is an imbecile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050423,
					"content": "#Okay, {NICKNAME}, let's teach him a lesson.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050424,
					"content": "Let's go find Yaksha-man and debrief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000505,
			"completionStepIds": [
				4000505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000505",
							"2"
						],
						"stepId": 4000505,
						"stateName": "QUEST_STATE_UNFINISHED"
