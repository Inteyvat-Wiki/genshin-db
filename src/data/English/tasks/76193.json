			"dialogs": [
				{
					"id": 761930130,
					"content": "(Huh? I—Is that... a Melusine!?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930101
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930101,
					"content": "Whoa! A real Melusine! Aww... such a tiny, adorable little Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930102
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930102,
					"content": "Hmm? Who... who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930103
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930103,
					"content": "Umm... may I... touch you? I've always wondered what a Melusine like you feels like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930104,
					"content": "Something so cute and so clever... Are you smooth? Or soft? Or maybe fluffy? Hehe... don't be scared. I just want to give you a little...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930105,
					"content": "Uh... Huh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930106
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930106,
					"content": "Please mind your conduct, miss, and refrain from any actions that may violate the statutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930107,
					"content": "Miss Mamere is a citizen of Fontaine. Unauthorized physical contact may lead to misunderstandings and could carry serious legal consequences, including imprisonment for over three years and permanent prohibition from entry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930108,
					"content": "Aaaah! A machine that moves and talks...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930109,
					"content": "Ahem... my apologies. She was just too adorable, and I got carried away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930110
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930110,
					"content": "My name's Linnea. I'm an advisor working for the Adventurers' Guild. Uh... And I promise I'm not a weirdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930111,
					"content": "Negative. Individuals engaging in suspicious behavior often insist they are \"not a weirdo.\" This is a basic principle of deductive reasoning, Miss Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930112,
					"content": "Aah...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930113,
					"content": "You shouldn't just go around calling people weirdos, Seymour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930114
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930114,
					"content": "This small fairy lady has really pretty colors. She's not like Fa{RUBY#[D]Elynas}ther, but she feels warm and looks nice. That means she's not a weirdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930115
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930115,
					"content": "Negative. With the exception of purple, coloration generally bears no relation to one's moral alignment. This is a basic principle of deductive reasoning, Miss Mamere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930116,
					"content": "...I wasn't talking about the color of people's clothes, Seymour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930117
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930117,
					"content": "Huh? Why is purple an exception?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930118
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930118,
					"content": "Well... hello, Linnea. My name is Mamere. I'm a traveling painter from Fontaine. This is Seymour. He's a good friend of mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930119
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930119,
					"content": "I didn't expect to meet anyone else here. Are you here to gather inspiration, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930120
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930120,
					"content": "Gather inspiration... hmm, let me think. I suppose adding new entries to my archive counts, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930121,
					"content": "Linnea tells Mamere about the pink Frostfin Whale...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761930122
					]
				},
				{
					"id": 761930122,
					"content": "And, hehe... maybe Maisie was right after all. That Frostfin Whale really does bring good luck! I even got to meet an adorable Melusine—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930123,
					"content": "Please mind your conduct, miss, and refrain from any actions that may violate the statutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930124,
					"content": "I—I know! I won't touch anything without permission!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930125,
					"content": "I see. Do you like animals, Linnea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930126
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930126,
					"content": "Absolutely! *sigh*... if only I could swim as fast as a Melusine... Those Frostfin Whales looked like they were having so much fun. I want to play with them too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930127,
					"content": "Hmm... then I'll give this painting to you, Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930128
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930128,
					"content": "It can't help you swim faster, but if you hang it in your room... maybe it'll feel like you're playing with the Frostfin Whales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930129
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930129,
					"content": "Whoa... thank you! It's beautiful! When I get back, I'll show it to everyone in Speranza for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		}
	]
}