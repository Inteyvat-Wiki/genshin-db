				"points": []
			},
			"dialogs": [
				{
					"id": 726550101,
					"content": "Well, looks like we've finally located our target! Great! Guess I can go back to the ship and get some sleep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550102,
					"content": "What? You're gonna leave just like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550103,
					"content": "Of course not, we're so close! Let's head out right now and capture ourselves a Ruin machine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550104,
					"content": "Huh, and here Paimon thought you were going to return to the ship!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550105,
					"content": "*sigh* Well, never mind. Let's follow her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7265502,
			"completionStepIds": [
				7265503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
