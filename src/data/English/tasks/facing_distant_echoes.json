			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muzhen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550301,
					"content": "Hmm? Do you need to warm up or anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550302,
					"content": "Can you tell me anything about these ruins?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "Well, I'm a Technical Officer, so I don't know much about world history, I'm afraid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550305,
					"content": "Nonetheless, I believe these ruins to be related to the great disaster that occurred five hundred years ago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550306,
					"content": "I grew up listening to old sailors tell that tale, you know? They said that neither land nor sea could escape the reach of the Abyss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550307,
					"content": "But to me, those were no different from the ghost stories they tell to scare children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550308,
					"content": "I mean, only the terrors you can see are true, after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550303,
					"content": "Do you know anything about those mysterious machines?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				}
			]
		}
	]
}