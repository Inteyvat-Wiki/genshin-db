			"trigger": {
				"objectNames": [
					"Muzhen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726550201,
					"content": "Haha, this is the place!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550202,
					"content": "To think that there would be underground ruins here too... *gulp*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550203,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "N—Nothing, it's nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550206,
					"content": "You don't look so good. Are you unwell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550207,
					"content": "Haha. I just don't normally get off the boat, so this ruin entrance is... well, quite a sight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550208,
					"content": "Really? Paimon doesn't think so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550209,
					"content": "S—Still, the Captain's order still needs completing. I'm sure you're really curious as to what treasures lie within as well, aren't you, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550210,
					"content": "So, could I invite you, experienced and skilled as you are, to take the lead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550211,
					"content": "You're hopeless...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "That she is! Come on, Traveler, lets go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550204,
					"content": "Find anything new?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				}
			]
		},
		{
			"id": 7265503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
