			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "Paimon remembers everything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100102,
					"content": "...Good, you adapted quickly this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100103,
					"content": "At the end of last night...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "We definitely took off our Akasha Terminals last night, but we still heard that beep. Why's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100105,
					"content": "We've been implanted with another form of the terminals?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "But now, we can at least confirm one thing: The Akasha definitely has something to do with whatever's trapping us in this cycle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100108,
					"content": "Paimon doesn't get it... Why would the Akasha go this far if all it wants is everybody's wisdom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100109,
					"content": "It's extremely difficult for lab rats in an experiment to understand why they're being treated the way they are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100110,
					"content": "If we're lab rats, then what are you? Nahida, you've never told us anything about yourself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100111,
					"content": "Hmm... I guess I'm the Moon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100112,
					"content": "The Moon? Wasn't that the result of our divination?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100113,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "Anyway, knowing who I am won't help you get closer to the truth, so you should focus on other things. Don't get distracted and miss any clues~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100115,
					"content": "Okay then... Dehya helped us a lot yesterday, so let's go find her. If Paimon's reading the time correctly, those kidnappers should be showing up soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100106,
					"content": "We failed at severing our connections with them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "Ah, there you are. I've already taken care of those kidnappers. My lady, did you get hurt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100202,
					"content": "Hold on, something's not right...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "Eh? Dehya!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100204,
					"content": "What's wrong? Why are you both gawking at me like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100205,
					"content": "Y—You didn't get hurt this time!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100206,
					"content": "Huh? What do you mean, \"this time\"? Why are you so surprised that I managed to get out unscathed? Those kids were amateurs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100207,
					"content": "Aren't you still getting used to your new greatsword?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "Shhh... How did you know about my greatsword? I haven't told anyone about it. Please don't tell Miss Dunyarzad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100210,
					"content": "So Dehya's lost her memories after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100211,
					"content": "During your battle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "Anything strange...? You already know that I got a new greatsword. Hmm... if I had to say something, it's weird how such a new weapon could feel so familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100214,
					"content": "It's as if... I've already used it to fight a countless number of battles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100215,
					"content": "You're saying that although you don't remember using it, your body... feels like it does?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100216,
					"content": "That's right. Both mercenaries and warriors heavily rely on muscle memory. Only knowing the theory of battle won't get you anywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100217,
					"content": "Traveler, what do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100218,
					"content": "Could it be because we removed our Akasha Terminals?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "Yeah, Paimon's feeling really hopeful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100221,
					"content": "Is it possible that... we have already broken free?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "Ooh, you're right! Earlier in the samsara, something like this would've never happened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100223,
					"content": "We'll know for sure at the end of the day.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "I have no clue what you two are talking about, but it's still dangerous here, so—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100225,
					"content": "So you want us to take Dunyarzad somewhere else to rest while you check if there are still more kidnappers around. Right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100226,
					"content": "How did you know what I was gonna say...? Can you read minds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100227,
					"content": "Forget it, go and do your thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100219,
					"content": "This has never happened before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "Did anything feel strange?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "Your unfamiliarity usually lands you some scratches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "...Phew, it's finally nighttime. Aside from Dehya not getting injured, everything seems to have stayed the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100302,
					"content": "Listen, Nahida! We found out that Dehya got out just fine today, even though she got injured every other time she fought the kidnappers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100303,
					"content": "Do you think the samsara has been broken? Have we saved Dunyarzad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100304,
					"content": "Really? Good job on all that progress. Get some good sleep tonight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100305,
					"content": "Hey, what kind of an answer is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100306,
					"content": "\"Tomorrow will come.\" Everyone assumes this as common knowledge, but the only way you can know that for sure is if you experience tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100307,
					"content": "How many \"today\"s has it been? Is it possible that \"today\" will be followed by \"yesterday\"? Does \"tomorrow\" truly exist as anything beyond a made-up concept?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100308,
					"content": "It's even possible that this entire world is a lie, and the history of the whole world has just been one endless Sabzeruz Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100309,
					"content": "Okay, okay, no more! Paimon's brain has already shut down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100310,
					"content": "Hehe... That's why it makes no sense to waste your energy thinking about things you will learn tomorrow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100311,
					"content": "Get some good rest! Ya know... Use the bathroom and flush your anxiety dookie away~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100312,
					"content": "Huh? Hold on, what did you just say? Did Paimon hear you correctly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100313,
					"content": "Hm? People always say they feel a sense of relief after they take a dook-dook. That's why I suggested you could try that. Is that so strange?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100314,
					"content": "Ugh... It's so strange and so against common sense that Paimon is at a loss for words... You were sounding kinda smart just a minute ago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100315,
					"content": "...We're going to go get some rest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "Yeah... Even though it's happy and lively at the Sabzeruz Festival every day, it feels like it's been a long time since we've really gotten to relax. Let's go back to our room.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100317,
					"content": "*beep*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100318,
					"content": "Continue the harvest. Compared to what we stand to achieve, these sacrifices are trivial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azar"
				}
			]
		},
