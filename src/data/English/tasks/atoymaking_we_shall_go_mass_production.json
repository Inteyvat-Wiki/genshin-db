			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#Hah, {NICKNAME} and Paimon. You've arrived!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970102,
					"content": "My Toy Factory shall soon be open!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970103,
					"content": "Toy Factory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970104,
					"content": "*coughs* Well, I mean, it's just me and my Great Machine at the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970105,
					"content": "So, I streamlined the Machine's processes. Now, production should take a lot less time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970106,
					"content": "Of course, we're not talking about \"instantaneous\" levels of speed, but I would at least rate it at \"rapid.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970107,
					"content": "Wow, that sounds impressive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970108,
					"content": "Speaking of which, I made some improvements to the Material Collector as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970109,
					"content": "Previously, you'd need to come back here after each process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970110,
					"content": "I thought that was inefficient, so I made some adjustments, and now it updates the current process based on your collection progress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970111,
					"content": "So it changes the process...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970112,
					"content": "...based on what we've collected?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970113,
					"content": "I'm confused...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "Hmm, how should I put this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970115,
					"content": "Let's say that the first process requires 10 Sunsettias, the second needs Hydro and the third will see you defeating 2 Hydro Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970116,
					"content": "And let's say that now you've collected 10 Sunsettias with the Material Collector equipped. Well, in that case, it will consider the materials for the first process collected in full.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970117,
					"content": "And then it will...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970118,
					"content": "Ooh, and then it will automatically start the process of collecting materials for the next stage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970119,
					"content": "Bingo! It will enter Elemental Charge mode, which will let it collect Hydro energy. And once it finishes collecting Hydro, it will change processes again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970120,
					"content": "It will go on to the third process...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "Yep, and all you will have to do once that happens is to defeat 2 Hydro Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970123,
					"content": "That does sound a lot more convenient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970124,
					"content": "Tell me about it. I pulled an all-nighter to improve it, you know? I personally call it the ultimate foolproof three-in-one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970125,
					"content": "Huh. This Material Collector is truly amazing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970126,
					"content": "Indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "Heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970128,
					"content": "Why would you give this Material Collector to us, though?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970129,
					"content": "Hehe, I'm temporarily grounded in Ritou... So I can't collect materials at the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970130,
					"content": "Come on, help me out here. You can have a bit of the Mora from selling toys and one of the toys for free!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970141,
					"content": "Remember the ticket you got? Hehe, well, it can get you one free redemption...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970142,
					"content": "Well, as long as you've already created that particular toy model, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970131,
					"content": "Excuse me? You mean with all the materials we collected and all the effort we put in, we only deserve a bit of the Mora and one toy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970132,
					"content": "#That's preposterous! Let's get outta here, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970133,
					"content": "Wait... How about a bigger share of the profits and two... maybe three toys?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970134,
					"content": "OK, that's it. Let's go, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "Four! You can have four! But come on, that's as far as I can go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970136,
					"content": "*sigh* You could have all of them, really, if only I wasn't in debt. Sadly, I still owe the International Trade Association a sum of Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970137,
					"content": "All right, I'll let you off easy this time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "*sigh* Listen, we chose to help because you needed help, not for the Mora or toys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726970139,
					"content": "Hehe, and your aid is most appreciated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970140,
					"content": "A relief, finally...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726970121,
					"content": "It will proceed to Core Activation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}