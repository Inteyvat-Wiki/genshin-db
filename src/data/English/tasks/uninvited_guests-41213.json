			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "Albedo! We're baaaack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130102,
					"content": "Huh? It seems that he's not here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130103,
					"content": "Is he out investigating something? Or maybe he went to make some mysterious drawings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130104,
					"content": "Ah! It's you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130105,
					"content": "Oh, if it isn't Sucrose! What are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130106,
					"content": "I'm in the final stage of my research. I have five hours and twenty-six minutes of leisure time today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130107,
					"content": "So I came here looking for you to inquire about previously discussed matters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130108,
					"content": "You tell time very accurately! Are you a human clock?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130109,
					"content": "No, no, it's nothing worth your praise. You're too kind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130110,
					"content": "That wasn't a compliment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130111,
					"content": "C—Can I ask you a question, Traveler? I made a request regarding investigating Mr. Albedo's secret. Have you made any progress?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130112,
					"content": "Correct me if I'm wrong, but it's been over a week since we talked about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130113,
					"content": "I thought you'd forgotten about it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "What...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130115,
					"content": "O—Over a week? I clearly... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130116,
					"content": "I've been so absorbed in my research. That matter of ours had completely slipped my mind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130117,
					"content": "How can your sense of time be so strong and so weak at the same time...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130118,
					"content": "S—So! Do you know what it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130119,
					"content": "Yeah, you could say that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "That's great. Could you tell me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130122,
					"content": "What do you think, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "Umm... Telling her shouldn't really matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130124,
					"content": "She can take a look, too. Just no touching...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130125,
					"content": "Wait. What are you talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130126,
					"content": "What's this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130127,
					"content": "This is Albedo's secret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "It's a super powerful sword. Don't touch it with your bare hands!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130130,
					"content": "Uh... This is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130131,
					"content": "Ah! Th—This is... I've never seen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130132,
					"content": "Hehe, look all you want! Not sure why, but even Paimon feels a strange sense of achievement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130133,
					"content": "Astounding! It's the first time I've heard of such a mysterious weapon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130134,
					"content": "I can faintly feel the power coursing through the sword... It's like a living creature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130135,
					"content": "Is it such a distinct feeling?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130136,
					"content": "This may be due to my alchemist training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130137,
					"content": "I don't dare to say anything for sure, but the \"flow\" of power is very noticeable. Although this description isn't the most precise... N—Normally, I wouldn't define things like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130138,
					"content": "Please, believe me! I don't usually use such ambiguous terms!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130139,
					"content": "Okay, okay, we got it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130140,
					"content": "Traveler, could you use this sword in battle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130141,
					"content": "I'd like to learn more about it, but I'm unable to use it myself. I can only ask for your assistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130142,
					"content": "Let's keep a low profile. We can't let Albedo know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "Let's look around for the right spot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130143,
					"content": "We should find a place hidden from view.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "This is the answer you seek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "My investigation was successful.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
			"id": 4121302,
			"completionStepIds": [
				4121305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121305",
							"2"
						],
						"stepId": 4121305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "Remarkable! This weapon is like no other...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130202,
					"content": "You're also extraordinary. No matter if it's your fighting stance or the momentum of your swing, it's perfect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130203,
					"content": "You flatter me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "This sword is special. I didn't want to go too deep into the research, and yet I couldn't take my eyes off of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130205,
					"content": "Well, Paimon thinks that's one of your own special qualities, not the sword's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130206,
					"content": "Clearly this is a mysterious yet dangerous and enticing sword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130207,
					"content": "Mr. Albedo must have great confidence in you to have entrusted you with such an important item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130208,
					"content": "I'm as surprised as you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "Well, you've earned his trust with your abilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130211,
					"content": "I agree with Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130212,
					"content": "However, the sword hadn't absorbed much energy before it was handed to you... Huh, how did Mr. Albedo recognize its uniqueness among a pile of other items in storage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130213,
					"content": "A flash of brilliance often doesn't make sense. For example, Paimon's appetite for Sticky Honey Roast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130214,
					"content": "Ah... Which reminds me, I didn't eat much today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130215,
					"content": "I went looking for you right after completing my experiment. Then, on the way, I ran into an adventurer trapped in the snow. I spent quite some time saving him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130216,
					"content": "*rumbling*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130217,
					"content": "Did your stomach just rumble?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "Ah... Ahhhh! N—No, it's not like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130219,
					"content": "Don't be so shy! Just say what's on your mind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130220,
					"content": "Um, um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130221,
					"content": "Let Paimon help you out: Paimon's hungry! We should grab something to eat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130222,
					"content": "I'm hungry!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "I'm... I'm hungry. I could really go for a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130225,
					"content": "Oh... ah... I'm just a little embarassed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130226,
					"content": "Nothing to be ashamed of! Admitting that you're hungry makes the food taste better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130227,
					"content": "Huh, is that so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130228,
					"content": "Of course! Let's get moving! There must be some food back at the camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130229,
					"content": "It'd be lovely to have some Sticky Honey Roast to keep us warm in this icy weather.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130223,
					"content": "I want to eat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "I'm grateful for the faith he puts in me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
		{
			"id": 4121303,
			"completionStepIds": [
				4121307
			],
