			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Reckless Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130301,
					"content": "U—Ugh... Argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130302,
					"content": "M—Mr. Pallad!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130303,
					"content": "You still haven't gone back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130304,
					"content": "Isn't that the hotheaded adventurer from Mondstadt? Did he come here with Cyrus to explore the Snowy Mountain, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130305,
					"content": "I'm f—f—f—freezing, ACHOO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130306,
					"content": "Have you been here since I rescued you from the snow pit!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130307,
					"content": "I wanted to leave, b—but I got lost. I'm sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130308,
					"content": "U—Ugh... It's so c—cold that I c—can't move...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 412130309,
					"content": "Mr. Pallad, a trip to this mountain requires solid preparation. You shouldn't have treated it so lightly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130310,
					"content": "We'll take him back down.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "I'd appreciate the assistance. I'm afraid that, in his current state, he won't be able to walk on his own...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130312,
					"content": "Even if we can't, we won't just leave him here, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130313,
					"content": "You're right... My apologies, Traveler. I'm sure he feels bad about the situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130314,
					"content": "He's the least of your concerns right now. You should be worried about yourself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "???"
				},
				{
					"id": 412130315,
					"content": "Ah! The Fatui strike again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130316,
					"content": "You must've already figured out why we're here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130317,
					"content": "We won't let you go unless you give us that sword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130318,
					"content": "No! Please, don't give them the sword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130319,
					"content": "Of course, I wouldn't hand it over to them!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "That's the spirit! Let's knock 'em down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130322,
					"content": "Mr. Pallad, I'll take you to a safe place! Quickly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130323,
					"content": "So naive! We won't let any witness escape!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130324,
					"content": "This sword will make a fine gift for Her Excellency, Harbinger Signora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130320,
					"content": "Don't even think about putting your hands on it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
