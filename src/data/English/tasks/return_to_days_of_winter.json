				{
					"id": 200290901,
					"content": "Did you send the present to Lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290902
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290902,
					"content": "She's as pleased as punch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290903
					]
				},
				{
					"id": 200290903,
					"content": "That's good. I suppose Rudolf had his own two Mora's worth to say on the subject?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290904
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290904,
					"content": "Hmph, you don't even have to say it. No one trusts a Fatuus here in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290905
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290905,
					"content": "When are you leaving?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290906
					]
				},
				{
					"id": 200290906,
					"content": "The official order hasn't come down yet. I've just packed my things in advance, and I'll be staying at the Goth Grand Hotel for the time being — ready to leave at a moment's notice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290907
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290907,
					"content": "Come on, what's with that serious expression? Are you going to formally bid me farewell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290908,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290909
					]
				},
				{
					"id": 200290909,
					"content": "Hah, that's right. That's how it should be. We're not friends. We're just ad-hoc partners.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290910
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290910,
					"content": "If you should ever come to Snezhnaya, you can look for me there. We can continue doing business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290911
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290911,
					"content": "Alright, enough small talk. Here's your payment. Take it. I suppose this will be our last \"equivalent exchange\" here in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290912
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290912,
					"content": "*sigh* I just hope my next assignment isn't as troublesome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
