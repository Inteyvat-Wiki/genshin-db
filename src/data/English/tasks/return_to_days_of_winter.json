			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200292801,
					"content": "Well, I guess I'm finally heading home...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292802,
					"content": "Leaving us, Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200292803
					]
				},
				{
					"id": 200292803,
					"content": "Eh? Oh, it's you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292804,
					"content": "That's correct. I received orders from above recently that I can return to Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292805,
					"content": "Something about me being transferred to another Harbinger, and no longer needing to standby in Mondstadt for any new orders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292806,
					"content": "I've got no clue which of them I'll be under this time, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290107,
					"content": "When will you be leaving?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "The higher-ups didn't mention that. I was just told to pack my things and be ready to leave at a moment's notice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290109,
					"content": "I mean, that's great, right? Finally, I'll be free from the judging gazes of those Sisters!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290110,
					"content": "Ah, right, Traveler. Seeing as how we've had dealings for so long... Won't you do a man one last favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290111,
					"content": "Like before, you'll do the deed, and I'll cough up the payment. You'll never work for free when you work with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290112,
					"content": "What stories will you tell me this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Haha. To tell the truth, I'm all out of Fatui stories to tell you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290115,
					"content": "The payment this time will be Mora for sure. Sounds good?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290116,
					"content": "Well, unless you'd like me to tell you the same fairy tales I tell Lily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290117,
					"content": "What do you need help with?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "You know what? I'll come clean. The request this time also has something to do with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290121,
					"content": "She's... well, the only person in all of Mondstadt who'll listen to anything \"the evil Fatui uncle\" says — other than you, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290122,
					"content": "I doubt I'll be returning to Mondstadt ever again... So I just wanted to send Lily one last memento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290123,
					"content": "But as you know, I'd be walking into a shooting gallery if I were to just walk out there and buy something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290124,
					"content": "So I can only leave this task to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290125,
					"content": "Just head over to Marjorie's and help me see if she's got any gifts that a child might like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290118,
					"content": "You still keep Lily company?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Err... Well... Sometimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290113,
					"content": "Aye, never a lack of Fatui stories with you around...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		}
	]
