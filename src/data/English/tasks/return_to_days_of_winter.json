					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rudolf",
					"Lily"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290801,
					"content": "Lily, you shouldn't be talking to that Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290802
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290802,
					"content": "But why not? Mister Fatooey's told me loadsa stowies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290803
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290803,
					"content": "Hey there, Lily, Viktor got you a gift.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290804
					]
				},
				{
					"id": 200290804,
					"content": "Wow! Mister Fatooey got me a pwesent? Thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290805
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290805,
					"content": "Wait, why would that Fatuus send Lily a present? Don't tell me that he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290806
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290806,
					"content": "That's becoz I gave Mister Fatooey lots of stuff to eat! That's why he sent me a gift!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290807,
					"content": "Lily, he's not a good person...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290808,
					"content": "But he tells me stowies! He's a good guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290809,
						200290810
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290809,
					"content": "You can consider this Viktor's farewell gift.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Eh? Why does he have to go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290812,
					"content": "*sigh* He's leaving? Fine. I was beside myself with worry every day, what with that fellow talking to Lily every day and all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290813,
					"content": "Dadda, I wanna say bye bye to the Fatooey man!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290814,
					"content": "*sigh* Lily, you shouldn't get too close to that man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290815,
					"content": "But why? That Fatooey... He's been really nice to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290816,
					"content": "He tells me stowies. Lots of stowies! He's nice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290817,
					"content": "Lily, listen to Daddy. Things aren't that simple... *sigh* You know what? Daddy will tell you more when you're older.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290810,
					"content": "Viktor's going to leave Mondstadt soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				}
			]
		},
