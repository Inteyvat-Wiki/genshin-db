			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290201,
					"content": "Hello there, Traveler. What can I do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290202,
					"content": "Do you have any gifts for kids here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "A gift for a child... Let me think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290204,
					"content": "Hmm, actually, I've been attempting to fashion some small toys recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290205,
					"content": "The only catch is that they need a lot of Wolfhook dye, and I'm all out of Wolfhooks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290206,
					"content": "I asked Schuster to help me gather some more, but he hasn't returned yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290207,
					"content": "Could you help me look for Schuster, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290208,
					"content": "Once we have enough Wolfhooks, I should be able to make those toys for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290209,
					"content": "Alright. Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "He said that he'd be going <color=#00E1FFFF>near Wolvendom</color> to gather Wolfhooks. You can head over there to look for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290212,
					"content": "In that case, I'm counting on you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290210,
					"content": "Where has Schuster gone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
		{
