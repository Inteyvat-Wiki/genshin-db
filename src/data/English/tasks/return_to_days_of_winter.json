			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terrified Schuster"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "Th—Thank you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290502,
					"content": "These monsters just kept coming after me, even after I ran all the way here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290503,
					"content": "You came to gather some Wolfhooks, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "Eh? Yeah, it was Marjorie's request...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290505,
					"content": "Couldn't you have brought someone else with you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "...Come on, who would've agreed to come with me to work on a commission as simple as \"gathering plants\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290508,
					"content": "I know how that's supposed to work, of course, but you can only find Wolfhooks here, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290509,
					"content": "And the Wolfhooks that grow in safer areas have all been picked.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290510,
					"content": "So I had to go further in to gather Wolfhooks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290511,
					"content": "But let's not talk about that now. Could you help me pass these Wolfhooks to Marjorie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290512,
					"content": "I need a moment to rest. I thought my legs were going to give out on me back there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 200290507,
					"content": "Please don't go out so far by yourself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
		{
			"id": 2002906,
			"completionStepIds": [
				2002906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2002906",
