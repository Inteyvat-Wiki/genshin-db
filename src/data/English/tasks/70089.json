			"dialogs": [
				{
					"id": 700890101,
					"content": "Huh, there's someone here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890102,
					"content": "Not this one either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890103,
					"content": "Hey, what are you doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890104,
					"content": "I'm trying to find my way back. I only remember that I need to find an Anemo Archon Statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890105,
					"content": "I don't remember anything else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890106,
					"content": "Your way back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890107,
					"content": "It's a vague sense of homesickness, but I can't remember anything at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890108,
					"content": "When I woke up, the only thing I had was a note in my hand that said, \"You are 'Maukie.'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890109,
					"content": "So I suppose my name is Maukie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890110,
					"content": "I should be going now. Goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890111,
					"content": "What a strange person. But he doesn't seem like a bad guy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890112,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890113,
					"content": "I had a strange vision.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "A strange vision? Could it be because that person touched the statue just now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
