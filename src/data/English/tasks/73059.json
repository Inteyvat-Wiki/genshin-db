				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "\"The pomegranate sings, the apples clap...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590102,
					"content": "Hello, Mr. Khayyam! What are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590103,
					"content": "Oh, hello, hello. Child in white, and... *sigh* Apologies, my children. My memories are getting blurry, and names just fade after a while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590104,
					"content": "#Just call me {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "Haha... Okay, so you were the...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590106,
					"content": "Yes! We were the Javans - the brave young ones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590107,
					"content": "Hmm... So, please tell me, do the Aranara still remember me? Do they remember us all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590108,
					"content": "Oh, uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590109,
					"content": "They remember.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590111,
					"content": "I see... But I can't see them anymore, nor can I know how much they miss me... What a pity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590114,
					"content": "Hehe... I can't see them anymore. I am too old to see their faces or hear their voices... Gone, it's all gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590115,
					"content": "*cough*... Apologies, I have to take my leave now. Perhaps a miracle is my only hope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590116,
					"content": "One cannot understand or chase after a miracle. The only thing one can do is wait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590117,
					"content": "Khayyam unsteadily walks away...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "They forgot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "But... We can befriend them all over again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305902,
			"completionStepIds": [
				7305903
			],
