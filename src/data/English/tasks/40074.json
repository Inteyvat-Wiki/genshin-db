					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740301,
					"content": "What a spectacular structure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740302,
					"content": "Wow, I've never seen anything like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740303,
					"content": "Hey, uh Mona, your mirage is amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740304,
					"content": "Though it falls short of the glorious Immernachtreich, one must admit that it is an impressive realm nonetheless, Lady Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740305,
					"content": "(Whew, at least it's not showing me getting lectured by the old hag. Thank goodness...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740306,
					"content": "Well, what else would you expect of a genius astrologist's mirage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740307,
					"content": "Okay, let's get started.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007409,
			"completionStepIds": [
				4007409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
