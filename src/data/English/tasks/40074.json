				"points": []
			},
			"dialogs": [
				{
					"id": 400740201,
					"content": "According to my scryglass, we've arrived at the mirage. Okay, let's find the entrance first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740202,
					"content": "Is that it, over there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740203,
					"content": "Huh, this looks like some kind of pool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740204,
					"content": "Uh, we're not gonna have to swim to get in, are we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740206,
					"content": "Wait, do we have a non-swimmer among us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740207,
					"content": "No, I don't think that's the real problem here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740208,
					"content": "Ahaha, someone's scared, huh? Well, then, I'll go first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740209,
					"content": "And there she goes! She's gonna show off her oh-so-perfect swimming skills now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740210,
					"content": "Ahem! Please be mindful of your wording, mein Fräulein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740211,
					"content": "Ohh! Right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740212,
					"content": "See you later!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740213,
					"content": "Whoa, Mona dived right into the pool and disappeared! Let's catch up with her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
