					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "The surroundings appear to have changed. This isn't the beach we originally left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740902,
					"content": "The area appears to be the mountains of Mondstadt. Wait, have we been sent back to Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740903,
					"content": "Yet the boundless ocean still surrounds us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740904,
					"content": "There should be another pool around here for us to enter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740905,
					"content": "Over here, y'all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740906,
					"content": "Hmm? Why isn't it letting us enter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740907,
					"content": "Oh, something seems to be floating on the water there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740908,
					"content": "Uh... is it a painting? Or what is it...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740909,
					"content": "It seems to be hinting at a specific place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740910,
					"content": "It is anticipating that the Prinzessin would guide her loyal followers to the location that has been chosen by fate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740911,
					"content": "Why is it always you that has to take the lead... Ugh whatever, it doesn't matter. Let's just find this place first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
