				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400741201,
					"content": "Lady Megistus... this is heartbreaking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741202
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741202,
					"content": "Ugh, please don't try to comfort me. It'll only make me feel embarrassed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741203,
					"content": "C'mon, you don't need to pretend in front of us! Need a hug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741204,
					"content": "N—No!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741205
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741205,
					"content": "That was really how I felt back when I first started out in astrology but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741206,
					"content": "I've matured now. I'm no longer so easily swayed by random people's opinions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741207,
					"content": "Who would've thought! Even Megistus the Court Archmage was not spared of vexatious times in her career.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741208
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741208,
					"content": "It must have been difficult to be misunderstood by others... I'm glad that you were able to move past that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741209,
					"content": "Actually, there are many who have given up astrology due to similar circumstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741210,
					"content": "But, I am a genius, so it's only fair that I'm able to accomplish what others cannot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741211,
					"content": "It's pretty inspiring to hear you say all that in an amazing place like this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741212,
					"content": "You're awesome, Mona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				},
				{
					"id": 400741214,
					"content": "Yes, good, keep going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741215,
					"content": "Ahem... sorry to interrupt, but the door is that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741216,
					"content": "Alright, I'll let you shower me with praise after all the mysteries are solved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741213,
					"content": "You're definitely a genius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				}
			]
		}
	]
