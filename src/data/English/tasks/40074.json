					"Oz",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400741101,
					"content": "Everyone, over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741102,
					"content": "Is everyone awake now? Mona says that she has something important to tell everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741103,
					"content": "The first glimmering daybreak after the return of the Immernachtreich most certainly revitalizes one's innermost spirits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741104,
					"content": "What mein Fräulein means is that she is ready to take on the next challenge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741105,
					"content": "Yeah, we're rested and ready too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741106,
					"content": "Alright. Then I'll get to the crux of the matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741107,
					"content": "I just peeked into my scryglass, and there's a new mirage forming on the island over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741108,
					"content": "And... I have a feeling that this one is my mirage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741109,
					"content": "Oh, so now it's Mona's turn. You were with us for all of ours, seems like it's time for us to go with you into yours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741110,
					"content": "Ugh... well, I'm sure there's nothing to see, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741111,
					"content": "Lady Megistus, are you embarrassed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741112,
					"content": "No, absolutely not! Haha... It's not like I'm worried about everyone judging me after seeing my embarrassingly pathetic mirage or anything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741113,
					"content": "This emphatic \"no\" sounds rather like a thinly disguised \"yes\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741114,
					"content": "Well... *ahem* Astrologists are often regarded as something out of this world, right? But what if my mirage is nothing like that...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741115,
					"content": "Fret not. Your Prinzessin is not so foolish as to entertain preconceived notions on how thy mirage should or should not present itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741116,
					"content": "Yeah, me neither! Not that I have low expectations of you, Mona, but personally, I think you're a kind soul, and you shouldn't feel like you have to live up to anything more than that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741117,
					"content": "I'm sure Mona's mirage will stay true to her kind heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741118,
					"content": "Yeah, and it's not like we're going in there just to do some sightseeing. There's other reasons, too, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741119,
					"content": "Yeah. Maybe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "...Really? Well, okay then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741122,
					"content": "I suppose I'm not worried as long as everyone doesn't get too excited. Alright then, let's get going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741120,
					"content": "...we'll find some clues about the unusual phenomena there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				}
			]
		},
		{
