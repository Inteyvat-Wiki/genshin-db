					"Pedrush",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "Oh, great. You're awake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150102,
					"content": "Everybody has started to wake up, and we've heard similar reports from around the city as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150103,
					"content": "From the looks of it, you were able to successfully resolve the issue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150104,
					"content": "Yes, although it took us a good deal of effort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150105,
					"content": "There will be many people gathering here shortly, so please do your best to maintain order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150106,
					"content": "I need to go to the Akademiya with them now, but we'll be back soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sitt",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "Oh, it's the great Dendro Archon. How can I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150202,
					"content": "I would like to check the registration records of a Kshahrewar scholar. He should be in an unconscious state right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150203,
					"content": "Okay, just a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150204,
					"content": "After a while...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Sorry to keep you waiting, Dendro Archon. We have confirmed that there's a scholar named Beynuni who's been unconscious for a while. The cause was improper operation of the Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150206,
					"content": "He hasn't regained consciousness yet, and is still receiving treatment at Bimarstan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150207,
					"content": "Huh? Isn't his name Moseis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150208,
					"content": "I guess he didn't want to be recognized or bothered by anyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150209,
					"content": "Please give the knowledge stored in this to the matra, and ask them to import it into Beynuni's brain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150210,
					"content": "Understood, but for safety reasons, I need to know why.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150211,
					"content": "It's simple: This contains his consciousness. It's long been trapped inside of a dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150212,
					"content": "He's committed an act that affected the safety of Sumeru. After he wakes up, I'll inform the General Mahamatra of all the details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150213,
					"content": "I see. I'll take care of this right away. Thank you, great Dendro Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150214,
					"content": "Mm-hmm. No problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150215,
					"content": "Alright, everyone should have gathered at \"A Moment of Dreams\" by now. Let's head back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Let's be quiet and just listen in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "I wonder what she's going to say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "Hello, all of you who have just woken up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "I'm sorry for interrupting your beautiful dreams. I may have acted a little cold when handling things in the dream. I sincerely apologize for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "Dreams have amazing power. They inspire us to remain resolute in the face of adversity, and help those with aspirations achieve their desires.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "But dreams also have the potential to exploit people, confuse the senses, and distort the truth. Unfortunately, you were all chosen as prey for an elaborate scheme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "As I've said before, I'm still learning, and cannot fully empathize with the pain of all the loss you've experienced.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "But just take a good look around you, and you'll see many other people who have had similar experiences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "You should be proud that you've been able to gather here and look toward the future together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "The path of life is long, and it's hard for us to see the destination. This leads us to ask a lot of difficult questions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "What's the meaning of life? What's the purpose of my existence? Why do I keep experiencing pain and loss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "*sigh* Of course, the most comfortable choice is to stop progressing, give up thinking, and just keep repeating whatever you're already familiar with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "Whenever you have such thoughts, just look at the people and things around you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "Some people work hard all day so that their families can have a hot meal on the table at night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "Some people travel all over the world in order to create art that resonates with all of Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "Some venture in search of the world's secrets to prevent rapidly approaching, yet still unknown, world-shattering catastrophes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "Life is not just about yourself. Each and every one of your actions shapes you and the world around you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "*sigh* Look, friends and family will remember what you've done, and even some people you've never met may benefit from your actions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "Therefore, many people will strive forward to forge new paths, even if they have to endure great pain to do so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "Once you begin your journey on that same difficult yet rewarding path, you'll come to know the answers to those big, existential questions, yet they will no longer feel as life-defining as they did before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "But if you were to believe that life is nothing but an empty, ephemeral dream, then that's also the only thing it'll ever become.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "You are free to choose how you want to live your lives, but as your archon, I should first make this information known to everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "In the end, it's up to you whether you want to embrace a beautiful dream at the cost of your real life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "You're amazing, Nahida! Even Paimon was nearly won over by that scholar in that dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "Well, he's very good at manipulating the weaknesses of human nature, but perhaps he himself had fallen prisoner to them long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "That dream was incredibly beautiful and enticing. Ordinary people couldn't see through it, and easily lost themselves within it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "But as long as you can still wake up, you can still move forward with your life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "You've also learned a lot, Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "Huh? What makes you say that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "You can really empathize with others now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "Right! You said that you didn't understand human feelings, but we saw how considerate you were with all these people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "Your speech just now really connected with everyone. You did a good job!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "Thank you. I've heard a lot of sad stories along this journey, and several of them have touched my heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "You can't say that the victims of the dream really did anything wrong, and what they wanted was also not unreasonable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "That's why I could understand them when they tried to resist us and protect the dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "But all of my understanding and stirred feelings probably can't even account for even one percent of the pain they've experienced.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "I don't think this \"one percent\" can be seen as an example of what you call empathy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "You're too hard on yourself that's for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "Nobody is capable of having absolute empathy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Hehe, alright. I suppose going out into the world will help my confidence grow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "I've learned that emotions are nothing like knowledge, and that's why it's hard for me to put them into words sometimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Beynuni, or \"Moseis,\" said that I had never personally felt the pain of loss, but I have a vague feeling that this isn't true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "The moment I entered the dream, I felt like I was wrapped in a blanket of warm feelings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "It was so warm that it felt like I had returned to the start of my life, and I didn't want to wake up anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(Huh... Did she see something in the dream, too?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "But when I opened my eyes, the feeling was gone without a trace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "If I have to make an analogy for it, I would say I can no longer see words on a piece of paper after they have been erased, but I can still see the slight indentations of where the words had been written.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "But now that I've experienced this dream... I think I can say with confidence that I won't dwell too much on the meaning of that warmth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "It's enough that I can tell I was once supported by that warmth, and its existence has allowed me to get to where I am today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "If I dwell too much on its exact nature, I would be putting the cart before the horse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "I gave a speech to inspire my people, so if I were to fail to live up to those words myself, then that would be too embarrassing, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(Greater Lord Rukkhadevata has already shaped Nahida through her actions.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Even if she has been forgotten, Nahida's mind and willpower are the proof that she once existed.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(Instead of telling her the truth, I should respect their decisions.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Hey, what's with that serious look?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "You keep looking like there's something you want to say. Is there anything you want to tell me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "Uh, I forgot what I wanted to say.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Hehe, okay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "Since we just woke up, let's stretch a little bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "A new day is about to begin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "Nah, it's not important.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "You should be a little more confident in yourself.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
