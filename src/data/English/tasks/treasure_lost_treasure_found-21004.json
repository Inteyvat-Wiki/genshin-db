			"dialogs": [
				{
					"id": 210042001,
					"content": "Sometimes fate is inescapable, even for a god...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042002,
					"content": "I found four clues in four ruins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "Four ruins, four clues... And there are Four Commandments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042004,
					"content": "Each of these clues expounds upon the meaning of one of the Four Commandments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042005,
					"content": "To get to the correct interpretation, the original text of Guizhong's Four Commandments is key. These four are helpful, but peripheral to our enquiry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042006,
					"content": "These five passages are all linked — but how?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042007,
					"content": "\"Convergence...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "Hmm... Could \"convergence\" mean that... these four things all link up in some way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042009,
					"content": "Wait — I remember, each of Guizhong's Four Commandments can be found in a specific ruin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042010,
					"content": "Hmm... I am speculating here, but perhaps the four <color=#00E1FFFF>ruins</color> are relevant to deciphering the true meaning of Guizhong's Four Commandments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042011,
					"content": "How exactly, I don't know. I need to mull it over. Maybe you could have a think too — or better still, go and investigate it firsthand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042012,
					"content": "I'm just a skinny little scholar after all, I tire out completely after a few seconds on the run... Wish I had your stamina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042013,
					"content": "Anyway, I'm going to keep thinking about it for a while. If you think of anything, or if you find anything, you know where I am.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100422,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
