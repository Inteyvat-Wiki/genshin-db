				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "How is the search going? Found the treasure yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "Yes, it was about where they \"converge\" after all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Really... So it's just like Guizhong's Four Commandments says. The treasure was located at \"the convergence of these four...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Whoever designed this riddle must have truly revered Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "So much so that they preserved Guizhong's Four Commandments for future generations, even though the Guili Assembly was wiped out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "And as for Guizhong herself, who established the commandments — she must have been adored by her people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "Clearly, she wished for her people to be wise, to hold themselves to a moral code, to be strong and healthy, and to find solidarity in the shared enterprise of protecting their home — the Guili Assembly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "But she failed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Failed? I suppose you're right, she died in the end... and when the Guili Assembly was wiped out, her people no longer had a place to call home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "And yet, today, Guizhong's Four Commandments have seen the light of day once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "These were the words penned by Guizhong herself to serve both as maxims and blessing for her people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Once there was a time when she led her people to go forth and take this very land, guided by these commandments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "She may no longer be with us, but her beliefs, the things she stood for — they will endure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "Whoever it was that revered her so much was very clever indeed. They used the allure of hidden treasure to ensure Guizhong's Four Commandments would be passed down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Though for that person, I wonder whether the treasure they held dear was the rare metals and precious stones, or Guizhong's Four Commandments themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Haha, well, to me at least, it's clear that the commandments are the real treasures here. A chest full of gold or gems can't compare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "...But if you made people choose, how many would really pick a list of commandments over material wealth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "Seems like a gentle-natured god.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "I'm not sure \"gentle-natured\" is a particularly common trait of gods...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "But maybe it was once. Maybe a long, long time ago, among the gods who led the peoples of the world, there were those gentle by nature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Those who protected their people... walked among them... stood by them as they went forth into the world...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "...But it was the gentle gods who were ultimately powerless to protect their people. Look at Guizhong — it took an elaborate treasure hunt just to preserve the four commandments that once were the lifeblood of a whole civilization.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "I wish I could meet her...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "You want to meet a god? You do entertain some wild thoughts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "But I'm curious, what would you say to Guizhong if you actually got to meet her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "\"...Cheer up, Guizhong, you did your best\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "If it were me... I'd recite Guizhong's Four Commandments flawlessly from memory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "And I'd tell her that her vision and her ideals were alive and well, that the people of this land still remember the things she taught to their ancestors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "I think that for someone like Guizhong, who lost everything... That would be the only thing that could lift her spirits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
