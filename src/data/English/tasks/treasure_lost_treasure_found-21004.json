			"dialogs": [
				{
					"id": 210049001,
					"content": "Just what exactly is being hidden in this saying...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049002,
					"content": "Tell me about the saying...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049003
					]
				},
				{
					"id": 210049003,
					"content": "Though we call it a saying, it's really more of a riddle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049004,
					"content": "A riddle that has been kept alive by word of mouth among the residents of Guili Plains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049005,
					"content": "\"At the place where wisdom and ambition, unity and fortitude converge like water; that is where I shall reveal the bountiful treasures of the earth.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049006,
					"content": "How about that, eh? However you interpret it, it sure sounds like there's some kind of buried treasure in the Guili Plains area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049007,
					"content": "If I surmise correctly, those four words should correspond to four different ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049008,
					"content": "If one were to find all four ruins, perhaps they would be able to find the meaning behind this saying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049009,
					"content": "But I'm not cut out for finding all of them myself. Just finding that first one really took it out of me. Took days to recover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049010,
					"content": "If you're interested, perhaps you could take a look. Who knows, perhaps you'll find the next lead before I do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
