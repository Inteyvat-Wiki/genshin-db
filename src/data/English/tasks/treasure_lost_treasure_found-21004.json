					"nextDialogs": [
						210040203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040203,
					"content": "If you do find something, don't make the amateur mistake of running off in your excitement. Be sure to <color=#00E1FFFF>note down the clue</color> first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
