					"nextDialogs": [
						210049302
					]
				},
				{
					"id": 210049302,
					"content": "A territorial challenge, you say? Hmm... but the Guili Assembly is said to have existed peacefully under Guizhong's rule for a very long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049303,
					"content": "Not that Guizhong was a particularly powerful god... At least, that's my impression...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049304,
					"content": "But there seems to have been another god with the Guili Assembly besides Guizhong. I highly doubt anyone would have been foolish enough to try and take on two gods at once...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
