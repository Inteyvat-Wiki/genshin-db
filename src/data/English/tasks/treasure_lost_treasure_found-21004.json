					"nextDialogs": [
						210049403
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049403,
					"content": "Or if they did, then you have to ask yourself... What kind of treasure would it take to drive the gods into war with each other?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049404
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049404,
					"content": "...Haha, I for one cannot imagine such a treasure.",
