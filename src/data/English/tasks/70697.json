			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}! What a surprise, running into you in Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "I've never been anywhere with a climate like this before. It's so cold! But wow, what an experience!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "I've had my first snowball fight, built my first snowman... Oh, and the comics are a nice surprise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "The Soulblazer Saga is super popular in Inazuma, but I totally wasn't expecting to find so many people that read it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "I had a great chat with some Natlanese fans earlier. It really got me inspired, so... I ended up making a character stand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "...Oh, sorry, lemme backtrack a little. Have you ever heard of The Soulblazer Saga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "You tell Yoimiya about the Legion of Soulblazers...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "No way! Your friends are into it too? What a funny coincidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "In that case, lemme give you this character stand of Fietena. Hehe, she'll be right at home in the Legion of Soulblazers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}