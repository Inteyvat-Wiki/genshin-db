					"id": 766730901,
					"content": "Hey Nicole, we're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730902,
					"content": "That was quick! You two work very fast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 766730903,
					"content": "Ah, it's nothing. But uh, how do we get the photos to you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730904,
					"content": "You can hold onto them for now. I'll be there in a couple of days — we can talk more about the statues then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 766730905,
					"content": "Sure thing. See you in a couple days!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
