				]
			},
			"dialogs": [
				{
					"id": 766730801,
					"content": "#A long, long time ago, there was a young {M#man}{F#woman} who ran away from home. After spending the last of {M#his}{F#her} Mora, {M#he}{F#she} trod through the cold of winter, shivering in {M#his}{F#her} threadbare clothes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 766730802,
					"content": "#Suddenly, the young {M#man}{F#woman} found {M#himself}{F#herself} stepping out onto thin air, and {M#he}{F#she} fell through into a strange place. But before {M#he}{F#she} could react, a voice rang out from somewhere in the distance:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730803
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 766730803,
					"content": "\"This is the secret home of Nicola Coco, the Great Mage Everlasting. Oh, destitute one, tell me your heart's greatest wish, and with my guidance, you shall attain it.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730804
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 766730804,
					"content": "Whoa... That was a strange voice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730805,
					"content": "\"Nicola Coco\"... Who's that again? Do we know her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
