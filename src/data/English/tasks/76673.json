			"dialogs": [
				{
					"id": 766730701,
					"content": "You and Paimon take a bunch of photos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766730702
					]
				},
				{
					"id": 766730702,
					"content": "Hmm, some of these shots are pretty good, but we didn't get any from the front. Let's wait for it to turn around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730703,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730704
					],
					"speakerTitle": "Mandragora"
				},
				{
					"id": 766730704,
					"content": "Yes, that's the one! That's the money shot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730705,
						766730706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730705,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730707
					]
				},
				{
					"id": 766730707,
					"content": "Waaaaaah! Help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730706,
					"content": "Get back!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730707
					]
				}
			]
		},
