			"dialogs": [
				{
					"id": 766730501,
					"content": "Just who I wanted to see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730502
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730502,
					"content": "I'm delighted with the photos you took — excellent source material. Now — I have all the carving tools ready to go. Would you like to try it together?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730503
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730503,
					"content": "Carving tools? ...You mean these blocks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730504,
					"content": "That's right. The statues are inside the stones. All we need to do is remove any excess material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730505
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730505,
					"content": "To make things a little easier for you, I've provided a guide on how the carving process works.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730506
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730506,
					"content": "Allow me to demonstrate. First, we make some big, bold cuts to carve out the general shape...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730507
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730507,
					"content": "The numbers on the stones represent the amount of material you need to keep in a given column. So, first we do this... and then this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730508
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730508,
					"content": "Ooh, it's starting to take shape!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730509,
					"content": "Got it? If you carve the blocks this way, you should be able to see the basic form.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730510
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730510,
					"content": "Then, you just need to add some finishing touches... and, voila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730511
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730511,
					"content": "Wait, what!? It suddenly changed in the blink of an eye! How'd you do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730512,
					"content": "Hah, a great mage doesn't reveal her secrets that easily. Just behold, and be amazed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730513
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730513,
					"content": "You got the basic carving process down, yes? Focus on that, and leave the finishing touches to me. Much obliged.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730514
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730514,
					"content": "Alright. Let's give this a shot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730515,
					"content": "What the...!? This is way more difficult than the one you walked us through!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730516,
					"content": "Hmm? Oh, sorry, sorry. Wrong one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730517
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730517,
					"content": "That's the one I was going to work on. Yours is over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730518
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730518,
					"content": "Whew... Well, that's a relief...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
