			"dialogs": [
				{
					"id": 715360301,
					"content": "#So, that's how it's done... This gift envelope is wonderful, {NICKNAME}, thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360302,
					"content": "Now, I just need to make a few more to give alongside the souvenirs I bought. I'm sure the people back home will love them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360303,
					"content": "But, this one... I'm keeping just for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
