			"dialogs": [
				{
					"id": 715360101,
					"content": "#Happy Lantern Rite, {NICKNAME}. I heard about how you helped Dehya with the gift envelope. It was beautiful, thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "Everything is settled back at the village, I'm guessing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "Yes, it's all thanks to Dehya and the others. I can rest a little easier knowing the village is still protected while I'm gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Take this time to get some good rest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "I will. Dehya wants to visit Qiaoying Village in a few days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "She said the scenery is beautiful, and the village is known for their tea. It's a perfect gift for the people back home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "I was planning to follow the tradition here and make a few gift envelopes for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "But, Dehya packed our schedule to the brim, and with all the running around, I'm not sure I'll have the time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "Dehya told me you're good at making gift envelopes. Could you show me how to make one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "Of course, just leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
