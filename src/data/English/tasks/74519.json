				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "Oh, hello there, Honorary Knight! Are you here to see Master Jean... Or is there something I can help you with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190402,
					"content": "I'm just having a little stroll.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "I'm currently conducting a routine cleanup of the area around the Knights of Favonius offices. Most of the dust has been cleaned out at this point. Next, I'll be re-organizing our old files.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190405,
					"content": "Those documents have piled up for a while now. I'm thinking that everyone will have an easier time looking them up if I sort them into different categories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190406,
					"content": "Also, I can learn a lot from those who came before me in the process. That's a form of training too, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190407,
					"content": "You're as serious about your work as ever, Noelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "Just doing my duty. You and the other Knights are always pushing forward, so I've got to catch up as soon as I can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190409,
					"content": "Your resolve deserves remembrance...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "Huh? Me? I mean, you're most welcome! It's just... I just finished cleaning, so I'll be covered in dust...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190412,
					"content": "Ah, but that's the point! I mean to capture you at your hardest-working!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "Um... I—Isn't it a bit too soon to call me that? But if you want to take the photo... It would be my honor, covered in dust though I may be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190415,
					"content": "I'm sure you'll hit the shutter at the perfect moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190413,
					"content": "I mean to set the Maid Knight's \"decisive breakthrough\" onto film!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "...So allow me to take a photo of you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "What are you busy with, Noelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
}