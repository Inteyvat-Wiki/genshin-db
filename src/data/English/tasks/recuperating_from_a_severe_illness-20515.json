					"nextDialogs": [
						205150506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150506,
					"content": "I don't know what he's there for. But I don't think he's a bad person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150507,
					"content": "Well, since you've found me, I guess I'll head back now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150508
					],
					"speakerTitle": "Anna"
