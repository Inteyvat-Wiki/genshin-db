			"dialogs": [
				{
					"id": 205150301,
					"content": "Did you find Anna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150302,
					"content": "She's on the roof of the Cathedral.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150303
					]
				},
				{
					"id": 205150303,
					"content": "The Cathedral roof? All those sisters, and not one of them spotted her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150304,
					"content": "How did she manage that? Maybe she really does have talent for being an Adventurer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150305,
					"content": "I'll go get her to come down. We really shouldn't be bothering the sisters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150306,
					"content": "Thanks for your help. Please take these as a token of my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
