				"points": []
			},
			"dialogs": [
				{
					"id": 205150201,
					"content": "Wow, the sisters really are alert. They almost discovered me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150202,
					"content": "You're an agile one...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150203
					]
				},
				{
					"id": 205150203,
					"content": "Wah! How did you know I'd be here? Even the sisters didn't spot me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150204,
					"content": "Well, since you've found me, I guess I'll head back now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150205,
					"content": "I just wanted to enjoy the scenery, so don't worry about me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
