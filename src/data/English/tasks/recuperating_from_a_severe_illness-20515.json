						205150606
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150606,
					"content": "He's something, he is. No matter how many times the sisters warn him, he can always be found loitering around the Cathedral for no good reason.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150607
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150607,
					"content": "Well, I'll go get Anna to come down. We shouldn't bother the sisters. Right, and I also need to give Albert my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150608
					],
					"speakerTitle": "Anthony"
				},
				{
