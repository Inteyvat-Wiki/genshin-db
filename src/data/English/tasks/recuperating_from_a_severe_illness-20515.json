					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205150101,
					"content": "Oh, where has Anna gone this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150102,
					"content": "Can't find Anna again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "Yes. I've searched all over the city for her, but no luck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150104,
					"content": "Please help me look for her. I'm so tired, I can barely move...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150105,
					"content": "Gotcha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "It's up to you, then. This girl... If she keeps running around like this when she's almost well, I might fall sick myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150111,
					"content": "Hang on... Anna did once say that she's wanted to go to the Cathedral and thank the sisters there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150112,
					"content": "Perhaps you should check the Cathedral first. You can also check in with Albert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150113,
					"content": "He often, uh, hangs around the Cathedral. Who knows, maybe he's noticed something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150107,
					"content": "Maybe she's gone off to be an adventurer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "That can't be. It can't be... Can it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150109,
					"content": "H—Hey, won't you say something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051502,
			"completionStepIds": [
				2051502
