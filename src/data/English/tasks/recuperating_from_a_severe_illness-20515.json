			"dialogs": [
				{
					"id": 205150401,
					"content": "This kid's really nimble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150402
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150402,
					"content": "Excuse me, have you seen a girl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150403
					]
				},
				{
					"id": 205150403,
					"content": "You mean Anna? I've seen her, she just ran past me and disappeared down that corner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150404
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150404,
					"content": "Still, the Anna I remember has always been ill, and would sometimes come to the Cathedral to be healed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150405
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150405,
					"content": "But she doesn't look sick at all. Why, I'd wager that she's got more energy than I do. What happened, I wonder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
