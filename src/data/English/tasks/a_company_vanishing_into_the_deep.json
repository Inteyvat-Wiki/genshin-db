					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621001,
					"content": "Whatever the case, thank you for giving us food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621002,
					"content": "We'll find a way to get out of here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106211,
			"completionStepIds": [
				7106207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106207",
							"2"
						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Radomir",
					"Danila",
					"Temur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "You're back. How is it? Any news from the station?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621102,
					"content": "It has been abandoned.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "Is that so... Then, did you find anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621104,
					"content": "You're no longer welcome in Liyue Harbor, I fear.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621106,
					"content": "Other than this, do you have any other news?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621107,
					"content": "Uh... Here's a letter we found. Seems it's for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710621108,
					"content": "Here you are...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "The Fatui soldiers read the letter...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "Ah, it's from Yanbo. I got it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621111,
					"content": "What happened? The Millelith are gone too? Let me read it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621112,
					"content": "*sigh* What's with them? We're fighting for them! Aren't we allies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621113,
					"content": "There are no allies anymore. No more collaboration... To be precise, the Fatui are no longer in a collaborative relationship with Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621131,
					"content": "This is betrayal! The people of Liyue have betrayed us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621132,
					"content": "Maybe it's the other way around in their eyes? Perhaps they think that we, the Fatui, have betrayed them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621114,
					"content": "This can't be! We came here to protect the people of Liyue! Don't you remember what the Kapitan said before our departure? \"This expedition has nothing to do with conspiracies or schemes!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621115,
					"content": "But that couldn't prevent conspiracies and schemes from coming to us, could it? This isn't something we have control over, Danila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621116,
					"content": "OK, I see. *Deep breath*... I've decided — we need to retreat, the quicker the better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621117,
					"content": "It's alright. I'll take full responsibility. If there's any deserter amongst us... If any deserter shall bring dishonor to the Ninth Company, that's me and only me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621118,
					"content": "...Danila is right. We're here to protect the people of Liyue from the Calamity of the Darkness. We can't leave like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621119,
					"content": "Do you think this is the right time to worry about your personal honor, Mirka? Can't you see it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621120,
					"content": "Can't you see that the people of Liyue neither need our protection, nor even want us here? They even defeated our comrades, who thought of themselves as heroes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621121,
					"content": "Yes, you've betrayed the trust of the people of Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "We should retreat, and preferably in silence. Without alerting the local Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621124,
					"content": "The Kapitan said that we should be ready to give our lives here. We should...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621125,
					"content": "He also said that he wouldn't let anyone die in vain! That he didn't want the whole company to be buried here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621126,
					"content": "At least we're still alive. At least not all of the Ninth Company are gone. Do you understand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621127,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621128,
					"content": "Yes, Sir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621129,
					"content": "OK, any more questions? I don't want to hear any objections. You're now dismissed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621130,
					"content": "#Whatever the case, {NICKNAME}, thank you for helping out. Take this Mora and these supplies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621122,
					"content": "Best you consider what you're gonna do next.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
