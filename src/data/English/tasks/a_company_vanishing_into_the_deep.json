			},
			"dialogs": [
				{
					"id": 710620202,
					"content": "Please consider our request.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620201
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620201,
					"content": "Here is the food you wanted.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106203",
							"2"
						],
						"stepId": 7106203,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7106202"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Anton",
					"Danila",
					"Temur",
					"Radomir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "They're so weak. Just a few kicks and they're already down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620702,
					"content": "Stop! Please stop! Give us some food and we'll do anything as you wish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620703,
					"content": "Hmph... They're really desperate for food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620704,
					"content": "Tell me your purpose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "Lemme put it this way: Whatever doubts you may have, the only purpose we have here is to investigate the source of the calamity in The Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620707,
					"content": "What calamity? Paimon's seen no sign of it in The Chasm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620708,
					"content": "The calamity that happened five hundred years ago is just a beginning. The war against the dark has never stopped, and we're standing on one of the very battlefields of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620709,
					"content": "*sigh* Our Serzhant CO is so hungry that he's started to talk some crazy stuff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620710,
					"content": "He always likes to exaggerate, but this is the first time he's talked nonsense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620711,
					"content": "Forget it... Antoha does have a point, which is you people of Liyue are no enemy to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620712,
					"content": "At least no enemy to us... As for our comrades who went missing, I'm not so sure how they might perceive you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620713,
					"content": "OK... I'll help you, but just this once.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "How can I trust you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Danila",
					"Temur",
					"Radomir",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "*sigh* I'm sorry, but there's a... small issue... with our chain of command.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620902,
					"content": "\"A small issue\"!? We just betrayed our men by standing here as we watched someone else chase them off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620903,
					"content": "Then what do you suggest we did? Let them beat us up and have our food snatched away? Zip that mouth of yours shut and focus on eating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620904,
					"content": "Antoha, stop downplaying this. Our chain of command has been wiped out. It's gone! Our captains and other higher-ranking COs have either gone missing or got killed... That leaves us no other choice but to retreat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620905,
					"content": "But many of our men refuse to do so... They'd rather hold on to what's left behind by our COs and fight till the last man standing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620906,
					"content": "I'd say it's \"starve\" till the last man standing... According to the collaboration agreement, people up there are supposed to relay orders and supply us with food, but we haven't heard from them for a long time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620907,
					"content": "We're loyal to the Fatui and Lord Harbingers — as we should be — but we're no fools. Anyone sensible would have long suggested that we retreat under such circumstances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620908,
					"content": "So, what's your plan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "Mmm... I know that this isn't your concern, and I won't stop you if you wanna leave, but we're really out of our depth and could use your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620910,
					"content": "I need to think about it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "OK. Stay safe. But be careful. Our other comrades scattered around here might not be as friendly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620913,
					"content": "I'm not supposed to tell you this, but... there's a supply station near the ground level. All our supplies go through there, and we sometimes got orders there, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620914,
					"content": "We sent a few men up for food, but they haven't returned... I can't afford to risk another trip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620915,
					"content": "No one has come down from the supply station for a long time, either. I hope you can check the situation there for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620916,
					"content": "Let me think about it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "I'm so sorry to trouble you, but we need to know what's happening on the ground... Otherwise, any decisions we might make would be too rash.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620919,
					"content": "Okay, okay, you're starting to confuse Paimon with all the convoluted talking! We'll look out for it when we pass by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620917,
					"content": "I'll help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "What do you need me to do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
