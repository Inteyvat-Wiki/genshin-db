					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "Since when have we become \"friends\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "What do you want? Supplies, weapons, intel, or Mora — we've plenty of them. Take them all if you'd like, so long as you help us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "Ah, look, our beggar CO just took on the most humiliating job ever... losing the last ounce of dignity we're left with on our behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "Knock it off already! Are you expecting to fill your tummy with bitter sarcasm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "\"Join our ranks! Let our marching boots shake the earth like thunder! You who will march with us towards the polestar of the white night, come! We shall never abandon you...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Oh, someone shut him up already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Ugh... Although they're all bad guys, seeing them all famished certainly makes Paimon feel sorry for 'em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "It shames me to admit this... But as you can see, we're no longer combat-effective in the least. All we want is some food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
