	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "*Huff* Sorry to stop you if you're in a hurry. I'm Serzhant Anton Melnikov, the... Acting CO of the Ninth Company. Just call me Anton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620102,
					"content": "They are Danila, Temur, Radomir and... uh, Romanski. He's not here. He's at the... medical camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620103,
					"content": "Neither Romanski nor the medical camp remains, Antoha. Romanski didn't make it through the morning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620104,
					"content": "Danila, how many times have I told you. I'm in charge of the company now. Call me Serzhant Anton!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620105,
					"content": "Ha! In charge of the company, as a Serzhant! Who do you think you are? Ever since the Kapitan went missing, you've been acting like an important-looking CO. Hah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "That's enough, Temur... Your growling stomach must've messed with your judgment. Calm down and preserve your energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "It's \"Acting CO\" Antoha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620149,
					"content": "Acting CO, my foot! Just for how long do we have to take orders from this fake CO who doesn't even know what he's doing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Hey, Temur, your brain must be intoxicated with hunger. I suggest you take a few punches to sober up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "Suits me! Go ahead! Come at me and I'll help you sober up too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "Great! After running out of rations, we're also saying goodbye to our sanity and patience. Splendid! Draining every last ounce of energy we have here, what an enlightened course of action...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620108,
					"content": "Ahem...! Silence! If you're itching for a fight, then go down and fight the monsters that came from the black mud! And don't you forget to fight them with your growling stomach too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620109,
					"content": "If we wanna live and walk outta here alive, we must stick together! Don't make me repeat myself, OK?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620110,
					"content": "Alright, give me a \"If not us, then who?\" on three. One, two, three!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620111,
					"content": "If not us, then who.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620112,
					"content": "If not us, then who...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620114,
					"content": "Uh, so, my friend, you must've noticed that... *cough* we're not very combat-effective at present. There's... been a small issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620115,
					"content": "Hmph, \"a small issue!\" You certainly talk like the Kapitan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "Since he's not here, I'm the acting commander! Now, why don't you shut that clever mouth of yours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620117,
					"content": "Sorry, my friend. We're in dire need of your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
