			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "The temple's looking the part now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310302,
					"content": "It is, yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "Eh? Oh, you've got impeccable timing, haven't you? The repairs have just been completed, and I've just finished paying the laborers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310304,
					"content": "Ah... I didn't think that it would cost this much Mora. I've more or less sunk all my earnings into this place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310305,
					"content": "But anyway. The important thing is that the temple has been rebuilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310306,
					"content": "Would you like to offer some incense? I made a point of getting a new Censer made.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310307,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "Take these incense sticks. The censer's right over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310308,
					"content": "Have you offered any incense yet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "Of course I have. I was the first to do so once the refurbishment was complete, in fact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
			],
