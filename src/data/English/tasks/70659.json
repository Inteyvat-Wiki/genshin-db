				"points": []
			},
			"dialogs": [
				{
					"id": 706590301,
					"content": "Heh. But don't take my word for it — try it out for yourself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590302,
						706590303
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590302,
					"content": "Play Windtrace.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "Leave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "Alright, well, if you're ever interested to try it out, you know where to find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
