			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706590101,
					"content": "Hey there, fancy trying your hand at Windtrace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590102
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590102,
					"content": "What's Windtrace?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590103
					]
				},
				{
					"id": 706590103,
					"content": "I'm glad you asked. Windtrace is a game that's all about Mondstadt's history!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590104,
					"content": "I suppose you've heard of the aristocrats who once lived in Mondstadt City?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590105
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590105,
					"content": "They were tyrants, and their rule was brutal. Words cannot do justice to the way that people suffered at their hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590106,
					"content": "To fight back against their oppression, a group of brave citizens came together and formed an underground resistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590107
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590107,
					"content": "These valiant rebels engaged in operations throughout the city, becoming a major thorn in the side of the aristocrats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590108
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590108,
					"content": "But the aristocrats retaliated, quickly training up their own team of henchmen to suppress the rebels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590109,
					"content": "And so, the rebels fought duel after duel with the aristocrats' lackeys all across Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590110,
					"content": "Windtrace takes its inspiration from this thrilling chapter of Mondstadt's history! And it used to be quite popular, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590111,
					"content": "Used to be?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590112
					]
				},
				{
					"id": 706590112,
					"content": "Sadly, yes. Young people these days don't seem very interested in the game...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590113,
					"content": "But I can't let Windtrace fade into obscurity. So, I tweaked the rules a little to make it easier to get into and more fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706590114
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706590114,
					"content": "I also added a whole load of brand-new maps in. Hopefully, this will help to attract more people...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
		{
			"id": 7065903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
