				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690201,
					"content": "Ah, Traveler! How goes the crab-catching harvest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "Oho! This crab looks pretty good. You're a dab hand at this, aren't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Well then, since we've got all our ingredients, let's begin cooking post-haste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "Let me prepare for a while, Traveler. Please wait here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216903,
			"completionStepIds": [
				7216904
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
