			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "This dish certainly does have a very \"Julie\"-esque feel to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690102,
					"content": "In fact, the first time I saw it, I thought it must've come from Mondstadt. But as it turns out, it's a local specialty instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690103,
					"content": "I bet it tastes just as good as its name sounds, Xudong! C'mon, let's make some, please!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690104,
					"content": "We meet again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "Oh, it's you, Traveler! Hehe, see, what did I tell you about us meeting again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690107,
					"content": "Xudong's picked up a new recipe from the city! It's called Crab Roe Kourayaki. Pretty good name, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690108,
					"content": "It's not that hard to make either. But it does require a great number of crabs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690109,
					"content": "I've prepared some normal crabs, and now I'm looking for some... special ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690110,
					"content": "Special crabs?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "Exactly! In specific, we're going for the ones that dwell under that Thunder Sakura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690112,
					"content": "You might as well say \"thunderstruck crabs\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690113,
					"content": "Well, I'm just curious, you know? I wonder what crabs that live under such circumstances will taste like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690114,
					"content": "However, with lightning flashing all around that tree, I daren't get too close.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690115,
					"content": "My book states that just like before, you just need to touch a Thunder Sakura Bough and cause an Electrogranum to attach to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690116,
					"content": "And that way, you won't be struck by the lightning from the Thunder Sakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690117,
					"content": "But well, you've seen what that tree looks like. I'm not going to risk it based off such a rough summary of a solution.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690118,
					"content": "Wouldn't it work if we just ran fast enough?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690119,
					"content": "Are you daft? Do you think you can run faster than lightning!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690120,
					"content": "Well, why don't we just use a stick to pull those crabs out and stuff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690121,
					"content": "If you ask me, we might as well dig some ditch nearby. That'll draw both the water and the crabs out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690122,
					"content": "Hahaha. Everyone's got their own opinion. That's great, that's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690123,
					"content": "If you don't mind, Traveler, could you help us catch a few of the crabs that live under that Thunder Sakura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690124,
					"content": "If you do, I'll whip up a great feast for you as thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690125,
					"content": "Ah, yes. Hang on... Take this bait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690126,
					"content": "If you're going to catch crabs over there, use these to attract them first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690127,
					"content": "It should save you some time and effort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690128,
					"content": "Crabs that live near a Thunder Sakura. I wonder how they'll taste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690105,
					"content": "Oh, we're talking about delicious food again, are we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
		{
