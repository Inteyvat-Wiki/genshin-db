				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "Why hello there, outlander! Do you have any interest in a little scrap, by any chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600102,
					"content": "I've been in thousands of those.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "Ah, wonderful! Glad I had my eye on the right person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600106,
					"content": "It's like this: recently, some people have organized a Hyakunin Ikki in secret again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600107,
					"content": "Don't you mean the Hyakunin Isshu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "No, no, I said \"Hyakunin Ikki.\" What on earth's the \"Hyakunin Isshu,\" anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600110,
					"content": "This practice used to circulate amongst the Tengu-Kin, who imitated the tengu. Basically, they would do this—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600111,
					"content": "When the situation went ill, when they felt down, when something worth celebrating occurred, or if they were simply bored...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600112,
					"content": "They would engage in a hearty fight to celebrate, or simply to eliminate bad luck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600113,
					"content": "Sounds like you could just hold it at any time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "...Now that you mention it, that is true, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600115,
					"content": "Whatever the case, let's find another place to discuss this matter. There are too many people in the city for such talk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600109,
					"content": "I'm all ears.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "Do you have a commission for me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "Now, I wouldn't call this a commission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "Kayabuki Ikkei"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "Here we are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600202,
					"content": "You can enter the Hyakunin Ikki Dojo by stepping through this... rather suspicious door.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600203,
					"content": "Oh, that's pretty exciting.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "Though the Tengu-Kin have long been banned for flouting public order and morals, some still hold the Hyakunin Ikki free-for-all tournament from time to time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600206,
					"content": "Monsters, adventurers, and warriors who long for battle will be attracted here to engage in passionate battle on this stage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600207,
					"content": "Feel free to bring your friends and companions! After all, the \"Hyakunin\" in \"Hyakunin Ikki\" means the more, the merrier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600208,
					"content": "You seem like a well-traveled adventurer. You shouldn't lack for any companions to take part together with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600209,
					"content": "You're not taking part?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "Oh, of course I will — as a spectator, cheering you on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600211,
					"content": "In truth, my goal here is to write the most epic fighting novel ever and use it to take first prize in Yae Publishing House's \"This Novel Is Amazing!\" contest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600212,
					"content": "...And my gut tells me that your star will shine brightest in this arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600213,
					"content": "I'll do my best.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "Great! In fact, I already have a name for my novel. I'm calling it \"Hyakunin Ikki: Greatest Battle Chapter.\" If you should see it in Yae Publishing House's store one day, look out for the bit where the blond-haired outlander makes their debut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600216,
					"content": "I'm looking forward to your performance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726600214,
					"content": "Of course.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "Oh, that's suspicious alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}