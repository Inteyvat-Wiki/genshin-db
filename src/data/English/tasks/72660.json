	"talks": [
		{
			"id": 7266001,
			"completionStepIds": [
				7266001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266001",
							"2"
						],
						"stepId": 7266001,
						"stateName": "QUEST_STATE_UNFINISHED"
