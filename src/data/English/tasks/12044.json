				]
			},
			"dialogs": [
				{
					"id": 120440201,
					"content": "Ahh, remember when we chased that tanuki down this way? Good times!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440202,
					"content": "Huh? What's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440203,
					"content": "A tanuki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "Paimon doesn't think they look anything like that... Oh, maybe there's a new kind of youkai in town?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440206,
					"content": "Umm.... Is it trying to get us to follow it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440204,
					"content": "A piglet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
		{
			"id": 1204403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
