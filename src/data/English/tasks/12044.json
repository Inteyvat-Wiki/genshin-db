					"nextDialogs": [
						120440916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440916,
					"content": "And Paimon really hates bad dreams, so Paimon's even more happy to help knowing that you can eat them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440917,
					"content": "Thank you... but I still owe you an apology...",
