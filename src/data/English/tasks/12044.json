							-4251.508
						],
						"pointId": 322100696
					}
				]
			},
			"dialogs": [
				{
					"id": 120440301,
					"content": "What's that girl doing over there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440302,
					"content": "She doesn't look well... Let's go check on her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440801
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440801,
					"content": "What just happened? All we did was lock eyes with her for a split-second, and then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440802,
					"content": "Wait, where did all these people come from? And what are they here for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440803,
					"content": "Looks like they're waiting in line for some reason.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "True... Oh, and there's that girl! She's still here. Hmm, maybe she knows what happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440805,
					"content": "If I leave now, will I have enough time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 120440806,
					"content": "How many times do I have to explain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 120440807,
					"content": "There's no going back if I report him. But still...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 120440808,
					"content": "Hmm... anxiety over a lack of creative inspiration... Well, inspiration tends to give anxious minds a wide berth, so I hope our treatment will help you relax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440809,
					"content": "...Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 120440810,
					"content": "...Remorse for the misdeeds of the past, and despair over the sorry state of the present... I can help you face your troubles with a more positive mindset, but you'll need to work through things in your own time, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440811,
					"content": "...Many thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "Nishiguchi"
				},
				{
					"id": 120440812,
					"content": "Next please! *cough*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440813,
					"content": "What's wrong with her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440814,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "I'm fine. Next, please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440816,
					"content": "Um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440817,
					"content": "Mmm! Delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440818,
					"content": "Whoa, that was unexpected...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440819,
					"content": "Huh? What do we have here... *burp*! Oh no, I'm so sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440820,
					"content": "Sorry for what? We have no idea what's going on here, let alone what you're sorry for. Would you mind bringing us up to speed?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440821,
					"content": "It looks like you entered my dream by mistake. Let me wake you up, then I'll explain everything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440822,
					"content": "Dream? When did that—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440901,
					"content": "Whoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440902,
					"content": "#Hi! Feeling more awake now? Heh, I never expected {NICKNAME} to literally come to me in a dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440903,
					"content": "How do you know who I am?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "Oh, someone I know talks about you all the time. Plus... I'm pretty good at profiling people based on their reputation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440905,
					"content": "So who are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440906,
					"content": "Right, of course. It's our first time meeting each other, so I should introduce myself properly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440907,
					"content": "My name is Yumemizuki Mizuki — or just \"Mizuki\" for short. I'm a yumekui-baku, which is a kind of youkai here in Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440908,
					"content": "Yumekui-baku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440909,
					"content": "*hum*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "Little Baku"
				},
				{
					"id": 120440910,
					"content": "Hey, it's that little critter from before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440911,
					"content": "That's what we look like in our original form. I'm guessing that's the one that led you into my dream earlier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440912,
					"content": "Baku feast on the bad dreams of human beings — but we need to be in a dream of our own to digest them. The place where you met me earlier was where I go to digest bad dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440913,
					"content": "I must have swallowed one too many bad dreams, because they were causing me some digestive trouble... It's actually a good thing you showed up when you did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440914,
					"content": "Call it a happy accident, I guess. Thanks to your help, I'm now able to digest all these dreams properly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440915,
					"content": "Yeah, we thought you looked a little uncomfortable. That's why we came over. We didn't know what it was, we just thought maybe you could use some help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440916,
					"content": "And Paimon really hates bad dreams, so Paimon's even more happy to help knowing that you can eat them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440917,
					"content": "Thank you... but I still owe you an apology...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440918,
					"content": "For what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "While you were inside my dream... I ate one of your dreams, but it wasn't a bad one. It was a nice one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440920,
					"content": "I've eaten so many bad dreams today that I just scarfed it down without noticing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440921,
					"content": "So yumekui-baku can eat good dreams too, huh... Still, is that really such a big deal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440922,
					"content": "Of course it is. Dreams are some of the most precious things a person can have, and I just went and gobbled it down...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440923,
					"content": "It's the unwritten rule of my kind: Never eat someone else's good dreams without permission. I can't believe I was so careless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440924,
					"content": "Don't beat yourself up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "But... Don't you feel horribly depressed? Isn't your mind suddenly flooded with distressing memories?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440927,
					"content": "Nope.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "Remarkable... I've never heard of someone remaining so mentally stable after having a good dream of theirs devoured...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440929,
					"content": "#Umm... It's probably because {NICKNAME} has too many good dreams to count!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440930,
					"content": "Maybe, but I still owe you something for your trouble... Ah! Here, take this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440931,
					"content": "It's a VIP pass for the Aisa Bathhouse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440932,
					"content": "\"Staffed by clinical psychologists and offering spa and fine dining services, we invite you to bring us your troubles and leave refreshed and renewed\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440933,
					"content": "That's where I work. You'll find the address on there, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440934,
					"content": "This invitation letter entitles you to enjoy our highest-tier service, free of charge... Oh, and speaking of work — I'd better get back before I'm missed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440935,
					"content": "Hope to see you as customers soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440936,
					"content": "So she's a yumekui-baku that eats bad dreams and a clinical psychologist, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440937,
					"content": "It adds up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "Paimon's never considered therapy before. Then again, Paimon never really gets that stressed out. Except when she's trying to decide what to eat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440940,
					"content": "Speaking of eating — that bathhouse place does fine dining, and we have a VIP pass. That means we can eat as much as we want, right? This is the opportunity of a lifetime! We can't let it go to waste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440938,
					"content": "Yeah. Kinda cool...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "I feel fine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
		},
