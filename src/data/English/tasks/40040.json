			"dialogs": [
				{
					"id": 400400101,
					"content": "Gather round, gather round! If you're passing by, don't pass this up: Introducing the amazing Shadow Lantern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400102
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400102,
					"content": "\"Shadow Lantern\"? Ooh, Paimon's never heard of this one before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400400103,
					"content": "You two look like you're out to have some fun! Care to check out the Shadow Lantern? My latest invention, made to amaze and amuse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400104
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400104,
					"content": "It's very simple — all you have to do is rotate the objects inside the Shadow Lantern, get all the shadows to merge in a certain way, and the most incredible images will be revealed before your very eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400106
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400106,
					"content": "Intrigued? You should try it out for yourself! It's set up right here — please, peruse and use at your leisure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400107
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400107,
					"content": "I hope the Shadow Lantern shows you something truly spectacular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400400108
					],
					"speakerTitle": "Yuan Rong"
				},
				{
					"id": 400400108,
					"content": "Sounds pretty cool! Let's give it a whirl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
