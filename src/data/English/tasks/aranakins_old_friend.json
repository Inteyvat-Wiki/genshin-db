			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "What memories is it keeping? What did you see?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570702,
					"content": "It seems that the owner of the notebook knows you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "Is that so...? I can't remember...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570704,
					"content": "He said... He couldn't see you anymore. Because he grew up, maybe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570705,
					"content": "Hmm... Growing up is really troubling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570706,
					"content": "Oh right! He also said in the notebook that... This flower is for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570707,
					"content": "Here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "Huh...? Ahh! This flower is very important! Why do you... how did he get it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570709,
					"content": "Actually, you once gave us the same flower as well... It's just that you forgot everything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570710,
					"content": "Really...? I can still make friends with you again. But... As for him, I can't even recall his face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570711,
					"content": "I—It's okay... Don't be sad, we still have this flower. It will bring you more memories, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570712,
					"content": "Yes, White Floaty is right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570713,
					"content": "I am taking this flower back, Mawtiyima should know how to wake her up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570714,
					"content": "#Hmm... Nara {NICKNAME} and White Floaty, I am going back to where Aranaga is, planting her, and listening to her songs. If you are not busy, you know where to find us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570715,
					"content": "Yes, see you soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
