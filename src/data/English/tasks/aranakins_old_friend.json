					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "\"...I've repaired the oud Uncle Bakr dropped, so stop crying by yourself, alright? You can talk to Khayyam and me if you're unhappy...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Battered Notebook"
				},
				{
					"id": 730570902,
					"content": "\"...I've been accepted into the Akademiya! Haha, congratulations to me! I don't want to be some warrior's wife! I'm going to be Siman, the Great Sage!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Battered Notebook"
				},
				{
					"id": 730570903,
					"content": "\"Hehe... Irfan the 'Great musician' and Khayyam 'the Wise!' Don't forget me! Especially you, Khayyam! Don't you dare forget me!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Battered Notebook"
				},
				{
					"id": 730570904,
					"content": "\"...Farewell, notebook! Farewell, Irfan and Siman, my best friends! I hope that the forest never forgets our story, and I hope we remember each other...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Battered Notebook"
				},
				{
					"id": 730570905,
					"content": "(...The rest is a mess and filled with the children's happy and sorrowful memories...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Battered Notebook"
				},
				{
					"id": 730570906,
					"content": "\"...Aranakin is gone. Vanished into thin air, and without so much as a sign as to when. It's time for me to bid farewell to the oud too. I'll be a craftsman, just like my father had hoped I would...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Battered Notebook"
				},
				{
					"id": 730570907,
					"content": "(There seems to be more, but it's been crossed and blacked out with ink.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Battered Notebook"
				},
				{
					"id": 730570908,
					"content": "\"...To the person reading this notebook, if I by some miracle am allowed to meet Aranakin and the others again, years from now, then please give this flower to him...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Battered Notebook"
				},
				{
					"id": 730570909,
					"content": "Hey, something fell out of the notebook!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "It looks like... a flower? It looks... exactly like the ones we got.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
