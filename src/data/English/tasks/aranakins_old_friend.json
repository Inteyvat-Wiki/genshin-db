			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "Ah, he's gone... But Paimon understands, he's forgotten our adventures together, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570102,
					"content": "Don't lose heart now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "Yes, you're right... Oh, Paimon has an idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570105,
					"content": "Aranakin taught us a song, right? Let's play it, and maybe he would recognize it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570106,
					"content": "That's a valid idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "Hee-hee, because Paimon is Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570108,
					"content": "That's finally some helpful advice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "Hey! Stop being so mean to Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570103,
					"content": "We can be friends all over again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305707",
							"2"
						],
						"stepId": 7305707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570201,
					"content": "Haha, here he comes! Hello, little thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570202,
					"content": "Aranakin is not a little thing! You are! You floaty white little thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570203
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570203,
					"content": "Speaking of which, golden sand... Nara, why do you know this song?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570204,
					"content": "Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570205,
						730570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570205,
					"content": "You taught us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570206
					]
				},
				{
					"id": 730570206,
					"content": "Yes, during our last adventure, you taught the song to us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570209,
					"content": "Is that... so? Hmph, Aranakin is not clever, but you don't look like those bad sand grains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570210,
					"content": "No, we don't! You told us that sand is Valuka. So the bad sand grains are a group of bad Nara Valuka, right? But we are good Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570211,
					"content": "Ohh? Did I tell you that as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570212
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570212,
					"content": "#Haha, that's right! {NICKNAME}, let's tell the stories to him again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570213,
					"content": "You recount the adventures to Aranakin, as well as how you neutralized The Withering together.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730570214
					]
				},
				{
					"id": 730570214,
					"content": "...I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570215
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570215,
					"content": "Aranakin is not clever, but what you said, sounds to be true. Aranakin can't remember, sorry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570216
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570216,
					"content": "No, no need for that! Y'know, it's pretty normal to forget things... Besides, we can become friends again, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570217,
						730570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570217,
					"content": "Aranakin is a good kid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570220
					]
				},
				{
					"id": 730570220,
					"content": "Ah... Since we're good friends, follow me then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570221
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570221,
					"content": "Oh? But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570222,
					"content": "Golden Nara and White Floaty! Come to my place, follow me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570218,
					"content": "Paimon is a good kid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570219
					]
				},
				{
					"id": 730570219,
					"content": "Hehe, that's for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570207,
					"content": "I played this song, so that I could meet you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570208
					]
				},
				{
					"id": 730570208,
					"content": "#Hehe, how did {NICKNAME} do? See? We still remember the melody you taught us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
