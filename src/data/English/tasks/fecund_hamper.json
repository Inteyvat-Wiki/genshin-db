				"points": []
			},
			"dialogs": [
				{
					"id": 736800101,
					"content": "Hello and welcome to Weinlesefest. May Lord Barbatos bless you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800102
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800102,
					"content": "#Hey, {NICKNAME}, look! There's a noticeboard here, and there's a whole bunch of paper pinned to it. Is it a commission board or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736800103,
					"content": "Hehe, no, they're not commissions. These are clues to find Fecund Hampers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800104
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800104,
					"content": "What's a Fecund Hamper? Ooh! Is it a sort of treasure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736800105,
					"content": "That's one way to look at it. It seems it's your first time participating in the festival. Would you like me to give you a brief explanation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800106,
						736800107
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800106,
					"content": "Well, since Paimon's so interested...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				},
				{
					"id": 736800108,
					"content": "Alright. Simply put, a Fecund Hamper is a gift prepared by residents for lucky outsiders during the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800109
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800109,
					"content": "We aren't just welcoming the return of Lord Barbatos, but we also mean to share the joy of harvest and reminisce about good times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800110
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800110,
					"content": "Everyone will put a gift in a wooden box shaped like a barrel and hide it in a place that holds memories for them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800111
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800111,
					"content": "Next, the owner of the gift will leave clues. The first person, no matter who, to find the box will get that gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800112
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800112,
					"content": "Other than gifts, everyone will also leave a message in the box to the person who finds it. This is a sincere blessing, often more valuable than the gift itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800113
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800113,
					"content": "This sounds pretty fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736800114,
					"content": "So, would the two of you like to try looking for a Fecund Hamper? You should be able to work the clues out easily if you have some knowledge of Mondstadt customs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800115
					],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800115,
					"content": "#Let's try, {NICKNAME}! We might even find a gift from someone we know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736800116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736800116,
					"content": "Good luck and have fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Annette"
				},
				{
					"id": 736800107,
					"content": "Go ahead, please.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736800108
					]
				}
			]
		}
	]
}