			"dialogs": [
				{
					"id": 200180301,
					"content": "That'll do the trick. I should be able to fix the cart now. I think. I hope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180302
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180302,
					"content": "Shoot, they're back! Help me, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Magar"
				}
