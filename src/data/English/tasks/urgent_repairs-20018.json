			"dialogs": [
				{
					"id": 200180801,
					"content": "I'm afraid I have to go...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180802
					]
				},
				{
					"id": 200180802,
					"content": "Don't go... Please. If I try, I—I'll only mess it up again. I need you. You're my only hope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Magar"
