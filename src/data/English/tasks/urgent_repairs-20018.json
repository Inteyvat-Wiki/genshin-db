				"objectNames": [
					"Terrified Magar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "Thank you, Traveler. Ugh, trust me to find a way to balls everything up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180102,
					"content": "If I can't even take a cart of wine from A to B without running into trouble... What good am I for anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180103,
					"content": "I'll be fired from the Winery if I don't get my act together... That is, if Mr. Connor isn't on to me already. Ugh, I bet Mr. Elzer's drafting up my dismissal letter as I speak... It's hopeless, it's all hope—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180104,
					"content": "Whoa Nelly! Calm down.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "*sigh* Well, even if my job situation is beyond hope, I should still get this cart to its destination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180106,
					"content": "The cart's also been damaged... Traveler, could I trouble you to help me find what I need? Just one <color=#00E1FFFF>Sturdy Plank</color> will be enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Magar"
				}
			]
		},
		{
			"id": 2001802,
