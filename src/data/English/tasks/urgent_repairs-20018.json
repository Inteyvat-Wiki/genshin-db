			},
			"dialogs": [
				{
					"id": 200180401,
					"content": "Phew... Thank goodness you are here, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180402,
					"content": "But I don't know how I'm going to fix my cart now, after that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180403,
					"content": "There's damage everywhere... I guess I'll have to patch it up as best I can. Whatever I do, it's not going to be a permanent fix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180404,
					"content": "Never mind. As long as it holds together for the journey into town, I can figure out the next step once I'm there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180405,
					"content": "I thought there was some rope in the cart... Gah, they must have made off with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180406,
					"content": "Traveler... Why don't you take a look in the woods over there for me? If there's a <color=#00E1FFFF>Rope</color> around, that would be perfect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Magar"
				}
			]
		},
