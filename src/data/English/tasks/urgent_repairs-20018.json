			"dialogs": [
				{
					"id": 200180601,
					"content": "Thank you, Traveler. That will do nicely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180602
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180602,
					"content": "This should hold out long enough to get me to Springvale. Once I've dropped off the goods there, I'll head back to the winery and update them on what went down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180603
					],
					"speakerTitle": "Terrified Magar"
				},
				{
					"id": 200180603,
					"content": "Hopefully Elzer doesn't fire me on the spot when he sees what's happened to his cart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Magar"
				}
			]
		},
