			},
			"dialogs": [
				{
					"id": 751791101,
					"content": "What am I gonna do... What am I gonna do? The boss is definitely gonna beat me up when I get back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "*sigh* It's a long story... Our caravan was moving along just fine when the volcano erupted out of nowhere. Then, these massive purple Tepetlisaurs burst out of the ground...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "I wasn't paying attention, and my saurian partner got spooked and carried me far from the group. By the time I got us turned back around, the path was completely blocked, and now I can't get back to the others...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "I don't even know how everyone else is doing... and I ditched the group without permission... The boss is gonna kill me. I'm done. This is it. I'm dead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "If it were me, I'd just run...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "Run? No, no, no, that's impossible. The boss is like the Night Kingdom — everywhere, all the time. She'll hunt me down and drag me back no matter where I go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "I've gotta go back and apologize. But how? The road's blocked... Ugh, I'm so dead this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
		},
