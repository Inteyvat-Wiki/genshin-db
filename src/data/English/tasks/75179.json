			"dialogs": [
				{
					"id": 751790901,
					"content": "Oh no, Itsaho, there's still so much missing from the list... H—Help me look for them, would you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "*sigh*... Don't waste your time. I already checked. Most of them were fragile goods. Do you really think any of them are still in one piece after the eruption and the crash?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Save your energy and take a break. We've got a long road ahead of us once the boss and the others get back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
					"content": "N—No way! F—Fine, if you're not going, I'll just go myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masose"
				}
