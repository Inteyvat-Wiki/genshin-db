			"dialogs": [
				{
					"id": 751791301,
					"content": "Hey, chubby! Ensuring the caravan's safety is your job, isn't it? So what's this about someone else having to clean up your mess? What do you have to say for yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791302
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791302,
					"content": "I—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791303
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791303,
					"content": "Quit stuttering! If you hadn't panicked and dropped your guard, a few measly monsters wouldn't have been a problem for me! This time, you're giving up part of your pay to thank our savior. Got it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791304
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791304,
					"content": "I—I... I'll do whatever you say, boss...",
