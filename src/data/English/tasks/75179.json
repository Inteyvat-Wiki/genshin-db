			"dialogs": [
				{
					"id": 751790701,
					"content": "So, it's all thanks to these three that you made it out safe, boss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "Haha, that's right! You should've seen them in action — took down those monsters in just a couple of moves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "You saved the caravan leader. That's a debt I haven't much to offer in repayment for. But please, take this small gift as a token of my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "Seriously, Tizlo? Have you always been this stingy? That's all you're giving to the people who saved your life!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				}
			]
		},
