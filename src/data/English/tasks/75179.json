				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2985.355,
							284.137,
							9968.472
						],
						"pointId": 10719
					},
					{
						"sceneId": 3,
						"position": [
							-2984.694,
							282.976,
							9964.69
						],
						"pointId": 10984
					}
				]
			},
			"dialogs": [
				{
					"id": 751790301,
					"content": "Of course, such a small token as a life-saving gift does seem a bit stingy, doesn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "Indeed, it feels a bit lacking.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "Haha, well said! I like people like you — you say it how it is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "Ahem, anyway, this is a personal gift from me to you. Just accept it! Consider it a little something extra for your little Tepetlisaurus to get some more snacks. No need for any thanks or formalities!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Alright, we still need to go pick up all the stuff we lost along the way. We'll be heading off now! May we meet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "No, this is more than enough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "Tsk, you're really not very forthright, are you? That's no fun. Just take it already! Otherwise, if word gets out, people will label me a cheapskate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
		{
			"id": 7517904,
			"completionStepIds": [
				7517915
			],
			"beginWay": "TALK_BEGIN_MANUAL",
