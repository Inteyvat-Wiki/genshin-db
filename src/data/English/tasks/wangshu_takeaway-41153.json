					"nextDialogs": [
						411530303
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411530303,
					"content": "This Black-Back Perch Stew has had greater emphasis placed on the quality of its soup. So you <color=#00E1FFFF>can't fly or climb all over the place</color>, or you'll spill it for sure. You'll want to make the delivery quick, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411530304
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 411530304,
					"content": "If you meet with an accident along the way, come back here and I'll make you another serving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				}
			]
		},
