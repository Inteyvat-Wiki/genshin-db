			"dialogs": [
				{
					"id": 747050101,
					"content": "Hmm, I think... This one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050102,
					"content": "Yes, I see what you mean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050103,
					"content": "Why that one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050104,
					"content": "Look at the color of its tail. It's the most fashionable thing in the whole aquarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050105,
					"content": "The colors are a bit loud for my taste, but alright, I'll take it as a compliment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050106,
					"content": "Whoa! Look at all these people! Is everyone here to see the fish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050107,
					"content": "Mmhmm! I just wrapped up a scene, so I'm taking time out to admire your aquarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050108,
					"content": "What were you talking about just now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050109,
					"content": "We were trying to decide which fish looks most like Chiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050110,
					"content": "You guys do that too!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050111,
					"content": "Oh, uh, hehe... Oh well, it was actually Columbina who mentioned it originally. It sounded like fun, and then, before we knew it, we were doing it too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050112,
					"content": "So it's contagious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050113,
					"content": "Oh, look! That one's just like you, Chevreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050114,
					"content": "What do you mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050115,
					"content": "Never still, swimming laps around the tank. Just like you, training every second of the day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050116,
					"content": "...Is that how you see me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
