			"dialogs": [
				{
					"id": 250330101,
					"content": "Good boy, good boy! Eaten your fill today? Ready to train?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330102,
					"content": "Raar, oroo, rrooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330103,
					"content": "Pretty energetic today, aren't we? Awesome! Let's do this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330104,
					"content": "Yeah, let's do this!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "Huh? Oh, hello there! We're doing some more mountain climbing training right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330107,
					"content": "Rroo! Wrroo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330108,
					"content": "Wrooo, rrooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330109,
					"content": "How's the training coming along?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "Well... we're \"making progress.\" Qica's made it up a lot further this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330111,
					"content": "It's just that Qica's not very familiar with how you climb mountains, and...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330116,
					"content": "Could you demonstrate for us again, by the way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330117,
					"content": "Sure I can.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "Thank you so much! I'm sure I'll be able to catch your movements this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330119,
					"content": "You keep your eyes peeled too, alright, Qica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330120,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330123,
					"content": "We're counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330124,
					"content": "So what we'll do is time you while you climb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330125,
					"content": "Wroo, roooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330121,
					"content": "Watch closely this time, alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "Of course! Qica and I won't miss a thing this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330112,
					"content": "Looks like he's recovering nicely.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "That's right. Mom says I'm getting real good at caring for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330114,
					"content": "Qica's improved loads. He can climb way higher than he could last time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330115,
					"content": "It's just that Qica's not very familiar with how you climb mountains, and...",
