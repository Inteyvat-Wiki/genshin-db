			},
			"dialogs": [
				{
					"id": 737060101,
					"content": "Good news, everyone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060102,
					"content": "The Fieldwise center is getting a lot of praise from important scholars all throughout the Akademiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060103
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060103,
					"content": "Soon, they'll send a team of specialists to take over the management of this place based on our recommendations!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060104,
					"content": "So, thank you for all the support!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060105
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060105,
					"content": "Wow, sounds like your hard work paid off, Collei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060106,
					"content": "And you're overseeing the transition yourself... Well done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060107
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060107,
					"content": "The young students today could learn a thing or two from you, Collei. Your confidence, your proactiveness, your leadership... It's admirable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060108
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060108,
					"content": "Not like some of the ones I teach, so focused on theses and research, with no practical skills to speak of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060109
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060109,
					"content": "T—To be honest, I don't feel all that confident. Being the go-between for all the different Darshans, coordinating everything... I still can't quite believe I managed it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060110
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060110,
					"content": "#Oh, but {NICKNAME} and Paimon played a huge role in that too. I can't thank you both enough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060111,
						737060112
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060111,
					"content": "It was nothing!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060113
					]
				},
				{
					"id": 737060113,
					"content": "Yeah, we're used to this kinda work. So, for us, this was more like... a super special camping trip with friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060114,
					"content": "Y'know, a few puzzles here, a little exercise there... It was super fun! Pretty much a piece of cake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060115,
					"content": "Aw, man... Now Paimon's hungry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060116,
					"content": "Hey, now that we're all done, why don't we go get some food to celebrate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060117,
					"content": "Hah, Candace and I are two steps ahead of you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060118
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060118,
					"content": "This way, everyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060119
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060119,
					"content": "Woohoo! A feast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060120,
					"content": "Mm! Perfect timing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060121,
					"content": "Aww, it's been a while since we've had such a delicious spread of dishes from Sumeru... Paimon feels like she could eat twice as much... No, three times as much as normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060122,
						737060123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060122,
					"content": "We should come around more often then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060124
					]
				},
				{
					"id": 737060124,
					"content": "Hah, is that a challenge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060125,
					"content": "Careful what you wish for. We have your wallet to think about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060126,
					"content": "Mmm! It's been a while since I've had food from the desert region...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060127
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060127,
					"content": "It's nothing like I remember...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060128
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060128,
					"content": "Now, this is the real deal. Everything I've tried before pales in comparison.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060129
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060129,
					"content": "That means a lot, Madam Faruzan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060130
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060130,
					"content": "If all the researchers who came to our village were so polite, we would have an occasion to offer feasts like this more often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060131
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060131,
					"content": "By the way... You planning on doing any sight-seeing, Miss Amber? You came all this way, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060132
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060132,
					"content": "Oh, for sure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060133
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060133,
					"content": "I hear that there's a forest full of gigantic trees northwest of Port Ormos, with trunks bigger than the entire width of the Good Hunter restaurant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060134
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060134,
					"content": "I'd love to see it for myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060135
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060135,
					"content": "Ooh, and I bet I could climb up and then glide down from the tree tops! That sounds so fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060136
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060136,
					"content": "In that case, I'll give you some snacks to take with you... like a dense cake or some dumplings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060137
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060137,
					"content": "The wind's strong up there, so you don't want anything too crumbly. Oh, and you'll need a thicker water skin, so it doesn't break if it drops...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060138
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060138,
					"content": "Ooh, dumplings sound great... so soft and chewy. Great thinking, Collei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060139,
					"content": "As for the desert, I'd love to check out some of the ruins, like that giant one shaped like an hourglass!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060140
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060140,
					"content": "I'll just observe from a distance, though. Your ruins could be protected sites, so... better to not barge in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060141
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060141,
					"content": "Besides, there could be someone sleeping in there, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060142
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060142,
					"content": "I'm glad to hear that, Miss Amber. It's for the best...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060143
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060143,
					"content": "Hm, your body won't be used to the desert environment, though, so traveling could be tough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060144
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060144,
					"content": "You'll need to bring moisturizing ointment, and essential oils for the skin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060145,
						737060146
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060145,
					"content": "So, we're even thinking about skin care...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060147
					]
				},
				{
					"id": 737060147,
					"content": "Honestly, though, helping set up the Fieldwise Center was the real highlight of this trip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060148
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060148,
					"content": "And thanks to you, Collei, I got to make some new friends, too! So, I couldn't be happier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060149
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060149,
					"content": "Feel free to drop in on me in Mondstadt any time! I'll show you the best our city has to offer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060150
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060150,
					"content": "Don't mind if I do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060151
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060151,
					"content": "I had some Dandelion Wine while I was in Fontaine, and man... that was the stuff. So sweet and fragrant... Not a single bitter note in there at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060152
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060152,
					"content": "And that was the imported stuff! I bet the taste is even better when it's fresh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060153
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060153,
					"content": "I'm looking forward to downing a couple of barrels already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060154
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060154,
					"content": "Ahem... It couldn't hurt to take a break from wine, either. Those children gave you some Henna Berry thorn powder, remember? You could make some tea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060155
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060155,
					"content": "Aha... Ahaha... C—Come on, Candace, it's just a taste. The barrels aren't even that big... We're talking, like, three to five cups per, tops.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060156
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060156,
					"content": "And, don't worry, I'd make sure to bring back souvenirs for everyone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060157
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060157,
					"content": "Well, I've heard the Knights of Favonius Library has quite the collection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060158
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060158,
					"content": "I wonder if there are tomes that approach engineering from a different angle — could be worth perusing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060159
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060159,
					"content": "I'm not sure about the exact number, but the library's pretty huge, alright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060160
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060160,
					"content": "What kind of books are you interested in, Madam Faruzan? I can write them down and have Lisa get them ready for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060161
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060161,
					"content": "Either way, just leave your Mondstadt travel plans to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060162
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060162,
					"content": "Lisa... Lisa Minci? Cyrus's prized student, who he never stops bragging about...? So, that's where she's hiding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060163
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060163,
					"content": "Ahhh, this is kinda nice, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060164,
					"content": "Friends of ours meeting other friends of ours, then becoming friends in their own right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060165,
						737060166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060165,
					"content": "The world doesn't stand still, after all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060167
					]
				},
				{
					"id": 737060167,
					"content": "Yeah! Maybe we should start introducing our friends to each other! Paimon can think of a few who might get along...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060168
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060168,
					"content": "Not a bad idea, right? Just imagine all the fun we could have, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060166,
					"content": "It's nice to have friends all over, don't you think?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060167
					]
				},
				{
					"id": 737060146,
					"content": "This is a whole new level of thoughtfulness...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060147
					]
				},
				{
					"id": 737060123,
					"content": "I'm still waiting for the day you clean out an entire restaurant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060124
					]
				},
				{
					"id": 737060112,
					"content": "A total team effort!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060113
					]
				}
			]
		}
	]
}