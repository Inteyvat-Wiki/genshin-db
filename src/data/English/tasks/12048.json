			"dialogs": [
				{
					"id": 120480101,
					"content": "Scuse me, hello! Please come register over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120480102,
					"content": "What's going on? Why are there so many guests? Had I known, I'd have definitely turned some of them back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120480103,
					"content": "Whoa, looks like business is booming with Emura Ichigensai out of the picture! And it's good to see that Murasaki and Shion are well on the road to recovery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480104,
					"content": "#Morning, {NICKNAME}, Paimon. Want to make an appointment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480105,
					"content": "Yes please! For today, if possible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480106,
					"content": "Then, I'd better get you another VIP pass. You're our most important customers, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480107,
					"content": "Hee-hee, awesome! In that case, Very Important Paimon would like to start with the fine dining this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480108,
					"content": "Oh my... Imagine if you'd taken my advice and sold your shares the other day. It could have cost you dearly now that business is booming again. I hope you're not too upset with me, old friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480109,
					"content": "Why would I be upset? It's not as if I ever took your suggestion seriously.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480110,
					"content": "Ah, I've missed that way with words. So affectionate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480111,
					"content": "Would it kill you to not sneak up on people every darn time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480112,
					"content": "Morning, little ones. Did you enjoy the scenery last night?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480113,
					"content": "What? ...You were spying on us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "Hardly. That tree was directly beneath the Grand Narukami Shrine. What was I supposed to do, move the entire shrine to give you some privacy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480115,
					"content": "Is there a reason you're here, Lady Guuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480116,
					"content": "Heh... Mostly because I felt like a walk. But I do have a message from the Tenryou Commission to pass on, as it happens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480117,
					"content": "The gentleman who your fellow yumekui-baku fished out of the water last night is no longer in a critical condition. Although, his mind seems to have regressed to that of a young child.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480118,
					"content": "It could have been worse, I suppose... Lady Guuji, I owe you my thanks. Without your help, things might've gone a lot less smoothly yesterday.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480119,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480120,
					"content": "Wasn't me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "Come on, Miko. You've always been worse than me at keeping secrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480122,
					"content": "I admit that I feel inferior around you, and have an urge to prove myself. How could I not? But maybe these feelings are what have driven me to take this business as far as I have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480123,
					"content": "My sense of inferiority keeps my ego in check, and my desire to prove myself gives me the strength to persevere. I'm able to accept these parts of me for what they are — there's no need for you to tiptoe around them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480124,
					"content": "#*sigh* You could have told me sooner... The poor {NICKNAME} here has been doing all my running around for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480125,
					"content": "#True. But then again, without {NICKNAME}'s help, you'd have been placed in a difficult position.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480126,
					"content": "Emura Ichigensai had amassed a huge following. For the Guuji of the Grand Narukami Shrine to publicly go against him would have been a dangerous move.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480127,
					"content": "An angry mob of zealots could have done some serious damage to the shrine's reputation... Much safer for the Guuji not to get personally involved. It was the right decision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480128,
					"content": "While that's all true, my main concern was that I didn't want to upset an old friend. Otherwise, I could have taken a much more direct approach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480129,
					"content": "Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480130,
					"content": "I always seem to forget that you're more cunning and less adorable than you look... Seems like my worries about upsetting you were unfounded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480131,
					"content": "...It's not that I don't get upset. Everyone has their fair share of troubles... But every sorrow has its cure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480132,
					"content": "Here's your new VIP Pass. Please take good care of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
