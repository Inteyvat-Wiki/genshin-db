				"points": []
			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪Rose, oh rose, grant me my wish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "Hmm? You're still here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "Why live here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Well, anyway, I'm an old weirdo, and \"old weirdos behave in inexplicable ways.\" Few people ask me questions like you do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "I've always wanted to go out and grab the chance to do something with my life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "When I was a newlywed, I almost left with the Eremites, but then I thought about it, and I couldn't just leave my wife to take up a life of wandering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "Later, I met a traveling merchant and wanted to follow suit and do some business, but that didn't work out because I didn't have enough Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "Much later, my wife passed and nothing held me back anymore, but by then, I'd gotten too old to leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "I've dragged things out up till now and I've missed out on too much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "In retrospect, I've found that I belong neither to this village, nor to anywhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "So in the end, I moved by myself to the edge of the village, and I found life here to be more comfortable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "And decades went by, just like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "I'd like to invite you to come and see these flowers when they bloom. It's probably going to be tomorrow or the day after. Will you be able to make it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Alright, alright...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪Rose, oh rose, grant me my wish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "About the old ghost...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Only outsiders ask about the old ghost. The children of the village all know his name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "Whenever a child is naughty, their parents will say, \"The old ghost will come take you away.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "These younglings don't know the old ghost at all, but are pretty good at using his name to scare people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "I met the old ghost myself as a child. He did dislike children, but he wasn't scary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "For some reason, he became known as the old ghost. I thought it was just a bunch of people talking about him behind his back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "Weren't you friends?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "When I was young, I used to sneak close to his garden to play. He'd chase me away with a garden hoe as soon as he saw me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "He probably took me for a naughty child looking to cause trouble. Why would he remember me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "He might not have known who I was, but I still remember him and his little garden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "So I suppose I can call him my friend, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "I want to grow the same flowers, just to recreate that little garden in my memories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320601,
			"completionStepIds": [
				7320601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320601",
							"2"
						],
						"stepId": 7320601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "Oh, it's you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060102,
					"content": "How are the seeds doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "None of them have sprouted yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060104,
					"content": "I've checked the surface of the seeds, and there's not even the slightest hint of germination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060105,
					"content": "Why is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060106,
					"content": "I'm sure these are the right seeds. I found them in the storeroom based on the old ghost's notes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060107,
					"content": "According to his notes, the seeds have a long shelf life, and they won't ever go bad so long as they're kept dry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060108,
					"content": "And there shouldn't be any problems with the way I planted them either. I watered and fertilized them as I should... So why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060109,
					"content": "Don't worry. Why don't we wait a little longer, Grandpa Affan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060110,
					"content": "Every time the two of us go to pick fruits and flowers in the wild, we have to wait several days for them to grow back after we pick 'em up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060111,
					"content": "Be patient.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "Ah, I suppose I will just have to wait. Do you guys have time today? Can you help me water them again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060114,
					"content": "It took me hours to loosen the soil in the nursery and I'm too tired to run back for water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060115,
					"content": "Got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060112,
					"content": "Keep watering them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
			"completionStepIds": [
				7320603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"2"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060301,
					"content": "I'll keep watering them and feeding them fertilizer... But really, will it work out...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060302,
					"content": "I don't know anymore. *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060303,
					"content": "After dawdling for so long, I've finally decided to do something, and yet I still can't do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060304
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060304,
					"content": "I failed to fulfill your wish, old ghost. I'm sorry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060305
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060305,
					"content": "Grandpa Affan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060306,
					"content": "Thank you for the day, children.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
