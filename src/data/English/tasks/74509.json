					}
				]
			},
			"dialogs": [
				{
					"id": 745090101,
					"content": "After a while, you and Paimon arrive at the Lil' Fungi's Fun-Tastic Fiesta booth...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745090102
					]
				},
				{
					"id": 745090102,
					"content": "Oh, the Twin Stars of Brilliant Valor! Are you back for more of Lil' Fungi's Fun-Tastic Fiesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090103
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090103,
					"content": "Ms. Enghiene received orders to return to the Maison Gardiennage, so I'll be playing against you for now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090104
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090104,
					"content": "Hey, Souka! You're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090105,
					"content": "Paimon was pretty surprised when we met Haniyyah, but you've taken it to the next level! Your outfit is so... Well, you sure are enthusiastic!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090106,
					"content": "And that's a good thing, because I have a lot of work... I need to stay motivated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090107
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090107,
					"content": "And that's why I'll cut my problems down, one clean axe-swing at a time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090108,
						745090109
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090108,
					"content": "How are things at the newspaper?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				},
				{
					"id": 745090110,
					"content": "Our plan is progressing steadily. Novel events like these attract a lot of attention, and the paper won't miss any promotion opportunities!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090111
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090111,
					"content": "We didn't get the most important page, but it's clear that the event's becoming more popular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090112
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090112,
					"content": "That's right. We've seen an increase in ordinary citizens who wanted to give our game a try recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090113
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090113,
					"content": "Many have been talking about what's the best Fungi team with which to win a round quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090114
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090114,
					"content": "I've also heard that people have been looking to play against you two, so they can see how the experts play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090115,
						745090116
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090115,
					"content": "We'd like to keep a low profile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090117,
					"content": "Unless the two of you play against us, of course. You know our strategies very well already...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090118,
					"content": "Paimon thinks a match between you and us... will be a real test of technique!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090119,
					"content": "Well, you're here now, so why don't we play a friendly round?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090120
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090120,
					"content": "Come to think of it, the last time we went head-to-head with you was during the first Nilotpala Cup Beast Tamers Tournament, where you beat me most soundly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090121
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090121,
					"content": "How nostalgic. After that, Haniyyah and I went through a lot together, and many things changed. I bet it was the same with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090122
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090122,
					"content": "But your... seasoned courage and fearless aura are still as unwavering and sturdy as crystal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090123
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090123,
					"content": "That alone was enough for us to decide that we'd follow you, back when we were preparing Fungus Mechanicus. I think we made the right choice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090124
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090124,
					"content": "Uh, why are you reminiscing all of a sudden? Is it something that writers do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090125,
						745090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090125,
					"content": "I miss those times, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090127,
					"content": "Yes! What an incredible line!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090128
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090128,
					"content": "Anyway, as one of the designers of the game, I've got an ace up my sleeve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090129
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090129,
					"content": "Are you talking about \"that,\" Souka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090130
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090130,
					"content": "That's right. I'll get started, and then Haniyyah will control powerful opponents against you. It should make for an exciting match!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090131
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090131,
					"content": "Let's do this, Golden Comet, Silver Companion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090132,
						745090133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090132,
					"content": "Alright!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090134,
					"content": "After all this time, you're going up against Haniyyah again... Ooh, this is so exciting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090135,
					"content": "But this is a friendly match, so let's just have fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090133,
					"content": "It's on!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090126,
					"content": "We can make new memories together.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090116,
					"content": "Alas, so many people, and such hurry to lose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090109,
					"content": "How are the advertisements coming along?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				}
			]
		}
	]
}