						4630105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630105,
					"content": "*pitter-patter*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630106,
					"content": "Listen, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "Oh! Mice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630108,
					"content": "You didn't even try, did you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "It's no time to get suspicious. We're close!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630110,
					"content": "Hurry! The treasure is waiting for us!",
