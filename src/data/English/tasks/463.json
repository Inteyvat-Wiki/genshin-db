					"nextDialogs": [
						4630103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630103,
					"content": "Oh, Paimon gets it! The perfect disguise is always in plain sight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "Paimon"
				},
				{
