					"nextDialogs": [
						706750104
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750104,
					"content": "By which I mean, you still don't know a thing about what cats are capable of! Anyway, feel free to use the new Invitation Board and invite your friends for a duel in the special room!",
