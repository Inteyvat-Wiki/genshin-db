	"talks": [
		{
			"id": 7302301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shefket"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230101,
					"content": "Hey, you over there! The one who just hunted that wild boar with mushrooms on its back... Can you come over here? I have something to discuss with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shefket"
				}
			]
		},
		{
			"id": 7302303,
			"completionStepIds": [
				7302303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302303",
							"2"
						],
						"stepId": 7302303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Shefket",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230301,
					"content": "Oh, I'm really sorry if I'm bothering you, but I have something to discuss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230302
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230302,
					"content": "Can I have a piece of that Shroomboar you just hunted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230303
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230303,
					"content": "Shroomboar... That wild boar with mushrooms on its back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230304,
					"content": "Yup, exactly. They're always rolling in the mud of Sumeru, so spores stick to their fur and grow into mushrooms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230305
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230305,
					"content": "Haha, some say the mushrooms gradually eat away at the wild boar while they grow... Likewise, the Shroomboar's meat gains a unique mushroom aroma, and becomes expensive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230306,
						730230307
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230306,
					"content": "Sounds creepy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				},
				{
					"id": 730230308,
					"content": "Haha! It's just a rumor. Shroomboars can eat the mushrooms on each other's backs during the winter or when they have nothing to eat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230309
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230309,
					"content": "Mushrooms, on the other hand, can spread their spores even further with the wild boars carrying them... It's actually a healthy symbiotic relationship...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230310
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230310,
					"content": "Ooh, forgive me, I don't think I've introduced myself. I'm Shefket, and you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230311
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230311,
					"content": "This is Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230312,
					"content": "#I'm {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230313
					]
				},
				{
					"id": 730230313,
					"content": "#So, {NICKNAME} and Paimon, got it. I knew you weren't ordinary when I saw how swift-footed you were while hunting that Shroomboar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230314
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230314,
					"content": "Actually, I'm carrying out research on wild animals, but... *sigh* I can't capture those Shroomboars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230315
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230315,
					"content": "They either run or ram me to the ground as soon as I get close... If this goes on, my waist is going to give way before I even start my research...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230316
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230316,
					"content": "So, when I saw how easily you took down a Shroomboar, I had to try and ask if I could purchase some of its meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230317
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230317,
					"content": "Is there something special about it? It looks just like the meat from any other wild boar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230318,
					"content": "Oh my, of course we have to carry out an investigation to find out the differences! Sell it to me. I'll pay you well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230319
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230319,
					"content": "(Give the Shroomboar meat to him...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230320
					]
				},
				{
					"id": 730230320,
					"content": "Oh, thank you so much! I can carry on with my research now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230321
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230321,
					"content": "Just what kind of research is Shefket carrying out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230322,
					"content": "It's just some ordinary ecological surveys. Sometimes, I capture animals and research their growth...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230323
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230323,
					"content": "Just a single animal can tell me things about the recent growth of its entire colony. It's really quite miraculous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230324
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230324,
					"content": "Paimon can tell how much you love animals, Shefket!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230325,
					"content": "Yes, I... I've always loved them. I've spent so much time studying them. The ecology in the forests of Sumeru is absolutely fascinating...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230326
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230326,
					"content": "Alright, I've got the Shroomboar meat. I need a Dusk Bird next.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230327
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230327,
					"content": "#{NICKNAME}, have you seen a Dusk Bird before? It's a gorgeous bird found in the <color=#00E1FFFF>south of Apam Woods</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230328
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230328,
					"content": "It's a bird unique to Sumeru. Even the Akademiya researchers often use it to send messages... Though it's capable of long distance travel, it hates rain and will hide away on rainy days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230329
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230329,
					"content": "Well, it's time for me to go. A Dusk Bird... I hope I'll be able to capture one on my own... Haha, I can't keep relying on others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230330
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230330,
					"content": "But if you're willing... Ahem... I hope you'll keep an eye out for me. I'm willing to buy the Dusk Birds you capture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230307,
					"content": "Sounds scary.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				}
			]
		},
		{
			"id": 7302308,
			"completionStepIds": [
				7302308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302308",
							"2"
						],
						"stepId": 7302308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Shefket"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230801,
					"content": "Oh, you're that field researcher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230802,
					"content": "What do you mean? Haha, my name is Shefket. We've met before. You even sold some Shroomboar meat to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230803,
						730230805
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230803,
					"content": "Really?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230804
					]
				},
				{
					"id": 730230804,
					"content": "Yup! He paid us much higher than the price of ordinary wild boar meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230807,
					"content": "So, Shefket, what are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230808,
					"content": "Hahaha! It's embarrassing to say, but my research is still ongoing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230809
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230809,
					"content": "I need a Dusk Bird, but I still haven't caught one... My research progress is worrying... And that's not the worst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230810
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230810,
					"content": "That's not the worst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230811,
					"content": "I even encountered the Eremites. They raised their weapons at me on sight...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230812
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230812,
					"content": "Oh, so the Eremites mistook us for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230813,
					"content": "Huh? Did they? Guess that's because... That's definitely because they don't understand that I'm trying to protect the Dusk Birds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230814
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230814,
					"content": "You see, I'm sure the Eremites here think of the Dusk Birds as their own property. That's why they're against me collecting a specimen for research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230815
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230815,
					"content": "After all, the feathers of a Dusk Bird are quite expensive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230816
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230816,
					"content": "Right, do you know that the Dusk Birds grow multicolored feathers as camouflage in the forest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230817
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230817,
					"content": "But in the end, many hunt them for those same gorgeous, multicolored feathers. It's really sad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230818
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230818,
					"content": "Oh no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230819,
					"content": "I don't have the courage to face the Eremites like you... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230820
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230820,
					"content": "Right, can you sell me a feather from the Dusk Bird you hunted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230821
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230821,
					"content": "Just like before, I'll compensate you generously!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230822
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230822,
					"content": "(Give the Dusk Bird feather to him...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230823
					]
				},
				{
					"id": 730230823,
					"content": "Haha, I've got a Dusk Bird feather too... Now, I'm more than halfway done with my investigation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230824
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230824,
					"content": "But this feather...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230825
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230825,
					"content": "What's wrong? Is there something wrong with it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230826,
					"content": "No, there isn't. Its quality just isn't very good... Oh, I mean, I can discern that the Dusk Birds in this area don't seem to be growing very well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230827
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230827,
					"content": "Well, I'll have to go around and gather more feathers. It's the only way I can find out what happened to the entire colony of Dusk Birds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230828
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230828,
					"content": "I heard there's a different colony of Dusk Birds in the <color=#00E1FFFF>north of Apam Woods</color>. It looks like I'll have to look for Dusk Birds there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230829
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230829,
					"content": "#Hmm, time to leave now! May we meet again, {NICKNAME} and Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230805,
					"content": "That did happen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230806
					]
				},
				{
					"id": 730230806,
					"content": "Yes, Paimon remembers now! It's the animal lover, Shefket!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302312,
			"completionStepIds": [
				7302312
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302312",
							"2"
						],
						"stepId": 7302312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orhan",
					"Paimon",
					"Pamuk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231201,
					"content": "Stop it! Stop it! Why are you hunting Dusk Birds here again!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231202
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231202,
					"content": "I get it now! You're the poachers who've been hunting here! And you're poaching my Dusk Birds again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231203
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231203,
					"content": "Hmph! These Dusk Birds don't belong to you! You didn't raise them, did you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231204,
					"content": "I didn't, but... They are my Dusk Birds because I say so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231205
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231205,
					"content": "I'm in charge of protecting them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231206
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231206,
					"content": "You're in charge of protecting them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231207,
					"content": "Yes, I'm Orhan. I'm under orders from the Corps of Thirty to protect the Dusk Bird colony from poachers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231208
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231208,
					"content": "You don't believe me? Take a look at these Orders signed by the Corps of Thirty's Sheriff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231209
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231209,
					"content": "Orhan shows you the Orders. It is signed by the Corps of Thirty.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231210
					]
				},
				{
					"id": 730231210,
					"content": "Huh? But that's not what we heard... Isn't an ecological survey being carried out on Dusk Birds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231211,
					"content": "There's no such thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231212
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231212,
					"content": "...Did Shefket deceive us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231213,
					"content": "Shefket... Shefket again... Oh, Dendro Archon! You've been utterly duped by that guy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231214
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231214,
					"content": "He disguises himself as a Forest Ranger to trick people, but he's actually working with the Treasure Hoarders to sell the precious materials he gathers from rare animals...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231215
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231215,
					"content": "How could that be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231216,
						730231217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231216,
					"content": "I have to admit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				},
				{
					"id": 730231218,
					"content": "You're not the first adventurer to be tricked by him. He's always making adventurers help him and hiding behind them. He's as slippery as an eel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231219
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231219,
					"content": "#What do we do, {NICKNAME}? We've hunted quite a few Dusk Birds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231220,
						730231223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231220,
					"content": "Let's hope they serve balanced meals in prison...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231221
					]
				},
				{
					"id": 730231221,
					"content": "NOOOO! Paimon doesn't want to get locked up by the Corps of Thirty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231222,
					"content": "...It's not that serious. The Dusk Bird colony is quite huge, so Dusk Birds are not that rare. You didn't know what you were doing either, so it's not serious enough to get locked up for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231228,
					"content": "Paimon gets it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231229,
					"content": "But you can't escape being punished for it... I want to say that, but... Ahem, there's an opportunity for you to redeem yourselves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231230
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231230,
					"content": "An opportunity to redeem ourselves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231231,
					"content": "Yes, I don't know why, but Shefket seems to need a large amount of Dusk Bird feathers... We can use that as bait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231232
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231232,
					"content": "For example, we can spread the word that there's a large group of Dusk Birds resting on the mountain at the <color=#00E1FFFF>east of Apam Woods</color>. He'll definitely take the bait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231233
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231233,
					"content": "But he's a cunning guy, so even the slightest action we take will scare him off. That's where both of you come in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231234
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231234,
					"content": "#Hmm... I think I heard the {F#blonde}{M#blond} one's name is {NICKNAME}. What about the flying one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231235
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231235,
					"content": "This is Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231236,
					"content": "#Oh, {NICKNAME} and Paimon. I need you to make contact with Shefket.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231237
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231237,
					"content": "Paimon gets it. He'll let his guard down with us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231238,
					"content": "Exactly. We'll set up an ambush, so it'll be up to you to keep him busy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231239
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231239,
					"content": "Once you meet him... Alright, just shout \"We know everything you've done!\" as the signal, and we'll get him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231240
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231240,
					"content": "What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231241
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231241,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231242
					]
				},
				{
					"id": 730231242,
					"content": "Let's do it! Let's spread the news right now. Leave Sumeru City to me. Ferit, you take Gandharva Ville, and use this opportunity to find out if anyone's colluding with the Treasure Hoarders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231243
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231243,
					"content": "Pamuk, around Vimara Village...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231244
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231244,
					"content": "Got it, Boss! Don't worry, I'll spread the fake information!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231245
					],
					"speakerTitle": "Pamuk"
				},
				{
					"id": 730231245,
					"content": "Alright, we're gonna get that poacher this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231246
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231246,
					"content": "#I'll leave the rest to you, {NICKNAME}. We must draw him out of hiding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231223,
					"content": "Is it too late for us to flee from Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231224
					]
				},
				{
					"id": 730231224,
					"content": "It can't be helped. We'll have to return another time for the parts of Sumeru we haven't explored yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231225,
					"content": "I can't just watch as you flee right in front of me, and the Corps of Thirty has surrounded the area to combat the recent rise in poaching!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231226
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231226,
					"content": "Nooo, I don't want to get locked up by the Corps of Thirty!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231227
					]
				},
				{
					"id": 730231227,
					"content": "...Calm down. The Dusk Bird colony is quite huge, so Dusk Birds are not that rare. You didn't know what you were doing either, so it's not serious enough to get locked up for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231217,
					"content": "Shefket tricked us...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				}
			]
		},
		{
			"id": 7302314,
			"completionStepIds": [
				7302314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302314",
							"2"
						],
						"stepId": 7302314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shefket",
					"Paimon",
					"Orhan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231401,
					"content": "#Oh? If it isn't {NICKNAME} and Paimon! I'm sure you're here because you've heard about the Dusk Bird colony resting here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231402
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231402,
					"content": "This isn't an environment the Dusk Birds usually favor, so why would they come here? Perhaps it's something worth studying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231403
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231403,
					"content": "Shefket...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231404,
					"content": "Haha, what is it? Oh, I'm sure you want to know if I'm still buying Dusk Bird feathers, right? Of course I am, their feathers are very precious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231405
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231405,
					"content": "\"We know everything you've done!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231406
					]
				},
				{
					"id": 730231406,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231407
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231407,
					"content": "Why did you say that? Do you suddenly feel proud of me for conducting such a hard research?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231408
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231408,
					"content": "#(Huh? What's going on? Why haven't the Eremites come? We had an agreement with Orhan... {NICKNAME}, maybe Paimon should give it a try.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231409,
					"content": "\"We know everything you've done!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231410,
					"content": "Paimon too? Oh my, it's alright. It's my duty, and you've helped me so much already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231411
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231411,
					"content": "The process may be difficult, but it's all for a cause. It's for the animals of the forest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231412
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231412,
					"content": "It isn't for the animals! It's all for yourself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231413,
					"content": "We know everything you've done!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231414
					]
				},
				{
					"id": 730231414,
					"content": "Orhan rushes out of the forest just as you finish speaking...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231415
					]
				},
				{
					"id": 730231415,
					"content": "Yes, Shefket, the Corps of Thirty is officially placing you under arrest for the crimes of impersonating a Forest Ranger, instigating unknowing adventurers to carry out poaching, and colluding with Treasure Hoarders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231416
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231416,
					"content": "Hey, Orhan, what took you so long? We almost lost our voices shouting the signal just now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231417,
					"content": "Uh... We had a little accident...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231418
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231418,
					"content": "What's the Corps of Thirty doing here? What signal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231419
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231419,
					"content": "\"We know everything you've done!\" So that's what you meant. I even felt a little touched just now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231420
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231420,
					"content": "Liar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231421,
					"content": "Just surrender!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231422
					]
				},
				{
					"id": 730231422,
					"content": "Ugh, I should have known you were with the Corps of Thirty... Hmph! The news about a Dusk Bird colony here was your doing too, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231423
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231423,
					"content": "Exactly. You've fallen into a trap, Shefket. I bet a veteran con man like you never expected to get conned yourself! The Corps of Thirty will treat you really, really well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231424
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231424,
					"content": "*sigh* I guess there's no point trying to deny it. I'm very fond of the animals in Sumeru, but sometimes, just fondness is useless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231425
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231425,
					"content": "I couldn't get into the Akademiya. All I could do was some meaningless surveys. In the end, others only thought of me as a weirdo wandering the forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231426
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231426,
					"content": "I need Mora... Not just for my research, but so that I can shut the mouths of those people who talk behind my back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231427
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231427,
					"content": "So you started targeting the animals you knew best? Hmph! You caused greater losses just because you understand them! Isn't that something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231428
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231428,
					"content": "I had no other choice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231429
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231429,
					"content": "Stop trying to talk your way out of it! I will never believe your lies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231430
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231430,
					"content": "The liar has finally been apprehended.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231431,
					"content": "So, Orhan, what took you so long?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231432,
					"content": "Oh, that... Ferit and Pamuk never returned, and I couldn't find them. After much consideration, I decided to come here myself. Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231433
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231433,
					"content": "Didn't I make it just in time? My timing was perfect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231434,
						730231435
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231434,
					"content": "That sounds questionable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231436
					]
				},
				{
					"id": 730231436,
					"content": "Hmph! What? I expected many of the Corps of Thirty to be lying in ambush here. But it's just one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231437
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231437,
					"content": "I planned to feign capture and look for an opportunity to escape, but hah! It doesn't look necessary at all now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231438
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231438,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231439,
					"content": "Don't tell me you think just the two of you and... a lousy guard from the Corps of Thirty can capture me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231440
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231440,
					"content": "Today's your unlucky day because it just happens to be the day I promised to deliver the goods to the Treasure Hoarders, so they're lying in ambush just over there. You're not the only one who can call for reinforcements!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231441
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231441,
					"content": "Hurry! Get rid of them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231435,
					"content": "Just a little later and it wouldn't have made a difference...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231436
					]
				}
			]
		},
		{
			"id": 7302316,
			"completionStepIds": [
				7302316
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302316",
							"2"
						],
						"stepId": 7302316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ferit",
					"Pamuk",
					"Paimon",
					"Orhan",
					"Shefket"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231601,
					"content": "You make short work of the Treasure Hoarders.\\nFerit and Pamuk arrive too...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231602
					]
				},
				{
					"id": 730231602,
					"content": "Boss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231603
					],
					"speakerTitle": "Ferit"
				},
				{
					"id": 730231603,
					"content": "Sorry we're a little late...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231604
					],
					"speakerTitle": "Pamuk"
				},
				{
					"id": 730231604,
					"content": "A little late? Everything's over...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231605,
					"content": "Oopsy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231606
					],
					"speakerTitle": "Ferit"
				},
				{
					"id": 730231606,
					"content": "Where on earth did you two go!? I couldn't even find you... Whoa! You reek of alcohol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231607
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231607,
					"content": "Hehe... But the best way to spread information has always been pretending to be drunk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231608
					],
					"speakerTitle": "Ferit"
				},
				{
					"id": 730231608,
					"content": "And then divulging the false information.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231609
					],
					"speakerTitle": "Pamuk"
				},
				{
					"id": 730231609,
					"content": "You're 100 percent drunk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231610
					]
				},
				{
					"id": 730231610,
					"content": "#*sigh* If it wasn't for {NICKNAME}, I would have gotten a good beating from the Treasure Hoarders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231611
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231611,
					"content": "#I must admit, I wasn't expecting {NICKNAME} to take the Treasure Hoarders down so easily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231612
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231612,
					"content": "#Of course! {NICKNAME} is stronger than {M#he}{F#she} looks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231613,
					"content": "No wonder. I mean, I got taken out with great ease when I tried to stop you earlier, but this... exceeded my expectations a little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231614,
						730231615
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231614,
					"content": "You're too kind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				},
				{
					"id": 730231616,
					"content": "#Alright, Shefket. We... I mean {NICKNAME} has taken down the Treasure Hoarders you were relying on. Now, do you have anything else to say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231617
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231617,
					"content": "I—I... Actually, the mental trauma I experienced as a child is the cause of all this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231618
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231618,
					"content": "Let me explain... It happened when I was just a young boy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231619,
						730231620
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231619,
					"content": "Nobody cares!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231621,
					"content": "Alright, you've caught this guy and atoned for your crimes. Next time, choose wisely when you decide to believe someone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231622
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231622,
					"content": "If only you listened to me from the very beginning...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231623
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231623,
					"content": "Hey! You attacked us without saying a word!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231624,
					"content": "I admit... I do that when I get anxious. I guess I should try to be calmer next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231625
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231625,
					"content": "But I hope there isn't a next time. Be careful, and don't just believe anyone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231626
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231626,
					"content": "Got it, got it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231627
					]
				},
				{
					"id": 730231627,
					"content": "Paimon'll bear that in mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231628,
					"content": "Orhan leaves with Shefket in his custody...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730231620,
					"content": "Stop making up stories!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231615,
					"content": "It's going to get to my head if you don't stop!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				}
			]
		},
