			"dialogs": [
				{
					"id": 747030101,
					"content": "Hold up... these accounts... are you sure you haven't miscalculated?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030102,
					"content": "Hmm? Is something wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030103,
					"content": "...Have you really made this much profit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030104,
					"content": "Having second thoughts about your 30% cut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "Do you really think I'm that petty? I'm just amazed you've done such a good job running the aquarium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030106,
					"content": "Paimon thinks the Fontinalia Film Festival deserves some of the credit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030107,
					"content": "This much revenue... Even after paying off the Wingalet's rent, there's still a sizable profit left over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030108,
					"content": "Considering a career change?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Not in the least. I have no delusions regarding my business acumen. Constructing machines and studying formulas is where my passions lie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030110,
					"content": "That said... Seeing this place transform from a fishless room into what it is now really has felt like a miracle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030111,
					"content": "Hehe, well, we owe you credit for lending us the space! It's so rewarding to see all our work bring so many people joy! Don't you think, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030112,
					"content": "Hmph. Maybe a little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030113,
					"content": "Only a little?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030114,
					"content": "Must be because she settled for 30%...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "Ugh, I told you, I don't care about that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
