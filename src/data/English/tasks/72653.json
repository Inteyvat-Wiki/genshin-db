			"dialogs": [
				{
					"id": 726530101,
					"content": "Traveler, you've returned!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530102,
					"content": "I had a look at the crystals you brought back earlier. They seem rather... \"young.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530103,
					"content": "By that, I mean that they come from rather recent elemental crystallizations... To strike a comparison, this is but a slightly deeper footprint recently left in the snow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530104,
					"content": "So this time, I'd like you to look for footprints that are more \"shallow\"... and follow them to their source!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530105,
					"content": "When I say \"shallow footprints,\" I mean deposits of Electro elements that have condensed to a certain extent near the ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530106,
					"content": "If we are able to obtain sufficient samples of that for comparison, we should be able to draw a general route map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530107,
					"content": "Shallow and deep footprints... route maps... Paimon's got no idea what you're on about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726530108,
					"content": "It is rather complicated...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "Well, maybe my analogy wasn't the best, but I think you'll figure it out just fine once you're there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530110,
					"content": "Well, guess that's all for the chit-chat. Time to get moving!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				}
			]
		}
	]
