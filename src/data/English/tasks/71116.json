			"dialogs": [
				{
					"id": 711160401,
					"content": "We've been pals, Johnnie, so I get the pickle you've found yourself in lately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160402,
					"content": "You could've just talked to me straight, but causing a mess like this... It's enough to break my heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160403,
					"content": "Well, pal, you know business as usual is no longer the usual over here. The Spina di Rosula's on the rise, and my brothers are a bit out of sorts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160404,
					"content": "But I still got to look after all the birds in my crew. If this keeps up, they won't even get crumbs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160405,
					"content": "We got good business going between us, it's pretty reasonable, but if you can give us more... I'm sure we all know I'll scratch your back in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160406,
					"content": "If not... Haha, there are plenty of other fish in the sea, Iron Ming, it's not like you can't find new friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160407,
					"content": "So I take it that means this is your final offer, right, Johnnie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160408,
					"content": "You got a problem with what I'm offering?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160409,
					"content": "You kidding me, Mr. Fontainer? Just tell us what you're up to! Who are you trying to steal from with this little money? Stop shouting nonsense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160410,
					"content": "Shut it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160411,
					"content": "Listen, Johnnie, the Don Pesci family pays me 58 thou a box, and the De Niro 70 thou. I shouldn't have to tell you just how big they are in Lumidouce Harbor, yeah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160412,
					"content": "But for you, I only asked for a hundred grand for three boxes, and even threw in special pick-up and delivery service on top... Now why do I do that? Because I cherish you as a friend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160413,
					"content": "No need for me to harp on all that... I'm sure you just didn't think it through! Let's find a place to drink while we talk, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160414,
					"content": "Hehe, I don't need all that. I know how you Liyue people get about contracts. Since the point of contracts is fairness, I don't think friendship supersedes that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160415,
					"content": "Hehe, Brother Johnnie! Someone who understands the spirit of contracts so well... My men ought to learn from you, ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160416,
					"content": "It's just that... at least on this matter, I'd like to see you guys respect the contract more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160417,
					"content": "Of course, of course! You're being more than reasonable, and the ancient Liyue tradition of upholding contracts is something we can all admire. I suppose I must find a way to prove my sincerity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160418,
					"content": "Walker, you think we can raise our offer... say, one Mora per item?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160419,
					"content": "That's very generous, Mr. Johnnie. These good people of Liyue have worked so hard for us, so we do owe them one extra Mora per item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160420,
					"content": "Fontainian frogs! Just what are you trying to pull here!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160421,
					"content": "Come on, old pal, can't you just feel my sincerity radiating off of me from where you're standing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160422,
					"content": "I take it you're gonna breach our agreement, then, Johnnie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160423,
					"content": "Oh? Am I? What do you think, Walker?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160424,
					"content": "Mr. Johnnie, there's plenty of other fish in the sea, if you ask me. Any minnow should know that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160425,
					"content": "I'm ashamed of you, Walker. How could you insult our Liyue friend like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160426,
					"content": "I mean, we're going to take over their turf soon anyway, shouldn't we show a bit of gratitude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160427,
					"content": "Sorry, Mr. Johnnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160428,
					"content": "You slippery bastards! The audacity to plan something like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160429,
					"content": "Whoa, calm down with the insults! No need to be rude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "Hey, who are the two youngsters...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160431,
					"content": "Well, now this is interesting. Are all Liyue little children brave like them? Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160432,
					"content": "Hey, where did you snotty kids come from? Here's some Mora. Now scram, run on back to your mommies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160433,
					"content": "Hey! Don't any of you have any manners?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160434,
					"content": "And who are you two...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160435,
					"content": "We're here for a super swanky meal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "Hahaha! From the sound of it... Looks like you're Mr. Iron Ming's rusted little help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160438,
					"content": "So, you had the same idea too, eh, Mr. Iron Ming? Well, we didn't exactly come unprepared. Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160439,
					"content": "Come out, boys, it's time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160440,
					"content": "What!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160441,
					"content": "Oh dearie me, guess what? I think we have more people on our side.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160442,
					"content": "I am so, so sorry, Mr. Iron Ming. Before our little meeting, I made prior arrangements to have the people guarding your camp taken care of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160443,
					"content": "Now it's your turn. I'll make sure your business is in good hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160444,
					"content": "\"Boss\" Johnnie... If you wanna get a slant at our business, it won't be duck soup!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160445,
					"content": "Well, I hope you can back up your tough talk. Get him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160436,
					"content": "We're here to make certain somebodies run on back to their mommies.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
