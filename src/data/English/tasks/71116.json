			"dialogs": [
				{
					"id": 711160601,
					"content": "Two incredible heroes! I am in your debt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160602,
					"content": "It's quite alright! No matter where you make a deal, you should always honor your contract!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "#Hehe, this little {M#hero}{F#heroine}'s got the picture! Still, you two seem wise to our deal. Why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160604,
					"content": "Iron Dou'er told us about it. She said you were bootlegging or somesuch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "But what does \"bootleg\" mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "Some sort of illegal transaction.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "In that case, I must repay you two chivalrous heroes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160608,
					"content": "Boys! Come truss them up nice and tight and toss them into the sea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160609,
					"content": "Be sure to tie a few extra rocks to them, too. They did us Iron and Salt Gang a big favor, so let's not make them suffer more than they should!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160610,
					"content": "What!? You... You want to do WHAT to us!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "My dear little hero, from what you just said, I would've thought you'd understand. Liyue is indeed a place very particular about contracts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160612,
					"content": "And walking in on a transaction between outlaws means you get silenced. Surely that is an unspoken contract known to all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160613,
					"content": "There's no such thing as that contract! Repaying our kindness with murder is the real breach of contract here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "Please don't make this harder on yourselves. If I have to do it myself, you'll be in for a world of hurt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160615,
					"content": "Do you know who I am?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "Shut up! Iron Dou'er, Iron Chuan'er, just what are you waiting for? Get them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160618,
					"content": "Boss Iron Ming... You really are heartless. Unjust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Iron Chuan'er"
				},
				{
					"id": 711160619,
					"content": "As long as we can stop villains like you from befouling Liyue with your criminal conduct, all of our efforts will have been worth it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160626,
					"content": "Round 'em up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160620,
					"content": "Wh—What...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160621,
					"content": "Iron Ming, you lowly scum! Open your eyes and take a good look at us! Who are we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160622,
					"content": "M—Millelith!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160623,
					"content": "Whoa, whoa, slow down a sec! What's going on? Why the sudden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "I thought you were just newbies, I never imagined you were a bunch of cursed sleuths...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160625,
					"content": "Don't count on me going quietly! Bring it on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Ming"
				},
				{
					"id": 711160616,
					"content": "Oh no, I'm shaking in my boots!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
