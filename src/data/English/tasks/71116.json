			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iron Dou'er"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2083.502,
							359.483,
							2715.594
						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "We drink out of the same bottle, yeah? We don't say \"thanks\" for such big favors, you're ever in a jam, you just holler and it'll be done in a flash!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160203,
					"content": "Wow, you're pretty polite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "I'll get to the point then. I've been a little tight on money lately.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "You need Mora? Haha, well, funny thing is, there could be a little problem with that—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160206,
					"content": "Our Mora? The big cheese took it all. We been down on our uppers, flat broke here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160210,
					"content": "Big Cheese?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Our Boss, the leader of us Iron and Salt Gang. He's with a bunch of Fontainian cats down at the bottom of the cliff over there, left us behind to hold down the fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160212,
					"content": "But you saw what happened too, right? Those Fontainian frogs snuck in while the big shot was away and stabbed us in the butt, really put the screws to us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160213,
					"content": "Eek... Stabbed you in the butt...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Yikes...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Brat! Really trying to take us for a ride?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160216,
					"content": "Since they tipped their mitts and showed their mugs here, our Boss is probably gonna get double-crossed too. Whaddaya say, bo? In for a Mora, in for the lot, you wouldn't back out now, would ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160217,
					"content": "As long as Boss is safe, you're guaranteed the swankiest of meals, and can live the good life!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160218,
					"content": "Where is he? I'll go check it out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "On that beach beneath the cliff. You'll see when you get there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160220,
					"content": "I'll leave you to it, and be on over after I finish here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160207,
					"content": "Just doing my part to uphold justice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "Supremely honorable! Righteous beyond measure! In that case, I got something juicy to tell both of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Iron Dou'er"
				},
				{
					"id": 711160209,
					"content": "Our big cheese... He's probably in a jam himself, probably needs some help, yeah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Iron Dou'er"
				}
			]
		},
