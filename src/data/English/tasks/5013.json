			"dialogs": [
				{
					"id": 50130801,
					"content": "The Children of Echoes' territory is secure. All monsters down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130802,
					"content": "I'll go deal with the Abyss Tumor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50130803,
					"content": "All good here at the People of the Springs, too. We crushed it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130804,
					"content": "Masters of the Night-Wind are also safe. Should I go support the Flower-Feather Clan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50130805,
					"content": "Things are still pretty rough over there. I'm already en route.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50130806,
					"content": "No need. I just dealt with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130807,
					"content": "Already!? But you were just at the Stadium!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130808,
					"content": "Yeah, well. You have no idea how long I've been itching to bash some heads in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 50130809,
					"content": "Oh... Fair enough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130810,
					"content": "Iansan, what should we do about the Collective of Plenty? Your home's a long ways away from the stadium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130811,
					"content": "Oh, no need to worry. I just heard from Varesa, she says they're safe now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50130812,
					"content": "Sounds like all regions are secured. The Abyss forces are weakening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130813,
					"content": "Yeah! Their only game-plan was to outnumber us, and that ain't gonna work now that we have the Ode of Resurrection on our side!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50130814,
					"content": "Hold up... The Abyss is sending a sizeable unit towards the Stadium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130815,
					"content": "I guess they've realized that the Ode of Resurrection is a game changer, so now, they are going to try to destroy the sacred flame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50130816,
					"content": "We ain't gonna let them get away with that. Friends, let's gather at the stadium!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50130817,
					"content": "More Abyss Tumors have descended, all near the Stadium. Let's split up and take them out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130818,
					"content": "Oh, and we need someone to guard the main entrance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 50130819,
					"content": "Allow me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "Alright. This is the final battle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		}
	]
}