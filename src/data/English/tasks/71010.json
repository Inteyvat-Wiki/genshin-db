						"rawParams": [
							"7101001",
							"2"
						],
						"stepId": 7101001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "My fellow disciple and I trained in the martial arts from childhood. Our quest was to fight the forces of evil and protect all that is sacred in this world. But this was no easy task without the aid of a Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Ruins Treasure"
				},
				{
					"id": 710100102,
					"content": "We two sought refuge here to train ourselves further and to seek the Visions that we desired. We erected this monument in testament to our endeavors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Ruins Treasure"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101006",
							"3"
						],
						"stepId": 7101006,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "But now that my fellow disciple has obtained his Vision, instead of battling against monsters, he asked me, \"Are monsters truly evil by nature?\" So I replied to him, \"They wreak havoc all across the world, and innocent people are the ones who must suffer the consequences. Is that so insufficiently evil that you should stay your blade?\" I do believe an excess of meditation has fried his brain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Ruins Treasure"
				},
				{
					"id": 710100202,
					"content": "Well, I still intend to take on these monsters — even if it means doing so without him, and even if it means doing without a Vision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Ruins Treasure"
				}
			]
		},
		{
			"id": 7101003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101007",
							"3"
						],
						"stepId": 7101007,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100301,
					"content": "Monsters are the bane of all that is worth living for in this world. Those of us who are skilled with the blade are duty-bound to hunt them out of existence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Ruins Treasure"
				},
				{
					"id": 710100302,
					"content": "Monsters are evil! They deserve nothing more than the merciless slaughter they will get!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100303
					],
					"speakerTitle": "Ruins Treasure"
				}
			]
		},
