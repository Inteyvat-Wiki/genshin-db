	"talks": [
		{
			"id": 2003301,
			"completionStepIds": [
				2003301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003301",
							"2"
						],
						"stepId": 2003301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "Traveler, come have a look! What do you think? Does this look good on me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330102,
					"content": "Oh, this uniform...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "That's right! I passed the Adventurers' Guild exam. That makes me an officially-recognized adventurer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330104,
					"content": "You look awesome!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "Hehe, thanks. I tried to persuade my brother to give the exam a go too, but he refused no matter what I said...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330107,
					"content": "I've got no interest in adventures... And anyway, who'll take care of our parents if we both become adventurers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330108,
					"content": "Well, then we can bring them along! We can travel the whole world together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330109,
					"content": "You... Alright, alright. You're an adventurer now, so do your best. Leave matters at home to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330110,
					"content": "But remember, don't get yourself injured, and don't overtax yourself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330111,
					"content": "Oh, fine, fine, I get it! Heading out now, I've got a commission to finish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330112,
					"content": "Traveler, do you mind coming with me? I've got so many things I want to ask you about being an adventurer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330113,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "Now let me see. This commission is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330116,
					"content": "Transport Balloon Escort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330114,
					"content": "Okay. Let's go!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "Congratulations!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
		{
			"id": 2003302,
			"completionStepIds": [
				2003304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003303",
							"3"
						],
						"stepId": 2003303,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003304",
							"2"
						],
						"stepId": 2003304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330201,
					"content": "And we're done! Thanks, Traveler. This went pretty well, I think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330202,
					"content": "But is this the usual fare for adventurers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330203,
						200330205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330203,
					"content": "There will be others.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330204
					]
				},
				{
					"id": 200330204,
					"content": "What's with that hapless tone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200330207,
					"content": "Is that so... Nice! I'll keep working at it, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330208,
					"content": "Once I've saved up enough Mora, I'll bring my brother and our parents out on a trip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330209,
					"content": "My brother always wanted to travel... But I fell ill, and he had to stay back to take care of me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330210,
					"content": "But I'm well now, and I've even become an adventurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330211,
					"content": "Hehe. When the time comes, I'll help my brother fulfill some of his dreams too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330205,
					"content": "You'll understand in time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330206
					]
				},
				{
					"id": 200330206,
					"content": "Hey, not that tired look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003301",
							"3"
						],
						"stepId": 2003301,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330301,
					"content": "Please take care of Anna, Traveler. Her excitement might have gotten to her head lately...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330302,
					"content": "Do you not want her to become an adventurer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330303
					]
				},
				{
					"id": 200330303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330304,
					"content": "I respect my sister's wishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330305,
					"content": "Now that she's well again after such a long struggle with her illness, she deserves a chance to pursue her dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330306,
					"content": "As her brother, I'll support her... all the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330307,
					"content": "That's all I have to say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
}