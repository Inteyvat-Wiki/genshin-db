			"dialogs": [
				{
					"id": 751500901,
					"content": "Greetings. New data recovery category detected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500902,
					"content": "...Entries concerning Source Mechanism energy cores have been updated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500903,
					"content": "Phlogiston is the main form of energy that powers Source Mechanisms, albeit in a condensed form that closely resembles light.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500904,
					"content": "Stable amounts of Phlogiston Units may be generated via the controlled reaction known as [DATA LOST] allowing for more precise control over energy release.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500905,
					"content": "The energy that a Source Mechanism requires is dependent on both size and the complexity of its operating logic. The quantity of Phlogiston Units a Secret Source Servant requires is [DATA LOST]...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500906,
					"content": "While the larger Secret Source Dragon Idols, in fact, require less — specifically, three in number.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500907,
					"content": "\"Information is energy, and energy is information.\" The data carrier you retrieved counts as a single Phlogiston Unit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500908,
					"content": "So one \"Phlogiston Unit\" is one fireball...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "Yes, that is one way to look at it. You restored a Phlogiston Unit that had been corrupted by the Abyss. Only then could I extract anything from it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500910,
					"content": "They can also be used as substitute energy sources for Abyss-corroded Source Mechanisms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Secret Source Servant"
				}
			]
		},
