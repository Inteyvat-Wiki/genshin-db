			"dialogs": [
				{
					"id": 751500401,
					"content": "How do we enter the Heart of the Sacred Mountain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "The entrance to the Heart is close by. When recreating Tollan's city center, Lord Xiuhcoatl excavated downward in order to create a stable experimental environment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500403,
					"content": "And there, he built the ultimate weapon for use against the Abyss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500404,
					"content": "However, the seal has caused this device to suffer from the deepest Abyss corrosion. Thus was the city taken over...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751500405,
					"content": "The entrance to the Sacred Mountain's heart lies beneath the fissures in the Sacred City... That is also where our shadowy foe's corruption runs the deepest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Secret Source Servant"
				}
			]
		},
