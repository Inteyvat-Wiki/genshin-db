					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501503,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501504
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501504,
					"content": "Hehe, fancy meeting you again so soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501505,
					"content": "...Apologies, but there are no entries regarding you logged in my database.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501506
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501506,
					"content": "Humans this far down... This has not happened in at least 500 years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501507
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501507,
					"content": "Wait, you're not Amaru... or Ehecatl, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501508,
					"content": "...There were indeed individuals referred to as such, but I am neither of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501509
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501509,
					"content": "I believe there must be some misunderstanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501510
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501510,
					"content": "I am a prototype created to assist Lord Xiuhcoatl with information recording, so I have no name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501511
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501511,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "Wait... No... Not that I have no name, I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501513,
					"content": "I am the only intelligent Secret Source Servant without a master. Even after Lord Xiuhcoatl fell, I was still in charge of the most basic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501514,
					"content": "The most basic city maintenance and information recording functions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501515,
					"content": "However, some records have been lost due to the invasion of our shadowy foe, so I do not have data regarding my name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501516,
					"content": "Yeah, seems like we've got the wrong guy... Err, dragon-robot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501517,
					"content": "It is fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501518,
					"content": "Hmm. This robot is huge, but it doesn't seem too bright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501519,
					"content": "#This probably isn't that guy who uses machines to talk to us, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501520,
					"content": "But it did say that it is in charge of record-keeping and stuff, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501521,
					"content": "Why don't we ask it what it knows, then? Or... You know, about how we can reach the Heart of the Sacred Mountain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501522,
						751501523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501522,
					"content": "Maybe that's what \"that guy\" intended...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				},
				{
					"id": 751501524,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
