						751501304
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501304,
					"content": "Moreover, any who wish to gain access to the Heart must also obtain a \"permit\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501305,
					"content": "Only then can you gain the acknowledgement of the Secret Source Dragon Idol that stands guard... Heart of the Sacred Mountain, also known as Huitzilopochtli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501306,
					"content": "Where can we get this permit...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "According to the agreement and the edict issued by Lord Xiuhcoatl, entry to... The Heart of the Sacred Mountain, also known as \"Huitzilopochtli\"... the descendants of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501308,
					"content": "Proceed unto the Chamber of Deliberation to submit an application, and then wait for the permit to be issued.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501309,
					"content": "What about the energy source required by Secret Source Dragon Idols?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "Now, searching... No corresponding data entry categories... Or perhaps the relevant data, like so much else, has become lost due to the Abyssal corruption of the city...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501311,
					"content": "If you can eliminate the Abyss's influence and retrieve the data, perhaps you might find the entries you seek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501312,
					"content": "I have marked out a potential data storage location for you. Please eliminate the Abyssal corruption present there to restore the area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501313,
					"content": "Do you have any queries?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751501314,
					"content": "I have no more questions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501315
					]
				},
				{
					"id": 751501315,
					"content": "Understood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Secret Source Servant"
				}
			]
