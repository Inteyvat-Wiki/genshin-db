							452.578,
							52.995,
							6035.06
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "Whew, this brings back memories of summertime. It's actually kinda refreshing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040202,
					"content": "So, this is the gate to the ancient kingdom of Khaenri'ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040203,
					"content": "I'm sure a lot of secrets and tragedies lie behind it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040204,
					"content": "Well, let's open the second letter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040205,
					"content": "Let me see here... Yep. It's this one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040206,
					"content": "\"As the ancient Sumeru saying goes: Rote knowledge bears no fruit, until it is watered with the showers of wisdom. With that in mind, there is a phenomenon in this land known as the 'Sign of Apaosha.'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040207,
					"content": "\"It is a celestial mark that burns in response to an all-too-ardent desire for the truth. In that sense, perhaps it's more fitting to call it a 'Sign of Truth' instead...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040208,
					"content": "The records of this ancient kingdom state there are several large subterranean lakes in Khaenri'ah, clear and calm as mirrors, whose surfaces reflect the true stars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040209,
					"content": "\"This is because the 'Sign of Truth' created in the water is able to bypass the false sky and connect to the outer universe.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040210,
					"content": "I had no idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040211,
					"content": "\"To observe the gravitational forces and influence of celestial bodies, one must be able to see past the false sky. Only by obtaining these cosmic parameters can one predict the fate of this world.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040212,
					"content": "\"Now, my task for you is as follows: Open a 'Sign of Truth' in front of the gate to Khaenri'ah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040213,
					"content": "The rest is a bunch of stuff about the ceremony the old hag came up with to summon this thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040214,
					"content": "Yeah, all these planetary trajectories and... runes... Paimon's not even gonna try to make sense of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040215,
					"content": "So, what do you say, Mona? Are you gonna attempt it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040216,
					"content": "Well, I hate to admit it, but it looks like the parameters she came up with could work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040217,
					"content": "Frankly, this prospect is quite exciting — and heading back now will just cost me another night of lodging. So... no better time than the present!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040218,
					"content": "Emissaries of the enduring stars, wanderers over ecliptic and equatorial planes, radiant celestial brethren...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040219,
					"content": "Traverse the twisted paths of the cavernous void. I, Mona Megistus, the Astrologist, invoke the power of Hydro to balance the scales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040220,
					"content": "By wisdom and truth, let the thirst be relieved. I, Mona Megistus, the Astrologist, summon you, O stars, to stand before me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040221,
					"content": "D—Did it work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040222,
					"content": "Aaah! Monsters? How did that happen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040223,
					"content": "No dice. The Sign of Truth only opened long enough for the monsters to slip through.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040224,
					"content": "Darn it! I didn't get a glimpse of the real stars at all. Whatever... I'll just take it out on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1000406,
