			"dialogs": [
				{
					"id": 100040101,
					"content": "Mona! We have something for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040102,
					"content": "#Oh, {NICKNAME}, Paimon! You're full of energy today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040103,
					"content": "You have something for me, you said? Is it... some quick and easy way to make Mora, by any chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040104,
					"content": "Well, actually, it's some kind of \"task\" from your master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040105,
					"content": "Yeah, that's a hard no! Ugh, but I guess I don't have a choice, huh... An enterprising spirit is important, and all that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040106,
					"content": "I just know it's going to be torture, though. I know that old hag all too well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040107,
					"content": "Why don't you just take a look first?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040108,
					"content": "Huh, this book... doesn't seem so special to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040109,
					"content": "Whoa! Letters just fell out of it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040110,
					"content": "Oh! Maybe she's trying to... reconcile with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040111,
					"content": "No idea. Either way, it looks like I'm supposed to open these three letters in order. Well, let's start with the first one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040112,
					"content": "If this is her \"task,\" it should be okay for us all to read. C'mon, let's see what this is about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040113,
					"content": "\"Oh, how long it's been, my student. I'm afraid to report that getting up and about is becoming harder and harder these days...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040114,
					"content": "Heh, the sympathy card. She could've tried to make it sound a bit more genuine, at least...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040115,
					"content": "\"Remember when I would chase you, and you would run for dear life, trying to use that Hydro phantom of yours to distract me? Ah, seems like it was just yesterday...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040116,
					"content": "\"Now, you're off on your own, and I laze the days away in my rocking chair. I really should get some exercise again...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040117,
					"content": "Well, then get it some other way, you old hag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040118,
					"content": "Um, on second thought, this seems kinda private...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100040119
					]
				},
				{
					"id": 100040119,
					"content": "\"Now, I'm sure you're curious as to the purpose of this letter. And to that, I say this... If you want to learn how to predict the fate of an entire kingdom, or even the entire world...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040120,
					"content": "\"Head to Sumeru and search for the gate to an underground kingdom. Once there, open the second letter.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040121
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040121,
					"content": "Huh, but she knows how to lure people in, that's for sure. Is she serious about passing on her secret technique?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040122,
					"content": "Guess she really is getting old.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040123,
					"content": "You two have such a weird dynamic. When you talk about sentimental stuff... you fight. But when it comes to dry, academic stuff, you get all emotional...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040124,
					"content": "Anyway, this \"gate to an underground\" kingdom sounds familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040125,
					"content": "Wait, you've heard of it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040126,
					"content": "Yeah. It should be the same one we're thinking of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040127,
					"content": "Perfect! I don't even need to investigate, then! That means no hired guide, no lodging, no shelling out Mora left and right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040128,
					"content": "C'mon, there's no time to waste. Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040129,
					"content": "And since you didn't mention a transportation fee just now, Paimon's guessing that means...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040130,
					"content": "Yep! Same method as usual! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
