			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "Sorry... I'm still not very good at controlling my emotions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552602,
					"content": "Don't apologize.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "Yeah... We know you're going through a tough time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730552604,
					"content": "Thank you... May your travels be smooth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552605,
					"content": "Oh, Paimon hopes that everything will go well for you too... Paimon's sure it will!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305527,
			"completionStepIds": [],
