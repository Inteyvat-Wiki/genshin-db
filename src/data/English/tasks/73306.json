			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bonifaz",
					"Nachtigal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "Where are Omid and Mirsad? Are they...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Don't worry. They're both fine. It's just that... they have other plans so they won't continue working with us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "Huh? What do we do? We can't handle all the work with only the two of us. We've gotta hire more people! But who'd want to come to Aaru Village...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Forget it, let's discuss this later. Anyway, Cyrus got back safely. That's at least something to be happy about, right? I'm never letting it go to such a dangerous place again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "What are you talking about? We're Sumpter Beast merchants. What are we going to eat if our Sumpter Beasts don't work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "You can't simply fill your belly with wind. Even if you could, open your mouth here, and I guarantee that you'll get a mouthful of sand instead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "But we can't let Cyrus take risks. You look pretty strong to me, so why don't you carry our goods instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552708,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nachtigal"
				}
			]
		}
	]
