			},
			"dialogs": [
				{
					"id": 240070201,
					"content": "There's just some rotten cardboard here... and no components.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070202
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070202,
					"content": "That's weird. I fished a few gears out of the water here just yesterday.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400703,
			"completionStepIds": [
				2400703
