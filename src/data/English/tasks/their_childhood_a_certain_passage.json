			},
			"dialogs": [
				{
					"id": 240070401,
					"content": "These are... tattered clothes? Their colors have run completely...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070402,
					"content": "Has someone fished around this area already? There are no components here at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
