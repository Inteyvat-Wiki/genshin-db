			"trigger": {
				"objectNames": [
					"Verut",
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240070101,
					"content": "Lovi, did you find something good?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070102,
					"content": "Nope, there's nothing here at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070103,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "We're looking for treasure! Hehe... Would you like to join us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070105,
					"content": "Treasure?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "Don't listen to Verut's bragging. We're just looking to fish up some components.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070107,
					"content": "Well, the components are treasure... Huh? There should be some here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070114,
					"content": "Looks like we're not going to find anything here. Shall we go somewhere else?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070115,
					"content": "Sure! Let's go a little further up ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070116,
					"content": "I'll go with you two.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "Whoa, you're starting to sound like my brother...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070119,
					"content": "Well, let's just walk a little further. I'm quite sure the waters around here were full of components...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070117,
					"content": "You shouldn't go running around everywhere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "Where's Aurele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "He went to look for Mr. Delerue with some questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070110,
					"content": "As for us, we had to be good and stay good... and search for treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070111,
					"content": "Hehe, so... would you like to join us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070112,
					"content": "Don't listen to Verut's bragging. We're just looking to fish up some components.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070113,
					"content": "Well, the components are treasure... Huh? There should be some here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				}
			]
		},
		{
