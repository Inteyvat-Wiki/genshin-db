			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 240070301,
					"content": "Found one! This gear is quite complete. There's even a whole bearing over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070302
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070302,
					"content": "Nice, we can use these!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
