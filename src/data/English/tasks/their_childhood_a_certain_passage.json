						],
						"pointId": 340100204
					}
				]
			},
			"dialogs": [
				{
					"id": 240070501,
					"content": "Let me see... We can use this gear, and if we saw this bearing open...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "What are you looking for this for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "I'm trying to make my own clockwork puppet. Actually, I've been secretly looking into knowledge related to that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Once I figure it all out, I'm going to make a huge Clockwork Meka — now that'll stun Daddy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "I've read lots of books in his room, and I've made some basic components according to the instructions therein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "I'm pretty sure that mek's within reach so long as I keep working at it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "But I can't study these things in the city, or he'll find out — and that would ruin the surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "That's how this place became Lovi's secret clockwork research base. As for me... Well, I'm her assistant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "Well, assistant, talk is cheap! Let's start our research. Today, we must make a moving mechanical arm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "Aye aye, ma'am! Let our research begin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		}
	]
