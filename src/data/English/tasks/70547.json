			"trigger": {
				"objectNames": [
					"Valerina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "Whoa! The Cat Savior and Paimon the Cat Whisperer! I can't believe you actually came!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "Huh? What did you just call us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "That sounds familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "Umm... Have we met somewhere before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "Haha! I can't believe the Cat Whisperer still remembers me! You go, Valerina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "Let's save the catching up for later — for now, how about trying my newly sponsored game? This one's that's kept me grinning for a whole week...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "Dodoco's Blow-Up-Erative Bomb-Nanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "Whoa! So many Dodocos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "And they're all familiar faces.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "Look, Cat Savior... Hehe, or perhaps I should say — our glittering, admirable, Honorary Knight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "This Dodoco doll was designed in your image!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#She's right! Wow, right down to the colors and patterns... Ehe, it's a spitting image of you, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "In this game, Sparky Dodoco, Flashy Dodoco, Knightly Dodoco, and Witchy Dodoco have to join forces, and use explosives to blast their never-seen-before opponents away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "I'm only responsible for the operation and sponsorship of the game, so I'm not really clear on its development. These enemies are just as mysterious to me as they are to you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "But I'm sure that even if we meet in real life, the amazing Dodocos will definitely send them flying back to where they came!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "Of course! No monster can stand against Klee and her best buddy Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "Well, let's give it a try then!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Hehe, I'm sure you'll have a blast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "A new Dodoco game!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Well, the prototype's pretty hard to miss!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "That's a new one to me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
}