			},
			"dialogs": [
				{
					"id": 221130501,
					"content": "Finished! Finally, it's repaired. What do you think of my DIY? Looks alright eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130502,
					"content": "And with any luck, it might actually be fit for purpose too. Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130503,
					"content": "Anyway — take this for your trouble. Many thanks, once again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130504,
					"content": "Please do stop by for a cup of tea or a bite to eat whenever you want to. This chef we've got is really rather good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
