					"id": 221130201,
					"content": "Have you brought the Wooden Planks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130202,
					"content": "Not yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "Ugh, come on, I haven't got all day... I'm waiting to get started here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
