			"dialogs": [
				{
					"id": 221130301,
					"content": "Have you brought the Wooden Planks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130302,
					"content": "Here they are.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Wonderful. Finally! Gosh, these monsters are no end of trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130304,
					"content": "These should be plenty. Many thanks! I will get started straight away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
