			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "Phew... The weather sure is nice. This trip out was well worth it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600102,
					"content": "Hmm? Do my eyes deceive me, or do I spy our \"Tum{RUBY#[D]Hope}aini\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600103,
					"content": "What a coincidence, Xilonen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "You tell Xilonen about Irade and the exam stages...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "Ah, I see... I almost forgot. I did lend her a hand earlier. In fact, our tribe's stage is nearby.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600107,
					"content": "At first, she only got the \"Calamity of Tetlahuitl,\" Nkunga, and the \"Sand Dagger of Seit'aad,\" Amuru, to help her out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600108,
					"content": "But those two aren't big on \"mobility,\" preferring head-on clashes, so the resulting feedback was skewed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600109,
					"content": "First thing Pacal did after hearing that was to ask me to give some suggestions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600110,
					"content": "So the current stage is your work, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "More or less. Pacal, Irade, and I made a few minor modifications after some discussion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600112,
					"content": "Now, the stages are more about getting yourself to advantageous ground quick and managing a shifting fulcrum in the heat of battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600116,
					"content": "Allow me to accept your trial, then!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "Please, everyone in Natlan has witnessed your strength. I doubt there's a challenge out there that could trip you up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600119,
					"content": "Anyway, the stage is over there. Go try it out if you're interested.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600117,
					"content": "Let's hope you didn't make this too difficult...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "You... really make just about everything, don't you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "Eh, it's just a few simple devices. They weren't that hard to build.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600115,
					"content": "A one-time effort on my part for a continuous pipeline of stronger warriors for our tribe? That's a good deal — especially since I can use that extra free time to work through my commission backlog...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600104,
					"content": "I took Irade's commission.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}