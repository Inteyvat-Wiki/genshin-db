			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "Oh? Have you found all the replicas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "Marvelous! You really do have a knack for this, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Well then. This gift is for you. Thanks for taking part in the event organized by our Darshan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "I hope that you've been able to enjoy your taste of archaeology, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "That said, real-life archaeology tends to be rather dry and labor-intensive work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "But the instant you find that key relic, you will feel as if the struggle was all worth it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "And if you fail to dig anything up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Well, if we don't find anything, then this is, as they say, \"a waste of effort.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "And to be honest, this is actually what happens more often than not. The instances where we do find something important are quite rare indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "But to work in archaeology is to be used to such circumstances and stay optimistic even so. It would only be a matter of time before we collapsed otherwise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "I'm quite sure there are situations in which you find nothing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
