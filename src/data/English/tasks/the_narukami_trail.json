			"dialogs": [
				{
					"id": 220500701,
					"content": "Is something the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500702,
						220500705,
						220500710
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500702,
					"content": "About Mikoshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500703
					]
				},
				{
					"id": 220500703,
					"content": "Legend has it that Mikoshi Nagamasa has been working for the Shogunate, and it is said that he is extremely just and upright, even to the point of... being overly stubborn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500704
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500704,
					"content": "His bloodline has been passed down to this day. Most of the people in the city who have the surname Mikoshi today are his descendants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500705,
					"content": "About Kamuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500706
					]
				},
				{
					"id": 220500706,
					"content": "There aren't many records about him. He returned to Inazuma after crossing the sea to Liyue to learn the art of the adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500707
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500707,
					"content": "Then, he created his own \"Onmyoudou\" and \"Shiki Taishou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500708,
					"content": "According to the records, in order to bring peace to Inazuma, he once used this technique to seal the bake-danuki, Ioroi, that was making trouble everywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500709
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500709,
					"content": "But later, news of him gradually disappeared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500710,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500711
					]
