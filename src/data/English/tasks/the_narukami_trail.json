			"dialogs": [
				{
					"id": 220500601,
					"content": "Phew... finally back. After staying next to that shrine for a long time, my fur is curling up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500602,
					"content": "Thank you so much for your help. You are truly a rare and reliable human being, meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500603,
					"content": "I will continue to take care of the shrine. When Hibiki returns, I will introduce you to her.",
