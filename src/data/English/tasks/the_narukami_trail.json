			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "\"Grand Narukami Shrine\"... Is this the place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500202,
					"content": "There are so many red doors. Do humans like red doors a lot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500203,
					"content": "This is called a \"torii gate.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "They are at Asase Shrine too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500205,
					"content": "Oh, I understand now. So, this is a \"torii gate.\" It's a place where birds live, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500206,
					"content": "So the more torii gates there are, the more birds there are, right? Birds are a good thing. Humans are pretty smart, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500207,
					"content": "Have you seen where Hibiki is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500208,
					"content": "There's no trace of anyone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "There seems to be no one around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500210,
					"content": "Why don't we go up to the Grand Narukami Shrine and ask the shrine maidens there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500211,
					"content": "\"Hibiki\" should also be a shrine maiden... Maybe they would know something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "Meow, this shrine is really big, and there are a lot of humans too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500302,
					"content": "Wow! The Offering Box and racks are also very grand, no wonder so many people come here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500303,
					"content": "You should take some pointers. In the future, Asase Shrine will become like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500304,
					"content": "That's... probably not it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "However, I still don't see Hibiki anywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500307,
					"content": "Anyway, let's find someone to ask about \"Hibiki.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500305,
					"content": "Wait, why am I the one who has to take some pointers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inagi Hotomi",
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "Hello, Traveler from afar. Welcome to the Grand Narukami Shrine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500402,
					"content": "If you encounter any trouble or just want to make a wish, feel free to come here for a fortune slip. May the Electro Archon bless you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500403,
					"content": "We are not here to ask for a fortune slip, but there is something we want to ask you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500404,
					"content": "Ask me? Oh... go ahead then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500405,
					"content": "Well, here's the situation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "Hibiki from Asase Shrine? Could it be \"Asase Hibiki\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500407,
					"content": "Yes! Hibiki is \"Asase Hibiki.\" Human! Do you know Hibiki? Do you know where she is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500408,
					"content": "Hmmm... Huh!? How can this cat talk? Am I hearing things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500409,
					"content": "Humans, such ado about nothing... Is it so strange that I speak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500410,
					"content": "Do you know Hibiki? Do you know where she is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500411,
					"content": "It feels really strange to be questioned by a cat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500412,
					"content": "However, if you are really asking about that \"Asase Hibiki,\" you've come to the wrong place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500413,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500414,
					"content": "Wrong... place?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "I have come across her name in the few well-preserved ancient texts of the shrine. She is the last successor of Asase Shrine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500416,
					"content": "About four to five hundred years ago, it was said that \"The Yougou Three\" Asase Hibiki, Kamuna Harunosuke, and Mikoshi Nagamasa once went to Mt. Yougou to learn under the Yougou Tengu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500417,
					"content": "During that time, Asase apprenticed at our shrine and also befriended the Kitsune Saiguu. However, in the end...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500418,
					"content": "The three eventually parted ways after a \"disaster\" that was vague in their account. It is said that Kamuna Harunosuke crossed the sea and went to Liyue as he wanted to learn the more powerful \"way of the adepti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500419,
					"content": "Mikoshi Nagamasa returned to Inazuma City to serve the Shogunate. As for Asase Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500420,
					"content": "She returned to Seirai Island...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "Well, that's right. But because there is so little historical information available, the details are not very clear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500423,
					"content": "Wait a minute...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "Hmm... she said four to five hundred years ago. So that means, Hibiki was someone from a long time ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500425,
					"content": "So Neko's a cat that's 400 or 500 years old?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500426,
					"content": "Meow? I'm not sure. What does \"400 or 500 years old\" mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500427,
					"content": "I am not a human being. There aren't many things to worry about. I just know the rising of the sun, and then the moon. If I am in a bad mood, sleep is the best remedy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500428,
					"content": "Paimon's so envious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500429,
					"content": "Paimon, it's almost the same for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "#Hey! How rude, Paimon is worried sick about {NICKNAME} every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500433,
					"content": "You have said a lot of things that I do not understand. So, where is Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500434,
					"content": "With all due respect, I'm afraid that Asase Hibiki has...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500435,
					"content": "Hibiki is not here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "Yes, that's right. Hibiki should have gone somewhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500437,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500438,
					"content": "That's true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500439,
					"content": "Oh well. Hibiki is still like a child, running around as she pleases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500440,
					"content": "Anyway, thank you, Miss Shrine Maiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500441,
					"content": "Please excuse us, we'll be leaving now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500442
					]
				},
				{
					"id": 220500442,
					"content": "Take care now. I'll be ready to help whenever you need me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500431,
					"content": "Do cats live that long?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500432
					]
				},
				{
					"id": 220500432,
					"content": "Generally speaking, not really...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500421,
					"content": "Back to Asase Shrine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				}
			]
		},
		{
			"id": 2205005,
			"completionStepIds": [
				2205006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205006",
							"2"
						],
						"stepId": 2205006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500501,
					"content": "Let's have a rest here, I am tired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500502,
					"content": "But it's really the same as what Hibiki said.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500503
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500503,
					"content": "The different islands are really completely different. Also, it turns out that the shrine can be on such a high mountain. Aren't humans afraid of heights?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500504,
					"content": "My Asase Shrine is still better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500505,
					"content": "Where exactly is Hibiki, I wonder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500506,
					"content": "Do you still wish to continue looking for her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500507
					]
				},
				{
					"id": 220500507,
					"content": "I am tired. Let's talk about it later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500508,
					"content": "There's still a \"later\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500509,
					"content": "That's for sure. Hibiki told me many, many stories. Stories about the beach, stories about the place with lots of trees, stories about the \"Lady Kitsune.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500510
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500510,
					"content": "I remember all these stories very well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500511,
					"content": "But the most important thing now is to return home. After all, Asase Shrine must have its Guuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500512,
					"content": "In short, you will go back with me now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
