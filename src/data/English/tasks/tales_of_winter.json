	"talks": [
		{
			"id": 2060001,
			"completionStepIds": [
				2060001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060001",
							"2"
						],
						"stepId": 2060001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "Traveler, over here. I've been watching you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000102,
					"content": "What do you want?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "Come now, why the wary tone? I've got a fine proposition for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000104,
					"content": "How would you like to join the Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000105,
					"content": "You wish! Isn't that right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000106,
					"content": "I'll give it some thought.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "Hey! What do you mean you'll give it some thought? Shouldn't we be refusing right away!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 206000108,
					"content": "You've got a good eye. If you want to do great things, there's no place like the Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000111,
					"content": "Now... By the look of you, you must have questions, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000109,
					"content": "Well, this is Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "And so what if it is? We, the Fatui, recruit from all over the continent. This is fair game, and Knights have no say in it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060002",
							"2"
						],
						"stepId": 2060002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "So, tell me about the Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "How very direct. Hmm, this is quite the long story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000203,
					"content": "But given that you're not yet an official member of the Fatui, I can't tell you, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000204,
					"content": "I've heard that there are a lot of hilichurls around Mondstadt, and some have even huddled together into groups.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000205,
					"content": "Let's make a deal. You take a stroll outside and bring a trophy from a Mitachurl back for me, and I'll tell you a little story. How does that sound?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000206,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "Very straightforward, I like it. One hardly finds someone like you in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000208,
					"content": "Hurry along, then. I'll be waiting for you here. Did I mention that you should hurry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000209,
					"content": "Is this all you need?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "What, too easy? It'll do, or do you think you can take on something nastier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000211,
					"content": "Just go, and be back soon. I'll wait here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000212,
					"content": "*sigh* If you'd kept me waiting any longer, I'd have been put to sleep by this wind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060003,
			"completionStepIds": [
				2060003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060003",
							"2"
						],
						"stepId": 2060003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000301,
					"content": "So, about Delusions, then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "Hah! I say, are you an idiot, or is that just an act?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000303,
					"content": "You're not even an official member of the Fatui. Do you really think you can ask \"what's a Delusion?\" just like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000304,
					"content": "Do you think I'd tell you? Like those two Knights of Favonius guards at the gate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000305,
					"content": "Still, Delusions are our precious pride and joy — it couldn't hurt to explain a little.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000306,
					"content": "How about this, then. I believe you've seen those Treasure Hoarders outside Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000307,
					"content": "They're a bunch of skulking two-bit pikers, but they do sometimes blunder into something valuable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000308,
					"content": "If you could head over there and take a little something off them, I'll tell you a bit about Delusions in return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000309,
					"content": "Alright, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "I think I like you. Off you go, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000311,
					"content": "Are you lacking money?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "Money? Hahaha, do you take me for one of those Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000313,
					"content": "No, I'd just like to see what those Treasure Hoarders can dig up in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000314,
					"content": "That said, I don't think they'll find anything decent. *chuckles*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060004,
