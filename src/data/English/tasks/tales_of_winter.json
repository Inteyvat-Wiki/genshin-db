				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000801,
					"content": "So, have you got it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000802,
					"content": "Indeed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000803
					]
				},
				{
					"id": 206000803,
					"content": "Let me see. Gah, of course you couldn't find anything good in this backwater...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000804,
					"content": "Alright, alright, one story about Delusions coming right up. Let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000805,
					"content": "Delusions are treasures of incredible power, granted by Her Majesty the Tsaritsa in person. Whether faith or Vision, a Delusion makes them all look like child's play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000806,
					"content": "Still, not everyone can wield one. Beyond the Eleven Harbingers, very few other Fatui possess a Delusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000807
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000807,
					"content": "Even so, for an ordinary mortal like me, a Delusion is far more practical than a Vision, which one can only get by the grace of the gods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000808
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000808,
					"content": "Ha, I see that you don't own a Vision, either. How about it, then? If you join the Fatui, who knows? Maybe you really will come to possess a Delusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000809,
					"content": "And that's all I have to say about Delusions. The Knights of Favonius are rather touchy about these things, so best you don't send them running my way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060009,
