			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000401,
					"content": "Now, about the Tsaritsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "What, you want to ask me about the Tsaritsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000403,
					"content": "Is she the reason you want to join the Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000404,
					"content": "I don't mean to put you down, but weigh your words for a moment, why don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000405,
					"content": "Still, the Tsaritsa is something that I cannot tell you about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000406,
					"content": "Why don't you go grab something off a Ruin Guard? I'm in need of something to fiddle with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000407,
					"content": "I... Fine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "Well, then off you get. I'll be waiting here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000409,
					"content": "What do you need that for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "Eh? Can't a man collect trinkets? Or are you Mondstadt folk afraid of a little Ruin Guard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000411,
					"content": "To us Fatui, we would barely need to lift a finger to take care of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000412,
					"content": "Still... *sigh* this breeze really is lulling me to sleep, so I'll leave this trifling matter to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060005,
