			"dialogs": [
				{
					"id": 206000501,
					"content": "Don't forget, it's a Mitachurl trophy that you want. Come back here once you've got it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000502,
					"content": "What is it, specifically? It's... a horn. Just go get it already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
