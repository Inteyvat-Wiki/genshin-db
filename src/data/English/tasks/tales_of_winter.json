				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060005",
							"3"
						],
						"stepId": 2060005,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060006",
							"2"
						],
						"stepId": 2060006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000601,
					"content": "Have you brought it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000602,
					"content": "Sure have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Let me have a look. Well... it's passable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000604,
					"content": "Now, let me tell you a little something about the Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000605,
					"content": "We Fatui hail from Zapolyarny Palace. We hear the commands of Her Majesty the Tsaritsa and we inherit her will, enacting it throughout the land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000606,
					"content": "The eleven strongest among us have been granted the title of Harbingers by Her Majesty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000607,
					"content": "Compared to a nameless grunt like me, the Eleven Harbingers are truly great figures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000608,
					"content": "If you join the Fatui and prove your strength, then perhaps you might be chosen by one of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000609,
					"content": "And then you'd be on the up and up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000610,
					"content": "As for me? Well, I'm hardly \"chosen,\" but I am running a little errand here for Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000611,
					"content": "But if you made me choose... I'd prefer to work under Capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
