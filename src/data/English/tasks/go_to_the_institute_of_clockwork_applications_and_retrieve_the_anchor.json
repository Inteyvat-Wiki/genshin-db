			"dialogs": [
				{
					"id": 740880401,
					"content": "#There should be a Survey Anchor here too. I'll open the door, and leave the recovery to you, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
