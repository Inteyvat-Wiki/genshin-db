			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "Perhaps... Like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540302,
					"content": "Hmm, let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540303,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540304,
					"content": "Moons... Moons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540305,
					"content": "How about here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540306,
					"content": "Looks like I won this round.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540307,
					"content": "My three moons are connected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540308,
					"content": "Mm, this should win it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540309,
					"content": "Mm... The moons wax and wane in an endless cycle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540310,
					"content": "It seems both sets of moons refuse to be eclipsed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540311,
					"content": "Are we... heading for a tie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540312,
					"content": "Ah, you weigh your decisions carefully before making them, I see. Take your time — we have plenty of that, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540313,
					"content": "Did you forget how to place your moons in the night sky? Shall I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540314,
					"content": "You don't like this game? Hm... I find it quite amusing myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540315,
					"content": "Mm? Are you staring at me? Your gaze is not subtle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540316,
					"content": "You're staring... Is the truth of the moons written on my face?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540317,
					"content": "The board's over there, by the way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540318,
					"content": "Hm, your moons are aligned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540319,
					"content": "The night sky is yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540320,
					"content": "Ah... I must have... slipped up somewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540321,
					"content": "You have a wonderful time playing the game with Columbina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Thank you, I enjoyed that a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540323,
					"content": "If you'd like... feel free to come keep me company again, sometime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540324,
					"content": "Here, take this as a token of our promise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		}
	]
}