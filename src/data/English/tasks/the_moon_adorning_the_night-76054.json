			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"The Damselette"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2149.017,
							136.326,
							11219.34
						],
						"pointId": 360300009
					}
				]
			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "Huh, where's Columbina? Paimon doesn't see her anywhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Over here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540103,
					"content": "Whoa! What are you doing all the way up there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Come join me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540105,
					"content": "What are we getting ourselves into this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "Do you remember those stones we went out to gather last time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540107,
					"content": "Last time? Oh, you mean the ore that glows after absorbing kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Correct. Well, after that, the kuuhenki gathered some more, and I sorted them into two types — darker ones and lighter ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540109,
					"content": "Darker ones and lighter ones? But... Why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "To play Moon Chess, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540111,
					"content": "Uh... What's \"Moon Chess\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "Oh, you've never played?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540113,
					"content": "...Nope.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "I see... Ever since seeing the grids the children of the Frostmoon Scions draw on the ground, I've always wanted to try it out. But I've never had anyone to play it with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540115,
					"content": "Well, what are the rules?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Hm... It'll be easier if I just show you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540117,
					"content": "Whoa! Th—That's amazing! How did you do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Hm? With a little kuuvahki, of course... You can't do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540119,
					"content": "Hahaha... Maybe you should lower your expectations. We're not all moon goddesses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "As you wish. Now, this is the board — it represents the \"night sky.\" And the pieces each player controls represent the \"moons.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540121,
					"content": "The two players take turns placing their moons in the sky, and the first to get three moons in a row wins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540122,
					"content": "Ohhh! So it's basically a version of tic-tac-toe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "So, it's called \"Moon Chess\" here in Nod-Krai, huh... Talk about giving it a local touch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "I see. Well, in this version, the moons rotate, meaning there can never be more than three moons in the sky at once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540125,
					"content": "So, when the night sky is full, the moon that rose earliest will vanish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540126,
					"content": "That... actually makes a lot of sense... and it makes the game a lot harder too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "So, would you like to give it a try? It'll be my first time playing too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540128,
					"content": "(Looks like she's really looking forward to this...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#Hehe, sounds fun! Paimon will be the referee! {NICKNAME}'s a clever one, though, so watch out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "Alright then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
		{
