			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "\"The service at Shapur Hotel is good, but their sound insulation is awful.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170902,
					"content": "\"I stayed here because prices in Port Ormos were low. Now I'll have to move to Sumeru City.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170903,
					"content": "\"If I failed the exam again this year, I'm gonna have to return home and be a farmer. Don't know if I can take some 'Anahitian Blessing' with me then...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
