			"dialogs": [
				{
					"id": 732170401,
					"content": "Special reminder: The Eremites are the only authorized mercenary organization in Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170402,
					"content": "Please do not trust strangers easily in case of getting cheated by scammers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170403,
					"content": "If you wish to hire bodyguards, security staff, or have any other requests, please contact Captain Feroz of the Corps of Thirty at Port Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321705,
