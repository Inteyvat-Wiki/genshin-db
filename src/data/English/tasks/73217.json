			"dialogs": [
				{
					"id": 732170601,
					"content": "Investigations are being conducted to track smuggling. All goods passing through the port need to be registered and inspected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170602,
					"content": "All unregistered or contraband goods will be confiscated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170603,
					"content": "All consequences shall be borne by the cargo owner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
