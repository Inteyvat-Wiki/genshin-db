			"dialogs": [
				{
					"id": 732170701,
					"content": "Watch out for sea beasts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170702,
					"content": "We have witnessed an increased sea beasts activity recently. Ships leaving the port should pay attention to warnings issued by Pharos Lighthouse, or obtain maritime information in advance through Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170703,
					"content": "For any questions, please contact the Lighthouse Guardian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
