			"dialogs": [
				{
					"id": 732170501,
					"content": "Personal info and reasons for all docking ships need to be reported to the Port Master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170502,
					"content": "Merchant ships need to provide details on the cargo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170503,
					"content": "Merchant ships shall not unload cargo or trade without registration here. Any violation will face severe punishment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321706,
