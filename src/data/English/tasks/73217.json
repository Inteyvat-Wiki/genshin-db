						"stepId": 302812,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732172001,
					"content": "Watch out for sea beasts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732172002
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732172002,
					"content": "We have recently witnessed an increase in sea beast activity. Ships leaving the port should pay attention to warnings issued by Pharos Lighthouse, or obtain maritime information in advance through the Mahamata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732172003
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732172003,
					"content": "For any questions, please contact the Lighthouse Guardian.",
