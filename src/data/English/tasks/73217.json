			"dialogs": [
				{
					"id": 732170801,
					"content": "As the largest hotel in Port Ormos, we provide the most thoughtful services for merchants and tourists.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170802,
					"content": "We have a special discount for students and graduates of the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170803,
					"content": "If you need to store goods, please contact Wikala Funduq.",
					"roleType": "TALK_ROLE_NPC",
