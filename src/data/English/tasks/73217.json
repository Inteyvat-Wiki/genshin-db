			"dialogs": [
				{
					"id": 732170101,
					"content": "This Bulletin Board is set up by the Port Master of Port Ormos to publicize important matters in and around Port Ormos. Questions or doubts regarding the notices on the Bulletin Board can be posted here as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "\"Struggling with paper format? Still trying to find ideas for your paper? It's time to try something new!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170202,
					"content": "\"I majored in Hara{RUBY#[S]Semiotics}vatat and am proficient in both Span{RUBY#[S]Elementalism}tamad and Kshah{RUBY#[S]Technology}rewar. Providing Q&A services on paper writing.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170203,
					"content": "\"Time to wriggle out of your pains. Contact Mr. Amandeep at the hotel. Service fee negotiable.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170204,
					"content": "\"Do you ghostwrite?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170205,
					"content": "\"No, the Inspector will not allow such behavior.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170206,
					"content": "\"Indeed. Focus on your study and do not try your luck.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "Have you heard of levitation? Have you seen someone flying? Would you like to discover the secrets of the flying Sumpter Beast? Then don't miss out on the Fontaine Flyers' first performance in Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170302,
					"content": "Welcome, show's on! Don't miss this unique performance of art! Only five Mora for a ticket.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732170303,
					"content": "\"It was wonderful. I've never seen anything like it, even in Fontaine!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
