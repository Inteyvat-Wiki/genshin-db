			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "\"These Mahamata they sent are each more useless than the last. They can't answer a single question that I ask.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171002,
					"content": "\"And now that we have access to the Akasha, these amateur Mahamata are not even at my level.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171003,
					"content": "\"That Scribe we don't see very often who helped us sort out the shipping schedule last time is the only exception. Seems the Akademiya are not all dim-wits.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "\"The burden on me gets heavier since Cyno became a General Mahamatra, but it's actually more relieving since I don't have to deal with the tedious factionalism anymore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171102,
					"content": "\"Or I couldn't be loitering around here while on a research trip.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171103,
					"content": "\"Don't know where Cyno has been. Guess I wouldn't get caught by him if I write it here.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171104,
					"content": "\"I've seen it all. Report to me before tomorrow noon and receive punishment.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171105,
					"content": "\"Don't waste my time.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "Our commerce engages in the trade of gem products and precious ores produced in Liyue with sufficient stable supply channels and long-term cooperation with many fleets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171202,
					"content": "A handful of stylish silks are for sale. Limited offer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171203,
					"content": "Contact us if you have a good supply channel for Sumeru local blankets, herbs, gemstones, and brocade products. Let's trade and make friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "\"Last month, I sailed to a country whose king had never seen a horse. Can you believe it?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171302,
					"content": "\"So I decided to sell some Sumpter Beasts there and tell them that those were horses, haha. If I closed a deal with them, perhaps I could be a king or something there!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171303,
					"content": "\"What is a king?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171304,
					"content": "\"Like the Navbed or a Vizier, but with greater power than any of them. Pretty much the same as the legendary Twenty-Nine Deys. Gosh, it's so hard to describe.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171305,
					"content": "\"You're just making this up.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321714",
							"2"
						],
						"stepId": 7321714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "\"So dully is the sage's preach. Bring the wine made from flowers, for there are the seven seas to reach.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321715,
			"completionStepIds": [
				7321715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321715",
							"2"
						],
						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "To sailors, travelers, merchants, and port residents: The port regulations are announced here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171502,
					"content": "In case of dispute, contact Sheriff Shyam for assistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "\"Instead of visiting the Grand Bazaar in Sumeru City, you should visit the old markets in Port Ormos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171602,
					"content": "\"The Grand Bazaar is messed up by the Mahamata. We are maintaining a lot more Sumeru traditions and characters here instead.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171603,
					"content": "\"But, of course, if you want to watch a dancing performance, you still have to go to Zubayr Theater, though.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171604,
					"content": "\"Peasants. The Sumeru City was built with a delicate plan by researchers. The zoning and planning of each and every area here are backed up by scientific research.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171605,
					"content": "\"I see someone here is full of nonsense. The unruly streets in Port Ormos somehow have become treasures in their eyes!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171606,
					"content": "\"What's that? Can't hear you!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "\"This is embarrassing to say. We were workers that maintain merchant ships here, living off the maintenance skills passed down from generation to generation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171702,
					"content": "\"But some time ago, new technologies have been added to the Akasha, and our years of experience have become worthless. Young people can still learn through the Akasha, but old stuff like us have no choice but to change jobs.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171703,
					"content": "\"The Scribe said we can go to sea and try our luck, but we have no money for something like that right now. If you have any gigs, please come to us.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171704,
					"content": "\"Don't listen to the Scribe. I happen to know a big client who needs craftsmen. I'll introduce you to her. Take the money too. Forget about going to sea.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171705,
					"content": "\"I wish you could do less meaningless things. Some people will succeed and some will fall, that's how the world works. Why interfere with it just to act like a goody-two-shoes?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171706,
					"content": "\"Here the Scribe goes again with the mysticism. Why did I do this, you say? Because it makes me happy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171707,
					"content": "\"And don't you forget that mutual assistance, fairness, and righteous anger are also what drive the world, not the nonsense like 'the fittest survives'!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171708,
					"content": "\"Make no mistake. I have never denied what you meant, but you don't understand what I am saying to you at all. End of conversation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171709,
					"content": "\"It's a headache to argue with the impulsive. Anyway, where's your own budget? Don't tell me you're spending all your Akademiya subsidies on such nonsense.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171710,
					"content": "\"'The poor suffer from the rich's wealth. Thus the rich should give away their wealth for a good purpose.' says the sage Zolfikar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171711,
					"content": "\"He never said that.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171712,
					"content": "\"He did.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171713,
					"content": "\"No, he never said that. And you'll pay for your drinks this month.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171714,
					"content": "\"I won't argue with you about this. But give me a month. I'll prove that he said it.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321718",
							"2"
						],
						"stepId": 7321718,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "\"Our company has opened the route to Dornman Port. We sincerely invite you to join our fruit business.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171802,
					"content": "\"Wait a minute. Is it even possible to import fruit from Mondstadt, given the long voyage? I might be interested if you were talking about liquor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171803,
					"content": "\"Everyone knows importing wine from Mondstadt is a business, but importing fruit? Only I do such business here. That's why this is such a great business opportunity!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171804,
					"content": "\"And you don't actually need to import from Mondstadt...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321719,
			"completionStepIds": [
				7321719
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321719",
							"2"
						],
						"stepId": 7321719,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171901,
					"content": "\"The route to Ritou has been reopened. We sincerely invite you to join our business.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171902
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171902,
					"content": "\"Our Association's trade of wild mushrooms between Sumeru and Inazuma has been approved by the Port Master. We are now open to mushroom merchants for cooperation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171903
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732171903,
					"content": "\"You can also contact us if you encounter any problems or difficulties during your travel to Inazuma.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321720,
			"completionStepIds": [
				7321707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321707",
							"2"
						],
						"stepId": 7321707,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
