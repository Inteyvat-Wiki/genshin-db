						718000202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000202,
					"content": "One can't very well brew tea with it in this state...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 7180003,
			"completionStepIds": [
				7180006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180006",
							"2"
						],
						"stepId": 7180006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718000301,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000302,
						718000305
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000302,
					"content": "My clothes are soaked through...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000303
					]
				},
				{
					"id": 718000303,
					"content": "I'm terribly sorry, children, how absent-minded of me. I had thought there was only a little water inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000304,
					"content": "At least this teapot is more or less clean now. There are a few final nooks and crannies to attend to, but all in good time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000307,
					"content": "Granny, did you put the whole Bishui River in there or something!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718000308,
					"content": "Foolish child, I wouldn't dream of doing such a thing — wherever would the poor city folks draw their water from if I did that? No, I was careful to use only half of the river's water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000309
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000309,
					"content": "Sorry for causing you a little spot of bother on this occasion. Please accept these as thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000310
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000310,
					"content": "Oh, and I mustn't forget to return the water from the teapot back to the river some time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 718000305,
					"content": "Should be spick and span in there by now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000306
					]
				},
				{
					"id": 718000306,
					"content": "Well, mostly. There are still a few nooks and crannies, mind you, that one shall have to get inside and clean out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
