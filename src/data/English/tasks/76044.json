			"dialogs": [
				{
					"id": 760440101,
					"content": "There's a particularly tricky bounty at The Flagship with basically no leads.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440102,
					"content": "The target was attacking people in the north of Lempo Isle, but now he's disappeared without a trace. No one seems to know where he's gone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440103,
					"content": "Every contact leaves a trace. No matter how carefully someone covers their tracks, in doing so, they always create new ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440104,
					"content": "Besides, just because the bounty didn't include any extra information, doesn't mean whoever posted it doesn't have any.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440105,
					"content": "I never thought of that... I'll go ask Leszek — with all my experience, I should be able to get something useful out of him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440106,
					"content": "I'll leave it to you then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440107,
					"content": "You can count on me, Boss Nef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
