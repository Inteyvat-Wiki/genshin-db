			"dialogs": [
				{
					"id": 760440301,
					"content": "Hmm... Seems like only yesterday, there were plenty of bounties going at The Flagship — now there's only one left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440302,
					"content": "#Apparently, that's all down to {NICKNAME}. But even {M#he}{F#she} hasn't been able to crack this last one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440303,
					"content": "Well, there really aren't any leads—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440304,
					"content": "Ah, but... Just because something isn't written on the bounty board, doesn't mean it doesn't exist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440305,
					"content": "What's this — a sudden flash of inspiration?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440306,
					"content": "I'm going to ask Leszek — with all my experience, I should be able to get something useful out of him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440307,
					"content": "I'll leave it to you then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440308,
					"content": "You can count on me, Boss Nef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
