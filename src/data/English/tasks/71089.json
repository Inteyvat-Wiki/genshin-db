				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "Wow, that's a really long letter. Seems like Zhiqiong left it here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890102,
					"content": "It's hers alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "Ugh, where's she gone!? Let's go tell Jinwu what happened first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
							"2"
						],
						"stepId": 7108903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Jinwu, we found this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "Alright, alright, relax. What did you find? Does it have anything to do with Zhiqiong's whereabouts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "It's a letter she left behind. She says she's gone deeper into The Chasm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "Thank you. Let me see what she's written real quick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu reads the letter carefully.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "This girl... I've never really considered issues this big, so I can't really criticize her life choices. But perhaps...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "Perhaps I didn't acknowledge her discoveries in time, or give her as much respect or understanding as I should've.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "It would've been immeasurably more difficult to complete our exploration without her maps... But I only showed concern for her health instead of focusing on her hard work and what she'd done so much to achieve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "Agh, how did I not realize how her work was always different from that of us miners...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "She just doesn't want to be forgotten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "Well, don't we all, as people who aren't favored by the gods...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "Don't we all... But has anyone been as obsessed as her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "And yet, when I think about the moment when I gave up any thoughts of becoming great... when I realize that I've gotten to used to living day to ordinary day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "I feel like I just don't have the right to judge Zhiqiong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
}