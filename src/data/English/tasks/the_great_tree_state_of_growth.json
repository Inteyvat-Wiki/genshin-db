			"dialogs": [
				{
					"id": 230290401,
					"content": "How did it go? Did you take the picture?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290402,
					"content": "Of course.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "Wow! Let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290404,
					"content": "Well done. Perfectly angled, and the image is pretty clear as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290405,
					"content": "Here is your payment. Thank you for helping me, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290406,
					"content": "The trunk is fine... And the shape of surrounding branches hasn't changed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290407,
					"content": "Great, I'll wait till Ladep and Pharez finish gathering their data, and we can move on to the next subject.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
