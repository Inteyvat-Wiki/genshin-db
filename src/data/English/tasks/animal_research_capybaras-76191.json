			"dialogs": [
				{
					"id": 761910201,
					"content": "I warned you more than once — keep your eyes open. This is premium stock, personally requested by repeat clients in Snezhnograd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910202,
					"content": "And you just let it go? Have you gone soft on me? Did you suddenly grow a conscience or what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910203,
					"content": "Boss, listen, it's really not my fault. Those Hilichurls—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910204,
					"content": "Hilichurls? You're using that as an excuse? Keep this up and you'll make a joke of our Treasure Hoarder brand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910205,
					"content": "I couldn't handle them, boss. I really couldn't! The blue one and its green friend hit harder than those Agents...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910206,
					"content": "(These two... they're definitely smugglers.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910207,
					"content": "...Who's there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910208,
					"content": "Easy, Lumi! Not yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910209,
					"content": "What's this? Hmm... A rare find.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910210,
					"content": "Hey, you can handle a little girl, yeah? This looks solid enough. Let's swap it in and call it a day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910211,
					"content": "Yes, boss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910212,
					"content": "You have the nerve to go after Lumi now? You're the reason the Treasure Hoarders' reputation is in the gutter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910213,
					"content": "\"Reputation\"? The Treasure Hoarders have a... what now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910214,
					"content": "Stop wasting your breath on her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhoma"
				}
			]
		},
