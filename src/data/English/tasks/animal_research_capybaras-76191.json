			},
			"dialogs": [
				{
					"id": 761910301,
					"content": "It really is a silver Capybara... No dye, no trick of the light. This is so incredibly rare... absolutely astonishing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910302,
					"content": "I searched all over Natlan and never managed to find one. Turns out, it got snatched by smugglers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910303,
					"content": "But it doesn't seem hurt... Hehe, a silver Capybara! Never imagined I'd get to see one with my own eyes! Let me just— oh, let me feel it for a moment, see if this silver one feels any different from the ordinary ones...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910304,
					"content": "Ouch! It's burning hot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910305,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Capybara"
				},
				{
					"id": 761910306,
					"content": "Ah, I almost forgot! You're still in the pot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910307,
					"content": "Could it be that you've grown used to Natlan's liquid Phlogiston, so this temperature barely fazes you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910308,
					"content": "Anyway, you're coming back with me for now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910309,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Capybara"
				}
			]
