			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "Hello, Nara friend! Um... I was supposed to tell you something, but I don't remember...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150102,
					"content": "It's okay. We are just happy to see you again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150103,
					"content": "Well, thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150104,
					"content": "About \"Mawtiyima\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "She's not talking anymore, but she's doing well. Recovering too, the forest is... Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150106,
					"content": "About forgetting...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "Forgetting...? Oh, because the power has been depleted, the Kusava. That's why it will flow away too, memory. Drop by drop, like dewdrops...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				}
			]
		},
