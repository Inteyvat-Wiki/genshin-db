			},
			"dialogs": [
				{
					"id": 732150501,
					"content": "Hello, Golden Nara! And you, Little White Floaty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150502,
					"content": "Hmph! Paimon is not little! Take a look in the mirror!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150503,
					"content": "Hey, I'm not little either! Oh, right, what are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150504,
					"content": "We just came back to see you guys.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "Yeah, we defeated a lot of bad guys in the past after all, and we sang together, and saved \"M—Mootaya\" together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150506,
					"content": "Mawtiyima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150507,
					"content": "Yeah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150508,
					"content": "Oh... Sorry... What you guys are saying must be true, but I don't remember...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150509,
					"content": "Um...! I—It's okay! Don't be sad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150510,
					"content": "(He really doesn't remember...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
