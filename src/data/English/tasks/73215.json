					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150301,
					"content": "Hello, and thank you! Golden Nara and White Floaty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150302,
					"content": "What are you guys doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150303,
					"content": "You said to remember to come back and play together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150304,
					"content": "Oh, did I say that...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150305,
					"content": "You did say that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "I see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150309,
					"content": "Anyway, thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150307,
					"content": "What, are you upset?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "Mm... No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Aragaru"
				}
			]
		},
