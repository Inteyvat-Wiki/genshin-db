			"dialogs": [
				{
					"id": 732150601,
					"content": "Golden Nara, White Floaty! You're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150602,
					"content": "Yeah! We're here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150603,
					"content": "Hehehe... I probably forgot many things, so I need you to remind me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150604,
					"content": "Is it because of the Kusava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Yes... Aranaga should have mentioned it to you. Power is in memory, and no memory means no power...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150606
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150606,
					"content": "So... We must have experienced something in the past, but we don't remember anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150607
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150607,
					"content": "Haha, but it's nothing to me! We can still start making new memories again, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150608
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150608,
					"content": "Yes! That's the spirit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
