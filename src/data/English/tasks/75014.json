			"dialogs": [
				{
					"id": 750141201,
					"content": "Huh? Are you lost, little one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141202
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141202,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141203,
					"content": "How energetic! You look healthy. And there's a special pattern on your horn... Not bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141204
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141204,
					"content": "Still, why did you all come here together? Did I do a bad job of teaching? That can't be, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141205
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141205,
					"content": "Rooh? Rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141206,
					"content": "Huh? What's wrong with it? Did it bring you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141207
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141207,
					"content": "(I can't let her notice me...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141208,
						750141209
					]
				},
				{
					"id": 750141208,
					"content": "Hooo... Hoooo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				},
				{
					"id": 750141210,
					"content": "Why are you making such weird sounds? Are you sick? You seem to be acting strange too. We might need to get you checked out properly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141211
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141211,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141212,
					"content": "Don't be impatient, little one. It'll be your turn soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141221
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141221,
					"content": "You're up first. Follow me. Do you understand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141213,
						750141215,
						750141217
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141213,
					"content": "(Nod.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141214
					]
				},
				{
					"id": 750141214,
					"content": "Where did you learn to do that? Oh my, do you understand what I'm saying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141219,
					"content": "#Just then, you hear the sound of a ruckus outside...\\n\"Who opened the box... Hey! Let go! Stop fighting over it! Quilla's gonna be mad!\"\\nThere is no time to find out what has happened. You take advantage of the chaos to escape the camp with {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750141215,
					"content": "(Shake head.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141216
					]
				},
				{
					"id": 750141216,
					"content": "Where did you learn to do that? Oh my, do you understand what I'm saying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141217,
					"content": "(Follow her.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141218
					]
				},
				{
					"id": 750141218,
					"content": "That's odd — I haven't given you any instructions yet. Do you understand what I'm saying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141209,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				}
			]
		},
