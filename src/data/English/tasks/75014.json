					"Temach"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750875701,
					"content": "We still have a few more flying challenges. Details are written on the board. Give 'em a try if you're keen... Of course, there are prizes to be won.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875702,
						750875705,
						750875709
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875702,
					"content": "About the Pakpaka Flying School...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875703
					]
				},
				{
					"id": 750875703,
					"content": "Honestly, I have no clue why it's called that. But speaking of Pakpaka... Have you ever heard the story of Kuntur and the evil sorcerer Rumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875704
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875704,
					"content": "The warriors of the tribe were defeated by that wicked mage, and he turned them into Pakpaka... which doesn't sound all that good. Maybe Pakpakas fly very quickly, or something — I don't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875705,
					"content": "About Lamizana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875706
					]
				},
				{
					"id": 750875706,
					"content": "Haha... He's a good fighter, but not necessarily a good teacher. And as an opponent in flying competitions... I guess he's passable?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875707
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875707,
					"content": "But I mean, why would you come here if you didn't have issues with flying? So, if I were to be too strict... *sigh* Well, it's not like things like this have never happened in the past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875708
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875708,
					"content": "That's why I focus on encouraging people nowadays. I'm sure that approach will get results just fine too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875709,
					"content": "Gotta go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875710
					]
				},
				{
					"id": 750875710,
					"content": "See you. You're welcome back any time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
			]
		},
