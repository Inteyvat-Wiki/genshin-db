			},
			"dialogs": [
				{
					"id": 750141601,
					"content": "Ugh, this is trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141602,
						750141605
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141602,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141603
					]
				},
				{
					"id": 750141603,
					"content": "Well, I have a little brother who's a lot younger than me. Maybe it's because he's in his rebellious years, but he doesn't get along with anyone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141604
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141604,
					"content": "Bah, I'll only add to your troubles by telling you about this. Things will probably get better when he grows up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750141605,
					"content": "Sorry to bother you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141606
					]
				},
				{
					"id": 750141606,
					"content": "It's no trouble. See you around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				}
			]
		},
		{
