			},
			"dialogs": [
				{
					"id": 205190501,
					"content": "What... What can I do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190502
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190502,
					"content": "I'm still waiting for Sister Victoria to give me her reply.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190503
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190503,
					"content": "This incident... I'm prepared for the consequences, no matter what they may be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
