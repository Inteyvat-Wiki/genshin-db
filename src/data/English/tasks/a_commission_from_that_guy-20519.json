			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190201,
					"content": "You're back already? Why, aren't you efficient? I think I know why that gentleman likes you so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190202,
						205190204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190202,
					"content": "The money. Give it here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190203
					]
				},
				{
					"id": 205190203,
					"content": "How cold. I mean, I do have the bounty right here. But pray, spare a thought for a fellow errand-runner's feelings!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190204,
					"content": "Why, it's an honor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190205
					]
				},
				{
					"id": 205190205,
					"content": "Oh no, the honor is all mine. Please take this reward... And pleasure doing business with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051902",
							"2"
						],
						"stepId": 2051902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "...Those Treasure Hoarders... Oh, I'm sorry! Is something the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190302,
					"content": "There are Treasure Hoarders active around Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "Treasure Hoarders? We're on the trail of a group of them ourselves. How dare those crooks skulk so near to Mondstadt. Not to mention that we don't know what their intentions are at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190304,
					"content": "No matter what the reason, they're definitely up to no good. We've redirected a lot of manpower to dealing with them, so I'm afraid we don't have the manpower to deal with your report right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190305,
					"content": "Nonetheless, I'll note your report down. Once we are done with those Treasure Hoarders, I will pass it upwards. Again, thanks for reporting the matter to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051904,
