			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "Still preparing? That's fine. Just head out once you're ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190402,
					"content": "Who's this gentleman, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "I won't tell you no matter how you ask. That's par for course in our line of work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190404,
					"content": "Even when we do reveal any intelligence, we do so because we must.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190405,
					"content": "Well, you can give this a thought: which of the things I just said falls under \"things I revealed because I must\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190406,
					"content": "What's your goal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "That gentleman's goals... I couldn't guess them. But I believe that he also means to protect Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190408,
					"content": "Or should I say that even he probably wouldn't do things like this just for the fun of it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190409
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190409,
					"content": "Hmm, no, no, I shouldn't be speculating about such things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
