			},
			"dialogs": [
				{
					"id": 220210601,
					"content": "Then let's get started. Jewelry Soup requires Snapdragon, Tofu, and Lotus Heads...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210602
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210602,
					"content": "Lotus Heads and Tofu... Luckily, there's still some left. But there's not enough Snapdragon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210603
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210603,
					"content": "Traveler, I'll be handling the ingredients. Just in case, can you please get me three more servings of Fresh Snapdragon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202107,
			"completionStepIds": [
				2202112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
