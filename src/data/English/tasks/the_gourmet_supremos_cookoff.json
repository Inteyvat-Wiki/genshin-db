				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "Hmm. The smell and how it looks... these Three Flavored Skewers should be called Extreme Skewers instead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210302,
					"content": "Extreme... Skewers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "Hehe, I simply mean that it's a perfect dish... Well, would you look at the time. Xudong's Jewelry Soup should be ready now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210304,
					"content": "Of course! Here is my Jewelry Soup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210305,
					"content": "It might be a bit overcooked because I didn't handle the timing perfectly, but the taste should be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210306,
					"content": "Let me taste it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210307,
					"content": "Well, it does have a slightly burnt taste. It's not bad enough to ruin the whole pot, but it is still a flaw in the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210308,
					"content": "Hahaha, I was in a hurry this time. Next time, I'll prepare all the ingredients in advance, so this won't happen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210309,
					"content": "You win this time, but rest assured that I won't make the same mistake next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210310,
					"content": "Seems like you got careless.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "Hahaha... Yeah, I was careless. I'll have to be more mindful next time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210312,
					"content": "By the way Traveler, these are for you. Thank you for helping us all this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210313,
					"content": "Make sure to come next time we compete, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210314,
					"content": "Uncle Munehisa's Extreme Skewers have won the day.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "Extreme Skewers? What does that mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210316,
					"content": "It means that these Tri-Flavored Skewer are of perfect quality.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210317,
					"content": "To have an \"extreme\" pursuit means that your heart can never satisfied with mere \"acceptability.\" Instead, the highest perfection is the goal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210318,
					"content": "Even in cooking, one must have the heart to pursue perfection. This is the only way to become a master of the art of cooking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210319,
					"content": "Ah, I see. Exactly... That's exactly it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210320,
					"content": "That's right!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "The art of the sword and the art of cooking are the same in this regard, and to me, they are both part of the art of existence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210322,
					"content": "Come, Xudong. Allow me to tell you about the \"extreme\" path.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210323,
					"content": "Huh? O—Okay. Just give me a second, I'll be right there. Traveler, here is your payment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210324,
					"content": "Uh... I have no idea how to deal with someone who is so... serious. I guess only Julie can, but she's not here right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210325,
					"content": "Just go get the Extreme Cookery experience.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210327,
					"content": "Huh? I'm coming. Just a second! I'll be right there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
