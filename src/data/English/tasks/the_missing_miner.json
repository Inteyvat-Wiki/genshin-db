			},
			"dialogs": [
				{
					"id": 710570133,
					"content": "You suddenly hear whispering coming from behind you:\\n\"Hee-hee... mushroom meat... Hee-hee...\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "You... Hee-hee, what are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570102,
					"content": "Whoa! This guy looks terrible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570103,
					"content": "#And he just popped up without making a single noise, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570104,
					"content": "Could he be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570105,
					"content": "Probably not.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "Hee-hee, wh—why are you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570107,
					"content": "Have you run out of food as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570108,
					"content": "Are you Uncle He?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "Huh... Huh? Youngster, what are you saying? I can't hear you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570110,
					"content": "I'm asking if you are Uncle He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570111,
					"content": "Oooh, yes. Hee-hee, that's me-hee-hee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570112,
					"content": "Are you also trapped here like me? Did you run out of food too? *sigh* ... How unlucky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570113,
					"content": "Hee-hee, but no worries. I've got some food here... You must be famished... Hee-hee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570114,
					"content": "Now that topic's making Paimon's tummy grumble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570115,
					"content": "This \"mushroom meat\" stuff looks very suspicious!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "Uh... You're right. He seems a bit cooked in the head, and what's with that strange complexion? Paimon bets it has to do with the mushroom meat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570118,
					"content": "Mushroom meat? Hee-hee, yes, it's delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570119,
					"content": "Here, would you like some?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570120,
					"content": "Hahaha, how do you like it? Mm... What—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570121,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570122,
					"content": "The mushroom meat is gone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570123,
					"content": "...Y'know what? Forget it, let's go back to the camp now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570124,
					"content": "I'm not going! I've run out of mushroom meat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570125,
					"content": "Without it, I won't even have the strength to walk. I'm not going anywhere... No mushroom meat... and no food anywhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570126,
					"content": "But with mushroom meat, I can go anywhere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570127,
					"content": "Then, where can we find you some?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570128,
					"content": "Mushroom meat... Oh, hee-hee, I know where it is. Lemme find some for us. Let's fill our tummies and then we'll have the strength to work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570129,
					"content": "It should be around here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570130,
					"content": "#Well, {NICKNAME}, Paimon guesses we can only do as he says.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570131,
					"content": "This does seem to be the only option now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "Mushroom meat... Hee-hee... big mushroom meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570116,
					"content": "Don't just chow on whatever suspicious stuff you find!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
