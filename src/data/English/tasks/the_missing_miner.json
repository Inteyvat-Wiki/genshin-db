			"dialogs": [
				{
					"id": 710570201,
					"content": "He took them all out in a whoosh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570202,
					"content": "Whoa! So strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570203,
					"content": "Hee-hee... Mushroom meat, mushroom meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570204,
					"content": "Ever since I started eating mushroom meat, my lower back pain left me and I got more strength. Hee-hee, it's like I've grown a few years younger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570205,
					"content": "And mushroom creatures are more delicious than mushroom meat! The bigger, the tastier... Hee-hee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570206,
					"content": "Could it be that Uncle He got so strong from eating mushroom meat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}, since it might grant us more power, why don't we give it a whirl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570208,
					"content": "You sure it's \"more power\" that you're after, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "Paimon just wants to see how it tastes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570212,
					"content": "But back on topic, Uncle He should be fine with following us back now, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570213,
					"content": "Mushroom meat... Hee-hee, yummy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570214,
					"content": "Uncle He, let's go back to the camp together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570215,
					"content": "Huh? \"Together\"? Sure, let's have the mushroom meat together. Hee-hee, air-dried mushroom meat can be stored for a long, long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570216,
					"content": "Paimon means we're going back to the camp together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570217,
					"content": "The \"damp\"? What got damp? Oh, what does it matter? I'm fine with it... Hee-hee, now that I've eaten mushroom meat, damp or dry, I can go anywhere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570218,
					"content": "*sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}, let's bring Uncle He back to see Jinwu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570210,
					"content": "Please be less creative with your diet!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "Oh, alright, Paimon gets it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105703,
			"completionStepIds": [
				7105707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105707",
							"2"
						],
						"stepId": 7105707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uncle He",
					"Jinwu",
					"Paimon",
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710570301,
					"content": "Mushroom meat... Hee-hee... A mushroom meal in my tummy, small mushrooms, mushroom creatures, big mushrooms... Hee-hee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570302
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570302,
					"content": "Uncle He? What's happened to your face?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570303
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570303,
					"content": "*sigh*... I knew you were alive! To think that your family even invited me to your funeral! I refused to go, you know. Told them that nothing was certain yet without a body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570304
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570304,
					"content": "Look at your face. It must've been tough for you, being trapped in the mine like that. But anyway, I'm glad that you're still alive!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570305,
					"content": "Being alive is good, yes! Living, breathing mushrooms are delicious! Hee-hee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570306
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570306,
					"content": "Uncle He?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570307
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570307,
					"content": "He was like this when we found him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570308,
					"content": "He wasn't quite all there... and he kept saying that he wanted to eat mushrooms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570309,
					"content": "Mushrooms...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570310
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570310,
					"content": "The Chasm is a dangerous place for ordinary people. Plants and fungi growing here could also be harmful to the human body. That's why Huishan Hall has set strict rules against eating these things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570311
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570311,
					"content": "But Uncle He's been trapped down here all these years with nothing else to eat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570312
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570312,
					"content": "How am I supposed to face his family with him in this state?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570313,
						710570314
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570313,
					"content": "Speaking of mushrooms...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				},
				{
					"id": 710570315,
					"content": "Now that you mention it, Khedive might be able to help. After all, he's a scholar from Sumeru. He must've conducted some research on mushrooms.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570316
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570316,
					"content": "Please wait here. I'll bring him over to check up on Uncle He.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570317
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570317,
					"content": "Mushroom meat... mushroom meat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570318
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570318,
					"content": "*sigh* With how messed up Uncle He is, Paimon's really not sure if he can recover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570319,
					"content": "If he goes back to his family like this, they'll still be pretty saddened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570320,
					"content": "You can't just kidnap me here while I was halfway through my report, Jinwu! I know you're in charge of the team's safety, but you can't just disturb my research like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570321
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570321,
					"content": "I'm seriously considering cutting your budget as they proposed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570322
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570322,
					"content": "Never mind the budget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570323
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570323,
					"content": "Please check on this man here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570324
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570324,
					"content": "It's so itchy inside my earsies... Hee-hee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570325
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710570325,
					"content": "Huh? Who is he? And why does he look like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570326
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570326,
					"content": "#Did you find him, {NICKNAME}? ...Seriously, how are you always able to stumble upon such peculiar events...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570327
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570327,
					"content": "Then... How was he like when you found him?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570328
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570328,
					"content": "You tell Khedive what happened to Uncle He...\\nKhedive performs a careful examination on him.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570329
					]
				},
				{
					"id": 710570329,
					"content": "He's fine. It's not a big deal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570330
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570330,
					"content": "You know how he always complains about the itchiness in his ears? That's because the spores of the fungi have entered his ears.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570331
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570331,
					"content": "Although long-term consumption of this type of fungus — I mean, mushroom — does impair one's sanity, it doesn't hurt the body.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570332
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570332,
					"content": "So you're saying he can recover?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570333
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570333,
					"content": "I've already cleared his body of the fungi and made some medicine to treat his neurological disorder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570334
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570334,
					"content": "He's very likely to recover if given ample rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570335
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570335,
					"content": "I see. Then, about the cost of the medicine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570336
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570336,
					"content": "None of the ingredients are expensive — they're only worth a month's meals at Xinyue Kiosk. It's not a big deal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570337
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570337,
					"content": "Uh... I—I'll figure out some way to repay you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570338
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570338,
					"content": "No need to repay me — as a matter of fact, this incident gives me something new to write in my report.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570339
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570339,
					"content": "Ever since I came across these peculiar mushrooms in The Chasm, I've been curious about the long-term consequences of eating them, but I haven't found a willing assistant yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570340,
						710570342
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570340,
					"content": "An assistant?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570341
					]
				},
				{
					"id": 710570341,
					"content": "I mean, someone whose responsibility is to eat the mushrooms. Everyone seems to have reservations. Although they know that no great harm will come to them, they just don't dare to eat the things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570344,
					"content": "But... given how peculiar The Chasm is, the environment here could be another reason for his symptoms. Anyway, just have him take the medicine and get some rest. He's very likely to recover, even now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570345
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570345,
					"content": "What a relief... I'll bring him up to the surface later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570346
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570346,
					"content": "Once he's recovered, I'll bring him home and inform his friends as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570347
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570347,
					"content": "He's a veteran miner, and an agile one, too. He took very good care of youngsters who were new in the mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570348
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570348,
					"content": "When he went missing a few years back, everyone wondered why Rex Lapis didn't protect him. A good man's life shouldn't have ended that way, they said.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570349
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570349,
					"content": "I'm sure his friends will be much comforted by the news that he's back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570342,
					"content": "\"Test subject\" is more the word, don't you think?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570343
					]
				},
				{
					"id": 710570343,
					"content": "You can say that, but we've studied these mushrooms and come to the conclusion that they won't cause any irreversible damage to either the body or the mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570314,
					"content": "Do you know anyone who does research on mushrooms?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				}
			]
		},
		{
			"id": 7105704,
