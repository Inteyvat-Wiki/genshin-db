			"dialogs": [
				{
					"id": 710571201,
					"content": "My ears aren't itchy anymore... But...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710571202
					],
					"speakerTitle": "Uncle He"
				},
				{
					"id": 710571202,
					"content": "Mushroom meat, *sigh*, where can I find more?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uncle He"
				}
			]
		}
