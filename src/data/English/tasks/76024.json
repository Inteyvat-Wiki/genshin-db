			"dialogs": [
				{
					"id": 760240101,
					"content": "Heh. It's the end of the line for you now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "Huh. This is my first time seeing the Weasel Thief Big Boss up close... Oh, yeah. You've gotta call him Big Boss too, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "Wha... Fat chance Paimon's gonna call some Weasel Thief \"Big Boss\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "You're right. Bad kids can't be bosses, can they? And no one's going to attend their funerals either... if they even hold 'em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Oh, right! I heard Helka say that there are strange people who eat strange meat, such as meat from Weasel Thieves. And there are those who like to collect specimens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "Whether eating them or collecting them, there won't be any need for a funeral afterward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Whoa, Auni... Are you seriously saying all that scary stuff with a straight face?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(This one looks terrified...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "Weasel Thief Big Boss"
				},
				{
					"id": 760240136,
					"content": "Stop! Don't you dare run!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "Huh? It doesn't seem to be running... but waiting for us? Well, let's go see what's up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602402,
