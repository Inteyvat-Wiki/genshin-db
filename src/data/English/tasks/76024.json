							1489.509,
							220.36,
							9700.62
						],
						"pointId": 360700070
					}
				]
			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "Y'know, Paimon's just noticed that all the Weasel Thieves fled toward that little hill over there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "Yeah, and it's something the big guys who trained the Weasel Thieves brought over. The Weasel Thief Big Boss used it to beat the big guys up — sent them rolling and crawling!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "A difficult scene to imagine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Aaanyway, let's go to that hill and investigate. Keep your eyes open for a Weasel Thief ambush, {NICKNAME} — Paimon would rather not roll... or crawl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "If only I'd been there at the time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "Wait, would you have wanted to help? ... No, you just want to watch the mess unfold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602405,
