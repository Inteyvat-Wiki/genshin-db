			"dialogs": [
				{
					"id": 111240101,
					"content": "This tablet was erected by Mountain Shaper. It names Azhdaha as a terrible dragon, and serves as a warning for later generations to stay away from this place... from the seal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240102,
					"content": "It's a shame... There is a fine line between good and evil. If the good and evil within him could be summarized in a single sentence... well, never mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240103,
					"content": "(You gaze quietly at Zhongli as he stands beneath the tree...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "(Amidst the quiet, only the soft sound of the wind can be heard. Time seems to transform into an invisible river, trickling away...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240105,
					"content": "(A fleeting moment, a thousand years in the mortal world. The rocks feel it, and so too does the earth and the gods.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
