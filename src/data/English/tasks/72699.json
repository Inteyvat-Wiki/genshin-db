			},
			"dialogs": [
				{
					"id": 726990101,
					"content": "I greatly look forward to this duel. I wonder what the extent of your skills is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990102,
					"content": "Uh, what are you doing here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "Actually, when I said previously that 4 warriors had joined, I was including myself in that list.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990104,
					"content": "I'm the organizer, yes, but there were just too few participants...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990105,
					"content": "And anyway, I was born for combat! Since there is a mighty foe before me, I must have my duel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990106,
					"content": "...Hehe, I've been waiting to say that for a long time now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990107,
					"content": "Uh, Paimon's not sure this person is right in the head.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726990108,
					"content": "Best not to underestimate him all the same.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "Exactly! Your desire to show no partiality to your foes fills me with respect for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990110,
					"content": "Previously, if I had not looked down on our fourth contestant, I would not have suffered such a terrible defeat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990111,
					"content": "#But the man I am today is not the man I was yesterday! Come on then, {NICKNAME}, let us duel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990114,
					"content": "Let us cross swords.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "Bring it on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726990112,
					"content": "Give me a second to prepare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "I understand. Take your time to prepare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				}
			]
		}
	]
