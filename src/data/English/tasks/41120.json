			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "I pray that everyone remains safe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200102,
					"content": "Something on your mind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "Oh, it's you, Traveler. I suppose you've seen the meteorites too, haven't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200104,
					"content": "Fortunately, none of them landed inside the city, but I'm worried for those who are still outside. It must be a huge mess at the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200105,
					"content": "Traveler, could you please help us warn them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200106,
					"content": "If they're willing, please invite them to seek shelter within the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200107,
					"content": "Got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "Many thanks, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200112,
					"content": "You can look for Lynn first. Perhaps she knows who is and isn't still lingering in the wilderness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200113,
					"content": "Do try to convince her to seek shelter in Mondstadt herself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200114,
					"content": "This... really isn't the time for \"surviving in the wilderness.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200109,
					"content": "Why didn't any of the meteorites land inside the city?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "Perhaps it was just good fortune. Whatever the case, the city of Mondstadt is the safer place to be for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200111,
					"content": "At least, it's better than being outside the city... wouldn't you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112002",
							"2"
						],
						"stepId": 4112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "These conditions do make surviving in the wilderness quite challenging, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200202,
					"content": "Please seek shelter inside Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "Seek shelter? Oh, don't worry about me. I'm always watching my surroundings. I'll be fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200204,
					"content": "That said, why are you still out here? You should head back to Mondstadt — you might get hit by one of those meteorites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200205,
					"content": "Why, yes — on the topic of people still out here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "People still out here? There's a lot of them, actually — why do you ask?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200207,
					"content": "To get them to seek shelter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "Oh, so that's what it is... The Guild actually sent out commissions to that effect. I've notified quite a few people nearby myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200209,
					"content": "Those closer to the city have all gone inside to seek shelter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200210,
					"content": "But we've been unable to get very many adventurers on the case because we're short on help, so there's still quite a few people who have gone unnotified. If you're willing to help, that would be great.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200215,
					"content": "Give me a moment to remember who's still out here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200216,
					"content": "Ah, that's right! I believe Patchi and Doolan are still at the Thousand Winds Temple. I've tried to warn them, but they insisted on continuing their research there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200217,
					"content": "There's also Vind, who's remained at Stormbearer Point all this while. The Guild asked me to look for her a few times, but I was never able to find her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200218,
					"content": "That's all the people who come to mind for now. I guess you can start with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200219,
					"content": "As for me, I'll give the area another sweep and notify anyone I can find once I'm done preparing some food and other necessities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200220,
					"content": "Let's just hope they haven't run off too far, or it'll be hard for them to return to the city even if we do find them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200211,
					"content": "Sister Grace is very concerned about them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "Grace? So you're here on her behest... Actually, the Guild's sent out commissions to that effect, and I've notified quite a few people nearby myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200213,
					"content": "Those closer to the city have all gone inside to seek shelter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200214,
					"content": "But we've been unable to get very many adventurers on the case because we're short on help, so there's still quite a few people who have gone unnotified. If you're willing to help, that would be great.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				}
			]
		},
		{
			"id": 4112003,
			"completionStepIds": [
				4112003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112003",
							"2"
						],
						"stepId": 4112003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "This is no time for research, we should find a place to take cover!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200302,
					"content": "I've said it before, and I'll say it again. I'm not letting this opportunity slip by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 411200303,
					"content": "Excuse me, please seek shelter within Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "This again? Now isn't the time for seeking shelter. These meteorites may yet present us with an opportunity to get deeper inside the Thousand Winds Temple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 411200305,
					"content": "Deeper inside the temple?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "Patchi says that if a meteorite hits the Thousand Winds Temple, we'll be able to follow its path into the temple's inner chambers... or whatever else may be underneath.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200307,
					"content": "But this is wishful thinking. If a meteorite does strike the temple, we wouldn't be able to get away in time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200308,
					"content": "We should really take cover somewhere. And if a meteorite were to hit the Thousand Winds Temple and open a path beyond, couldn't we just come back later and explore it then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200309,
					"content": "But what if someone gets there before we do? If you want to go back, go yourself. I'll wait here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "Patchi the Curious"
				},
				{
					"id": 411200310,
					"content": "But... Alright, then. I'm sorry, Traveler, but I think the two of us will stay here for a while more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200311,
					"content": "Don't worry. If there's any danger, I... I'll settle it myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200312,
					"content": "Oh, that reminds me... There was a person named Schuster who passed this way earlier, looking all shaken up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200313,
					"content": "He asked me for a sip of water, before saying that he had to get to Mondstadt and hurrying off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200314,
					"content": "But he wasn't running in the direction of the city at all — he was headed towards Stormbearer Point instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200315,
					"content": "Perhaps... he might have forgotten the way in his fright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200316,
					"content": "You should also head that way and look for him near Stormbearer Point. I can't imagine what might happen if he runs into some monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200317,
					"content": "I'll keep Patchi company here, and if something really does happen... Um, I'll handle things myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
		{
			"id": 4112004,
			"completionStepIds": [
				4112004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112004",
							"2"
						],
						"stepId": 4112004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200401,
					"content": "Hmm? What brings you here, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200402,
					"content": "Where have you been?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200403
					]
				},
				{
					"id": 411200403,
					"content": "Oh, I'm sorry. I was walking around, watching the ocean, so I probably wasn't all that easy to find... Is something the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200404,
					"content": "Could you please return to Mondstadt to seek shelter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "Seek shelter? Ah, you're referring to those meteorites. I understand, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200406
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200406,
					"content": "W—Watch out! We've got monsters incoming!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
