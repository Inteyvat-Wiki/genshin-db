					"Terrified Schuster"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200801,
					"content": "Agh! Y—You... Oh, you're not a monster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200802
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200802,
					"content": "Excuse me, please seek shelter within Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200803
					]
				},
				{
					"id": 411200803,
					"content": "I—I know that I should! Why, I'm out here notifying people to seek shelter as well. I might have taken a few extra turns, yes, but still—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200804
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200804,
					"content": "Alright, so why are you hiding over here, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200805
					]
				},
				{
					"id": 411200805,
					"content": "I... I'm resting! Something wrong with that? D—Don't you worry about me! Just head back to Mondstadt... or something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200806
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200806,
					"content": "Meteorites and monsters... Does anyone out and about at this time have anything in their braincases at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200807
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200807,
					"content": "Well, are there any other people out and about right now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200808
					]
				},
				{
					"id": 411200808,
					"content": "I was looking for Vind, actually... by which I mean that sister who is always seen around Stormbearer Point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200809
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200809,
					"content": "I searched that entire area, but I couldn't find her, so I went somewhere else to try my luck there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200810
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200810,
					"content": "But I was discovered by a group of crazed monsters instead. Just barely escaped them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200811
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200811,
					"content": "I twisted and turned this way and that, all the way back to Stormbearer Point — still no sign of Vind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200812
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200812,
					"content": "I can only hope that sister's already back inside Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200813
					],
					"speakerTitle": "Terrified Schuster"
				},
				{
					"id": 411200813,
					"content": "Alright, I'm heading back to the city. You should go back as well. This is no time to be taking outdoor strolls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terrified Schuster"
				}
			]
		},
