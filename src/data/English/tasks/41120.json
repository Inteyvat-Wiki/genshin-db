			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200601,
					"content": "Phew... Thank you, that was quite a close call.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200602
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200602,
					"content": "And that's why I asked you to seek shelter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "I'm sorry, but I can't go back right now. These meteorites are strange enough as it stands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200604,
					"content": "In times like this, it wouldn't be surprising if a storm were to churn the seas again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200605,
					"content": "I must keep watch here. If a storm does occur, I must be able to warn the city immediately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200606,
					"content": "Thanks for informing me, though. I'll be more careful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 4112007,
			"completionStepIds": [
				4112007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112007",
							"2"
						],
						"stepId": 4112007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200701,
					"content": "You're back. Have you managed to notify all of them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200702,
					"content": "Yes. None of them want to return right now, though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "They all refused? One wonders what important tasks they must have, that they should feel compelled to stay in the wilderness at a time like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200704,
					"content": "Guess that's the free people of Mondstadt for you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "Haha, that's true. The people of Mondstadt are as free as the wind, indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200706,
					"content": "Still, I do wish that they could rein it in at times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200707,
					"content": "*sigh* The Knights likely have their hands full as well. It's alright — I will think of some other way to convince these people. Thank you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200708
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200708,
					"content": "I pray that everyone remains safe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 4112008,
			"completionStepIds": [
				4112008
			],
