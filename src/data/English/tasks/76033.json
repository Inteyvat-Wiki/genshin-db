			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603302",
							"2"
						],
						"stepId": 7603302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Food-Obsessed Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "Hey, newbie. You can't be making food like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330102,
					"content": "We're making rations for the Ratniki on the island, so we've gotta cook it to their tastes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330103,
					"content": "These dishes won't do at all. First, your heat control's terrible, and second, this stuff doesn't suit our diet. That's gotta change.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330104,
					"content": "You've still got a lot to learn — I suggest starting from our most basic dishes, like Nod-Krai Hot Dogs. Come back and show me once you're done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Food-Obsessed Phantom"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603304",
							"2"
						],
						"stepId": 7603304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Food-Obsessed Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "Mmm, the sausage is nicely grilled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330202,
					"content": "You'd make a half-decent sous chef if you were working in a restaurant outside, I'd say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330203,
					"content": "But we're making meals for every Ratnik on this island. So it's not about how fancy the food is, but whether it's plentiful enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330204,
					"content": "Make the bread thicker. There's not a ton of vegetables right now, and you could also add some meats apart from sausages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330205,
					"content": "You still need more practice! Come back next time and make some Berries and Fried Meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Food-Obsessed Phantom"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Food-Obsessed Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "Mm. The meat's been sliced into sizable chunks, then fried perfectly after that. Not bad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330302,
					"content": "But let me remind you. When making fried meat, you must consider your side dishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330303,
					"content": "It's easy to get stuffed from eating too much meat. That's why the berries are there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330304,
					"content": "Here on this island, we're in charge of everyone's dietary health, so a balance must be struck between vegetables and meat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330305,
					"content": "This dish doesn't have enough such veggies on the side. We can't have that here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330306,
					"content": "You need to practice more. Come back next time and whip up some Lakkaberry Madame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Food-Obsessed Phantom"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603308",
							"2"
						],
						"stepId": 7603308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Food-Obsessed Phantom"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "The chicken's flavorful, and there are sufficient side dishes. You tryin' to make it tough for me to nitpick, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330402,
					"content": "...Heh. Whatever. Not that I was ever looking to find fault with you newbies specifically.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330403,
					"content": "I'm just a chef. I just do my job, and I want to do it well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330404,
					"content": "And to that end, I made all kinds of preparations for the Wild Hunt's arrival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Food-Obsessed Phantom"
				},
				{
					"id": 760330405,
					"content": "But it's a pity... I couldn't send them the finished dishes in time... The food wound up spilled... spilled...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Food-Obsessed Phantom"
				}
			]
		}
	]
}