			},
			"dialogs": [
				{
					"id": 400130101,
					"content": "Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130102,
					"content": "We've finished placing the scales.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "Yay, amazing! Hehehe, it's my turn now, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130104,
					"content": "Yep, we'll leave that mechanism over there to you, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130105,
					"content": "Okay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130106,
					"content": "Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130108,
					"content": "Please make sure you stay safe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "Yep, I got it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130112,
					"content": "Klee, what's wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130113,
					"content": "I—I'm worried... What if Dodo-King really is in here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130114,
					"content": "And what if he doesn't allow me to become Dodoco's family, or if I lose to him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130115,
					"content": "Then Dodoco can't be with me, and Mom will be very sad too... Dodoco is my bestest friend that Mom ever gave me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130116,
					"content": "I—I'm too scared to press it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130117,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130118,
					"content": "#{F#Miss}{M#Mr.} Honorary Knight, can you press the button for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130119,
					"content": "Klee, I can't help you press it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "Why?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130121,
					"content": "Because I have to hold my weapon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "This way, I can protect you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "Yes, we're all here for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130124,
					"content": "Don't worry Klee, we've all got your back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130125,
					"content": "No matter who the enemy is, as long as we're here, you don't have to be afraid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130126,
					"content": "Perfect, I also want to see how strong the enemies on this island really are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 400130127,
					"content": "Go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130128,
					"content": "I'm here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130129,
					"content": "Guys, don't say things like that... What if Dodo-King just wants to invite Klee to his house to chat? Or yes, maybe he already approves of Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130130,
					"content": "Will he really approve of me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130131,
					"content": "Why wouldn't he? You've always tried your best and have done a good job.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130132,
					"content": "Really?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130133,
					"content": "Klee, you're my favoritest friend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "...Alright!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130136,
					"content": "Leave this to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130137,
					"content": "Press, press... press the button!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130134,
					"content": "He will approve of you, I know it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "We'll go with you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				}
			]
		},
		{
			"id": 4001302,
