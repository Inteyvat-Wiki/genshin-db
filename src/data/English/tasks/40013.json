					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara",
					"Jean",
					"Klee",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130301,
					"content": "Honorary Knight, over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130302
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130302,
					"content": "How are the fish?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130303
					]
				},
				{
					"id": 400130303,
					"content": "As we suspected, they were drawn to the crystal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130304
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130304,
					"content": "Catchy catchy fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130305,
					"content": "Ah! No, no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130306,
					"content": "To keep Klee from blowing up the fish to pieces, perhaps it'd be better to let us catch the fish. After all, we're experts at collecting all manner of wildlife!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4001304,
			"completionStepIds": [
				4001311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001311",
							"2"
						],
						"stepId": 4001311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Paimon",
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130401,
					"content": "#{F#Miss}{M#Mr.} Honorary Knight, are you going to place the fish scales?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130402
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130402,
					"content": "Yup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130403
					]
				},
				{
					"id": 400130403,
					"content": "Too bad I can't reach that high...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130404
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130404,
					"content": "Then I'll be your helping hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130405
					]
				},
				{
					"id": 400130405,
					"content": "When you say \"Now,\" I'll place it, alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130406
					]
				},
				{
					"id": 400130406,
					"content": "Okay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130407
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130407,
					"content": "But actually... I don't really understand this part.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130408
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130408,
					"content": "So if you place them for me, it'll be fine! I trust you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130409,
					"content": "Then we'll place the fish scales and let Klee activate the final and most important mechanism.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130410
					],
					"speakerTitle": "Paimon"
