			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "Oh no... how did this happen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370102,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "Traveler, I was just looking for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370104,
					"content": "Do you still remember Konda Densuke? He came to the store several days ago, asking about the fertilizers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370105,
					"content": "Is he satisfied with the fertilizers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "I wouldn't put it in those terms. Strictly speaking, I think Mr. Konda Densuke is feeling lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370107,
					"content": "Lost?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "Well, here's the thing. After your previous promotion, Mr. Densuke did use our fertilizers according to your instructions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370109,
					"content": "However, although the crops did grow well, at the same time... a lot of mushrooms came out of nowhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370110,
					"content": "To be honest, after Mr. Konda told me about it, I am also feeling a bit lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370111,
					"content": "But anyway, it definitely has something to do with the fertilizers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370112,
					"content": "Traveler, could you please go to Konda Village and help Mr. Konda clear those mushrooms out of his fields?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370113,
					"content": "You can count on me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "That I will. I will be doing some research in the store to see what exactly caused this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370115,
					"content": "*sigh* If only Alrani were here. She would definitely have found the cause already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370116,
					"content": "How about we ask Alrani to work on this issue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "If she was here, we would have figured it out quite quickly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370118,
					"content": "But she hasn't returned yet, and I have no idea where she went.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370119,
					"content": "I can only count on you, Traveler. I will be doing some research in the store to see what exactly caused this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
