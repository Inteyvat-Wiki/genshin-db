					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370404,
					"content": "Got all the mushrooms right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370405
					]
				},
				{
					"id": 220370405,
					"content": "There were so many mushrooms, but looks like you did get them all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370406
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370406,
					"content": "Thank you, youngster. I really don't know what I would do without your help. Take this as a token of my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370407
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370407,
					"content": "I have to say that these fertilizers are quite amazing. The mushrooms grew so quickly. If only they could help the crops grow this fast as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370408
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370408,
