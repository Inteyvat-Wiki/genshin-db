				"points": []
			},
			"dialogs": [
				{
					"id": 220370301,
					"content": "Have you cleared them all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370302,
					"content": "All the mushrooms are here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "That's all? I remember there being be a lot more. Did you really clear them all out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370304,
					"content": "Anyway, you have my appreciation, youngster. Take this as payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370305,
					"content": "I have to say that these fertilizers are quite amazing. The mushrooms grew so quickly. If only they could help the crops grow this fast as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370306,
					"content": "When I've got the time, I will surely come buy some more and try them out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
