			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300201,
					"content": "Look at that box. I think it's got the potions in it. Yasmin must have been here already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300202,
					"content": "Huh? The lids of the potions haven't been opened yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300203,
					"content": "Don't uncap them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300204,
					"content": "Wah! There are Fungi emerging behind you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230300205,
					"content": "What? There weren't any before. What's going on?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300206,
					"content": "#Let's not listen to their nagging any longer, {NICKNAME}. Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303004",
							"2"
						],
						"stepId": 2303004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "Whoo, lucky us, huh? Good thing the jar didn't break, or we might be experiencing some serious vomiting right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "Wait. You're not used to the smell? Didn't you make that yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300403,
					"content": "How many times have I explained to you that I added physiological emetics, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "It has nothing to do with whether you are used to it or not, the smell just triggers automatic vomiting in anyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "Seriously, why do I even repeat myself? You won't understand anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "Also, where on earth did Yasmin go? She didn't even sprinkle the potions today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "She must have gone sampling some rare plants she found. Typical Amurta behavior and stuff... I mean, how do you still not know how they're like?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300408,
					"content": "Alright, we'll look after this jar now. Thanks for your help, Traveler. Please take these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Ugh, these Amurta... They're just...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pharez"
				}
			]
		},
		{
			"id": 2303005,
			"completionStepIds": [
				2303005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303005",
							"2"
						],
						"stepId": 2303005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "*cough*, *cough* *cough*... We should be fine here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "Ugh... Blargh... You... This was your handiwork! How are you vomiting too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300503,
					"content": "Ugh... *cough* *cough* *cough*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "I have... explained multiple times that I added physiological emetics!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "It has nothing to do with whether you are used to it. The smell just triggers automatic vomiting in anyone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "Seriously, why do I even repeat myself? You won't understand anyway... Blergh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "Eh? Ladep, Pharez, and the Traveler, too? What brings all of you here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300508,
					"content": "And the potion jar is broken... Was there some kind of monster attack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300509,
					"content": "Judging from how things look... That's probably the case. Did you see any monsters on your way here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
					"content": "No. In fact, I even took some time to sample several plants around here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300511
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300511,
					"content": "That's quite odd... Very odd indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300512
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300512,
					"content": "What's so odd about this? Your potion is what attracted them here, obviously!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300513
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300513,
					"content": "What!? The field tests didn't demonstrate anything like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300514
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300514,
					"content": "Well, now you've seen it with your own eyes, can you be a little more realistic?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300515
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300515,
					"content": "We will... discuss that later. Traveler, thanks so much for your help. Please take this as your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300516
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300516,
					"content": "Where did it go wrong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		}
	]
}