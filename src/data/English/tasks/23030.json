	"talks": [
		{
			"id": 2303001,
			"completionStepIds": [
				2303001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
