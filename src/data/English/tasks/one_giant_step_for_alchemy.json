			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110301,
					"content": "There you are. So, here it is — the <color=#00E1FFFF>Elemental Crucible</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110302,
					"content": "Let's fire it up and see if it works.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
		{
			"id": 4091104,
			"completionStepIds": [
				4091104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4091104",
							"2"
						],
						"stepId": 4091104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "Just need to activate it a few more times...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110402,
					"content": "Traveler! Just who I wanted to see. Do you remember that Elemental Crucible I made?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110403,
					"content": "After you activated it, I was able to gather a fair bit of data from the sidelines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110404,
					"content": "Most importantly, I was able to determine its reliability.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110405,
					"content": "With such reliable apparatus, we will be able to perform even more experiments from now on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110406,
					"content": "If you're willing to help, Traveler, could you help me activate the Elemental Crucible once more?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110407,
					"content": "Gotcha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "Many thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110409,
					"content": "How many experiments would you like to conduct?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "The more the merrier, of course. For a Vision-less alchemist like myself, these brute-force measures are the only way I can do research...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110411,
					"content": "So please help me activate the Elemental Crucible again. I'll be in your debt, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}