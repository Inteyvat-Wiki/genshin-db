	"talks": [
		{
			"id": 4091101,
			"completionStepIds": [
				4091101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4091101",
							"2"
						],
						"stepId": 4091101,
