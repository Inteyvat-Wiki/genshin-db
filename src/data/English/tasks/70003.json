				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "Oh, what am I to do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030102,
					"content": "Do you need help with anything?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "Whenever the Windblume Festival rolls along, people will always offer up all manner of flowers to the Archon statue. Then a gust of wind comes, and off they go, flying every which way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030104,
					"content": "We've had to spend no small amount of effort to clear these withered flowers out. But while I can handle the flowers and leaves in the plaza itself, there's not much I can do about the ones that get onto roofs and the city walls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030105,
					"content": "Definitely not with these knees of mine. They really aren't holding up well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030106,
					"content": "I'll lend you a hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "You would? Oh, that's wonderful. Those withered flowers are pretty obvious. You should be able to see them the moment you get on top of a roof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
		{
			"id": 7000302,
			"completionStepIds": [],
