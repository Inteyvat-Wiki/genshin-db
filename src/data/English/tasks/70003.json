			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lost Cat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "Huh, guess there really was a cat. Wonder why it's over here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030502,
					"content": "Meow... Meeeow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "Lost Cat"
				},
				{
					"id": 700030503,
					"content": "Meow, meow, meow?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "Meow-meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "Lost Cat"
				},
				{
					"id": 700030506,
					"content": "Um, hate to break it to you, but Paimon doesn't think it understands a thing you just said...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030507,
					"content": "Let's get it down from here first. Maybe Aramis knows who it belongs to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030504,
					"content": "Are you lost?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000308",
							"2"
						],
						"stepId": 7000308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "I'm sorry, I don't think I've seen it. If I did, I'm sure I would have had some impression.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030602,
					"content": "Oh, I see... That little darling really loves flowers. I thought that she might have chased them here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030603,
					"content": "Someone looking for a cat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "Meow... Meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "Lost Cat"
				},
				{
					"id": 700030605,
					"content": "Is that... Butterfly? Oh, it really is you! Where have you been?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030606,
					"content": "On the city walls.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "So it's just as I thought, then... Thank you so much. Butterfly here loves to chase flowers. She's been a real headache during this time, what with there being flowers all over the city and all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030608,
					"content": "Thank you once again — your next drink's on me the next time you visit The Cat's Tail. Well, the non-alcoholic ones, at least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030609,
					"content": "Oh, joy, this again...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "Haha... Once again, thank you. See you around, and happy Windblume Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030612,
					"content": "Well, I never — so cats are attracted to the flowers too. What a busy festival... Still, it's good that you found that cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030613,
					"content": "If you'd asked me to climb up there to rescue it, I'm afraid my knees would have given up the ghost...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030614,
					"content": "Well then, thank you for your trouble. Here's a little something for your work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030610,
					"content": "Let's save that tab for next time, I suppose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}