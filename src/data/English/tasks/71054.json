			},
			"dialogs": [
				{
					"id": 710540401,
					"content": "I think hitting the <color=#00E1FFFF>alchemy camp</color> first will do the most damage to them.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540402
					]
				},
				{
					"id": 710540402,
					"content": "Good. We'll put a stop to whatever they're brewing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
