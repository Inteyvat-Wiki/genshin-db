				"objectNames": [
					"Yanbo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540301,
					"content": "I'd suggest that you hit the <color=#00E1FFFF>cooking quarters</color> first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540302
					]
				},
				{
					"id": 710540302,
					"content": "Alright. We'll move their food supply off with all haste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105404,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
