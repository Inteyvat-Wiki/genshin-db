					"Yanbo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540901,
					"content": "Their alchemy equipment is rather amateurish... Most of the tools were rendered unusable after just a few bumps as we were transporting them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540902
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540902,
					"content": "We'll get these things impounded and cleared out as soon as possible. As for the rest down there, we'll need your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105410,
			"completionStepIds": [],
