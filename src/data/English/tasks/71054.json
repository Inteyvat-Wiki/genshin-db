				"points": []
			},
			"dialogs": [
				{
					"id": 710540501,
					"content": "I think hitting the <color=#00E1FFFF>weapons stash</color> first will make our lives easier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540502
					]
				},
				{
					"id": 710540502,
					"content": "Sure. They'll find themselves disarmed soon enough, mark my words!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
