				"objectNames": [
					"Yanbo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710541001,
					"content": "Their bows were actually quite well-maintained. That said, they're ours now. I wonder how many years they'll get just for illegal ownership of these...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710541002
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710541002,
					"content": "We're done on our end. The rest is up to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
