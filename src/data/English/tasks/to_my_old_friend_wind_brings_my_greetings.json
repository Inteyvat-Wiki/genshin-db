						],
						"stepId": 4000408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bei'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040801,
					"content": "Please, oh great one! Heroic Yaksha of Liyue! Divine Adeptus and friend of the people! Have mercy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040802
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040802,
					"content": "The letter is drivel anyway! It's not worth an armed conflict... Just take it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040803
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040803,
					"content": "How about that — Paimon knew it all along!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040804,
					"content": "#Let's see what they wrote, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040805,
					"content": "I see. Then let us send these two to the meeting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040806,
					"content": "The sender may be plotting something truly diabolical for the Lantern Rite. It seems they want to burn down the entire city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040807
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040807,
					"content": "Great, everyone's happy. You're good, we're good. However...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040808
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040808,
					"content": "These two... They don't look anything like us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040809
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040809,
					"content": "It'll be fine. When we're in disguise, no-one will be the wiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040810,
					"content": "It still seems like a long shot to me, but... with the help of an adeptus, hopefully everything will turn out fine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040811
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040811,
					"content": "Well, the safety of Liyue is in your hands now. Good luck — even the Treasure Hoarders don't want to see the city burned to the ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040812
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040812,
					"content": "Then it is settled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040813
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040813,
					"content": "Wait!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040814
					]
				},
				{
					"id": 400040814,
					"content": "*sigh* What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040815
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040815,
					"content": "Next time we meet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040816
					]
				},
				{
					"id": 400040816,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040817
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040817,
					"content": "Let's make it somewhere with a view of the Mingxiao Lantern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040818
					]
				},
				{
					"id": 400040818,
					"content": "...I am not partial to crowded areas. Especially at this time of the year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040819
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040819,
					"content": "Must we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040820
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040820,
					"content": "Yes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040821
					]
				},
				{
					"id": 400040821,
					"content": "...Understood. I shall await your news there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4000409,
			"completionStepIds": [
				4000409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000409",
							"2"
						],
						"stepId": 4000409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bei'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040901,
					"content": "Sorry mate, wrong way. Wherever you think you're going, it's that way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040902
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040902,
					"content": "But isn't that the way to Liyue Harbor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040903,
					"content": "Right. Here is nowhere. So the other way is Liyue Harbor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040904
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040904,
					"content": "If you're looking for somewhere to stay, I suggest you go to the Wangshu Inn. Fair prices, great customer service, and a wonderful view.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040905
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040905,
					"content": "Show us the anonymous letter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040906
					]
				},
				{
					"id": 400040906,
					"content": "...How do you know about the letter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040907
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040907,
					"content": "...Uh, one of Liyue's adepti told us about it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040908,
					"content": "Did they now? I somehow doubt that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040909
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040909,
					"content": "You should not doubt it. It was I who sent them to investigate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040910,
					"content": "Any further questioning, you may direct to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040911,
					"content": "...You're the Vigilant Yaksha!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040912
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040912,
					"content": "Hey, watch your tone of voice! Or do you seriously wanna pick a fight with an adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040913,
					"content": "Uh, okay. It's not that we don't believe you're an adeptus, it's just... Everyone needs to look at the bigger picture here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040914
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040914,
					"content": "As you well know, we Treasure Hoarders are no serious threat to anyone. We're petty criminals, that's all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040915
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040915,
					"content": "So if you are truly an adeptus, please... Show us some mercy, would you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040916
					],
					"speakerTitle": "Crafty"
				},
				{
					"id": 400040916,
					"content": "Of course, if it turns out you're not a real adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040917
					],
					"speakerTitle": "Bei'er"
				},
				{
					"id": 400040917,
					"content": "Then please, don't blame our weapons for treating everyone equally...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Crafty"
				}
			]
		}
	]
}