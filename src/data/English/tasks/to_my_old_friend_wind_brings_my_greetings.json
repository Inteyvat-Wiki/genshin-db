					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040201,
					"content": "#Well, well, long time no see, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040202,
					"content": "Kaeya, we went to the Lantern Rite in Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040203,
					"content": "Ah. Well, how was it? Fun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040204,
					"content": "Delicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040205,
					"content": "Well then, you ought to be looking forward to Mondstadt's Ludi Harpastum. I'm sure it will be to your liking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040206,
					"content": "Get to the point, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "Right, right! Kaeya, there's something we need to tell you about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040208,
					"content": "Hmm... Lantern supplies... Stockpile of wood, paper, and oil... At the very least, it sounds like an accident waiting to happen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040209,
					"content": "Haha, how very amusing. What makes you think I would recognize this symbol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040210,
					"content": "You're amazing at everything and we trust you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "Oh, that about sums it up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040212,
					"content": "Hah. I'm flattered, but don't you think you might be overestimating me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040213,
					"content": "There it is! At last, Kaeya displays the knightly virtue of modesty, perfectly articulated and masterfully delivered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040214,
					"content": "My goodness, your stay in Liyue seems to have sharpened your wit and broadened your vocabulary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040220,
					"content": "Anyway, I digress. This is the symbol of the cross-border criminal organization you know as the Treasure Hoarders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040221,
					"content": "If you are curious to know more, I can put you in touch with an informant on the inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040222,
					"content": "Uhh, didn't you just say the Knights of Favonius don't have dealings with their enemies!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040223,
					"content": "...This is my own personal informant. Nothing to do with the Knights of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040224,
					"content": "A little later, make your way over to Windrise. I'll arrange for the informant to meet you there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040225,
					"content": "Thanks, Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040226,
					"content": "Oh, and remember: \"wine begets wisdom.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040227,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040215,
					"content": "You flirt with the dark side, so you would know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "Exactly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040217,
					"content": "Uh-ah! You should watch what you say, Honorary Knight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040218,
					"content": "What do you mean, flirt with the dark side? The Knights of Favonius certainly does not have dealings with its enemies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040219,
					"content": "That has to do with a certain knightly virtue called \"integrity.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4000403,
