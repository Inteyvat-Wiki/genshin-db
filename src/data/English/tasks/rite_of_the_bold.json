				]
			},
			"dialogs": [
				{
					"id": 750190301,
					"content": "...Is there any room to negotiate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190302,
					"content": "Manqu, look at me. Didn't you hear what Titu said? No one's attempted this feat in almost 500 years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190303,
					"content": "Even if you claim that you've found a possible entrance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190304,
					"content": "Well, so what? You listen well — no human or Saurian companion setting out on this road has ever returned. Not a single one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190305,
					"content": "Um, forgive my directness, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190306,
					"content": "Well, there's our Relics Association guy. And that over there... Is that the chief of the tribe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190307,
					"content": "Hey! Relics Guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190308,
					"content": "#Ah, it's you, {NICKNAME}... Paimon, and {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190309,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "Huh, a Tepetlisaur with a red tail scarf! Mighty energetic, and looks different right off the bat too! Alright, little fella, give us another!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190311,
					"content": "Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#Not bad! So you're {REALNAME[ID(2)|SHOWHOST(true)]}? And I suppose that makes you two the ones it chose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190313,
					"content": "#And haven't you two been the talk of the town lately, {NICKNAME}, Paimon? Manqu here's been mumbling about you constantly, and Titu mentioned you after his return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190314,
					"content": "It wouldn't be a stretch to call your recent deeds \"legendary,\" and you've been a friend to us Children of Echoes thus far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190315,
					"content": "There's no need to thank me too much.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "Haha, quite the phenomenal youngster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190318,
					"content": "And it is in that capacity, Manqu, that I'm telling you — it is not our way to push guests into a fiery pit just to prove a hypothesis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190319,
					"content": "That's not how \"I'd\" treat my guests, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190320,
					"content": "*sigh*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190321,
					"content": "What's all this about, anyway? Something about danger, and a fiery pit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190322,
					"content": "Apologies. Allow me to explain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190323,
					"content": "Remember what we spoke of before? To remove the mark of the Flamelord's Blessing, you need to bring the two required token types to the volcano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190324,
					"content": "One of the tokens is in the ruins beyond the Children of Echoes' land...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190325,
					"content": "There are conditions for getting in, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190326,
					"content": "Based on past custom... Which I only just found on a woven scroll, by the way, since it's been ages since anyone's hankered to try this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190328,
					"content": "If you wish to take your Saurian companion to the volcano and perform a baptism to cleanse the Flamelord's Blessing, you must be recognized by said Saurian's corresponding tribal chief...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190332,
					"content": "#With {REALNAME[ID(2)|SHOWHOST(true)]} being a Tepetlisaurus, this means the chief of the Children of Echoes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190334,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "Isn't that you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190336,
					"content": "#Well, yeah, though I'll be real, I don't know if this rule applies to outsiders. Still, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190337,
					"content": "For hundreds of years, many are those who have tried to free their Saurian companions from what runs in their bloodline... this thing that is more curse than blessing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190338,
					"content": "But not a single one has succeeded... Which is why the tribes gradually abandoned the custom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190339,
					"content": "A zero percent success rate, seriously!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190340,
					"content": "Yes, so perilous is the journey. It's also said that the trial that must be passed before one may obtain the token will test not only the warrior who steps forth, but also the Saurian with them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190341,
					"content": "You are not of the tribes, but I will not have you die in vain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190342,
					"content": "#So please, {NICKNAME}, I suggest that you leave {REALNAME[ID(2)|SHOWHOST(true)]} here with us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190343,
					"content": "If nothing else, I can ensure it will be taken care of until the day it must enter the Night Kingdom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190344,
					"content": "But... If we do that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190345,
					"content": "#...As I said, {REALNAME[ID(2)|SHOWHOST(true)]} will be unable to grow up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190346,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "Looks like that's not what it wants.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "I'll try this all the same.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "Despite the immense peril?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190350,
					"content": "Yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "And what about you, little fella?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190352,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "Hahaha! Unyielding, resolute, yet passionate. Your hearts blaze like fine phlogiston.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190354,
					"content": "Alright then. Then I shall award you the right to embark on the volcanic pilgrimage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190355,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "Alright! Let's go get that first token, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190357,
					"content": "No, not yet. Now that you are qualified, you must undertake a trial of witnesses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190358,
					"content": "Ancient custom dictates that the warrior and Saurian must together obtain the feather of a green quetzal deep in the woods, and offer up a stole of animal pelts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190359,
					"content": "And together, you must win fifty battles for our tribe, and offer up ninety-six gems of high quality...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190360,
					"content": "Uh, I wouldn't be eligible to...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "Oh come now, Manqu, forget it. Where are those traditions even from? Some lost stone age?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190363,
					"content": "The purpose of those formalities was to foster the bond between human and Saurian, and hone their skills — and I've had it with all that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190364,
					"content": "#Anyway, as I see it, neither {NICKNAME} nor {REALNAME[ID(2)|SHOWHOST(true)]} seems to need that sort of proof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190365,
					"content": "#To put things simply, {NICKNAME}, we have here in Natlan a super simple way of dealing with such situations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190366,
					"content": "Fight me, and prove your strength!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190367,
					"content": "Right on!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "Wait? Here? Oh, do you mean we're going on stage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190370,
					"content": "Of course not, haha, the stage isn't a place for tunneling... Our duel grounds are in the mountain to the rear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190371,
					"content": "Come, let's head there — we'll have ourselves a good one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190361,
					"content": "Can you give me a discount on those for Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
		{
			"id": 7501906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7501908",
							"2"
						],
						"stepId": 7501908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manqu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "Again, forgive my directness... But while I am aware of your strength, be careful all the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190602,
					"content": "He obtained no Ancient Name, but Pacal is not to be taken lightly... so long as he's kept his training up these last few years.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190603,
					"content": "If you're ready, then we can begin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
			]
		},
		{
			"id": 7501907,
			"completionStepIds": [
				7501907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
