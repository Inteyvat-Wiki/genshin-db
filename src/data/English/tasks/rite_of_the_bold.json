						],
						"stepId": 7501907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manqu"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1307.468,
