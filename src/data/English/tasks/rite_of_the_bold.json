						"pointId": 8921
					},
					{
						"sceneId": 3,
						"position": [
							-1309.671,
							241.037,
							7740.863
						],
						"pointId": 8922
					},
					{
						"sceneId": 3,
						"position": [
							-1306.066,
							241.062,
							7740.411
						],
						"pointId": 8923
					}
				]
			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "Hehe, nice! We won! Great job us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "Hah... Hoo. I'm not sure even the best warrior in our tribe could take you out... That was a sound defeat indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "Whaddya think, huh, buddy? Looks like we need more training!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "Mmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190706,
					"content": "Quite a spectacular battle, indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190707,
					"content": "Pretty words, Manqu, but is that all you've got? Wanna try your hand too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "No, thank you very much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190709,
					"content": "#Bleh. Boring. Ah, that was a great match! {NICKNAME}... You're the real deal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "I was just warming up, you know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "Hahaha! Cocky, too! Still, I admire that. The strong should also assert their dominance a bit! I mean, what's the point of getting strong otherwise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Haha, looks like you really are well taken care of, {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#Of course! {REALNAME[ID(2)|SHOWHOST(true)]}'s our trusty buddy, y'know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "I am very glad to hear that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "As promised, this is proof of your accomplishment from a tribal chief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "As for its official name — well, Manqu, there's your cue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "The Talisman of Waxaklahun Ubah Kan... the Sage of the Stolen Flame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190721,
					"content": "Yeah, I can never memorize that name, but I do remember that after the Pyro Dragon Sovereign's death, and after the first Pyro Archon was revived from the flames...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "The Sage and the Archon each brought back one token from the volcano, and whomsoever obtains both may enter the cleansing fire within the volcano and purge all curses and calamities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Still, how long did this Sage live anyway, Manqu? I feel like there are tales of him from the tribal era to that of Ochkanatlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "...And even around the Shadow Pin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Well, he was the first human to use phlogiston... and who knows what fate came upon such legendary figures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190726,
					"content": "Some say both his body and spirit turned into phlogiston, becoming one with Natlan's winds, lands, and flowers, granting him the power to hear the prayers for help directed at him by all the tribes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190727,
					"content": "Some say that each era boasted its own successor to the sagely title, passing it on even to this day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190728,
					"content": "But — and excuse my bluntness — these are mostly storytellers' speculations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190729,
					"content": "Haha, watch yourself with those words. You'll make Titu mad again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Alright. My duties are hereby discharged— oh, wait, tradition does demand one more thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "Which is to grant the brave journeying soul and their companions my blessing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Ooh, so that's also a ritual you all do, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Heh, it's just moral support. Don't get your hopes up, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Right, then. {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Here I am, chief.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "May you soar through the mountains like the hardiest bird;\\nMay the wicked tides break upon you as if you were the hardest of stones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "May you fear no hardship, for the world is bound to be full of it.\\nMay you never forget each other, for fate must bring an inevitable farewell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "May you reach your destination and gain what you desire... And most of all, I hope that you shall safely return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "I will.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Eh? Wait, does Paimon get any blessings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Haha! As for you, little Paimon... May you eat and drink well, sleep sumptuously, and see goodly growth!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
					"content": "That sounds pretty good to me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "Anyway, Paimon accepts this blessing — but only just, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190749,
					"content": "Fine by me. In that case, the rite of witnesses is ended. But before you go, let me stress this again: be careful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190750,
					"content": "We know, Pacal. See ya! ... And seeya too, Uchu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190751,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190753,
					"content": "Good luck. See you all soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190746,
					"content": "Can you even grow, goodly or otherwise, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "Of course! Just you wait, Paimon's gonna be as big as three mountains before you know it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190712,
					"content": "You weren't bad either.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "Hahaha, save the commiseration. Now, if I was younger, who knows how that might have gone? Ah, how I wish I could have taken you on then.",
