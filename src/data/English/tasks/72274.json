			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fatui Skirmisher"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Agh, I never thought that our operational plans would be leaked. That's some awful luck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740202,
					"content": "Exactly! Also, I heard that the Teacher was summoned back to Snezhnaya, but that the Watatsumi Island operation is still going ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740203,
					"content": "Don't you think the Teacher is acting a bit too independently? He didn't report this operation to Lady Arlecchino, did he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740204,
					"content": "That's true. This is his own idea. You know what? I've got a bad feeling about this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Fatui Skirmisher"
				},
				{
					"id": 722740205,
					"content": "Are you saying that if we fail, the Teacher's just going to pin all the blame on us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Skirmisher"
				}
			]
		}
	]
