			"dialogs": [
				{
					"id": 705400101,
					"content": "*hiss*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Sir Pouncelot"
				},
				{
					"id": 705400102,
					"content": "*whimper*... The cat is hissing at me, Miss Rosaria! I'm scared!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400103,
					"content": "You should probably give him some space. Get too close, and all that swatting might catch you in the face.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400104,
					"content": "Uh oh, seems like Valerina has run into some more cat-sized trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400105,
					"content": "Looks like the shelter has a new stray...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "Honorary Knight! Cat Whisperer! This big cat just barged in here after Snowball! He must have spotted her when she went out for a walk and followed her all the way back here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400108,
					"content": "Easy, easy. No one's going to hurt you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400109,
					"content": "All those evil things, all those bad people who forced you to do whatever it took to survive... They can't find you here. You're safe within these walls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400110,
					"content": "You're surrounded by good people now. Their constant hovering might get a little annoying, but it's all for your own good. Just relax. A life of leisure isn't a bad thing, you know. You just have to get used to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400111,
					"content": "*hiss*... *whimper*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Sir Pouncelot"
				},
				{
					"id": 705400112,
					"content": "H—He understood all that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400113,
					"content": "Looks like it worked. Hah, smart cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400114,
					"content": "Woah, this cat is waaay bigger than the others. His coloring looks like fresh-squeezed Bulle Fruit juice! And he's wearing a scarf too! Huh, looks like there's some sort of design on it... Oh! It's the symbol of the Knights of Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400115,
					"content": "He deserves a name fit for a knight, then! Hmm, he's pretty feisty. How about \"Sir Pouncelot\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400116,
					"content": "Meow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Sir Pouncelot"
				},
				{
					"id": 705400117,
					"content": "You really do have a way with cats. He looks way more at ease now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400118,
					"content": "Paimon thinks you deserve to take the credit this time. Sir Pouncelot seemed to calm right down after everything you said to him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400119,
					"content": "You're getting much better with them, Rosaria!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "It doesn't matter to me either way. Although... The fact that they're cute doesn't hurt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400122,
					"content": "Let Paimon show you how to put Sir Pouncelot completely at ease! Paimon just needs to work a bit more of her magic, and he'll be as happy as can be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400120,
					"content": "Hopefully you're finding this gig a bit more fun, too!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "There's something almost... dignified about him...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}