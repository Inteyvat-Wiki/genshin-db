	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "...Anyway, so the contaminated region turned out to be a Ley Line effluence deep in the forest. Things are already getting back to normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030102,
					"content": "I see. Thank you for your hard work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030103,
					"content": "Once the excess Ley Line energy dissipates from the air, we should be able to make an announcement for residents to resume their normal activities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030104,
					"content": "This is the stipulated reward. Please accept it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030105,
					"content": "After leaving the Adventurers' Guild, Paimon takes you to a quiet place...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "Is Karkata... going to be sent back to the Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030107,
					"content": "It's already damaged, but Paimon feels sad thinking about it getting disassembled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030108,
					"content": "Me too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "Oh! Then how about we find Tighnari tomorrow and ask him to not do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030110,
					"content": "Paimon really wants to go right now, but Tighnari said that we would \"discuss matters tomorrow.\" We'll probably make him mad if we go now, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030111,
					"content": "Probably.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "Alright then! We'll find Tighnari tomorrow and tell him not to disassemble Karkata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tighnari",
					"Karkata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "Tighnari—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030302,
					"content": "Shh, keep your voice down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030303,
					"content": "The Lilac Daphne, a daphne of the genus Thymelaeaceae, has a strong anticonvulsant effect. It can also be made into an anesthetic powder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030304,
					"content": "Extrapolating from these two data sets, it would be particularly potent against piscine species... Hey, make sure you're getting all this down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030305,
					"content": "Kolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030306,
					"content": "Karkata!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030307,
					"content": "Kalu! Kalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030308,
					"content": "I thought I told you all to keep your voices low. Plants aren't afraid of noise, but your shouting is making my ears ring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030309,
					"content": "Y—You didn't disassemble Karkata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030310,
					"content": "Why would I do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030311,
					"content": "But Paimon thought you said, \"According to the Akademiya's policies\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030312,
					"content": "So that's why you two barged in like barbarians at this hour. Fine, I suppose I wasn't clear enough about this yesterday.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030313,
					"content": "What I meant was, according to the Akademiya's policies, all products of research must be destroyed. That's why we can't let the Akademiya discover that place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030314,
					"content": "So the real reason you stayed back was to...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "Anyway, the first thing I did was repair Karkata. During my time at the Akademiya, I took an elective course at the Spantamad. Who knew it would prove useful one day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030316,
					"content": "We then buried Abattouy together. After organizing the research materials, I kept some as a souvenir, most of it was burned to hide the evidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030317,
					"content": "I'm not with the Akademiya, so what do their policies have to do with me? On the other hand, I am the Forest Watcher of the Avidya Forest. I have a duty to protect all life in the forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030318,
					"content": "All life brought forth in this world has meaning, and Karkata is no exception. If it exists, then it shouldn't be carelessly abandoned or destroyed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030319,
					"content": "Hehe, that's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030320,
					"content": "Kulilu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030321,
					"content": "Wait, you just said \"life form.\" You recognize Karkata as a true living being now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030322,
					"content": "The possibility exists is all. It's hard to explain Karkata's efforts to \"repair\" Abattouy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030323,
					"content": "Abattouy only left behind a small portion of his research. Who knows how many commands he installed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030324,
					"content": "Maybe a conflict between all those commands resulted in this sort of behavior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030325,
					"content": "From a more rigorous perspective, it is impossible to conclude that Karkata is a real life form, but the possibility exists — I am willing to believe in that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030326,
					"content": "Kolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030327,
					"content": "By the way, I'm not interested in continuing research on this subject. I'm just letting it hang out here because this place is relatively secluded.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030328,
					"content": "But as things stand now, it wouldn't be a bad idea to make it my research assistant. At the very least, it can record my experiments.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030329,
					"content": "What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030330,
					"content": "Kalu! Kalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karkata"
				}
			]
		},
