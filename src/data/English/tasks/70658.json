			"dialogs": [
				{
					"id": 706580101,
					"content": "Hello there, have you been enjoying the Windblume festivities?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580102,
					"content": "Thanks to your recommendations, yes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "Hehe, I have another event for you that's quite relaxing. It's called \"Ballads of Breeze.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580105,
					"content": "I'm sure you've seen the bards of Mondstadt. Taking part in this event will allow you to play lovely songs, just like they do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580106,
					"content": "Feel the breath of the wind atop mountains and beside rivers, and put your heart and soul into playing your tune. It's a surefire way to forget all your worries!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580107,
					"content": "But I've got no experience in this field...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "Don't worry. This activity was designed precisely such that those without any performance experience can savor the joys of music.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580110,
					"content": "As long as you can keep up with the hints and the beat, there should be no problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580111,
					"content": "That's reassuring.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "Of course. Happy Windblume Festival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580112,
					"content": "Well, guess I'll give it a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "Will it really sound alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580103,
					"content": "Haven't had time yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				}
			]
		}
	]
