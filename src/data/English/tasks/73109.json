	"talks": [
		{
			"id": 7310901,
			"completionStepIds": [
				7310901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310901",
							"2"
						],
						"stepId": 7310901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "This is strange... It should be around here. Why can't I find it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090102,
					"content": "What are you looking for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "You're... Oh, the Traveler, right? I've heard about you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090104,
					"content": "I'm Javi, a... normal salesperson. I'm looking for the \"Dream Box\" I buried before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090105,
					"content": "That's a strange name... What is in it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090106,
					"content": "Well... If I have to put it into words, it contains my childhood \"dreams to be realized.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090107,
					"content": "Why did you do that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "Hahaha, that was a childhood game I played with friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090109,
					"content": "We each wrote down the most precious dream we had then, and buried it here. We have agreed on a time when we are gonna gather here again and dig our \"Dream Boxes\" out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090110,
					"content": "Now the time comes, but... Seems that I'm the only one remembering the promise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090111,
					"content": "*sigh* That's okay, though... As long as they keep their dreams.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090112,
					"content": "Anyway, I'm coming to dig my box out, so that I can have some closure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090113,
					"content": "But I searched around and found nothing. Could it be that someone took it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090114,
					"content": "Did you leave a mark?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "I remember burying it beside a tree...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090119,
					"content": "A tree? B—But Paimon sees lots of trees here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090120,
					"content": "I didn't expect this as a child, you know. We only set up a tiny sign as a reminder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090121,
					"content": "But it's all gone after all this time, and the trees nearby have totally grown different...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090122,
					"content": "I just got the vague impression that the box was buried somewhere near.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090123,
					"content": "Traveler, could you help me find it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090124,
					"content": "But how?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "I buried the box near a tree, so... let's try digging beside the trees.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090126,
					"content": "Please, lend me a hand, Traveler. I'll pay you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090130,
					"content": "Look at all the trees here. I will never find it without help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090131,
					"content": "Fine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "Hehe, thank you. We'll split, then. I'm staying here, and you can search there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090127,
					"content": "It has already flown away...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "Yes, my dream has flown away, and that's exactly why I'm digging the box out to see my dream back then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090129,
					"content": "Please, Traveler, just a tiny favor here. I'll have your payment ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090115,
					"content": "So your dream has flown away...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "Hahaha... Can't say I disagree, since I can't even remember what I wrote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090117,
					"content": "But even if my dream can fly away, the box cannot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "Javi"
				}
			]
		},
		{
			"id": 7310903,
			"completionStepIds": [
				7310903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310903",
							"2"
						],
						"stepId": 7310903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "Oh no. This isn't my Dream Box.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090302,
					"content": "We've got a box.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "Haha... I've got one, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090305,
					"content": "I even opened it, and found a piece of paper with Ami's name on it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090306,
					"content": "I remember that kid, the daughter of Jahangir, who was always found near the food shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090307,
					"content": "So she dreamed of becoming a florist, who would care for a lot of flowers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090308,
					"content": "That was unexpected. I always thought Jahangir was gonna pass the shop to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090309,
					"content": "Let's see your dream first.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "Oh! I almost forgot, I must take a look at my own dream first...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090312,
					"content": "Lemme see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090313,
					"content": "\"I hope to be a Vanara, and live in the forest forever...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090314,
					"content": "So that's my childhood dream? My goodness, I can't believe that's what I wished for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090315,
					"content": "Come on... Kiddo, being a Vanara won't pay you much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090316,
					"content": "I don't see anything wrong with that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "That's just some childish ideas. For someone at my age, dreams...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090320,
					"content": "Better think about ways to get more Mora, and that's what gives some good sleep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090321,
					"content": "Enough about my boring dream, let's talk about Ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090322,
					"content": "I should definitely do something to make amends to her since I opened her \"Dream Box\" without consent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090323,
					"content": "Well... Let me think, being a florist starts with learning how to plant flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090324,
					"content": "I happened to have a spare flower pot that I can give her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090325,
					"content": "Traveler, do you happen to know somewhere to get some flower seeds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090326,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "I'm counting on you for the seeds, Traveler. See you beside Jahangir's shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090327,
					"content": "Why are you doing this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "Hahaha... Let's just say I'm being spontaneous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090329,
					"content": "I will never realize my dream, because of all the years behind me, and... the fact that I don't actually care about the dream anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090330,
					"content": "But Ami is still young. She can still try to realize her dream.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090331,
					"content": "As a boring adult, gifting her a flower pot is the least I can do. Hope that would show my support and encourage her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090317,
					"content": "Dreams are never good or bad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "Here, your \"Dream Box.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "You got one, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310905",
							"2"
						],
						"stepId": 7310905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ami",
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "Is this... for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090502,
					"content": "I wasn't serious about the box or the paper! So it's alright, you don't need to apologize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090503,
					"content": "Don't worry, this flower pot has no use for me anyway. Please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090504,
					"content": "I've asked someone to find some seeds. They should arrive at any minute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090505,
					"content": "Seeds are coming!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "Huh? When did you arrive? I didn't even notice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090508,
					"content": "Ahem... Ami, you wanted to be a florist, right? You can start with planting these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090509,
					"content": "Thanks... But if I do that beside my dad's shop, bugs might get into the pot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090510,
					"content": "That would be a pity, for the bugs in the pot, and the grown-ups having bugs in their food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090511,
					"content": "But if I move the flowers further, I might forget about them. That's also a pity, for the dying flowers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090512,
					"content": "Besides, dad is always busy, and he never lets me go far...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090513,
					"content": "Um... We can take care of it together, if you want. How about that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090514,
					"content": "Although I could only visit after work, I do have some free time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090515,
					"content": "Great! But dad might say no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090516,
					"content": "Mr. Jahangir and I are basically friends. He should agree if we talk to him together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090517,
					"content": "Okay! I... I want more flowers, then! Sumeru Rose is my favorite! Someday... I'll surround my dad's shop with Sumeru Roses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090518,
					"content": "Good, that's a beautiful dream, little girl. Let's do our best for that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090519,
					"content": "Please save one for me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "Thank you! Lemme think... I want a Sweet Flower, too, and what else...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090522,
					"content": "So the kid is really into flowers. Hope she could stick to that dream...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090523,
					"content": "Hehe... Hope she won't grow up like me, a common and boring guy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090524,
					"content": "Ahem! Thanks for your help, Traveler. Please take this as compensation for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090525,
					"content": "Living with all your heart is more than common.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "Thanks. I'm not complaining, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090528,
					"content": "I was just... having some thoughts after seeing the \"dream\" I've buried.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090529,
					"content": "Alright, I should leave now. Thanks for your help today, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090530,
					"content": "Maybe I should... write down another \"dream\" and bury it back there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090526,
					"content": "Living with all your heart is never boring.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "You can do it!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "Here, the flower seeds.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
		},
