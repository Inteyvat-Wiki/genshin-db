					"nextDialogs": [
						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Thank you, now I can continue to grow flowers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
