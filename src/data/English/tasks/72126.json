			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "Oh no...what now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260102,
					"content": "What happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "Hey...I'm so glad you're here... It's like this, after you gave me the flower seeds, I started planting flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260104,
					"content": "But before I could plant much, a group of monsters suddenly appeared and kept loitering around the place where I was going to plant the flowers. I no longer dare to go over to plant them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260105,
					"content": "If they continue to remain here, they may destroy the place where the flowers were planted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260106,
					"content": "If you don't mind, could you go and get rid of those monsters for me? I... I just want to plant flowers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260107,
					"content": "I'll take care of it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "You said yes? Thank you so much! I'm counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260109,
					"content": "Why are you so determined on growing flowers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "I was thinking, the reason why people don't want to come back to Tatarasuna is because they are worried that this place is no longer suitable for living after the Mikage Furnace incident happened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260111,
					"content": "I can't persuade everyone one by one, but if I can plant a lot of beautiful flowers here again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260112,
					"content": "Maybe it will be enough to convince everyone that Tatarasuna is already safe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260113,
					"content": "And...heh, besides planting flowers, I have no other means to convince people...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260114,
					"content": "So please, please help me to chase away those monsters!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
