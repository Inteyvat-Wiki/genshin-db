			"dialogs": [
				{
					"id": 766530501,
					"content": "Hmm... Should I continue my research or not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530502,
					"content": "What's this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530503,
					"content": "Zip-Zap Spy-Bot Number 1!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530504,
					"content": "Zip-Zap what now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530505,
					"content": "To be precise, this is a testing platform for Zip-Zap Spy-Bot Number 1, the latest stealth robot of Aino's design.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530506,
					"content": "She recently purchased an abandoned cleaning bot from the black market. After modifying it, she created the Zip-Zap Spy-Bot Number 1 you see here today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530507,
					"content": "This platform has simulated several hostile environments to test the robot's ability to maintain stealth under pressure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530508,
					"content": "Why's Aino making this stealth robot again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530509,
					"content": "After the theft of Krum-Clank 70% Sweet, Aino made up her mind, and declared: \"No matter how powerful the foe, we have to rescue our friends!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530510,
					"content": "Then she quickly completed the draft of Zip-Zap Spy-Bot Number 1 and started its development.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530511,
					"content": "According to her plan, once the development is complete, it should be able to infiltrate even the heavily guarded Kuuvahki Experimental Design Bureau with ease to rescue our friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530512,
					"content": "That sounds pretty awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530513,
					"content": "But Aino soon realized that perfecting the plan would take far too long — so she wanted to abandon the idea. As per her calculations, it would be much faster to just turn all of Nod-Krai upside down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530514,
					"content": "I've made up my mind! Since we're taking things nice, chill, and easy, I'll just keep working on Zip-Zap Spy-Bot Number 1! It'll definitely help us save our friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530515,
					"content": "In that case, could we ask you two to assist with the tests?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530516,
					"content": "Based on past statistics, having data provided by other testers as reference will increase Aino's development speed by at least 30%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530517,
					"content": "Count Paimon in! This sounds like fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530518,
					"content": "I'll help too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "Then I thank you both on Aino's behalf. I will grant you access permissions to the platform — from now on, you can use it for any testing you need to conduct.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		}
	]
}