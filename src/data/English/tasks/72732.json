					"Pain-Grocer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "Arataki Gang, I'm here to duel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320102,
					"content": "Oh, what now? Has Grandmaster Hanakado sent another kid to challenge me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320103,
					"content": "Is he running out of people? 'Cause this is some serious bottom-of-the-barrel material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320104,
					"content": "...It's not you I'm after.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320105,
					"content": "Empty vessels make the most noise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320106,
					"content": "#This {M#blond guy}{F#blonde gal}, on the other hand, looks like a strong and able warrior. I take it that {M#he}{F#she}'s the real leader of the Arataki Gang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320107,
					"content": "#Hahaha! Now that's what Paimon calls a good judge of character! Go on, praise {M#him}{F#her} some more!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320108,
					"content": "Hey, hey! What are you two talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320109,
					"content": "#My compadre here is strong, for sure, but {M#he}{F#she}'s just outside help. Make no mistake, there's only ever been one leader of the Arataki Gang, and that is yours truly, Arataki Itto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320110,
					"content": "So should I be called the Oni King's Temporary Right Hand?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "Hey, nice idea! The Arataki Gang may not be the strongest gang in the world, but being a leader would still be pretty cool!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320113,
					"content": "If it's cool with you, Paimon could be called Arataki-for-3-Days-Only Paimon, or Paimon, Temporary Leader of the Arataki Gang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320114,
					"content": "Hey, hey, hey! Don't let your opponent lead you astray! She's clearly just... just trying to sow discord, yeah! Okay? All part of a nefarious plot to turn us against each other!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320115,
					"content": "Just wait till I defeat her boss! She'll be begging to take back her words!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320116,
					"content": "Don't flatter yourself. I don't care about the Arataki Gang's internal affairs. I just want to battle strong opponents!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320117,
					"content": "Let's see just how good blondie here is at beetle fighting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pain-Grocer"
				},
				{
					"id": 727320111,
					"content": "Can't you just let me be the leader for a few days?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}