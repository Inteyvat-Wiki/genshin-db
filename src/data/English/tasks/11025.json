			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110240301,
					"content": "I will remain here for a while. I fear that moments of reminiscence like this can only grow fewer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "I feel a bit bad for the God of Salt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "We did not measure right and wrong during the days of the Archon War in the same manner as we do today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "Of course, as I am now... I only wish that she could have lived in a gentler time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "Won't those relics cause Osial to grow in power?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Though the salt chalice and salt ruler do have power in their own right, they are nothing before Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "If a day comes when he should recover his strength and return... Ha, I believe that even so, he will be defeated once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "What will you do now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "That is a good question. In the past, I might have given you a most specific answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "But now... Yes, I suppose I will continue in my role as a consultant at Wangsheng Funeral Parlor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "But if this journey was to your liking, why don't you come along the next time I am seeking to preserve memories of Liyue's past?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}