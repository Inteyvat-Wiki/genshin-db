						210310502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310502,
					"content": "You beat them all?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310503
					]
				},
				{
					"id": 210310503,
					"content": "Hahaha, that's right. It took quite a lot of work, you know? Ah, I'm just not the young fighter I used to be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310504,
					"content": "I suppose you've defeated the ones on your end as well, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310505,
					"content": "About Xiao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310506
					]
				},
				{
					"id": 210310506,
					"content": "So he did it? But why would he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310507
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310507,
					"content": "Eh. I'm not going to second-guess him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310508
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310508,
					"content": "Whatever the case, thanks for patrolling the area on my behalf. Please take these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
