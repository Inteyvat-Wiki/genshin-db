			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "Agh, I must think of something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310102,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "Ah, it's you. *sigh* I'd rather not talk about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310104,
					"content": "Lately, business at the inn has been getting better and better, and we've had more people coming to stay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310105,
					"content": "Some people are looking for a peaceful time alone, while others bring their families over on trips.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310106,
					"content": "The booming business is a good thing, of course, but the fact remains that many monsters roam the nearby areas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310107,
					"content": "If some child out at play or senior folk out on a stroll were to run into those creatures...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310108,
					"content": "To prevent such incidents from occurring, I have to go out and chase monsters around the inn away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310109,
					"content": "But I am just one man, and they are many...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310110,
					"content": "Traveler, could you lend me a hand? You will be well-paid, I assure you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310111,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "I'm counting on you, in any case. I noticed that there were various monster encampments about with dangerous creatures within them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310116,
					"content": "Also, another group of monsters tiptoed up near the inn and even set up camp there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310117,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310118,
					"content": "You know what? You can leave the more dangerous ones to me. Just help me to clear out the monsters surrounding the inn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310119,
					"content": "We'll meet up back here once all the monsters have been driven out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310120,
					"content": "*sigh* These monsters really are a problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310112,
					"content": "I mean, you're pretty good yourself, aren't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Me? Well... Thank you for the praise, but I'm just passable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310114,
					"content": "And even so, I cannot fight them all by myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
