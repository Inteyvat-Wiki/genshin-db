			"dialogs": [
				{
					"id": 210310201,
					"content": "Huh, not a single clue in sight. Who defeated all these monsters? Was it... another adventurer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210310202,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210310203,
					"content": "But since these monsters have been defeated, let's just go back to Huai'an and tell him the news.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
