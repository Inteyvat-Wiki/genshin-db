			},
			"dialogs": [
				{
					"id": 210310401,
					"content": "You're back. Agh, those monsters were really hard to deal with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310402
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310402,
					"content": "You beat them all?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310403
					]
				},
				{
					"id": 210310403,
					"content": "Hahaha, that's right. It took quite a lot of work, you know? Ah, I'm just not the young fighter I used to be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310404
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310404,
					"content": "I suppose you've defeated the ones on your end as well, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310405
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310405,
					"content": "About the monster camp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310406
					]
				},
				{
					"id": 210310406,
					"content": "They were all defeated... But there was not a soul in the camp?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310407,
					"content": "That's very strange. Did some passing adventurer defeat them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310408,
					"content": "Whatever the case, thanks for patrolling the area on my behalf. Please take these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
