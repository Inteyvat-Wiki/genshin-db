					"content": "...Oh, it's you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310302,
						210310303
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310302,
					"content": "What brings you here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310304
					]
				},
				{
					"id": 210310304,
					"content": "I encountered these monsters by chance and defeated them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310305
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310305,
					"content": "This area is not safe. So...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310306
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310306,
					"content": "I'll be careful.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310307
					]
				},
				{
					"id": 210310307,
					"content": "Right. I have other matters to attend to. See you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310303,
					"content": "Those monsters...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310304
					]
				}
			]
		},
