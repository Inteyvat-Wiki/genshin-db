			"dialogs": [
				{
					"id": 205030601,
					"content": "If you ever find ore in the future, you can always come and see me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030602,
					"content": "Ideally when I'm not busy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030603,
					"content": "You seem to be in a bad mood.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "A blacksmith's work takes focus and concentration. It does not take small talk with customers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030605,
					"content": "When the craft is good, business is good. That's all there is to this trade, and anyone who tells you different is trying to con you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030606,
					"content": "If there's nothing else, I'll carry on with my work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
		}
	]
