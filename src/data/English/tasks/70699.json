			},
			"dialogs": [
				{
					"id": 706990101,
					"content": "Honorary Knight! We're so lucky to have you come and test out the entertainment stalls. It really puts my mind at ease!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990102,
					"content": "This is actually my first time taking part in a development project, so I'm a little nervous. It's kinda frying my brain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990103,
					"content": "All I had to do was put a casing on an existing device. But there were so many design considerations, so many parameters to adjust...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990104,
					"content": "I don't envy Captain Albedo, having to create purpose-built devices from scratch... It must be such a difficult task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990105,
					"content": "I think it's functioning really well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "Wow, uh... Th—Thank you! Thanks, Honorary Knight, that means a lot coming from you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990108,
					"content": "I'll... I'll keep doing my best. Hopefully, I'll get to the point where I can build some useful stuff for the Reconnaissance Company...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990109,
					"content": "Oh, I won a few toys in one of the games. I'd like you to have this one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990110,
					"content": "I have another one the same. Now, whenever I look at it, I'll think of all the encouragement you gave me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990106,
					"content": "Don't be hard on yourself. You can only get better.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
}