				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130101,
					"content": "Oh! You're back already? Sooner than I expected!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130102,
					"content": "You didn't go spilling the beans, did you, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130103
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130103,
					"content": "Does Paimon look that unreliable to you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130104,
					"content": "Hee-hee, I'm kidding. Anyway, looks like they were willing to hand over some keepsakes, so I guess they knew the deal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130105,
					"content": "Nevertheless, when it comes to things like ghosts and ghouls, spirits and souls, the one thing everyone knows is you never know what to expect...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130106,
					"content": "Which explains why they were reluctant to pry and find out the full story. Which is just as well — because if they had attempted to... it would have been too much for me to deal with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130107,
						111130108
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130107,
					"content": "Sounds terrifying.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				},
				{
					"id": 111130109,
					"content": "\"Guard the border between life and death...\" This is Wangsheng Funeral Parlor's most important responsibility. And I'm stricter than most...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130110,
					"content": "So what about us? Does it matter if we cross the \"border\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130111,
					"content": "Of course not. After all, you were caught up in all this already, just like Meng. It's not the end of the world if you catch a glimpse behind the curtain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130112
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130112,
					"content": "And where we're going, don't be surprised at what you may see or what may occur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130113
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130113,
					"content": "All of it exists within the border between the living and the dead, an ordinary place, really. The only special thing about it is that nobody really knows about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130114,
					"content": "Whatever you do, don't get all worked up over nothing, okay? Or else by the time we're out, I'll have to erase your memories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130115
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130115,
					"content": "So, listen to everything I say. Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130116,
					"content": "P—Paimon's scared...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130117,
					"content": "But like Hu Tao says, we're already caught up in this. We'd better see it through to the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130108,
					"content": "I can't tell if you're serious anymore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				}
			]
		},
		{
			"id": 1111302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111301",
							"2"
						],
						"stepId": 1111301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Wu",
					"Mumu",
					"Congzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111122301,
					"content": "Y'know, I just realized... mine's the only item that's been outright purchased. Yours are both handmade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111122302,
					"content": "But yours is worth a lot more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "Little Wu"
				},
				{
					"id": 111122303,
					"content": "Worth in Mora is not what's important here. These things all played a big part in our childhood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111122304,
					"content": "They show that we will never forget our promise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congzi"
				}
			]
		},
		{
			"id": 1111304,
			"completionStepIds": [
				1111304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111304",
							"2"
						],
						"stepId": 1111304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Big G (Memory)",
					"Little Wu (Memory)",
					"Mumu (Memory)",
					"Congzi (Memory)",
					"Meng (Memory)"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130401,
					"content": "It's the Lantern Rite again. Wouldn't it be cool if we got to see the lanterns ourselves one day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130402
					],
					"speakerTitle": "Little Wu (Memory)"
				},
				{
					"id": 111130402,
					"content": "You can make a wish without a lantern, you know. My mom told me — as long as you yell it really loud, your wish will come true in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130403
					],
					"speakerTitle": "Congzi (Memory)"
				},
				{
					"id": 111130403,
					"content": "Yell it? Isn't that... kinda embarrassing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130404
					],
					"speakerTitle": "Big G (Memory)"
				},
				{
					"id": 111130404,
					"content": "As soon as the first person yells, then everyone else just joins in, and nobody feels embarrassed anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130405
					],
					"speakerTitle": "Meng (Memory)"
				},
				{
					"id": 111130405,
					"content": "That's right. Little Wu, you start.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130406
					],
					"speakerTitle": "Congzi (Memory)"
				},
				{
					"id": 111130406,
					"content": "Alright... I—I wish I could open a massive restaurant, with never-ending dishes and snacks, so I could eat Jueyun Chili Chicken every day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130407
					],
					"speakerTitle": "Little Wu (Memory)"
				},
				{
					"id": 111130407,
					"content": "Hahaha, that's your wish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130408
					],
					"speakerTitle": "Mumu (Memory)"
				},
				{
					"id": 111130408,
					"content": "If that's so funny, what's your wish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130409
					],
					"speakerTitle": "Little Wu (Memory)"
				},
				{
					"id": 111130409,
					"content": "To get rich of course! Do big business and make a load of Mora! With Mora, you can do whatever you want and be happy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130410
					],
					"speakerTitle": "Mumu (Memory)"
				},
				{
					"id": 111130410,
					"content": "Yeah, if you get rich you could buy that super expensive toybox.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130411
					],
					"speakerTitle": "Meng (Memory)"
				},
				{
					"id": 111130411,
					"content": "Not just one... One for everyone — no, loads for everyone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130412
					],
					"speakerTitle": "Mumu (Memory)"
				},
				{
					"id": 111130412,
					"content": "Well, if Mumu's gonna be a businessman, then I don't need to earn any money.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130413
					],
					"speakerTitle": "Congzi (Memory)"
				},
				{
					"id": 111130413,
					"content": "Whoa whoa whoa, it's tough getting rich. Don't put all the pressure on me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130414
					],
					"speakerTitle": "Mumu (Memory)"
				},
				{
					"id": 111130414,
					"content": "As for me, I want to learn to make Mingxiao Lanterns, the big kind! And Xiao Lanterns too. I'll be the best artisan around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130415
					],
					"speakerTitle": "Congzi (Memory)"
				},
				{
					"id": 111130415,
					"content": "Yeah, that way we don't need to go to Liyue Harbor to release Xiao Lanterns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130416
					],
					"speakerTitle": "Big G (Memory)"
				},
				{
					"id": 111130416,
					"content": "Anyway, those are our wishes. Meng, Big G, what about you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130417
					],
					"speakerTitle": "Little Wu (Memory)"
				},
				{
					"id": 111130417,
					"content": "Me...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130418
					],
					"speakerTitle": "Big G (Memory)"
				},
				{
					"id": 111130418,
					"content": "Ah, they all disappeared... right when he was about to make his wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130419,
					"content": "It brings back so many memories! That was the last Lantern Rite the five of us spent together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130420
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130420,
					"content": "It's been so long... Everyone's all grown up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130421
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130421,
					"content": "Have all of those wishes really come true?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130422,
						111130423
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130422,
					"content": "They've come true.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				},
				{
					"id": 111130424,
					"content": "We asked each of them for parting gifts for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130425,
					"content": "Little Wu's become a chef, Mumu's a successful businessman, and Congzi makes great Xiao Lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130426,
					"content": "Really...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130427
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130427,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130428
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130428,
					"content": "We've never forgotten our childhood dreams. We've kept them in our hearts as a promise to each other.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130429
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130429,
					"content": "Anyway. Time to release this lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130430
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130430,
					"content": "#Hey {NICKNAME}, take a hint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130431
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130431,
					"content": "Let's give them some space to go over the good old days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130423,
					"content": "We can prove it to you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				}
			]
		},
		{
			"id": 1111305,
			"completionStepIds": [
				1111305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111305",
							"2"
						],
						"stepId": 1111305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130501,
					"content": "\"Take the hint\"? Really? Of all of us, you're the one who needs to learn how to read the room.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130502,
						111130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130502,
					"content": "Don't you need to \"guard the border\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130503
					]
				},
				{
					"id": 111130503,
					"content": "Meng's already crossed the \"border,\" that's the only way to send Big G off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130506,
					"content": "As I explained, Wangsheng Funeral Parlor was, once upon a time, more akin to a doctor's office than an actual funeral parlor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130507
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130507,
					"content": "During the Archon War, piles of corpses covered the wilderness. People were plunged into misery and suffering. Disease was spreading all over the land. Death devastated the world of the living.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130508
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130508,
					"content": "Such were the times when the Wangsheng Funeral Parlor was first established. As humans, its founders were deemed too insignificant to matter, but slowly, they managed to drive away death.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130509
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130509,
					"content": "They must've paid a huge price for that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130510,
					"content": "After generations, Liyue Harbor became a bustling hub of prosperity, luring people with dreams of great fame and abundant Mora. But in the end, some lunatics stirred up the \"legacy\" of the dead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130511
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130511,
					"content": "By that, I mean the remnants of the defeated gods that ravaged the world. I won't go into specifics of that situation, but suffice to say that at its peak, life was on the verge of bringing about its own extinction, while death was coming back with a vengeance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130512
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130512,
					"content": "It took a long, long time, longer than you'd think, to restore balance and reinstate the \"border.\" Without it, Liyue Harbor as we know it wouldn't be here today — neither would the Wangsheng Funeral Parlor, you, or me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130513,
						111130515
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130513,
					"content": "I didn't expect you to be such a storyteller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130514
					]
				},
				{
					"id": 111130514,
					"content": "Hahaha, the previous directors all loved to tell this one, too. Although, if you ask me, I think I tell it best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130517,
					"content": "What you make of my words is up to you. I do hope that most of it flew over your heads, though. The Wangsheng Funeral Parlor is just that, a funeral parlor. Nothing more to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130518,
						111130519
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130518,
					"content": "Maybe it's for the better.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130520,
					"content": "We live in peaceful times, but this harmonious coexistence between life and death should never be taken for granted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130521
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130521,
					"content": "Huh, it's about time. Let's go! Let's take them to \"the place where all begins and all goes to rest\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130522
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130522,
					"content": "What kind of place is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130523,
					"content": "I just mean where we first bumped into each other. I come up with fun names for things sometimes, okay? No need to hound me with questions about every little thing I say!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130519,
					"content": "Won't disagree. It's time to go back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130515,
					"content": "Can you reveal a bit more?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130516
					]
				},
				{
					"id": 111130516,
					"content": "Not a chance! Curiosity can be perilous, you know. Don't forget my warning, the less you know, the better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130504,
					"content": "Your scope of work is nothing like I imagined.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130505
					]
				},
				{
					"id": 111130505,
					"content": "Really? The end result is the same, though. Exactly what I do and how I do it are just minor technicalities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "Hu Tao"
				}
			]
		},
		{
			"id": 1111306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111303",
							"2"
						],
						"stepId": 1111303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130601,
					"content": "Finally! Paimon thought we were gonna be trapped in that weird place forever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130602,
					"content": "That's exactly the point. Trespassers end up running scared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130603
					]
				},
				{
					"id": 111130603,
					"content": "So that's the weird stuff out of the way, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130604,
					"content": "Yep, just dive off the edge here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130605
					]
				},
				{
					"id": 111130605,
					"content": "Wahhhh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111307,
			"completionStepIds": [
				1111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111307",
							"2"
						],
						"stepId": 1111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130701,
					"content": "I think we did everything we could to make you happy, Big G, wouldn't you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130702
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130702,
					"content": "But... if you ever really do become an evil spirit and come back with more nefarious nonsense in mind, I may have to forget our friendship and give you a far less fond farewell...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130703
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130703,
					"content": "I won't, I promise! ...I'm grateful for everything you've done for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130704
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130704,
					"content": "Now that I know that my friends are doing so well, I have no intention to bother them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130705
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130705,
					"content": "I also want to thank you. You made my dream come true, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130706
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130706,
					"content": "So you should also mind my warning, Meng. If you won't let go of the past, I might reunite you two sooner than you think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130707
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130707,
					"content": "How can you say such horrendous things with that smile on your face...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130708
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130708,
					"content": "Hahaha, well then, last but not least, let's say our good-byes to Big G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130709
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130709,
					"content": "See you later, Big G!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130710,
					"content": "Not like that! You won't be \"seeing him later.\" Let's stick to \"good bye\" and such.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130711
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130711,
					"content": "Hahaha, no worries. I'll just take my leave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130712
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130712,
					"content": "I'm sorry. Of all the wishes we yelled that day, only ours hasn't come true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130713
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130713,
					"content": "Don't be bothered by that. No life is without its regrets. You can leave in peace now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130714
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130714,
					"content": "Alright, I'll remember you all... Good bye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130715
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130715,
					"content": "He's gone, then... *sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130716
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130716,
					"content": "I thought that closure would bring me relief, but all I can feel now is... emptiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130717
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130717,
					"content": "So, what was the wish you two made? We didn't have a chance to hear it earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130718,
					"content": "\"After each of us has started a family and built a career, we want both our families to spend the Lantern Rite together.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130719
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130719,
					"content": "That's why I envy my friends so much. Little Wu and the rest, they all had a chance to fulfill their wishes. Mine, however, will remain just a dream...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130720,
						111130721
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130720,
					"content": "Cheer up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				},
				{
					"id": 111130722,
					"content": "That's right. Also, think about this: Everyone gets burnt to ash one day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130723
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130723,
					"content": "So enjoy your life while you can, and when your duty to the living is over, you can meet whoever you want again in the afterlife. Isn't that great?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130724
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130724,
					"content": "Uhhhh... Th—Thank you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130725
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130725,
					"content": "Either way, I don't think I'll ever return to Wuwang Hill. I have a lot of feelings to process.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130726
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130726,
					"content": "No worries, it's a good opportunity for you to go on vacation. Consider your leave approved. Ah, naturally, this doesn't change the terms of our previous agreement. The leave will be unpaid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130727
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130727,
					"content": "Uh... Aren't you forgetting about something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130728,
					"content": "You promised that you'll help us in our search.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130729
					]
				},
				{
					"id": 111130729,
					"content": "I took you to the \"border\" and let you have a look around, didn't I? But based on your reaction, it seems like you didn't find what you're looking for. It's a pity, indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130730
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130730,
					"content": "...The biggest pity of all is your lack of help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130731,
					"content": "Hahaha, I was fishing around on your behalf through the channels that aren't accessible to you. Unfortunately, I didn't find any leads worth pursuing either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130732
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130732,
					"content": "I'll keep my eyes open in case anything crops up. If so, I'll be sure to let you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130733
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130733,
					"content": "You don't sound like you mean it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130734,
					"content": "Hehe, I'm not an expert on tracking down the living. However, if you want me to summon someone from the other side of the \"border\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130735
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130735,
					"content": "Grr, stop saying creepy stuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130736,
					"content": "Relax! I'll help you look for them, you have my word. Tsk, my exquisite sense of humor always goes unappreciated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130737,
						111130738
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130737,
					"content": "Seems like you really like your job.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130739,
					"content": "Haha... I have my reasons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130740
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130740,
					"content": "Reasons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130741,
					"content": "The spirits we saw near the border are the dead that still long for the world of the living.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130742
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130742,
					"content": "But I've never seen any of the previous directors there, not even once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130743
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130743,
					"content": "This means that becoming the Director of Wangsheng Funeral Parlor was the right decision for them and left them with no regrets.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130738,
					"content": "Seems like being a funeral home director really suits you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130721,
					"content": "You still have a lot ahead of you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				}
			]
		},
		{
			"id": 1111308,
			"completionStepIds": [],
