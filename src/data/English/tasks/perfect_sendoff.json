			"dialogs": [
				{
					"id": 111131101,
					"content": "Are you new here? What a coincidence, so am I!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131102
					],
					"speakerTitle": "Zhu Ming"
				},
				{
					"id": 111131102,
					"content": "I can't believe how nice the scenery is! I thought it would be all pitch-black and freezing cold, with no sense of space or time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131103
					],
					"speakerTitle": "Zhu Ming"
				},
				{
					"id": 111131103,
					"content": "Here I can finally work out a lifetime of emotions, it's fantastic. Haha, perhaps I just set my expectations too low.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhu Ming"
				}
			]
