			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Meng",
					"Big G"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130801,
					"content": "Wow, there are even the names of all five of us on it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130802
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130802,
					"content": "Hehe, amazing. Oh, didn't you just say that you release lanterns every year? Do you plan to add more names over the years?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130803
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130803,
					"content": "Like Little Wu's kids and Mumu's wife?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130804
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130804,
					"content": "Actually, I have some good news. Mumu is soon to be a father. He's been talking about nothing else recently. He's excited and nervous at the same time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130805
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130805,
					"content": "Hahaha, I wonder if such a goofball will make a good father.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130806
					],
					"speakerTitle": "Big G"
				},
				{
					"id": 111130806,
					"content": "No, no, no, you'd be surprised how sharp-witted he is now. Let me tell you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Meng"
				}
			]
		},
