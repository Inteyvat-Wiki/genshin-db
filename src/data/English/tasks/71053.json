			"dialogs": [
				{
					"id": 710501401,
					"content": "Let's get to the serious topic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501402,
					"content": "You've done me a big favor the past few days. I really don't know how I can repay you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501403,
					"content": "Considering our amiable collaboration so far, it wouldn't be enough to pay you with Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501404,
					"content": "Actually, if you insist...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "Be serious! Am I so vulgar as to humiliate you with mere gold?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501406,
					"content": "Wouldn't that be a sheer insult to you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501407,
					"content": "Here, take this letter. If you ever run into any trouble or need some help in your future journey in Sumeru, bring it to the House of Purbiruni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501408,
					"content": "We'll spare no effort in helping you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501409,
					"content": "\"Connections are far more precious than gold.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501410,
					"content": "This Sumeru saying rings quite true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		}
