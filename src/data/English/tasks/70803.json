			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Reckless Pallad",
					"Joel",
					"Joserf",
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "Huh? Who is this guy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030102,
					"content": "Is he... Joel's father?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "Oh, you're here, Traveler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030105,
					"content": "Allow me to introduce Joserf. He's Joel's father.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030106,
					"content": "Dad! This is that traveler I was telling you about. The traveler's helped me out loads in the past, and this time we even built a snowman together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030107,
					"content": "Joel has told me everything about you. I can't thank you enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030108,
					"content": "I'm glad you're finally reunited...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "Wow, this is amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030111,
					"content": "Not bad, Pallad, not bad at all! You did great work this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030112,
					"content": "\"This time\"? Did something happen the last time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030113,
					"content": "Uh... You remember the person I said I found the last time on Dragonspine, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030114,
					"content": "After you accompanied me up the mountain and helped me to defeat those monsters, I continued searching the area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030115,
					"content": "During my search, I accidentally tripped and rolled my way down the mountain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030116,
					"content": "You... rolled...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030117,
					"content": "Thankfully, the snow was very thick below. I wasn't hurt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030118,
					"content": "And I was just getting ready to head back when I heard noises at the side... and then someone just popped out of nowhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030119,
					"content": "I didn't realize that this was the person I was looking for at first. In fact, I mistook him for a fellow adventurer in the search party.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030120,
					"content": "But after a few words of conversation, it was clear that he was having memory problems. He didn't even know his own name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030121,
					"content": "The temperature was freezing, and there was no time to deal with all that there and then, so I convinced him to come back to the camp with me and figure everything else out after we got there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030122,
					"content": "We got back to the camp, ran into Joel, and the moment he saw him, he froze for a second, with this completely stunned expression on his face, and then he started crying out: \"Dad! Dad!\" That's when Joserf suddenly started to remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030123,
					"content": "Daddy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030124,
					"content": "Daddy's right here, Joel. Daddy's right here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030125,
					"content": "Joserf, don't you remember anything else at all?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030126,
					"content": "The Boar Princess, feeding the foxes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030127,
					"content": "I'm sorry, I have no recollection. Maybe it's because of the head trauma? I'm not sure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030128,
					"content": "I woke up and found myself covered in blood. My things were gone and there was nothing to indicate who I was or how I got there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030129,
					"content": "I crawled into a cave and settled in for a slow recovery. After my legs and feet were a little better, my hunting skills were what kept me alive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030130,
					"content": "Dad... I was so worried about you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030131,
					"content": "I'm alright now, Joel. Don't cry, daddy's not going anywhere. I'm here to stay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030132,
					"content": "So what's the plan now, Joserf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030133,
					"content": "I... I just want to stay with my family for a while longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030134,
					"content": "It's wonderful that you were able to return safe and sound! I suppose there's our happy ending now, hahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030135,
					"content": "That said, Pallad, you've still got some way to go before your adventuring skills are up to scratch. I mean, losing your footing and rolling down the mountain like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030136,
					"content": "You're having some remedial classes with me once we get back to the Guild, I say!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030137,
					"content": "Huh? B—But Cyrus... I think I kinda made up for my mistakes this time, y'know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030138,
					"content": "No buts! Back to the Guild we go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030139,
					"content": "Guild Master, please!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708030109,
					"content": "I'm glad you're okay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "A gigantic version of Joel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}