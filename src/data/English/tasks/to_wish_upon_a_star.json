				]
			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "Phew! I'd never have made it by myself, thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "So is this the fallen star? If you look at it up close...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "Aaaah! A mysterious power is surging through my body!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "Eh!? Really? Hey, wait a sec, we haven't even found the scattered fragments yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "Speaking of the fragments, are there really clues to them around here? Paimon doesn't see anything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "So, what's next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "We'll have to rely on our raw strength. <color=#00E1FFFF>Hit it with all the might of a Tepetlisaurus</color>, and maybe we'll find out where the missing fragments are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "Brute force can solve most problems! That's what my dad says. But I still haven't awoken my strength, and I don't have my own Saurian either... So you're all I've got.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "What a weird rock.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "It definitely looks peculiar enough... But is Paimon just a bit slow? She doesn't feel any kind of mysterious power from it at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
