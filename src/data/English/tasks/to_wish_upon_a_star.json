					}
				]
			},
			"dialogs": [
				{
					"id": 750210501,
					"content": "That should be all, right? This commission was way easier than Paimon thought it'd be! Still, do miraculous powers like that exist? Paimon was pretty skeptical before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "Want to awaken some hidden powers too, do you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#Of course! Wouldn't it make things really easy if you had, say, a super treasure-seeking ability or the power to just destroy any monster with one punch? C'mon, {NICKNAME}, wouldn't you want that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "I want more poweeer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "Ooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "C'mon, hurry up and put the fragments back on the star! Wow... I wonder what power will awaken? Maybe I'll even ascend to the sky... Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "I'm strong enough as-is. I don't need it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "Eh? But doesn't everyone say that the pursuit of more power is endless?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
