			},
			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME}, do you feel any unbelievable power?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "Not really, no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "The big rock hasn't changed a bit! No mysterious glow, not even sudden shaking or just cracking right open.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "Uh, did we use the wrong incantation? It sounded right to Paimon, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "Still, we occasionally run into situations like this when we're exploring ruins! If you misremember the password or signal, the mechanism just won't respond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Weird... I was told saying that stuff would liberate the hidden power...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "And the person who told me closed their eyes and started moaning in pain soon after they recited it! Not only that, but afterward, he gained a \"magic eye\" that could tell the value of gems!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "Wow, so cool!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "Eh? Sounds kinda dubious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "Oh my! I've finally found you, you silly little goose! How'd you end up out here? Your father's been worried sick about you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211312,
					"content": "I told him I'd go back when it's time to eat! Did he have to tell you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "Still talking back? You two kids down there, don't you tarry either! Who knows what kind of dangers might show up if you dally there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211314,
					"content": "You bring Orqo back up, and explain the situation...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "*sigh* Those are just childish fantasies he was talking about. Sorry you had to get involved in his mischief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211316,
					"content": "He's gotten quite naughty, as nobody really disciplines him. After all, his mother isn't around and his father's eyesight is poor. I try to help out as a neighbor, but I haven't got unlimited energy either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211317,
					"content": "Ohh, so that's it! Paimon knew it! There's no way something like that could be true... Imagine just collecting a few stone fragments and getting mysterious powers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "I'm not being naughty, it's for dad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "Don't be so bird-brained! It's all because you won't listen to those older and wiser. At least you're safe and sound this time, but did you ever stop to think about what would happen if you got into some real trouble someday?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211320,
					"content": "Hmph! Enough. You just behave now and come back with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211321,
					"content": "Fine... But first... Here you go, you two. We did agree. Here's the Mora I promised.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Do take it. We wouldn't want him to be someone who isn't true to their word.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211323,
					"content": "Well, since you put it that way... We won't say no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "Yeah, and maybe I'll need your help in the future! We failed this time, but that doesn't mean we won't succeed next time, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "...Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "You little munchkin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211327,
					"content": "C'mon, Mama Coco. Let's go, my dad's waiting! Thank you both, see you next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Those symptoms sound familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
