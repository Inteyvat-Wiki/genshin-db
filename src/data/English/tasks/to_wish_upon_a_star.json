			},
			"dialogs": [
				{
					"id": 750210101,
					"content": "Hey, what are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "...Whoa! You scared me half to death! What if I fell? How would you pay me back? My hidden powers haven't been awakened yet, you know, I'm just a helpless little child.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "Ah! Sorry, Paimon didn't mean to give you a fright! But... hidden powers? Would you develop some super duper ultimate technique or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "Look, it's called a \"hidden\" power for a reason. If it's hidden, how the heck would I know what it is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "He's got a point.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "Look, let's put all that to the side for now. Can you help me find the star shards? I've saved up quite a bit of pocket money from helping out Mama Coco, and you can have every last Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Well, since you're asking us for help, could you at least tell us your name? By the way, Paimon's Paimon, and this is {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "The name I use now is nothing but a code name, that's all... But everyone calls me Orqo, so you might as well too. Now, about those star shards, will you help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "Though... Just what is a star shard? Doesn't sound like it's something you can come by too easily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "They're shards split off from stars that fell from the sky! As long as you find them and return them to their original spot, you can regain the power that was lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "Look! A fallen star is just down below, so there's gotta be some leads to find star shards down there. C'mon, please gimme a hand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "Okay, okay, we'll help you out this time! Still, though, star shards and lost power and whatnot... That feels like something out of a novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "You've never even heard the story of Qoyllor and Ukuku? My dad's told me it a million times, I've got it completely memorized. I'd be happy to share it with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "But let's go down and take a look together first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "So young, yet so full of baloney.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
		{
