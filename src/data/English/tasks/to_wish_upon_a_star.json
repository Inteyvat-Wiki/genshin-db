			"dialogs": [
				{
					"id": 750210701,
					"content": "Wow! Amazing! You guys found all the star shards!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210702,
					"content": "I've saved up quite a bit of pocket money from helping out Mama Coco. I'll give you every last Mora if you give the shards to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210703,
					"content": "Star shards? What are they for? Uh... And before that, what the heck is a little kid doing out here all alone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210704,
					"content": "...Everyone else calls me Orqo, so you might as well too. Though it's only a codename...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210705,
					"content": "I'm only here to collect the star shards! You guys saw the big rock down below too, right? That's a star, fallen from the sky!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210706,
					"content": "As long as we can collect the scattered shards and return them to it, we can gain the power that was lost... Please, I'm begging you, I really do need these star shards...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210707,
					"content": "Sounds pretty dubious...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "Yeah... But it still counts as a clue, right? Why don't we give it a try and see what happens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210711,
					"content": "Still, though, star shards and lost power and whatnot... That sounds like something out of a novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210712,
					"content": "You've never even heard the story of Qoyllor and Ukuku? My dad's told me it a million times, I've got it completely memorized. I'd be happy to share it with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210713,
					"content": "But let's go down there together first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210714,
					"content": "You and Orqo arrive beside the \"fallen star\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "C'mon, hurry up and put the fragments back on the star! Wow... I wonder what power will awaken? Maybe I'll even ascend to the sky... Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210709,
					"content": "Whoa, that amazing? Okay, I definitely can't give 'em to you now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "Hey, he's just a little kid! Ease up a bit. And even though we don't know if it's true or not, why don't we give it a try and see what happens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				}
			]
		},
