			"dialogs": [
				{
					"id": 210360401,
					"content": "*huff* That was tough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360402,
					"content": "Look at me, making a fool of myself again. I guess I haven't made much progress after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360403,
					"content": "Needless to say, I still need more training. Thank you, Traveler. Please, take these as your reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360404,
					"content": "How are you going to leave Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Well... My current plan is to take the merchant's boat and travel by water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360406,
					"content": "As for my first stop... I'm thinking about Fontaine. I'll probably stay there for a while and make further plans from there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360407,
					"content": "*sigh* I wonder if I'll be able to convince Que'er to travel with me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
