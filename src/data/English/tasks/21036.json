			"dialogs": [
				{
					"id": 210360501,
					"content": "*huff* *huff* How... How could you... run so fast...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360502,
					"content": "You are a slow runner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "I—I concede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360506,
					"content": "Thank you for the demonstration, Traveler. Please, take these as your reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360507,
					"content": "About Que'er...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "*sigh* She still won't talk to me. I—I've run out of ideas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360509,
					"content": "How did this become such a dilemma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360510,
					"content": "About that adventurer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "That adventurer? I met her at the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360512,
					"content": "She told me that she had accepted a commission from the Guild to work in The Chasm. When she heard that I wanted to come in here, she agreed to take me with her without much hesitation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360513,
					"content": "But in exchange, I must help her with her commission. Mostly just to look for things though, nothing too toilsome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360514,
					"content": "It's just... that she's crazily talkative. I had no idea how to deal with people like that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360504,
					"content": "You still need more training.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
					"content": "*huff* You are absolutely right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
