			"dialogs": [
				{
					"id": 210360801,
					"content": "*huff* *huff* How... How could you... run so fast...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360802,
						210360804
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360802,
					"content": "You are a slow runner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360803
					]
				},
				{
					"id": 210360803,
					"content": "I—I concede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360806,
					"content": "*huff* Finally I get to catch my breath. Oh my, never thought it could be so exhausting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360807
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360807,
					"content": "Thank you for the demonstration, Traveler. Please, take these as your reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360804,
					"content": "You still need more training.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360805
					]
				},
				{
					"id": 210360805,
					"content": "*huff* You are absolutely right...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "Sun Yu"
				}
			]
