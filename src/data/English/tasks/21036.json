			"dialogs": [
				{
					"id": 210360901,
					"content": "Cross-country training.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360902
					]
				},
				{
					"id": 210360902,
					"content": "Brilliant! Let's keep to the off-road trails we used before to train.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360903
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360903,
					"content": "The adventurer said that I just need to reach the destination as quickly as possible. But I've never quite been quick enough...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360904,
					"content": "Could you demonstrate how to do it quickly? I'll try my best to keep up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360905,
						210360906
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360905,
					"content": "No problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360908
					]
				},
				{
					"id": 210360908,
					"content": "Anyway, I'll be counting on you then. Let's head to the starting point, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360906,
					"content": "Try not to be left too far behind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360907
					]
				},
				{
					"id": 210360907,
					"content": "I—I'll certainly try. But to be completely honest, I wasn't built a runner in any sense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360908
					],
					"speakerTitle": "Sun Yu"
				}
			]
