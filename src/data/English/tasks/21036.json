						210360611
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360610,
					"content": "You've trained here before?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360613
					]
				},
				{
					"id": 210360613,
					"content": "Thankfully, I met a helpful adventurer. She lent me a hand and, using a \"mutually executable commission\" as an excuse, she brought me in with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360614
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360614,
					"content": "She even helped me organize a training regimen and offered me all sorts of advice... But, at the same time, I have to help her deal with some commissions for the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360615,
					"content": "Ahem... Alright, let's get down to business, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360616
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360616,
					"content": "Here's the thing. I've initiated a training plan for myself that includes fighting monsters and cross-country training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360617
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360617,
					"content": "It's all up to you which one you'd like to help me focus on today, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360611,
					"content": "Didn't know you could train in a place like this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360612
					]
				},
				{
					"id": 210360612,
					"content": "I'm... a bit embarrassed to admit this, but I came here mainly because of the complex terrain and the roaming monsters. I thought it would be a great place to train. The only thing I didn't account for was how hard it was to get here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360613
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360604,
					"content": "Is Que'er still ignoring you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360605
					]
				},
				{
					"id": 210360605,
					"content": "Well... She said she had things to do in the city recently, and she hasn't returned...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360606,
					"content": "I've paid her a couple of visits, but she just sends Zhiruo out to make me go away. She still refuses to see me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360607
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360607,
					"content": "*sigh* I honestly don't know what to say to her now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
