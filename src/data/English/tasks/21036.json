			"dialogs": [
				{
					"id": 210360101,
					"content": "Traveler, we meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "Are you still training here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "Indeed I am. It's just... so much harder than I expected. I don't know if I'm really that weak, or if I've adopted the wrong method...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Anyway, enough about that. The last time when we fought monsters together, your moves turned out to be quite inspirational.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "Traveler, please do me a favor and accompany me for another round of training, will you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "And just like the last time, monster fight or cross-country training? All up to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "Is Que'er still ignoring you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "Well... She said she had things to do in the city recently, and she hasn't returned...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "I've paid her a couple of visits, but she just sends Zhiruo out to make me go away. She still refuses to see me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "*sigh* I honestly don't know what to say to her now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
