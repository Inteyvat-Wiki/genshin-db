			},
			"dialogs": [
				{
					"id": 731053001,
					"content": "Please be safe, Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053002,
					"content": "How was Alrani at Akademiya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "She was quite a diligent kid. Though she always chased weird dead ends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053004,
					"content": "She is more than qualified as a student, and I believe she will be so as a researcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053005,
					"content": "Is it hard for students to get their papers passed at Akademiya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "To be honest, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053007,
					"content": "Paper review is complicated. You have to take into account your research focus, how extensive the references are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053008,
					"content": "Also you should keep in mind any overlap or conflict between others' papers and your own. After your thesis proposal is submitted, you'll still bump into all kinds of difficulties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053009,
					"content": "*sigh* But I have to say, she's exceptionally unlucky...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				}
			]
		},
