			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Niloofar",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Alrani, where did you go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050102,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "Huh, Paimon remembers the name... The young lady who's always writing her thesis? The one we met at Watatsumi Island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050104,
					"content": "Right, she said she left Akademiya for some materials. She should have been back now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050105,
					"content": "But the woman there seems really nervous... let's go ask her about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050106,
					"content": "If Alrani did return to the Akademiya, we might as well stop by and say hello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050107,
					"content": "Greetings. About Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "Are you the Adventurers sent by the Adventurers' Guild!? Did you find Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050109,
					"content": "I know I've been pressing and I'm sorry for that. But she really worries me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050110,
					"content": "Whoa, take it easy. We are not from the Adventurers' Guild. Just passing by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050111,
					"content": "And you are...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "You are not Adventurers? I'm so sorry. I haven't got any news from them. I'm so worried...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050149,
					"content": "You tell the story of what you've been through with Alrani...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "So you are the Traveler Alrani keeps talking about...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050114,
					"content": "I'm Niloofar, researcher at the Akademiya... You could tell, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050115,
					"content": "Be that as I am, I now devote most of my energy to teaching students on research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050116,
					"content": "Alrani is my student. She's been struggling with her thesis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050117,
					"content": "You are... her mentor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Miss Alrani said she had to rewrite many of her papers because they were disapproved by her mentor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050119,
					"content": "Ah, this isn't the time for this. What happened to Miss Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050120,
					"content": "She... went missing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050121,
					"content": "Alrani came back all excited from Inazuma with a paper a while ago, which was about the folk culture of Watatsumi Island...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050122,
					"content": "She took that very seriously.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "I could tell. That paper is well written, and of a high standard in every respect...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050125,
					"content": "But... she submitted the paper too late! I asked her to send me the first draft in advance, but I never heard back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050126,
					"content": "By the time she came back with the full version of her paper, someone had submitted one with exactly the same topic, which had already passed the preliminary review!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050127,
					"content": "I tried in every way to get her to pass the review, but she still didn't make it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050128,
					"content": "Why's that? Miss Alrani started forming ideas for her papers long ago. How come it took so long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050129,
					"content": "Wait... Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050130,
					"content": "The Sakoku Decree!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "Oh no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050132,
					"content": "I've no idea how to break the news to her... I was going to think of a gentler way to let her know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050133,
					"content": "Then a motor mouth out of nowhere just spilled it all to her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050134,
					"content": "Then she went missing. I turned every stone in the Akademiya, and she was nowhere to be found. So I went to the Adventurers' Guild and put out a commission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050135,
					"content": "They found nothing but Alrani's notebook at a place, and there was no sign of her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050136,
					"content": "The Adventurers should still be searching for her everywhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050137,
					"content": "I... I don't know what to do... *sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050138,
					"content": "I'll help look for Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "That's right! We'll start from where they found the notebook!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050142,
					"content": "Really? I can't thank you enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050143,
					"content": "I'll mark the location of the notebook on the map for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050144,
					"content": "Oh, and your payment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050145,
					"content": "We can talk about that later.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "Thank you very much. I'll be waiting here for news from the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050148,
					"content": "Please be safe, Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050146,
					"content": "I'll ask Alrani for that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "Where is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "We'll help look for Miss Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050123,
					"content": "She'd been working hard on it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
			"completionStepIds": [
				7310505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310505",
							"2"
						],
						"stepId": 7310505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gobley",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "Please, have mercy! This is all just a big misunderstanding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050502,
					"content": "I don't think so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "What have you done to Miss Alrani? Spill!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050504,
					"content": "Or... Or we will kick your butt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050507,
					"content": "No, no, please... Please listen to me. You got it all wrong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050508,
					"content": "We wouldn't dare mess with her. We are no match for her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050509,
					"content": "What do you mean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "It's a long story...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050512,
					"content": "We happened to be short of money some time ago, so we and our big sis were expecting to fill our wallet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050513,
					"content": "Pfft, you mean stealing and robbing again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050514,
					"content": "Well... We are Treasure Hoarders... That's kinda what we do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050515,
					"content": "As we were making plans in the camp, we saw a young lady carrying a huge bag coming towards the camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050516,
					"content": "Seemed to us she'd lost her soul. Freaked us all out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050517,
					"content": "Before we got ready to make our move on her, she just plopped down beside the campfire, weeping and throwing a bunch of books into the fire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050518,
					"content": "That was really spooky...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050519,
					"content": "Freaked out by a young lady...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "Sure we are, but it's not like we kill people. We just pick and steal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050522,
					"content": "She got us more puzzled before we even realized what was going on. She threw a bag of Mora and asked us to lock her up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050523,
					"content": "Eh... Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050524,
					"content": "You're not making any sense...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "No one would dare touch her at first... But she wouldn't eat or drink and just kept asking us to lock her up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050527,
					"content": "At last, big sis asked us to make a cage with branches and let her in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050528,
					"content": "That was nice of your big sis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "Well, big sis always has respect for learned folks. She says she'd want to go to school one day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050531,
					"content": "Ahem... The lady's over there, see her yourself if you don't believe me. Big sis must be soothing her now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050532,
					"content": "If you can take the lady out of here, we'd be more than willing to repay you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050529,
					"content": "You were actually being nice to her...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "So did you do what she asked?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "Aren't you the Treasure Hoarders...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "So you do have Alrani with you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "What have you done to Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "Tell us what you know! Or... Or we'll kick your butt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
