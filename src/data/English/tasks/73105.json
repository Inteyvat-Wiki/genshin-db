			"dialogs": [
				{
					"id": 731050801,
					"content": "Traveler! Did you find Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050802
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050802,
					"content": "Yes, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050823,
					"content": "You tell Niloofar what happened and hand her the note...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050803
					]
				},
				{
					"id": 731050803,
					"content": "Narzam? How...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050804
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050804,
					"content": "You know her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050805,
					"content": "Not personally. I heard someone mention her as some weird Treasure Hoarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050806,
					"content": "They say she would ask her victims a question when she plunders them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050807,
					"content": "Literature, Elements, all sorts of stuff. Even brain teasers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050808,
					"content": "If you solve her problem, she will give back everything she looted, plus escorting you back to the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050809,
					"content": "So she's a weirdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050810,
					"content": "What is this... outlaw riddler?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "No one knows. I know this because my mentor once met her in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050813,
					"content": "Her question was: \"What quickly fills an empty room?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050814,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "It's wind! Is Paimon right? It must be wind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Ugh... Candle light?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "My mentor answered, \"Elements are everywhere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050818,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "That's cheating!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Haha. Anyway, Narzam escorted my mentor back to the city and they practically had a goodbye in decorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050821,
					"content": "I wouldn't be so worried if Alrani is with her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050822,
					"content": "But she can't stay there forever. I have to figure out a way to help her with her paper...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050811,
					"content": "What exactly is she up to?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
