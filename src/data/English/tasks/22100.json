			"dialogs": [
				{
					"id": 221000301,
					"content": "How's it coming along? All clear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000302,
					"content": "All clear.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "Great. Thanks a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000304,
					"content": "As promised, here's your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000305,
					"content": "Fingers crossed we're in the clear for a while now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000306,
					"content": "Pardon? Who's the young gentleman? ...That's a question for the boss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
	]
