			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000101,
					"content": "*sigh* Whatever am I going to do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "This location... It's a real challenge to run an inn here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000104,
					"content": "Dihua Marsh means lots of Silvergrass, and where treasure lies, monsters will follow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000105,
					"content": "We're lucky that the Millelith cleared most of them out of the area. Since then it's mostly been fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000106,
					"content": "But inexplicably, they seem to have made something of a resurgence recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000107,
					"content": "I know they would never come anywhere near the inn, but there's no denying they're an eyesore. And if even I think so, I can guarantee my customers will too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000108,
					"content": "Are you free to help? It would be great if you could deal with any nearby monsters for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000109,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "Haha... Ah, I must say I do find your forthrightness refreshing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000114,
					"content": "Anyway. I'm not exactly thrilled to be begging a guest for help like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000115,
					"content": "But please be assured that you will be well compensated for your trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000116,
					"content": "Best of luck, and thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000110,
					"content": "You're stressing out over an eyesore!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "Frankly, yes, their irksome presence is the biggest problem they pose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000113,
					"content": "But some people, such as a certain young gentleman obsessed with peace and quiet, find that simply intolerable. And when something upsets him, it usually ends up upsetting the rest of Dihua Marsh too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 2210002,
			"completionStepIds": [],
