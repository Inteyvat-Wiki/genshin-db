			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200720201,
					"content": "How are the flowers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720202,
					"content": "I'm sorry...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720203
					]
				},
				{
					"id": 200720203,
					"content": "Huh? What happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720204,
					"content": "I broke the containers and flowers by accident...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720205
					]
				},
				{
					"id": 200720205,
					"content": "B—By accident!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720206,
					"content": "Ugh... I specifically picked those flowers out. You can't find such good flowers just anywhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720207,
					"content": "Is Dragonspine so dangerous that even an adventurer like you couldn't keep one container from...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720208,
					"content": "Still, thanks for making that trip for me. Please take these as thanks. Now, if you'll excuse me, I have to go tend to my flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720209,
					"content": "*sigh* Maybe I should try the method that Sara suggested after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007203,
