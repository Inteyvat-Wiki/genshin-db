			},
			"dialogs": [
				{
					"id": 401970201,
					"content": "Awesome! Fancy a <color=#C4D6EAFF>white</color> one?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Cream-flavored, huh? Very traditional, but also... very delicious! Mm-hmm, you have my approval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "Alright then! Now that you're the proud owner of this commemorative map, you can draw as many different flavored mustaches on it as you like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Hehe, sounds like a pretty tasty map. We'll look after it well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "Great! Your satisfaction is our number one priority.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Everything's all in order — now it's time to relax. Forget about work, and just enjoy the park!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
