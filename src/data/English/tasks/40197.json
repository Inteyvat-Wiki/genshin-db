			"dialogs": [
				{
					"id": 401970101,
					"content": "Now that things have reached this point, we should add—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970102,
					"content": "A pinch of salt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970103,
					"content": "A dash of pepper, actually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970104,
					"content": "Ah, brilliant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970105,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970106,
					"content": "You two aren't talking about a new dessert menu by any chance, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970107,
					"content": "Pepper sounds a bit out of place in a dessert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "Not desserts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970109,
					"content": "We're talking about the script!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970110,
					"content": "Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "My dear partner, photographer, rookie director... Our creativity must keep up with the overflowing enthusiasm of our fans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970112,
					"content": "There's no room for dull scripts on my stage! Plot twists should strike the audience like a cloud of pepper, leaving them sneezing in surprise. ACHOO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970113,
					"content": "The same logic applies in catering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970114,
					"content": "I once heard Miss Emilie mention that pepper could be used in perfumes. Perhaps I could find a way to make it work in desserts too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970115,
					"content": "Hmm... A peppery kick to complement the delicate sweetness of cream, perhaps...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970116,
					"content": "Wow, the two of them seem to be working together so well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970117,
					"content": "Paimon's struggling to imagine what a pepper cake would taste like, though!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970118,
					"content": "Well, well, what do we have here? Escoffier's making a new cake?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970119,
					"content": "Yes, and she's peppering in some new ideas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "How exciting! When it's ready, do let me know — I'd love to try it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970121,
					"content": "Is it just Paimon, or does it seem like everyone's even more enthusiastic now that they've finished their work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970122,
					"content": "Why shouldn't they be? When your hard work pays off... that's when you should celebrate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970123,
					"content": "It's like a batch of fresh macarons — you should never let fear of sweetness stop you from adding all the filling you please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970124,
					"content": "After all, if there's ever a time to pile on the sugar, it's when you're making macarons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970125,
					"content": "Pile on the sugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970126,
					"content": "Pile on the sugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970127,
					"content": "...And, why are we piling on the sugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970128,
					"content": "Lepine-Pauline, you're here! Is it ready?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970129,
					"content": "Of course! It all went according to plan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970130,
					"content": "Huh? Were you off on some kind of important task?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970131,
					"content": "I was indeed! Please, accept this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970132,
					"content": "What's this...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "Oh wow! It's a panoramic view of the amusement park, with everyone's illustrations on it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970134,
					"content": "Hehe, since the Film Fantasyland has been such a success, we decided to create a unique souvenir to remember it by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970135,
					"content": "We built this park together, brick by brick. So we decided we'd all contribute to drawing this map together, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970136,
					"content": "To be fair, it was mostly thanks to Miss Lepine-Pauline — she's our expert when it comes to drawing, after all. But we all did our best to leave our own marks too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970137,
					"content": "That's right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970138,
					"content": "#And on top of that, {NICKNAME}, I'm offering you a most special privilege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970139,
					"content": "You get to add a mustache to my portrait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				}
			]
		},
