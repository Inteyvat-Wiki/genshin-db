			},
			"dialogs": [
				{
					"id": 751890401,
					"content": "Whew, that's a wrap — finally! Guess we've got the permit to enter that \"Heart of the Sacred Mountain\" or whatever now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890402,
					"content": "\"No. As I said before, this is merely the permit's empty shell...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890403,
					"content": "\"A device made from a single scale, bereft of any information concerning its owner, cannot be converted into a permit.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890404,
					"content": "\"Otherwise, would it not have become some sort of master key, to be used by any old dragon?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890405,
					"content": "Quickly, bring a dragon of suitable status to the stand!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#Where are we supposed to find a dragon... Hey, wait! Does {REALNAME[ID(2)|SHOWHOST(true)]} count?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890407,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "\"Not... at the moment, no.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890409,
					"content": "Then what do we do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890410,
					"content": "\"Long ago, after the great sovereign entered the Heart of the Sacred Mountain, there were some who had the authority to, yet did not, activate this permit.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890411,
					"content": "\"Perhaps this conspicuous specimen was placed here for that very purpose...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Secret Source Servant"
				}
			]
		},
		{
