					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "\"There it is, the engraving light that can activate the scale. That is the permit...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890602,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "Phew, you can see the whole Sacred City from here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890604,
					"content": "\"Indeed, the shadow of a glorious, unhappy past...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890605,
					"content": "Wrroh... Rawrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "\"You wish to know the final outcome of that trial? Haha...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890607,
					"content": "\"Of course, those who called for sacred judgment knew that the master of all light and flame was simply feigning death, but when the true king, only occasionally clear-minded, made an appearance in the flesh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890608,
					"content": "\"The Thirteen Lords and Three Princes, who before could not stop speaking, hastily withdrew their words, and the whole trial descended into farce, and was thus dissolved...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890609,
					"content": "Rrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "\"Later on, the Three Princes would be slain in battle against humanity, while ten of the Thirteen Lords fell when the Sacred City of Tollan collapsed, with one remaining in Chichen Uctokah...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890611,
					"content": "\"But one lord survives to the present day...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890612,
					"content": "\"Though doubtless not in the form that it would have wished to maintain...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890613,
					"content": "\"Alright. Let us continue into the Heart of the Sacred Mountain. There, all lies buried... including a yearning for the journey's end.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890614,
					"content": "\"My duty shall soon be discharged in full... Chosen of Dragons, if only you could have seen this place in its fullest splendor, its truest beauty...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890615,
					"content": "\"Go, touch the flame-engraved light... Win permission to reach the Sacred Mountain's heart...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890616,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "Awanyu... Huh, gone again! Paimon was just getting used to using that name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890618,
					"content": "Still, the permit to enter the Heart of the Sacred Mountain is ours at last...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890619,
					"content": "Rrroar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "The light on this side... It's gone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
