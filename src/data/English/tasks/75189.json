						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 751890501,
					"content": "\"I knew you would arrive, and so I prepared a welcome of suitable pomp and circumstance...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890502,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "\"Though I know that you are only being polite, I am indeed glad to see you.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890504,
					"content": "Huh, so it's you after all! So, uh, what are you calling yourself this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890505,
					"content": "\"This time, my name belonged to a scribe from the Chamber of Deliberation. In truth, he rarely ever touched quill or ink himself — not since the Secret Source Servants were invented, anyway.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890506,
					"content": "\"Awanyu... You may address me so.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890507,
					"content": "Alright then, Awanyu. So, are you here to help us out with this \"Sacred Mountain Heart Permit\" thing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890508,
					"content": "\"If you are without it, the Astral Assemblages within the Heart of the Sacred Mountain will attack upon detecting any unauthorized entry...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890509,
					"content": "\"...I have extracted records from 'Awanyu.' According to them, the permit required to enter the Heart of the Sacred Mountain has been placed above the Chamber of Deliberation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890510,
					"content": "\"For that cause, I have no choice but to set foot in this place... This congress of arrogant fools, this assembly of those who gloried in their powerlessness.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890511,
					"content": "\"Not to mention a den of pretenders claiming the right to judge their own kin...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Secret Source Servant"
				}
			]
		},
		{
			"id": 7518906,
			"completionStepIds": [
				7518905
			],
