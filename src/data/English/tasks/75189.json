							"2"
						],
						"stepId": 7518902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Secret Source Servant"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751890201,
					"content": "Sounds like you don't like it here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890202
					]
				},
				{
					"id": 751890202,
					"content": "\"And neither would you, were you ever to have been regarded as a criminal.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Secret Source Servant"
				}
			]
		},
		{
