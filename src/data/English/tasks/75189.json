			"dialogs": [
				{
					"id": 751890701,
					"content": "Shadow foe threat detected...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890702,
					"content": "Internal safeguard... Auto-repair mode activated...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890703,
					"content": "Ah! Paimon never imagined there'd be these sorts of mechanisms inside a place like this... Those monsters never stood a chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890704,
					"content": "\"This place was built to outlast the very eons themselves. Not only does it bristle with defenses, but it is even capable of self-repair...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890705,
					"content": "It's so golden and shiny... Paimon wants to touch it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890706,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "\"Haha, it would be best not to... It will not distinguish between 'friend' or 'foe'... It simply consumes everything it touches.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890708,
					"content": "\"...A crass and brutal approach. Hmph, the designs these fools came up with...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890709,
					"content": "Still, we can use it to open the shield covering the permit, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890710,
					"content": "It's worth a shot...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "Anyway... Let's find a way to make this thing ascend, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890712,
					"content": "A serious proposal — a rarity from our dear Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "Grroah, Raowrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "\"Indeed. I, too, did not expect our white herald to have such hidden depths... Such hidden wisdom. A shock, to be sure.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890715,
					"content": "...Paimon doesn't get what you're so shocked about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
