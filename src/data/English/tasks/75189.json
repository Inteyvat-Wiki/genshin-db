			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Secret Source Servant"
				],
				"points": [
					{
						"sceneId": 101,
						"position": [
							300.34,
							56.8,
							-155.137
						],
						"pointId": 89
					},
					{
						"sceneId": 101,
						"position": [
							291.503,
							56.8,
							-149.863
						],
						"pointId": 90
					}
				]
			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "\"Let us go. We shall see where they have hidden the permit...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890302,
					"content": "\"It seems they have left it over there... Did they even think to hide it at all?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890303,
					"content": "\"Still, it seems but an empty shell...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890304,
					"content": "Hey, hey, what's with all these Rifthounds? Gah, that means the permit's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890305,
					"content": "\"Gate security may have been neutralized, allowing them to take advantage of the opening and enter.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890306,
					"content": "W—Wait, what do we do, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890307,
					"content": "\"No matter. We need only activate the Chamber of Deliberation's repair and purification facilities.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Secret Source Servant"
				},
				{
					"id": 751890308,
					"content": "\"They are over there...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Secret Source Servant"
				}
			]
		},
