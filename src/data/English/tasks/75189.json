			"dialogs": [
				{
					"id": 751890101,
					"content": "A dragon judge... Is it just me, or is that familiar somehow?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890102
					]
				},
				{
					"id": 751890102,
					"content": "\"I fear you imagine quite the different beast.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Secret Source Servant"
				}
			]
		},
		{
			"id": 7518902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
