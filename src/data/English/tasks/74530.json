			"dialogs": [
				{
					"id": 745300401,
					"content": "Ah, you're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300402,
					"content": "You seem to be in a good mood, Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "Hehe. I found some awesome ore during this excavation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300405,
					"content": "If polished properly, it could turn into a big, shiny gemstone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300406,
					"content": "That's great!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "Right? To be honest, the dig didn't get off to a good start, and I almost went home empty-handed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300408,
					"content": "But I thought to myself that I should hang on a little longer. So I did, and then I held out a little longer, and a little longer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300409,
					"content": "I don't know how many times I repeated that... but I got it in the end!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300410,
					"content": "I only realized that the sun was setting when I got outside... I wound up digging all day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300411,
					"content": "That's our Kachina, alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "R—Really? I—I... kinda get shy in front of Kameras... I'm not sure this'll go well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300414,
					"content": "But... I'll do my best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300415,
					"content": "You're already doing your best, Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "Okay then! I'll leave it to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300416,
					"content": "You're great just the way you are.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "Let me take a picture of you shining bright!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "Has something good happened?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
