			"dialogs": [
				{
					"id": 6080101,
					"content": "Phew, it's been a while since I unleashed my lightning during Windblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080102,
					"content": "It happen a lot before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080103,
					"content": "Unleashing lightning on people? Haha, no, no. Once in a while, maybe. It sure feels good to let loose, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080104,
					"content": "Hah, my old Professor even wrote to me about that a few days ago. Of course, I made sure to emphasize that I always \"treat others with kindness.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080105,
					"content": "It's only natural for a student to inherit their teacher's ways, after all, and mine was a gentle old man from the Spantamad school.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080106,
					"content": "So, you see? This time, I only used gentle methods of electrocution. So gentle, even Jean would have no reason to intervene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080107,
					"content": "Huh, gentle electrocution...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080108,
					"content": "You seem to be in good spirits, Miss Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6080109,
					"content": "Ah, well, it's good to move about every once in a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
