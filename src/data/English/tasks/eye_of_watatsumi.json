			"dialogs": [
				{
					"id": 721450101,
					"content": "\"...They say that Omikami's envoy had three eyes: one for the 'soul,' one a 'mirror,' and the last the 'truth'...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Ancient Stone Tablet"
				},
				{
					"id": 721450102,
					"content": "\"...From the depths it arose, from the <color=#00E1FFFF>south</color>, o'er the <color=#00E1FFFF>north</color>, and all about the <color=#00E1FFFF>western</color> mound...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Ancient Stone Tablet"
				},
				{
					"id": 721450103,
					"content": "\"...The three eyes shone mercilessly to ward off the dragon's heir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Ancient Stone Tablet"
				},
				{
					"id": 721450104,
					"content": "Paimon... knows all these words... but none of them mean anything when strung together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721450105,
					"content": "It doesn't look like there are any clues around here either, so why don't we try using <color=#00E1FFFF>Elemental Sight</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
