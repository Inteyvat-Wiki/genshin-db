			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#Over here, {NICKNAME}, over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570202,
					"content": "Remember this place? It's where our journey began.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570203,
					"content": "We've been to so many places since then! Time really flies, huh... Just thinking about it makes Paimon kinda emotional. Ooh, she could write a poem right now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570204,
					"content": "Please, go right ahead, O great bard Paimon~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "Pfft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "Oh, don't interrupt. Let Paimon think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570207,
					"content": "Ah, vast Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570208,
					"content": "How far have we traveled, yet not seen your full breadth!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570209,
					"content": "(Remain silent.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "That didn't rhyme at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "Ah! Ah... Huh, and the thought's gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570212,
					"content": "Hahahaha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "Do you mean to reflect on how tough this journey's been?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "Yeah, yeah, laugh it up. Paimon's used to it by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570215,
					"content": "That's right! Hehe, you sure know Paimon well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570216,
					"content": "But seriously, it's easy to forget where we started after all this traveling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570217,
					"content": "For example, Paimon can't quite remember what Sweet Madames taste like nowadays, and that was one of her favorite dishes, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570218,
					"content": "That's why Paimon bought this album in the first place, to take pictures of the places we've been and the people we've met.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570219,
					"content": "\"The end is close once we get back to where we started.\" That happens pretty often in light novels and films, doesn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570220,
					"content": "That's why we're taking a picture here. Not to feel all sad and stuff, but 'cause we hope to always remember the road we've taken, all the better to tread the road ahead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570221,
					"content": "Have you been eavesdropping on my conversations with Kazuha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "What? Paimon is evolving!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "Well... Yeah, Paimon was listening when you and Kazuha were chatting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570224,
					"content": "C'mon, we were trying to create an atmosphere here — and now it's all gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570225,
					"content": "Don't worry, I understand what you mean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "We'll forge ahead.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "Hehe, sure, as long as you get it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570228,
					"content": "Alright! Your model for this picture is going to be Teyvat's number one guide! So, what pose would you like to go for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570101,
					"content": "Hey, wait a moment. Where's the Kamera Paimon lent you? Let's check real quick — you'd better not have lost it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
