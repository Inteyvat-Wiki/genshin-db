					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570231,
					"content": "Just take up a casual pose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570232,
					"content": "Yup yup! How's this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570233,
