			"dialogs": [
				{
					"id": 711170401,
					"content": "Huh, this stone tablet seems to say that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170402,
					"content": "As long as one throws Raw Meat into the river, we can summon old friends we haven't met in a while?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170403,
						711170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170403,
					"content": "Wait, you can read those inscriptions?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170404
					]
				},
				{
					"id": 711170404,
					"content": "Hey, don't you underestimate Paimon... You can just decipher it using the stuff you can already read!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170405,
					"content": "Like so — Paimon can only read the last two lines, so there's no way she's wrong about what it means!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170408,
					"content": "Anyway, let's just toss the Raw Meat in. Maybe an adeptus really will show up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170406,
					"content": "Uh, it's probably more about throwing the food to memorialize a friend...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170407
					]
				},
				{
					"id": 711170407,
					"content": "Really? ...Well, Paimon thinks her interpretation is correct, too!",
