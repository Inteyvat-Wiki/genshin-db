					{
						"sceneId": 3,
						"position": [
							-1372.812,
							169.291,
							7665.692
						],
						"pointId": 350400242
					},
					{
						"sceneId": 3,
						"position": [
							-1373.609,
							169.233,
							7665.231
						],
						"pointId": 350400243
					}
				]
			},
			"dialogs": [
				{
					"id": 755050101,
					"content": "Hey, Xilonen! Didn't expect to see you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050102,
					"content": "Hey there, Traveler, Paimon! What, is it so weird to see me at my own home?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050103
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050103,
					"content": "Well, no, but Paimon thought you'd have found a beautiful tree to get a few days' shut-eye in by now since we just solved such a big problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050104,
					"content": "Haha, I'd love to, but everyone's been busy with the reconstruction. It'd feel wrong to slack off at a time like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050105,
					"content": "So this is where you've decided to contribute?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050106
					]
				},
				{
					"id": 755050106,
					"content": "Here, let me show you something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050107,
					"content": "Wow! What a pretty jewel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050108,
						755050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050108,
					"content": "Looks very valuable.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050109
					]
				},
				{
					"id": 755050109,
					"content": "Yes, but that's not all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050112,
					"content": "This is a Phlogiston Honey Pearl with peculiar patterning that's been making the rounds recently in the market. They're usually produced by Phlogiston Aphids. Pretty common, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050113,
					"content": "But these oddly patterned ones are both novel and scarce, making them quite expensive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050114
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050114,
					"content": "Paimon gets it! That's just like how we love treasure chests that have awesome-looking patterns on them too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050115,
					"content": "Hehe, so I bought a few for my collection, and guess what? After a few days, the potted plant I was raising nearby had withered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050116,
					"content": "I didn't think much of it at first. I mean, I don't know the first thing about growing plants anyway. Later, however, I heard Kachina say that some people got sick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050117,
					"content": "Most of them were customers of Cheven's gemstone shop. Even Cheven herself proved no exception.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050118,
					"content": "Huh? Wait... Did it all have something to do with this gem, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050119,
					"content": "I thought so too, and so I smashed one open... and discovered that it contained some Abyssal energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050120,
					"content": "Low-concentration, of course, and isolated by the outer shell of the honey pearl itself — which made it almost undetectable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050121,
					"content": "What about the victims? How are they doing now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050122
					]
				},
				{
					"id": 755050122,
					"content": "No need to worry. The low concentration resulted in rather minor maladies, with most being sleepy or being prone to exhaustion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050123,
					"content": "It hasn't had any effect on the more fit, like myself or Kachina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050124
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050124,
					"content": "Phew... And here Paimon thought this might be a sticky situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050125,
					"content": "Sticky? Like the honey in Honey Pearls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050126
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050126,
					"content": "I'd bet Paimon was thinking \"sticky like Slimes\" instead.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050127
					]
				},
				{
					"id": 755050127,
					"content": "Hehe, you know it! And fortunately for us, this problem's only a threat to ordinary people, just like Slimes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050128,
					"content": "Heh, you two really understand one another.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050129
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050129,
					"content": "We totally do! Still, we've met lots of people scared stiff by Slimes, so it's not like we can ignore it just because it isn't dangerous for us, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050130,
					"content": "Exactly. I already explained the situation to our Chief, and asked him to collect and destroy all the strange Honey Pearls on the market.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050131
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050131,
					"content": "But we still need to attack this issue at the source.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050132
					]
				},
				{
					"id": 755050132,
					"content": "My sentiments exactly. Like I said, Phlogiston Honey Pearls are produced by Phlogiston Aphids. If anything is the source of the problem, it'll be them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050133
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050133,
					"content": "I went to look for Kinich, since he's got the better head for investigating between us. Yesterday, he sent word that he found Aphids with Abyssal contamination.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050134
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050134,
					"content": "There are also traces of their presence near the Scions of the Canopy and the People of the Springs. Right, and Kinich also notified Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050135
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050135,
					"content": "However, they're not exactly gemstone enthusiasts, so the problem didn't affect them as much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050136
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050136,
					"content": "Hmm... Looks like there are all sorts of lingering Abyss-related issues, huh? Guess we've gotta be patient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050137,
					"content": "How do you plan to deal with the Aphids?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050138
					]
				},
				{
					"id": 755050138,
					"content": "Catch 'em first. We can still purify this level of Abyssal contamination, we shouldn't need to harm the Aphids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050139
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050139,
					"content": "Kinich has marked out places where they gather, and I'm heading to a spot near our tribe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050140
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050140,
					"content": "Would you like to come along, by the way? A little bug-catching sounds like fun, doesn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050141
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050141,
					"content": "I'd have invited Kachina, but unfortunately, she's already occupied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050142,
						755050146,
						755050148
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050142,
					"content": "Are we there so you can slack off?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050143
					]
				},
				{
					"id": 755050143,
					"content": "Hah! Do I look like I'm going to lie down and watch you from a tree? We'll be working together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050144
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050144,
					"content": "Just kidding. Let's go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050145
					]
				},
				{
					"id": 755050145,
					"content": "Glad to have you! Would've been a boring trip otherwise. Let's head off, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050146,
					"content": "I'm game.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050147
					]
				},
				{
					"id": 755050147,
					"content": "Glad to have you! Would've been a boring trip otherwise. Let's head off, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050148,
					"content": "Nah, seems like a boring gig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050149
					]
				},
				{
					"id": 755050149,
					"content": "Ugh, guess it's crushing boredom for me, then... Sure you don't wanna come? I was planning on giving you a little something for your time, you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050150
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050150,
					"content": "Ooh! There's pay? What is it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050151,
					"content": "Shiny, shiny stuff. Pretty, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050152
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050152,
					"content": "#Mora! It's gotta be Mora! C'mon, {NICKNAME}, are we gonna pass up a chance to make some money?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050153,
						755050155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050153,
					"content": "Alright, I was just kidding earlier. Let's go!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050154
					]
				},
				{
					"id": 755050154,
					"content": "Haha, fine by me. Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050155,
					"content": "Well, guess we'll do it for the Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050156
					]
				},
				{
					"id": 755050156,
					"content": "Haha, fine by me. Let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050110,
					"content": "Something looks off.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050111
					]
				},
				{
					"id": 755050111,
					"content": "Hah, sharp as always.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "Xilonen"
				}
			]
		},
		{
			"id": 7550502,
