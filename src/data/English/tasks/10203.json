			"dialogs": [
				{
					"id": 102030201,
					"content": "*sob* I'll be more careful next time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030202
					],
					"speakerTitle": "Solitary Confinement"
				},
				{
					"id": 102030202,
					"content": "Next time, I'll complete a big heroic adventure all by myself, and I'll do it safely!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030203
					],
					"speakerTitle": "Solitary Confinement"
				},
				{
					"id": 102030203,
					"content": "I've heard that the Adventurers' Guild has its own set of rules. I wonder if I could get them to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030204
					],
					"speakerTitle": "Solitary Confinement"
				},
				{
					"id": 102030204,
					"content": "Yeesh, if Cyrus was listening to this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030205,
					"content": "He would be begging Jean to extend Klee's sentence!",
					"roleType": "TALK_ROLE_NPC",
