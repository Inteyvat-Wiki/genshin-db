			"dialogs": [
				{
					"id": 102030101,
					"content": "*sigh* Klee is no ordinary child. In fact, she holds the title of Spark Knight within our ranks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030102,
					"content": "No way! Even Klee gets to be a Knight of Favonius!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030103,
					"content": "Paimon sounds jealous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "Yes! Paimon thinks this is quite unjust!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030106,
					"content": "Although... The name kinda makes sense considering what Klee's treasure does.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030107,
					"content": "Yes. She causes her fair share of trouble for the Knights of Favonius, but we care a great deal about her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030108,
					"content": "As for her background...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030109,
					"content": "In short, you will understand her more as time goes by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030110,
					"content": "#Please keep an eye on her in the future, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030104,
					"content": "Sounds more impressive than \"Honorary Knight.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				}
			]
		},
