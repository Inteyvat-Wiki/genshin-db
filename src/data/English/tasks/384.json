			"dialogs": [
				{
					"id": 3840201,
					"content": "Everyone is finally here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840202,
					"content": "What a view...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840203,
					"content": "Lovely for a fated reunion, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840204,
					"content": "Well, we must be prepared for a fight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840205,
					"content": "Regardless of the outcome, things finally seem to be taking a turn for the better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840206,
					"content": "Mondstadt has really been going through so much recently...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840207,
					"content": "Huh! In the end, the solution to our problem was as simple as a traveler and a song.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840208,
					"content": "I suppose the Knights of Favonius may have played a part in it too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840209,
					"content": "Oh, we get it, Master Diluc... Everyone, please step aside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840210,
					"content": "I, the best wandering bard of the mortal world, shall begin my performance with the Holy Lyre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 38404,
			"completionStepIds": [
				38405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
