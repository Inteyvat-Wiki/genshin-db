			"dialogs": [
				{
					"id": 762080101,
					"content": "Huh? It looks like a transparent curtain is rising all around us... Is that tree doing this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080102,
					"content": "Looks like it's spewing resin... Paimon thinks it's trying to turn this whole place into a piece of amber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080103,
					"content": "That would make us the little bugs trapped inside.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080104
					]
				},
				{
					"id": 762080104,
					"content": "An amber piece with the two of us inside? Paimon bets it would definitely be the star of any auction! We'd be a one-of-a-kind treasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080105,
					"content": "Then what's the actual crown jewel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080106
					]
				},
				{
					"id": 762080106,
					"content": "This tree, obviously! It's the one making all this amber, after all. It's a shame we can't just haul it away with us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080107,
					"content": "Paimon wonders if there are any clues about it nearby.",
					"roleType": "TALK_ROLE_NPC",
