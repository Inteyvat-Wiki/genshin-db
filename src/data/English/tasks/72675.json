				"points": []
			},
			"dialogs": [
				{
					"id": 722641401,
					"content": "Mm! Training is fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641402,
					"content": "As long as you're having fun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "Yellow Fur very strong. Kapow — big and round thing gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641404,
					"content": "That's because I train regularly, you know?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "Mm! Kichiboushi, become strong like Yellow Fur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641406,
					"content": "Train, train, and train. Strong-strong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641407,
					"content": "What do you plan to do once you become stronger, Kichiboushi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "Get back at Gyoubu Koban, mmhaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641409,
					"content": "Then make Ioroi not stone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641410,
					"content": "Good luck. As for your training route, just leave it to us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "Mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641412,
					"content": "Let's have fun then. See you later.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "Yey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
		{
