			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 726750801,
					"content": "See! The view's great, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750802,
					"content": "Mm! Very good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750803
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750803,
					"content": "Many mountains over there. What place is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750804
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750804,
					"content": "Hmm? Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750805,
						726750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750805,
					"content": "That's Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				},
				{
					"id": 726750807,
					"content": "That's right. That should be Mt. Yougou over there — and beneath it? That's where Chinju Forest is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750808,
					"content": "So far. Ioroi, across the sea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750809
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750809,
					"content": "That's right. But we'll be with you all the way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750810,
					"content": "Mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750811
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750811,
					"content": "Well then, where to next...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750812,
					"content": "Is there somewhere familiar where we can find some good food?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750813,
						726750817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750813,
					"content": "Of course it's about food with you, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750814
					]
				},
				{
					"id": 726750814,
					"content": "Good food, good idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750815
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750815,
					"content": "#Aw! See, {NICKNAME}? Kichiboushi knows what's up. Eating all the good food in the world is good training too, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750816,
					"content": "Kichiboushi will surpass you pretty quick if you don't wise up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750818,
					"content": "Right? Climbing the mast sure was tiring.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750819,
					"content": "White Fur climb? But White Fur can fly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750820
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750820,
					"content": "Eh, details!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750821,
					"content": "Whatever the case, we'll stop here today. Paimon's gotta have a good think about where we'll go next.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750822,
					"content": "Mm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750817,
					"content": "Guess it's just as well that I'm feeling a little peckish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750818
					]
				},
				{
					"id": 726750806,
					"content": "That's where you're from.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				}
			]
		}
	]
}