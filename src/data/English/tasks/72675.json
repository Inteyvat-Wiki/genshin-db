				"points": []
			},
			"dialogs": [
				{
					"id": 726750601,
					"content": "Next, let's bring Kichiboushi onboard The Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750602,
					"content": "Not good. If boat sinks...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750603,
					"content": "Relax, this boat won't sink.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "This ship took us all the way to Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "Exactly! And that's how we came to meet you and Ioroi. So don't worry, it'll be fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750606,
					"content": "Mm! Understood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750607,
					"content": "Captain Beidou is a real steady hand, and so are the rest of her crew. Basically, this ship is the safest place on the high seas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750608,
					"content": "Mm! Yey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
		{
			"id": 7267508,
			"completionStepIds": [
				7267508
			],
