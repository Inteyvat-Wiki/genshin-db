			},
			"dialogs": [
				{
					"id": 726750301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750302,
					"content": "Not gold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750303
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750303,
					"content": "Huh? The Crystal Core really isn't golden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750304,
					"content": "Well, you both say that, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "Come to think of it, Paimon's never really noticed this even though you've caught lots of Crystalflies in the past...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750307,
					"content": "...Is this what they call \"disillusionment\"? You know, the thing that happens when you get older?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750308,
					"content": "Looks like you're in need of some training yourself, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "White Fur, can do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750310,
					"content": "Don't you \"you can do it\" Paimon! You're the one who's training, Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750311,
					"content": "Still, it is kinda disappointing. Why are the Crystal Cores of Geo Crystalflies not gold?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750312,
					"content": "Right. Gold Crystalfly, why not gold?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750313,
					"content": "Crystalflies might just be that kind of organism.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "Oh well, then. In any case, let's proceed as we planned. Time to take Kichiboushi to see The Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750314,
					"content": "I honestly don't know the answer to that question.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "There's not much I can do about it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
			]
		},
