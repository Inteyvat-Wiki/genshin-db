			},
			"dialogs": [
				{
					"id": 726750101,
					"content": "Different from snow mountain. Not cold. No snow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750102,
					"content": "This is Guyun Stone Forest! Legend has it that this is where Rex Lapis defeated that, uh, many-headed water snake thingamabob — what was its name again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750103,
					"content": "The Overlord of the Vortex?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "Right, that's the one! Osial, the Overlord of the Vortex! This is where it was defeated by Rex Lapis' stone spears and sealed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750106,
					"content": "Ooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750107,
					"content": "Cool, eh? But we fought with it too, y'know? Atop Ningguang's Jade Chamber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750108,
					"content": "Golden Crystalfly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750109,
					"content": "Wait, so that was what you were gushing over? C'mon, Paimon's telling a story over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750110,
					"content": "Well, it does look different from the ones in Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "He's probably never seen a Crystalfly that wasn't purple...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#Well... Guess that's true. Alright, alright. Why don't you catch one for him, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750113,
					"content": "And you're not gonna do it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "Well, you've got more experience at this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750118,
					"content": "It can be done, but we can only capture its Crystal Core.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "Yey! Nice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750115,
					"content": "But you're the one who can fly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "True, but you've got more experience at catching 'em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750117,
					"content": "Alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "Osial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
		},
