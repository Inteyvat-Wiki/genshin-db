			"dialogs": [
				{
					"id": 726750401,
					"content": "See The Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750402,
					"content": "Amazing! So much water!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750403,
					"content": "And so big! So big, on the water!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750404,
					"content": "So big, must be heavy. Why not sinking?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750405,
					"content": "That's because The Alcor is a ship.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750406,
					"content": "But, mud boat sink. Ioroi tell story. Story of rabbit, bake-danuki, and the mud boat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750407,
					"content": "Um, well, The Alcor isn't made of mud. That's why it won't sink.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750408,
					"content": "Why will not-mud ship not sink?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750409,
					"content": "Huh, you're becoming more fluent, Kichiboushi. But at the same time, how are we supposed to answer this question...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750410,
					"content": "#Right! Hehe, {NICKNAME}, why do ships float on the water's surface?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750411,
					"content": "Ships are made of wood. All hail the power of Dendro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "Eh? Can Dendro really do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750413,
					"content": "Um... Then why don't hilichurls with wooden shields float?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750416,
					"content": "Mmmph. Didn't get it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750417,
					"content": "Don't worry, Kichiboushi. Someday, when you're older, you'll be as smart as Paimon! Then you'll understand all these things: why ships float, why it snows in Dragonspine... You'll know it all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750418,
					"content": "I'm not sure you know either, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "Hey, come on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750422,
					"content": "Yup! Whatever the case, we can see The Alcor from here. Let's take a photo of Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750423,
					"content": "Photo! Drawing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750424,
					"content": "Yup, that's right! Alright, stand still for a moment now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750420,
					"content": "It's fine if you don't get it yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "You can get by without understanding some things.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "Ships can float as long as their buoyancy exceeds the pull of gravity.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "Ooh, is that how it is? Paimon gets it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
