			"dialogs": [
				{
					"id": 4840401,
					"content": "Hmm... How do we know if this was left by Raptor or an Anemo Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840402,
					"content": "Anemo Slimes are airborne creatures. They don't leave marks on the ground, unless someone stomped on one to take-off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840403,
					"content": "Wait... Are you telling me people actually do that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840404,
					"content": "Either way, let's make a mental note of these markings. They're very clear.",
