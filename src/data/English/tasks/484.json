			"dialogs": [
				{
					"id": 4840201,
					"content": "This is Springvale. There must be some clues about Raptor 'round here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840202,
					"content": "The Sister from the Cathedral put some secret Anemo markings on the artifact he took.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840203,
					"content": "Use your <color=#00E1FFFF>Elemental Sight</color> and keep your eyes peeled for clues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48409,
			"completionStepIds": [
				48409,
				48411,
				48424
			],
			"beginWay": "TALK_BEGIN_MANUAL",
