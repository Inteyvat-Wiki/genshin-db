					"id": 4842201,
					"content": "Huh, look where we are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4842202,
					"content": "There are no more elemental markings ahead.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "The elemental power on the artifact must have worn off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842204,
					"content": "Raptor must have realized the markings would give away his position, and sent his minions to slow us down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842205,
					"content": "That way, when the effect wears off, he can make his escape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842206,
					"content": "He won't get away with this! After him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 48435,
			"completionStepIds": [
				48432
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
