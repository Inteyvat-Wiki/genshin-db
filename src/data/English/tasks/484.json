			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4840601,
					"content": "Hmm... a strip of cloth with Anemo markings on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840602,
					"content": "Looking at the design and the way it's woven, there's a good chance it came from a wind glider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840603,
					"content": "Wow, Outriders have to be textile experts now!? It's a harder job than Paimon thought.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840604,
					"content": "If this really belongs to Raptor, it must mean his wind glider is broken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841101,
					"content": "It appears that the elemental markings point this way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841102,
					"content": "Huh. Well... D'you think he ran off ahead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841103,
					"content": "There's only one way to find out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841104,
					"content": "#C'mon {NICKNAME}, we should keep following the markings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841105,
					"content": "Ooh, what's that? Looks like something's going on up ahead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841106,
					"content": "It sounds like there's a battle going on — could that be Raptor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841107,
					"content": "Quick, let's keep going!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
