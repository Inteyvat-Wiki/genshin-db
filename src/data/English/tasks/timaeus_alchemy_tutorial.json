					"nextDialogs": [
						200390603
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390603,
					"content": "To make Flaming Essential Oil, you will need a frog and a flaming flower stamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390604
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390604,
					"content": "You should easily be able to find these outside the city— You want to know why we mix a frog with fire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390605
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390605,
					"content": "Why, flaming flowers have to be diluted with the mucus found on frogs' skin before they are safe for consumption...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390606
					],
					"speakerTitle": "Timaeus"
				},
				{
