				"points": []
			},
			"dialogs": [
				{
					"id": 200390401,
					"content": "Let's have you start by making some Shocking Essential Oil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390402,
					"content": "It is a foundational alchemical product. The best place for beginners to start.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390403,
					"content": "To make Shocking Essential Oil, you will need some electro crystal and a frog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390404,
					"content": "Both can be easily found outside the city— What? You can't see a connection between crystal and essential oil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390405,
					"content": "Hahaha, that's because there is none! The electro crystal is for the shocking part; it's the frog that provides the essential oil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390406,
					"content": "Once you've gathered everything, try and create some Shocking Essential Oil. No half measures now, give it all you've got! I'll be watching from here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390407,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
