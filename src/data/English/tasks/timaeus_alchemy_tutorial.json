					"nextDialogs": [
						200390503
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390503,
					"content": "To make Frosting Essential Oil, you will need a lizard tail and some mist flower corolla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390504
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390504,
					"content": "Both of these are found frequently in the wild— The point of the lizard tail, you ask?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390505,
					"content": "Why, the crispness of a frozen lizard tail makes for a far more appetizing potion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390506
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390506,
					"content": "Hahaha. That was a joke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390507,
					"content": "Once you've gathered everything, try and create some Frosting Essential Oil. No half measures now, give it all you've got! I'll be watching from here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390508
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390508,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
