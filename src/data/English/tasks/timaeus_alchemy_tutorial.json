			"dialogs": [
				{
					"id": 200390101,
					"content": "I want to find out more about alchemy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390102,
					"content": "The ancient art of alchemy is simply captivating... I wish more people appreciated it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390103
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390103,
					"content": "Oh, you're into alchemy too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390104,
					"content": "Very much so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200390105
					]
				},
				{
					"id": 200390105,
					"content": "#Well then, {M#boy}{F#girl}, it's time for you to get some first-hand experience!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390106,
					"content": "All great accomplishments start with a firm grasp of the basics and go from there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
