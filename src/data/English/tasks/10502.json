			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "Are you ready? Don't shame your master now — we're about to meet that successor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020102,
					"content": "I can't tell fortunes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "I guess... Wait, no! It won't do if you have no idea at all, even if you are a fake disciple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020105,
					"content": "We have a rule that forbids us from teaching outsiders, but I suppose... I suppose I could teach you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020106,
					"content": "My astrology is based on hydromancy, and as the name suggests, I use the reflections in water bodies to observe the true starry sky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020107,
					"content": "Allow me to demonstrate. Watch closely now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020108,
					"content": "From the present station and movement of the stars... I see, so that successor is a young... female... Knight of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020109,
					"content": "Doesn't that sound like... Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020110,
					"content": "We will meet her here presently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020111,
					"content": "Well, that's all the information we need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020112,
					"content": "Th—That's all?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "*sigh* It seems that even basic astrology can't be grasped in one go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020115,
					"content": "Never mind. I'll explain in detail later — she's here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020116,
					"content": "#Wow, it's you, {F#Miss}{M#Mr.} Honorary Knight! And Paimon too! You're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020117,
					"content": "That's her! The successor to great knowledge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020118,
					"content": "...You mean Klee!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "Successor...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020121,
					"content": "That's right. I am the astrologist who has plumbed the depths of the ocean of stars. Surely, you have long calculated my arrival as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020122,
					"content": "An ocean of stars? What's that? Does it have fish in it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020123,
					"content": "Fish...? No, don't play dumb. Is this some kind of game?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020124,
					"content": "I should be the one saying that! I didn't get what you said at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020125,
					"content": "We're getting nowhere fast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "But my predictions can't be mistaken... Well, let's make sure. Your mother's name is Alice, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020128,
					"content": "That's right! Oh, so you're Mommy's friend! But she's gone very far away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020129,
					"content": "My readings told me as much. But before she left, she must have imparted her mystical arts to you, surely?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020130,
					"content": "Mystical... arts? I... don't get it. Mommy only taught me to make Jumpy Dumpties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020131,
					"content": "So Klee's mother is the friend and rival of Mona's teacher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020132,
					"content": "Yes. As well-versed in astrology as she was, my master knew only astrology. Alice, on the other hand, was skilled in a great many other mystical fields.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020133,
					"content": "Well... Klee's so young, so even if she'd heard this deep knowledge, she might not have understood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020134,
					"content": "Yes. It seems she has inherited the blood, but not the knowledge... what a miscalculation. There can be no contest like this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020135,
					"content": "Ah, yes. So, before Alice left, did she tell you about a fifty-year agreement, and about a certain box?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020136,
					"content": "Ooh, I know this one! So you're here for that box. I'll look. Wait here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020137,
					"content": "Hmm... Not this one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020138,
					"content": "Hmm... Hm... Or this one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020139,
					"content": "No, no, it's not this one either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020140,
					"content": "Ah! I remember now. I buried it together with my new treasure, at <color=#00E1FFFF>Windrise</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020141,
					"content": "It's a bomb again, isn't it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "Wait for me. I'll be right back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020144,
					"content": "Klee, don't just run off! Don't you need the things in your pack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020145,
					"content": "I'll help her pack these things back in. You go after her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020146,
					"content": "*sigh* Looking at how rash she is, I worry for the box...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020142,
					"content": "Why do you always bury important things outdoors?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "See, I said this was a mistake.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "There must be some mistake!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "I haven't had a chance to look yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "I can't read the stars...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
			"id": 1050202,
