				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020301,
					"content": "Found it! It's this box.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020302,
					"content": "Glad it wasn't damaged in the explosions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020303,
					"content": "Retrieval complete! Let's bring it back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 1050204,
			"completionStepIds": [
				1050207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050207",
							"2"
						],
						"stepId": 1050207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "You're back at last. The wait was exceedingly dull.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020402,
					"content": "I had intended to read a book to pass the time, but this one was just some ridiculous diary. Nothing of note in it at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020403,
					"content": "It dropped from Klee's backpack, so I thought it might contain some ancient knowledge, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020404,
					"content": "Never mind that. So, did you find the box?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020405,
					"content": "We did. It's in perfect shape!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020406,
					"content": "That's wonderful— Wait a moment... Wh—Why isn't it locked!? And... why is it empty!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020407,
					"content": "Ehhh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020408,
					"content": "Well... it's because I borrowed this box to store my treasures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020409,
					"content": "Borrowed!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020410,
					"content": "But since you're here for the box, I took all my treasures out. That's why it's empty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020411,
					"content": "You used it to store your things!? Th—Then where are the original contents of the box? That's what I want.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020412,
					"content": "Oh. You want the thing that used to be in the box? ...You should've said so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020413,
					"content": "You haven't... broken it, have you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020414,
					"content": "No! It's not broken at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020415,
					"content": "Phew...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020416,
					"content": "It's the book in your hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020417,
					"content": "Whaaaaaaat—!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020418,
					"content": "Th—This... So this book, this diary... is that hag's... It's her diary from 50 years ago!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020419,
					"content": "The thing she wanted back after 50 years was the dark history of her youth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020420,
					"content": "Ah, I'm finished! No wonder... No wonder that old woman said that I should not look at it no matter what, or she'd rip me to shreds...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020421,
					"content": "Am... Am I in trouble?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020422,
					"content": "Ah! It was you who said you wanted the box. You didn't say anything about the thing inside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020423,
					"content": "I don't know anything. I'm leaving! Bye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020424,
					"content": "What a touching conclusion...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "Umm... Well, if you don't say anything, your master won't find out, will she?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020427,
					"content": "Impossible. Astrology can see through all lies — you've seen it yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020428,
					"content": "*sigh* After having spent all my Mora to come to Mondstadt, not only have I gained no knowledge, but now I can't return... How did it come to this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020429,
					"content": "That's so sad... Maybe you could forget everything in that book, and then go back?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020430,
					"content": "That's... too difficult. And even if I wanted to stay in Mondstadt, it would be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020431,
					"content": "Too embarrassing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "Yes. How can I maintain a proper astrologist's mentality if I stay with all these philistines?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020435,
					"content": "Well, then you'll just have to go back and face your master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020436,
					"content": "S—Stop talking about it! I... I guess I'll have to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020437,
					"content": "I'll just have to stay in Mondstadt temporarily. Once that old crone's reached the end of her days, I'll be free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020438,
					"content": "An intimidating resolution.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "But what will I do about my astrology research? ...No, wait, I don't even have a place to stay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020441,
					"content": "About that, we can go ask <color=#00E1FFFF>Katheryne at the Adventurers' Guild</color>. Let's see if she can help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020442,
					"content": "The Adventurers' Guild? Ah, right, you can do commissions for them in exchange for... you know what I mean, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020443,
					"content": "Of course.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "Oh. Um, thanks. I... Never mind, it's nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020444,
					"content": "That was always the plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "Does that really count as \"temporary\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "Too expensive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "Yes— I mean, no! You really have no way with words.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020425,
					"content": "There's no point getting mad at Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
			"id": 1050205,
			"completionStepIds": [
				1050208
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050208",
							"2"
						],
						"stepId": 1050208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020501,
					"content": "About Mona's background and her quandary...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020502,
					"content": "I see. I understand the situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020503,
					"content": "There is a <color=#00E1FFFF>magic laboratory</color> in Mondstadt that has been sealed by some unknown person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020504,
					"content": "Although we have a few specialists who could break the seal, they all have their own labs, and aren't that interested in the matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020505,
					"content": "I believe that if the astrologist you mentioned can break the seal, the owner of that house wouldn't mind if she stayed there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020506,
					"content": "I think she can do it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "Alright. Then, allow me to tell you where the house is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020507,
					"content": "I'll take her to go have a look.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
				1050211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050211",
							"2"
						],
						"stepId": 1050211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020601,
					"content": "The person who placed this seal... is by no means simple. Breaking this seal by force is nigh on impossible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020602
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020602,
					"content": "Interesting. I suppose it's worth using my astrology on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020603,
					"content": "Let me see... Hmm, I see, so if you first... ...and then you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020604,
					"content": "Alright, it's open.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020605,
					"content": "Holy moly, that's amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020606,
					"content": "Now we just need to go back to Katheryne, and you'll be able to stay here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020607,
					"content": "No need, no need, you have my utmost thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020608
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020608,
					"content": "You are...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020609,
					"content": "Oh, I'm Goth, the owner of this house. I passed by the Adventurers' Guild a while back, and Katheryne told me about the matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020610
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020610,
					"content": "I never thought this troublesome seal would be dispelled so quickly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020611
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020611,
					"content": "Does that mean I can stay here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020612
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020612,
					"content": "Of course, of course. The facilities inside were just being left there, anyway. I would be glad to have someone make use of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020613
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020613,
					"content": "To express my thanks, I shall rent this building to you at the lowest possible price!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020614
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020614,
					"content": "R—Rent?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020615,
					"content": "I didn't hear anything about rent, and I helped out, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020616,
					"content": "Yes, of course, I understand. I am most thankful to you for that, so rest assured that I will give you the best rates!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020617
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020617,
					"content": "I... I mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020618
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020618,
					"content": "Paimon thinks Mona's misunderstood something, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020619,
						105020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020619,
					"content": "This might be her best option.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				},
				{
					"id": 105020621,
					"content": "*sigh* I guess I don't have any other choice. I'll rent this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020622,
					"content": "Great! Then we are agreed. I will go prepare the documentation, please wait here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020623
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020623,
					"content": "Thanks for your help. Also, well, I'm very sorry, but I won't be able to do what I agreed to help you with just yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020624,
					"content": "Without the necessary tools, and without new knowledge, it will take me some time to see your destiny clearly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020625
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020625,
					"content": "But I promise that I'll do a reading for you first thing once I'm ready!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020626,
						105020628
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020626,
					"content": "As you said, this journey was all gain and no loss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020627
					]
				},
				{
					"id": 105020627,
					"content": "Thank you. Our traveling together was fate — and of the good kind, I'd say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020630,
					"content": "I wish you both safe travels! As for me... I need to think of the future as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020631
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020631,
					"content": "How is she going to make a living if she doesn't use astrology to make money?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020632,
					"content": "Maybe we should come back to check on her once in a while. It would really be bad if she fainted from hunger in there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020628,
					"content": "Guess you've got to keep working at it, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020629
					]
				},
				{
					"id": 105020629,
					"content": "Yes... I don't really know what to do, but... I'll do my best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020620,
					"content": "Save a little here, scrimp a little there, and you'll be fine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				}
			]
