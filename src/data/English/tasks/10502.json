					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020201,
					"content": "We're heeere! This is it. Let's dig it up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020202,
						105020203
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020202,
					"content": "This has to be the work of Dendro Slimes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				},
				{
					"id": 105020204,
					"content": "It can't be. I put up a sign here. There's no mistake—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020205,
					"content": "Argh! Dendro Slimes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020206,
					"content": "Yup. Dendro Slimes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020207
					]
				},
				{
					"id": 105020207,
					"content": "*sigh* We can talk later, let's take them out first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020203,
					"content": "Dendro Slimes must have done this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				}
			]
		},
		{
			"id": 1050203,
			"completionStepIds": [
				1050206
			],
