			"trigger": {
				"objectNames": [
					"???",
					"Julie",
					"Parvaneh",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "What can I do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "Excuse me, you are...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "I'm Kamei Munehisa, I am just passing by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "Wow... This guy dresses like a samurai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000205,
					"content": "S...samurai? Is he the samurai from the Shogunate... I heard that the Shogunate's attitude towards outlanders is quite... subtle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "Don't worry. I've left the Shogunate. I'm no longer a samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "I often come here to look for food. But today, I noticed monsters wandering around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "They've taken all the food around here. So I had to destroy them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "How often do you come here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "There are not many monsters around here usually. I often come here to pick fruits or hunt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "Well, that's all I have to say. After killing these monsters, the other ones around here won't dare to come here for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "If you are also looking for food, you can look around. I only took what I need. There should be something left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "Well, goodbye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "Did he just leave just like that? His behavior is exactly like the samurai I heard about before...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000221,
					"content": "But what does he mean he's left the Shogunate? Samurai who have left the Shogunate are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000222,
					"content": "They are like the enemies we met before.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Yes, I also heard that some samurai who have left the Shogunate wander around and rob people in the streets for a living...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000225,
					"content": "Although he doesn't look like a bad guy, we'd better stay vigilant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000226,
					"content": "All right, all right. Aren't we here to look for ingredients? But judging from the current situation, we'd better not go any further, in case it gets dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000227,
					"content": "This traveler has been escorting us for such a long time. Let's cook something here, have a short break and then we'll head back to town.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000228,
					"content": "The guy said there are still ingredients left behind, right? Let's look around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000223,
					"content": "Like the Kairagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "Did you kill all these monsters?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Yes, they are just ordinary monsters. They're easy to deal with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "Why are you looking for food in the wild?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "I have my own reasons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7280003,
