						"rawParams": [
							"7280010",
							"2"
						],
						"stepId": 7280010,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280011",
							"2"
						],
						"stepId": 7280011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Julie",
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "I was going to look for some fresh ingredients... Anyway, these will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000302,
					"content": "I'm sorry. I wanted to cook something nice for you, but now I guess we'll have to make do with these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000303,
					"content": "It's fine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "You worked hard escorting us. \"It's fine\" is not an acceptable answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000305,
					"content": "I'll remember this and treat you to a nice meal next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000308,
					"content": "Julie, is the soup ready? Remember not to let Parvaneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000309,
					"content": "No, no, just let the soup simmer quietly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000310,
					"content": "It's fine. I'm seasoning this soup according to my improved recipe. I'm just adding a little bit of seasoning...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000311,
					"content": "I don't understand your improved recipe. Stop it! Xudong, Xudong, come over here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000312,
					"content": "Parvaneh! Hey! What kind of strange seasoning are you putting in!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000313,
					"content": "Strange seasoning? This is my special sauce! This is the result of my thesis research!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000314,
					"content": "I don't need that! Let's just eat something ordinary today! Julie, stop her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000315,
					"content": "Humph, what do you know... Fine, let me fine-tune this. I am going to make the ultimate seasoning that will make any dish delicious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000316,
					"content": "Ultimate seasoning... Is something like that really possible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000317,
					"content": "No one has ever done it, that's why I am going to! I'll show those stuck-up unbelievers at the Akademiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000318,
					"content": "Haha... Well, I look forward to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000319,
					"content": "By the way, traveler, thank you for spending all this time running around with us. Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000320,
					"content": "I'll prepare a takeaway for you. You've got to have enough food when you are adventuring out there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000321,
					"content": "Next time we meet, I will treat you to a nice meal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000306,
					"content": "I'll find you to cook me a feast next time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "Hahaha, okay. I'll make a note of this. I'll make sure to treat you to something nice next time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}