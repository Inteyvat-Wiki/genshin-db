			"dialogs": [
				{
					"id": 761500101,
					"content": "*coughing*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500102,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "...I'm fine. I just had a very, very long nightmare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500104,
					"content": "...Forget it. Pretend I didn't say that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500105,
					"content": "I can't take it anymore. Why does this keep happening to me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500106,
					"content": "Why is it always me... First Mom and Dad... and now my sister...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500107,
					"content": "It's okay. I'm here with you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "...I know. I'm not angry at you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500110,
					"content": "What has Dex picked up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500111,
					"content": "I call it a Deathmuse Shard. It may be a way to move from death unto life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500112,
					"content": "Let's go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "Yes, let's.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500114,
					"content": "Now that Zeitlind's been found, let's try to find a way out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500115,
					"content": "Are you sure we can get out of here by ourselves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761500116,
					"content": "Melanta and Nihilita can move within this place freely, and they usually bring people with them. In which case, Dex should be able to do the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500118,
					"content": "That's three Deathmuse Shards collected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500119,
					"content": "Though I should say this is a temporary name, since I have no clue what Dex will be using them for either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500120,
					"content": "What next, Dex?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500121,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500122,
					"content": "Let's follow its directions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
