			},
			"dialogs": [
				{
					"id": 220000301,
					"content": "Finished cleaning yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000302,
					"content": "Finished.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "Yay! Thanks, these are for you. It was fun playing with you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000304,
					"content": "And don't forget — being a good person doesn't stop here. Make it a habit for life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000305,
					"content": "Hey, when do I get to be the captain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000306,
					"content": "Next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000307,
					"content": "That's what you said last time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Fei"
				}
			]
		},
