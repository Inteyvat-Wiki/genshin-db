			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220000101,
					"content": "So. How shall we play it this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000102,
					"content": "Hmph. If no one's going to be the pirate, we can't play it at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000103,
					"content": "But no one wants to be a pirate. So what're we gonna do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000104,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "We were gonna play a game, but there's no one to be the pirate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000106,
					"content": "If there's no pirate, there's no one to do the robbing... so we can't start the game.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000107,
					"content": "Ooh, ooh, I know, you can do it! Do you want to be a pirate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000108,
					"content": "It will be done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Yay! Right, let's get ready...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000115,
					"content": "When you're ready, come and join in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000110,
					"content": "Pirating is not my area of expertise...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "It's not that hard! A pirate is just someone who is very naughty and takes things that don't belong to them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000112,
					"content": "I've never met a real pirate though. That's just what Beidou told me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000113,
					"content": "But I think it must be quite easy to play a pirate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000114,
					"content": "Hehehe, I'm sure you can do it! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Little Meng"
				}
			]
		},
		{
			"id": 2200002,
			"completionStepIds": [
				2200002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200002",
							"2"
						],
						"stepId": 2200002,
