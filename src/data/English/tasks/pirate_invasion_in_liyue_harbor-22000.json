				"points": []
			},
			"dialogs": [
				{
					"id": 220000501,
					"content": "Finished cleaning?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000502,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "Hurry up. This is your chance to change your ways and show you can be a good person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000504,
					"content": "Hey, are we seriously saying that just cleaning up the place once turns you into one of the good guys?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000505,
					"content": "All it takes to be a good person is the willingness to do the right thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000506,
					"content": "That sounds too simple...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000507,
					"content": "Do good, you're a good person. Do bad, you're a bad person. Yes, it's very simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000508,
					"content": "Huh. You may say so, but then how come there's still so many bad people in the world?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000509,
					"content": "Because everything in the world is easier said than done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000510,
					"content": "But doing bad things is still easier than doing good things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000511,
					"content": "Did Beidou teach you that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000512,
					"content": "Nah, that one I read in a book.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				}
			]
		},
