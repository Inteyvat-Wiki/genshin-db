				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Little Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220000201,
					"content": "Ready!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "Then let the game begin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000203,
					"content": "...How do we start?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000204,
					"content": "Uh... Shiver me timbers? I'm robbing you!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "Eek! Pirates!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Little Lulu"
				},
				{
					"id": 220000206,
					"content": "Don't worry, Lulu, I'll save you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Little Fei"
				},
				{
					"id": 220000207,
					"content": "You must be a pirate. Tell me, why are you robbing us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000208,
					"content": "Because I'm a pirate...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Not all of them. There are good-guy pirates and bad-guy pirates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000211,
					"content": "Beidou says she's a pirate, but she's one of the good guys. She gives us snacks! Everyone loves Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000212,
					"content": "Why you gotta be a bad pirate? Can't you be a good pirate instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000213,
					"content": "You're the one who said pirates are naughty people who take things that don't belong to them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "I see the error of my ways.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Great! Owning up to your mistakes is the first step towards becoming a better person. That's what Beidou says.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000217,
					"content": "The next step is tidying up the area. Because as long as you do good things, you can be a good person. Even a good pirate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Little Meng"
				},
				{
					"id": 220000215,
					"content": "I hereby renounce said naughtiness.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "That's what pirates do...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
		{
