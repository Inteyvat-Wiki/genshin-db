							"7210816",
							"2"
						],
						"stepId": 7210816,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210810",
							"3"
						],
						"stepId": 7210810,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080401,
					"content": "The Sky Kitsune Statue that was supposed to protect the ward... It's empty inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080402,
					"content": "Maybe it was hidden by Miss Mask's old friend. Let's go find out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080403,
					"content": "\"Miss Mask,\" Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080404
					]
				},
				{
					"id": 721080404,
					"content": "Paimon just came up with that nickname. How is it? Easier to remember, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080405,
						721080406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080405,
					"content": "Not at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				},
				{
					"id": 721080407,
					"content": "Well, forget it then... Anyway, let's find some clues first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080406,
					"content": "It makes no sense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				}
			]
		},
		{
			"id": 7210807,
			"completionStepIds": [
				7210814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210814",
							"2"
						],
						"stepId": 7210814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080701,
					"content": "Eek! I—I... Mine name is Ioroi. Do whatever you want! K—Kill me if that be your will!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080702
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080702,
					"content": "Wow, the statue is talking! And it's so scared that it can barely string a sentence together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080703,
					"content": "I am no statue! This unseemly appearance is but the work of a temporary seal! Mine name is Ioroi, the world-renowned bake-danuki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080704,
						721080705
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080704,
					"content": "Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				},
				{
					"id": 721080706,
					"content": "What? Are you telling me that folk nowadays have heard naught of Ioroi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080707
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080707,
					"content": "The \"Tanuki Gyouen Scroll,\" \"Ioroi's Teapot,\" \"Kakushigami Oobayashi,\" \"Yougou Tanuki Gassen\"... Of these tales have you heard nothing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080708
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080708,
					"content": "Ah, how long has mine seal persisted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080709,
						721080711
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080709,
					"content": "I mean you no harm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080710
					]
				},
				{
					"id": 721080710,
					"content": "What? You aren't here to destroy me? Come now, why did you not say so earlier, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080719,
					"content": "*cough* Ahem. Well then, speak! Why have you come seeking me, the lord of bake-danuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080720,
						721080722
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080720,
					"content": "This is about the Sacred Sakura Cleansing Ritual...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080721
					]
				},
				{
					"id": 721080721,
					"content": "The Sacred Secular what now? What is that? Some manner of oni treasure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080726,
					"content": "This guy is unbelievable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080727
					]
				},
				{
					"id": 721080727,
					"content": "*sigh* Is he really Miss Masked Maiden's old friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080728,
					"content": "Anyway, we're looking for something hidden inside a kitsune statue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080729,
					"content": "Eek... Uh, Wh—Why are you l—looking for that, might I ask?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080730,
						721080731
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080730,
					"content": "Ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080732,
					"content": "Ugh, it's on that comb's account that I was sealed in here for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080733
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080733,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080734,
						721080735,
						721080736
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080734,
					"content": "One hundred years?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080737,
					"content": "I don't know how long it's been! Sunlight doesn't come through the Chinju Forest. There's no way to tell time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080738
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080738,
					"content": "Back then, I wreaked havoc everywhere to lure that sneaky kitsune out, but it was all in vain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080739
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080739,
					"content": "Eventually, I decided to vent my anger by dismantling one of those kitsune statues, and I found a comb inside... Which gave me an idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080740
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080740,
					"content": "The comb was hidden inside a kitsune statue and even had the Hakushin symbol on it, which reminded me of her white fur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080741
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080741,
					"content": "Thus, I concluded immediately that it must be very important. In which case, I just needed to hide the comb, and that sneaky kitsune would surely come out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080742
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080742,
					"content": "Yup, treasure's a good way to lure people out for sure! Then what happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080743,
					"content": "Then came one of the humans from the Yougou Three. He defeated my tribe and I, turning all of us to stone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080744
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080744,
					"content": "So that's why Ioroi is afraid of humans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080745
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080745,
					"content": "Hmph! Humans. They're so short-lived, and they can't even transform... I don't get why that kitsune likes them so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080746
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080746,
					"content": "That guy who sealed me up was especially infuriating. He even told me to \"strike a nice pose so that I can become nice scenery.\" Why, that little—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080747
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080747,
					"content": "Well, you do make for nice scenery...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080748
					]
				},
				{
					"id": 721080748,
					"content": "Eh? You... How could you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080749
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080749,
					"content": "#(Hey, {NICKNAME}, don't annoy him, or we may never get that ward...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080750,
						721080751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080750,
					"content": "I mean to say that you look really bold and burly...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080752,
					"content": "That's right! You make this dark forest look so much more colorful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080753,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080754
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080754,
					"content": "And?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080755,
						721080756
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080755,
					"content": "Like the statue of a god...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080757,
					"content": "Well, so, being sealed up is not such a bad thing after all, eh? See, humans don't mean you any harm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080758
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080758,
					"content": "I reckon I can see where you're going, but at the same time... I also... don't?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080759
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080759,
					"content": "Could we borrow that comb you spoke of?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080760
					]
				},
				{
					"id": 721080760,
					"content": "Well, you certainly could... But only if you play with the children first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080761
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080761,
					"content": "#Sure, that's easy. {NICKNAME} is good with kids!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080762,
						721080763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080762,
					"content": "Am I really...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080765
					]
				},
				{
					"id": 721080765,
					"content": "Shousei, Gyoubu Koban, and Kichiboushi. Go find these <color=#00E1FFFF>three little tanuki</color> and play with them. I would do it, but as you can see, I'm not exactly at any liberty to move.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080766
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080766,
					"content": "That dratted fellow was a bit sloppy when he sealed them. That's why some of them were able to get out earlier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080767
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080767,
					"content": "...Wait, that's not correct! We should say, rather, that we bake-danuki are most powerful indeed. It's only normal, therefore, that we could free ourselves from a mere human seal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080768,
						721080770
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080768,
					"content": "Well, what about you then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080769
					]
				},
				{
					"id": 721080769,
					"content": "Ahem! You speak truth, Ioroi the mighty and powerful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080771
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080771,
					"content": "Although their power can't really compare to mine, they can still use it to hide themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080772
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080772,
					"content": "Alright then, off you go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080770,
					"content": "Indeed, most powerful!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080771
					]
				},
				{
					"id": 721080763,
					"content": "That's right, I play with Paimon all the time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080764
					]
				},
				{
					"id": 721080764,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080765
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080756,
					"content": "Even the Statues of The Seven pale in comparison...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080751,
					"content": "I mean that you are truly handsome and truly...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080735,
					"content": "One thousand years?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080736,
					"content": "One million years?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080731,
					"content": "Now we're getting somewhere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080722,
					"content": "I'm looking for wards here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080723
					]
				},
				{
					"id": 721080723,
					"content": "Warts? Are those edible? We bake-danuki do know quite a bit about cooking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080724
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080724,
					"content": "No, it's the Sacred Sakura Cleansing Ritual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080725,
					"content": "Victuals? Oh, it's been too long since I've had any victuals...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080711,
					"content": "I am here to collect a debt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080712
					]
				},
				{
					"id": 721080712,
					"content": "Uh, collect a debt? Where? When was that? Let me think, let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080713
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080713,
					"content": "You, uh... What do I owe you, again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080714
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080714,
					"content": "He's thinking really hard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080715,
					"content": "You probably shouldn't tell this sort of joke in front of strangers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080716,
					"content": "That's right, jest not so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080717
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080717,
					"content": "Mm, it's all good, it's all good... Actually, best I make sure. Do I really owe you nothing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080718
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080718,
					"content": "...Do you really owe that many debts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080705,
					"content": "World-renowned?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				}
			]
		},
