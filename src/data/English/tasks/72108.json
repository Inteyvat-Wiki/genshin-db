			"dialogs": [
				{
					"id": 721080931,
					"content": "What? I didn't realize that it was so important. You should've said so earlier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080932,
					"content": "Agh, I was sealed over this thing for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "One hundred years?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Ugh! Stop speaking so lightly of my misfortunes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "Never mind. It's all water under the bridge now. I do also have some inkling about the barrier near the forest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "Back when I was fighting that sneaky kitsune, I once saw it on the eastern seashore. It looks like a Thunder Sakura with a torii gate, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "Back when that guy was battling the demons or whatever, I was worried that some of them might come out to hurt us. So I used magic to put a seal on that place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "Let me see. The seal should be under the cliff face to the east... Kichiboushi, take them there and remove the seal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "Thank you, Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Alright, alright. Enough jibber-jabber. Go now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "If you run into that sneaky kitsune, remember to send her my regards. Just say... let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "\"You've ticked me off real good this time, you jerk. Come back and fight me — our contest isn't over yet! And help me break this seal while you're at it, would you? It's not as if I couldn't do it myself or anything, but you still owe me a favor! Also, Gyoubu Koban says he misses you!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "Whoa, whoa, that's a lot to remember!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080934,
					"content": "One thousand years?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080935,
