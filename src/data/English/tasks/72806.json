				"objectNames": [
					"Aratani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060501,
					"content": "Oh, you're back at last! How did it go? Did you find our two authors?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060502,
					"content": "I did. The letters have been delivered.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "That's wonderful! What did they say, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060504,
					"content": "They both said that they'd read the letters with care.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Good, good. *sigh* It's just a shame that they're both far away in Liyue. Even were things more normal, we couldn't easily go to visit them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060506,
					"content": "Especially for Mr. Zhenyu. His book, \"A Legend of Sword,\" wasn't even submitted by him, but by a traveling merchant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060507,
					"content": "Later, one of our editors would read this book, and seeing its value, they prepared to go to Liyue personally and arrange for more manuscripts to be written.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060508,
					"content": "Who would've thought that with these changes in our situation, none of our letters that we sought to have people bring to Liyue ever returned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060509,
					"content": "We could only publish the books first, while keeping a record of the royalties owed to Mr. Zhenyu. Once we'd established contact, we would send the royalties over.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060510,
					"content": "But it's been so long, and still \"A Legend of Sword\" remains a bestseller. The royalties are starting to pile up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060511,
					"content": "*sigh* How I wish Mr. Zhenyu could attend this competition. These royalties can't be left to pile up like this much longer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
