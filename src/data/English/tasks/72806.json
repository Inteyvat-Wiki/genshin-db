			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang the Ninth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "Hmm? Traveler? What brings you to my home today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060202,
					"content": "Here's a letter and a gift from Yae Publishing House.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "A letter from Yae Publishing House? They're not asking me to change my pen name again, are they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060204,
					"content": "I've told them a thousand times that I'll write under my real name...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060205,
					"content": "*sigh* Oh, forget it. Let me have a look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060206,
					"content": "They want me to judge a novel-writing contest... Hmm. I don't think I have the time, but I suppose I should thank them, anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060207,
					"content": "Eh? What's all this? These are... \"creative suggestions\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Chang the Ninth"
				},
				{
					"id": 728060208,
					"content": "Uh, I—I'll have to read these a bit more carefully. Thank you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang the Ninth"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
