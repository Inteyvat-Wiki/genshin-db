				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "Hmm, this part is indeed well-written, and the progression is so very novel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060402,
					"content": "Xingqiu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "Oh, so that's what happens. Fascinating...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060404,
					"content": "Xingqiu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#Hmm? Ah, it's you, {NICKNAME}. It has been a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060406,
					"content": "From the way you greeted me, you seem well. That is good... What brings you here today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060407,
					"content": "Actually, we were hoping to ask you to find someone for us. You've read a ton of books, so you probably know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060408,
					"content": "A person? Are you looking for a writer, then? Hmm... certainly, ask away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060409,
					"content": "We're looking for a certain \"Zhenyu\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "Zhenyu? Wh—Where did you hear this name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060411,
					"content": "It says so right here on this copy of \"A Legend of Sword\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "We're looking for this Zhenyu person because someone from Yae Publishing House in Inazuma asked us to pass them a letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060413,
					"content": "Would you know who this Zhenyu person is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060414,
					"content": "Well, this Zhenyu of whom you speak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060415,
					"content": "This is embarrassing, but... that's my pen name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060416,
					"content": "Eh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060417,
					"content": "Well, that's one we've never heard of.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "Well, it's certainly nothing worth mentioning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060419,
					"content": "Initially, the editor in charge of this book here in Liyue told me that \"the setting is too outlandish while the plot is unexpectedly clichéd. No one will like this,\" and rejected my manuscript.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060420,
					"content": "I didn't feel like taking that lying down, so I had a few copies printed myself before planting them surreptitiously into Wanwen Bookhouse to see if anyone would like them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060421,
					"content": "As it turned out, readers were few and far between, so I did not pay it any more mind. I never thought that it would become so popular in Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060422,
					"content": "Still, I'm quite pleased that people are willing to read what I've written.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060423,
					"content": "I shall read this letter carefully, Traveler. Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				}
			]
		},
		{
			"id": 7280605,
