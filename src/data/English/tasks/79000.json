			"dialogs": [
				{
					"id": 790000401,
					"content": "Found it! Treasure, treasure... Wonder what'll we find inside...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000402,
					"content": "Eh? There's a lock on it. And it's coded, too... Looks like we'll need the code to open it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000403,
					"content": "We can just shatter it, can't we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "Wait! What will happen if the stuff inside breaks as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000406,
					"content": "Let's find a way to unlock it instead, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000410,
					"content": "But since this chest contains \"family heirlooms\" and is locked using a code...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000411,
					"content": "That's gotta mean that the person who locked it thinks that the code they left behind is easy enough to remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000412,
					"content": "Looks like our only chance are those conches that store sounds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000413,
					"content": "Let's listen to the sounds inside those conches again. Let's hope that they can give us some clues about the code...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000404,
					"content": "Looks like we'll have to find a way to unlock it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "But Paimon doesn't see any stone tablets, potraits, notes, carvings or notes nearby...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000408,
					"content": "There's a dearth of scholars, Treasure Hoarders, and adventurers, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "Yeah. Hmm... This is an unprecedented test!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				}
			]
		}
