			"dialogs": [
				{
					"id": 752380101,
					"content": "Is the tea to your liking? Or would you prefer something with a little more bite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380102,
					"content": "Tea is fine. I feel guilty drinking during the day. Best not to do it too often...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380103,
					"content": "Anyway, Miss Guillotin, what brings you to Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380104,
					"content": "I'm just traveling around, visiting old acquaintances. Besides, I wanted to thank you for agreeing to help out during the Fontinalia Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380105,
					"content": "You're too polite. Did you really come all the way here just for that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380106,
					"content": "Well... Although you were gracious enough not to bring it up last time, I'm well aware I've caused you trouble in the past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380107,
					"content": "Ah... That business with your subordinate? The incident involving the robot, Ineffa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380108,
					"content": "Heh... Isn't life strange? You might suddenly find yourself friends with your former enemy's boss... You might even find they become your own boss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380109,
					"content": "I hope you can accept this as a small token of apology.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380110,
					"content": "Th—This... It's a limited edition... No, a collector's edition!? And it's my favorite genre!? H—How did you know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380111,
					"content": "#I asked {NICKNAME} for advice. {M#He}{F#She} has a pretty good grasp of your reading preferences.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME}...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380113,
					"content": "(Ugh...! What's with these conflicting feelings!? It's like I'm pleased but also embarrassed.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380114,
					"content": "#(Naturally, I'm flattered {M#he}{F#she} knows what I like, but does {M#he}{F#she} really have to go shouting it from the rooftops? I'd rather {M#he}{F#she} just gave me a gift {M#himself}{F#herself}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380115,
					"content": "Do you like it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380116,
					"content": "Ah... Th—Thank you! You're too kind, Miss Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380117,
					"content": "#If it's the type you like, then next time, I can bring you some more. Of course, when the time comes, I'll have to trouble {NICKNAME} to pick them out with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380118,
					"content": "...W—With you!? You mean... You went to the bookstore together to get this!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380119,
					"content": "#Yes. {M#He}{F#She} seemed intent on choosing the perfect one. Maybe next time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380120,
					"content": "...There'd better not be a next time!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380121,
					"content": "Oh... I... Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
