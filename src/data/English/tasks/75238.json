				"points": []
			},
			"dialogs": [
				{
					"id": 752380201,
					"content": "#Ugh... Just wait till I get my hands on {M#him}{F#her}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380204,
					"content": "Is that the time? Alright, Miss Guillotin, be careful on the road.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
