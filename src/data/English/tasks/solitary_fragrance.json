			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220201,
					"content": "There are so many talismans here! And some stacks of blank paper, too! Hmm, what are they for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220202,
						10220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220202,
					"content": "It looks like they're copying the pattern on the talisman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				},
				{
					"id": 10220204,
					"content": "Paimon's seen this pattern before! But where...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220205,
					"content": "Oh, Paimon knows! It looks just like the Sigil of Permission that Childe gave you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220206,
					"content": "Hmm, but how did a relic of the adepti end up in the hands of someone like Childe? Suspicious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220207,
					"content": "It's not just a relic...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220208
					]
				},
				{
					"id": 10220208,
					"content": "Oh, that's right. Cloud Retainer said that when the Lord of Geo created the Sigil of Permission, it wasn't to be used as some ol' relic...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220209,
					"content": "Talismans like that were once used in the Archon War to channel divine powers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220210,
					"content": "Maybe the Fatui are copying the Sigil of Permission in hopes of achieving a similar effect?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220211,
					"content": "Being able to channel divine power in battle... Whew, that sounds pretty dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220212,
						10220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220212,
					"content": "Seems the Fatui are definitely up to something.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220214,
					"content": "And the plot thickens... We'll need to keep an eye on Childe, that's for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220215,
					"content": "Hmm, alright, that's enough sticking around here. We gotta go meet up with Zhongli soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220216,
					"content": "The last stop on our Rite of Parting preparations tour is... Dihua Marsh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220217,
					"content": "Let's go! Paimon hates being late!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220213,
					"content": "Maybe this paper is only a snippet of a much bigger plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220203,
					"content": "Maybe they're trying to reproduce a talisman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				}
			]
		},
		{
			"id": 102203,
			"completionStepIds": [
				102203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102203",
							"2"
						],
						"stepId": 102203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220301,
					"content": "Right on time. I myself only arrived moments ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220302,
					"content": "Did you enjoy your visit to the Jade Chamber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220303
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220303,
					"content": "It was so biiig, and preetty, and expensive... Paimon's never seen such a fancy-schmancy place before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220304,
					"content": "Indeed. It's second to none in all of Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220305,
					"content": "Then you met with Ningguang, I trust? What did you talk about with her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220306,
					"content": "She's super rich and so generous. Paimon thinks she's very friendly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220307,
					"content": "Business people are always \"friendly\" when it suits their interests.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220308
					]
				},
				{
					"id": 10220308,
					"content": "#Yeah, {M#his}{F#her} take on Ningguang is quite different from Paimon's. {M#He}{F#She} thinks that even the tactless Yuheng is more trustworthy than her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220309,
					"content": "Oh, so you also met with Keqing, then? What did she have to say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220310,
					"content": "She said, \"The time of the adepti has long passed. If even the Liyue Qixing don't want to face that truth, then what future is there for Liyue?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220311,
					"content": "Haha, no respect for the divine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220312
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220312,
					"content": "Indeed, contrary to the ever-bold Keqing, Ningguang is more of a businesswoman at heart, though they are both members of the Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220313,
					"content": "Although she's friendly, there's no way of clearly discerning her true intentions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220314,
						10220315
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220314,
					"content": "Ningguang is highly intelligent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				},
				{
					"id": 10220316,
					"content": "Yes, she has only relied on herself to rise to her current position. No ordinary person could ever achieve that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220317,
					"content": "It's said that she's the one behind the constant expansion of the Jade Chamber. It's the second most important thing to her. Even if she ever gave up the position of Tianquan, she would never give up the Jade Chamber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220318
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220318,
					"content": "The Jade Chamber is only second? What's the most important thing to her then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220319,
					"content": "Why, Mora, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220320,
						10220321
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220320,
					"content": "Makes sense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220322,
					"content": "All Ningguang talked about was the Fatui this and the Fatui that... She said that after Rex Lapis was murdered, the Fatui have constantly been trying to sink their fingers into Liyue and that they aren't to be trusted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220323,
					"content": "That is how the Fatui have always been. It doesn't surprise me in the least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220324
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220324,
					"content": "And now they are trying to reproduce the Sigil of Permission.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220325
					]
				},
				{
					"id": 10220325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220326
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220326,
					"content": "No matter what they may be planning, you must be careful when dealing with the Fatui. Always be on your guard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220327
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220327,
					"content": "So is there anything we need to get for the Rite of Parting in Dihua Marsh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220328,
					"content": "Yes, as a matter of fact, there is. Today, we'll be gathering wild Glaze Lilies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220329
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220329,
					"content": "Glaze Lilies? But why did we come all the way out here? Doesn't the garden in Yujing Terrace have some? Even Qingce Village has Glaze Lilies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220330,
					"content": "Oh right, Paimon remembers that Madame Ping is always tending to flowers. Maybe we could ask her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220331,
					"content": "No, those lilies have all been gardened by people. They won't do at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220332
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220332,
					"content": "Dihua Marsh used to be full of Glaze Lilies. It is a sort of joyful flower that listens to human song.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220333
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220333,
					"content": "Before the Archon War, Dihua Marsh was all dry land and fertile soil. But the war caused landslides and the land was flooded, turning it into the marsh you see now. Nearly all the Glaze Lilies were wiped out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220334
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220334,
					"content": "Of course, there are some kinds of flowers that have been preserved and gardened by people in the city. But very few people know that Glaze Lilies may still be found in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220335
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220335,
					"content": "Wild Glaze Lilies have the strongest fragrance. If we want to follow the true tradition of the Rite of Parting, we must grind up the wild lilies and place the powder in a censer of Everlasting Incense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220336
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220336,
					"content": "But I'll need your assistance in gathering these flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220337,
						10220339
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220337,
					"content": "You mean you need me to pick them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220338
					]
				},
				{
					"id": 10220338,
					"content": "No, I need you to sing to them. Singing to the flowers will make them more fragrant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220341,
					"content": "#Uh... so how good is your singing, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220342,
						10220343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220342,
					"content": "I can hold a tune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220344,
					"content": "Really? Why doesn't Paimon believe you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220345,
					"content": "#We'll only know once {M#he}{F#she} starts singing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220346
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220343,
					"content": "I'm a pro. Just step back and listen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220339,
					"content": "So you need me... to sing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220340
					]
				},
				{
					"id": 10220340,
					"content": "...That's correct. Your singing will surely bring out the strongest fragrance from the flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220321,
					"content": "No surprises there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220315,
					"content": "Ningguang is highly ambitious.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				}
			]
		},
		{
