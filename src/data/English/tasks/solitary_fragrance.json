			]
		},
		{
			"id": 102206,
			"completionStepIds": [
				102206
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102206",
							"2"
						],
						"stepId": 102206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "Those weren't Glaze Lilies! Glaze Lilies wouldn't hit people!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220602,
					"content": "Those flowers put up quite a fight...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "This little monster is known as a \"Whopperflower.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220604,
					"content": "Hmm... Strange. These petals look interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220605,
					"content": "The Glaze Lilies used as a disguise were buried with the Whopperflower for too long. The result seems to have surprisingly potent medicinal value. Let's collect what we can of these petals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220606,
					"content": "Well that's nice and all, but will those petals be useful for the Rite of Parting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220607,
					"content": "Unfortunately, no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220608,
					"content": "Ugh, that's so lame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220609,
					"content": "Excuse me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220610,
					"content": "Are you searching for Glaze Lilies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220611,
					"content": "Oh, hey! It's... what's her face... Ah, Paimon can't remember...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220612,
					"content": "Greetings, Ganyu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "Hello, traveler. I'm surprised you still remember my name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220617,
					"content": "Ah! That reminds me, how was your visit to the Jade Chamber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220618,
					"content": "Well, it sure would've been better if you'd told us how to get up there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220619,
					"content": "Didn't I tell you the way!? Surely I did!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220620,
					"content": "Nope, we found the way on our own!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220621,
					"content": "It isn't a secret, so perhaps you just assumed we knew?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "Oh, I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220624,
					"content": "(Uh-oh, I guess I really did forget to tell them...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220625,
					"content": "Huh, something seems a little off about Ganyu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220626,
					"content": "She's acting different from the first time we met... Where's her serious attitude now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220627,
					"content": "Ah, well, I met you at that time as an emissary of the Tianquan. But now, I am simply out on a stroll to see the flowers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220628,
					"content": "You came all the way out here to see the flowers? Why not just enjoy the gardens of the city?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220629,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220630,
					"content": "Yujing Terrace is where Rex Lapis parted from this world. If I strolled through those lonely gardens now, I wouldn't be able to bear it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220631,
					"content": "Whenever my duties take me near Yujing Terrace these days, I draw the windows to block my view of the gardens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220632,
					"content": "Oh... Sorry, we shouldn't have brought it up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220633,
					"content": "No, it's quite alright. I just haven't processed my emotions yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220634,
					"content": "When the Archon War came to its end two thousand years ago, the first iteration of The Seven would gather in Liyue and drink with Rex Lapis. But five of those original seven had already passed before Rex Lapis — it's truly a changing of the guard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220635,
					"content": "So that means...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "Yes. Now that the spirit of Rex Lapis has returned to the heavens, only Barbatos of Mondstadt remains of the first Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220666,
					"content": "The other five, including Inazuma's Raiden Shogun, are no longer the same friends from two thousand years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220637,
					"content": "Of the current Seven Archons, the youngest is Sumeru's God of Dendro. She is merely five hundred years old, whereas Rex Lapis was more than six thousand years old at the time of his passing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220638,
					"content": "This means that Liyue had been under Rex Lapis' rule from the moment it was first founded 3,700 years ago. The city has never had to bid farewell to its deity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220639,
					"content": "So, what do you think of this \"farewell\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220640,
					"content": "Huh? This... This is a little sudden, I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220641,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220642,
					"content": "As a mortal, I've never dared to imagine a Liyue without Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220643,
					"content": "But as an adeptus... I think I will eventually come to grips with reality. Since Rex Lapis has passed, the time of Liyue's contract with the gods and adepti has now reached its end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220644,
					"content": "Huh? Did you just say, \"as an adeptus\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220645,
					"content": "Yes, I... I am a mix of human and Qilin. Adeptus blood flows through my veins. I fought for Rex Lapis and the city of Liyue during the Archon War.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220646,
					"content": "After the war ended, I signed a contract with Rex Lapis and took the position as secretary for the Qixing. I've continued those duties to this very day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220647,
					"content": "So you're half Qilin? That explains the horns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "Well... uh, let's save that conversation for another day. You say that you are here looking for Glaze Lilies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220650,
					"content": "I also know where wild Glaze Lilies can be found. See, I've just picked one myself. Here, you may have it if you wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220651,
					"content": "We dare not refuse it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220652,
					"content": "Oh, so did you sing a song before you picked the lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220653,
					"content": "Indeed, I did. I know this tradition well. In fact, I sang a local Liyue ballad to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220654,
					"content": "Wow, so you really know your stuff too! Thanks, Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220655,
					"content": "No, it is you who I should be thanking. If not for this chance meeting, I never thought that I would be able to contribute to the upcoming farewell for our ancient lord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220656,
					"content": "If you would excuse me, I should return to my work now. Good luck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220657,
					"content": "And that just about does it. Our preparations for the Rite of Parting are mostly finished.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220658,
					"content": "Given the ease of picking Glaze Lilies, I think this was a fitting end to our tasks, in more ways than one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220659,
					"content": "Zhongli, you seem suited to working in agricultural development.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "Yeah, Paimon can already imagine him starting a business in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220661,
					"content": "Hah, I've had enough ventures in my life already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220662,
					"content": "Beginning a new undertaking is always difficult at first and requires no small amount of effort. And once business is at full steam, the stress of it all only wears away at you over time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220663,
					"content": "So you must be careful to take the time to step back and reexamine yourself. If left unchecked, the wear and tear on your heart may go well past mending.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220664,
					"content": "Wow! See, Zhongli sounds like he's already seen it all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220665,
					"content": "Alright, I think it's about time we head back to Liyue Harbor now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220648,
					"content": "So you're how old!? That explains the forgetfulness!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "Guess it was our fault for not asking.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "Greetings, Yangu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "\"Yangu\"? Wh—Who's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220616,
					"content": "Eh... You've completely forgotten my name, haven't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Ganyu"
				}
			]
		},
		{
			"id": 102208,
			"completionStepIds": [
				102208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102208",
							"2"
						],
						"stepId": 102208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Felix"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220801,
					"content": "Ah, you're the consultant to Wangsheng Funeral Parlor — Mr. Zhongli, I presume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220802
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220802,
					"content": "The Millelith are watching our every move now. These are desperate times, we mustn't act rashly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220803
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220803,
					"content": "Desperate times?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220804
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220804,
					"content": "The adepti of Jueyun Karst are finally on the move.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220805
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220805,
					"content": "Do they intend to exercise force?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220806
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220806,
					"content": "Most likely. I've heard that some members of the Qixing have already gone to meet them... Well, I say \"meet,\" but it's more like they're attempting to stall the adepti outside the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220807
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220807,
					"content": "However, both sides were quite obstinate, and hit an impasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220808
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220808,
					"content": "...It seems inevitable, given the current situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220809
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220809,
					"content": "The adepti do not acknowledge the Qixing, they only acknowledge the contracts of the Geo Archon. If the two sides come to blows, Liyue Harbor will be in no position to stop them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220810
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220810,
					"content": "Surely the Liyue Qixing are not the sort to give in so easily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220811,
					"content": "Hmph. Their bone-headedness is known throughout the lands. Yet it's because of that obstinacy that mortals and adepti are now on the verge of conflict.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220812
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220812,
					"content": "And what now? How is it that the Fatui have come under fire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220813
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220813,
					"content": "Ugh... that's all Ningguang's doing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220814
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220814,
					"content": "She proclaimed that \"in these tumultuous times, the Millelith must rein in the actions of the Fatui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220815
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220815,
					"content": "Only now do they want to start keeping tabs on us? Huh! That's the Qixing for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220816
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220816,
					"content": "Anyway, Mr. Zhongli, you're one of Childe's close associates. Please understand that your actions will reflect on us. Don't let anyone catch you off-guard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220817
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220817,
					"content": "It looks like things are about to boil over in Liyue Harbor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220818,
						10220819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220818,
					"content": "Is there anything we can do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				},
				{
					"id": 10220820,
					"content": "Do you intend to use your neutral identity as an intermediary between both sides? Or, will you use your sword to turn the balance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220821
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220821,
					"content": "Neither path is an easy one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220822
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220822,
					"content": "Oh, by the way, Mr. Zhongli. We've heard that the Wangsheng Funeral Parlor has also been caught up in all this. They're currently squaring off with the authorities at the gates.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220823
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220823,
					"content": "Things are taking a turn for the worse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220824
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220824,
					"content": "I'm afraid I must leave now to handle things back at Wangsheng Funeral Parlor. I hope that Master Hu has been able to keep things under control for the moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220825
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220825,
					"content": "#Consider your next course of action carefully, {NICKNAME}. If you're trying to prevent an explosion, it may be wisest to look for the fuse first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220827
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220827,
					"content": "Phew... Having connections with the Fatui seems to be quite the double-edged sword.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220828,
					"content": "So what did Zhongli mean by looking for the \"fuse\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220829,
						10220830,
						10220831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220829,
					"content": "Childe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220832,
					"content": "Ooh, Paimon gets it! If there's anyone that wants to see the whole city turned upside down, it's definitely him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220833,
					"content": "He must be waiting for the moment when no one is watching to do something really bad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220834,
					"content": "But, where could we find him now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220835,
					"content": "Where would he go at a time like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220836,
						10220837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220836,
					"content": "Follow me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220837,
					"content": "There's only one place he would go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220830,
					"content": "That ginger guy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220831,
					"content": "You know, Mr. More-Money-Than-Sense.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220819,
					"content": "We can't just stand by and watch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				}
			]
		}
	]
}