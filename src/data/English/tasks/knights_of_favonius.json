			"dialogs": [
				{
					"id": 3572401,
					"content": "This is the <color=#00E1FFFF>Knights of Favonius Headquarters</color>. Let's take a look inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
