				"points": []
			},
			"dialogs": [
				{
					"id": 726560101,
					"content": "Come, try your hand at Theater Mechanicus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560102,
						726560106
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560102,
					"content": "What is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560103
					]
				},
				{
					"id": 726560103,
					"content": "W—Welcome! I am a local representative for this new game from Liyue. It's called Theater Mechanicus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560104
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560104,
					"content": "In short, it is a game that can be played on a board. It was first invented by Ms. Ruijin from Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560105
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560105,
					"content": "Well, according to Ms. Ruijin, I am one of their overseas agents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560111,
					"content": "After I obtained... umm... the distribution rights, Ms. Ruijin sent me a complete set of Theater Mechanicus and the business model that goes with it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560112
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560112,
					"content": "Although it initially got confiscated by the Outlander Affairs Agency... It took me a while to get this copy of the game back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560113
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560113,
					"content": "Why did the Outlander Affairs Agency confiscate this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560114
					]
				},
				{
					"id": 726560114,
					"content": "They'll confiscate anything from overseas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560115
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560115,
					"content": "Anyway. Let's not talk about this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560116
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560116,
					"content": "Do you see these things laid out on the table here? These are all important items used in Theater Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560117
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560117,
					"content": "Does it feel like Liyue? Hahaha, this version was tailor-made according to the descriptions in Ms. Ruijin's letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560118
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560118,
					"content": "I even had someone make this table... It cost me a fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560119
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560119,
					"content": "And per Ms. Ruijin's suggestions, I added new features to Theater Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560120
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560120,
					"content": "Well... Anyway, it's better to learn through practice. Why don't you just give it a go? You'll understand after you play it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560121,
						726560123
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560121,
					"content": "Play Theater Mechanicus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560122
					]
				},
				{
					"id": 726560122,
					"content": "Sure thing! Enjoy the brand-new version of Theater Mechanicus! You won't be disappointed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560123,
					"content": "I don't have time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560124
					]
				},
				{
					"id": 726560124,
					"content": "Well, try it when you're free next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560106,
					"content": "How come there's Theater Mechanicus here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726560107
					]
				},
				{
					"id": 726560107,
					"content": "Welcome... Huh? So you know Theater Mechanicus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560108
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560108,
					"content": "Ah... I see. You must've played it in Liyue before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560109
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560109,
					"content": "Ms. Ruijin told me that she promoted the game during the Lantern Rite... So it did work after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560110
					],
					"speakerTitle": "Komakata"
				},
				{
					"id": 726560110,
					"content": "Well, according to Ms. Ruijin, I'm a local representative of Theater Mechanicus in Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726560111
					],
					"speakerTitle": "Komakata"
				}
			]
		}
	]
}