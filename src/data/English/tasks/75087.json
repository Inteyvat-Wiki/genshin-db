			"dialogs": [
				{
					"id": 750870501,
					"content": "Since you've managed to find your way here, I suppose I can finally drop the \"good merchant\" act. I need a breather from dealing with all the idiots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870502,
					"content": "You meanie! How can you pin the blame for your crimes on other people? Everyone got the wrong idea about us thanks to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870503,
					"content": "I'm a villain. Is it not natural for a villain to do bad things? Besides, doesn't the fact that those three idiots misunderstood prove that I'm good at what I do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870504,
					"content": "Haha, and now I'm going to do something more wicked still! This time, you're not going to get away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870505,
					"content": "Go get them, Furball!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870506,
					"content": "Gwoooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870507
					],
					"speakerTitle": "Furball"
				},
				{
					"id": 750870507,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#Let's go, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}? Are you really gonna take on someone that much bigger than you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870510,
					"content": "Crrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870511,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "Oberon looks kinda out of it. Is he just worried about Taruka, or has he eaten too many Saurus Crackers...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870513,
					"content": "#Maybe {REALNAME[ID(2)|SHOWHOST(true)]} really wants to cheer him up, so he bravely stepped out to protect us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870514,
					"content": "The things in this world that courage alone cannot change outnumber the sand grains of Sumeru. Compared to something illusory like that, absolute control is more reliable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870515,
					"content": "Attack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870516,
					"content": "#Amazing! {REALNAME[ID(2)|SHOWHOST(true)]} dodged the attack! That's just what Tepetlisaurs are good at, not even the sovereign of the skies can touch 'em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870517,
					"content": "Attack.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} is ready to attack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870530,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "The attack hit! It dealt... almost no damage!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870532,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "Well, getting a hit in is already pretty impressive! Phew— Paimon's kinda feeling tired already. Have we really only gone one round? What's going on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870534,
					"content": "It's my turn now, right? Attack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870535,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} quickly assumes a defensive stance to weather the opponent's fierce assault! He successfully blocks it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870536,
					"content": "Wait, your Saurian defended on his own right after attacking! Tch, despicable rule breaker...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870537,
					"content": "The best way to win a turn-based game is not to take turns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "What should we do next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870539,
					"content": "...Krraaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870540,
					"content": "Huh? Oberon seems to be pulling himself together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870541,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "Paimon doesn't understand what they're saying, but it looks like they've reached some kind of... mutual understanding...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870543,
					"content": "Use a Coordinated Attack.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "Here we go! Show us what the flight school's future star is capable of!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870552,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#Oberon has blocked the opponent's aerial escape route, and {REALNAME[ID(2)|SHOWHOST(true)]} is launching an attack! A brilliant coordinated strike!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870554,
					"content": "That's a lot of damage Furball's taking! Did it eat a bad hit to the foot? Like, \"stubbing your toe against the corner of a table,\" bad? Either way, the opponent seems shaken up and unable to move!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870555,
					"content": "Attack, but I'm the one attacking.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#You could do that... but c'mon, {REALNAME[ID(2)|SHOWHOST(true)]} doesn't get lots of chances to show his stuff as-is, so stop being so childish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870565,
					"content": "Kraaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870566,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#Oh? It looks like {REALNAME[ID(2)|SHOWHOST(true)]} and Oberon have a plan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870568,
					"content": "Saurus Crackers? Where did these Saurus Crackers come from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870569,
					"content": "Coo! Krraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870570,
					"content": "Wait, were you hiding them under your wings? What a cunning little Saurian... Taruka must have such a hard time dealing with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870571,
					"content": "Crrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870572,
					"content": "Now's not the time! Hey! Stop!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870573,
					"content": "Huh? Furball ignored her command and ran towards the Saurus Crackers! The chance to recover 5 HP is just too tempting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870574,
					"content": "Little does it know that it's the Saurian being served on that plate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870575,
					"content": "#In summary, the battle continued on in this way, each party trading hits.\\n{REALNAME[ID(2)|SHOWHOST(true)]} acted courageously, of course, like he was trying to prove himself. Though he would not ever be considered an outstanding student at the flight school, he could still use his other abilities to help his companions.\\nSurprisingly, even Oberon's unexpected weight gain helped. Now granted a larger physique than the average Qucusaurus, he closed off the aerial battlefield and dealt Furball a heavy blow...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "Quilla herself proved useless in a fight, and thus fled after Furball lost the will to fight.\\n\"You damned rule breaker! You... You won't win that easily next time! Just you wait and see!\"\\nAfter reciting the trite lines that petty villains such as herself are wont to say, she ran away with the injured Furball.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "Oh! Paimon forgot to ask her where Taruka is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870578,
					"content": "Crooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870579,
					"content": "Hey, cheer up for now. Taruka's a smart kid. He'll be fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870580,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#Yes, that's what you think too, right, {REALNAME[ID(2)|SHOWHOST(true)]}? C'mon, Oberon, let's get you back to the flight school first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870557,
					"content": "Persuade the opponent to surrender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "If words could solve problems, why would there be so many conflicts in the world?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870559,
					"content": "Ahem... Paimon's just saying that it isn't likely to work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870560,
					"content": "Capture it with a magical item.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870562,
					"content": "Let's run away now!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "Wooo... Rrroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#C'mon! You're even getting {REALNAME[ID(2)|SHOWHOST(true)]} down now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870545,
					"content": "Defend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "Wait, we're two against one here. Our opponent probably can't attack both targets at once, so isn't this a waste of a turn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870547,
					"content": "Use an item.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "Eat Saurus Crackers to recover 5 HP!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870549,
					"content": "...Not that that's necessary!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870550,
					"content": "Run away.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "C'mon, things are going well. Why are you still thinking about running away!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870519,
					"content": "Defend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "Rooo... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} seems to feel like defending too conservatively will lead to wasted opportunity. He's getting ready to attack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870522,
					"content": "Use an item.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "There's nothing we can use right now! Also, don't you think it's a bit too late to set Beast Trap now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870524,
					"content": "Rooo... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#Oh! {REALNAME[ID(2)|SHOWHOST(true)]} is ready to attack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870526,
					"content": "Run away.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "This isn't the time to run away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870528,
					"content": "Wrrooo... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#Even {REALNAME[ID(2)|SHOWHOST(true)]} gets it! Look, he's ready to attack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				}
			]
