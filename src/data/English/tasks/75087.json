			"dialogs": [
				{
					"id": 750870301,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870302
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870302,
					"content": "Cooo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870303
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870303,
					"content": "Huh... Is that you, Oberon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870304,
					"content": "Croooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870305
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870305,
					"content": "...You've, ah, grown a lot since we last met...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870306,
					"content": "Guess Taruka was right about you gaining weight easily. Oh right, where is he? Why isn't he with you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870307,
					"content": "Cooo... Crrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870308
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870308,
					"content": "Um, at any rate, we should probably get out of here first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870309,
					"content": "Now that we've found Oberon, we don't have to hide anymore, right? Paimon's still worried, though, we don't know where Taruka is... We gotta hurry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
