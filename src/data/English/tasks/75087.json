			},
			"dialogs": [
				{
					"id": 750870701,
					"content": "Huh? Taruka! You're back already!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#{M#Mr.}{F#Ms.} {NICKNAME}! I'm so glad you're okay... I've told my sister and everyone about what happened. Lamizana's just as big of an idiot as I thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "Crooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870704,
					"content": "Yes, even dumber than you, birdbrain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Crooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870706,
					"content": "#Okay, okay, guess he's really upset after being separated from you for so long. Also, he worked super well with {REALNAME[ID(2)|SHOWHOST(true)]} just now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "There's still room for more improvement.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Well, we're still talking about a little Saurian, here! As long as you treat him right, Taruka, Paimon's sure he'll grow into an outstanding Qucusaurus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "Kraaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870710,
					"content": "Speaking of which, how did you get back here? Did someone find you and save you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "I escaped by myself. I wanted to bring Oberon with me, but he was busy eating Saurus Crackers and wouldn't move no matter what I did. I got angry, so I left by myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "Huh? It was that easy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "After figuring out the movement patterns of the Saurian guards, I realized there was an opening I could use to escape. Got out of there smoothly afterward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Y'know, you might just be the most reliable one here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "What took you so long? I was just about to settle matters with that liar... a—and officially apologize to you guys, of course... I was way too arbitrary, and almost framed innocent people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870716,
					"content": "Too late now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "That's right! You only appeared after everything ended. If that isn't trying to steal credit, then what is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "I haven't any leg to stand on, so I'll pay you the agreed compensation or whatever you want from me. I won't be stingy about it. You can even punch me if it'll make you feel better!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870721,
					"content": "I'm a real man, so I won't try to weasel out of my responsibilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870722,
					"content": "#We'll get {REALNAME[ID(2)|SHOWHOST(true)]} to give you a punch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "Ouch! Ow! I haven't been hit, but it already hurts! Please stay your merciful hands... and feet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870727,
					"content": "Didn't you just say you're a real man who won't try to weasel out? How pathetic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Forget it, we're not that petty. Don't you agree, {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Thanks for forgiving me. The flight school... well, it has no doors, but its figurative doors will always be open to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870731,
					"content": "#Since you and {REALNAME[ID(2)|SHOWHOST(true)]} are so close, I wanted to ask you for the secret to getting along well with little Saurians!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870732,
					"content": "Hehe, no problem. We'll be back later if we get the chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870724,
					"content": "#I'll have {REALNAME[ID(2)|SHOWHOST(true)]} kick you in the toes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "I request monetary compensation! And my participation prize.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870719
					]
				},
				{
					"id": 750870719,
					"content": "So you haven't forgotten about the participation prize...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				}
			]
