			"dialogs": [
				{
					"id": 401440301,
					"content": "All you need to do is add the ingredients into the cauldron, follow the steps provided, and you're good to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
