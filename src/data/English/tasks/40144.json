			"dialogs": [
				{
					"id": 401440601,
					"content": "Seems like you've gotten the hang of the cultivation side of things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440602
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440602,
					"content": "Ah, I should probably mention, a knight from the Logistics Company has arrived. She'll be the one handling the provision of all future supplies. You should go have a chat with her in a little bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440603
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440603,
					"content": "And after that, it'll be your time to shine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440604
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440604,
					"content": "Wait, what about you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440605
					]
				},
				{
					"id": 401440605,
					"content": "Yeah! Shouldn't it be our time to shine? Y'know, the three of us? What about your role in all this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440606,
					"content": "My role? Naturally, it was to ensure my cuties had all the business and alchemy knowledge they needed to succeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440607
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440607,
					"content": "Okay, I'll be rooting for you! Good luck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440608
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440608,
					"content": "Paimon knew this would happen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
