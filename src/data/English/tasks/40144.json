			},
			"dialogs": [
				{
					"id": 401440401,
					"content": "Ooh, seems like everything is going well. You've already sold your first batch of potions. Not a bad start at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440402,
					"content": "As for what potions you should brew next, we'll need to consult the news from the market.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "That means staying up to date on the latest news and trends to try and anticipate people's needs. It's an essential skill when it comes to business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440404,
					"content": "Uh, that sounds kinda hard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Hehe... Don't worry. I already took it upon myself to compile all the latest news on the market for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "What do you think? Have any ideas on the kinds of potions you should sell next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "Go ahead and try to cultivate some herbs then. Bio-alchemical processing can infuse herbs with different effects and properties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "Using different herbs in the brewing process will, in turn, alter the effects of the potion. There's a whole bunch of combinations to try.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "Alright cutie, why don't you get started?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
