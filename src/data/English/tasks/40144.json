						],
						"pointId": 300300753
					}
				]
			},
			"dialogs": [
				{
					"id": 401440201,
					"content": "This is the shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440202,
					"content": "Wow! Looks like you've made a lot of preparations already! Did you do all this by yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440203,
					"content": "It was a group effort. A whole bunch of knights helped out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440204,
					"content": "Jean secured the initial funds to open the shop. Albedo and Sucrose provided the ingredients and equipment needed to brew the potions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440205,
					"content": "And the Logistics Company is handling the provision of all future supplies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440206,
					"content": "Now with your help, it's like an additional weight has been lifted off my shoulders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440207,
					"content": "The Knights have been busy spreading the word about our shop over the past few days. So, we should be ready to open once we've finished our final preparations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440208,
					"content": "Okay, let's not keep everyone waiting, then. Why don't you take these ingredients and try your hand at brewing a potion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
