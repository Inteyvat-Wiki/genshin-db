			},
			"dialogs": [
				{
					"id": 401440701,
					"content": "#Greetings, Honorary Knight! Greetings, Paimon! My name is Freda. I'm a knight from the Logistics Company. It's such an honor to meet the famous {NICKNAME} and {M#his}{F#her} loyal attendant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440702,
					"content": "#Wow, Paimon's fame is really spreading across the land, hehe! One small correction though. Paimon's {M#his}{F#her} companion, not {M#his}{F#her} attendant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440703,
					"content": "Ah, my apologies. I guess I got a bit carried away after hearing all about your exploits. It's just like something out of a novel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440704,
					"content": "You're practically legends at this point. I'm a bit jealous, actually...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440705,
					"content": "I'd love to wander the land in search of adventure like one of those knights you read about in stories! Seems like a really fun life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440706,
					"content": "Maybe you'll get the chance one day!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "Yeah! That's what I'm hoping, at least!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440710,
					"content": "Anyway, we've got some prep work to wrap up, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440711,
					"content": "My orders from the Acting Grand Master are to support your business in any way I can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440712,
					"content": "If there's anything you need, just let me know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440713,
					"content": "Purchase supplies...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "You're in luck! I just got a new batch of provisions! Please take a look and see if anything catches your eye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440715,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440716
					]
				},
				{
					"id": 401440716,
					"content": "Best of luck with your business!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440708,
					"content": "It's not actually all fun and games.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440709
					]
				},
				{
					"id": 401440709,
					"content": "I bet. The knights in the stories are always running into all sorts of danger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				}
			]
