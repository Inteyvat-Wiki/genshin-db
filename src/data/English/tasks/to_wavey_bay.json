			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chasca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "Sharp eyes! I didn't expect you to spot me all the way up here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421302,
					"content": "Looks like you've taken an interest in the facilities here as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421303,
					"content": "Are they fun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "I think they're pretty good, but \"fun\" is subjective. What I say's not gonna sway you, you'll have to try it for yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421307,
					"content": "See that track over there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421308,
					"content": "Use paintballs to color the balls lined up on the tracks. Once they're all the same color, the balls will disappear with a \"bang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421309,
					"content": "By which I mean that someone else might be standing nearby with their own gun. They'll be waiting to send those colored balls flying when the time's right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421310,
					"content": "Amazing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "Give it a try and see. Just use that gun over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421313,
					"content": "I'll watch you play this time. Good luck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421311,
					"content": "I almost want to believe you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "Are they complicated?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "Relax, it's easy. Fitting, given the name of this place. You wouldn't be able to find anything \"complicated\" or \"hard\" around here even if you tried.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				}
			]
		},
		{
