			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "Huh, how did I run out of wood...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430102,
					"content": "Oh, hey there, Traveler! You're just the person I was hoping to see. Do you mind doing me a favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430103,
					"content": "What's that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "I've been trying to make smaller-scale wood carvings of our provisional head priestess.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430106,
					"content": "I've been thinking to bring a batch of these to Narukami Island to see if they'll sell...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430107,
					"content": "If they do, they would make for a source of consistent income for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430108,
					"content": "Oh, I think they'll sell alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "Hahaha. Thanks for your well-wishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430110,
					"content": "That said, I think I've got faith in our Lady Neko's charisma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430118,
					"content": "Well, never mind that for now. Let's talk about the matter at hand...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430119,
					"content": "So, the issue is that I'm running out of the wood I was using to practice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430120,
					"content": "Could you help me collect 10 blocks of Otogi Wood, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430121,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "I'll leave it to you, then. You're a really great help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430126,
					"content": "Bring those Otogi Wood blocks to me once you're done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430123,
					"content": "Do you really need that many?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "Well, I've only just started practicing, so it's best to be on the safe side and prepare more material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430125,
					"content": "Well, I'm counting on you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430111,
					"content": "What's with the wood carvings all of a sudden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "Oh, well... Do you know what my payment from our head priestess has been so far?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430113,
					"content": "They're generally these... bottles, cups, plates, and things like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430114,
					"content": "They do look a bit old, but when I went to have them appraised, we found out that these things are in fact a bit \"ancient\"... and valuable, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430115,
					"content": "But to tell the truth, it was pretty troublesome and tiring getting them sold every time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430116,
					"content": "Also, this really doesn't make for a particularly stable income... If the head priestess were to run out of these things one day, wouldn't that basically put me out of a job?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430117,
					"content": "As such, I've decided to pursue a new business venture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430104,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
