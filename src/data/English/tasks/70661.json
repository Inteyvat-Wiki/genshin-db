				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "Ad astra abyssosque! Welcome to the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610102,
					"content": "We've recently received a commission from the Fishing Association, claiming that the fish activity in the nearby waters has been abnormal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610103,
					"content": "Unfortunately, their report does not mention any specifics. Could you help us check in on the situation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610104,
					"content": "I have full faith that no matter what the problem is, you will overcome it with ease.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610105,
					"content": "Fishing Association? Is it that fishing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "Huh? \"That fishing\"? I'm not sure I understand... Is there any other kind of fishing to speak of?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610107,
					"content": "Ooh, the Fishing Association... The Fishing Association... Sure sounds like they're in the business of catching delicious fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610108,
					"content": "Well, there's no time to lose — let's go check this out! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066102",
							"2"
						],
						"stepId": 7066102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "The fish have been really active these days...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610202,
					"content": "Do you need help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "Yes, and here comes my help now, I suppose! Good day to you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610204,
					"content": "Ahem. My name is Nantuck, senior fisherman of the Mondstadt Fishing Association.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610205,
					"content": "Recently, many new fish species have suddenly appeared in nearby waters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610206,
					"content": "I immediately contacted my friends in other regions, and sure enough, this has been happening everywhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610207,
					"content": "Some people say that this must be the Teyvat fish outbreak of the century!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610208,
					"content": "Actually, the reason hasn't been fully investigated, but I guess it has something to do with the improvement of the ecological environment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610209,
					"content": "Oh, so you guys are in trouble because there are too many fish, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610210,
					"content": "Don't worry, Paimon will take care of it! As long as they don't taste bad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610211,
					"content": "Haha, it's no trouble. In fact, the more fish, the better as far as the Fishing Association is concerned. However, we need enough manpower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610212,
					"content": "And to be honest, with the manpower we have available...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610213,
					"content": "We'd be hard-pressed to catch all the new fish species for research in a short time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610214,
					"content": "But on the flip side, I thought, isn't this also a great opportunity for the Fishing Association to grow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610215,
					"content": "So I put up a commission with the Adventurers' Guild. Well, how about it? Interested in joining us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610216,
					"content": "Fishing is a lot of fun, you know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610217,
					"content": "No problem, I'm good at fishing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "Great, what an energetic youngster you are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610223,
					"content": "So... Let's start by going to Cider Lake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610224,
					"content": "That's where the fishing grounds I prepared for newcomers is. I'll teach you the basics first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610219,
					"content": "Can I just go down and catch them straight?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "Isn't it really dangerous to dive straight in? You adventurers sure are bold...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610221,
					"content": "Unfortunately, those fish are not as brave as you. All of them will be scared away if they see such a huge being jump into the water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610222,
					"content": "Best you refrain from doing such a thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				}
			]
		},
		{
			"id": 7066103,
