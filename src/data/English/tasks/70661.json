				}
			]
		},
		{
			"id": 7066104,
			"completionStepIds": [
				7066103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066103",
							"2"
						],
						"stepId": 7066103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "This place will do! See those little fish in the water? They're so beautiful...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "Here, take some of these tools. We have fishing rods, bait, and formulas for making bait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "First, place the bait on the hook, then aim for where the fish are gathering... then cast your rod! Then, dutifully wait for the fish to take the bait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "I've heard that newcomers have something called \"beginner's luck.\" I caught a large bass that was more than half a meter long back then! Well, go on then, give it a go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "Here's to catching another Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "Hey! You shall have no other Paimon before this Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "Paimon? What a strange name, is it a kind of fish?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "It's a sort of \"wonderous seafood\" that I managed to catch last time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "Hey! When did Paimon go from \"emergency food\" to \"wondrous seafood\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610410,
					"content": "Ah, I see! I didn't realize that you were already an experienced angler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610411,
					"content": "Well, that just makes me even more excited to see what you'll catch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
		{
			"id": 7066106,
			"completionStepIds": [
				7066106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066106",
							"2"
						],
						"stepId": 7066106,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"7066110",
							"3"
						],
						"stepId": 7066110,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "How did it go? By the look on your face, I suppose you got a pretty good haul! Let me see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610602,
					"content": "Oh? It's a newly discovered species of fish! That's wonderful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610603,
					"content": "You're almost catching up with me back when I was in my glory days, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610604,
					"content": "Can you also catch fish with your bare hands?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "Ahem... Seems like these ordinary little fish are a walk in the park for you. I should consider giving you something more challenging...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610606
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610606,
					"content": "You might not know this, but even fish from the same species can have huge differences between individuals because of differences in living environment and food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610607
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610607,
					"content": "Even though they all look the same, some individuals are particularly active and energetic. They jump out of the water from time to time and are very eye-catching.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610608
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610608,
					"content": "These individuals are superior by far in terms of both commercial and aesthetic value.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610609
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610609,
					"content": "Many hobbyists buy them at high prices and keep them at home in their tanks for ornamental purposes. This is why such fish are also called \"ornamental fish.\"",
