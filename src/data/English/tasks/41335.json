			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "No this isn't right, and that's not right either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350102,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "Oh, hello. I'm just here collecting some materials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350104,
					"content": "Given that the Lantern Rite festival is already in full swing, I was thinking about how I could create a painting that depicts Liyue Harbor during the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350105,
					"content": "*sigh* Maybe it's a problem with my technique or something, but no matter what I do, the painting just doesn't feel right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350106,
					"content": "Maybe a change of scenery would give me more inspiration, but I can't seem to find anywhere better...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350107,
					"content": "Traveler, do you know of any scenic spots that would be suitable for painting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350108,
					"content": "We'll have a look around!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "Oh, good. Let's have a look together then. Maybe we'll be able to find a nice scenic spot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "Now here's a good view of the landscape... Oh, who's this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350302,
					"content": "My name is Qingzhou, my liege. I might add that I consider myself a poet, if I may be so bold. And you are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350303,
					"content": "Ah, so you're a poet? Haha. Well, I'm a painter and I'm looking for some scenic spots nearby to help give me some inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350304,
					"content": "Inspiration, you say? Why, this is quite a coincidence. I myself am also seeking a stroke of inspiration. May I be so bold as to ask the purpose for which you seek to be inspired?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350305,
					"content": "Certainly. I intend to paint a scene of Liyue Harbor during the Lantern Rite. This traveler here was assisting me in my search for a suitable landscape.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350306,
					"content": "And may I ask what you are seeking inspiration for?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350307,
					"content": "Yes, quite the coincidence indeed. I also intend to write a poem about Liyue Harbor during the Lantern Rite. I'm seeking inspiration, just as you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350308,
					"content": "I see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350309,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350310,
					"content": "Wouldn't a poem be a little too simple? How could an amazing festival like the Lantern Rite and Liyue Harbor itself possibly fit into a few lines of poetry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350311,
					"content": "Hah, if you ask me, only a great painting could properly capture the essence of the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350312,
					"content": "A great painting, you say? Hehe, I fear that such a work would only be a waste of good brush and ink. A painting could never truly capture the subtle charm of the Lantern Rite and would fail to accurately render the spirit of Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350313,
					"content": "Furthermore, could the grandeur of a land as magnificent as Liyue ever possibly be captured in a painting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350314,
					"content": "Haha, I think a painting would be better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350315,
					"content": "Hehe, and I think a poem would be better suited.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350316,
					"content": "Whoa, calm down you two.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "Arguing like this won't solve anything. I propose we each create a work depicting Liyue Harbor during the Lantern Rite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350318,
					"content": "Once we've both finished our works, we can put them on display and invite someone to judge them. What do you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350319,
					"content": "Your proposition is acceptable. I shall await your presence at Wangshu Inn once you have completed your... painting. Then we shall entreat an impartial judge to critique our work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350320,
					"content": "Good, you have a deal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350321,
					"content": "It's settled then. If you would excuse me, I shall take my leave now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350322,
					"content": "He sure does talk big for a poet. And to think he actually believes that the Lantern Rite and Liyue Harbor can be expressed with a few lines of poetry, hah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350323,
					"content": "I'll show him! He won't even stand a chance once I finish my painting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350324,
					"content": "I'll need to pour all my creativity into this one. In fact, I should even specially prepare some paints and brushes for this particular piece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350325,
					"content": "Traveler, could I trouble you to help me collect some special materials?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350326,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "Good, I'm counting on you. Now let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350329,
					"content": "Oh, I'll need you to collect Whopperflower Nectar from a Pyro Whopperflower.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350330,
					"content": "With that, I'll be able to make mix some special paint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350328,
					"content": "What kind of materials do you need?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
