			"dialogs": [
				{
					"id": 413350701,
					"content": "So, were you able to get the Whopperflower Nectar I need?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350702,
					"content": "Here it is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "Let me see here. Oh, here we go... Yes, this will do just fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350704,
					"content": "Once the paint is ready, all we'll need to do is find a suitable landscape and then I can start painting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350705,
					"content": "Humph, just wait until that poet sees my painting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350706,
					"content": "Ah, I've just remembered! It's a tradition to release Xiao Lanterns during Liyue's Lantern Rite. People even write wishes on the lanterns, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350707,
					"content": "Hehehe, I've even prepared a Xiao Lantern here, and as for the wish... Well, I won't tell you, otherwise it might not come true.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350708,
					"content": "Oh, I nearly forgot, these are for you. I guess you could consider them your reward. Thanks for the help!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350709
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350709,
					"content": "I can't wait to see the look on that poet's face when he sees my painting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
