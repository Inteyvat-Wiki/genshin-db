			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150301,
					"content": "Recruiting new people isn't the hard part — that comes in some time later, when lots of them start finding excuses to take the day off, or just straight up stop coming in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150302,
					"content": "The coach has come up with all sorts of ideas to keep their motivation up, that block challenge being one of 'em.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150303,
					"content": "But in the end, some people tried to boost their scores by ramming straight into the block, and wound up all black and blue for their trouble. That just added to the number of people applying to be excused...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				}
			]
		},
		{
			"id": 7521504,
