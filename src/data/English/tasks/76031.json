			},
			"dialogs": [
				{
					"id": 760310201,
					"content": "...Good idea. I'll ask Kunegunda to bring more fruit over later. She will need rest over the next two days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310202,
					"content": "Huh, looks like Lauma's busy right now. Let's give her a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310203,
					"content": "I realized, many years ago, that the Moonchanter is a figure of great importance to the Frostmoon Scions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310204,
					"content": "Sometimes, I think their task is even harder than that of a god.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310205,
					"content": "Finally! She's got some free time. Let's—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310206,
					"content": "My lady, some of the defensive structures over here require your attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Vanamo"
				},
				{
					"id": 760310207,
					"content": "Of course. I'll see to that right away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310208,
					"content": "And off she goes again! She never gets a moment's rest, does she?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310209,
					"content": "C'mon, let's follow them. But, keep it quiet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
