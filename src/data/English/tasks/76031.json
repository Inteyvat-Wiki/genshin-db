			"dialogs": [
				{
					"id": 760310101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310102,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310103,
					"content": "Oh, she seems to be taking an afternoon nap. Guess we'll come back later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310104,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "Chic Badger"
				},
				{
					"id": 760310105,
					"content": "No, wait! Don't go over there—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "...Mmph!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310107,
					"content": "Ouch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Chic Badger"
				},
				{
					"id": 760310109,
					"content": "Ah, you slipped? Don't worry, I'm not hurt. Hm? Oh, you two are here as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310110,
					"content": "Guess a Moon Goddess isn't immune to a few bumps and bruises...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "I don't mind little critters bumping into me, so long as the kuuvahki emanating from them reflects no ill-intent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310112,
					"content": "Did something happen? Why are you so afraid, little one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Chic Badger"
				},
				{
					"id": 760310114,
					"content": "Hm, I see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310115,
					"content": "Ooh, so you can understand these animals too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "The moon shines high over Nod-Krai. All animals that grow beneath the light of kuuvahki can be considered \"familiars of the Moon Goddess.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310117,
					"content": "So, what did this little guy say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "That monsters have appeared where he lives. He was looking for Lauma, but the monsters chased him to this area...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310119,
					"content": "Ohh... No wonder he's so scared...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "Where should we take him?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Back to Lauma, I think. She will know how to handle this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310122,
					"content": "Alright, looks like it's another trip out for us. Since we're heading to the Frostmoon Scions, make sure you hide extra good this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
