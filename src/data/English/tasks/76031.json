			},
			"dialogs": [
				{
					"id": 760310301,
					"content": "...This will do. Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310302,
					"content": "Come night or day, may the moonlight connect us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310303,
					"content": "...Hmm? That saying has changed from when I last heard it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310304,
					"content": "Hey! That person left. C'mon, now's our chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310305,
					"content": "Lady Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 760310306,
					"content": "Seriously!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310308,
					"content": "...Thank you for your hard work. Excuse me for a moment. I will be back shortly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310310,
					"content": "There is no one around. You can come out now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310311,
					"content": "Wait, you knew we were here!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310312,
					"content": "How could I possibly miss the \"Kuu{RUBY#[S]Moon Maiden}tar\" and her kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310313,
					"content": "Although... I'm not quite sure why you're following me. It's quite unnerving... being \"observed\" at work like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310314,
					"content": "Oh, um... S—Sorry about that. We wanted to ask you about something, but the time was never right... Hopefully, we didn't stress you out too much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310315,
					"content": "Ah, I see... Understood. I'll handle it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310316,
					"content": "To be honest, after seeing how busy you are, Paimon kinda feels bad asking you to do more work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310317,
					"content": "Ah, it's nothing. Such is the duty of the Moonchanter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310318
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310319,
					"content": "...Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310320
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310320,
					"content": "...Now that you have seen all this, \"Kuu{RUBY#[S]Moon Maiden}tar\", what do you think of the Frostmoon Scions today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310321
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310321,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310322
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760310322,
					"content": "The atmosphere is much changed from how it was several centuries ago. It's a good kind of change.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310323
					],
					"speakerTitle": "The Damselette"
