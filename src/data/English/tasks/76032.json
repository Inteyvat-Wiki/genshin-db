			"dialogs": [
				{
					"id": 760320201,
					"content": "Hey, you. Do you know what happens to people who go sneaking about where they shouldn't?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320202
					],
					"speakerTitle": "Fatui Oprichniki"
				},
				{
					"id": 760320202,
					"content": "...I guess I'm finding out right about now! Look, this is all a bit new to me — I'm still learning the ropes... How about you give me another chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320203
					],
					"speakerTitle": "Suspicious Person"
				},
				{
					"id": 760320203,
					"content": "Just give me one more chance — I promise you, you won't catch me next time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320204
					],
					"speakerTitle": "Suspicious Person"
				},
				{
					"id": 760320204,
					"content": "Did you take a knock to the head? We're not letting a single one of you <color=#00E1FFFF>thieving rats</color> escape!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320205
					],
					"speakerTitle": "Fatui Oprichniki"
				},
				{
					"id": 760320205,
					"content": "Listen, that girl's probably run off with everything by now. Do you really have time to be standing about arguing with the likes of me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320206
					],
					"speakerTitle": "Suspicious Person"
				},
				{
					"id": 760320206,
					"content": "There's no need for you to worry about her. You're coming with us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Oprichniki"
				}
