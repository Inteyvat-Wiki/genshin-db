			"dialogs": [
				{
					"id": 150221301,
					"content": "Ugh... Oof... Paimon's never flown that fast before... She feels ready to throw up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221302,
					"content": "At least we made it in one piece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221303
					]
				},
				{
					"id": 150221303,
					"content": "Ah-hah... just as I thought. It might look like a regular hot air balloon from the outside, but up close, it's clearly been heavily remodeled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221304
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221304,
					"content": "And sure enough, it only descended below the cloud line because the custom-built machinery malfunctioned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221305,
					"content": "Can you tell what the issue is?",
