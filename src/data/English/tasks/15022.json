						150220702
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220702,
					"content": "We're good for now. How is Puma doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220703
					]
				},
				{
					"id": 150220703,
					"content": "Hanging in there — she seems to have calmed down now. I'll check in with her again later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220704
					],
					"speakerTitle": "Xilonen"
				},
				{
