				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Puma",
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "A short while later, at Xilonen's workshop...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "I'm back. Allow me to introduce Tepal's mother, Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Hello! We're—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Save the pleasantries. I don't want to spend any longer talking about that boy than I have to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "...Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "I disowned him long ago... He is no child of mine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "All he cared about was his pipe dream of reaching the sky... We tried to talk sense into him, but he was obsessed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "Hmph... Then when he left us, he spouted some nonsense about building a workshop in the sky to avoid the constant criticism of us ground-dwellers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "He left his notebook behind. Whatever questions you have, you can look for them in there — I'm done talking about him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "He is no son of mine... He never called me \"Mom\" anyway...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "Wow, they've really fallen out... Paimon sure wasn't expecting that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Her husband, Tepal's father... he passed away recently, and Tepal didn't even bother to show his face at the funeral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "If you ask me, that was probably the final straw for Puma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "I'll go keep her company. If there's anything else you need, just come and find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Okay, so this notebook is the only lead we've got now, right? What's in there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Hmm... some early designs for the Phlogiston Wings... and some theorizing about an airborne workshop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Ochkanatlan, the Cinder City... Looks like that's where he got his technological inspiration from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "So he was serious about the workshop in the sky? But that's such a big project for one person... do we think he actually pulled it off?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "Actually, look at that balloon sketch...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "...Oh! Yes! The one from the trial arena that was super high up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "That balloon has been there for a while, and everyone's been wondering how it got up there. But... what if that's the wrong question?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "What if it started off even higher up, above the clouds and out of view, and it only descended to its current height due to some kind of malfunction?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "In other words, it could be...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "...Part of Tepal's workshop?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "Seems likely. If Tepal's base had been hiding above the clouds this whole time, that would definitely explain why Isidore couldn't find it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Paimon totally called it... But um, how do we get up there? Chasca, can you even fly that high?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "By myself... possibly. But with a passenger, no chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "I doubt even Phlogiston Wings could take you up that high... at least, not without that \"relic\" Tepal mentioned in his notebook.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "Yeah, and he's probably holding onto it... We'll have to find another way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "Can you fly up that high, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "Nope, that's waaay beyond Paimon's altitude! Also, would you really expect Paimon to go up there and take on Tepal all by herself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "Let's not worry. Just because we can't think of a solution doesn't mean no one else can. I'm not the only flying expert in my tribe, you know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Oh, good point. We should go ask Elder Allpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "And Mutota. He was quite the flying ace back in the day, too. Let's head back and see what they suggest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Haven't we seen that somewhere before?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
		{
			"id": 1502203,
