				7010206
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010206",
							"2"
						],
						"stepId": 7010206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020102,
					"content": "Any ideas about this tooth?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "A tooth? Let me see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020104,
					"content": "Hmm... Yes, it is a little unusual, both in shape and in size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020105,
					"content": "I'm no expert on obscure materials... Orban may know something though, he comes across all sorts of materials in the process of forging weaponry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020106,
					"content": "Why not go and ask him? He's right over there, you can't miss him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010207",
							"2"
						],
						"stepId": 7010207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010206",
							"3"
						],
						"stepId": 7010206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "What do you make of this tooth?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "A tooth? Ugh, don't tell me you've been foraging around on the mountain for junk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020203,
					"content": "...Huh, although, as teeth go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020204,
					"content": "What? What is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "This is a rather fine specimen. Tough as nails, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020206,
					"content": "And these contours... Looks an awful lot like Dragontooth to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020207,
					"content": "What do you mean, \"Dragontooth\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "As in, the tooth of a dragon. Weapons made from Dragontooth are supposed to be extraordinarily strong and sharp... and even possess some sort of strange power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020209,
					"content": "It's hardly the sort of thing you come across every day, though... In all the stories you hear, it's only ever the most famous heroes who manage to acquire Dragontooth and craft weapons from it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020210,
					"content": "As they say, if you plan on slaying the dragon to pinch his teeth... you'd better be sure to have a dragon-slayer of a weapon handy, or he might just bite back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020211,
					"content": "Then... is this really a dragon's tooth, or not?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "Honestly, I've never dealt with Dragontooth firsthand, so I can't give a definite answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020213,
					"content": "I do think it has to be the tooth of some enormous beast or other...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020214,
					"content": "Anyway, since you've gone to all this effort... let's just treat it as if it really is a genuine, precious piece of Dragontooth, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020215,
					"content": "Hmm, but that said — it's not enough to make a weapon from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020216,
					"content": "How about you go find, say, three more pieces of Dragontooth, and in the meantime, I'll do some reading and find out how to work with this stuff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020217,
					"content": "Oh — and <color=#00E1FFFF>Dragontooth</color> aside, we'll want to supplement it with some good ore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020218
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020218,
					"content": "In which case, while you're up on the mountain, grab 50 pieces of <color=#00E1FFFF>Starsilver</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020220
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020220,
					"content": "Ah yes, and as well as all that... I'm also going to need a <color=#00E1FFFF>Northlander Polearm Billet</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020219
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020219,
					"content": "Once you've got all of that, come and see me again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
		},
		{
			"id": 7010203,
