			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Furuya Noboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "Hmm, this is quite the headache...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630202,
					"content": "Would you know anything about this map...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "Judging by the topography, I'd say that this is some place on Seirai Island...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630204,
					"content": "How could you tell?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "The Guild has commissioned several expeditions to Seirai Island in the past.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630206,
					"content": "The adventurers who accepted those commissions would bring us intel on the island in the form of reports.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630207,
					"content": "Unfortunately, manpower issues have prevented us from launching large-scale expeditions, so we're stuck sending a few adventurers at a time to explore the area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630208,
					"content": "I'm afraid that this limits the extent to which I can continue helping you to analyze this map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630209,
					"content": "However, I do know someone who might have more to do with Seirai Island than me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630210,
					"content": "His name's Oda Tarou. I've heard that his ancestors used to live on Seirai Island before migrating here for various reasons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630211,
					"content": "Speaking of which, he did come to the Guild some time back to hire some adventurers who would accompany him to Seirai Island to see the place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630212,
					"content": "You can ask him about this map. With any luck, he might know something about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furuya Noboru"
				}
			]
		},
		{
			"id": 7216303,
			"completionStepIds": [
				7216302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216302",
							"2"
						],
						"stepId": 7216302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "*sigh* When will I find someone who'll accompany me back there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630302,
					"content": "Would you know anything about this map...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "Are you... an adventurer with the Guild? Can they finally spare the people?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630304,
					"content": "Uh, I'm just a passing traveler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "Hmm, fine, then... What's this map you spoke of?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630306,
					"content": "Now, let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630307,
					"content": "Th—This! Could it be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630308,
					"content": "What did you see?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "Isn't this Seirai Island!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630311,
					"content": "That it is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "Haha, is it really? I just guessed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630314,
					"content": "Although my ancestors once lived on Seirai Island, that was a very long time ago now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630315,
					"content": "By the time we came to my generation, we no longer had any impression of our old home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630316,
					"content": "All we have left in the house to remind us of it are three landscape paintings of the island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630317,
					"content": "So why do you want to go back?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "Well... It is still my \"hometown,\" is it not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630319,
					"content": "I feel like... I have to go see it no matter what.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630320,
					"content": "Unfortunately, I'm pretty busy running my business at the moment, so I haven't the time to go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630321,
					"content": "Additionally, I had some trouble finding adventurers willing to escort me to Seirai Island...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630322,
					"content": "So I went with Option B: putting up a commission at the Adventurers' Guild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630323,
					"content": "Hopefully, some adventurers can help me go to Seirai Island, find the three places shown in those paintings, take a few pictures with a Kamera, and bring those pictures back to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630324,
					"content": "But no one's picked up that commission thus far...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630325,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "W—Would you really? That would be amazing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630328,
					"content": "As for payment, you need not worry. I will have it ready for you for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630329,
					"content": "Well then, Traveler, I'll be counting on you. Including the map you brought, that would make four locations to take pictures of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630330,
					"content": "Well then, Traveler, please head to these four locations and snap a picture of each of them for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630326,
					"content": "I can go there for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "Ding ding, correct answer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "Is this your home?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
			"id": 7216304,
			"completionStepIds": [
				7216307,
				7216310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216307",
							"2"
						],
						"stepId": 7216307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630401,
					"content": "You're back. How's it going? Did you manage to get those pictures?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630402,
					"content": "Of course.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "Wonderful. Please, let me see them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630404,
					"content": "Um... Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630405,
					"content": "Ahaha! I can't tell where these places are at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630406,
					"content": "It does seem that those three locations have changed a lot since our family left.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630407,
					"content": "I wonder if Miss Fujiwara Toshiko will be able to recognize them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630408,
					"content": "Well, actually... I doubt it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630409,
					"content": "She's also from Seirai Island?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "More accurately, she's in the same boat as me — our ancestors both lived there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630411,
					"content": "Actually, there's a lot of us here in Inazuma City whose ancestors were once natives of the island, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630412,
					"content": "So why did you all move away?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "I don't really remember anymore... It was a very long time ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "Oda Tarou"
				},
				{
