			},
			"dialogs": [
				{
					"id": 230165001,
					"content": "Sir, I humbly suggest that we might have to... change our approach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165002,
					"content": "Change our approach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165003,
					"content": "Perhaps we might make something less complicated but equally intricate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165004,
					"content": "I believe that with your talents, making machines of this sort should be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165005,
					"content": "My dear Lutong, we have spoken of this matter before. You know my answer... but I will always respect your choices.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165006,
					"content": "Perhaps we should instead discuss where you shall have dinner with Ms. Kaia next, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165007,
					"content": "Ah, thank you, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165008,
					"content": "My pleasure, sir. Our contract has not ended yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
