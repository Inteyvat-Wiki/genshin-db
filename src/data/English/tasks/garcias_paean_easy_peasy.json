				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "My hands... Ugh! They're both numb...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160102,
					"content": "Sir, you still need to do accounts for Ms. Kaia later. Please don't exhaust yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160103,
					"content": "Not right now, Lutong! I—I am well aware!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160104,
					"content": "Of course, if you can't make it, I will stand in for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160105,
					"content": "No! I will do that myself. I am just... I just need to... forge a couple more gears...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160107,
					"content": "Okay, I give up, I just can't continue anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160108,
					"content": "What are you doing now...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "Oh, it's you, Traveler... Ouch... My hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160110,
					"content": "Well, here's the situation. Mr. Ahangar is also otherwise engaged, and so it is not possible to constantly commission him to make the parts I need...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160111,
					"content": "Moreover, the parts he makes are often ever so slightly different from those that I picture in my mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160112,
					"content": "So, to ensure the reliability of these parts, I asked Mr. Ahangar to teach me some forging skills and decided to forge the parts on my own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160113,
					"content": "Fortunately, I have acquired relevant experience in Fontaine... But some of the techniques Mr. Ahangar spoke of were just so hard to remember. Ouch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160114,
					"content": "Traveler, could you please ask Mr. Ahangar about his forging techniques? I really need some rest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160115,
					"content": "Have a good rest here, Mr. Garcia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "Thank you for being willing to help. Ugh... My hands...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160116,
					"content": "Who is Kaia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "A business partner! A... um... very talented and... rich business partner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160118,
					"content": "We have signed a long-term accounting contract with her! And that is why I've been meeting her often, as I'm certain Lutong can attest to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160119,
					"content": "That is perfectly right, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160120,
					"content": "S—So that's how things stand... Traveler, do help us find Mr. Ahangar as soon as possible. I shall be waiting here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301602",
							"2"
						],
						"stepId": 2301602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "I told you! Just wait a sec... Huh. It's you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160202,
					"content": "I'm here to ask some questions on Mr. Garcia's behalf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "So he actually went and did that himself... What a weirdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160205,
					"content": "I've been a blacksmith for a great many years. This is the first time I've encountered someone with such strict requirements.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160206,
					"content": "He even brings a ruler to measure the seam between iron tubes, and the distance between threads.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160207,
					"content": "I just can't put up with him, so I told him to do it himself... And you know what? He actually came the next day and asked me to teach him some forging skills.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160208,
					"content": "Really, there's nothing I can do about him, so I let him be. As long as he pays for the materials, I'll let him use whatever tools he wants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160209,
					"content": "*sigh* I've no idea what this guy has in mind...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160210,
					"content": "He's making a wondrous machine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "Eh, it's probably something strange, whatever it is. You're here to ask about forging skills, right? To be honest, I have nothing much to teach regarding gear forging...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160213,
					"content": "I have noticed something about the gears he wants, though. They all have sharp edges but are concave in the middle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160214,
					"content": "Molds are not enough for such specially-shaped gears, so he has to reshape the gears afterward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160215,
					"content": "I've taught him about the techniques in detail. You just need to tell him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160216,
					"content": "First, <color=#00E1FFFF>remember to add enough fuel to really heat up the fire</color> when putting it into the furnace for the second time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160217,
					"content": "Then, when you take it out to process it, <color=#00E1FFFF>hammer it from the inside out</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160218,
					"content": "Did you get all that? Alright, go back and tell him if you did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160219,
					"content": "What a weirdo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160211,
					"content": "He's making a weird machine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "Mr. Garcia's hands went numb from all that forging, and he needs rest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
