			"dialogs": [
				{
					"id": 230160301,
					"content": "Lutong! This gear is ready for demolding! Come help me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160302,
					"content": "Traveler, you're back. So, Mr. Ahangar has taught you his tricks, I trust?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160303,
					"content": "Tell me then, how should I process this gear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
