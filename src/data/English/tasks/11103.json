			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030701,
					"content": "We finished the ritual, and we followed all the instructions to the letter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030702,
					"content": "...Close enough.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030703
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030703,
					"content": "Leave the rest to me. You two get ready to greet him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030704
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030704,
					"content": "Where is one... Huh? You two look familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030705,
					"content": "What's with one's body? One feels... light. Weightless!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030706,
						111030709
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030706,
					"content": "We summoned your spirit forth with an adepti art.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "An adepti art? Hahaha! You dare don the guise of an adeptus in one's presence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030708,
					"content": "But as for the matter of one's present location... One could have sworn that one was dozing off to sleep at Wangshu Inn not a moment ago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030712,
					"content": "Wait... that must be it... of course it must! Haha, as expected of an adeptus such as oneself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030713,
					"content": "One must indeed be in a dream!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030714,
					"content": "Ugh, there's no helping this guy, is there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030715,
					"content": "Oh, you're not dreaming.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "Huh? What is the meaning of this? Do you truly think that one will permit such insolence in one's own dreams?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030718,
					"content": "...Alright, time to take him down a peg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030716,
					"content": "Dreamers, after all, feel no pain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "Guess what? You're already dead.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "Dead!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030711
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030711,
					"content": "Impossible! One was just lying in peaceful repose at Wangshu Inn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Starsnatcher"
				}
			]
		},
		{
			"id": 1110309,
			"completionStepIds": [
				1110309
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110309",
