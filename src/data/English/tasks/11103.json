				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "This censer... should be fine... right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030202,
					"content": "At least it isn't as run-down as this shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030203,
					"content": "So next... we just need to grab the Seven-Star Lamps, right? The sooner we start, the sooner we'll be done.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "Huh? Where'd he go!? He was right here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030302,
					"content": "I had presumed that once you had acquired what you came for, you would forget about me and simply be on your way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030330,
					"content": "Ah! It's that guy's voice! ...Hello? Wh—Where are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030303,
					"content": "My physical form ceased to exist over a thousand years ago. What you witnessed earlier was an illusion, created by the adepti art known as Mortal Lingering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030304,
					"content": "Now that you have taken the Seven-Star Lamps and censer used in the Mortal Lingering ritual, my form is no longer visible to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030305,
					"content": "So you're...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "I was once a junior in the order of the yakshas, bestowed with the name Pervases by Rex Lapis himself. Yet my strength failed, and I was slain in battle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030309,
					"content": "Today is the anniversary of my death. My last wish was to see a modern Liyue, and so I took the liberty of performing this ritual here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030310,
					"content": "That aside... You were sent here by the Conqueror of Demons, were you not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030311,
					"content": "So, you two know each other then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030312,
					"content": "I sense his aura upon you... that, and the heavy burden of his karma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030313,
					"content": "*sigh* Even after all these millennia, he still must endure such tremendous suffering?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030314,
					"content": "...I am truly ashamed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030315,
					"content": "Don't say that, Pervases — you sacrificed your life for Liyue, didn't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030316,
					"content": "Life is a precious thing, yes... But when I think of the burden that the Conqueror of Demons must bear... *sigh* death seems to me to have been the easy way out. A selfish indulgence, even.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030317,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030318,
					"content": "Haha, I apologize. Birthdays are joyful occasions, but by the same token, it is hard to not be melancholy on the anniversary of one's death.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030319,
					"content": "The Mortal Lingering will not last much longer. Take care, you two, and please pass on my regards to the Conqueror of Demons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030320,
					"content": "We will!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "*sigh* If only I could taste some authentic Grilled Ticker Fish once more...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030323,
					"content": "By wave and storm I hunt for fish, by wind and snow I slay evil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030325,
					"content": "Huh? Looks like he's gone, then... Paimon really hopes that at least someone will remember Pervases the Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030326,
					"content": "We should get going. But let's come back here and make an offering sometime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030321,
					"content": "You take care too, Pervases...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030306,
					"content": "Y—Y—You're a g—g—ghost?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030307
					]
				},
				{
					"id": 111030307,
					"content": "Haha... It is not untrue to say this. The line between adepti and ghosts is a fine one indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110305,
			"completionStepIds": [
				1110316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110305",
							"2"
						],
						"stepId": 1110305,
						"stateName": "QUEST_STATE_UNFINISHED"
