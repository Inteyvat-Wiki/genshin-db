			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pervases"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "The spirit soars the mountains high, while the body rests as the world goes by...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030102,
					"content": "Um... Sorry to interrupt you, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030103,
					"content": "We'd like to borrow a censer and some lamps.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "Well I'll be... Isn't that something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030105,
					"content": "A pair walk into a shrine, neither to seek nor worship gods or adepti, but to pilfer the tools of worship for their own ends. Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030106,
					"content": "We know it's rude to ask, but we just need them for a short while — honest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030107,
					"content": "For the Dream Trawler ritual, I trust?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030108,
					"content": "Wha— How'd you know that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030109,
					"content": "I have been in this shrine for far longer than you would expect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030110,
					"content": "Perhaps as a reward for my faithfulness, I have been endowed with some understanding of the adepti arts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030111,
					"content": "Wow. Paimon's never heard of that happening before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030112,
					"content": "Ah, it matters not. Take what you need. It is a fortuitous thing that these items may be of service to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030113,
					"content": "...They served little purpose here, in any case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030114,
					"content": "Something on your mind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "Heh, nothing that you need concern yourself with. Please, take what you wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030116,
					"content": "Well... thanks, then!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "You are quite welcome. Please, take what you wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
