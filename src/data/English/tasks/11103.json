						],
						"stepId": 1110309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030901,
					"content": "P—Please, stop! I surrender, I surrender! Argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030902,
						111030904
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030902,
					"content": "So, do you believe us now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030903
					]
				},
				{
					"id": 111030903,
					"content": "Yes! Yes, I do! I thought I was going to die...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030906,
					"content": "How did I ever have the misfortune to meet you two...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030907
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030907,
					"content": "Please, great adepti, spare my life. I won't do this ever again, I swear it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030908
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030908,
					"content": "We did call your spirit here, but we're not adepti. He, however, is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030909,
					"content": "You deceive the masses with quackery, masquerade as an adeptus, exorcise demons without exterminating them, and display a callous lack of regard for life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030910,
					"content": "One day, you will reap that which you have sown... For those who invite the infernal into their lives, there is no redemption!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030911,
					"content": "Ah... I... You're...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030912
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030912,
					"content": "Seems like Xiao's got him scared stiff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030913,
					"content": "O great adeptus... might I ask your name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030914,
					"content": "He is the Conqueror of Demons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "It really is you! It's truly you! Never in my life did I imagine that I might meet the Conqueror of Demons, the Vigilant Yaksha himself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030917,
					"content": "You know about Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030918,
					"content": "Of course! My grandfather was a folklorist — I learned the tales of the Conqueror of Demons at his knee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030919,
					"content": "To this day, I am an avid collector of books concerning the yakshas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030920,
					"content": "But ever since I discovered a Sigil of Permission while rummaging through my grandfather's personal effects...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030921,
					"content": "At first, I was just imitating the adepti for fun... but slowly I began to stray further and further from the righteous path...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030922,
					"content": "Huh, so to sum you up... you're Xiao's biggest fan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "Y—Yes. Thank you both for allowing me to witness the Conqueror of Demons in the flesh — it's like a dream come true!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030924,
					"content": "Uh, that wasn't quite our intention...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Please allow me to swear this oath before the Great Conqueror of Demons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030926,
					"content": "I swear to turn away from evil, to live an honest life, and to never again stain the name of the adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030927,
					"content": "I will remember your oath... Now go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Thank you... A thousand thanks for your forgiveness... and for all that you have done for Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111030929,
					"content": "He seemed very earnest when he was making that oath there. Guess he won't be tricking anyone anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "Oh, wait! We haven't gotten the Sigil of Permission back yet. Let's head over to Wangshu Inn first thing tomorrow and look for him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "He is the Vigilant Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "So, are we still going to do this \"oneself\" song and dance?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "N—No, no, never again! Y—You almost killed me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Starsnatcher"
				}
			]
		},
		{
			"id": 1110310,
			"completionStepIds": [
				1110310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110310",
							"2"
						],
						"stepId": 1110310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111031001,
					"content": "Hey there, Boss. Starsnatcher's staying here, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031002,
					"content": "Starsnatcher... Hm... You mean the false adeptus who wore a mask?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031003
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031003,
					"content": "He signed in here under the name Wang Ping'an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031004,
						111031005
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031004,
					"content": "That's a... really normal name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				},
				{
					"id": 111031006,
					"content": "He's already checked out. He said he wished to go on a solo pilgrimage...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031007
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031007,
					"content": "Ah, yes. He also requested that I give this letter to a traveler who journeys together with a \"talking fairy\"... should they come asking for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031008
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031008,
					"content": "Talking fairy... Who's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031009,
					"content": "...Well anyway, you must be the traveler. Here's the letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031010
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031010,
					"content": "How strange that he would leave a letter for us. Is this the final attempt to fool us, maybe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031011,
					"content": "Come on, open it! Paimon's curious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031019,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031012,
					"content": "Huh, seems like he actually left us a few nice trinkets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031013,
					"content": "Along with... Woohoo! The Sigil of Permission!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031014,
					"content": "Paimon hasn't met a bad guy like him in a long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031015,
						111031016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031015,
					"content": "I'm actually quite touched...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031017,
					"content": "Yeah... Anyway, let's go take this Sigil of Permission to Xiao, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031016,
					"content": "This is all thanks to Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031005,
					"content": "So a really, really ordinary person after all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				}
			]
		},
		{
			"id": 1110311,
			"completionStepIds": [
				1110311
			],
