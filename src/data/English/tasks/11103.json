					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111031101,
					"content": "Ah! There you are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031102,
					"content": "We got the Sigil of Permission back. Do you wanna take it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031103,
					"content": "You have my thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031104,
					"content": "May I take your order, sir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031105
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031105,
					"content": "One Grilled Ticker Fish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031106
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031106,
					"content": "Certainly, we'll prepare it for you immediately!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031107
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031107,
					"content": "Huh? No Almond Tofu this time? Well that's not like Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031108,
					"content": "Ticker Fish was Pervases' favorite dish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031109,
					"content": "I just wanted to... see how it tastes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031110,
					"content": "Huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031111,
					"content": "By wave and storm I hunt for fish, by wind and snow I slay evil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031112
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031113,
					"content": "Was there anything else? I... am accustomed to eating alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031114,
						111031115
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031114,
					"content": "We'll leave you be, then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				},
				{
					"id": 111031116,
					"content": "Uh huh! And so, Detective Paimon and the trusty Traveler solved the case, and quietly slipped away...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031115,
					"content": "Come on, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				}
			]
		},
