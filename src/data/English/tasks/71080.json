				{
					"id": 710800615,
					"content": "My, oh my. This is great. This is perfect! Give me a moment, let me write it all down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800616
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800616,
					"content": "\"The dark fog pressed in like an avalanche, and the two apostles of the Abyss, now separated, disappeared without a trace, just as they had appeared...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
