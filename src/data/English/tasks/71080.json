				"points": []
			},
			"dialogs": [
				{
					"id": 710800601,
					"content": "This might seem a little sudden, good hero, but could you spare a moment to tell me a story or two of yours for me to turn into songs for those who come after?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800602,
						710800603
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800602,
					"content": "Well, if you just need me to tell you stories...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				},
				{
					"id": 710800604,
					"content": "I would be most grateful if you were to agree! Well then, fire away! I'm listening.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800603,
					"content": "I've got a ton of stories to tell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				}
			]
		},
