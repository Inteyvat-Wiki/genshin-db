					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710800622,
					"content": "Tell of the fluorescent fungi in the caves...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800623
					]
				},
				{
					"id": 710800623,
					"content": "You tell Taliesin of the things that happened...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800624
					]
				},
				{
					"id": 710800624,
					"content": "Fascinating... Almost unthinkable, really... Let me think for a moment before I say anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800625
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800625,
					"content": "\"And though it be a giant mushroom towering unto the sky, it was helpless before the encroaching dark...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800626
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800626,
					"content": "#\"Answering the call, {NICKNAME} came forth, purifying the land and staving the crisis off...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
