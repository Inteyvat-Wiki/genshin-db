					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710800634,
					"content": "Tell of your search for your kin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800635
					]
				},
				{
					"id": 710800635,
					"content": "You tell Taliesin of the things that happened...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800636
					]
				},
				{
					"id": 710800636,
					"content": "That is... fascinating indeed. An ancient, forgotten land, sacrifices that went unacknowledged, and an unjust punishment to fall into folly... What huge themes! What an expansive tale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800637
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800637,
					"content": "And to think that such stories are things that you've encountered in your travels, and that are so very close to your own aims...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800638
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800638,
					"content": "Thank you for sharing all these with me. I will record them down. That said, I don't believe that I shall compose a poem from them yet... I believe that these will only be small fragments of your saga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800639
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800639,
					"content": "I will not tell your tale with the limited skill that I have... I ask only that you tell me of your journey once it is complete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800640
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800640,
					"content": "My intuition tells me that when that day comes, my ears shall be blessed with the most heroic tale known to this world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
