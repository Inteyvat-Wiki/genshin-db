				{
					"id": 710800641,
					"content": "Tell of the Fatui who met with a crisis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800642
					]
				},
				{
					"id": 710800642,
					"content": "You tell Taliesin of the things that happened...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800643
					]
				},
				{
					"id": 710800643,
					"content": "Haha! That's such an interesting story! \"'A bitter day this is, that we should be saved by our great foe!' Serzhant Anton exclaimed with a sigh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800644
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800644,
					"content": "\"Yet those who meet as friends today, tomorrow may meet as foes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		}
	]
