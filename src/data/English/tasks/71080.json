					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710800629,
					"content": "Tell of the nine Black Serpent Knights...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800630
					]
				},
				{
					"id": 710800630,
					"content": "You tell Taliesin of the things that happened...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800631
					]
				},
				{
					"id": 710800631,
					"content": "This... This is wonderful! \"And so, the fated Traveler said: 'Forget coming at me one by one. I could take all nine of you on at once!'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800632
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800632,
					"content": "Uh, that's a bit of an exaggeration...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800633
					]
				},
				{
					"id": 710800633,
					"content": "It's alright... Now, if you'll allow me, I might exercise some creative license with the former lives of those nine swordsmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7108017,
