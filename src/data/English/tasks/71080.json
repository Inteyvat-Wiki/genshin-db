				"points": []
			},
			"dialogs": [
				{
					"id": 710800701,
					"content": "Thank you for helping me finish this epic poem... Ah, yes. Please, take this copy of my manuscript as thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800702,
					"content": "Phew... This epic manuscript carries both my emotions and ambitions. Please, take it. It is what little I can do to repay you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7108008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
