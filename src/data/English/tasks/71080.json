				"objectNames": [
					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710800617,
					"content": "Tell of the azure crystal you found in the depths of the Chasm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800618
					]
				},
				{
					"id": 710800618,
					"content": "You tell Taliesin of the things that happened...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800619
					]
				},
				{
					"id": 710800619,
					"content": "\"The skies and the waters alike flowed across the crystal's surface, and the purple and red splotches faded...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800620
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800620,
					"content": "#\"The ancient creature of the ruins reeled, having taken a blow from {NICKNAME}'s iron fist, and it was at this moment that the star of the show arrived!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800621
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800621,
					"content": "\"...The mysterious ally that came to the Traveler's aid had vanished without a trace, but the giant construct serpent had already been shattered to pieces by the crystal...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7108015,
			"completionStepIds": [
