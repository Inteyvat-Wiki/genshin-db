			"dialogs": [
				{
					"id": 1903201201,
					"content": "Ugh... I'm beat. Finally, I can take a break.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201202,
					"content": "*sigh* I wonder if I took things a little too far... A few people seemed scared out of their minds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201203,
					"content": "Who are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "Huh? Hey, you shouldn't be here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201205,
					"content": "*sigh* Never mind. I assume you overheard me anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201206,
					"content": "I work here pretending to be a ghost, but now's my break time, so I took off my costume. I get all hot and stuffy wearing that thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201207,
					"content": "So there are no real ghosts here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "Of course, how could there be real ghosts here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201210,
					"content": "No one wants to see a real ghost, neither us nor the participants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201211,
					"content": "They just come here for the atmosphere, or should I say, the chance... Everyone wants the chance to feel the thrill of excitement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201212,
					"content": "When people find themselves in a scary situation, they'll say things that they'd never dare to otherwise. That's what the Test of Courage is all about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201213,
					"content": "I think I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "*sigh* Okay... I should get back to work now. Hope you and... whoever you're here with have a fun time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201214,
					"content": "(Chongyun will be very disappointed.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "It's all planned to scare people, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
}