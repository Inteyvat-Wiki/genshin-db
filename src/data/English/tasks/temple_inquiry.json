					"content": "I'm ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480502
					]
				},
				{
					"id": 722480502,
					"content": "Then I wish you... every success in your battle ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
