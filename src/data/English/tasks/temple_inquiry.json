		},
		{
			"id": 7224802,
			"completionStepIds": [
				7224804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224804",
							"2"
						],
						"stepId": 7224804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480201,
					"content": "Ah, if only Byakuyakoku had such valiant warriors as you! Then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480202,
					"content": "*sigh* If this thing is done, then my wishes shall be fulfilled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480203,
					"content": "You must bring these offerings bearing my thoughts to be enshrined... in the place where I was held under arrest. We must do this, in order to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480204,
					"content": "In order to what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480205,
					"content": "In order to... In order to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480206
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480206,
					"content": "Ugh, there's no use talking to this guy now. Seems like his spirit's all messed up again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480207,
					"content": "#{NICKNAME}, let's just take those items with us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480208,
					"content": "But where was this high-up place where this guy was imprisoned?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224803,
			"completionStepIds": [
				7224805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224805",
							"2"
						],
						"stepId": 7224805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "Here comes one of those spirits...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480302,
					"content": "My name is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480303,
					"content": "Aberaku, Helios-Forger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480304,
					"content": "How could I have been felled by your vile slander, or imprisoned by your puppet infants!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480305,
					"content": "I— No, wait. I was imprisoned for months and years beyond count, was I not? Then... This must be my post-life form?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480306,
					"content": "\"Post-life form\"? You mean that you're already dead, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480307,
					"content": "Takes a pretty rare spirit to realize that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480308,
					"content": "And yet, though it shames me to say so, I know not just how I died...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480309,
					"content": "But I recall that I was imprisoned on orders from a child.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480310,
					"content": "A child?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480311,
					"content": "Indeed. But till today, I can never feel any hatred for that child, only pity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480312,
					"content": "He was not at fault. The blame should fall upon those who controlled him like a puppet in their palms... Forget it. Such things are best left unsaid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480313,
					"content": "After that, I was imprisoned...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480314,
					"content": "Imprisoned in a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480315,
					"content": "In a...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480316,
					"content": "In a very high place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480317,
					"content": "But though it was high up, it was dark, lightless, and cold as the ice itself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480318,
					"content": "...Strange. Why is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480319,
					"content": "Why do I feel that a high place should have brought a person warmth and comfort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480320,
					"content": "Why... Why can't I remember any of this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480321,
					"content": "Are you hungry, maybe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480322,
					"content": "Whenever Paimon's famished, forget thinking, she can barely even talk straight!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480323,
					"content": "I don't think that's his issue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "Come on, it's gotta be! Look at him, he can hardly speak clearly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480327,
					"content": "#Actually, {NICKNAME}, could you check if there's something to eat amongst the offerings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480328,
					"content": "Wait! That's it! The offerings!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480329,
					"content": "What, do you wanna eat them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480330,
					"content": "No, I just remembered...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480331,
					"content": "When I died in prison, my attire and body were enshrined in various places due to my contribution in creating the Helios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480332,
					"content": "But that also caused my spirit to be separated and rendered unable to rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480333,
					"content": "This place should have been the resting place of my sacred crown, though it has surely decayed by now. This must surely be why my thoughts are so... stuck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480334,
					"content": "If this persists, I doubt that even my current state can be sustained for long...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480335,
					"content": "But these offerings can be used to replace the remnants of my body and my attire in sustaining an ounce of my thoughts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480336,
					"content": "As such, please take them with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480337,
					"content": "However, there are many perils on the enshrining path. So though it may seem rude of me, could you accept a certain test first?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480338,
					"content": "Test? What test?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480339,
					"content": "Please defeat the monsters hereabouts, the prison wardens of my spirit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480340,
					"content": "This matter is perilous. Tell me once you are ready, O Traveler, and we shall begin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480325,
					"content": "Well, it just so happens that we have some emergen—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
