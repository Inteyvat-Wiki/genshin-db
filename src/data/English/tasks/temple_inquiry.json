					"content": "I need a while more to prepare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480602
					]
				},
				{
					"id": 722480602,
					"content": "Then I shall await your tidings.",
					"roleType": "TALK_ROLE_NPC",
