				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790041201,
					"content": "Hello, friend. Is there anything I can do for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041202,
					"content": "Are you a researcher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790041203,
					"content": "Haha, I suppose I count. Strictly speaking, I am a \"wandering scholar,\" but I suppose that is merely a subset of \"researcher.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041204,
					"content": "Well, then. Have you encountered a problem that you need a \"researcher\" to help solve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041205,
					"content": "Well, here's what happened...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "Islands out at sea... and murals that you found there. How fascinating.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041207,
					"content": "So you're looking for a researcher who can help you decipher those murals, I gather?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041208,
					"content": "Are you willing to help us out?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "Of course, I have never rejected an opportunity to study the unknown.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041213,
					"content": "Now then, let us not delay. Could I have a look at those murals?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041214,
					"content": "Here are the ones we recorded down.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "Oh, not bad, not bad at all. My apologies, please give me a moment to think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041210,
					"content": "We can pay you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "Hahaha. From the look of things, you must be highly-experienced adventurers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041212,
					"content": "However, I would say that these stories of the unknown are the greatest possible remuneration for me. You need not pay me anything else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				}
			]
		},
