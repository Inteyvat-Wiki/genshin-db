			"dialogs": [
				{
					"id": 790040101,
					"content": "Hmm? Look, there's some sort of... drawing on this stone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 790040102,
					"content": "Looks like a ship with lots of people on it... meeting a disaster at sea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "Observe"
				},
				{
					"id": 790040103,
					"content": "Paimon can't read this very well... Either way, let's make of note of this mural first, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Observe"
				}
			]
		},
