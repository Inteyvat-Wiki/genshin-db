			"dialogs": [
				{
					"id": 741140101,
					"content": "No problem. Our box is waterproof. All we need to do is dive down and fetch it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140102,
					"content": "Boss, none of us here knows how to dive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "I know how to swim, but diving's beyond me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "Is... is the commission we posted at the Adventurers' Guild still on the board?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140105,
					"content": "Boss, didn't you say before that we should hurry up and take the commission down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "We did that yesterday. The guild said they can return us our prepaid commission posting fee today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Uh... If we want to send out a commission again, are we going to need to pay an additional service fee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140108,
					"content": "Have you guys finished your film?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#Adventurer... {NICKNAME}! You came right when we needed you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140111,
					"content": "Can you dive? Or... can you help me find a diver with the ability and time to do a dive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140112,
					"content": "You want to... do an underwater shoot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "We're hardly that capable. We also can't afford water-proof film equipment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "It's purely because the box we put our films in fell into the water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#Alright, that's enough you two! {NICKNAME}, you gotta help us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140116,
					"content": "Don't worry about the payment. I'll pay you upfront, just like last time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140109,
					"content": "What are you guys doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
