					"content": "*sigh* I hope the films won't be damaged by the water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140202,
					"content": "Don't worry Boss, the box is sealed tight. The water won't be getting in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140203,
					"content": "Good thing our Film Kamera didn't fall in. Otherwise, it would be a total flop...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingye"
				}
