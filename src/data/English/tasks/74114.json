			"dialogs": [
				{
					"id": 741140401,
					"content": "This pot is pretty strange. Hmm... but it should be used the same way as the ones in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140402,
					"content": "Boss, I got the veggies, but they're all out of Marcotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140403,
					"content": "I couldn't find any other store that sells it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140404,
					"content": "#That's... the last ingredient we needed. Well, uh, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140405,
					"content": "I'll go fetch it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "Thanks for your help. Don't worry, I know how adventurers work. This isn't a free favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140406,
					"content": "Include this with the payment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
