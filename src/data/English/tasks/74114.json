			"dialogs": [
				{
					"id": 741140301,
					"content": "#Aha! You're the best, {NICKNAME}. You're the absolute best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140302,
					"content": "If it weren't for you, everything inside the case would have been lost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140303,
					"content": "We need to get back to the city and give these films to Mr. Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140304,
					"content": "#And then... let's have a meal together. {NICKNAME}, if you're interested, you can come too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140305,
					"content": "After we finish eating, I'll pay you your reward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140306,
					"content": "Alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Alright! It's settled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, bring the films in this box over to Mr. Geisert later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, go get some good greens from nearby. I've been practicing my Poisson Seafood Soup, and it's time to show it off to Mr. Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140311,
					"content": "Boss, we're already going to the restaurant. Why do you still get to do things yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "So that we can save costs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140313,
					"content": "Ahem! It's settled. Let's get going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, you can follow me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ms. Qiu"
				},
				{
					"id": 741140307,
					"content": "Well, I just happen to be hungry.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
