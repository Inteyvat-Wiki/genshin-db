	"talks": [
		{
			"id": 2001401,
			"completionStepIds": [
				2001401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2001401",
							"2"
						],
						"stepId": 2001401,
