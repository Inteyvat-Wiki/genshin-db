					"content": "I'm leaving Anna in your care, Traveler. Please make sure that she doesn't come to any harm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140402
					],
					"speakerTitle": "Anthony"
				},
