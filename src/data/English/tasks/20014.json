				"points": []
			},
			"dialogs": [
				{
					"id": 200140201,
					"content": "Wow, you beat them all down — you made it look pretty easy, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "It's just as the handbook says — you can use all sorts of ways and means to beat monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Still, I've got to admit that they still scare me when they're this close. It's a good thing we've got you around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "You still need more training.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Yup, I know. The road to becoming an adventurer is far from easy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "Thank you, Traveler! I'll head back to the city now. I'm sure my brother's worried sick by now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "I've got to train harder from now on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
