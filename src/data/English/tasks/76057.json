			"dialogs": [
				{
					"id": 760570101,
					"content": "How about a team battle next time? Or maybe some kind of versus match? Oh, it's you guys! Welcome to the training ground!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "About the training ground...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "More and more folks have been showing up lately. That's all thanks to you. And of course, the kids and The Hollowhands did their part too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "I think the training ground might just be the perfect place for get-togethers. When you bump into someone you haven't seen in ages, it's hard to know where to start the conversation, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "About The Hollowhands...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Ah... I still haven't found anything that works better than my targets for lining their nest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "The kids and I have tried all kinds of materials, but they just really like the targets. So for now, trading with them is still our only option...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "But we've kinda cracked their treasure exchange rates, and we've been making a pretty good profit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "I'll drop by again sometime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "You're welcome anytime! And remember, for you two, it'll always be free!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
		{
