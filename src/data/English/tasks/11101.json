			"dialogs": [
				{
					"id": 111011201,
					"content": "About karma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011202
					]
				},
				{
					"id": 111011202,
					"content": "The book says that the yakshas, after fighting against the wrath of the gods for thousands of years, became bound by karma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011203,
					"content": "Poisoned by the hateful thoughts of the gods, the yakshas would often descend into indescribable fits of terror, rage, or agony...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011204,
					"content": "*sigh* It's so tragic... After everything they went through in all their years of protecting Liyue, they got no reward, and had to deal with so much suffering instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
