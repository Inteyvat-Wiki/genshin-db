				"points": []
			},
			"dialogs": [
				{
					"id": 111010501,
					"content": "Flee at my command, foul demons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010502
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111010502,
					"content": "...Flee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010503
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111010503,
					"content": "Wh—Why won't you flee?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010504
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111010504,
					"content": "Beru nye! Beru nya! Beru nyaaaa!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010505
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 111010505,
					"content": "Uh-oh, looks like Starsnatcher's in trouble!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010506,
					"content": "And there are innocent bystanders here, too. We have to step in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110107,
			"completionStepIds": [
