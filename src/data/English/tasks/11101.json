			"dialogs": [
				{
					"id": 111011101,
					"content": "About demons...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011102
					]
				},
				{
					"id": 111011102,
					"content": "The book says that the wrathful spirits of the gods defeated during the Archon War can sometimes cause plagues, monsters or mutations...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011103,
					"content": "All of which sound pretty horrendous. Hey, wait a second... Paimon wonders if...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011104
					],
					"speakerTitle": "Paimon"
				},
				{
