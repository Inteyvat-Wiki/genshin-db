					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010223,
					"content": "Huh. Since when did that old chestnut become a best-seller?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010224
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010224,
					"content": "You're a rare breed of youngster if this is what you like to read... But you should be able to find a copy somewhere on that desk over there.",
