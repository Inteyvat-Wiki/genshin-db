				"objectNames": [
					"Starsnatcher"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111010701,
					"content": "I don't get it... Why didn't the Sigil of Permission do anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111010702,
					"content": "Has the evil aura of these hilichurls grown in intensity?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111010703,
					"content": "Sigil of Permission, huh? Now why does that sound familiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "Ah yes, the get out of Jueyun free card...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "Right! It's a keepsake of the adepti, so it must still contain traces of their power!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "*gasp* No wonder he was able to scare those monsters away earlier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "Wh—What are you two babbling on about? One is merely underslept... meaning that one's adeptal power... is not in full flow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111010709,
					"content": "Were one but given another opportunity...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111010710,
					"content": "Well as it happens, there goes another bunch of evil hilichurls over there. Should we leave them to you, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "I— O—One... suddenly feels ill at ease. Surely one has overexpended one's adeptal powers, otherwise, one would surely purge these infernal beings at once...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Starsnatcher"
				},
				{
					"id": 111010712,
					"content": "Ugh, so you WERE just bragging after all. We were right to be suspicious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
					"content": "Come on, Traveler, looks like it's up to us. Use your Elemental Sight and hunt them down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010705,
					"content": "So that's what he was using for his exorcisms...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
		},
