					"nextDialogs": [
						111011303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011303,
					"content": "Do you think that it could have anything to do with that Starsnatcher guy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011304,
					"content": "Hm... No, surely not. He doesn't exactly give off the impression that he's been suffering for thousands of years...",
