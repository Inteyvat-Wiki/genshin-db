			"dialogs": [
				{
					"id": 752520601,
					"content": "You were a guest in the bar. We've met.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520602
					]
				},
				{
					"id": 752520602,
					"content": "Have we? Guess that's why you look familiar. I've met a lot of people today, so I don't really remember the faces... but that isn't important right now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525207,
			"completionStepIds": [
				7525205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
