			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "What's important is whether you've seen a bald-headed guy around here? I have something to talk to him about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520702,
					"content": "That sounds like the person I'm looking for.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Oh, was he here just now? I guess he must have seen me coming...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520709,
					"content": "Hmph. I'll get you for this, Icahua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520706,
					"content": "Since we've met before and you seem alright, I'll warn you to steer clear of that follicly deficient rascal and me — otherwise, that pretty face of yours might end up covered in red and white paint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520707,
					"content": "These are the things I found in his camp. I'm guessing he didn't have time to take them with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520708,
					"content": "They're yours now. Don't worry, he's already forfeited any right to object.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520710,
					"content": "Sooner or later, his life will be mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520703,
					"content": "I haven't seen him, sorry.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "Are you telling me the truth? I'm inclined to trust that honest face of yours — for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				}
			]
		}
	]
