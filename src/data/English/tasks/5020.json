				"points": []
			},
			"dialogs": [
				{
					"id": 50202001,
					"content": "Atea... is an elder I deeply respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202002,
					"content": "After my grandfather died, the elders voted for me to become the chief of our tribe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202003,
					"content": "I always have a lot of new and crazy ideas, so everyone believed I could lead our tribe towards a different kind of future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202004,
					"content": "For a long time, though, I had no idea what to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202005,
					"content": "But, Atea was always there to encourage me. Even when I made mistakes, she never made me feel bad for messing up. She'd help me analyze what went wrong and help me do better next time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202006,
					"content": "She's someone I really respect, so... I'll remember what she taught me, and work hard to become the chief our tribe deserves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amina"
				}
			]
		}
	]
}