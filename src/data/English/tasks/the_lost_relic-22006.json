					"nextDialogs": [
						220060704
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060704,
					"content": "It must never be given to thieves to sell for petty cash. As well as dishonoring a precious relic, it's trampling all over history.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060705
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060705,
					"content": "I refuse to back down before people who treat history, and its relics, like trash.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060706,
					"content": "I want to know more about the jade plate.",
