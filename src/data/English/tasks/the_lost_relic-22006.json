			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060101,
					"content": "I can't find it anywhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060102,
					"content": "What did you lose this time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "Oh, this time I haven't lost anything yet — I'm still looking for it! But I can't find it anywhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060104,
					"content": "Where could it be? After all the effort I've gone to to confirm its whereabouts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060105,
					"content": "Help me search for it, would you? We can't let something like this stay lost!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060106,
					"content": "Alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "Okay, you take that side, I'll take this side.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060109,
					"content": "We have to find it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060107,
					"content": "What kind of relic is it this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "It's... uh, it's an... It's really ancient, anyway! Dates back a thousand— no, all the way back to the Archon War, in fact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060111,
					"content": "Basically, it's a very precious relic and it simply cannot stay lost! So help me find it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
