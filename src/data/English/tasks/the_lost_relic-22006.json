			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "Thank you, Traveler! That was terrifying... the Treasure Hoarders are such savages these days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "Who are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "I'm Soraya, a visiting scholar. I'm actually doing some research as we speak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "A few days ago I followed a trail of clues to a ruin, where I found a jade plate that recorded details from the Archon War.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "But I was ambushed by the Treasure Hoarders on my way out. I tried to run away, but they caught up with me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "If not for you, both I and the jade plate would have been in big trouble. So thanks again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "You're a scholar, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "...You mean, you've met other scholars around here? Like who?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao'er...? Wait a second... Just now, when I was ambushed by the Treasure Hoarders, I heard someone complaining about Bao'er hogging all the treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "What a strange coincidence... Could you tell me a little more about the Bao'er you met?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "Here's what I remember...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "...Hmm. The locations Bao'er pointed out to you are the same ones I was targeting. Maybe this coincidence is not so coincidental after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "If she really is with the Treasure Hoarders, then I suspect they must have been following me around for some time... Hoping to get at some fresh ruin treasure via me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Bao'er wanted it all for herself, so she split off from the group and tried to get ahead. But this area is much too big for one person to search, so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "It seems like she used you, Traveler. And I'll bet that she had her eyes set on this location for a long time — it's just her comrades and I got there before you did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "Don't be alarmed, this is still just guesswork. But Bao'er... it's just a suspicious-sounding name. It could just be a fake name, or maybe a codename.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "Traveler, could you throw her off the scent? Whatever happens, this jade plate cannot get into the wrong hands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Thank you. Although, she'd probably sense something was up if you went back empty-handed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "How about this — here's a little something you can give her instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "Barely enough for her to make a profit on. But hopefully enough to avoid her suspicion for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "Okay, you'd best get back. You may have just beaten the living daylights out of her comrades, but if she's traveling alone she shouldn't get word of it right away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "Oh, and if you find something on any of her future treasure hunts, you can bring it to me. I'm usually at the Wangshu Inn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "*sigh* ...I might not be good for a lot of things, but if I can keep a historical relic safe then at least that's something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "If I return empty-handed, she'll get suspicious...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Good point... In that case, take this. It's nothing of anything value, really.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "Barely enough for her to make a profit on. But hopefully enough to avoid her suspicion for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
