			"dialogs": [
				{
					"id": 207411001,
					"content": "Have you gathered the Dandelion Seeds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411002
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411002,
					"content": "Have them right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "These should be enough. Please wait here for a moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411004,
					"content": "...Lord Barbatos, please hear me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411005,
					"content": "Wow, she's so... devout. So... many words...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411006,
					"content": "Who knows if that Tone-Deaf Bard is listening...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411007,
					"content": "Alright. Please take these dandelions seeds. Help me go up and scatter them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411008,
					"content": "I should really do this myself, but with my physical abilities... I would probably have a hard time getting back down, even if I could climb up there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411009,
					"content": "So I'm counting on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
