			"dialogs": [
				{
					"id": 207412001,
					"content": "Have you scattered the Dandelion Seeds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412002,
						207412003
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412002,
					"content": "I've done just that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412005
					]
				},
				{
					"id": 207412005,
					"content": "Regardless, I do hope that Lord Barbatos will be able to hear my voice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412006
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412006,
					"content": "Thank you for your willingness to help. Please take this for your troubles — and may the Anemo Archon protect you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 207412003,
					"content": "The wind will carry them far abroad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412004
					]
				},
				{
					"id": 207412004,
					"content": "That's wonderful. It should be easy for Lord Barbatos to notice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412005
					],
					"speakerTitle": "Grace"
				}
			]
