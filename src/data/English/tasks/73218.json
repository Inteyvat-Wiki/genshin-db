			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "As an entrance to Sumeru, Caravan Ribat is a critical pass. This Bulletin Board is established to inform merchants and tourists of important matters. Please heed the notices on the board often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "\"My love, though you are so far away from me, my heart belongs to you as always.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180202,
					"content": "\"I know. You have more important things to attend to. After all, the higher position you are in, the more responsibilities you shoulder.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180203,
					"content": "\"But I couldn't share with anyone the thing that is troubling me so deeply. I couldn't tell them your name.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180204,
					"content": "\"I hope one day I'll be able to let everyone know how learned and wise you are.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
