					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Researchers who stay in Caravan Ribat for a long time must register with the Mahamata before checking in at the hotel to avoid knowledge leakage and other unexpected happenings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Merchants and travelers must register with the Mahamata for approval to cross the border.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180902,
					"content": "It is forbidden to carry unregistered goods or contraband goods prohibited from import and export. Any cargo in violation will be confiscated and related parties will be expelled into the desert in accordance with the regulations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180903,
					"content": "In addition, residents of Aaru Village can cross the border with the clearance issued by the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321810,
			"completionStepIds": [
				7321810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321810",
							"2"
						],
						"stepId": 7321810,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "\"Desert adventure package for sale. Offering the most caring desert adventure solutions for merchants and travelers.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181002,
					"content": "\"For those who purchase the package, we guarantee that you will safely return from your trip. We are liable for a ten-time fine for any counterfeit sold. Pre-order now to enjoy a discount!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
