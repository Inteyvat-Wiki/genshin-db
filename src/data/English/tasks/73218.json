			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Adventurers going to the desert, please note that all adventures to the Great Red Sand must be registered at the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181302,
					"content": "Relics found in the desert belong to Akademiya in principle, and no one shall take possession of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181303,
					"content": "Due to security concerns, a ban on access to desert areas excluding the Sea of the Great Red Sand has been issued by the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181304,
					"content": "Akademiya assumes no responsibility for any accidents in the areas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321814",
							"2"
						],
						"stepId": 7321814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
