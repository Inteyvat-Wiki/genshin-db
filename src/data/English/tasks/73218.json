			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "To the Great Red Sand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180302,
					"content": "Those who do not revere the deceased shall stay here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "The Akademiya strictly forbids destruction in any form of the Wall of Samiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180402,
					"content": "Any violation will be severely punished.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "\"Preserved fruit, dessert ingredients and other desert specialties on sale.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180502,
					"content": "\"Delivery is available for large-quantity orders.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180503,
					"content": "\"This looks good. I could make Dango with it. Can you deliver it to Inazuma?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180504,
					"content": "\"My apologies. Cross-border delivery is only available to Liyue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Although it seems there's no need for Gilded Journey to advertise as it's the only hotel in Caravan Ribat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180602,
					"content": "Our barbecue is savory with the authentic tinge from the desert. Way more authentic than in the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180603,
					"content": "Exhausted travelers, be sure to come for a taste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "\"I hope the Mahamata considers tightening customs restrictions at Caravan Ribat.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180702,
					"content": "\"Now any desert folk can pass through the border, giving bandits the chance to flee into the jungle for a hide and taking jobs away from people in Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180703,
					"content": "\"The Akasha has not been available to the desert folk, but commissions issued by Citadel of Regzar cover way more than mercenaries. If it goes on like this, even all sit in for the entrance exam for the Akademiya, some will lose their jobs anyway.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180704,
					"content": "\"What are you talking about? The desert folk are the people of Greater Lord Rukkhadevata, and they are people of Sumeru as well. It is only natural that they are allowed to enter the city.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732180705,
					"content": "\"Be careful when you say this here.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321808",
							"2"
						],
						"stepId": 7321808,
