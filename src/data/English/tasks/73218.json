				{
					"id": 732181601,
					"content": "Permanent recruitment of workers for Wall of Samiel maintenance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181602,
					"content": "We offer a fair salary with free meals and accommodation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181603,
					"content": "Outstanding employees will be recommended by the official to receive further education at the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
