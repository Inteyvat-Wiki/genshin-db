			"dialogs": [
				{
					"id": 732181701,
					"content": "\"I have forgiven your sins in the name of the King of the Magic Bottle, yet who shall forgive ours?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
