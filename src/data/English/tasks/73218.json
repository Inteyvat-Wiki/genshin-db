				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321811",
							"2"
						],
						"stepId": 7321811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "\"I heard the Akademiya had set up a hospital in the desert for Eleazar. But it was abandoned for some reasons unknown...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181102,
					"content": "\"According to residents of Aaru Village, there were cured Eleazar patients who'd escaped from there.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181103,
					"content": "\"If there's information left there, it might lead to a cure for the disease...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "\"They say one of us from Aaru Village has become a high official at the Akademiya. We desert folk might well live a better life in the future.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181202,
					"content": "\"I barely earn enough carrying these stones. But with a single order of carrying something like cans of knowledge, I could afford to get married back at my hometown.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181203,
					"content": "\"But I heard that that official happens to be one who tackles smuggling. I don't think that person will be on our side.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181204,
					"content": "\"Tsk, that's how we desert folk end up like this. We don't unite.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
