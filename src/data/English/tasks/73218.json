			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "\"Young people overthink everything these days. Hadn't it been for Greater Lord Rukkhadevata, we Aaru villagers would have long been skeletons under the ruins of those temples.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181502,
					"content": "\"I overheard someone say that King Deshret might come back to life. Even that Greater Lord Rukkhadevata never came back after all these years, let alone King Deshret.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181503,
					"content": "\"Better get to our work now. We can't afford to live with the few supplies delivered to Aaru Village every month.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
