			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "\"They say some people earned a fortune just by selling sand pupa grease in the city. Now they have mansions there and claim themselves to be some kind of family. Even pretending to be cronies with those at the Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181402,
					"content": "\"I've spent most of my life carrying stones here, and I still have nothing.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181403,
					"content": "\"What do you know? Sand pupa grease is a business licensed by the Akademiya. You can't even have a finger in the pie.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 732181404,
					"content": "\"If you wanna make a fortune, come smuggle books with me. If it works out, at least we won't need to carry stones here anymore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321815",
							"2"
