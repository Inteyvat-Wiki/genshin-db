						],
						"pointId": 340100766
					}
				]
			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "#Y'know, {NICKNAME}, Paimon can see that the commissions have been pretty taxing lately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510102,
					"content": "As a thoughtful, capable guide, Paimon's duty is to help you relax, so... Ta-da! Guess where this is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510103,
					"content": "Well, it says \"Damoville Purveyor\" on the sign right here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "Ah, the abode of Mora thieves, the graveyard of wallets.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "Hello there. Welcome to Damoville Purveyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510106,
					"content": "Dear me, dear customer, do not speak such inaccuracies. Damoville Purveyor is committed wholly to affordability and quality. You may survey our prices should you wish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510107,
					"content": "This is no ordinary store. This is a place where hardworking laborers relax via spending money.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510108,
					"content": "Indeed, indeed! In fact, we have recently launched a buy one get one free promotion, with all customers welcome to take part!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510109,
					"content": "My loss if you buy, your loss if you don't!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510110,
					"content": "Hehe, Paimon saw the event poster when we passed by before. That's how she remembered it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510111,
					"content": "Double the goods for every purchase sounds like a great deal, no matter how you slice it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510112,
					"content": "It always feels like there's something missing in Paimon's day if she doesn't spend some Mora here... So today, we're coming here together to fill that gap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510113,
					"content": "And what would you like to buy, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "And how shall this yawning void be filled, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "Hehe, not telling you just yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510116,
					"content": "Payment might get tricky that way.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "Nah, don't worry. Paimon brought her own Mora today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510118,
					"content": "#Boss, has the order arrived yet? It's under \"Paimon and {NICKNAME}.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510119,
					"content": "We do have your package. One moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 756510120,
					"content": "Boucicaut the shopkeeper retrieves something over-packaged beyond identification. Beside you, Paimon fishes out a large pile of pocket money. You detect a hint of sadness on her face as she parts with this sizable sum.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "After you unwrap the package together, you realize that it contains two photo albums.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "Hehe, finally! Paimon's been waiting ages to get these!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510123,
					"content": "We've taken so many pictures so far, and now we've got a spot to put them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510124,
					"content": "I don't usually see you use a Kamera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "Hehe, that doesn't mean Paimon hasn't ever whipped it out! She's taken quite a few pictures of you while you weren't looking, in fact!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510126,
					"content": "Huh. Y'know, I'd like to see 'em now...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "Ooh, let me see!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "Not right now! Paimon's gotta take a whole album's worth first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510129,
					"content": "Nyeh, so petty.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "Paimon's a meanie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "Pfft, phooey! Anyway, take this photo album, would'ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510132,
					"content": "This one's a little thin, but it can fit a whole bunch of photos anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510133,
					"content": "We've been to so many places and taken many photos for others, but not really for ourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510134,
					"content": "Paimon thought it'd be nice if we could keep a few more memories for ourselves, so she bought these two albums.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510135,
					"content": "So this is a gift?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510136,
					"content": "That's right. It was a buy one get one free deal, so it's one for each of us. Paimon had it all figured out even when she was ordering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510137,
					"content": "You've gotta start using it right away, alright? You can take pictures of places we've been to, maybe relive some past memories as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510138,
					"content": "By the way, wanna use Paimon's Kamera to take some photos? You've never used it before, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510139,
					"content": "It took a lot of effort to custom-order this from a department store, so it'd be a shame if we didn't use it more often.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510140,
					"content": "Sure, I'll give it a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "Thanks, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "Hehe, as long as you like it! This is what a good guide should do, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756510143,
					"content": "C'mon! Let's go take some photos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}