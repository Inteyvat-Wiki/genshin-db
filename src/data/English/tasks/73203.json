			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "There you are. You're very punctual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030102,
					"content": "I made some Butter Chicken. You're welcome to dine with me if you're hungry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030103,
					"content": "Butter Chicken! How could we refuse? A big plate for Paimon, please!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030104,
					"content": "Watch your manners, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "Okay, sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030107,
					"content": "It's okay, there's no need to be so formal. It's only human nature to love food.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030108,
					"content": "I'll heat some up and pack it for you. It's the least I could do to show my gratitude for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030109,
					"content": "You're so nice, Miss Sabbah! Your roses will surely grow and flower, just like you wanted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030110,
					"content": "Well, I've been keeping the soil moist, so the sprouts have been coming along.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030111,
					"content": "My only worry is that they are growing slowly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030112,
					"content": "Generally speaking, if a germ is in good shape, it should grow quickly enough, but these few have been dormant so far...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030113,
					"content": "I'm not sure if it's because the soil isn't fertile enough. I may have to add more fertilizer if this keeps up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030114,
					"content": "Let's fertilize them again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "Would you do me this favor, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030117,
					"content": "Piece of cake. We got this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030115,
					"content": "We can try using Dendro again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "Sorry about Paimon's outburst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "Thank you again. Honestly, it gladdens my heart to see Sumeru Roses grow in this environment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030302,
					"content": "As you talk to Sabbah, new leaves begin to sprout...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "The leaves unfold, revealing flower buds.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "The flower buds slowly open and blossom into Sumeru Roses.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "Sabbah picks one and hands it to you and Paimon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "You shouldn't have... You didn't have many to begin with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030307,
					"content": "It's all right. After all, this wouldn't have been possible without your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030308,
					"content": "We were just lending a hand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "A rose garden is magnificent, but a single rose also has beauty of its own. I've been intrigued by roses ever since my scholarly days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030311,
					"content": "What? You were a researcher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030312,
					"content": "Right, I haven't told you yet... I'm not a native of Aaru Village. I \"moved\" here from the Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030313,
					"content": "See, didn't Paimon tell you that Miss Sabbah speaks in a refined way, just like the researchers we've met?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030314,
					"content": "You planted these because you wanted to continue studying roses, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030315,
					"content": "I wouldn't say that. To be honest, I don't think that researchers' interest in their subjects should be cultivated just for research's sake alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030316,
					"content": "I did this because I love this world and want to understand the life cycle of plants.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030317,
					"content": "As for me, I once studied the impact of geographical changes on the evolution of roses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030318,
					"content": "Just consider this. If the environments in Sumeru had changed in a totally different way, how would these roses have adapted?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030319,
					"content": "Would they have crawled up the walls like ivy? If so, the walls of the Akademiya would now be covered in roses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030320,
					"content": "Would they have formed clusters? A natural bouquet! Wouldn't that have been lovely?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030321,
					"content": "Maybe they might have even developed a spectrum of colors... White, red, and gold... Brand new species in their own right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030322,
					"content": "Of course, very few people discover new species nowadays, much less develop new species like the top researchers used to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030323,
					"content": "What I want to say is that there's a vast amount of potential in every rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030324,
					"content": "Exploring the possibilities is a lot of fun for me. Back then, I would happily collect samples every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030325,
					"content": "Looking back now, that was a simple and joyful time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030326,
					"content": "Anyway, just take it. To me, this is no loss. I am freely sharing my happiness.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030327,
					"content": "If you still feel awkward, just visit me often, and bring some Sumeru Roses with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030328,
					"content": "I feel at ease when I talk to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030329,
					"content": "And no matter what I said, you never thought it was nonsense or interrupted me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030330,
					"content": "I'll have small gifts for you too. Though I have no use for them now, you might like them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030331,
					"content": "We'll be back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "Please do return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030309,
					"content": "Don't sweat it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
		{
			"id": 7320304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320302",
							"2"
						],
						"stepId": 7320302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030401,
					"content": "You don't seem to have a Vision, and yet you can control Dendro. You're no ordinary adventurer, I think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030402,
					"content": "Supposedly, there are people who can control the elements without a Vision, but such people are of universally ill repute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030403,
					"content": "You, however, have a good heart. Don't stray onto the wrong path!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}