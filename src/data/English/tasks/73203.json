			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "If it weren't for you, I don't think I'd have ever seen these roses sprout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930502,
					"content": "If only I knew this would happen... instead of seeds, I should have brought a few more books.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930503,
					"content": "You're not from here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "Are you surprised? Well, I guess that means that I've adapted pretty well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930505,
					"content": "When I first got here, I was unable to get used to anything, whether it be the food, the housing, or anything else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930506,
					"content": "But I got used to everything over time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930507,
					"content": "That doesn't mean that I've fully accepted my predicament, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930508,
					"content": "I suppose it is impossible to make roses from Sumeru City bloom here after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930509,
					"content": "Are you a researcher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "I could have been called that once, but not anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930511,
					"content": "I said something beyond my station, and learned something I shouldn't have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930512,
					"content": "I broke the Akademiya's taboos, so I was removed from amongst their ranks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930513,
					"content": "What did you say?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "Curiosity is the impetus for seeking wisdom, but it's also the cause of sin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930515,
					"content": "I only understood that after I was exiled to this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930516,
					"content": "For safety reasons, I don't think I should go into details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930517,
					"content": "All right then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "Ahem, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930535,
					"content": "I thought adventurers would just come and go, never coming back to chit-chat after finishing their jobs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930536,
					"content": "I didn't expect to have another long conversation with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930537,
					"content": "To be honest, I don't have a lot of friends to talk to here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930538,
					"content": "Do you think... at some point... you would be able to come by and fertilize my plants again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930539,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "...Okay then, I'll wait for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930519,
					"content": "Why grow Sumeru Roses?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "You probably don't know much about them... but they are very versatile, and have many uses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930521,
					"content": "They can be eaten, turned into medicine, given as gifts, or fetch a good price on the market.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930522,
					"content": "And that's just some of the more common applications.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930523,
					"content": "The flower, leaves, and stalk of a Sumeru Rose also did not always look like this. They all had different appearances once upon a time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930524,
					"content": "I believe geographical changes led to changes in the roses' traits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930525,
					"content": "A study of its traits could help us derive past geographical and historical information.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930526,
					"content": "I won't be able to explain the mechanism over just a casual conversation, and sharing such information with adventurers is probably against the rules as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930527,
					"content": "If you're interested in botanical evolution, you should visit the Akademiya. They'll have more on the subject.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930528,
					"content": "So, you're doing this for your research?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "I'm not a researcher anymore. I no longer have the right or means to pursue any research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930530,
					"content": "If you must know why... *sigh*, you are a very curious soul, you know that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930531,
					"content": "I grew a lot of Sumeru Roses back in my former residence. The flowers were spectacular, and I got to see them every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930532,
					"content": "If it was possible, I wish I could see them again, just like before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930533,
					"content": "...That's all there is to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930534,
					"content": "I can understand that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
