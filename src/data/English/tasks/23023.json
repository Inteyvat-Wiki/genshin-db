			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230401,
					"content": "Soil fertility aside, perhaps \"water\" might also be a problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "Maybe we buried the rose so deep that it couldn't get enough water?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "Traveler, could you help us water the rose, please?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302306,
			"completionStepIds": [
				2302306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302306",
							"2"
						],
						"stepId": 2302306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan",
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "Whew... The soil should have enough moisture for now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230602,
					"content": "Many thanks, Traveler. We could have been all tuckered out by now if it wasn't for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230603,
					"content": "Strange... It took so much water to permeate the soil thoroughly this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230604,
					"content": "I felt like we used at least twice as much water as usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230605,
					"content": "That can't be. Maybe you're just too tired.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230606,
					"content": "If we really had doubled the amount of water, the soil would be soaked. But see, the moisture levels seem normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230607,
					"content": "I guess so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230608,
					"content": "Well, I hope the roses will grow well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "No worries. We will take good care of the roses for the sake of the patients and doctors at Bimarstan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230610,
					"content": "Traveler, take these as our thanks, please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230611,
					"content": "Still, I really feel like we used a lot more water than usual this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
