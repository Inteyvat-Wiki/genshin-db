					"id": 230230701,
					"content": "Traveler, please help us water the nearby roses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230702
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230702,
					"content": "With enough water, the roses will definitely start growing again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
				}
			]
