			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "Useless... Utterly useless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "...You really don't have anything to do, do you? Either you're too good at what you do, or hopelessly inadequate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100104,
					"content": "I doubt it's the latter though — you've been doing a fine job with my Commissions so far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100105,
					"content": "If you're at a loose end, there is something else you could do for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100106,
					"content": "But this time things are more dangerous. I need you to defeat a Ruin Hunter. Think you can handle it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100107,
					"content": "Consider it done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "My, you are self-assured. My brother was the same way... Perhaps you will one day achieve the heights of greatness that he did.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100113,
					"content": "That's all. The location is Guili Plains. Get yourself ready, then go and take down that Ruin Hunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100114,
					"content": "Once you've taken him down, remember to look around for sword-related items; anything you find, bring it back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100115,
					"content": "...But if there's nothing, just bring yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100116,
					"content": "Good luck with the Commission, and... I hope this time the search will prove more fruitful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100108,
					"content": "Should I keep an eye out for a sword?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Yes please. When you've defeated the Ruin Hunter, please check around for a sword or any sword-related items.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100111,
					"content": "I must warn you that Ruin Hunters are tough opponents. You must keep your attention fixed on them at all times if you wish to defeat them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100112,
					"content": "And as for the sword — it would be wonderful if you found something, but not to worry if you don't. You will be paid as long as you defeat the Ruin Hunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2211002,
