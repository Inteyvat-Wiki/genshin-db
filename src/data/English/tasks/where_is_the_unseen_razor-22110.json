					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100201,
					"content": "Has the Ruin Hunter been dealt with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100202,
					"content": "Not yet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "Well, take your time. One must be fully prepared before taking on a Ruin Hunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2211003,
			"completionStepIds": [
				2211003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
