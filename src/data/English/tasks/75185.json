			"dialogs": [
				{
					"id": 751850301,
					"content": "What are these... eggs?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "So, about them — they're a dish that can only be produced in our volcanic region.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "We toss some bird eggs on the vents, let the Phlogiston roast them, and when the heat and timing are just right, out comes the perfect Magma Egg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "But word to the wise — leave it in too long, and it'll take on a, ah, special taste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
