			"dialogs": [
				{
					"id": 790501501,
					"content": "Voila! All done!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501502,
					"content": "Seeing the Water Droplets so happy makes Paimon happy too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501503,
					"content": "We protected the essence of friendship.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "Now, both the painter's friends and their work in the Veluriyam Mirage are looking their best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501506,
					"content": "Maybe someday, that painter will return to visit their friends and look at their masterpiece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501507,
					"content": "Speaking of which, the style of this painting is pretty unique... Even though it's not that fancy, it's still beautiful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501508,
					"content": "And what's more important is that Paimon can understand it! Perhaps if Paimon imitates the style, she can also paint lovely yet understandable paintings!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501509,
					"content": "Sensational paintings aren't necessarily complicated.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "Yes! And if it's okay with you, let's take a picture of this painting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501512,
					"content": "Then Paimon can study the painting whenever she likes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501514,
					"content": "Maybe once Paimon has also painted something that pretty, it'll attract lots of Water Droplets that want to be Paimon's friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501510,
					"content": "Wanna learn how to paint that way, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501504,
					"content": "We made the Water Droplets' wish come true.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
