							75.375
						],
						"pointId": 68
					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Fantastic... That's pretty much all of the major junk retrieved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160102,
					"content": "I'm sorry you've had to work so hard, you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160103,
					"content": "Don't feel like you have to apologize, Freminet! The way Paimon sees it, we haven't been \"working\" — we've been fishing up goodies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "We helped to restore the environment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Thank you... I've had such a happy and fulfilling time, and it's all thanks to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160107,
					"content": "You're welcome! Besides, it was a team effort! Aaaand, Paimon thinks you've made some real progress. You've been a great help both underwater and on land!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "There's no need to blush.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "Oh, uh... Alright.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160111,
					"content": "I'm sorry, besides \"thank you,\" I really don't know what else to say at times like these.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160112,
					"content": "Maybe... I still need a little more practice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160113,
					"content": "Take your time, there's no hurry. Just keep working on it at your own pace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "If we get the chance, let's cooperate again in the future.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Alright, it's a deal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160117,
					"content": "...Now that the cleanup's over, I was planning on going back underwater to spend some time alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160118,
					"content": "But weirdly enough, after talking with you... even the sky itself seems calmer. I just wanted to... share this feeling with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160119,
					"content": "Anyway... I'd best head back and meet up with Lyney and the others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160120,
					"content": "I'll leave the rest of the underwater survey data with you. I hope you find what you're looking for.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160121,
					"content": "Hey, I could hear you celebrating from above decks. Has something good happened?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160122,
					"content": "Yeah! All that junk that was upsetting the fishies has pretty much been cleared away. We also found the rest of the piano pieces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "Really? Let me take a look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160124,
					"content": "...Well, I'll be. With these components, I can finally fix the piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160125,
					"content": "It might not be exactly how it was before, but it should be able to play beautiful music again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160126,
					"content": "Aww. You sound really happy, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "D—Do I? Whatever, I'll go fix it right away. It shouldn't take me long. In the meantime, could I trouble you to spruce this place up a bit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160128,
					"content": "Such a wonderful instrument deserves a proper stage to set the scene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160129,
					"content": "Aww... She sure looks happy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "Whoa! What a beautiful piano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "It's very elegant!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Hmph, of course it is. It was me who fixed it, after all! I also reinforced the mechanical linkages and retouched the exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160134,
					"content": "You two didn't do too badly yourselves. This stage is truly worthy of this piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160135,
					"content": "Hehe, it was nothing! Anyway, that's enough chitchat. Aren't you gonna play us a song?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "...Huh? Right now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160137,
					"content": "When else? Why fix the piano if you're not gonna play?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "How about... we leave the performance on hold for today! There's plenty of time for me to play for you later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160139,
					"content": "Forgot your sheet music?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Hmph... Absolute nonsense! I—I just want to sit with it quietly for a while and reminisce about the past!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160142,
					"content": "And don't think a few cheap taunts are gonna get me to play. Hmph, practice first, performance later!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160140,
					"content": "Feeling shy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "It's gorgeous!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "If you need any help, you can always count on us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "And we found a whole bunch of treasure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}