			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "What do you want all those gears and tubes for? Are you building an iron house or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "True enough, sir! A house it is, a house filled with gears — that is what I am building.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155003,
					"content": "I have named the area containing some of the gears the \"Storage,\" while the bearings and the rest of the gears make up the \"Numberbase.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155004,
					"content": "The gears in Storage are used for recording and storing numbers, and those in Numberbase for calculation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155005,
					"content": "A sketch might help you understand. Do you happen to have some paper on you? No? Never mind, I'll draw on my clothes. That should make things clearer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155006,
					"content": "Pass me the coal, will you? Many thanks, please look at this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		}
	]
}