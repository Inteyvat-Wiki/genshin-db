			"dialogs": [
				{
					"id": 230150201,
					"content": "Did you bring the Iron Chunks?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301503,
			"completionStepIds": [
				2301503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301503",
							"2"
						],
						"stepId": 2301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong",
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "Okay! Okay! I'll just forge the gears for you! Just... stop talking!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150302,
					"content": "But I haven't finished my explanation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150303,
					"content": "Now that we have the Iron Chunks, I'm going back to work. You, back off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150304,
					"content": "Ahangar swings his hammer so fiercely that Garcia has to back away from him...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "Let's leave Mr. Ahangar to his work. Here's your payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150306,
					"content": "I hope you will succeed this time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "That means so much. Thank you, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150308,
					"content": "I am... cautiously pessimistic about this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150309,
					"content": "Mr. Garcia is a genius with machines. That much is beyond doubt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150310,
					"content": "But if you ask me, the machine that Mr. Garcia envisions requires much more than just one \"genius.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
