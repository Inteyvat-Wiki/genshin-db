				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "It's you... I remember you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020202,
					"content": "I was purging some living beings that had been tainted by the demonic. It would appear that I have caused you some trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020203,
					"content": "(Huh? He isn't usually this polite, what's going on...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020204,
					"content": "But you were exorcizing demons, how is that causing trouble?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020205,
					"content": "That is because the changes that occurred in these monsters stem from me — or more precisely, from the karma I have accumulated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020206,
					"content": "Mutations, karma... Does that mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020207,
					"content": "We read about that in the book...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "Yeah. Paimon remembers that Xiao is also called the Vigilant Yaksha, isn't he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020210,
					"content": "So... so that means... Aww...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020211,
					"content": "*sniff* P—Poor Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020212,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020213,
					"content": "We read about your past in a book.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "I see. You must mean that piece of literati fan fiction from a few hundred years ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020216,
					"content": "Hmph. All things are impermanent, and to exist is to suffer. We yakshas have no need of sympathy or tears.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020217,
					"content": "My comrades who have passed on would see your tears as a stain upon their legacy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020218,
					"content": "Oh, uh... Paimon's sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020219,
					"content": "It matters not. In any case, I am on my way to purge a cavern of demonic influence, so we shall part ways here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020220,
					"content": "W—Wait! Take us with you! We'll be a big help, Paimon promises!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020221,
					"content": "No need. I am used to fighting alone, and in any case these mutations originated from me to begin with...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020222,
					"content": "Well then... Oh! Consider it Paimon's penance for being accidentally rude just now! ...Please?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020224,
					"content": "...Come on then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020214,
					"content": "We were just reading a book called \"Yakshas: The Guardian Adepti.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "So Xiao is the final yaksha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
		{
			"id": 1110204,
			"completionStepIds": [
				1110204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110204",
							"2"
						],
						"stepId": 1110204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "Ooh, this place gives Paimon goosebumps!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020402,
					"content": "I will use the ritual known as the Bane of All Evil to relieve this place of its karma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020403,
					"content": "You must remain calm. Do not allow yourself to be affected by the lingering wrath of bygone gods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "It is good that we came here. An unusual number of living things had fallen under infernal influence. Had we not arrived in good time, the consequences would have been unthinkable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020602,
					"content": "Now. This \"Starsnatcher\" you speak of. What is the situation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020603,
					"content": "Ooh, Paimon'll tell you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020604,
					"content": "An adeptus who grants wishes... To think that people could be so easily deceived by such blatant lies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020605,
					"content": "As an adeptus, do you have the power to grant wishes, Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020606,
					"content": "The Liyue of yesteryear would never ask the adepti for boons unearned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020607,
					"content": "Millennia ago, the ancestral people of Liyue asked for nothing more than the strength to defend the land they called their home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020608,
					"content": "Ehh... To be honest, an adepti who grants people's wishes is probably more appealing to people nowadays...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020609,
					"content": "However feeble people nowadays may be, they are not my concern. I concern myself only with following Rex Lapis' original decree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020610,
					"content": "Whoops... Paimon spoke without thinking again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020611,
					"content": "Oh, ah, one more thing! That fake adeptus has a Sigil of Permission. It's what he uses to exorcise demons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020612,
					"content": "Wait, truly? Hmph. Fool. Exorcizing demons without exterminating them — it is no wonder they have been congregating here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020613,
					"content": "If this continues, things may spiral out of even my control... We must confiscate his Sigil of Permission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020614,
					"content": "Confiscate? Is that all?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "Great minds think alike! Paimon agrees, we've gotta show that trickster what you get for trying to fool us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020617,
					"content": "And it just so happens that we've got a real adeptus with us too! If Xiao were to teach Starsnatcher a lesson, you can bet he'll never dare to pose as an adeptus ever again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020618,
					"content": "No. I only slay demons — I do not kill mortals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020619,
					"content": "...Who said anything about killing him!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020621,
					"content": "It would certainly benefit Liyue if we could convince him to cease his wicked ways.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020622,
					"content": "I possess an art called Dream Trawler. It is normally used to separate the soul from the body, that one might cultivate oneself in a waking dream...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020623,
					"content": "But it can also be used to call forth the spirits of others.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020624,
					"content": "Whoa, now that's a real adepti art for ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020625,
					"content": "Similar to \"gifting dreams and visions\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "A ritual must be performed for this art to be used. Assist me in gathering a few items... a censer, seven lamps, and something to reduce the temperature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020628,
					"content": "Reduce the temperature... Oh, some Mist Flowers will probably do, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020629,
					"content": "But as for the censer and the seven lamps... Hmm... Probably not the kinds of things we're gonna just stumble across in the wild.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020630,
					"content": "Do you know of the two yaksha statues that stand guard beside a merchant road on the southern face of Mt. Tianheng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020631
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020631,
					"content": "The ancestors of the people of Liyue built shrines there to honor the yakshas. You should still be able to find some ceremonial items there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020632
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020632,
					"content": "Once you have found them, meet me at the yaksha statues after nightfall, and I will teach you how to use this art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020626,
					"content": "You'll scare him out of his wits for sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020615,
					"content": "I think I'd also like to teach him a lesson.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				}
			]
		},
