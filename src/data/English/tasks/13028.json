			"dialogs": [
				{
					"id": 130280113,
					"content": "They've been here for a very long time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280101
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280101,
					"content": "I really want to do something for them so that they'll have a chance to meet again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280102,
					"content": "Yeah, and apart from these two Fungi, Paimon's also a little worried about the Floating Anemo Fungus's camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280103,
					"content": "Mm-hmm. I feel the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280104,
					"content": "I have an idea. Why don't we bring them over to live with the other Fungi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280105,
					"content": "Both sides have previously lived in the presence of an elemental life-form, so their habits should be similar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280106,
					"content": "Yeah, so they can look out for each other!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280107,
					"content": "Would you like to come with us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280108,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280109
					],
					"speakerTitle": "Floating Hydro Fungus"
				},
				{
					"id": 130280109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280110
					],
					"speakerTitle": "Floating Hydro Fungus"
				},
				{
					"id": 130280110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280111
					],
					"speakerTitle": "Floating Hydro Fungus"
				},
				{
					"id": 130280111,
					"content": "Looks like it's been convinced.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280112,
					"content": "Okay, let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
