			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060101,
					"content": "Greetings! I am Timaeus, researcher of alchemy. Welcome to Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060102,
					"content": "Alchemy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "Alchemy is a craft that has been passed down since ancient times, but it is barely understood in the present.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060104,
					"content": "Its mechanisms are magical and mysterious, completely unlike the principles that shape our understanding of the physical world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060105,
					"content": "If we can get the hang of this, we should be able to create some pretty awesome stuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060106,
					"content": "This must be your alchemist's work bench?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060107,
					"content": "That's right. Why not give it a go yourself?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060108,
					"content": "I don't know, it sounds complicated...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "You'll be fine, the procedure is actually very simple. If you're interested, I can show you the basics?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060111,
					"content": "Craft",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "I'm afraid I'll blow something up!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
			"completionStepIds": [
				2050602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050602",
							"2"
						],
						"stepId": 2050602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "Coooool!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060202,
					"content": "All we are really doing is following the methods of the ancients as best we can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060203,
					"content": "Much as one who uses a wind glider needs not understand how it was built in order to glide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060204,
					"content": "The difference with alchemy is that every time I think I finally understand how it's supposed to work, something totally unexpected happens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060205,
					"content": "What other uses does alchemy have?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "To be honest with you, I just don't know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060210,
					"content": "There's a lot of other mysterious recipes I have to research first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060211,
					"content": "Over the course of your adventures, you should come across some alchemists' notes from ancient civilizations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060212,
					"content": "And as your Adventure Rank increases, more recipes will become available to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060213,
					"content": "Thanks for the explanation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "You're welcome. I look forward to hearing more about your exploits!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060218,
					"content": "Well, see you next time. May the wind bring you good fortune on your path ahead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060215,
					"content": "The next time you hear from me I'll be a Paimon-conjuring alchemy wizard.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "Why are you so obsessed with other Paimons? Do I no longer satisfy your Paimonial needs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060217,
					"content": "Haha... You two are a fascinating pair I must say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060207,
					"content": "Can you conjure up a new Paimon using alchemy?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "Hey! You shall have no other Paimon before this Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060209,
					"content": "Hahaha! Unfortunately my skills are not that advanced.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}