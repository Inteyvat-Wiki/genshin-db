			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "Huh? Isn't that Maalaus? Has she been out gathering inspiration, again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Yes. But the little one has been like this ever since she came back... As if lost in thought.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760600104,
					"content": "Huh, maybe the theme this time is super profound... Y'know, like when a great artist realizes some fundamental truth about the world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "Come to think of it, Maalaus has given us a whole bunch of paintings. We could hold an entire exhibition at this rate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Hehe, Paimon can't wait to tell everyone all about our little painter's rise to artistic stardom! Ah, but we'd need Columbina's permission first, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "Hm? Why is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760600108,
					"content": "Well, 'cause they're nearly all paintings of you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "Oh... It's okay, I don't mind. It sounds intriguing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760600110,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "Oh, seems like Maalaus has decided what to draw! Quick, let's see what kind of paint we've got.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "This time... Let's go for deep and tranquil colors!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
