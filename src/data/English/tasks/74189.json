			"dialogs": [
				{
					"id": 741890401,
					"content": "Have you found the answers to the questions? Let me remind you of the questions first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890402
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890402,
					"content": "Question 1: How many tables are there in The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890403
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890403,
					"content": "Question 2: How many employees do we have at The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890404
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890404,
					"content": "Question 3: What is not served in The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890405
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890405,
					"content": "Are you ready to answer the questions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890406,
						741890407
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890406,
					"content": "We're ready.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890409
					]
				},
				{
					"id": 741890409,
					"content": "Then let's begin. First question. How many tables are there in The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890410,
						741890412,
						741890413
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890410,
					"content": "Three.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890411
					]
				},
				{
					"id": 741890411,
					"content": "Correct! One step closer to activating the cannon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890414
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890414,
					"content": "Question 2: How many employees do we have at The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890417,
						741890415,
						741890418
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890417,
					"content": "One.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890425,
					"content": "I'm sorry to break it to you, but that's the wrong answer. Do you want to try again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890426,
						741890427
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890426,
					"content": "I'll do it again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890409
					]
				},
				{
					"id": 741890427,
					"content": "Let me consider this further...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890428
					]
				},
				{
					"id": 741890428,
					"content": "Then I'll be waiting for your answers to my questions! You can find me right here whenever you're ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890415,
					"content": "Three.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890416
					]
				},
				{
					"id": 741890416,
					"content": "Correct! One step closer to activating the cannon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890419
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890419,
					"content": "Question 3: What is not served in The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890420,
						741890421,
						741890424
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890420,
					"content": "Cheese.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890421,
					"content": "Romaritime Flower.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890422
					]
				},
				{
					"id": 741890422,
					"content": "All correct! Congratulations, you may activate the cannon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890423
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890423,
					"content": "Hold on a sec, let me cover my ears first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890424,
					"content": "Milk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890418,
					"content": "I am your employee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890412,
					"content": "Two.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890413,
					"content": "There aren't any.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890407,
					"content": "I still need to give it some more thought.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890408
					]
				},
				{
					"id": 741890408,
					"content": "Then I'll be waiting for your answers to my questions! You can find me right here whenever you're ready.",
					"roleType": "TALK_ROLE_NPC",
