					}
				]
			},
			"dialogs": [
				{
					"id": 741890501,
					"content": "One moment please. Would you like to hear a secret about the treasure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890502,
					"content": "What secret?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "It has to do with treasure and the key to opening the gate. How does that sound? Interested?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890504,
					"content": "You're not asking me to fight monsters again, are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "Of course not! We wouldn't dream of asking tavern guests to run errands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890507,
					"content": "See this naval artillery by my side and the rubble it's pointed at?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890508,
					"content": "Activate the cannon and blow up those rocks, and any treasure you uncover is yours for the taking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890509,
					"content": "Who on Teyvat named that cannon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "The helmsman did. I'm not entirely sure myself where he acquired it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890511,
					"content": "Out with it. What parts are missing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "I think you've been misinformed, friend. The cannon is entirely intact and fully powered. I tend to it every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890514,
					"content": "But before you activate the cannon, I would like you to answer several questions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890515,
					"content": "It's per the request from the helmsman. He called it a good source of amusement for guests at the tavern, something to slow down their drinking and keep them here longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890516,
					"content": "I'm not sure about this, but ask away.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "Question 1: How many tables are there in The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890518,
					"content": "Question 2: How many employees do we have at The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890519,
					"content": "Question 3: What is not served in The Rusty Rudder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890520,
					"content": "That's it. You only need to answer these three questions correctly to activate the cannon, blow up the rubble, and get the treasure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890521,
					"content": "What will happen after I get the treasure?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "After that, I'll find the right time to place another suitable prize in the cave and seal it with rubble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890523,
					"content": "The treasure is waiting to be claimed once the next guest activates the artillery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890524,
					"content": "That's a lot of work for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "That's all. You may look for the answers now. Meanwhile, I'll stay here and wait for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890525,
					"content": "Talk about a horrible boss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "I find it hard to disagree with your remark, but I have yet to find a way to point the cannon at the helmsman without him detecting it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890527,
					"content": "Besides, rashly shooting in the wrong direction may harm other guests at the tavern, which stands in conflict with my moral principles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890512,
					"content": "Out with it. How is it powered?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "You're not asking me to find someone or something for you again, are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
}