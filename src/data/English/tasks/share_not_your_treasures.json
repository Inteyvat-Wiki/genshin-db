			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 210202001,
					"content": "\"...This whole thing about the bonfire granting wishes is utter nonsense! Though, the treasures buried underneath are genuine... Boss said I should leave the slip of paper where I found it and just wait nearby — people are bound to fall for it, and as soon as the fire lights up... Hehehe. A very lucrative stroke of genius this one...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210202002
					],
					"speakerTitle": "Scribbled Notes"
				},
				{
					"id": 210202002,
					"content": "\"...That said, there's more treasure here than I can move all in one go. Boss says I should first bury it on the <color=#00E1FFFF>highest peak in Cuijue Slope</color>. There's a big old withered tree on top of the mountain, I'm sure she can't miss it...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scribbled Notes"
				}
