			"dialogs": [
				{
					"id": 741660701,
					"content": "Okay, friends! We're finally at my favorite facility: The Pankration Ring! This place is our paradise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660702
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660702,
					"content": "This place... Is it really that great? That feels way different from what Paimon's heard...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660703,
					"content": "Of course, but don't listen to those outside rumors. That's just an image intended to fool others. Come, come, come, I have a consent form over here, if you just sign it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660704
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660704,
					"content": "Hey! It's you again! Tricking people into signing consent forms to register for the competition again, are we? You won't escape this time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660705
					],
					"speakerTitle": "Guard"
				},
				{
					"id": 741660705,
					"content": "You two are quite lucky that I noticed just before you were going to sign those forms!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660706
					],
					"speakerTitle": "Guard"
				},
				{
					"id": 741660706,
					"content": "In any case, ignore this fraud. He and the organization behind him specialize in tricking unsuspecting people into dangerous competitions, and they earn a profit from it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660707
					],
					"speakerTitle": "Guard"
				},
				{
					"id": 741660707,
					"content": "Don't make up things like that! I haven't tricked anyone! They're all my friends, and they're just signing up willingly after I recommending it to them as a friend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660708
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660708,
					"content": "Right, I'm sure. I know a better place for you to spout your nonsense. With me, now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660709
					],
					"speakerTitle": "Guard"
				},
				{
					"id": 741660709,
					"content": "The strange person was escorted away by the guard...",
