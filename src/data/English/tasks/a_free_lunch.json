				]
			},
			"dialogs": [
				{
					"id": 741660501,
					"content": "This is the location of the Tri-Coupon Troupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660502,
					"content": "Huh? Is that the entire intro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "Didn't you manage to associate that with anything? Where there is a troupe, there is drama! Where there is drama, there is romance! Where there is romance, there is love!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660504,
					"content": "They say that as long as you come here and watch their performances every day, you will find your true love.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660505,
					"content": "Are there really rumors like that? Then shouldn't everyone be gathered here every day?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "That is so, but for it to come true, you cannot be a prisoner or a guard of the Fortress of Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660507,
					"content": "So nobody can ever meet their true love!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "Perhaps that is the crux of the problem. Regardless, let us head to our next destination first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strange Person"
				}
			]
		},
