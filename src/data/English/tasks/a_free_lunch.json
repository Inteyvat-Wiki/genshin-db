			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "#Excuse me, young {M#lad}{F#lass} over there, yes, yes, you! You there, come, come on over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660202,
					"content": "Huh? Are you talking to us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "Oh, my friends, I immediately saw you are new here. You must not yet be very familiar with the Fortress of Meropide, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660204,
					"content": "Congratulations on running into me today! I am the single nicest resident of the entire Fortress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660205,
					"content": "Today, allow me to help you familiarize yourself with the Fortress. Of course, it will all be \"free.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660206,
					"content": "Actually, I already know the place quite well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "Oh, don't say that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660208,
					"content": "Perhaps you think you've got your bearings, but under my guidance, I believe you'll discover all kinds of things you never noticed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660209,
					"content": "There's such a thing as a free lunch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Of course, of course! Like I said, I'm the kindest resident of the entire Fortress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660211,
					"content": "Huh, this guy's kind of weird. We've only just met and he's all buddy-buddy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "Haha, my friend, think nothing of it! How about this, you two discuss it amongst yourselves first, and I'll wait over here to hear your decision.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660213,
					"content": "Once you've made up your minds, come find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strange Person"
				}
			]
		},
