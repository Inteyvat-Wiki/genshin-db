			},
			"dialogs": [
				{
					"id": 741660301,
					"content": "How about it? Have you come to a consensus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660302,
					"content": "You said it yourself, it must be absolutely free!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "Of course, of course, it will be totally \"free.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660304,
					"content": "Come come come, now I will show you about the Fortress of Meropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strange Person"
				}
			]
		},
		{
