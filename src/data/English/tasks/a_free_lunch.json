				]
			},
			"dialogs": [
				{
					"id": 741660401,
					"content": "This is the Coupon Cafeteria, and each person may claim one free Welfare Meal here each day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660402,
					"content": "The only problem is that what you get to eat is completely up to fate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660403,
					"content": "Hmm, is that all? This is just stuff anyone learns on their first day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Calm down, calm down, I have some secret information as well. They say there is a secret codeword you can say to Bran when claiming your Welfare Meal, which will allow you to obtain the legendary mystery meal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660405,
					"content": "Ah, really? What codeword?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Unfortunately, I do not know. Regarding the codeword, I await the day you discover it for yourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660407,
					"content": "That's totally Paimon's line!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "Do not worry about such trivial details! Our next stop, the Tri-Coupon Troupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strange Person"
				}
			]
		},
