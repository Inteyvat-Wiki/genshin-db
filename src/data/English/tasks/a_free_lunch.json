			"dialogs": [
				{
					"id": 741660601,
					"content": "This is... the lift to the production zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660602,
					"content": "This place doesn't have strange rumors too, does it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660603,
					"content": "No, that is does not. It's just that I really hate this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660604,
					"content": "Oh? Why's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660605,
					"content": "Because...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660606,
					"content": "Because...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "Because I don't wanna work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660608,
					"content": "I'm only here because I didn't wanna work, so I stole a loaf of bread to feed myself because I was so hungry, and was sentenced as a result.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660609,
					"content": "So why, why do you still have to work in the Fortress of Meropide!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660610,
					"content": "\"Any little bit of work will knock me out!\" That's my life's motto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Strange Person"
				},
				{
					"id": 741660611,
					"content": "Gah! It feels like he's getting all weird just being here, let's get out of here and go to the next place.",
					"roleType": "TALK_ROLE_NPC",
