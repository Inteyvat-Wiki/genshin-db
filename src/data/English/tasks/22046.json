			},
			"dialogs": [
				{
					"id": 220460101,
					"content": "The shrine is getting messy again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "Meow, it is you again. Well met.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460104,
					"content": "After a little neglect, the shrine's surroundings have started to collect dirt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460105,
					"content": "This is no way to greet those humans coming to pay their respects.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460106,
					"content": "Could you aid me in cleaning up the shrine, as you did before?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460107,
					"content": "Don't you have Taisuke and Etsuko around?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "I... will not speak to those two green humans of my own accord.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460109,
					"content": "The tall human always looks upon me with a strange gaze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460110,
					"content": "And the other green human never seems particularly... motivated?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460111,
					"content": "Meow meow, regardless, they are not reliable humans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460115,
					"content": "Whatever the case, I can only rely on you for this task. Just use the long stick and the water to clean up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460116,
					"content": "I've got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "Whatever the case, I shall leave this to you. I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460119,
					"content": "I will wait for you here, meow meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460117,
					"content": "I got you, more or less.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "Well, you could ask Mr. Ooshima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "The stone human is always busy with his knock-knock-knocking. Who knows what he is doing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460114,
					"content": "The stone was knocked, after all. What is he knocking this time, I wonder... How annoying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				}
			]
		},
