			},
			"dialogs": [
				{
					"id": 710750101,
					"content": "Hey, you! Yes, you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750102,
					"content": "Someone familiar with this place like you could find what that Erge lug couldn't, I'll bet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750103,
					"content": "No? Well, I'll just wait for someone who can, make 'em find it, and get it off them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750104,
					"content": "They call me The Qingce Kid, and no measly motley of Chasm miners is going to stop me, or I'll never show my face again out there. Well then! Give me the thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750105,
					"content": "We'll take the Millelith's treasure, thank you very much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750106,
					"content": "I don't know what you're looking for...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "And what you say goes, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750109,
					"content": "...Hmph. You know, I thought all that running around would've made you look a bit tougher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750110,
					"content": "Well, I'll give you a choice. You can give me the Helm of Warding, or you can give it to me after I've knocked your lights out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750111,
					"content": "...I doubt you actually want to fight me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "Oh, look who's talking big?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750113,
					"content": "Looks like you'll have to learn the hard way!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 710750107,
					"content": "...But you won't find it here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				}
			]
		}
	]
