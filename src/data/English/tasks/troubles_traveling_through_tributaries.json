				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yue Chuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "The handwriting in this bottled letter seems to belong to a child...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260102,
					"content": "\"Little Meng\"? Who's that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260103,
					"content": "Huh? Is that drifting bottle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "Traveler? Judging from your tone, you know the person who wrote this letter, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260105,
					"content": "I guess...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "Ah, so that's how it is. Quite the thinker too, this kid. Wanting to become mature...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260108,
					"content": "You know what? I think he'd gain a lot from taking a little trip outside to broaden his horizons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260109,
					"content": "Huh. Little Meng did say that he'd like to travel outside Liyue Harbor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260110,
					"content": "But we invited him that time, didn't we? Why didn't he just agree then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260111,
					"content": "Hahaha, I suppose that's a wee bit of what you might call a boy's \"stubbornness.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260112,
					"content": "It's his troubles, and he wants to solve them himself, you know? Can't be relying on others all the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260113,
					"content": "But he's not going to solve this problem by floating a bottle downstream...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260114,
					"content": "Well, yes. And that's where a reliable adult comes in, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260115,
					"content": "Come on, Traveler. Let's write this kid a letter together, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260116,
					"content": "Let's tell the kid about all the fascinating things waiting for him in the outside world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260117,
					"content": "That said... Well, it's not like I've been to too many places, so you're in charge of the details, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260118,
					"content": "Let's write about the towering ruins shrouded in raging winds...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "Whoa, whoa there. Slow down, I'm still writing over here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260122,
					"content": "Hmm... This goes here... and we write that there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260123,
					"content": "Alright! That's a wrap — wow, we sure wound up writing a lot...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260124,
					"content": "Honestly, just listening to you talk about your travels makes me want to travel myself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260125,
					"content": "It's not bad at all.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "Ah, but at my age, there's too much business to attend to. Traveling willy-nilly is just not something I can do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260127,
					"content": "Well, I've put this letter into the drifting bottle. Send it down the river.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260119,
					"content": "Let's mention the archipelago surrounded by thundering storms...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "Let's talk about the island that the Electro Archon split in two...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "It's a kid from Liyue Harbor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
