			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Buies"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "This type of game sure is inspiring, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220102,
					"content": "What new game?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "Traveler! Good timing! I happen to need someone to playtest my new game.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220104,
					"content": "Look here. I'm calling this game \"Inspiration Eruption.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220105,
					"content": "It perfectly captures the entire process of how we poets create poetry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220106,
					"content": "You mean drinking, drinking, and more drinking?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "Enlighten me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "Hahaha, hilarious. Though using wine to let one's creative juices flow is certainly a good idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220108,
					"content": "However, wine alone is not enough to inspire truly extraordinary poetry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220110,
					"content": "Before we write a poem, we have to start by seeking out inspiration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220111,
					"content": "Some like to travel, some prefer solitude, while others... really enjoy using wine to stimulate their creativity.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220112,
					"content": "This is the most challenging part, since we cannot pinpoint where inspiration lies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220113,
					"content": "So most of the time we feel like we haven't found our muse, and become anxious and depressed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220114,
					"content": "But in truth, inspiration has already visited us and left its mark inside our heads without us ever knowing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220115,
					"content": "At the right juncture, they will come bursting out and take the form of a great poem... or a painting... or something else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220116,
					"content": "And you can turn all that into a game?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "Hahaha! Of course! The process of making poetry is quite clear and easily understood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220118,
					"content": "It just so happens that there are a few tabletop game designers in Mondstadt interested in my ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220119,
					"content": "After some discussions and a few brainstorming sessions, we finally came up with \"Inspiration Eruption\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220120,
					"content": "You can try it right now if you're interested.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220121,
					"content": "Play a few rounds, and maybe you'll become a poet yourself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buies"
				}
			]
		}
	]
}