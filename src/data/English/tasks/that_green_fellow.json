			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Green Fellow"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3720501,
					"content": "Ehhhh!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720502,
					"content": "You... really do have some wonderful abilities...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720503,
					"content": "Someone like you is going to end up getting written into a bard's poem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720504,
					"content": "#Oh, a hero so bright, should {M#he}{F#she} stand in the light. Though stand in the shade, and you'll be met by a blade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720505,
					"content": "Alas... I've really not the time to compose a melody for you at this moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720506,
					"content": "Anyway, even if Dvalin is not taken down, his life will still wither away in the breeze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720508,
					"content": "I also feel sorry for Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "Is there anything I can do to help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "As a knight, I suggest you turn yourself in along with the dragon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "He'll burn himself out in the flames of anger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720509,
					"content": "Thank you for that, and you for purifying the Teardrop Crystal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720510,
					"content": "But I have my own plans for what is to follow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720512,
					"content": "I really must thank you for purifying the Teardrop Crystal, it has helped me greatly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720513,
					"content": "But I've already come to devise my own plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720515,
					"content": "Do you really deem that necessary?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720516,
					"content": "You can forget about me turning us in for now... I have another plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720517,
					"content": "Oh? And what plan would that be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720518,
					"content": "Seeing this tear has brought to mind a friend so dear.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720519,
					"content": "Friend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720520,
					"content": "Heh-heh, one must be going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720521,
					"content": "Hey! Where're you running off to!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720522,
					"content": "To the \"Symbol of Mondstadt's Hero.\" Bye-bye~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720524,
					"content": "This \"weirdo\" as you put it — we need to keep an eye on him...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#Huh... {NICKNAME}, what do you make of that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720526,
					"content": "You know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "As far as he's concerned, you're a weirdo too ya know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720528,
					"content": "His voice seems familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "Know what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720528
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}