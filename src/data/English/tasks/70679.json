	"talks": [
		{
			"id": 7067901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7067901",
							"2"
						],
						"stepId": 7067901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "Why hello, hello! We meet again! What fortune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Sorry, you are...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Gygax! I'm Gygax! You know, from Windtrace! Ring any bells?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "So that's who you are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "Oh, I remember now!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "You say that, but your expression says you don't remember a thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "Anyway, please, look over here. I'm sure you remember Windtrace at least, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "Didn't you give me a ton of suggestions after your previous round of play-testing? They were great ideas, too. I've taken just about all of them on board.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "I've revised the rules and gameplay once... Uh, well, several times since then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "They won't be overly complex and weirdly worded, will they?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "Oh, don't worry, I'm sure you'll love the new stuff. Let me give you a quick rundown.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "First off, I've introduced something called a Signaling Device in this brand-new version of Windtrace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "As long as the Rebels can activate 4 such Devices, they'll defeat the Hunter and emerge victorious!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "Whereas the Hunter... Well, nothing's changed there! If they manage to capture all the Rebels, they win.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "But in this version of Windtrace, when Rebels get caught by the Hunter, they won't be knocked out straight away. Instead, they'll be kept in what's known as the \"Surveillance Zone.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "After waiting a bit, or with the help of other Rebels, they can escape from the Surveillance Zone and carry on playing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "But if a Rebel who's previously been caught gets captured a second time... they'll be knocked out of the game completely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Sounds a little complicated...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Don't worry. It might sound complicated, but you'll get it after a few rounds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "In that case, I'll have a go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Sure! This way, please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "Not right now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "No worries. Come back when you're free — I'll be here for a while yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "So many new rules...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "You didn't add any weird gameplay in, did you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "You're... that Windtrace guy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "It's Gygax! But you're not wrong... and it's not as if I'm upset that Windtrace is more famous than I am.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}