				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "*sigh* What I would give to see it for myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630102,
					"content": "See what?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "Whoa, how long have you been there!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630104,
					"content": "Yesterday, Stanley got drunk and told me all about this adventure he once had at <color=#00E1FFFF>Dadaupa Gorge</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630105,
					"content": "He said, and I quote: \"The monster was burning fiercely as its amorphous body wriggled slowly towards me... I fought and I screamed, but it didn't seem to do anything; the monster just looked at me contemptuously with those eyes... those terrifying eyes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630106,
					"content": "Obviously I wasn't there to see it, but... if even Stanley felt he had met his match that time, it must have been one epic adventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630107,
					"content": "*sigh* I am so tempted to try and find the monster that even Stanley struggled to beat... Just to see it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630108,
					"content": "But knowing what I'm like in a fight, it would probably end in me getting beaten up and running away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630109,
					"content": "Hey, do you think maybe you could go find the monster for me? Only if you're interested, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630110,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "Brilliant! Knew I could rely on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630112,
					"content": "Let's go together.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "Oh boy, I would love to... But unfortunately, I have a million other things that need doing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630114,
					"content": "When I say \"other things...\" Unfortunately, just doing adventures for the Mondstadt Adventurers' Guild doesn't bring in enough of an income.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630115,
					"content": "So I've taken to doing a bunch of odd jobs for people around town. Finding missing cats, cutting the grass, you name it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630116,
					"content": "So the epic adventure of Stanley-scaring proportions is all yours. Tell me all about the monster when you get back, I want to hear everything!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006301",
							"2"
						],
						"stepId": 2006301,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"2",
							"20063"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "*sigh* When oh when will I finally become an epic Adventurer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630202,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Oh, hi... Yesterday, Cyrus was telling me about an adventure he once had. It was in the <color=#00E1FFFF>Stormbearer Mountains</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630204,
					"content": "In his words: \"That huge shield was like something out of a nightmare, no matter how hard my sword struck it, it just wouldn't budge... Meanwhile, the monster sneered at me from behind the shield, glaring contemptuously with those eyes... those terrifying eyes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630205,
					"content": "A Wooden Shield impervious to all attacks... I would give anything to see that with my own eyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630206,
					"content": "But I have a billion other things to do that I just can't get out of... I can't begin to imagine what kind of terrifying monster would have a shield like the one Stanley described...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630207,
					"content": "Hey, so... If you were at all interested, maybe you could go and find the monster for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630208,
					"content": "Sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Fantastic! Thanks so much. I want to hear all about it when you get back — every last detail!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630210,
					"content": "Let's go together.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "You want me to come? Sorry, I just can't. The Adventurers' Guild has a load of odd jobs waiting for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630212,
					"content": "Adventures just aren't that lucrative these days. Even though I got these jobs via the Adventurers' Guild, in actual fact most of them are just running errands for other people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630213,
					"content": "I need to herd some boars for Draff, find Margaret's cat, pick some fresh flowers for Flora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630214,
					"content": "...Not quite the sorts of adventures I was imagining when I signed up with the Guild. Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006303,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
