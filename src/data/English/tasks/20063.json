				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "I just want to get out there on an adventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630302,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Stanley told me another one of his stories yesterday.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630304,
					"content": "This time he was even drunker than usual, so it was quite incoherent... But from what I could tell, it took place near <color=#00E1FFFF>Dawn Winery</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630305,
					"content": "The salient parts of his drunken ramblings were as follows... \"There were ominous-looking ice crystals on the monster's body, as if to make it look larger, more intimidating... My legs froze with fear as I frantically flailed my weapon around... I dislodged a few shards of ice; brilliant, shining ice... Somehow I was transfixed by that ice...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630306,
					"content": "I can't imagine the kind of monster it would take for even Stanley to feel like he'd finally met his match.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630307,
					"content": "Oh, I do wish I could go and see it for myself... But knowing me, it'd have me running for my life before I got anywhere near it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630308,
					"content": "...You'd be fine, though. Knowing you. Would you be willing to go look for it for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630309,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "Excellent! When you find it, come back and tell me all about it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630311,
					"content": "Let's go together.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "I'd really love to come. But with everything that's going on with the Adventurers' Guild... You know how it is.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630313,
					"content": "Cyrus looks like he's about to retire — says he wants to settle down in Springvale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630314,
					"content": "Herman hasn't left the city once since his daughter was born. It's such a loss. He was our star Adventurer, no doubt about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630315,
					"content": "Meanwhile, Stanley's on extended leave and hasn't been on an adventure in ages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630316,
					"content": "The Guild has started taking on odd jobs from the public as way to cover its running costs, but they're still struggling to find people to do them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630317,
					"content": "So it's fallen to me to cover the shortage. We can't expect Bennett to do it, he's got more than enough to deal with already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
