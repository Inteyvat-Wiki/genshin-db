						],
						"stepId": 2006310,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"2",
							"20063"
						]
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"2",
							"20063"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200631601,
					"content": "...Alright, I'm sorry. Please, stop looking at me like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631602,
					"content": "So... a hilichurl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631603
					]
				},
				{
					"id": 200631603,
					"content": "Yes, alright, it's true. It was just a hilichurl in that story I told.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631604,
					"content": "*sigh* But look... As you know, every young person in Mondstadt has their heart set on joining the Knights of Favonius. Trying to convince them to sign up with the Adventurers' Guild is like trying to get Barbatos to trade his Holy Lyre for two twigs and a ball of string...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631605,
					"content": "The reason? The Knights of Favonius takes on dragons while the Adventurers' Guild is stuck dealing with the likes of the hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631606,
					"content": "Our recruitment drive desperately needs more gripping stories... Otherwise, we're just not going to sign up a single new recruit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631607,
					"content": "I know making up stories is futile... But what else can I do? I'm far too old to be going out there fighting epic battles against legendary monsters for real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631608
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 200631608,
					"content": "*sigh* I do worry for the future of Mondstadt's Adventurers' Guild after I retire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
	]
}