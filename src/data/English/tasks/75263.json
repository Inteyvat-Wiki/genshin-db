				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Attention, everyone! The Easybreeze Speed Champions Tournament is about to begin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "Whoever beats our reigning champ, \"Raging Wind Nanasian,\" our winner for three days straight, will win today's surprise grand prize! Now's your last chance to register for the tournament!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "Hmph! No challengers left for me, \"Raging Wind Nanasian\"? Is that it? Everyone's too scared to lose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "*sigh* No one's a match for \"Raging Wind Nanasian.\" Three days in a row! That sort of consistency is hard to beat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "Awrrrh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "Oh? You wanna give it a shot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Hmph. So we've stooped to letting saurians enter now? Fine! Send out all your beasts, and I'll show you what true speed looks like!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "What a unique tournament this is turning out to be! Can these mighty saurian companions dethrone our three-time winner, \"Raging Wind Nanasian\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "I'd like to sign up too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "What a twist! A brave challenger steps up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Huh? You think you stand a chance against me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "So many twists and turns today... Who'll be the champion in the end? Let's find out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "The staff mark out the course, and the crowd gathers around to watch. You take your place on the start line...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
