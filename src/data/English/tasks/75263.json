			"dialogs": [
				{
					"id": 752630501,
					"content": "Race over! It's over! What a shocking turn of events!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#And our ultimate winner is... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "#Whoa! {M#He}{F#She}'s incredible! {M#He}{F#She} actually managed to beat both \"Easy Come\" and \"Easy Go\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "#{M#He}{F#She} was like a golden lightning bolt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Oh, c'mon! What about this silver lightning bolt? Did nobody see the silver lightning bolt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "A crushing defeat... I doubt I'll ever reach that kind of speed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "\"Raging Wind Nanasian\""
				},
				{
					"id": 752630507,
					"content": "Don't give up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "I... I'll take you as my role model...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "\"Raging Wind Nanasian\""
				},
				{
					"id": 752630509,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "Please accept this grand prize specially prepared for the tournament's champion — you deserve it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630512,
					"content": "Your name will go down in the annals of the Easybreeze Speed Champions Tournament forever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
