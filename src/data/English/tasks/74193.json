			"dialogs": [
				{
					"id": 741930101,
					"content": "#Paimon! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930102,
					"content": "Wow, it's you, Pahsiv! Nice to see you again! What are you doing around here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930103,
					"content": "Pahsiv... working! Pahsiv... tired! Pahsiv... lie down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930104,
					"content": "Huh? You're... working?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930105,
					"content": "Foggy Forest Branch... Foggy Forest Branch... very throw!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930106,
					"content": "Huh? What's a Foggy Forest Branch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930107,
					"content": "Foggy Forest Branch... Information!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930108,
					"content": "Willow, collect. Fog, handle. Spring, send.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930109,
					"content": "Foggy Forest Branch... Mist information!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930110,
					"content": "So you mean it's information about the Foggy Forest Path?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930112,
					"content": "Foggy Forest Branch... very throw! Very many places!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930113,
					"content": "Pahsiv... searching! Pahsiv... tired! Pahsiv... eat! Pahsiv... lie down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930114,
					"content": "Foggy Forest Branch... Very not many! But boxes, very many!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930115,
					"content": "#Ah... Thank you Paimon, thank you {NICKNAME}, here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930116,
					"content": "You found us a treasure chest again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "Pahsiv! Box, treasure, flower, shiny, sweet, very many!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930118,
					"content": "Whoa, so there's other stuff, too? Y'know, Pahsiv, you're real nice, but it'd be bad if we kept taking your stuff for free. Why don't we exchange things instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930119,
					"content": "Ex... change?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930120,
					"content": "That's right! We're friends, and friends should exchange gifts in earnest with one another!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930121,
					"content": "So, we're gonna help you find your Foggy Forest Branches, and exchange those for your stuff. Whaddya say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930122,
					"content": "And we can get you some stuff to eat, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "Right, we can do that! You're having a hard time by yourself, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930124,
					"content": "Eat! Tidalga! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930125,
					"content": "You like Tidalga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "Tidalga! Tidalga! Tidalga Tidalga Tidalga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930127,
					"content": "Uh, does that mean you eat five meals, or five Tidalga a day? Uh... Wow, you might have Paimon beat for appetite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930128,
					"content": "Well, what about the Branches, then? Can we find 'em by following the Foggy Forest Path?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930129,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930130,
					"content": "Foggy Forest Branch... very throw! Very many places! Very Erinnyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930131,
					"content": "The Branches are all over Erinnyes, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#Smart {NICKNAME}! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930133,
					"content": "Foggy Path has flowers. Branches, also flowers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930134,
					"content": "Branch, branch, branch, branch, branch, branch... Number!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930135,
					"content": "Huh. Ooh, Paimon gets it now. The Branches can be found in places with the same flowers as the Foggy Forest Path, and there are six locations, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930136,
					"content": "Smart Paimon! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930137,
					"content": "Hehe, guess we're all clear now, eh? Make sure you rest up, Pahsiv. Just leave this to us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930138,
					"content": "#Paimon, {NICKNAME}, good thing! So, slowly, slowly! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
