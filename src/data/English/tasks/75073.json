			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "Ah, my savior! Thank you for your help in... defeating these hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730102,
					"content": "I was just standing on the cliff admiring the scenery, and one of them knocked me right out. By the time I woke up, I was trapped in here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730103,
					"content": "It's locked. The key... Ah, right, the key is in that chest over there. Could I trouble you to do me a teensy weensy favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730104,
					"content": "I'd be eternally, utterly grateful if you would...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
