					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050401,
					"content": "Water these three seeds first, and I'll think about what to do about the fertilizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050402,
					"content": "After growing things for decades, I do know how to make some simple fertilizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		}
	]
