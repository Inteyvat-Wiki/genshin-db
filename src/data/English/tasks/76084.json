			"dialogs": [
				{
					"id": 760840101,
					"content": "Ah, you're here? The kuuhenki are playing the lyre again. Could you play a song for them like last time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760840102,
					"content": "And I happen to be in the mood to hear something different myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760840103,
					"content": "(Hmm, what should I play...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
