		{
			"id": 7509406,
			"completionStepIds": [
				7509406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7509406",
							"2"
						],
						"stepId": 7509406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "Whew... That sure was scary, with those monsters attacking out of nowhere like that. Good thing we're super strong, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940602,
					"content": "Guess I'll be counting on you next time, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "Huh? No no no, Paimon can't do that! Who'd want to fight those scary monsters, anyway!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940606,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "Heh, looks like he's getting anxious already. Let's just find a way to hatch the egg first!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940608,
					"content": "Activate the incubator.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "The incubator is back in action...\\nAll you need to do now is wait...\\nHours pass, but nothing happens to the Saurian egg. It doesn't change at all...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "Err... Errh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "Weird. Nothing seems to have happened. Have we messed something up? Let's try again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940612,
					"content": "Let's try again...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "You reboot the incubator as the instructions indicate...\\nBut just as with your previous attempt, nothing happens to the Saurian egg...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "Aw... How long do we need to wait? Paimon's zoning out over here... Also, she's getting dizzy... and hungry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940615,
					"content": "Rrah... Grgh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "Huh!? Wait! Wait! It moved!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940617,
					"content": "Let's wait a little longer, shall we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "After a long while...\\nThe Saurian egg remains unchanged. No reaction, no sign of hatching.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "Still nothing... Could this incubator be broken? But its lights are on! Hmm. Is the problem with the egg, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940620,
					"content": "...Hmm, waiting around doesn't seem like it'll help... Should we just take the egg with us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940621,
					"content": "No matter how hungry you get, don't even think about eating it, alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "Wraah! Wraah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#Come on, of course not! Also, don't give {REALNAME[ID(2)|SHOWHOST(true)]} any strange ideas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940626,
					"content": "Well, little fella, Paimon means that... if the problem's with the egg, it might never...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940634,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#Don't be sad, {REALNAME[ID(2)|SHOWHOST(true)]}. There's nothing we can do about it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940636,
					"content": "Perhaps the environment here isn't suitable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "Y'know, you're right! Maybe the egg isn't hatching because it thinks Natlan hasn't changed and isn't suited to be its home!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940639,
					"content": "After all, it's been hiding inside here for so long, right? Of course it doesn't know what a wonderful place Natlan's become!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940640,
					"content": "So, let's take it back and take good care of it! We'll tell it stories about beautiful landscapes, thrilling adventures, and all the wonderful people we've met — every single day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940641,
					"content": "In short, we'll let it know how great Natlan is now! Once it gets excited enough, it'll surely hatch on its own!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940642,
					"content": "...Brwarh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "Or perhaps... the egg doesn't believe that this is the right time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#What do you think, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "Err... Errh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "No, it didn't.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#Huh!? But... Just now... Was Paimon imagining things? No, it can't be. Did you see that, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940629,
					"content": "Err... Errh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#Ah... So you didn't see it either? Was it really just Paimon's imagination, then? So, what do we do, {NICKNAME}? Are we gonna just wait?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940631,
					"content": "Or... could the problem be with the egg? B—But, if that's the case, does that mean it'll never hatch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940632,
					"content": "The egg itself might be the issue here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "Huh? So, does... does this mean that it might never hatch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940604,
					"content": "Hmph, is that all they've got?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "Exactly! You'd think they'd be super strong with how scary they looked! But really, our little fella hits harder than they do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
