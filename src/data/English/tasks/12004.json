			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120040101,
					"content": "Hmm, where do we go from here...? What's the plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040102,
					"content": "Traveler, Paimon. Hold on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040103
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040103,
					"content": "Huh? Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040104,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040105
					]
				},
				{
					"id": 120040105,
					"content": "Something has come up, and I would like to request your assistance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040106,
					"content": "But you ought not be nervous. This is not coming from the Yashiro Commission or the Kamisato Clan. It is my own individual request.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040107,
					"content": "Individual request? You mean... personal stuff?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040108,
					"content": "Correct. It concerns my mother.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040109,
					"content": "This may seem a little sudden... but in my view, you are the only person I can entrust this to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040110,
					"content": "Can you give me any more details?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040111
					]
				},
				{
					"id": 120040111,
					"content": "A few days ago, I was sorting through some old family belongings when I found a notebook that belonged to my mother.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040112,
					"content": "She wrote about all kinds of things, mostly of little consequence. But what drew my attention was a name — it is one that I have never heard before, so the fact that she mentions it so frequently... it makes it difficult for me to ignore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040113,
					"content": "Probably your mom's best buddy, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040114,
					"content": "You'd really never heard the name before? Not once?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040115
					]
				},
				{
					"id": 120040115,
					"content": "Never. And although my mother and father passed away many years ago, both my brother and I are familiar with the vast majority of their acquaintances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040116,
					"content": "So... I am very curious about this mysterious individual. I would very much like to meet them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040117,
					"content": "According to the notebook, their name is \"Tsubaki.\" This seems to have been someone very important to my mother. Someone with a lot of personality, who liked to have fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040118
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040118,
					"content": "Hmm... Paimon thinks it sounds like a girl's name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040119,
					"content": "That's what I thought too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040120,
					"content": "So, what do you want us to do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040121,
					"content": "Do you need us to find her for you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040122,
					"content": "No, no, her address is given in the notebook — we can head straight there. I wanted you to assist me with the preparation of greeting gifts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040123
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040123,
					"content": "...Please keep everything I have told you in strict confidence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040124
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040124,
					"content": "The proper course of action would be to involve my brother and visit her together, but he is terribly busy at present, and... on a more selfish note, I don't wish to involve anybody else from Inazuma in this matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040125
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040125,
					"content": "Hence why you came to me, an outlander.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040126
					]
				},
				{
					"id": 120040126,
					"content": "Exactly. That, and you are also a kind, well-mannered person with a genuine concern for other people... not to mention trustworthy. I would not feel comfortable with anyone else in this situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040127
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040127,
					"content": "You can count on us! We've done greeting gifts before, so we should be able to help. In terms of payment... just treat us to some delicious food, and we'll be more than happy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040128,
					"content": "Wonderful — in fact, I was hoping to take this opportunity to show you both around. If you don't mind, of course?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040129
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040129,
					"content": "#Oh, we don't mind! We don't mind at all! Do we, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040130,
					"content": "Not in the slightest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040131
					]
				},
				{
					"id": 120040131,
					"content": "Thank you kindly! Shall we head off, then? Ogura Textiles & Kimonos is our first stop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040132
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040132,
					"content": "Alright! Sounds great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}