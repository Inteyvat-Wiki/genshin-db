			"dialogs": [
				{
					"id": 708240101,
					"content": "Clean the place again, and I want it spotless this time! This is about making a good first impression!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "Sorry, Ms. Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240103,
					"content": "We'll be more careful this time, Ms. Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "What's up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "Ah, hello, Traveler. Welcome to the Dawn Winery. The storm may have passed, but here at the Winery we're still cleaning up the mess it made.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "I'm trying to organize the cleanup operation, but these girls, they—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "Sorry, Ms. Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240108,
					"content": "We'll be more careful this time, Ms. Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Yes, you've said that already, thank you very much! Now, why don't you put your efforts into cleaning instead of standing here apologizing to me? Shoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "These kids... Ugh, they're so sloppy. I don't know how we'll ever get through it all at their rate of progress. And even after that, there's still the indoors that needs cleaning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082402,
			"completionStepIds": [
				7082401
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
