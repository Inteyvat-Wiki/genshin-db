				{
					"id": 708240401,
					"content": "Finished?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240402
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240402,
					"content": "All done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240403
					]
				},
				{
					"id": 708240403,
					"content": "Wonderful, this was a huge help. I can't imagine how long this would have taken me by myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240404
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240404,
					"content": "And if I'd gotten the girls to do it... Who knows how many items they'd end up destroying in the process...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240405
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240405,
					"content": "Thank you, please take these. I do apologize for troubling you, a visitor, with the work of a Winery maid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240406
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240406,
					"content": "Next time you visit, the Winery will be spotless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
