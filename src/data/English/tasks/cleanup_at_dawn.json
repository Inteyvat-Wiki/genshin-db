			"dialogs": [
				{
					"id": 708240201,
					"content": "I can help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "Do you know how to sweep? Actually, scrap that, we're so short-staffed that I should be taking all the help I can get.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240203,
					"content": "Follow me indoors, there's plenty of cleaning that needs doing in there, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
