				"points": []
			},
			"dialogs": [
				{
					"id": 735180101,
					"content": "Sure enough, the charging unit is running more smoothly... As you said, the elemental environment in this area is returning to normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180102,
					"content": "...The activity of affected Wenut will calm down after some time, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180103,
					"content": "Yeah, yeah... Thanks to your precious Wenutslayer Cannon, we can report back our success and go home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180104
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180104,
					"content": "It's OUR precious Wenutslayer Cannon, Shriya. I never forgot that this assignment was a joint effort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180105,
					"content": "...We definitely had our share of disagreements, but without you, the cannon wouldn't have been a success.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180106,
					"content": "What's... gotten into you? Is this about wanting me to put in a good word for you in my report?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180107,
					"content": "Well, I just suddenly feel that what we went through just now is quite similar to our experience from that other year: it wasn't always smooth sailing, but we still made it in the end.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180108,
					"content": "And let's face it. In the end, your solution proved more efficient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180109
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180109,
					"content": "I... uh... I can't take all the credit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180110
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180110,
					"content": "...Because you were onto something, too. If you hadn't tested the Wenutslayer Cannon, I wouldn't have obtained the necessary data...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180111
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180111,
					"content": "\"To fix a machine you may only need to replace one gear, but the true challenge is finding that gear...\" These words from my mentor are beginning to make sense to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180112,
					"content": "I'm so glad you're here, Shriya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180113,
					"content": "Uh... I'm glad you're here, too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180114,
					"content": "Huh? The atmosphere between these two became so different all of a sudden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180115,
						735180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735180115,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				},
				{
					"id": 735180117,
					"content": "Ahem! When we were cooperating on our graduation project, our relationship was rather rocky because we weren't very mature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180118
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180118,
					"content": "Yeah. Looking back on it, it wasn't anything too serious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180119
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180119,
					"content": "Well... How about meeting at the café for a drink next time? We could discuss how to write the report.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180116,
					"content": "Just leave it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				}
			]
		}
	]
}