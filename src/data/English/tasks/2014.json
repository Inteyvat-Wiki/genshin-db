			"dialogs": [
				{
					"id": 20140801,
					"content": "Teppei!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140802,
					"content": "Oh... *cough* Hey, guys. What're you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140803,
					"content": "Just a moment, lemme get up... Oof, it's weird, I don't know where all my strength's gone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140804,
					"content": "Teppei, you have to tell me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140807,
					"content": "Oh right, yeah, I haven't had time to give you the full details. Well, I've made a lot of great contributions to the war effort lately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140808,
					"content": "Fighting the Shogun's Army at sea, taking on Shogunate Samurai all by myself, rescuing my comrades fr—from an ambush... things I never would have dreamed I could do when you first met me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140809,
					"content": "*cough* If only I were stronger still. The stronger I am, the more I can do for the resistance... Wait a sec, where's my secret weapon gone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140810,
					"content": "Tell me about this weapon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "*cough* It wasn't long after you were made captain of Swordfish II. I met these mysterious people, said they were with our supporters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140813,
					"content": "They gave it to me and said that as long as I have the will to become stronger, this secret weapon will answer my call.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140814,
					"content": "Haha... *cough* It's just like a Vision, isn't it? Of course, I've never used a Vision, so I wouldn't know the difference...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140815,
					"content": "This is... a Delusion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "Delusion? *cough* Oh god, that doesn't sound very good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140817,
					"content": "So... what's the difference between a Delusion and a Vision?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140818,
					"content": "A Delusion drains the user's life force.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "*cough*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140820,
					"content": "Gosh... Well, I suppose it's not too surprising that a mysterious weapon of unknown origins would come with its risks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140821,
					"content": "I've been getting more and more tired over the past few days, and I have this... strange sense of dread.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140822,
					"content": "At first I'd find I was a little more beat than usual after a battle. Didn't think anything of it. But today, I got back and suddenly my vision was going blurry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140823,
					"content": "This is a real shame... There I was, thinking I was catching up with ya, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140824,
					"content": "Guess I didn't receive the favor of the gods, after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140825,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#Hey {NICKNAME}, would you do something for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140827,
					"content": "When our uniforms are ready, grab mine for me... bring it back here, and we can change together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140828,
					"content": "What's that look for? Don't worry, partner. Soon as I've rested up, I'll be right as rain. Right as rain, I tell ya... soon as I've... rested up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140829
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140829,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140830,
					"content": "The Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140831
					]
				},
				{
					"id": 20140831,
					"content": "#Hey {NICKNAME}, where are you going? Heyyyy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140811,
					"content": "When did you start using it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140805,
					"content": "What's been going on with you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				}
			]
		},
