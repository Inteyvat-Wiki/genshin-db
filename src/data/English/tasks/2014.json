			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "Kokomi, we're back— Oh, look, Gorou's here too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140602,
					"content": "What happened? They look so serious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140603,
					"content": "Approximately how many people are exhibiting these symptoms?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140604,
					"content": "I haven't had the chance to do a full count yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140605,
					"content": "Kokomi, Gorou... what's going on?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140606,
					"content": "#Recently, {NICKNAME}, some of our soldiers started showing symptoms of accelerated aging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140607,
					"content": "I called them in for questioning and found out that they'd privately acquired some secret weapons from our sponsor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140608,
					"content": "Most of them are highly ambitious types, vehemently opposed to the Vision Hunt Decree. They've been using these new weapons secretly since getting hold of them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140609,
					"content": "So that's why the war has been going unusually well... But risky secret weapons are not the answer. We must put a stop to it immediately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140610,
					"content": "Gorou, have you managed to acquire one of these weapons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140611,
					"content": "Most of the officers refused to hand them over. Still, I did manage to get one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140612,
					"content": "Oh dear...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}, do you know something about this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140614,
					"content": "It's a Fatui Delusion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "So that means our secret sponsor is the Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140616,
					"content": "But why would the Fatui do this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140617
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140617,
					"content": "Forget that, there's no time. Right now, we need to inform the whole army to cease using their Delusions immediately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140618
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140618,
					"content": "All soldiers who have shown symptoms are to be taken for treatment. I just hope we'll be in time to save them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140619
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140619,
					"content": "#Wait a second... {NICKNAME}, speaking of soldiers with symptoms...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140620,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140621
					]
				},
				{
					"id": 20140621,
					"content": "No, s—surely he can't have...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140622,
					"content": "Uhh, let's go check on him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
