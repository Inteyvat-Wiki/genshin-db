						],
						"pointId": 600100254
					}
				]
			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "Look who's here, eh? Did you find a Purbiruni? Not that hard, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "We did, but...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "Hmm? You seem pretty hesitant. Did someone give you any trouble?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "You tell Khedive about everything that happened with Sadife...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "Ah, Sadife... He's known for his stubbornness, even his teachers can't always deal with him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "He even turns down every single source of funding, and insists on working alone, to \"keep his research pure\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "So that's \"Wisdom shall not be sold for gold\" at work?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Well, that's the Purbiruni rule... Haha, Pursina is much more flexible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Well... To be fair, it's just because I am rather well off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "How did you make your money?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "What's with that skeptical face? I earned my wealth with hard work, okay? Do you even know how hard futures trading is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "F-Futures trading?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "I tell you... One has to know transaction volumes, market trends, and then make the right investment decisions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "At first I thought I'd just invest a little bit for fun, I didn't want it to impact my research...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Who would have thought that... Ugh! I made more and more Mora, and the money I had sitting in the exchange grew and grew...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "I am a professional researcher! My interest lies in research and academic work! It's scholarly results that I'm after, not Mora! That's what I have been telling myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "However, whenever I'm in Sumeru City, I'm drawn to the exchange, and find myself trading futures, transaction after transaction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "So my bank account balance kept increasing, while my research... No progress AT ALL!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "So! Here I am, having hired an entire team for an expedition to The Chasm. Staying far away from anywhere with an exchange is the only way I can get any research done!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Without satisfactory results, I... I won't leave The Chasm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "You make money through futures trading?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "Why are you so rich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "Something happened...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
		},
