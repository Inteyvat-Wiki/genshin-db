				"points": []
			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "Traveler, you've returned! About my case...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480302,
					"content": "Here.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "Excellent! Thank you so much... To think you had a recommendation letter, and yet I still made you do so much work... Please accept this payment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480305,
					"content": "As the Purbirunis always say...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "Huh? So you actually know about that? Yes, Purbiruni does have this commandment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480307,
					"content": "But this admonishment is to prevent us from betraying the principles of research for monetary or other external reasons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480308,
					"content": "After all, a researcher who pursues research for profit... is unworthy of the title.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480309,
					"content": "But you went to such great lengths to help me, and thus you deserve a reward commensurate with your efforts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480310,
					"content": "Thanks again for your help, and please do not hesitate to reach out in case you need anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480311,
					"content": "Is it that \"Wisdom shall not be sold for gold\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "I got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
		{
