			"dialogs": [
				{
					"id": 733480101,
					"content": "But... Without those samples...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "About the Purbirunis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Yes, and the current Herbad. How may I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "Scholarly inquiries, perhaps? You don't look like an Akademiya researcher, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "About Khedive's recommendation letter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "Was this letter really personally written by Khedive? Wait a moment while I read it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Hmm, so his research at The Chasm is going well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "...Research on Fungi... aquatic environment... fossils... unique geological features... samples...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "Nice, perfect, astounding! He is still an astute scholar and outstanding researcher, of course he didn't disappoint!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "Hmph... I hate admitting this in front of an outsider, but the researchers of Pursina are certainly gifted...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "Moreover, Khedive did emphasize your repeated and exceptional contributions in his letter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "With your assistance, his research really was \"as smooth as a cat soaring in the air,\" wasn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "Please don't say that again...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Is that so? Ahem, sorry about that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Another glorious chapter of Pursina will be written into the record books upon his return to the Akademiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "Um... and the thousand-year friendship between Purbiruni and Pursina will be enhanced even further!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "Please accept my gratitude, Traveler, on behalf of the Purbirunis and Pursinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "Oh, right! He also mentioned gifts for you... not a problem, just a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "Not another letter, please...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "Of course not another letter! For your hard work assisting Khedive's research, it is only fitting that you are compensated with Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "But... Please forgive me. Today was such a busy day, I didn't bring much with me. If you would, please wait here for a second...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Another proud researcher, huh? But... He seems really different from Khedive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "He seems... actually poor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "H-How? We Purbirunis are born researchers, and never worry about something as mundane as money...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "It's just that we invest most of our money in our research. As for everything else... we tighten our belts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "But this never interferes with our research. Rather, freedom from material things allows us to see the way to wisdom all the more clearly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "I'll be on my way and get your payment soon. But before that, I must reluctantly make a request...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "Khedive referred to you as a vigorous, experienced, outstanding, elite adventurer the likes of which is rarely seen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "If you would, I'm saying if! Could you please do me a favor? Not long ago, I was exploring the desert alone for some geological research...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "And... I didn't hire a guard because... I was short on cash. I thought a quick trip would be safe, just get in and get out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "But I got unlucky, and ran into Treasure Hoarders on the way back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "Though I managed to escape unharmed back to the city, the case with all of my samples and notes was lost!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "That case is totally worthless to merchants and Treasure Hoarders... But to me! It means the world. Priceless!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "I had no luck finding an adventurer kind enough to help... Traveler, can I ask for your help? Please?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "I'll help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "I can't thank you enough! Without you, I don't know what I'd do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "I marked the spot where I was attacked on the map, here. The case must be somewhere nearby!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "Hearing it from him was enough...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "Excuse me, are you a Purbiruni researcher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
