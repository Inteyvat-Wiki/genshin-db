			"dialogs": [
				{
					"id": 733480901,
					"content": "*sigh* This paltry funding is by no means enough for my research...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480902,
						733480903
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480902,
					"content": "Um, excuse me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "A Purbiruni researcher? Right, you must be looking for Sadife. A guest for him... Quite unusual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "He's been back taking care of things at the Akademiya lately, and should be nearby... What's the matter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "About Khedive's recommendation letter...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "Khedive? So his research has wrapped up? Being rich must be nice, having a whole observation team supporting him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "...whereas I can't even get a subsidy for a field trip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "You know about Khedive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Of course! We poor researchers, who scrounge for funding and never make any Mora, all know about his fabulous wealth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "Whoa, you mean... this Khedive... and the researchers in his family, they're all loaded!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "Does this mean we can get a big fat reward?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "No way. Khedive is the exception. Don't go getting any unrealistic thoughts about the Purbiruni and Pursina researchers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480914,
					"content": "Especially those majoring in Astrology and minoring in History and Biology... In their fields, the unlucky ones can't even manage to apply for research funding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480915,
					"content": "Also, they always repeat something like \"Wisdom shall not be sold for gold\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480916
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480916,
					"content": "*ahem* I shouldn't have said that... There's your man. Go ask him about anything else you want to know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480903,
					"content": "About a Purbiruni researcher...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				}
			]
