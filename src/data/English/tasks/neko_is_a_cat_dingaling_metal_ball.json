	"talks": [
		{
			"id": 7221501,
			"completionStepIds": [
				7221501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221501",
							"2"
						],
						"stepId": 7221501,
