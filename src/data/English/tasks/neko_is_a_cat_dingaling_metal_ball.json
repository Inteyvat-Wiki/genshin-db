				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "Meow meow, when did that stone become the spitting image of me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150102,
					"content": "How's the statue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "The stone human says that he will finish knocking on this stone soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150104,
					"content": "Hibiki will be so happy when she returns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150105,
					"content": "Hmm, yes. This stone is good, but we must dress the shrine's surroundings up a bit, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150106,
					"content": "Please, help me hang these round, tinkling metal balls around the shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150107,
					"content": "These things were prepared by Hibiki. If memory serves, Domeki gave them to her because she loved playing with me and other children. It took quite a lot of effort to find them again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150108,
					"content": "Huh. These are... bells?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "\"Bells?\" I am not sure what those are, but Hibiki used to use these metal balls when playing with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150110,
					"content": "She would put the metal balls on the ground, and then knock them far away. They would make this tinkling noise whenever they moved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150111,
					"content": "I do not understand what power they possessed, but the sound they made would always attract myself and the other cats to chase them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150112,
					"content": "I came to understand, therefore, that the reason why few people have come to pay respects is because the shrine presently lacks metal balls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150113,
					"content": "Thus, I request your help in hanging these metal balls in high places.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150114,
					"content": "That way, humans will hear the tinkling of the metal balls and come to this shrine, and they will not lose their way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150115,
					"content": "The Offering Box will be full of Mora, and the shrine will thrive... and Hibiki will be very happy when she returns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150116,
					"content": "So, please help me hang these metal balls around the shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150117,
					"content": "I got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "Thank you, meow meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221502,
