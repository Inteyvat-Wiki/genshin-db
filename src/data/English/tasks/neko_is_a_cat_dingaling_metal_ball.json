			},
			"dialogs": [
				{
					"id": 722150201,
					"content": "These metal balls will attract more people. That will surely please Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221503,
			"completionStepIds": [
				7221503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221503",
							"2"
						],
						"stepId": 7221503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "Have you hung them all up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150302,
					"content": "All done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "Meow meow, wonderful. This will surely make the shrine a livelier place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150305,
					"content": "Hmm. Why haven't lots of humans come here yet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150306,
					"content": "I don't think they'll come so quickly...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "Ah, humans are so hard to understand. Well, you are an exception, of course. You are more enlightened.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150309,
					"content": "There may not be any people now... But at least those little rascals won't get lost anymore, meow meow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150310,
					"content": "The stone human says that the stone will be ready very soon. Do come and see it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150311,
					"content": "...Hmm, yes, there was one other thing. A strange thing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150312,
					"content": "I went to ask those two green humans about Hibiki and Domeki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150313,
					"content": "Both of them said that they didn't know Hibiki or anything about her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150314,
					"content": "But the tall green human said that he had read about an \"Ako Domeki.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150315,
					"content": "He talked about... \"bandit\" this and \"bounty\" that... Whatever the case, he was trying to say that Domeki was a bad person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150316,
					"content": "There must be some mistake. Hibiki would always play with him, so Domeki must've been a good person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150317,
					"content": "That human's comprehension must be lacking. You're still the most reliable human after all, it seems...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150318,
					"content": "Ah, when will Hibiki come back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150307,
					"content": "It's not that simple...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}