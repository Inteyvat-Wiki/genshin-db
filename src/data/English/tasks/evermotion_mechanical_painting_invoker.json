			"dialogs": [
				{
					"id": 705330101,
					"content": "What a surprise. To think that my invention could be used in this fashion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330102,
					"content": "Ah, Traveler! It seems we meet again... *cough*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330103,
					"content": "I thought you'd left Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "That was the plan, yes, but... Things do change, you know...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330108,
					"content": "*cough* But let's get back on topic.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330109,
					"content": "This time, I've been invited by the Mondstadt Adventurers' Guild to create several Mechanical Paintings based on certain card faces that can be disassembled and reassembled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330110,
					"content": "As for the card game, what was it again... Ah, right, it's called Genius Invokation TCG.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330111,
					"content": "According to them, these paintings will be brought to be used in the King of Invokations Grand Prix as a sort of minigame to liven things up just a bit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330112,
					"content": "*sigh* These things are too complicated for me. I should just concentrate on my inventions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330113,
					"content": "Ah, yes, Mondstadt's mechanical paintings are with me, so if you want to play around with them, feel free.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330105,
					"content": "Did something go wrong with your invention again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "No, not at all! Not this time... Or should I say, there was never a problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330107,
					"content": "When I asked you for your help previously, I was having a monster problem, not an invention problem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				}
			]
		}
	]
}