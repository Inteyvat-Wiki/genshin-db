			"dialogs": [
				{
					"id": 240210701,
					"content": "You... Why did you bring both boxes of files over?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210702,
						240210704
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210702,
					"content": "I forgot which one it was!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210703
					]
				},
				{
					"id": 240210703,
					"content": "Pffft... I guess that's just how you roll. Thanks! Both boxes have files I need to organize, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210706
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210706,
					"content": "Since you've brought them both over, I should get going now. This is going to be a huge task!",
