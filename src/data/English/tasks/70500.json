			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000701,
					"content": "Mmm... A most wonderful flavor. One would have expected no less...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000702,
						705000703
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000702,
					"content": "Of you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				},
				{
					"id": 705000704,
					"content": "'Tis so. The completion of these three dishes has proven the reliability of one's Supreme Cuisine Machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000705
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000705,
					"content": "We have but to solve the two issues of heat control and the automatic retrieval of ingredients, and this machine shall truly have achieved \"all-in-one cooking.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000706
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000706,
					"content": "Ah, yes, lest one forgets... Your Braised Meat recipe. With but one difference — this recipe involves the use of normal Raw Meat instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000707
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000707,
					"content": "One deems that it might be inconvenient for you to scale this frigid mountain each time you wish to eat this meal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000708
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000708,
					"content": "Ordinary meat shall serve in ordinary occasions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000709
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000709,
					"content": "Regardless, you have one's thanks for your aid in foraging for ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000710
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000710,
					"content": "To one's abode one must now return, and make further improvements to this device. Let us part here, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000711
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000711,
					"content": "Should one require any further succor... perhaps one shall call upon you again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000712
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000712,
					"content": "A measure of faith one has that you shall not decline should that time come. Most highly does one regard your abilities and trustworthiness, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000703,
					"content": "Of your Supreme Cuisine Machine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				}
			]
		},
		{
			"id": 7050008,
			"completionStepIds": [],
