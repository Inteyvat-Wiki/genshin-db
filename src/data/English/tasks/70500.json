				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "The azure trees stand tall amid the snowy scene, the land is lonely and tranquil. Verily does one's third dish suit this atmosphere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000102,
					"content": "What kind of dish are you going to make this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "Well. Have you ever heard tell of a method known as \"braising\"? This technique did one discover upon reading through some culinary tomes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000104,
					"content": "A fancy did one take to it, and thus created a new recipe, \"Braised Meat,\" with this culinary technique as its heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000105,
					"content": "Now, this dish is hardly too tall a task for one's Supreme Cuisine Machine, but meat is key to this dish, and none but the best shall one have.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000106,
					"content": "Thus did one activate a mechanism and pursue the scent of fine ingredients to this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000107,
					"content": "The snow and wind drive hard here, and makes for slow work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000108,
					"content": "One is aware, Traveler, of your wealth of adventuring experience. Surely, then, a mere snowy mountain will prove no obstacle to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000109,
					"content": "One thus requests that you go forthwith and retrieve some ingredients once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000110,
					"content": "I'd like to have the recipe for this third dish, too.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "Your aid shall not be forgotten. For the completion of this errand shall one await you here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000112,
					"content": "Hmm. The mechanism has come to a halt. 'Tis must be the biting cold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000113,
					"content": "Allow one to restart it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000114,
					"content": "Supreme Cuisine Machine... activate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000115,
					"content": "This should resolve the issue. Now then, Traveler, pursue the scent one has put you on and retrieve those ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000116,
					"content": "Too cold to fly, are we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "Nonsense! How daring of you, to gainsay one's adeptal might! One is merely... occupied repairing these devices!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000118,
					"content": "Depart now. One grows impatient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
