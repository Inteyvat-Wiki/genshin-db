			},
			"dialogs": [
				{
					"id": 705000401,
					"content": "One could not call the heat control desirable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
		{
			"id": 7050005,
			"completionStepIds": [
				7050007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050007",
							"2"
						],
						"stepId": 7050007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000501,
					"content": "...What manner of morsel is this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000502,
					"content": "They call it Chilled Meat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "Chilled Meat... An apt name indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000504,
					"content": "It is of fair quality, too. Still, we shall need a small fire to thaw it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000505,
					"content": "Fortunately, defrosting counts among the Supreme Cuisine Machine's functions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000506,
					"content": "It sure seems to have no shortage of functions, huh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "Ah! Falsehoods. This device does not lack for missing functions. The ability to automatically gather ingredients, for one. Or automatic heat control, for that matter... one could go on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000508,
					"content": "Many improvements still must one make to it in the coming days.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000509,
					"content": "We shall cease the idle talk there. The ingredients are prepared, one shall activate this device immediately.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000510,
					"content": "The heat control shall still be left in your hands, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000511,
					"content": "One would have you report your readiness once you are sufficiently prepared.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 705000512,
					"content": "The adepti really are powerful.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "One would prefer that you saved that praise for the Supreme Cuisine Machine's faculties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
		{
