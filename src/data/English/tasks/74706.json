			"dialogs": [
				{
					"id": 747060101,
					"content": "Hmm... What about this one?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 747060102,
					"content": "Mm, I still feel like it's missing something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "Columbina? Furina? What are you guys up to?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "Director Furina and I are... \"casting\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 747060105,
					"content": "What a wonderful way to put it! But the \"actors\" we're looking for... just so happen to be fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "...Fish could be \"actors\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Animal actors are hardly a rarity these days. We're looking to cast a charismatic little fishie with just the right attitude to shoot some B-roll... It's essential for setting the mood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "But I feel like we've seen every fish in the whole aquarium, and none of them quite fit the bill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#Should we try asking {NICKNAME} and Paimon for help? They have a knack for solving tricky problems.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 747060110,
					"content": "Paimon's happy you have so much faith in us... but when it comes to casting fish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "We could try rounding up some more \"candidates\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "Great idea! You're the ones with aquarium management experience, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "So you're saying we should be on the lookout for talent whenever we go swimming? Paimon doesn't see why not!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "Then it's settled! I'll fill you in on the attitude we're looking for later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "I guess this makes you \"talent scouts\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 747060117,
					"content": "You've really picked up the showbiz vocab since you started hanging out with Furina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "Or even casting on location?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
}