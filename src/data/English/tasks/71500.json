				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000101,
					"content": "Mm... Perhaps this path is best...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000102
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000102,
					"content": "Ah, Traveler. Fine timing. Only recently has one finished setting this device up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000103,
						715000105
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000103,
					"content": "So this is the Supreme Cuisine Machine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000104
					]
				},
				{
					"id": 715000104,
					"content": "Verily. Much personal work has one put into it, and its faculties are vast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000107,
					"content": "Much lore did one read in the construction of this cuisine-making machine. Know that there are a few key points in the art of \"making food.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000108
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000108,
					"content": "The first of these is finding ingredients, which are of utmost importance in cooking. Many long years have countless chefs labored and wandered in search of all manner of ingredients...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000109
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000109,
					"content": "One's device aims to solve this issue first of all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000110
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000110,
					"content": "Upon activation, it will automatically search for suitable ingredients nearby, and will mark their scent out, all the better for chefs to track them to their source.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000111
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000111,
					"content": "Can't it go grab those ingredients by itself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000112
					]
				},
				{
					"id": 715000112,
					"content": "Ahem. This... Early days yet would one call this stage of work, and this issue of how a stove may trek across treacherous mountain roads by itself has yet to be resolved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000113
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000113,
					"content": "Now then, the second matter is the cooking itself. One has placed countless intricate components in this device's interior, such that the mere act of placing ingredients within will see them automatically processed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000114
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000114,
					"content": "How does it know how to do that?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000115
					]
				},
				{
					"id": 715000115,
					"content": "Well... Naturally, it references the corresponding recipe in determining how the ingredients are to be processed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000116
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000116,
					"content": "Its inner workings are difficult to explain in a short time. You only need to know that resolving this matter took quite some work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000117
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000117,
					"content": "Much thought has one also bent to an affair most troubling for chefs — the cleaning of one's cooking utensils.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000118
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000118,
					"content": "Quite a spoilage of a lovely scene of feasting it would be to have to clean up leftovers in the pot otherwise, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000119,
						715000122
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000119,
					"content": "Is this device for sale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000120
					]
				},
				{
					"id": 715000120,
					"content": "Haha, but one doubts you could afford this wondrous tool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000121
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000121,
					"content": "Moreover, it will only work under one's adeptal power at the moment. Purchasing it shall profit you nothing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000125,
					"content": "Alright, we have spoken idly long enough. Even as one was constructing this machine, one was also studying recipes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000126
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000126,
					"content": "Recipes too, therefore, has one developed alongside, such that this Supreme Cuisine Machine may face suitable trials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000127
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000127,
					"content": "One invited you here to lend a little aid in gathering ingredients and following said recipes to make some dishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000128
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000128,
					"content": "The first of these one names the Oncidium Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000129
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000129,
					"content": "This dish requires tofu to be diced into tiny threads... a fair trial for this machine's knife-work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000130
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000130,
					"content": "As to what the ingredients are... one shall require Tofu, Ham, Bamboo Shoots, and Fowl. One has already asked Ganyu to prepare those ingredients, and they should be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000131
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000131,
					"content": "...What? Where have the Bamboo Shoots gone? Most surely did one place them here. Did some villains take advantage of one's engrossed state to steal them away?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000132
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000132,
					"content": "...Hmph. No matter. This is a good opportunity to show you the ingredient-finding faculties of one's Supreme Cuisine Machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000133
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000133,
					"content": "Supreme Cuisine Machine... activate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000134
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000134,
					"content": "Traveler, the machine has been activated. Follow the tracks it has created and reclaim one's Bamboo Shoots.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000122,
					"content": "Why did you make this device?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000123
					]
				},
				{
					"id": 715000123,
					"content": "One's motive? Why, to explore the arts of mechanisms and engineering, naturally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000124
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000124,
					"content": "And of course, one's cooking will this render more convenient in the future...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000105,
					"content": "So, what does it do?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000106
					]
				},
				{
					"id": 715000106,
					"content": "Hmph, how hasty of you. Be at ease, and let one explain it to you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
