			},
			"dialogs": [
				{
					"id": 715000401,
					"content": "One could not call the heat control desirable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000402
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000402,
					"content": "But no matter. One has ingredients to spare with which to attempt this once more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
