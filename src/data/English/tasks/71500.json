			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cloud Retainer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "Then the rest can be left to this machine. However, Traveler, the heat control is yours to tend to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000304,
					"content": "Can't this machine do that by itself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "Well... One has tried several times to use an internal flame in an attempt to achieve autonomous heat control...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000306,
					"content": "But the flame on the Supreme Cuisine Machine's stove is far from ordinary. One must use one's own adeptal flame to operate it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000307,
					"content": "Adeptal flames of such power would warp the shape of the internal components if fed directly into the machine's interior. Sacrificing the larger machine for some small gain is thus unwise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000308,
					"content": "The best solution at present is to apply the adeptal flames externally. As such, one requires a helper to control the heat of said flames...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000309
					],
					"speakerTitle": "Cloud Retainer"
				},
				{
					"id": 715000309,
					"content": "The all-important flames shall be yours to command, Traveler. When you are ready, inform one at once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cloud Retainer"
				}
			]
		},
		{
			"id": 7150004,
			"completionStepIds": [
				7150007
			],
