					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490706,
					"content": "It's okay. Seriously, you don't need to give us anything in return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, that wasn't my intention... I only wished to adorn your melody with a ray of gentle moonlight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490709,
					"content": "We have pierced through cloud and fog, and together, witnessed the answer on the moon... Its beauty is like the music your strings now sing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
