	"talks": [
		{
			"id": 7604901,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"The Damselette"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "...Hmm, a half-step too high, perhaps. Let's try that again, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490102,
					"content": "Hey there, Columbina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "Wait, are you... teaching the kuuhenki how to play the lyre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Yes. They were so happy to have it fixed, they practically haven't left my side.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490105,
					"content": "Playing the lyre has never been my forte, though. I'm more accustomed to hearing others play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490106,
					"content": "Ohhh, right! If you had a band, you'd totally be in charge of vocals, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "#When it comes to instruments, though... {NICKNAME}'s pretty much a prodigy! From the lyre to the Djem Djem Drum, this one can do it all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "I'm nothing special, honestly...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "Oh, is that so? In that case... Perhaps you could teach them instead?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490111,
					"content": "Alright then, why not?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "I was having them practice the song I usually sing. Perhaps you remember how it goes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490114,
					"content": "Or... A different tune works as well. Rarely do the kuuhenki get to hear music from other places. I would be quite interested to hear something like that too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490115,
					"content": "(Hmm, what should I play...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Let's try the one Columbina always sings...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(But what tone should I go for...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Let's try calm and gentle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "That was lovely. So you really did memorize my tune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490605,
					"content": "Hehe, only 'cause you're such a great singer! Whenever we hear your voice, sometimes we stop for a bit just to listen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Hm, the kuuhenki seemed quite enraptured with your performance as well. Perhaps they picked up a few things...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490607,
					"content": "I might require your educational assistance again in the future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490608,
					"content": "Come, give me your hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490609,
					"content": "Huh? No, no, this was a free performance. No tuition fee required!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hmm? Tuition fee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490611,
					"content": "I only thought... the gentle glow of moonlight would make a fitting accompaniment for such a beautiful melody.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490701,
					"content": "Let's make it cheerful...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Oh, it's over already? I could listen to that forever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490703,
					"content": "As I once told you, this is the only lullaby I can remember.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490704,
					"content": "Although I have yet to discern the meaning behind it, after hearing you play, I feel like whatever answer is waiting for me, up there on the moon... at the very least, it must be a beautiful one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490705,
					"content": "Here, give me your hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490706,
					"content": "It's okay. Seriously, you don't need to give us anything in return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, that wasn't my intention... I only wished to adorn your melody with a ray of gentle moonlight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490801,
					"content": "Let's try something from another nation...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "How curious... I have heard melodies like this before, but your playing lends a whole new dimension...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490803,
					"content": "#Ah, maybe because {NICKNAME} was channeling {M#his}{F#her} emotional connection to that place...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "What's curious is that... I feel as if I can picture the landscape just by listening to the melody. I wonder how the real thing compares to my imagination...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490805,
					"content": "You should just go see it someday! We can be your tour guides!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Mm... Perhaps. If that day ever comes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760490112,
					"content": "But what should I play?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "Though I have been known to dabble...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
