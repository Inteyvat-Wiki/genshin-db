			"dialogs": [
				{
					"id": 120311901,
					"content": "Ugh, the wait is unbearable! How has the next chapter of \"The Miraculous Adventures of the Traveler\" not been released yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311902
					],
					"speakerTitle": "Kyouta"
				},
				{
					"id": 120311902,
					"content": "It was quite a surprise when the \"moonless night\" finally came.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311903
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311903,
					"content": "Yeah, that huge black cloud over Mt. Yougou that night. It just seemed to form out of nowhere!",
