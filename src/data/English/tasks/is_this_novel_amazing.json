					"id": 220100919,
					"content": "The most important thing in a novel is an exciting and attractive plot. I'm writing with that in mind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100920
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100920,
					"content": "*sigh* You...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100921
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100921,
					"content": "Come on, relax. I know what I'm doing. It will definitely get unanimous praise. You'll see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201013,
			"completionStepIds": [
				2201007
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201005",
							"2"
						],
						"stepId": 2201005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100922,
					"content": "Actually, Shigeru sounds more reasonable...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100923
					]
				},
				{
					"id": 220100923,
					"content": "Reasonable? Reasonableness is no substitute for a good plot. A reasonable plot would be boring without a compelling story!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100924
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100924,
					"content": "You... mark my words, when it comes time to wrap up the story, you'll go crazy trying to tie up the loose ends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100925
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100925,
					"content": "I—I took some notes. We won't have any problems ending the story!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100926
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100926,
					"content": "You have to take notes to remember all the details, do you? Are you expecting the readers to take notes as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100927
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100927,
					"content": "Uh... Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100928
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100928,
					"content": "I'm not saying you can't add these new features. I'm just saying that you have to be mindful of how many there are and when they are added.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100929
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100929,
					"content": "Writing a novel is like running a marathon. If you go too hard at the start, you'll just lose steam later on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100930
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100930,
					"content": "The key to a successful novel is to move forward steadily, one step at a time. Trust me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100931
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100931,
					"content": "Okay, okay... *sigh*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		}
	]
}