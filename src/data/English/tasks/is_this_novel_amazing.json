			"dialogs": [
				{
					"id": 220100701,
					"content": "Tsukumomono Groceries sells all kinds of goods similar to the items collected during my character's adventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "I mean, Aoi always says that \"one man's trash is another man's treasure.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100703,
					"content": "Hmm... It seems like finding out what the buyer values is the key to selling goods at a high price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "But if I write it like this, I'll have to spend time describing psychology. It doesn't fit the theme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "...Why don't I just make the main character a psychic that can intuit the needs of the buyer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "You can't suddenly add traits to the character!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "It's character development. It's okay. Don't worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "Well, there we have it, then! I know what to write!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "Traveler, let's go back. I'm going to tell Shigeru about my idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100708,
					"content": "Where's its basis in the plot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "Plot basis... hmm, I'll think about it while I write. It shouldn't be a problem.",
