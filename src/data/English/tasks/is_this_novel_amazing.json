			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "Junkichi, the deadline to turn in the manuscript is tomorrow. No more delays!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100102,
					"content": "There's no use pushing me! I'm stuck at a critical point in the story and I've got writer's block.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100103,
					"content": "What are you two arguing about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "...Traveler! Just the voice of reason we need.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100105,
					"content": "I'm Shigeru, an editor at the Yae Publishing House. This is Junkichi, the writer I'm in charge of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100106,
					"content": "His new novel, \"Onibudo,\" is very popular. But he never meets his deadlines. Sometimes he even delays for weeks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100107,
					"content": "And he's at it again, of course. If he doesn't turn his manuscript in by tomorrow, I won't be able to get this month's issue into print.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100108,
					"content": "Why don't we postpone the issue? Our loyal readers will still pay for it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100109,
					"content": "Don't be ridiculous. If it isn't updated regularly, the novel's reputation will go into the trash!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100110,
					"content": "But I've just got no inspiration right now, and I'm not going to write some garbage chapter. There's just got to be an interesting story!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100111,
					"content": "But all the other writers are basically done. You're the only one left!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100112,
					"content": "Maybe Junkichi really just needs a bit of inspiration...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "That's right! My friend here gets me. I need inspiration!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100114,
					"content": "I'll go around and look for some — I'm sure something will come to me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100115,
					"content": "Hey! That's the excuse you used last time to put it off. We're not doing this again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100116,
					"content": "I'm not lying this time. Come on, trust me just this once!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100117,
					"content": "Hmm... All right. Fine. But this is the last time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100118,
					"content": "No further delays! Got it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100119,
					"content": "Okay, okay, I got it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100120,
					"content": "Phew... I guess I can't put it off this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100121,
					"content": "Let's go get some material.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "Well, time to go get some inspiration then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "Were it so easy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100124,
					"content": "But we have to do it somehow, or Shigeru will turn my house upside down...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
