			},
			"dialogs": [
				{
					"id": 220100601,
					"content": "Sparks fly as hammers clash against anvils...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100602,
					"content": "Amenoma Smithy is such place full of passion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100603,
					"content": "Blacksmiths turn rough billets and ore into powerful weapons using such simple tools.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100604,
					"content": "If alchemy is used while forging, wouldn't it be possible to create indestructible weapons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100605,
					"content": "Alchemy can't do that...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Yes! That's a good idea. The main character shall have the strongest weapon! One forged using alchemy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100609,
					"content": "Now, this weapon needs to have an awesome name... and an awesome backstory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100610,
					"content": "That's it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100611,
					"content": "Traveler, let's go back. I'm going to tell Shigeru about my idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100606,
					"content": "I don't think you understand alchemy...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "What do you mean? Isn't alchemy the kind of thing that makes the impossible possible?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
