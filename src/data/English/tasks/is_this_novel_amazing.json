			"dialogs": [
				{
					"id": 220100801,
					"content": "The Doushin keep the peace in Hanamizaka. No criminals can escape their watch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100802,
					"content": "In the story, the enemy's knights have the same duties as the Doushin. But to make it interesting, let's make them ten times as strong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100803,
					"content": "That's such an arbitrary number!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "Number scales are the clearest thing in the world. That'll help us show how powerful the main character is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100806,
					"content": "Well, I'll... give the main character mastery over disguises. Like being able to freely change their appearance and voice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100807,
					"content": "Is this some new character trait?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "This is the main character's hidden ability. An encounter with certain enemies is the best time to reveal it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100809,
					"content": "Hey, you just made that up, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "N—No... It was my plan all along. C—Come on, now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100811,
					"content": "Anyway, let's just go with that. Time to go tell Shigeru about my idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100805,
					"content": "And how will the main character solve this conundrum?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100806
					]
				}
