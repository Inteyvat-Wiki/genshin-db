			"dialogs": [
				{
					"id": 100060501,
					"content": "\"This is the first time we're meeting, so I'm not sure how to address you. But since you're M's child, I suppose I'll stick with 'Mini Durin.'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060502
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060502,
					"content": "\"Though you appear smaller than the Durin that came before you, that same strength flows through your veins — not a drop less.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060503
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060503,
					"content": "\"He was a child of 'Humus,' an incomplete creation. Thus, he lacked the 'will' to control his own strength.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060504
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060504,
					"content": "\"Yet this power was beyond what he could withstand, and so it twisted him, consumed him, thus sealing his ultimate fate.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060505
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060505,
					"content": "\"Albedo claims that you have transcended this tainted blood, becoming a being much like himself. That is his opinion. I remain unconvinced.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060506
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060506,
					"content": "\"I trust only the facts, only that which I 'see' for myself. So take this chance, child of M. Prove yourself to me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Rhinedottir\""
				}
			]
		},
		{
			"id": 1000606,
			"completionStepIds": [],
