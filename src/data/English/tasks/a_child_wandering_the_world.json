			},
			"dialogs": [
				{
					"id": 100060801,
					"content": "Ahem... And that's all Master Rhinedottir has to say. *coughs*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060802
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060802,
					"content": "Uh, could we get a self-introduction, at least?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060803
					]
				},
				{
					"id": 100060803,
					"content": "Yeah! We're used to talking cats at this point, but one that can imitate someone else's voice... That's a first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060804,
					"content": "I don't see how that's important, but if you must know... I am Sebas, a simple butler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060805
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060805,
					"content": "You're friends of Albedo, yes? Strictly speaking, I am his \"elder.\" So, make no mistake — I am no ordinary cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
			]
		},
		{
			"id": 1000609,
			"completionStepIds": [
				1000606
