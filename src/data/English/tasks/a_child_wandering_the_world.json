			},
			"dialogs": [
				{
					"id": 100060701,
					"content": "Ahem... And that's all Master Rhinedottir has to say. *coughs*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060702
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060702,
					"content": "Good work, Sebas. Can't be easy being you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060703
					]
				},
				{
					"id": 100060703,
					"content": "Heh. A cat that can imitate someone else's voice is just as strange to witness as the first time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060704,
					"content": "Well, do not be so shocked. I am hardly an ordinary cat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
			]
		},
