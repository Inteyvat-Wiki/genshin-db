			},
			"dialogs": [
				{
					"id": 100060601,
					"content": "\"Hmm. Looks like Albedo wasn't mistaken after all.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060602,
					"content": "Next time, maybe don't ambush us with a bunch of monsters just to prove a point!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060603,
					"content": "Still, I do feel like I can control my power more freely now that we've defeated them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060604,
					"content": "\"After hearing about you, I prepared a technique that would seal the dark power in your blood. I had planned to take this opportunity to pass it on to you.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060605,
					"content": "\"Of course, using it comes with a price. While it would maintain your existence in Teyvat, it would also weaken your connection to this world.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060606,
					"content": "\"And you are M's child, when all is said and done. How could I allow that uncontrolled power to send you down the same path as the child who came before you?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060607,
					"content": "\"But seeing you now, it appears my concerns were misplaced. M was a terrific mother, and a far more capable one than I.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060608,
					"content": "\"And I must admit, I'm rather curious to see how far you can go — how will you, an alchemical being truly integrated with this world, find your place in human society?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060609,
					"content": "\"I've never conducted an experiment like this before. As such, you may yet hold the key to some unexpected answers.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060610,
					"content": "Hey! You've got one thing wrong there. Durin's not an experiment! He's our friend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060611,
					"content": "I'm not sure I understand, but... I appreciate your kindness, Aunt Rhinedottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				}
			]
		},
