			"dialogs": [
				{
					"id": 740831001,
					"content": "And that's another key for us. Now all we need to do is find the final one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831002,
					"content": "Key, key, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831003,
					"content": "Oh, Pahsiv! Where did you come from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831004,
					"content": "Disappeared, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831005,
					"content": "Okay then... Paimon's never met a Melusine so unique... And Paimon thought Melusine all lived in the Court of Fontaine or Merusea Village. How come you're out here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831006,
					"content": "Court of Fontaine? Merusea Village?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831007,
					"content": "You seem confused. Haven't you heard of those places?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831008,
					"content": "Court of Fontaine, Melusine... Merusea Village, Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831009,
					"content": "Ah... Erinnyes, Pahsiv, home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831010,
					"content": "Erinnyes, Pahsiv, protect!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831011,
					"content": "Wait, you're saying that this is your home? And that you're protecting it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831013,
					"content": "But don't the Melusine live in Merusea Village?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831014
					]
				},
				{
					"id": 740831014,
					"content": "Yes, that's kinda strange. Are some Melusine born elsewhere? Paimon can't see any others here though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831015,
					"content": "Pahsiv, do you live here alone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831016,
					"content": "Alone? Melusine. New Valet! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831017,
					"content": "New... Valet? There's a valet? Who?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831018,
					"content": "#New... Valet! Paimon, Paimon, {NICKNAME}, {NICKNAME}. New Valet, New Valet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831019,
					"content": "So who is New Valet, exactly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831020
					]
				},
				{
					"id": 740831020,
					"content": "Pahsiv... are you trying to say New Valet is called New Valet, like Paimon is called Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831022,
					"content": "Ah-ha! I was right. Paimon's always said that she's clever, hasn't she?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831023,
						740831024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831023,
					"content": "It's a very strange name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				},
				{
					"id": 740831025,
					"content": "New Valet, Pahsiv, knowledge, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831026,
					"content": "Err... you mean that New Valet is helping you learn things?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831027,
					"content": "Pahsiv! Lots of. Language, wisdom... lots of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831028,
					"content": "Er, Paimon's not sure about the \"lots of\" bit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831029,
					"content": "Pahsiv, New Valet, protect, ka-pow.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831030,
					"content": "And he helps you protect this place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831031,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831032,
					"content": "You help him protect this place?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831033
					]
				},
				{
					"id": 740831033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831034,
					"content": "So that's it... But who is this New Valet? And why does he need you to help protect this place, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831035
					],
					"speakerTitle": "Paimon"
