					{
						"sceneId": 3,
						"position": [
							1136.21,
							506.39,
							-831.26
						],
						"pointId": 16843
					}
				]
			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "...Seeker of Power, Follower of Fate, you are here at last.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "It's Durin... Paimon's really not surprised at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "There's something odd about the way he's speaking...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "A sovereign ruler, the creation of a mage, and a descendant of angels... All wield disparate powers, yet all were crowned as dragons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "...This is because dragons are the symbol of power.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "So \"doing battle with great dragons\" became a way to prove your strength? Huh. I think I might be starting to understand the founding Grand Master a little better.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "...Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "I can see you still have much to say, but I suggest we cross blades instead. After all, a single sword stroke is worth a thousand words!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "W—Wait! Y—Young human, the trial you seek is far from here. You must venture to Stormterror's Lair and face the final prophecy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "Why is he talking so fast?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "Are you alright, Durin? You sound kinda weird today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Ahhh, phew... I think I got through the important bits... even if I did have to skip a lot!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Uhm, I think Albedo said he needed help with an experiment, so I'd better be heading back now. Sorry, everyone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Well he sure left in a hurry... What a shame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "Hey, what's this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Uhm... Why exactly was Durin here? Apart from that last line about \"venturing to Stormterror's Lair,\" he just seemed to be talking nonsense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "Something tells me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "Interesting. I'm getting curious as to exactly how this \"prophecy\" will come true...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "...He was only here so that the next dragon counts as number three.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "He sounds like an actor who wants to get off stage!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
		{
			"id": 7009606,
