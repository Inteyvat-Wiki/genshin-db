						],
						"pointId": 16840
					},
					{
						"sceneId": 3,
						"position": [
							1145.312,
							506.323,
							-831.24
						],
						"pointId": 16841
					},
					{
						"sceneId": 3,
						"position": [
							1136.39,
							506.295,
							-832.83
						],
						"pointId": 16842
