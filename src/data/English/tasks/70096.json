						],
						"stepId": 7009601,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Slazhnev",
					"Leifhelm"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "Our captain isn't just strong — he even developed a compound that counters the Abyss! Bet you didn't know that, did you, smartypants? And yet you think I'm a \"false expert\" who doesn't know anything!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960202,
					"content": "Well, do you know about our Grand Master's amazing speed? He used the Ley Lines to travel all the way from Nod-Krai to Mondstadt in less time than it takes you to tie your shoelaces — if you even know how!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leifhelm"
				}
			]
		},
