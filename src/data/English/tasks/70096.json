			"dialogs": [
				{
					"id": 700960401,
					"content": "Such fluid movements... I'd never have guessed you were a machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960402,
					"content": "Your attacks are also very precise, Mr. Lohen. Almost mechanically so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960403,
					"content": "Woohoo, new parts, hehe! I'm gonna be able to create some excellent new modules with these!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960404,
					"content": "And... Uhm... Does this mean you're free to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960405,
					"content": "Ineffa, look for more! I want as many as we can get!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960406,
					"content": "Understood... My apologies, Mr. Lohen. We can talk about this later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960407,
					"content": "After much exploration...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960409,
					"content": "Aino's asleep... Did she wear herself out playing in Dornman Port?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960410,
					"content": "She's often like this — her batteries drain quickly. I am sorry, Mr. Lohen, but I'm afraid I can't get up right now. I must stay here until Aino has entered a deeper state of sleep...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960411,
					"content": "...That's quite all right. I've already seen enough to know what you're capable of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960412,
					"content": "...I hope my combat data provides some useful insights.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960413,
					"content": "By the way, the person who told us about these special mechanisms also mentioned Dragonspine. You might want to go there and check things out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		},
		{
			"id": 7009605,
			"completionStepIds": [
				7009605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
