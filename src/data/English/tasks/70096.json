						700960703
					]
				},
				{
					"id": 700960703,
					"content": "Besides, it didn't really end badly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960704,
					"content": "Your first attempt at what, though?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
