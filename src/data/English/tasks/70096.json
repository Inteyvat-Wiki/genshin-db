					}
				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "Ineffa! Ineffa! Did you see that windmill!? I need you to make a record of how it works!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "Understood — preparing to photograph the windmill. Would you like to be included in the picture this time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#Huh? {NICKNAME} and Paimon? And Lohen!? Hey there!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "Ohhhh... Intel from Nod-Krai about a powerful ancient dragon... Paimon sees what's going on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Assessing situation... It appears that Mr. Lohen hopes to fight me. Is that correct?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "In a nutshell, yes — that's exactly what I was hoping to do. Back when the expedition was in Nod-Krai, I had no reason to suspect you had such an extraordinary history.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "But that's all by the by. I've been wanting to test my skills against you for quite some time now, so... How about it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "Hehe! Ineffa, show him who's boss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "My apologies — according to today's schedule, we still have to visit Mondstadt to collect some special components. My assessments indicate that fighting you now may impact our subsequent operations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Oh, yeah... I almost forgot! We heard there was some sort of giant robot in Mondstadt... That's why we're here! But then I got a little side-tracked...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "It's alright... I understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen... You're not seriously giving up just like that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "If I help you deal with the Ruin Guards, that should clear up your schedule, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
