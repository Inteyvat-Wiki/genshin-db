			"dialogs": [
				{
					"id": 790290101,
					"content": "There's a statue here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290102,
					"content": "*sigh*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "Captain Night Raven"
				},
				{
					"id": 790290103,
					"content": "Hey there, why are you sighing alone at this cavern entrance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290112,
					"content": "Well, I've been living here lately...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "Captain Night Raven"
				},
				{
					"id": 790290113,
					"content": "You've been living in a place like this!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290114,
					"content": "I didn't have a choice! A bunch of actors came to the island and started making a racket all day and all night. I couldn't even sleep because of them... So I found myself a quieter spot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "Captain Night Raven"
				},
				{
					"id": 790290104,
					"content": "But then a group of hilichurls came out of nowhere and occupied my resting place. So I had no choice but to brave the elements out here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "Captain Night Raven"
				},
				{
					"id": 790290105,
					"content": "*sigh* I swore to myself that if someone could help me, I'd tell them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "Captain Night Raven"
				},
				{
					"id": 790290106,
					"content": "Tell them what?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290107,
					"content": "Tell them about a clue to finding the legendary Secret Pirate Treasure! Although I only know a quarter of it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "Captain Night Raven"
				},
				{
					"id": 790290108,
					"content": "A quarter of a clue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290109,
					"content": "You seem like you're here for the treasure too. So, what do you say? Get rid of the hilichurls in there and I'll give you the clue's location.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "Captain Night Raven"
				},
				{
					"id": 790290110,
					"content": "They say that if you collect all four parts of the clue, you can find the treasure that pirates left behind here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "Captain Night Raven"
				},
				{
					"id": 790290111,
					"content": "Well, you have a deal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
