				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sebas",
					"Albedo",
					"\"Rhinedottir\""
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1195.911,
							375.446,
							-801.068
						],
						"pointId": 13934
					}
				]
			},
			"dialogs": [
				{
					"id": 100051301,
					"content": "Strange to see you so idle, Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051302
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051302,
					"content": "But considering that you've completed Master Rhinedottir's final task, I suppose you deserve a break.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051303
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051303,
					"content": "See! What did Paimon tell you? You ask for trouble, and here it comes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051304,
					"content": "Sebas? What are you doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051305,
					"content": "Wait. You know this cat, Albedo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051306
					]
				},
				{
					"id": 100051306,
					"content": "Yes. He's also one of my master's creations. I suppose that makes him a... family member, of sorts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051307,
					"content": "Ever the unconventional family you've got there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051308
					]
				},
				{
					"id": 100051308,
					"content": "Hmph, don't you take that tone with me. I'll have you know that I alone keep that giant house in order as its butler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051309
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051309,
					"content": "And yes, that has meant dealing with the assorted collection of vials and jars that you and Master use, washing them, drying them... All that work, done by one cat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051310
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051310,
					"content": "Wait. You're a butler? How does that work? How do you handle vials and stuff without... y'know, thumbs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051311,
					"content": "How do you stay afloat in mid-air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051312
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051312,
					"content": "Huh? It's just something Paimon's always known how to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051313,
					"content": "Housekeeping is the same for me. Such facts are not up for question, and shall receive no answers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051314
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051314,
					"content": "Hey! You're not allowed to say the same answer that Paimon said, you—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051315,
						100051316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051315,
					"content": "This cat belongs to Rhinedottir, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				},
				{
					"id": 100051317,
					"content": "Ugh. Sure, but don't expect Paimon to listen to his rambling...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051318,
					"content": "Allow me to get to the point, then. I'm here at Master Rhindottir's request. She has a message for me to pass along.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051319
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051319,
					"content": "Ahem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051320
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051320,
					"content": "\"Dearest Albedo, in regard to that task I set for you, your discovery of an answer that you can accept is most delightful.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051321
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051321,
					"content": "\"Alas, once a problem is solved, mulling it over in one's head loses all meaning.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051322
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051322,
					"content": "\"I'm sure the pendulum in your ever-whirring mind is swinging toward 'boredom' as we speak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051323
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051323,
					"content": "\"Might I suggest posing questions of your own, then?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051324
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051324,
					"content": "\"Cast 'the answers you know' aside. Instead, embrace 'the questions you don't.'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051325
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051325,
					"content": "\"After all, questions have always been more interesting than answers, and much better for passing the time.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051326
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051326,
					"content": "\"I look forward to what questions you'll bring me upon our next meeting.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051327
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051327,
					"content": "\"And should you come up with ones even I've never considered, all the better.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051328
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051328,
					"content": "\"It's unlikely, of course, but do your best. And who knows? If you're lucky, you might just surprise me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051329
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051329,
					"content": "\"Oh, and don't attempt to create a 'self' whose sole purpose is to pose or ponder questions. I've tried it, and it doesn't work.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051330
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051330,
					"content": "\"Lastly, I sent Sebas with a gift for you. Do keep it well, alright? Ah, and no need to feed him. He doesn't get hungry.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051331
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051331,
					"content": "As you instruct, Master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051332
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051332,
					"content": "*coughing*... Master had quite a bit to say, I see... That really took a lot out of me, *coughing*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051333
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051333,
					"content": "Well, I've passed the message along, so I shan't tarry in this frozen deathtrap for a second longer. I need to deliver a separate message to Mondstadt, at any rate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051334
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051334,
					"content": "Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051335
					]
				},
				{
					"id": 100051335,
					"content": "Huh, who else would have a connection to Rhinedottir in Mondstadt... Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051336,
					"content": "Although his \"birth\" was rather recent, Master Rhinedottir has long foreseen what his \"task\" should be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051337
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051337,
					"content": "But I digress. I shall be on my way. If I stay here a second longer, my tail might turn into an icicle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051338
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051338,
					"content": "Your \"gift\" from Master Rhinedottir is on the table. Use it well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051339
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051339,
					"content": "Y'know, Albedo... Your family gets more confusing by the second...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051340,
					"content": "Yeah, now you're even adding a cat to the mix...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051341
					]
				},
				{
					"id": 100051341,
					"content": "Speaking of, would that cat really count as a family member? He called himself a butler and all, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051342,
					"content": "Master created Sebas long before me. By the standards of a normal family, that would make him my \"elder,\" I suppose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051343
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051343,
					"content": "Of course, my family could scarcely be considered \"normal.\" So, by that logic, that type of relationship holds little meaning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051344
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051344,
					"content": "At the same time, Sebas did look after me quite a bit back in the day, helping me tidy up various vials and jars... He even modeled for my sketches at times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051345
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051345,
					"content": "Wait a second, the cat you drew today... That's him then, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051346,
					"content": "Yes. Whenever I need to think, I turn to drawing, and let my subconscious take over. It always helps me sort my thoughts out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051347
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051347,
					"content": "And, for some reason, I often wind up choosing a portrait of Sebas... I have drawn so many at this point that it's become second nature. Thus, this leaves my mind free to consider other things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051348,
						100051349
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051348,
					"content": "Now that you mention it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051350,
					"content": "Yeah, we thought it was just a random cat! Guess he was a way bigger deal than we thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051351,
					"content": "Well, now you know his real name. I can tell you more stories about him sometime, if you like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051352
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051352,
					"content": "But right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051353
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051353,
					"content": "\"The tree takes pride in its most perfect fruit — so complete, so flawless.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051354
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051354,
					"content": "\"But you, O seed of dreams, do not settle for being the king of a universe confined to its flesh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051355
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051355,
					"content": "...I need to think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051349,
					"content": "We've seen you draw a cat before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051316,
					"content": "Might be best if you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				}
			]
		},
		{
			"id": 1000514,
			"completionStepIds": [
				1000502
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"1000601",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sebas",
					"Albedo",
					"\"Rhinedottir\""
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1195.911,
							375.446,
							-801.068
						],
						"pointId": 13934
					}
				]
			},
			"dialogs": [
				{
					"id": 100051401,
					"content": "Strange to see you so idle, Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051402
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051402,
					"content": "But considering that you've completed Master Rhinedottir's final task, I suppose you deserve a break.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051403
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051403,
					"content": "Whoa! S—Sebas! Where did you come from? Paimon didn't hear a thing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051404,
					"content": "Nice to see you again.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051405
					]
				},
				{
					"id": 100051405,
					"content": "Oh, so you've met. I don't suppose Sebas told you of our relation to each other, did he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051406
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051406,
					"content": "He said he was your \"elder.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051407
					]
				},
				{
					"id": 100051407,
					"content": "...If I had to put a label on it, then... I suppose that's fair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051408
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051408,
					"content": "Ever the unconventional family you've got there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051409
					]
				},
				{
					"id": 100051409,
					"content": "Hmph, don't you take that tone with me. I'll have you know that I alone keep that giant house in order as its butler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051410
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051410,
					"content": "And yes, that has meant dealing with the assorted collection of vials and jars that you and Master use, washing them, drying them... All that work, done by one cat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051411
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051411,
					"content": "Wait. You're a butler? How does that work? How do you handle vials and stuff without... y'know, thumbs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051412,
					"content": "How do you stay afloat in mid-air?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051413
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051413,
					"content": "Huh? It's just something Paimon's always known how to do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051414,
					"content": "Housekeeping is the same for me. Such facts are not up for question, and shall receive no answers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051415
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051415,
					"content": "Hey! You're not allowed to say the same answer that Paimon said, you—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051416,
						100051417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051416,
					"content": "This cat belongs to Rhinedottir, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051418
					]
				},
				{
					"id": 100051418,
					"content": "Ugh. Sure, but don't expect Paimon to listen to his rambling...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051419,
					"content": "Allow me to get to the point, then. I'm here at Master Rhindottir's request. She has a message for me to pass along.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051420
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051420,
					"content": "Ahem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051421
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051421,
					"content": "\"Dearest Albedo, in regard to that task I set for you, your discovery of an answer that you can accept is most delightful.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051422
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051422,
					"content": "Alas, once a problem is solved, mulling it over in one's head loses all meaning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051423
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051423,
					"content": "\"I'm sure the pendulum in your ever-whirring mind is swinging toward 'boredom' as we speak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051424
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051424,
					"content": "\"Might I suggest posing questions of your own, then?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051425
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051425,
					"content": "\"Cast 'the answers you know' aside. Instead, embrace 'the questions you don't.'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051426
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051426,
					"content": "After all, questions have always been more interesting than answers, and much better for passing the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051427
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051427,
					"content": "\"I look forward to what questions you'll bring me upon our next meeting.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051428
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051428,
					"content": "\"And should you come up with ones even I've never considered, all the better.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051429
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051429,
					"content": "\"It's unlikely, of course, but do your best. And who knows? If you're lucky, you might just surprise me.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051430
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051430,
					"content": "\"Oh, and don't attempt to create a 'self' whose sole purpose is to pose or ponder questions. I've tried it, and it doesn't work.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051431
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051431,
					"content": "\"Lastly, I sent Sebas with a gift for you. Do keep it well, alright? Ah, and no need to feed him. He doesn't get hungry.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051432
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051432,
					"content": "As you instruct, Master.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051433
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051433,
					"content": "*coughing*... Master had quite a bit to say, I see... That really took a lot out of me, *coughing*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051434
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051434,
					"content": "In any case, you have your message. Why you insist on staying in a place like this is beyond me. Couldn't you have stayed in Mondstadt like that other fellow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051435,
						100051436
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051435,
					"content": "(\"That other fellow...\")",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051437
					]
				},
				{
					"id": 100051437,
					"content": "But I digress. I shall be on my way. If I stay here a second longer, my tail might turn into an icicle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051438
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051438,
					"content": "Your \"gift\" from Master Rhinedottir is on the table. Use it well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051439
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051439,
					"content": "Y'know, Albedo... Your family gets more confusing by the second...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051440,
					"content": "Yeah, now you're even adding a cat to the mix...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051441
					]
				},
				{
					"id": 100051441,
					"content": "Speaking of, would that cat really count as a family member? He called himself a butler and all, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051442,
					"content": "Master created Sebas long before me, so he was right. By the standards of a normal family, that would make him my \"elder.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051443
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051443,
					"content": "Of course, my family could scarcely be considered \"normal.\" So, by that logic, that type of relationship holds little meaning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051444
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051444,
					"content": "At the same time, Sebas did look after me quite a bit back in the day, helping me tidy up various vials and jars... He even modeled for my sketches at times.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051445
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051445,
					"content": "Wait a second, the cat you drew today... That's him then, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051446,
					"content": "Yes. Whenever I need to think, I turn to drawing, and let my subconscious take over. It always helps me sort my thoughts out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051447
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051447,
					"content": "And, for some reason, I often wind up choosing a portrait of Sebas... I have drawn so many at this point that it's become second nature. Thus, this leaves my mind free to consider other things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051448,
						100051449
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051448,
					"content": "Now that you mention it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051450
					]
				},
				{
					"id": 100051450,
					"content": "Yeah, we thought it was just a random cat! Guess he was a way bigger deal than we thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051451,
					"content": "Well, now you know his real name. I can tell you more stories about him sometime, if you like.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051452
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051452,
					"content": "But right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051453
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051453,
					"content": "\"The tree takes pride in its most perfect fruit — so complete, so flawless.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051454
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051454,
					"content": "\"But you, O seed of dreams, do not settle for being the king of a universe confined to its flesh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051455
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051455,
					"content": "...I need to think.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051449,
					"content": "We've seen you draw a cat before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051450
					]
				},
				{
					"id": 100051436,
					"content": "(He must be talking about Durin...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051437
					]
				},
				{
					"id": 100051417,
					"content": "Might be best if you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051418
					]
				}
			]
		}
	]
}