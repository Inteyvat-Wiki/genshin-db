			"dialogs": [
				{
					"id": 100050201,
					"content": "Hey, Albedo! Thought we'd find you here. Oh! Are you painting?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050202,
					"content": "Yes. I finally have a moment to myself, so I decided to pick up my brush and get some practice in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050203
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050203,
					"content": "Yeah, a lot of stuff has happened, huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050204
					]
				},
				{
					"id": 100050204,
					"content": "Indeed. Of course, thanks to your help, and my fellow Knights, that matter was resolved with little issue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050205,
					"content": "In addition, I was able to complete the final task my master left for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050206
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050206,
					"content": "I couldn't have asked for a better outcome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050207,
					"content": "Sucrose has been advancing swiftly in her studies, too. She can tackle many alchemy projects on her own now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050208
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050208,
					"content": "The Knights of Favonius don't have any duties for me at the moment, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050209
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050209,
					"content": "No responsibilities, no tasks, no problems to resolve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050210,
						100050211
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050210,
					"content": "Are you okay?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				},
				{
					"id": 100050212,
					"content": "It's not. It just feels strange, not having to wrack my brain for solutions to all manner of problems...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050213
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050213,
					"content": "To be quite honest, I'm finding the idle life a bit... hard to get used to.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050214,
					"content": "I keep finding myself considering if there might be other issues that need solving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050215
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050215,
					"content": "But, unfortunately for me, Mondstadt seems perfectly problem-free at the moment...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050216
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050216,
					"content": "There's nothing wrong with enjoying a bit of \"me\" time. Nothing good comes from working yourself to the bone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050217,
					"content": "But if you're really that bored, you can come hang out with us! Paimon will teach you the true art of doing nothing!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050218,
					"content": "Haha, well, I suppose I should learn from the best.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050219,
						100050220
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050219,
					"content": "And if you're looking for trouble...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050221,
					"content": "#{NICKNAME}! Don't say things like that! You're gonna jinx us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050220,
					"content": "I have a knack for finding it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050211,
					"content": "You make that sound like a bad thing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				}
			]
		},
		{
