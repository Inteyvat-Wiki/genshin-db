			},
			"dialogs": [
				{
					"id": 150290501,
					"content": "You told him everything, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290502,
					"content": "Yep! We left out the part about your contribution, but it kinda seemed like Chief Biram saw through us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290503,
					"content": "You could have just said it was a \"gift from the spirits\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290504,
					"content": "Yeah, but Chief Biram deserved something in return for his hard work.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "...I guess he is different from the previous chiefs. But, if he figures out it was me all these years, I'm in for a world of trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290506,
					"content": "There you are! I've been looking everywhere for you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290507,
					"content": "Oh, it's the other Fontainian researcher... He wasn't taken away with his boss?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290508,
					"content": "Please, call me Allier... After questioning, the tribe absolved me of any serious wrongdoing, so here I am.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290509,
					"content": "I'll be heading back to Fontaine soon — no employer means no funding, after all. But, I wanted to finish my investigation first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290510,
					"content": "I'd like to ask some questions about Huitzilin. I want people outside of Natlan to hear her story, but my understanding still has some holes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290511,
					"content": "Questions? Hmph... Why should I let an outlander tell our stories?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290512,
					"content": "Don't misunderstand — I have no intention of twisting your history or using it to make a profit. It's just honest curiosity, I assure you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290513,
					"content": "I believe amazing stories deserve to be shared with the world. Culture thrives through dialogue and exchange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290514,
					"content": "He has a point.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "Alright, you can ask your questions, but be quick. I have important plans after this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290516,
					"content": "Important plans?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290517,
					"content": "Thank you very much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290518,
					"content": "Allier conducts a thorough interview, only leaving when Citlali finally runs out of patience.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "Another day, another drained social battery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "Citlali"
