							-9.541,
							0.032,
							11.813
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "Now, when it comes to weaving the scroll itself, you don't actually need to lift a finger. But, if we're going to pass on Huitzilin's technique, your participation is critical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290102,
					"content": "What are you saying, Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290103,
					"content": "Follow me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290104,
					"content": "Whoa, look at this place... Do you weave scrolls, too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290105,
					"content": "Scrolls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290106,
					"content": "Scrolls? I thought you were going to show me your masterpiece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290107,
					"content": "That I am, old friend. The technique I'm about to show you directly relates to woven scrolls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290108,
					"content": "*sigh* Fine, what is it? Something that can turn the tide of war or prevent a great disaster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290109,
					"content": "You probably want to challenge me, right? I know you don't have the strength for a real fight, so I'll let you beat me with words.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290110,
					"content": "*cough*... Old friend, my life is nearing its end. I'm afraid... I don't have time for another match.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290111,
					"content": "Hey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290112,
					"content": "Don't worry. I trust in the belief of our tribe... that death is not the end, but the beginning of a new existence in the Night Kingdom, where everything is made of memories.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290113,
					"content": "So, do you know why our ancestors insisted on using colorful woven scrolls to record our history?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290114,
					"content": "Because... history is the memory of a people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290115,
					"content": "We give our scrolls an orange hue so the dead can still feel the warmth of the setting sun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290116,
					"content": "We decorate them with kernels of Grainfruit so the dead can still enjoy the abundance of our harvests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290117,
					"content": "I know that... But, something this important? Why entrust it to me and not one of your students?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290118,
					"content": "Hehe, as your friend, I admit... I'm being a bit selfish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290119,
					"content": "*cough* I don't have long, Citlali. I'm not sure... I can truly explain my decision. But, I know you will understand one day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290120,
					"content": "For now... will you accept my final request?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290121,
					"content": "...Just this once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290122,
					"content": "I understand now, Huitzilin — just like you said I would... Claw, help me move this outside. I'm going to color it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME}, Paimon, come with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
			"id": 1502902,
