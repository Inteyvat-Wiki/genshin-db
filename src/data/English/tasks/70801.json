					"nextDialogs": [
						708011003
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 708011003,
					"content": "My question is this: What is the official name now given to these ruins by the Knights of Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Swan"
				}
			]
