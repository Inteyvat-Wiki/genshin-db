				"objectNames": [
					"Balent"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911001,
					"content": "We're back! There were indeed a few small problems, but don't worry! We handled them all by following the instructions you gave us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "Your help is truly appreciated. If you hadn't fixed those potential safety risks in a timely manner, it would've been far too late to fix them had we let them fester into a larger disaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "...And this is why I don't see eye to eye with Monsieur Aigouy, though I know that he's taking care of me in his own way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Anyways, thanks again so much for saving my life, and for helping with the inspection. Here, please take this as your compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Sorry for troubling you here and holding up your journey. I wish you two a safe journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
