					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911302
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911302,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911303,
					"content": "I... I'm... fine... I think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911304
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911304,
					"content": "Your appearance begs to differ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911305
					]
				},
				{
					"id": 740911305,
					"content": "You'd better hurry back to the pier with us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
