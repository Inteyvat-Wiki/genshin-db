							4950.418,
							440.352,
							4977.36
						],
						"pointId": 6580
					}
				]
			},
			"dialogs": [
				{
					"id": 740910401,
					"content": "You two are... too kind... Thank you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910402
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910402,
					"content": "Are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910403,
					"content": "I... I'm... fine... I think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910404,
					"content": "Your appearance begs to differ.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "C—Could you guys take me to the pier over there... I... I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910406,
					"content": "Okay, save your breath for now. We'll take you back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
