			"dialogs": [
				{
					"id": 741410101,
					"content": "(The content on the pages still consists of incomprehensible symbols, letters, ancient languages, and geometric figures. But a period of focus seems to gradually render their meaning comprehensible.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "Read"
				},
				{
					"id": 741410102,
					"content": "Canotila doesn't seem to be here. Maybe she's in that mysterious place again! Should we start meditating?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "Having heard what she said the last time...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "I'm a little bit concerned. I'm going to check it out.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "Well... This is kinda unsettling, but let's go together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Paimon, why don't you wait out here for me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "What?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "The world in the Book of Revealing...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "It may be more dangerous than we imagined.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "So I don't want you to take the risk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "But... we've been journeying together this whole time, haven't we? There's no hardship we can't overcome, and no enemies we can't defeat together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "The dangers inside may not be something force alone can resolve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "Well, if you insist! You're smarter than Paimon, so Paimon has faith in you. Just don't abandon Paimon! Paimon will wait right here until you return!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "Maybe there's a side of it that we don't know about.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
