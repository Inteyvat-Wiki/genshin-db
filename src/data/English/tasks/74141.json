				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Caterpillar"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2383.938,
							-252.923,
							4841.653
						],
						"pointId": 6293
					},
					{
						"sceneId": 3,
						"position": [
							2386.312,
							-252.555,
							4841.593
						],
						"pointId": 6803
					},
					{
						"sceneId": 3,
						"position": [
							2385.29,
							-252.747,
							4843.136
						],
						"pointId": 6835
					}
				]
			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "...Is that so? That makes things easier, then. What's your name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411002,
					"content": "Caterpillar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#I didn't think I'd see you here, {NICKNAME}. Where's Paimon, though? I don't see her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411004,
					"content": "Wait, you're not some monster who's transformed into someone I know in order to trick me, are you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411005,
					"content": "We just saw each other not long ago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "...Is that so? It feels like a long time has passed since we said farewell. Might just be my age, though, and my memory getting worse as I get older.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411007,
					"content": "...Are you sure you are not a monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411008,
					"content": "Do you still remember?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "The giant's garden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "I remember, yes. Ah. It's really you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411012,
					"content": "Sorry, I've encountered too many incredible things here, and many battles that could not be won.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411013,
					"content": "But things have finally changed here. Golden rays of light have arisen, and the sunflowers have bloomed. Even the universe the ancient ones speculated about is not immune to changes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411014,
					"content": "Maybe things will get better. Maybe I will finally understand, and be able to let go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411015,
					"content": "Caterpillar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Come with me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "Haha, I suppose it really is you. I remember now... I knew you, and you haven't changed. You're always sticking your nose in someone else's business, but that's because you're kind and honest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411018,
					"content": "But you don't have to worry about me. I don't need help — you've seen what I'm capable of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411019,
					"content": "And... Perhaps I know more about this place than even you do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411020,
					"content": "#Hilichurl, tell the {M#boy}{F#girl} to leave at once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "Do you have something to tell me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "...Can you understand what I'm saying? I see. Let me ask you... What am I in your eyes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "A dog.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Hmm. Maybe there is still hope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "Leave this place, young one. It's for your own good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#I agree, {NICKNAME}. You belong to a brighter world.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411027,
					"content": "I have a question...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "You shouldn't. Goodbye, and don't come back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "The apprentice and the little fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
