			},
			"dialogs": [
				{
					"id": 741411101,
					"content": "Hey! You're back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411102,
					"content": "How long was I gone for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411103
					]
				},
				{
					"id": 741411103,
					"content": "Hmm, just the blink of an eye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411104,
					"content": "If it was just a blink of an eye to you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411105
					]
				},
				{
					"id": 741411105,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411106,
					"content": "Nothing. I suppose it really is dangerous inside.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411107
					]
				},
				{
					"id": 741411107,
					"content": "Is that so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411108,
					"content": "Anyway, where's Canotila? She didn't go become a guard in the Court of Fontaine, did she?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411109,
					"content": "...I'm feeling a little dizzy, let's come back next time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411110
					]
				},
				{
					"id": 741411110,
					"content": "Oh, okay. Should we find something to eat? Paimon was so worried about you that she's now starving!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411111,
					"content": "Wasn't it just a blink of an eye for you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411112
					]
				},
				{
					"id": 741411112,
					"content": "Well, it took a lot of effort to worry about you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
