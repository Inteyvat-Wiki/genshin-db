			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "Hey there, friend! Welcome to Paititi — and Tete Isle — the place of your dreams!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540102,
					"content": "Ahead, you'll find two of our bars, Me & Dew and The Dewdrop. I'm Tecuhtli, and it's my job to welcome guests!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525403",
							"2"
						],
						"stepId": 7525403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "My dear friend, now that you've had my welcome juice, let me give you a word of advice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540202,
					"content": "If you're just an ordinary visitor enjoying your vacation, then steer clear of the northernmost part of Tete Isle. There's nothing over there that will help you relax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7525401",
							"2"
						],
						"stepId": 7525401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "Thanks for the advice. What happened to your eyes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "Hmph, this was the work of a hairless heathen. He left me with this mark, but I know he's somewhere on the island... and I'll be damned if I don't \"thank\" him for it later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540311,
					"content": "After hearing my story, you're sure to want to take revenge on my behalf. But that's quite alright — though I should thank you for your kindness!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540312,
					"content": "Dear friend, in a summer this beautiful, nobody should be feeling sad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540313,
					"content": "Please enjoy the welcome juice I've prepared for each and every guest, then enjoy your relaxing vacation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540314,
					"content": "You'll find your beverages on that shelf over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525404,
