				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "Haven't we met before?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "My friend, this is fate's mark upon the extraordinary — our first meeting feels like a reunion across lifetimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "Seeing this wolfish eye patch of mine, you've surely realized I'm pretty extraordinary, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
