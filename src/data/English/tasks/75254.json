			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "Oh? You're asking about my eyes? Hehe, well, there are three things every man has to cultivate in his life.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "First! A weathered body must bear at least one scar. Otherwise, there's no way to tell what trials and tribulations a man has faced, and he would appear to lack substance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "Second! Scars must be covered with clothes or accessories, but only partially... Otherwise, no one would see that this man is special.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "And third...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Wait a second. I never even asked about your eyes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "Exactly! If others don't notice how special he is, the man must MAKE them notice by bringing it up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
