						"pointId": 343
					},
					{
						"sceneId": 102,
						"position": [
							-396.587,
							-3956.928,
							7006.722
						],
						"pointId": 344
					}
				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "...Aria, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "This was far beyond mere punishment — and not for the first time, either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "Be it the city of dragons our King entrusted to us, or the fragile yet beautiful homes built by those tiny humans...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "How many more innocent lives must you watch die before you stop standing idly by?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "If our King were still here—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "He is not here, Sonnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760307,
					"content": "If that far-from-omnipotent ruler believes this pale, horrifying fate to be \"order,\" if this is the only way to save this doomed world from being devoured, then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760308,
					"content": "No matter how heavy the price demanded... and no matter how much sorrow that price brings me, it is far better than pitch-black silence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760309,
					"content": "If the world is destined for destruction... What's the point of fighting the darkness?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "...Sonnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760311,
					"content": "Nothing, Sister Aria! Forget I said anything at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "I just think we shouldn't stand by and watch as that tyrant slaughters the living beings who put their faith in us... whether they be dragons or those tiny humans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "Shouldn't we... save them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760315,
					"content": "...I can understand Sonnet's anger, Aria. To me, what that ruler did was far too cruel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760316,
					"content": "Even if there's only the slightest chance... I want to do everything in my power to save those who can be saved.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760317,
					"content": "But... what about those who can't be saved?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "Those for whom salvation does not come, whose lives were lost... Are their blood, tears, and wails of agony simply meant to vanish without a trace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "No... That isn't how it should be. I wish for everyone to be saved, and for none to fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "If its \"order\" would perish alongside it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "...Sonnet. Do not forget the reason for our birth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760322,
					"content": "Our mission is solely to preserve this world until our King, who granted us life, returns from afar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760323,
					"content": "We knew what this order would cost from the beginning... but we could not allow this world to march toward destruction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760324,
					"content": "...No, this isn't even about order, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760325,
					"content": "Sonnet, to us... to me, you are our dearest little sister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760326,
					"content": "So... please do not do anything that would hurt Aria and I.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760327,
					"content": "Do not directly defy this heavenly order. At least... not now, while the world is still so fragile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760328,
					"content": "Canon... I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Istaroth told me of a word that only humans may lay claim to... \"hope.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760330,
					"content": "As long as there is life, there is hope... There will always be hope.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}