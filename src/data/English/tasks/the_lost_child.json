			"dialogs": [
				{
					"id": 730030501,
					"content": "#Iotham? Why are you... and {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030502
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030502,
					"content": "It's urgent, so we'll make this quick...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030503,
					"content": "You quickly explain what happened.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730030504
					]
				},
				{
					"id": 730030504,
					"content": "...I see. Iotham, you go rest up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030505
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030505,
					"content": "Okay. I'm sorry, Alphonso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030506
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030506,
					"content": "#It's fine, what matters is that you're okay... Wait here a moment, {NICKNAME}. I'll go with you as soon as I prepare some medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030507,
					"content": "There's no time. This is the location, head there as soon as you can.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030508
					]
				},
				{
					"id": 730030508,
					"content": "Yeah, we have to hurry back to look after Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030509
					],
					"speakerTitle": "Paimon"
				},
				{
