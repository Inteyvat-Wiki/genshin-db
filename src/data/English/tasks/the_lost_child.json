					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030301,
					"content": "Whew... Hah... Finally...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030302,
					"content": "Rana... Waaah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham... It's okay, little man, there's nothing to cry about. Look... If I can tell them about what I felt in the Withering Zone... to those Akademiya researchers... they'll be able to take care of The Withering for good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030304,
					"content": "#And... did you see... me fight? No... did you see {NICKNAME} fight? Be sure to thank {M#him}{F#her}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030305,
					"content": "Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Please, that's enough.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Rana, you'd better rest now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Ha... haha... it's fine. I just feel a little dizzy, that's all. And a little tired...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030310,
					"content": "Rana... I'm sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "Wh... What are you talking about? You're my little tiger, so no more crying! You're okay, aren't you? Does anything hurt, Iotham...? Do you feel dizzy, weak, or...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030312,
					"content": "I'm fine, but Rana, you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "It's nothing... I'll be fine. I'm a battle-hardened Forest Watcher, after all! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030308,
					"content": "I'll go get help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
