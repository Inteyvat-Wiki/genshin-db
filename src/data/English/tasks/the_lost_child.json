					"Iotham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#I'm sorry... {NICKNAME}, Paimon, I need to rest... Wait for me, Iotham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030802,
					"content": "Rana, are you really okay...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030803,
					"content": "We'll go get help...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "No, no, it's fine... I just need... a little rest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030805,
					"content": "I'm sorry, Rana... I'm sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030806,
					"content": "Really... How many times do I have to say it? I'm fine! But I'm very angry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030807,
					"content": "You promised me... that you wouldn't go into the forest. Once I'm all rested up, I'll teach you a lesson about breaking promises... you little rascal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030808,
					"content": "Waaah... Alphonso said that the mushrooms here are huge! And I just wanted to bring you some fresh mushrooms to eat... to give you energy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030809,
					"content": "Dummy... You didn't need to do that. Just thinking of you guys gives me energy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030810,
					"content": "Still, hahaha... the mushrooms here really are huge... They'd definitely taste great in a curry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030811,
					"content": "Did Alphonso let you come here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "No... Alphonso also told me not to go running off. But I wanted to give Rana something tasty to eat, so I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030813,
					"content": "Alphonso wouldn't do that, he's Iotham's big brother...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030814,
					"content": "Paimon understands... But Iotham, how did you get stuck in the Withering Zone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030815,
					"content": "When I was in the forest, I thought someone was following me... I got scared, I thought it was Marana's Avatar... So, I just kept running... *sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030816,
					"content": "And I ended up running into Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030817,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030818,
					"content": "\"Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "That's... The Withering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030820,
					"content": "Oh... Yeah, The Withering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030821,
					"content": "\"Marana's Avatar\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Uh-huh. It does bad things in the world for Marana... It's a big black thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030828,
					"content": "Marana... What a strange name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030829,
					"content": "Mm... How did I know that Marana is The Withering...? Dang it... everything's spinning...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030830,
					"content": "Iotham, what was that green thing just now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030832,
					"content": "That was Ararakalari... It can protect people from the corrosion of Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030833,
					"content": "More and more things I don't understand...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "This is... a kind of forest magic. It's also a kind of music... It's an Ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030835,
					"content": "What is it?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Don't worry about that, Rana, you need to rest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030838,
					"content": "It's on the tip of my tongue, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030839,
					"content": "I'm sorry, Rana, I'm sorry... I'll never run off like that again, I'll be good and stay home...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030840,
					"content": "I know. You'll become smart, healthy, and you'll know right from wrong... It's just like knowing which mushrooms you can eat, and which you can't...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030841,
					"content": "I know... I know... I'm sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030842,
					"content": "#Know that Marana is bad, and... the forest is good... Become a strong and good person, help people who need help... just like {NICKNAME} and Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030843,
					"content": "And don't forget... the forest will remember...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030844,
					"content": "Wah, this is bad, Paimon thinks Rana's condition is getting worse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030845,
					"content": "I'll go get help.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "Eh? Oh... I'm fine, really... I just need to rest for a little while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, please... take Iotham back for me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030849,
					"content": "Okay. Let's go, Iotham. Don't move, Rana! We'll be right back!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030846,
					"content": "Rana, wait for us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
					"content": "Don't worry about that right now, rest up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030838
					]
				},
				{
					"id": 730030823,
					"content": "\"Marana's Avatar\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030824
					]
				},
				{
					"id": 730030824,
					"content": "Uh-huh. It does bad things in the world for Marana... It's a big black thing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030825
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030825,
					"content": "\"Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030826
					]
				},
				{
					"id": 730030826,
					"content": "That's... The Withering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030827
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030827,
					"content": "Oh... Yeah, The Withering.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
