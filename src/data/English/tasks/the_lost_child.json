					"nextDialogs": [
						730030704
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030704,
					"content": "What's going on here...? Could it be that Ara-thing Iotham and Rana were talking about? What was it called again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030705,
