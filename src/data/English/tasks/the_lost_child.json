			},
			"dialogs": [
				{
					"id": 730030201,
					"content": "Iotham... What happened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030202,
					"content": "#Wah, Rana... and {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030203,
					"content": "Eh? What're you doing in... a Withering Zone... And there are so many monsters...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030204,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030205,
					"content": "I'll take care of this.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "No... There's no time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030208,
					"content": "#Darn it! {NICKNAME}, let's do this together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030209,
					"content": "Iotham, wait here and don't move! We're coming to rescue you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030206,
					"content": "What's that green thing...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				}
			]
		},
		{
