					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "Ah, yes, right, that was it! Paimon thinks they said it could resist the Marana corrosion or something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030707,
					"content": "Yes. Nara smart. Ararakalari can resist Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030711,
					"content": "Woah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030712,
					"content": "Woah!",
