			"dialogs": [
				{
					"id": 766740101,
					"content": "My oh my, the final product has exceeded all my expectations... If anyone actually does stumble in here by mistake, I'm sure they will be truly awe-inspired by this mage's might.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740102,
					"content": "If someone really does end up here by accident...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "Well, that all depends on the sort of person they are.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740105,
					"content": "Guidance can encourage complacency and entitlement if you're not careful. If someone is eager to rely on their own abilities, like you do, then I'll gladly help them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740106,
					"content": "But if they're the type of person who pins all their hopes on the mage's power, while doing none of the work themselves... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740107,
					"content": "...W—Would you really turn them into a statue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766740108,
					"content": "No, nothing like that. But I would guide them out of this place to the nearby Curatorium of Secrets. I'm sure Nefer would know how to deal with them much better than I do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740109,
					"content": "Those who seek to reap without sowing ought to pay the price, don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740103,
					"content": "Will you guide them to fulfill their wishes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
	]
