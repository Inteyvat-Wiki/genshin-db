			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "Mr. Miner, we're back and ready to report!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080102,
					"content": "Ah! Am I glad to see you again! I was getting nervous... At first, I figured I'm paying a fair price, and these are professionals. But then I thought... Goodness, I'd hate to send someone off on a strange commission and then for something bad to happen to them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080103,
					"content": "I'd never be able to forgive myself if you came to any harm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080104,
					"content": "Don't you worry, mister, it was nothing we couldn't handle! Anyway, we're back, aren't we? And the good news is, we got to the bottom of what's been going on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080105,
					"content": "Excellent, excellent! So then, what's the situation down there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080106,
					"content": "Uh... Heh, well... Ummm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080107,
					"content": "It's like a hilichurl hospice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Huh? ...Hospice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080111,
					"content": "...Uh, basically, the hilichurls down there don't wanna fight anymore. Leave them in peace, and they won't cause you any trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080112,
					"content": "What Paimon said.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "Well, we certainly wouldn't be going out of our way to provoke them, you can count on that. The last thing any of us miners are looking for is to stir up trouble... All we're looking for is, well, all that glitters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080115,
					"content": "Now there's a philosophy that Paimon can get behind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080116,
					"content": "...I gotta be honest, I didn't really understand the situation you were describing, but having your assurance that everything's okay is the main thing. It means we can get back to work straight away.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080117,
					"content": "I'm very grateful to you both! You came a long way for this. Please take these as compensation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080113,
					"content": "You have nothing to worry about.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "Hilichurl utopia. Hili-topia, if you will.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Sorry, hili-topia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				}
			]
		}
	]
}