				]
			},
			"dialogs": [
				{
					"id": 741830401,
					"content": "Whoa... Looks just like that glowing fish we saw before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830402,
					"content": "There are still weird things tangled around the top nearby... What the heck is going on? Paimon's getting more and more confused...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830403,
					"content": "I've heard this voice in a dream before...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "Yes, you must have met him in the Sebastos's dream, did you not?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830406,
					"content": "Scylla, a fell dragon who once served the Sebastos. He was subdued and sealed here by Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830407,
					"content": "Ehh!? Mr. Super Rude subdued an evil dragon? Paimon didn't think he could do something that amazing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830408,
					"content": "Well, \"fell dragon\" was the name they gave, but it was no more than a vishap that was a teensy bit stronger than normal. After all, no new Hydro Dragon could be born so long as the Mistress of Many Waters hibernated in the deep seas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830404,
					"content": "I can't remember his name anymore, though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scylla",
					"Monsieur Os"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "Ahhh! Such warm ocean currents! Free at last!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830602,
					"content": "Well now, little ones. Hail you from the surface? I know not for what reason you have come to this deepwater prison, but...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830603,
					"content": "We aren't \"little\" anything! You're just way too big!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830604,
					"content": "Haha! Very well! Either way, you have broken the shackles that have bound me for millennia. That places me in your debt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830605,
					"content": "If there is any undertaking in which I may aid you, then speak. Consider it a token of my gratitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830606,
					"content": "#Hehe, Paimon knew you'd be a reasonable guy! Anyway, Paimon's name is Paimon, and {M#he's}{F#she's} {NICKNAME}. And this is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830607,
					"content": "Err, actually, Paimon's not sure what you'd know him by, but we call him Monsieur Os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830608,
					"content": "Ah, Cassiodor, it is you. It has been a while. So you came back after all. But still, you are sadly late... by a few thousand years, no less.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830609,
					"content": "Ooh, looks like the big guy knows you, Monsieur Os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830610,
					"content": "I have nothing to say to despicable traitors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830611,
					"content": "Speak not so rashly, mortal! We are dragon-born. We keep all our promises and betray none, which is more than can be said for your haughty race.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830612,
					"content": "Save your breath! It is worth less than a drowning mayfly! Your betrayal is undisputed. Were we not defeated in that war precisely because you turned against us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830613,
					"content": "If we hadn't lost that war... our nation... the Sebastos... wouldn't have...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830614,
					"content": "Ah, you've been gone far too long, Cassiodor! The truth is not what you imagine... Though I suppose that a secret plan would not have been secret had its details reached your ears.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830615,
					"content": "...Secret plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830616,
					"content": "My leading an army of vishaps to assault the capital was, in fact, part of Remus's final, secret plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830617,
					"content": "And he did all this to save his nation and people — a man of great moral character.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830618,
					"content": "That sounds preposterous...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "Yeah, that is kinda weird. Why would a ruler ask someone else to invade their own country?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830621,
					"content": "And what, little one, would ones such as you or I know of Remus's thoughts? Whatever the case, look upon this, Cassiodor. Even you should be able to divine its meaning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830623,
					"content": "The guiding golden bees... They should only heed the call of the Symphony... Why would the Sebastos bestow his power upon a savage dragon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830624,
					"content": "Because they had an arrangement...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "Oh? You know much, little one! From where did you learn that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830626,
					"content": "From memories scattered in the sea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "You speak correctly! Yes, indeed, we did have an arrangement, but I failed him. I squandered his noble sacrifice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830628,
					"content": "I could not make it to Domus Aurea in time! And so the waves devoured the whole city, and my kindred could not escape, either...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830629,
					"content": "...How could such a thing be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830630,
					"content": "Hmph! If it is betrayal you speak of, then Boethius was the true traitor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830631,
					"content": "Were it not for that lying devil, that deceitful rat, and his silver-tongued deceptions, how could a prince among dragon-kin such as I, who once led our armies after the age of the ancient dragons, have been beaten so easily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830632,
					"content": "That devil first falsely claimed to have given up resistance on Remus's orders, saying he had ordered the legions to cease resistance. Yet when we arrived here, he suddenly rose up against us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830633,
					"content": "Now that I have had much time to think on it, I fear he must have learned of Remus's plans somehow, and thus was able to set up such an inescapable trap and lure me in, step by step...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830634,
					"content": "And thus did my flesh and blood turn to stone, and thus did it remain for millennia, to this day, when you rescued me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830635,
					"content": "Boethius knew perfectly well what a massive calamity his actions would bring about, yet he still... Could he have been trying to seize control over Phobos? Was that why he committed such sins...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830636,
					"content": "It seems that we don't have the full story yet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "So the guy who keeps calling others traitors was actually a traitor through and through!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830638,
					"content": "But why, though? Ugh, are we gonna have to ask him? Paimon doubts we'd get a straight answer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830639,
					"content": "Hmm? So that loathsome, recalcitrant demon-worm has yet to dissipate, has he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830640,
					"content": "Yeah, and he's stolen the souls of a whole bunch of Fontainians, too! Rescuing them is actually the main reason we're here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830641,
					"content": "He said that he'd wait for us within Domus Aurea... Well, he just said he'd wait for Monsieur Os, so we're coming along uninvited!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830699,
					"content": "Not even leaving a door, though. How rude of him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830642,
					"content": "The Initium Iani...? Hmph, though feeble tricks and smokescreens have been set to dismay us, but at the end of the day, it's nothing more than a glorified stone door.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830643,
					"content": "I may have lost my physical body, but it is no great labor to take the little ones over to settle the matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830648,
					"content": "Watch closely, little ones!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830644,
					"content": "Oooh! You're pretty reliable, huh, big guy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830649,
					"content": "Now we simply need to break these revealed seals one by one. If you are prepared, then let us go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830645,
					"content": "Well then, Monsieur Os, are you ready?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830646,
					"content": "Now that it's come to this, we have little choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "Monsieur Os"
				},
				{
					"id": 741830647,
					"content": "#Alright then. What about you, {NICKNAME}? Ready?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830619,
					"content": "Had he gone mad, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
