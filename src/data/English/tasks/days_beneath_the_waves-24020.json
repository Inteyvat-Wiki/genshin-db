					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200201,
					"content": "Have you helped me salvage those things?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402003,
			"completionStepIds": [
				2402005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402005",
							"2"
						],
						"stepId": 2402005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200301,
					"content": "That's right, this is what we go trawling for every day. It's just junk, junk, and more junk... Maybe that stingy rogue Goldman eats the stuff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200302
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200302,
					"content": "Thanks for your help. This is the pay I got as an advance from Goldman — please take it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200303
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200303,
					"content": "I can't take this from you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200304
					]
				},
				{
					"id": 240200304,
					"content": "But you must! It's your wages for YOUR work. It no longer belongs to me... and if you won't take it, I'm just going to consign this coin pouch to the waters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200305
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200305,
					"content": "Alright, alright...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200306
					]
				},
				{
					"id": 240200306,
					"content": "That's the way! If you need anything salvaged in the future, come look for me. I'll get it out for you in one piece, no matter what it is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200307
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200307,
					"content": "I need a bit more rest... Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402004,
			"completionStepIds": [
				2402006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402006",
							"2"
						],
						"stepId": 2402006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200401,
					"content": "These are... What are all these trinkets? Are these what Goldman really wanted us to salvage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200402
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200402,
					"content": "Thanks so much for your help! Here... Take this Mora, and don't tell a soul about this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200403
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200403,
					"content": "If I could sell these, I can purchase a divesuit of my own. No longer would I need to rent from that Goldman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200404,
						240200405
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200404,
					"content": "I can't take this from you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				},
				{
					"id": 240200406,
					"content": "No, no! This is the wages you deserve. I know this is nothing compared to the effort you had to put in, but it's all I have left. I was planning to get a swig of booze with it tonight...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200407,
					"content": "So please, take it. I'll take care of a few things, and then I'll figure out how to... y'know, sell this on the sly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200405,
					"content": "My lips are sealed.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				}
			]
		},
		{
			"id": 2402005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402002",
							"2"
						],
						"stepId": 2402002,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402003",
							"2"
						],
						"stepId": 2402003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200501,
					"content": "Pah, that stingy rogue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200502,
						240200508,
						240200512
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200502,
					"content": "Could you tell me about Goldman again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200503
					]
				},
				{
					"id": 240200503,
					"content": "He's my boss — real specialist in hiring folks like me with no skills, but strength to spare in order to make ends meet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200504
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200504,
					"content": "A real Fonta-for-brains he is, and he's strict and stingy to boot! He insists that we stick to that big, thick work manual while at work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200514
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200514,
					"content": "Also, even the divesuits we use at work are stuff he \"rents\" out to us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200505
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200505,
					"content": "If we violate those stipulations or our divesuits get damaged, we'll have to pay him instead...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200515
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200515,
					"content": "In other words, if I get careless at work even once, not only will I need to pay him a fee, but I'll need to grovel and beg him to keep me on staff! Pah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200506
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200506,
					"content": "What do you want to know more about him for, anyways? I'm begging you, please, keep your distance from him — even if it's just for your good name's sake!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200516
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200516,
					"content": "Shameless, that's what he is, and he surrounds himself with some of like kind to him, too. Bad eggs, them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200507
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200507,
					"content": "Don't associate with that fellow — you'd not clean that mud and filth off your hands, not even with a tower's worth of pure water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200517
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200517,
					"content": "But see, it takes nary any effort to stain a clear pond using dirty mud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200508,
					"content": "You do some really hard work...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200509
					]
				},
				{
					"id": 240200509,
					"content": "Hah, and isn't that the truth? But this is the only way I can make a living. I'm not smart, and I don't have any other skills, but I'm not going to turn to crime, either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200518
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200518,
					"content": "If I must do evil to get the bread, then I'd rather go hungry!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200510
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200510,
					"content": "My lot's rough, yes, but I can close my eyes in peace at night. No need to fear if anyone hates me, or might shank me in my sleep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200511
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200511,
					"content": "If you think about it that way, my life's way better than Goldman's.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200512,
					"content": "See you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200513
					]
				},
				{
					"id": 240200513,
					"content": "#Sure. I'll leave the salvage work to you, good {M#sir}{F#lady}. As for me, I still need a bit of rest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
