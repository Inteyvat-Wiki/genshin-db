	"talks": [
		{
			"id": 2402001,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "What rotten luck! I'm never going underwater again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "Ah, it's you. It truly is good to see you! I... I nearly lost my life down there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200105,
					"content": "I was doing work underwater, just like I usually do. I submerged, dodged the waterweeds, avoided the trash, and managed to not get cut or pierced by anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200106,
					"content": "But just as I was salvaging things, a group of monsters suddenly emerged from the mud!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200107,
					"content": "I can't quite remember what creatures they were, only that they came rushing at me — I could only flee and swim upward with all my might.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200108,
					"content": "But not long after, I ran into a group of strange mechanical fish, and they too began mindlessly charging at me the moment they saw me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200109,
					"content": "I don't know how I got ashore, but I did, and seemingly without injury too...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200110,
					"content": "If things are so dangerous, you should probably stay away from this area.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "But I can't, you see! Goldman designated this spot... never mind that quite a few people were injured, or even lost their lives while working here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200113,
					"content": "Over time, even his threats and pay dockings could not convince anyone to perform salvage here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200114,
					"content": "So he changed tack after a while, claiming that he'd give anyone willing to come here three times the Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200115,
					"content": "So... I and a few fellows strapped for cash took the work on, and we even bought a few fishing spears for underwater self-defense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200116,
					"content": "But not a few days in, our weapons were either broken or lost... The others went into the city to get a new batch, while I'm here holding the fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200117,
					"content": "Then why did you go into the water just now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "They've been gone for ages! If we don't start soon, I don't know how late I'll need to stay up tonight.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200120,
					"content": "Let me help you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "No! That won't do! These are real monsters that'll give you a real fight! Even adventurers can't handle them. Nope, I can't let you do this.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200122,
					"content": "I'm no ordinary adventurer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "Well... certainly not...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200125,
					"content": "Alright. If you insist, I'll mark that location out for you... But please, stay safe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200123,
					"content": "Do I look like an ordinary adventurer to you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "You went underwater without any weapons for self-defense?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "That sounds way too dangerous. You should find a different spot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "What happened this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
			"id": 2402002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
