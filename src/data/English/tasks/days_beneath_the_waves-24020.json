			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200601,
					"content": "Agh, what terrible luck...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200602
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200602,
					"content": "Were you able to sell the stuff?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200603
					]
				},
				{
					"id": 240200603,
					"content": "Ah, it's you. Ugh, forget it. I'd just found a buyer too, and that was when Goldman barged into my house and seized that box of trinkets!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200604
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200604,
					"content": "If he didn't still need me to work for him, I'd have taken a real beating, too... He did deduct two months' salary, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200616
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200616,
					"content": "He wants to pay me only after I've finished this whole year's worth of work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200605
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200605,
					"content": "*sigh* Forget it. Luck doesn't smile on idiots like me... Wait. Goldman didn't come knocking at your door, did he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200606,
						240200609
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200606,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200607
					]
				},
				{
					"id": 240200607,
					"content": "Good, then. Me getting beat up? Totally fine. But I would never want to get you in trouble with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200608
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200608,
					"content": "I didn't tell him about your salvage work, but I suspect that someone else found out and told him...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200611,
					"content": "Still, I will need your help today again. My divesuit still hasn't been fixed, but Goldman's been pushing me to make up for the days where I was unable to finish work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200612
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200612,
					"content": "I had no choice but to borrow someone else's divesuit, but even so, I couldn't finish my work quickly enough... Unfortunately, I'm gonna have to rely on your goodwill again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200613,
						240200614
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200613,
					"content": "No issue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200615,
					"content": "Thank you. I'll mark the locations of the objects in question for you — we'll split up and search.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200614,
					"content": "Allow me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200609,
					"content": "If he did come to me, I'd have a lesson to teach him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200610
					]
				},
				{
					"id": 240200610,
					"content": "Please, don't get involved with that shameless lump of lard! Someone as honorable as yourself shouldn't even be acquainted with him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				}
			]
		}
	]
