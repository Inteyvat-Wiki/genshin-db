						],
						"pointId": 360300034
					}
				]
			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "Perhaps... Like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540302,
					"content": "Hmm, let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540303,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540304,
					"content": "Moons... Moons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540305,
					"content": "How about here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540306,
					"content": "Looks like I won this round.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540307,
					"content": "My three moons are connected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540308,
					"content": "Mm, this should win it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540309,
					"content": "Mm... The moons wax and wane in an endless cycle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540310,
					"content": "It seems both sets of moons refuse to be eclipsed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540311,
					"content": "Are we... heading for a tie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540312,
					"content": "Ah, you weigh your decisions carefully before making them, I see. Take your time — we have plenty of that, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540313,
					"content": "Did you forget how to place your moons in the night sky? Shall I help you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540314,
					"content": "You don't like this game? Hm... I find it quite amusing myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540315,
					"content": "Mm? Are you staring at me? Your gaze is not subtle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540316,
					"content": "You're staring... Is the truth of the moons written on my face?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540317,
					"content": "The board's over there, by the way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540318,
					"content": "Hm, your moons are aligned.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540319,
					"content": "The night sky is yours.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540320,
					"content": "Ah... I must have... slipped up somewhere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760540321,
					"content": "You have a wonderful time playing the game with Columbina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "The three moons, linked up in a line...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210203,
					"content": "Huh? Still thinking about how that last match went?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "Oh, no. It's just... Looking back on the game now gives me a peculiar feeling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210205,
					"content": "Oh, yeah. Now that you have the power of three moons, you've become more than just something that can dominate the night sky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Yes. And I also think... that the fate of the world may have been different, had there not been division between the three Moon Goddesses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210207,
					"content": "What were they like?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "The first one I saw was Sonnet, goddess of the Iridescent Moon. She was livelier than I'd imagined, more like a playful younger sister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210209,
					"content": "Aria of the Eternal Moon, was the most mature of the three. She was a natural leader, and was most gentle to others. Ah, just like Lauma, actually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210210,
					"content": "As for Canon of the Frost Moon... she seemed both wise and far-sighted. And it was she who gave her moon to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210211,
					"content": "Sounds like all of them were kind deities.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Yes. Despite their differences, they loved Teyvat, and they love this home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210213,
					"content": "When I spoke to them of the things to come, they all seemed relieved, glad that this world still held so rich a future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210214,
					"content": "That was also why they gave me the power to return \"home.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210215,
					"content": "Huh... Paimon would love to see them, and give them a real proper \"thank you\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "I would very much like that as well. But I fear it's no longer possible...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210217,
					"content": "Fortunately, this world continues onward, and the humans they protected have survived, and pass on their stories to this day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210218,
					"content": "Exactly! As long as we live well and don't let the bad guys destroy the world — that's the best thanks we can give 'em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "You certainly have a way with words, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "In that case, every day's a thanks-giving for you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "Of course! You can bet Paimon's always trying to live her best life!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "You too, Columbina! Eat well and sleep well every day, and come find us if you wanna play games!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Haha, sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 761210224,
					"content": "I suspect that from now on, I shall think of those three gentle goddesses every time I play Moon Chess...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "The Damselette"
				}
			]
		},
