				"objectNames": [
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#I apologize again for not being completely honest with you, {NICKNAME}. I truly am sorry, but... I had to do it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551602,
					"content": "I understand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "By the way, does Kokomi know about all this?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "Ah yes, Her Excellency... Well, let's just say that the war brought many terrible things while also forcing us to learn a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551605,
					"content": "Right, but that still doesn't answer the question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551606,
					"content": "Well, ahem... aren't you curious about who's been pushing for the new commodity bill? It certainly isn't the Kanjou Commission, because it doesn't immediately benefit them, and we don't have any connections there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551607,
					"content": "Yeah... it's kinda as if the gods suddenly appeared to offer you a divine hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551608,
					"content": "Haha, yeah, the gods...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551609,
					"content": "I was invited to attend the Irodori Festival on Narukami Island with Her Excellency a while back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551610,
					"content": "At the festival, I waited in the marketplace while Her Excellency...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
