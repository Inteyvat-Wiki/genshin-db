			"dialogs": [
				{
					"id": 190550901,
					"content": "Todoroki, the shipment has arrived and is ready for inspection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190550902,
					"content": "Good, let's go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190550903,
					"content": "Hey, it's Todo... mmph!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190550904,
					"content": "Shh! Keep quiet. Let's follow him and see where he leads us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
