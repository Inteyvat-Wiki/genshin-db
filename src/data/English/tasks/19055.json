			"trigger": {
				"objectNames": [
					"Tokuda",
					"Todoroki",
					"Masashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "Your intel was spot on. When we arrived, the Nobushi were all still asleep, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "We captured them all, and the goods were retrieved and brought back here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "I'll take a look. Hmm... Everything seems in order, good work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "It's nothing. Thanks to the efforts of your caravan, the price of grain in the village has decreased.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "That's right, and who would have thought that the injuries we sustained during the war would have such a lingering effect on our bodies. But thankfully, you also brought back some life-saving medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Things are improving thanks to the help from those up top. By the way, what is the state of the village's inventory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Make sure that it's confirmed tonight, I have to leave tomorrow morning after I go to the Sangonomiya Shrine and get instructions from General Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "Don't worry. We've already prepared the list. Just follow us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
