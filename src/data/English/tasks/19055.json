			"dialogs": [
				{
					"id": 190551701,
					"content": "Went to see Lady Yae.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "Yeah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551802,
					"content": "She went to the Kanjou Commission to see Lady Yae — purportedly for a book review, but there were other items on the agenda, too. The meeting wasn't made public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551803,
					"content": "Following her return, we began our attempts at boosting commercial activity, and it wasn't long before there was a push for a new commodity bill on Narukami Island...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551804,
					"content": "So, what do you make of it? Do you think Her Excellency knows about this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
