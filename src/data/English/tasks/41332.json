			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "Did you deliver the food?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321402,
					"content": "Yes, we did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "Great, I knew that I could count on you! Did you also happen to ask Wrench Wang, Guanhai, and Zhihua what they would like to eat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321404,
					"content": "Wrench Wang and Hammer Li would like to have Bamboo Shoot Soup.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "Oh? These two have rather similar tastes, though Bamboo Shoot Soup will take some time to make. I'll have to start preparing it early.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321407,
					"content": "Guanhai would like to have Squirrel Fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "No problem, that dish is one of my specialties.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321409,
					"content": "Zhihua would like to have Lotus Flower Crisp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "Huh, I never would have guessed that Zhihua would have a liking for pastries and the like. Making Lotus Flower Crisp is straightforward enough, no problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321411,
					"content": "Thanks for going and asking them what they'd like to eat. Here, take this as a token of my appreciation. Now, I should get started on all those dishes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321412,
					"content": "Won't you be hanging any Xiao Lanterns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321413
					]
				},
				{
					"id": 413321413,
					"content": "Hah! We don't have time for that now, I've got more dishes to make and Xiangling has just gone out on another delivery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321414
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321414,
					"content": "The two of us can barely keep up with the orders as it is. There's no way we'd have any time for hanging lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321415,
						413321416
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321415,
					"content": "I can take care of it for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321417
					]
				},
				{
					"id": 413321417,
					"content": "Y—You'd really do that? I'll leave the lantern to you then. I was just starting to worry that the restaurant doesn't look festive enough without any lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321416,
					"content": "I'll make a Xiao Lantern for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321417
					]
				}
			]
		},
		{
			"id": 4133216,
			"completionStepIds": [
				4133216
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
