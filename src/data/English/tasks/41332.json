					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320301,
					"content": "I wonder why my order from Wanmin Restaurant hasn't arrived yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320302,
					"content": "Here's your order. Enjoy!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "Oh, thank you so much! I'd thought that it would still take a while longer before it arrived.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320304,
					"content": "All the festivities for Lantern Rite have been making me feel a little homesick... But I certainly won't be returning to Inazuma any time soon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320305,
					"content": "I wonder how things are back in Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atsuko"
				}
			]
		},
