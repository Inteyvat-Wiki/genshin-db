			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "How many more dishes was that again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320202,
					"content": "What are you doing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "What am I doing? Why, I'm running Wanmin Restaurant, of course! Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320204,
					"content": "Things have been getting busy with everyone going out to eat during the Lantern Rite. Even travelers from faraway lands have come to visit and join the festivities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320205,
					"content": "Even though my dear Xiangling has returned to help, we're still struggling to keep our heads above water. As a matter of fact, she just went out on a delivery...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320206,
					"content": "While everyone else has been out hanging lanterns for the festival, we've been too busy to make a single lantern yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320207,
					"content": "If you don't mind, Traveler, could you lend us a hand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320208,
					"content": "Do you happen to know Atsuko? She's the girl from Inazuma down by the docks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320209,
					"content": "We've prepared her order, so could you please go deliver the food to her? I've even made her extra large portions to celebrate the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320210,
					"content": "There's also the others who work down by the docks... <color=#00E1FFFF>Wrench Wang, Hammer Li, Guanhai, and Zhihua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320211,
					"content": "They're regular patrons here and always look after our business. They seem to still be busy with work down by the docks, even though it's time for the festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320212,
					"content": "I would like to prepare some food to give them, but I'm afraid that we're simply too busy and won't have the chance to leave the restaurant...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320213,
					"content": "If you could, Traveler, please help me ask them what they would like to eat, and I'll whip up whatever they request.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320214,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "Thanks a lot, Traveler. Just come back here and let me know once you've asked them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				}
			]
		},
