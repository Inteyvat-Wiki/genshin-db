			},
			"dialogs": [
				{
					"id": 250340501,
					"content": "#Thanks for saving us, {M#Big Bro}{F#Big Sis}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340502,
					"content": "Hrroo, roooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340503,
					"content": "This place was too far from the tribe — if you hadn't shown up, there's no way I'd have been able to alert Illapa before Qica got caught.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340504,
					"content": "What are you two doing over here, anyway?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "Climbing practice, as always — but we got hungry halfway through.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340506,
					"content": "So the two of us went foraging... But before we knew it, we'd wandered off pretty far...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340507,
					"content": "By the time we'd had our fill, we were a long, long way out. Mom's going to give it to me for sure when we get back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340508,
					"content": "Thanks again for saving us. Take these Cacahuatls — I only just plucked 'em!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340509,
					"content": "We'll head back as quick as we can. Come on, Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340510,
					"content": "Rawr! Rawrrr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				}
			]
		}
	]
