			"dialogs": [
				{
					"id": 250340101,
					"content": "He doesn't like you, so scram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340102,
					"content": "Little runt... What's with you and the Saurian? You know him or something?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340103,
					"content": "Roar... Rawrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340104,
					"content": "Oh, look, he's getting impatient. Alright then, whelp, stand aside. We don't hit kids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340105,
					"content": "Bring the bag, boys. Bet you this Saurian'll sell for a good price.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340106,
					"content": "Don't come any closer! And don't blame me if you get hurt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340107,
					"content": "W—Wait, you mean you're going to hit us? Hahahaha! You hear that, boys? He's gonna take us on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340108,
					"content": "Ooh, kiddo, I'm sho scared, I'm twembling in my bwoots. But if you say so... don't blame me if you get hurt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340109,
					"content": "Rawr! Rawrrr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340110,
					"content": "Tch... Isn't this Saurian a noisy one. Alright, kid, just go have a nap over—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340111,
					"content": "You're the ones who could use a nap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#Big Bro}{F#Big Sis}! They're trying to take Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340114,
					"content": "Rroo! Wrroo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340115,
					"content": "...Hey, you. How about you step aside? We won't hurt you. Heck, we'll give you a share. How's that sound?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340116,
					"content": "No hurting Qica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Huh. Guess that's that, then. Well, I'm sure you know the rules. Let's get dangerous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340119,
					"content": "Let's go, lads!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Impatient Thief"
				},
				{
					"id": 250340117,
					"content": "Who died and made you king?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Hope you don't mind if I chip in.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
