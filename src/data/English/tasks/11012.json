			},
			"dialogs": [
				{
					"id": 110120601,
					"content": "Teucer, see that big stone cube in front of you? I need your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120602
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120602,
					"content": "Yay! Do I really get to help my big brother out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120603
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120603,
					"content": "You bet. Now, I'll count down from three, and then we touch it together. Ready? Three... two... one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 1101207,
			"completionStepIds": [
				1101209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
