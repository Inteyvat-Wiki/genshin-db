			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120301,
					"content": "I can't find him anywhere... where did he go...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120302,
						110120304
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120302,
					"content": "I found your brother a moment ago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120303
					]
				},
				{
					"id": 110120303,
					"content": "Really? Where is he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120306,
					"content": "A huge number of people suddenly wanted to buy Mr. Cyclopses!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120307
					]
				},
				{
					"id": 110120307,
					"content": "Y—Yeah, so he had to leave in a real hurry. He didn't abandon you here on purpose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120308,
					"content": "Oh... Th—That's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120309,
					"content": "But still, I was kinda hoping we could play here a little longer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120310,
						110120311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120310,
					"content": "This is for you. From your brother.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120312,
					"content": "Wow! Look at this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120313
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120313,
					"content": "I never knew that they made Mr. Cyclopses in this size!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120314
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120314,
					"content": "Look, it even has my name on it! It's my very own Mr. Cyclops!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120315,
					"content": "You're really loving it, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120316,
					"content": "You bet! My brother is the best big brother ever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120317
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120317,
					"content": "You had a tour of Liyue, met your brother, visited the Institute of Toy Research, and got yourself a souvenir... Now that's what we tour guides call the perfect trip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120318,
					"content": "Do you think you're ready to head back to Snezhnaya now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120319,
					"content": "Hehe... Don't worry, I know I can't get my way all the time. That'd just be annoying for everyone else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120320
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120320,
					"content": "So... let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120311,
					"content": "Mr. Cyclops will keep you company in his stead.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120304,
					"content": "He's already headed back.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120305
					]
				},
				{
					"id": 110120305,
					"content": "What? Why... why would he leave without me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101204,
			"completionStepIds": [
				1101207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101207",
							"2"
						],
						"stepId": 1101207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Andrei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120401,
					"content": "#{M#Sir}{F#Ma'am}, young master Teucer, I've been waiting for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120402
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120402,
					"content": "Did Childe send you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120403,
					"content": "That's correct. Master Childe instructed me to arrange for young master Teucer's return trip. Please come this way...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120404
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120404,
					"content": "Who're you? My big brother always tells me never to go off with strangers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120405
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120405,
					"content": "But you've been following us around this whole time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120406,
					"content": "#Yeah, that's because I've known who you are all along, {M#Mr. Nice Guy}{F#Ms. Nice Lady}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120407
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120407,
					"content": "Um... What?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120408,
					"content": "My brother told us all about you in a letter he sent back home. Sister Tonia read it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120409
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120409,
					"content": "I actually recognized you the moment I saw you. I just... couldn't remember your name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120410
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120410,
					"content": "What a strange twist of fate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120411,
						110120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120411,
					"content": "It was a pleasure meeting you too, Teucer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120412
					]
				},
				{
					"id": 110120412,
					"content": "Hee-hee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120415,
					"content": "Young master Teucer, the boat to Snezhnaya will dock soon. We'd best prepare for boarding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120416
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120416,
					"content": "Gee, time really flies when you're having fun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120417
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120417,
					"content": "#Well then, see you, {M#Mr. Nice Guy}{F#Ms. Nice Lady}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120418
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120418,
					"content": "I'll wait for you back home. You definitely, definitely have to come visit Snezhnaya sometime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120419,
						110120421
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120419,
					"content": "You have a deal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120420
					]
				},
				{
					"id": 110120420,
					"content": "Pinkie promise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120423,
					"content": "You make a pinkie promise, you keep it all your life. You break a pinkie promise, Paimon throws you on the ice. The cold will kill the pinkie that once betrayed your friend, the frost will freeze your tongue off so you never lie again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120424,
					"content": "Hee-hee... It's a promise, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120425
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120425,
					"content": "Bye-bye, Teucer! Have a safe trip~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120421,
					"content": "Wanna make a pinkie promise?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120422
					]
				},
				{
					"id": 110120422,
					"content": "Yeah! Pinkie promise, pinkie promise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120413,
					"content": "Your brother didn't say anything bad about me, did he?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120414
					]
				},
				{
					"id": 110120414,
					"content": "Not at all. In fact, he said that if he ever had the chance, he'd quit his job and join you on your adventures!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
