			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121101,
					"content": "Hey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121102,
					"content": "Childe? So you were here this whole time. What are you hiding for? Why didn't you come and say goodbye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121103,
					"content": "Partings are special moments. If he spent his final moments in Liyue seeing me all haggard and weak like this... That's not a memory I want him to leave with.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121104,
					"content": "Still, it is a shame that I couldn't see him off by myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121105,
					"content": "*sigh* I should have been the one taking him back. I do have subordinates to escort him, but I still feel a little uneasy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121106,
					"content": "Geez, don't you think you've spoiled him enough already?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121107,
					"content": "Haha. I can't quite explain it, but somehow I felt much more at ease leaving him in your care. And to think that not long ago, we...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121108,
					"content": "Ah, yes. I almost forgot. Remuneration for your services — which I really couldn't have done without this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121109,
					"content": "Aha, so you do have a heart after all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121110,
					"content": "One other thing: don't forget our promise, now. Let's have a rematch when we get the chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121111,
					"content": "—This time, with my honor as a Harbinger on the line.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121112,
					"content": "I'm looking forward to it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "You'd best go rest up first! Don't come crying to us when you lose all over again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121115,
					"content": "Hahaha... Regardless of who wins or loses our next bout, I'd also like to invite you over to my home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121116,
					"content": "I'll introduce you to my other siblings, Tonia and Anthon. They're great kids, and I'm very proud of them both.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121117,
					"content": "We'll take you up on that offer! Mostly because we already made a pinkie promise to Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121118,
					"content": "Haha, I'm sure that he'll be very excited to see you too. Well, that settles it. I'm looking forward to it, now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121119,
					"content": "Farewell, my friends — till we meet again, in Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121113,
					"content": "I'm not gonna lose to you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
	]
}