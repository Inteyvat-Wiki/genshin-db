			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120701,
					"content": "This... This is everything I've ever dreamed of! It's Mr. Cyclops world!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120702,
						110120703
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120702,
					"content": "This is the surprise your brother prepared for you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120704
					]
				},
				{
					"id": 110120704,
					"content": "Wow... He actually pulled it off! And the way he knocked those Ruin Guards around was like they really were kids' toys...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120705,
					"content": "But Paimon wonders if he'll be alright after using Foul Legacy Transformation again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120706,
					"content": "Awesome! Hee-hee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120707
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120707,
					"content": "Boy, if these Mr. Cyclopses weren't so big, I'd sure love to take one home.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120708
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120708,
					"content": "Wait... Where'd he go? Where'd my brother go?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120709
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120709,
					"content": "Aren't you guys supposed to be playing hide-and-seek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120710,
					"content": "Oh, that's right! I was so excited that I forgot all about our game!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120711
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120711,
					"content": "#Well {M#mister}{F#lady}, let's look for him together, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120703,
					"content": "Mr. Cyclops is the coolest!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120704
					]
				}
			]
		},
		{
			"id": 1101208,
