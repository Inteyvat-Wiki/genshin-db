					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120801,
					"content": "Brother... someone was saying that Mr. Cyclops is a killing machine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120802
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120802,
					"content": "Were they, now? What a silly thing for them to say... And you shouldn't go repeating it either, Teucer, you're far too young to be talking about such violent topics.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120803
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120803,
					"content": "Yeah, I knew that they were lying, anyways. Mr. Cyclops is here to defeat the bad guys and protect the world. He's my favorite toy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120804,
					"content": "Right. With Mr. Cyclops around, the bad guys won't ever get you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120805,
					"content": "Hee-hee, that's right! Okay, I'm going to go play with Mr. Cyclops now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120806,
					"content": "Hey, Teucer, wait up...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120807,
					"content": "Th—The door's shut! Will Teucer be alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120808,
					"content": "There's another path over there — let's move!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
