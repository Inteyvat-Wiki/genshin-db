	"talks": [
		{
			"id": 1101201,
			"completionStepIds": [
				1101202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101202",
							"2"
						],
						"stepId": 1101202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Here we are — welcome to Liyue's Institute of Toy Research.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120102,
					"content": "Yeah, we're here! I can already hear the sounds of machinery inside. Awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "What is this place? And how do you know about it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "Based on my limited understanding, I believe this is one of Dottore's research facilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120105,
					"content": "Dottore is another one of the Fatui Harbingers. He loves tinkering with old things, it's a... personal passion of his. So, he converted these ruins into a Ruin Guard research lab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120106,
					"content": "Eh? So the Ruin Guards are built by the Fatui!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "No. They have much closer connections to the Abyss, so strictly speaking, they're as much our enemies as anyone else's... We just do research, nothing more.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120108,
					"content": "As to why the Ruin Guards have been moving outside of this area recently... I can only imagine that he's gotten bored of playing around with them, and has lost interest in this place.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120109,
					"content": "Wow, yet another Harbinger with a bad attitude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "But at least this explains why you were totally okay with bringing Teucer here. Seems you did your homework ahead of time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "Well... I wouldn't go quite that far. I actually have no idea what this place is like on the inside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120112,
					"content": "W—Wait, so... are you or are you not worried about your brother's safety?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "Of course I am... But no matter what the danger is, I will parry it. Isn't that what any older brother would do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120114,
					"content": "Even Teucer understands that, now he knows what he's fighting for... It's the very same reason that has nestled in my own heart for so many years...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120115,
					"content": "What are you guys chatting about? Come on, let's go in!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "Haha, alright. Follow me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "It's a good thing that you two found me first... Looks like using the Foul Legacy Transformation while I was still injured took more out of me than I'd thought...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120202,
					"content": "I've no idea what I'd do if Teucer saw me like this — look at me, deflated as a burst balloon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120203,
					"content": "You're not afraid that I might end you right here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "Haha! As I recall, you have siblings too, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120205,
					"content": "I figured that you probably wouldn't take me out in front of my little brother.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120206,
					"content": "Really milking this situation, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Like I said... I can never pass on an opportunity to test my limits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120209,
					"content": "And that's why I, Tartaglia, am always getting stronger. *chuckles*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120210,
					"content": "Anyway, childhood dreams are all too easily shattered. Even if you just leave them be, they will fall to pieces all by themselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120211,
					"content": "So, someone has to protect them, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120212,
					"content": "If you make a promise, you keep it, if you make a mistake, you apologize...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120213,
					"content": "And if you give someone a dream, you defend it to the end...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120214,
					"content": "That is what family is all about, isn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "Aha... Remind you of something, did I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120217,
					"content": "*cough* Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120218,
					"content": "Quit the tough guy act, already! You need to see a doctor right away, mister!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120219,
					"content": "A fine suggestion, but first... I have a little something for Teucer. Please give it to him on my behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120220,
					"content": "Eh, is this... a Mr. Cyclops action figure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120221,
					"content": "Indeed. I had it made to order by a smith some time back. I had intended to give it to him on my return to Snezhnaya, but it seems that it would make a better souvenir at this point.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120222,
					"content": "Wow... Now Paimon thinks about it, Childe's family are really lucky to have him, aren't they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120223,
					"content": "Hah. I'll also need you to explain my abrupt departure to Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120224,
					"content": "You'll help me out, won't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
						110120226
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120225,
					"content": "\"You make a pinkie promise, you keep it all your life...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120227,
					"content": "Hahaha... \"The cold will kill the pinkie that once betrayed your friend, the frost will freeze your tongue off so you never lie again.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120228
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120228,
					"content": "Ah, that nursery rhyme brings back so many delightful memories. Teucer taught you that one, did he?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120229
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120229,
					"content": "Go in peace.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120230
					]
				},
				{
					"id": 110120230,
					"content": "...Alright. Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120226,
					"content": "...I break a pinkie promise, I get thrown on the ice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120207,
					"content": "Was this worth the effort?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120208
					]
				}
			]
		},
		{
			"id": 1101203,
