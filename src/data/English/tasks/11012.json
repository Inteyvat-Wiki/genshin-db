				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120901,
					"content": "Oh, the door opened! Was that you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120902
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120902,
					"content": "That's right. But give me a moment over here, Teucer. I need to make sure that everything's safe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120903
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120903,
					"content": "*sigh* Maybe I shouldn't have spoiled him quite so much.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 1101210,
			"completionStepIds": [
				1101203,
				1101214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101214",
