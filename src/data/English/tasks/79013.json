			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132401,
					"content": "Hey, it looks like he got out of that secret chamber after all! ... And he... credited his sharp eyes for his escape!? C'mon, we left the clue in such an obvious spot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132410,
					"content": "Also, how many notebooks does this guy carry around!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132402,
					"content": "*sigh* He didn't go back after getting out of that chamber. He actually wants to continue adventuring...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132403,
						790132404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132403,
					"content": "Well, it's because he believes he resolved the crisis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				},
				{
					"id": 790132405,
					"content": "That's... That's true. The secret chamber that would trap him forever has now become an obstacle that he easily overcame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132406,
					"content": "That said, the mountain ruins that he mentioned can't be seen in the island outside the lake at all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132407,
					"content": "It's been a really long time since, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132408
					]
				},
				{
					"id": 790132408,
					"content": "Did it collapse and then fall into the sea, then? Paimon's pretty sure that we saw some similar buildings outside in the ocean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132409,
					"content": "Let's explore the nearby sea regions when we've got the time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132404,
					"content": "He did escape the secret chamber, you know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				}
			]
		},
