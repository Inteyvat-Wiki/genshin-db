				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132901,
					"content": "(These etchings are old. They have been written as such...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132902
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132902,
					"content": "\"The wind is very strong here, so I'm not going to use a notebook.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132910
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132910,
					"content": "\"Haha, to think that I'd find a Sweet Madame here — and still warm, too! It's practically a miracle.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132903
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132903,
					"content": "\"I don't know who left that Sweet Madame there or how they knew that I wanted to have some. It's all very strange... But I'm very thankful all the same.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132904
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132904,
					"content": "\"Thank you, person who left the etchings behind! Your Sweet Madame was the best I've ever tasted.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132905
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132905,
					"content": "\"And thank you. I do know that Dragonspine is very dangerous... and I know my limits as well. But I must go.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132906
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132906,
					"content": "\"Who knows, a sign that says 'here be traps' might be all that shall be left of my journey to Dragonspine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132907
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132907,
					"content": "\"But if someone else can avoid that danger and get further than I did, that to me would be something even more precious than a Sweet Madame.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132908
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132908,
					"content": "\"Thank you, whoever you are who left those etchings. But we adventurers exist precisely because of perils like Dragonspine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132909
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790132909,
					"content": "\"Dearest Regards, Wolfgang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etchings"
				}
			]
		},
