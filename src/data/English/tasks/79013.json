			"dialogs": [
				{
					"id": 790131101,
					"content": "The door opened! Whew, that was kinda tricky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131102,
					"content": "#Huh, looks like Wolfgang hasn't written any notes here yet, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131103,
					"content": "So he hasn't been here...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "We did open the chamber for him back then... This means he won't get stuck now, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131105,
					"content": "Well, if that device can be triggered multiple times...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "Wait, then... Um, why don't we leave him a message?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131108,
					"content": "Let's try etching our message into someplace obvious. We'll tell him how to decipher the mechanism!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131106,
					"content": "Even if we did solve it once...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
		{
