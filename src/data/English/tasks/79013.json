			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790130201,
					"content": "Hehe, Sweet Madame really is delicious.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130202,
					"content": "Paimon really gets why this Wolfgang guy misses it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130203,
					"content": "Poor guy, trapped in here without any chance of having Sweet Madame just one last time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130204,
					"content": "This notebook is very, very old...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "#Yeah, but... Do you remember how we crossed through something like a lake on an island to reach another island on the other side, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130217,
					"content": "The buildings on the island inside the lake do look way more complete than the ones outside it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130218,
					"content": "The buildings on the current island look like ruins in comparison...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130219,
					"content": "The buildings within the lake might be...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "That's very likely! The buildings on the island inside might just be the original form of the ruins outside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}, do you think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130223,
					"content": "That the island within the lake is the island as it once looked?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "Yeah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130207,
					"content": "Also, look... We can save this guy if we find where that secret chamber used to be, can't we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130208,
					"content": "It's only gonna work within the confines of the Mirage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "Yeah, but... Even if it's all fake, and this adventurer doesn't even exist... Shouldn't we at least try to save him? His fate was so sad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130211,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130212,
					"content": "Well yes, I suppose you're right.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "#Hehe! Paimon knew you'd agree, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130216,
					"content": "Let's have a look at the island that's inside the lake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130214,
					"content": "Let's go have a look, then...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "Yup, let's try to save this Wolfgang guy, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130209,
					"content": "That won't change what happened in reality...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130220,
					"content": "The buildings within the lake reflect their original appearance...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130205,
					"content": "This happened a long time ago, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				}
			]
		},
