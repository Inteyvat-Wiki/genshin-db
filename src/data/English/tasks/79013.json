				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "Ooh, so there weren't any notes here because he carved a message on the pillar. Huh, so he made it all the way here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131902,
					"content": "Where does his confidence come from, though... If we hadn't helped him out, he'd still be stuck in the secret chamber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131903,
					"content": "He's pretty much gonna be Chilled Meat if he goes to Dragonspine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131904,
					"content": "That's a little overboard...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "Eh? U—Um, Paimon just means that he'd be in deep trouble if he went to Dragonspine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131908,
					"content": "We need to tell him not to go, and quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131909,
					"content": "Well, let's leave him another message, shall we...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131910
					]
				},
				{
					"id": 790131910,
					"content": "Right, that's right! Paimon thought so too... And y'know what, let's leave him some Sweet Madame this time too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131911,
					"content": "Maybe he'll start missing the warmth of Mondstadt once he's had a bite, and he'll give up on going to Dragonspine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131912,
					"content": "The Sweet Madame's gonna spoil, you know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131913
					]
				},
				{
					"id": 790131913,
					"content": "Eh, come on, it's the thought that counts. Right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131906,
					"content": "Well, he's going to get in trouble for sure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131907
					]
				},
				{
					"id": 790131907,
					"content": "Exactly! Dragonspine's super cold and is filled with hilichurls... Not to mention The Great Snowboar King!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
