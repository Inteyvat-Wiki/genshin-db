					"content": "This place should be eye-catching enough!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131202
					],
					"speakerTitle": "Leave Message"
				},
				{
					"id": 790131202,
					"content": "Let's hope Wolfgang does see it, and doesn't go running around the secret chambers in these ruins anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131203
					],
					"speakerTitle": "Leave Message"
				},
				{
					"id": 790131203,
					"content": "Let's go back and have a look. Maybe his notes might have changed this time, too!",
					"roleType": "TALK_ROLE_NPC",
