			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131801,
					"content": "(These etchings are old. They have been written as such...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790131802,
					"content": "\"The wind is very strong here, so I'm not going to use a notebook.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790131803,
					"content": "\"The sunrise here is beautiful indeed. It fills my heart with satisfaction to have braved many dangers to get here.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790131804,
					"content": "\"I wonder if anyone will come after me to see these same sights.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790131805,
					"content": "\"Now that I've cleared this particular trial... Next stop, Dragonspine!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790131806,
					"content": "\"This truly is a lovely place. The only thing it's missing is some Sweet Madame...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "Etchings"
				},
				{
					"id": 790131807,
					"content": "\"Wolfgang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etchings"
				}
			]
		},
		{
			"id": 7901319,
			"completionStepIds": [
				7901327
			],
