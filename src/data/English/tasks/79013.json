			"dialogs": [
				{
					"id": 790133501,
					"content": "Wolfgang hasn't left his notebook here either. Looks like he hasn't arrived yet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133502,
					"content": "Let's leave him some hints on how to open this secret chamber again, shall we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133503,
						790133504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133503,
					"content": "This solution...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133505
					]
				},
				{
					"id": 790133505,
					"content": "Oh yeah, that's true. If Wolfgang can't make use of the elements...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133506,
					"content": "Then the solution's useless to him. What should we do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133507,
						790133508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133507,
					"content": "How about we just make him not enter this place at all?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133509
					]
				},
				{
					"id": 790133509,
					"content": "Ooh, that's right! We can just leave a hint outside saying that there's a secret chamber here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133510,
					"content": "Then he won't come in, and he won't get trapped in these ruins!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133511,
					"content": "C'mon, let's do it, quick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133508,
					"content": "Let's leave a message outside the door.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133509
					]
				},
				{
					"id": 790133504,
					"content": "Without the use of elemental powers...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133505
					]
				}
			]
		},
