				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132601,
					"content": "Well, he didn't go in again. That's a relief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132602,
					"content": "Still, his annoyingly arrogant attitude is really ticking Paimon off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132603,
					"content": "He really does sound like he's getting more and more full of himself...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132604
					]
				},
				{
					"id": 790132604,
					"content": "That said, the highland ruins he mentioned should be near the submerged ruins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132605,
					"content": "Let's go have a look. Honestly, who knows if he was able to climb that high up safely...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
