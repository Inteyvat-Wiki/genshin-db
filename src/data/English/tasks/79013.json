					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "What the... This guy's saying some pretty glib stuff, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131602,
					"content": "This is bad. We've got to get to Dragonspine and...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131603,
					"content": "Paimon, what we change in the Mirage will not change the past...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "Ah... Right, that's true. Wolfgang is only \"here\" at all because the Golden Apple Archipelago is under the effects of that device...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131606,
					"content": "That's why Paimon thought that he was rescued... But in the end, he really was just stuck in that very first secret chamber, wasn't he...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131607,
					"content": "But still, this Wolfgang is really... annoying! We helped him so much, but he still thinks that it would be nice if he could \"pave the way\" for others...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131608,
					"content": "Couldn't he at least value his life a little more?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131609,
					"content": "Everybody's looking for that something...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "Ugh... Paimon gets it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131612,
					"content": "Still, if only they could have come to better ends. You know, like returning to Mondstadt, becoming great adventurers, maybe going to the tavern to play with cats, eat Sweet Madame to their heart's content...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131613,
					"content": "Why doesn't it ever end well for them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131610,
					"content": "Well, it's only because people like him exist...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "Wolfgang will never make it to Dragonspine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
		{
			"id": 7901318,
