				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132501,
					"content": "This notebook... Oh, it's \"Wolfgang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132502,
						790132503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132502,
					"content": "Oh, joy. Stuck again, is he?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132504
					]
				},
				{
					"id": 790132504,
					"content": "I guess some people need some punishment before they'll learn anything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132505,
					"content": "#These underwater buildings... They should be the mountain ruins that we saw on the island on the other side of the lake. Let's go inside again to make sure, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132503,
					"content": "Didn't learn his lesson, I suppose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132504
					]
				}
			]
		},
		{
			"id": 7901326,
