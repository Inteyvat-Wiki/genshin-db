			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "Ah-hahahahah! Ah my, ah me... I'm all out of breath...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010202,
					"content": "Ahaha... I'm tearing up over here! Ah, dear Chikapu, if only you were here to see this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010203,
					"content": "I gotta admit, you're pissing me off.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "Hahaha... I'm sorry, I'm sorry. Please, don't be angry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010206,
					"content": "I and my wife have always enjoyed playing pranks on others. We've never pulled the same trick twice, you know? And everyone enjoyed them, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010207,
					"content": "Later, she suffered from a serious illness and left this world early... She told me then that I had to play a trick on someone in front of her grave, or her spirit wouldn't be able to move on...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010208,
					"content": "So I did. It was Chikapu's wish. How did it go? Pretty good, huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010209,
					"content": "It was kinda lame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "Ah, come on! You outsiders are no fun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010213,
					"content": "Well, I've still got a trusty water-spraying trick, if you'd like to see it... No? Aw, come on!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010214,
					"content": "Alright, alright, I'm leaving! See you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010210,
					"content": "You nearly got us killed!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "I'm gonna have trouble trusting you from now on...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "Care to share what this is all about?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
