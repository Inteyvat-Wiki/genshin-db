			"dialogs": [
				{
					"id": 761490101,
					"content": "Who is it!? Who's there?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}. One who belongs to this era.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "Ah. Well, though I know nothing of your time, my name is Alara. I was once an Ascetic of the Age of Silence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490104,
					"content": "I no longer remember how much time has passed since I came here. Even this place has broken my silent cultivation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490105,
					"content": "So it is true... cultivating a mind without thought or desire leads one to reincarnate in the Unthinking Heaven of Evil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490106,
					"content": "It was nothing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "No need to thank me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "Well, thanks all the same!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490109,
					"content": "Saving you was more of a spur-of-the-moment thing. That said, we're planning to look for a way out that isn't meditation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490110,
					"content": "Are you not practiced in that art? Or is it simply not taught in your era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490111,
					"content": "The first time I left this place, it took me hundreds of years. I gave up my pursuit of truth... and my longing to see my loved ones again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490112,
					"content": "This time, I'm not willing to give any of those up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490113,
					"content": "That makes two of us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490115,
					"content": "Dex has picked up another Deathmuse Shard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490116,
					"content": "Deathmuse? Ah, you mean the Maranasati meditation technique. I know of it, and its use in cultivating one's mental state when facing death.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490117,
					"content": "Now that Zeitlind's been found, let's try to find a way out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490118,
					"content": "Are you sure we can get out of here by ourselves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490119,
					"content": "Melanta and Nihilita can move within this place freely, and they usually bring people with them. In which case, Dex should be able to do the same.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490120,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490121,
					"content": "That's three Deathmuse Shards collected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490122,
					"content": "Though I should say this is a temporary name, since I have no clue what Dex will be using them for either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490123,
					"content": "What next, Dex?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490124,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490125,
					"content": "Let's follow its directions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
