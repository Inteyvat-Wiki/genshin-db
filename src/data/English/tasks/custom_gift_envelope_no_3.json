			"dialogs": [
				{
					"id": 715350401,
					"content": "Ooh? Looks like you've got a real knack for crafts. This gift envelope is beautiful, thank you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "I guess this is like your gift to me! I don't have anything on me right now, but once I'm back in Sumeru, I'll be sure to send you something in return.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Now, I just need to make one for Candace so I can give it to her with the necklace. I'm sure she'll love it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Ah, that reminds me, I wonder if she's here yet... It's been a while...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
