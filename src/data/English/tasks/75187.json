			"dialogs": [
				{
					"id": 751870101,
					"content": "#He doesn't have that flaming pattern on his horn... this isn't {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870102,
					"content": "Hey, where'd this little guy come from?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870103,
					"content": "The saurian egg from Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "Oh! It's the saurian egg from back then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870105,
					"content": "Roooah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870106,
					"content": "So that was a Tepetlisaurus egg...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870107,
					"content": "Paimon remembers the person protecting the egg gave it a name... So this little one would be \"Aguara,\" right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870108,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870109,
					"content": "Ooh, it looks like you know your own name!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870110,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870111,
					"content": "#Just like {REALNAME[ID(2)|SHOWHOST(true)]}, this little guy doesn't have a home anymore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870112,
					"content": "#Why not come with us? Hehe, Paimon and {NICKNAME} are the bestest at making friends with Tepetlisaurs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870113,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870114,
					"content": "Hehe... Paimon knew you'd say yes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870115,
					"content": "You put a red cloth on Aguara, just as you once did with your former companion.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "The last wearer of that scarf grew up to become a very, very special guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870117,
					"content": "Aguara! Paimon hopes you'll be just like him, and grow up h—happy and h—healthy...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
