			"dialogs": [
				{
					"id": 207431001,
					"content": "If our winery's business remains closed for any longer, how will I face Master Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207431002,
					"content": "Traveler, if you meet Master Diluc, could you tell him about this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431003
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207431003,
					"content": "It just won't do, the way he just leaves the winery to its own devices all the time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
			]
		},
		{
			"id": 2074320,
			"completionStepIds": [
				2074306
			],
