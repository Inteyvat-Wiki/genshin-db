			},
			"dialogs": [
				{
					"id": 761001601,
					"content": "...How is Bjorn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001602,
					"content": "...He's badly injured. The attack came too suddenly, and to protect us, he... *sob*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001603,
					"content": "...The battlefield was too dangerous, and he was in no state to be moved. We had no choice but to treat him here on the spot, but with the resources we have to hand, it's just...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001604,
					"content": "...Captain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001605,
					"content": "Bjorn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001606,
					"content": "...I'm sorry... I couldn't complete the mission...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001607,
					"content": "You did great! The position remains secure, and everyone's still safe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001608,
					"content": "Really...? I did it, then... That's good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001609,
					"content": "Stop talking. You need rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001610,
					"content": "If I don't say it now... I won't get another chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001611,
					"content": "...Don't say that! That's an order from your captain! You'll be fine... You'll be fine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001612,
					"content": "Heh... alright... as you command... I won't mention that again...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001613,
					"content": "But at least... I'll finally be able to face Veyde with no regrets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001614,
					"content": "He would say... that we Lightkeepers are like Winter Iceleas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001615,
					"content": "In the face of the Wild Hunt... each of us is fragile... like a Winter Icelea's petals... How easily we shatter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001616,
					"content": "But... so long as the leaves remain... so long as the roots stay firmly in the soil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001617,
					"content": "When the next season comes... and the one after that... new flowers will bloom anew...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001618,
					"content": "We will not fail... Isn't that right... Captain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001619,
					"content": "...Yes. We will not fail! I will see that monster buried at my hands once and for all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001620,
					"content": "...You're the strongest among us... I believe in you... Captain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001621,
					"content": "...Rest assured, Bjorn. I'll keep our promise. Rest now... Things will have turned around by the time you recover...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001622,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001623,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001624,
					"content": "#...{NICKNAME}, Paimon, we need to go. The mission isn't over yet. We can't stay here any longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001625,
					"content": "Illuga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761001626,
					"content": "We have to keep moving, for Bjorn's sake.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "We will defeat the enemy and claim victory.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "...Yeah. Let's keep going.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}