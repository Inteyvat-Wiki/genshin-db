			},
			"dialogs": [
				{
					"id": 761000701,
					"content": "Out of the way, move it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Hehe... What's the hurry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000703,
					"content": "One way or another... you're all going to die. But some of you... just get to go a bit earlier...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000704,
					"content": "He whined about not dying back then... Three years ago... And now... I'll fulfill his wish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000705,
					"content": "...Bjorn? What did you do to him!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "He was too weak... the weaklings... Useless... Crawling insects...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000707,
					"content": "...Dying is all they're good for, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000708,
					"content": "Don't you dare insult him! He's not weak at all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Oh... In your eyes... he was strong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000710,
					"content": "But... but the strong die all the same...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000711,
					"content": "I thought... you understood that better than anyone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000712,
					"content": "The ones stronger than you... They all died, didn't they? They died three years ago... and ten years ago as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000713,
					"content": "...Shut your mouth!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Yes... the only weak one here... is you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000715,
					"content": "Otherwise... why is it that every time... every time... you're the only one who survives?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000716,
					"content": "...You ran from the battlefield, didn't you? Just a coward clinging to life...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Voice From the Monster"
				},
				{
					"id": 761000717,
					"content": "Illuga, don't listen to its nonsense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "Enough! Time to die!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#...{NICKNAME}! Let's finish this quickly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
