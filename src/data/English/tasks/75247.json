			"dialogs": [
				{
					"id": 752470101,
					"content": "This should be the place from the picture. Look, Ororon and Ifa are here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470102,
					"content": "Hello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470103,
					"content": "Ah, now that sounds like a happy Paimon. Great! No need to be on guard then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470104,
					"content": "Please, even an \"angry Paimon\" is harmless.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "Ugh! Watch it, buddy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470106,
					"content": "All you gotta do is give her a treat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "Hey! Paimon's not Cacucu! You can't just give her a cracker and call it a day...! Okay, maybe that would help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470108,
					"content": "But, y'know what? It doesn't matter! Paimon's in a good mood today, and you're not gonna tease her out of it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470109,
					"content": "Hold on, speaking of Cacucu... Where is he? Don't tell Paimon the Capybara King gobbled him up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470110,
					"content": "What? Do you even hear yourself, bro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470111,
					"content": "Cacucu has joined hands with the enemy to bully us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470112,
					"content": "Bully you? Cacucu? Hahaha, good one, Ororon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470113,
					"content": "That wasn't meant to be a joke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470114,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470115,
					"content": "Then, this so-called \"enemy\" is...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "He said his name was \"Cacasha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470117,
					"content": "Wait, so does that mean he's an Asha? An Asha that can talk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470118,
					"content": "Whoa, hold up. Ororon is... embellishing. Let me explain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470119,
					"content": "Cacucu is, uh... playing hide-and-seek around here with an Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470120,
					"content": "And by that, we mean that they're allied against us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470121,
					"content": "Cacucu is fast, and Cacasha can disguise himself... So, we face a crafty enemy indeed.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470122,
					"content": "We played round after round with the little guys before you showed up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470123,
					"content": "And, listen, Cacucu is a beast at this game. Am I proud of him? Yeah. But man, I am getting worn out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470124,
					"content": "It's your own fault for not going to Coach Iansan's fitness class.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470125,
					"content": "*sigh* Seriously, having to search up and down for these little guys, round after round... My back's killing me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470126,
					"content": "Of course it is. Because you didn't go to Coach Iansan's fitness class.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470127,
					"content": "...Alright, alright. I get the picture! I'll go when we get back. Happy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470128,
					"content": "Hey, shouldn't you do a little more seeking right about now? Who's gonna track down Cacucu and Cacasha if you keep bickering like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470129,
					"content": "Ah, well, that brings us to the perfectly good lemon that just fell right into our lap...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470130,
					"content": "Me... again?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "Mm-hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470132,
					"content": "Fine. I'll go.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#You got this, {M#Gramps}{F#other Granny}! Oh, and you too, Granny Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470134,
					"content": "Just have fun, and call us if you need help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470135,
					"content": "Wait, I thought we were gonna be Ashas as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470136,
					"content": "Oh no... Please don't tell Paimon you're gonna hide with them and force us to find you too?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470137,
					"content": "That's right! From now on, I'm \"Orasha,\" and he's \"Ifasha.\" Gotta go hide. Good luck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470138,
					"content": "Bro! What the...! Gah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470139,
					"content": "Sorry, guys. Mind humoring him for a bit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470140,
					"content": "Not at all. It's fun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "Thanks, you two! Guess that means I should get hiding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470141,
					"content": "Don't worry! I have more than enough energy to spare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
