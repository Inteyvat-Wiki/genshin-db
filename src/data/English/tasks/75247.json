			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ifa",
					"Ororon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752475001,
					"content": "Well, are you happy, buddy? Did you have fun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475002,
					"content": "Oh wow, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475003,
					"content": "I think that's a yes. Happy birthday, bro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475004,
					"content": "Oh, and that reminds me. Why didn't you tell me about the plan, bro? Seriously, bro, bros don't hide things from other bros, bro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475005,
					"content": "Haha... To be honest, I wanted to see if you remembered the anniversary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475006,
					"content": "Psh... You've changed, Ifa. How am I supposed to trust you when you betray a bro like that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475007,
					"content": "Heh... Well, jokes on you, because I did remember. I saved some fresh honey for Cacucu. I know the price of forgetting the anniversary, and I wasn't about to get pecked in the head for a whole year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475008,
					"content": "Wouldn't do that, bro! You're the best!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		},
		{
			"id": 7524751,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
