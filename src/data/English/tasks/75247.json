			},
			"dialogs": [
				{
					"id": 752470401,
					"content": "Found it! We were right about the Easybreeze Market!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470402
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470402,
					"content": "Easybreeze Market!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470403
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470403,
					"content": "Chill, bro. I know you're excited, but we've gotta get the lay of the land first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470404
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470404,
					"content": "Ahem... Step on up, dear patrons! Pick an egg, any egg! Let this be your lucky day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470405
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470405,
					"content": "Test 'em out free of charge! What do you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470406
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470406,
					"content": "Oh, so this is where the picture was leading us. This must be where the Gift Eggs come from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470407,
					"content": "Well, hehe... Let's see how far that lucky streak gets us!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470408,
					"content": "S—Step right up! The gift eggs are all set for the picking!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470409
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470409,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470410
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470410,
					"content": "You first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470411
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470411,
					"content": "Seriously, bro? Don't tell me you actually buy into the whole \"bad luck to go first\" thing? ...Fine, fine. Have it your way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470412
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470412,
					"content": "By the luck of the Asha, gimme something good!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470413
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470413,
					"content": "Whoa, Saurus Crackers! Score!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470414,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470415
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470415,
					"content": "Pff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470416
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470416,
					"content": "You don't like Saurus Crackers, Ifa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470417,
					"content": "Oh, don't get me wrong, we both love 'em. But, when it comes to Gift Eggs, they're not exactly one of the better prizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470418
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470418,
					"content": "Whatever, anything that tastes good is fine by me. Here, everyone can have some.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470419
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470419,
					"content": "Make fun of me all you want, bro. Just wait until you get one of those weird Magma Eggs, and see if I help you then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470420
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470420,
					"content": "Impossible. You can never resist helping people.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470421
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470421,
					"content": "Now... Is there a special ritual I should do before opening the egg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470422,
					"content": "Whatever you think will bring you good luck, I guess.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470423
					]
				},
				{
					"id": 752470423,
					"content": "Got it. \"Flower-Feather Clan Patrol Team — open up!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470424
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470424,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470425
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470425,
					"content": "Whoa, it's the Flower-Feather Clan specialty, \"Sing Your Heart Out\"... Guess that ritual actually worked...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470426,
					"content": "Nice! I'll take anything but Mystique Soup, honestly. I'm so tired of that stuff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470427
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470427,
					"content": "Guess I lucked out with this huge tub of candy! Dig in, everyone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470428
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470428,
					"content": "You're the best, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470429,
						752470431
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470429,
					"content": "After making a meal of the Saurus Crackers, Cacucu crunches away at the candy.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470430
					]
				},
				{
					"id": 752470430,
					"content": "All the sugar gives everyone a bit of a rush...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470431,
					"content": "Paimon's turn, Paimon's turn! Ooh, what should she say for good luck... Ah, got it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470432,
					"content": "Ahem... \"Gotta be the big one! C'mon, big yummy, big yummy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470433,
					"content": "Hehe... Oh! It's the soup Ororon didn't want...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470434,
					"content": "Nice one, Paimon! Something you can keep all for yourself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470435
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470435,
					"content": "Huh, good point. All the more for Paimon, then! Hehe, time to dig in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470436,
					"content": "Ah, so sweet and refreshing! Perfect for the season!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470437,
					"content": "Alright, that leaves you two... Who wants to go next?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470438
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470438,
					"content": "No rush, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470439,
						752470440
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470439,
					"content": "I'll go first, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				},
				{
					"id": 752470441,
					"content": "Go for it, Traveler! Oh, and don't forget to think of something lucky to say!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470442,
					"content": "(Something lucky, huh...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470443
					]
				},
				{
					"id": 752470443,
					"content": "(deep inhale...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470444
					]
				},
				{
					"id": 752470444,
					"content": "Benny's Adventure Team, assemble!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470445
					]
				},
				{
					"id": 752470445,
					"content": "Glittering Gemstones... Wow, something sweet again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470446,
					"content": "Hehe, takes me back to when I took in my protege...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470447
					]
				},
				{
					"id": 752470447,
					"content": "#Seems like {M#Gramps}{F#other Granny} is lost in some beautiful memories. Guess it was a lucky draw, then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470448
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470448,
					"content": "Alright, Cacucu, you're up. Show 'em what you got!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470449
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470449,
					"content": "Hahaha... Go for the win, bro! Or just... do better than Ifa, at least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470450
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470450,
					"content": "Yeah, yeah, whatever you say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470451
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470451,
					"content": "Let's go, bro! \"Nice to meet you, bro!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470452
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470452,
					"content": "Whoa... What is that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470453
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470453,
					"content": "Score! Score!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470454
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470454,
					"content": "Well, would you look at that!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470455
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470455,
					"content": "Ahem... Aaand we have a winner! Congratulations to Mr. Cacucu for becoming the third patron of the day to win our grand prize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470456
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470456,
					"content": "In addition to these Mini Asha Pockets — our most exclusive prize — we're pleased to award Mr. Cacucu with a serving of every dish available from our gift eggs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470457
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470457,
					"content": "Seriously, bro!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470458
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470458,
					"content": "Yeah, seriously, bro!? Who would've thought Cacucu would turn out to be the lucky one...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470459,
					"content": "Haha, congrats, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470460
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470460,
					"content": "Cacucu, my good bro... Ah, no, my good sir, I have a humble request.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470461
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470461,
					"content": "They say that luck can be passed around by shaking hands. Would you mind if I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470462
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470462,
					"content": "Haha! Sure thing, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470463,
						752470466
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470463,
					"content": "Everyone follows Ororon's lead and shakes Cacucu's wing.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470464
					]
				},
				{
					"id": 752470464,
					"content": "It's an infectious feeling. Soon, everyone is petting his head too.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470465
					]
				},
				{
					"id": 752470465,
					"content": "It's so perfectly round and soft. You almost don't want the moment to end.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470466,
					"content": "Hehe, that should be enough to give Paimon good luck for the rest of the year...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470467,
					"content": "You can count on that, Paimon. Because you have a very special companion in your life. Just like Cacucu does...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470468
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470468,
					"content": "Wh—What are you looking at me for...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470469
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470469,
					"content": "Well, this was your plan all along, wasn't it? Time to come clean, don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470470
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470470,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470471
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470471,
					"content": "Uh, what are you talking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470472,
						752470473
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470472,
					"content": "Wait, so Cacucu's luck...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470474,
					"content": "Okay, okay. It's no big deal, alright? Of course the little guy's lucky to have a bro like me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470475
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470475,
					"content": "Stop dodging the question and give it to us straight. You set all this up, didn't you? The fishing, the hide-and-seek, everything...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470476
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470476,
					"content": "Well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470477
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470477,
					"content": "That must mean you knew that adventurer from Mondstadt already.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470478
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470478,
					"content": "No, not really. I met him a day before you did, that's all, and asked him to point me in the right direction.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470479
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470479,
					"content": "And, yeah, I organized everything with the pictures so that Cacucu could play with the Asha and capybaras. And I set up the gift egg thing, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470480
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470480,
					"content": "Oh wow, bro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470481
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470481,
					"content": "Haha... But, the Capybara King kinda took it the wrong way. At the end of the day, a wild animal's not gonna understand everything you tell them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470482
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470482,
					"content": "My guess is that he thought we were trying to steal the things I prepared for Cacucu, and that's why he was upset.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470483
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470483,
					"content": "Oh, so he's actually called the Capybara King.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470484
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470484,
					"content": "Of course not. Just thought I'd use the name you gave him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470485
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470485,
					"content": "Oh wow, bro! I'm touched.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470486
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470486,
					"content": "...So, now you know! It just happened to be around the anniversary of when I met Cacucu, and I wanted to do something special for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470487
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470487,
					"content": "We don't know when Cacucu's actual birthday is, so we've always just used the anniversary as an excuse to celebrate it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470488
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470488,
					"content": "Cacucu might act like a mature, big brother type of saurian. But, deep down, he's just a little guy who likes to play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470489
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470489,
					"content": "I know you're just a little guy inside and out, buddy. So, have as much fun as you want, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470490
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470490,
					"content": "Bro, bro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470491
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470491,
					"content": "Oh, did you have something to add, Cacucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470492
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470492,
					"content": "Bro, it's not...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470493
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470493,
					"content": "Bro, you don't have to say it. I understand. We love you, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470494
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470494,
					"content": "Yeah, don't be embarrassed, bro. While we're here at the resort, you're as free as a wild qucusaur. All you need to do is have fun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470495
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470495,
					"content": "Happy anniversary, Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470496
					]
				},
				{
					"id": 752470496,
					"content": "Bro! Bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470473,
					"content": "Was all because of...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470440,
					"content": "We should save the best for last.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				}
			]
		},
		{
			"id": 7524750,
			"completionStepIds": [],
