			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cacucu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752475101,
					"content": "Hello again, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "Earlier, I was trying to tell Ifa that he got the date wrong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "But, I stopped myself. I guess part of being mature is knowing when it's better to let things go.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		}
	]
