			"dialogs": [
				{
					"id": 752470301,
					"content": "*sigh*... We did it, finally! That was too much work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470303,
					"content": "Oh, you must be Cacasha! You and Cacucu make a really impressive duo! And, as part of a formidable duo herself, Paimon would know!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470304,
					"content": "Impressive, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470305,
					"content": "See what I mean? When those two join forces, it's almost impossible to beat them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470306,
					"content": "Cacucu, I can officially say you've earned your certificate in the \"art of concealment.\" From now on, you can call yourself a master trickster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470307,
					"content": "Oh, wow! You're the best, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470308
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470308,
					"content": "Hey, what about me? I was the one who played with you the most!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470309
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470309,
					"content": "You're awesome, too, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470310
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470310,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470311
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470311,
					"content": "Huh... I think he has something to give us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470312
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470312,
					"content": "Cacasha presents a Gift Egg to the group...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						752470313
					]
				},
				{
					"id": 752470313,
					"content": "Oh! Another Gift Egg, and another picture too. I think I've seen this symbol around the Easybreeze Market...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470314
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470314,
					"content": "Bro... Why does it feel like we've got another challenge coming our way...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470315
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470315,
					"content": "Huh? Is this some kind of secret treasure hunt, hidden around the resort? I have to see it through!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470316
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470316,
					"content": "See it through, bro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470317
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470317,
					"content": "Seems like Cacucu is having a blast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470318,
					"content": "#Well, you can't have an adventure without {NICKNAME} and Paimon! Whaddaya say, wanna check it out?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470319,
					"content": "Definitely! Let's see it through!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470320
					]
				},
				{
					"id": 752470320,
					"content": "Alright, guess I'm along for the ride, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				}
			]
		},
