					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "All Akademiya notifications and executive announcements have been moved to the Akasha. This message board is reserved for communications between instructors and students only. No outsider comments are permitted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "\"For a more relaxed academic atmosphere, better scholarly exchanges, and writing papers with a smile!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430202,
					"content": "\"We support Vikram as the next Grand Conservator!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430203,
					"content": "\"You are welcome to join the 'Friends of Vikram Fraternity,' where we shall witness the rise of a young, personable, and fun Grand Conservator!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "\"Never forget the three virtues and six sins of the Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430302,
					"content": "\"Admonition, Ingenuity, and Praxis... Virtues all researchers should aspire to.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430303,
					"content": "\"Three virtues that Rifaet has been practicing for decades.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430304,
					"content": "\"The 'Fravashi Reader Society' welcomes you to walk with wisdom and the future Grand Conservator.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "\"To all members, I salute you for your pursuit of virtues.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430402,
					"content": "\"But I've heard over half of Rifaet's papers were ghostwritten.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430403,
					"content": "\"That is why he stayed so low-key despite many achievements.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430404,
					"content": "\"Although sufficient evidence isn't required for a message board like for papers, the message board is not for personal attacks, either.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430405,
					"content": "\"All those comments were made simply out of jealousy!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430406,
					"content": "\"I also heard that Vikram won the hearts of a lot of girls with his eloquence.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430407,
					"content": "\"They don't even know he's married. So, are you jealous of his popularity?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430408,
					"content": "\"Unfounded attacks on Akademiya researchers are prohibited. Individuals who further fabricate rumors will be turned over to the Matra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "\"This message board is not yet a part of the Akasha Access and may be accessed without the system.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430502,
					"content": "\"Please be aware that posts outside of the normal scholarly realms are strictly prohibited.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "\"A gentle reminder, please observe Akademiya protocols and etiquette outside the campus as well.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430602,
					"content": "\"Centralized management of knowledge is the cornerstone for the 'Land of Wisdom.' Don't forfeit the opportunity to study in the Akademiya because of unintentional mistakes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "\"Several cases of Canned Knowledge smuggling have been detected recently. Detailed information will be released to the mentors and students of the relevant schools through the Akasha before the next Jnagarbha Day, following an investigation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430702,
					"content": "\"Mentors are encouraged to improve communication with students to ease their mental stress caused by paper writing and prevent potential crimes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "\"Some might say the Akademiya is pushing the Akasha way too much. Well, I think it's not enough. Most Mahamata have a low productivity, and are even worse than ones we had in the past in some respects.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430802,
					"content": "\"Just think, if we can assign work directly through the Akasha, and also let it manage trading in the Exchange...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430803,
					"content": "\"We can lay off at least half of the Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430804,
					"content": "\"You make a lot of sense. Maybe that's why we're not doing it.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
