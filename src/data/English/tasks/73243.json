			"dialogs": [
				{
					"id": 732432301,
					"content": "As the Akasha System is no longer in use, the bulletin board has now been recommissioned. All Akademiya notifications and executive announcements can be found here. No outsider comments are permitted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
