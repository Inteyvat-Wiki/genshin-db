			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432201,
					"content": "\"Although I trust the sages and mentors' judgment, does the Akademiya rely too much on the Akasha?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432202
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432202,
					"content": "\"It's obvious that the performance of the traveling scholars we sent out has gone down once we got accustomed to using the Akasha. I think it's necessary to restrict access to the Akasha for new students.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432203
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432203,
					"content": "\"How could you say that? Don't you know the cults in the desert without the Akasha have resorted to devouring raw poisonous snakes to gain wisdom?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432204
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432204,
					"content": "\"People fail to recognize that it's the Akasha that ensured the purity of our knowledge.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324323,
