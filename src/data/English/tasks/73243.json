			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "\"As we all know, it is the researchers' job to delve into profound knowledge. However, the current Akademiya is too mired in administrations.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430902,
					"content": "\"Now, many students are forced to stop their research and get sent to be Mahamata elsewhere after completing their studies. Doesn't that contradict the purpose of the Akademiya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430903,
					"content": "\"Wasn't a conclusion already reached on the Akasha long ago?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732430904,
					"content": "\"While folks still indulge in superstitions, we are the closest to the real truth. How can we relieve ourselves of the duty to illuminate the world? If we stop caring, Sumeru will descend into chaos!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "\"As a student studying abroad, I feel the Great Lord's greatness more each day that I'm in the Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431002,
					"content": "\"In Mondstadt's time, it would take digging through a dozen books just to sort out the different theories to a simple question.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431003,
					"content": "\"But the relevant info is available on the Akasha Terminal just by thinking about it. I believe there's no better creation in the world.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "\"Ever since Pir Kavikavus, the Akademiya has never increased the annual funding for Kshahrewar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431102,
					"content": "\"Those above only advocated strict control of machine and tech developments to ensure a stable, peaceful society. I'd say you might as well shut down the Akasha in that case!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431103,
					"content": "\"If it wasn't for long-term funding from astute businessmen like Lord Sangemah Bay, Kshahrewar would've been gone long ago!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "\"Although I trust the sages and mentors' judgment, does the Akademiya rely too much on Akasha?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431202,
					"content": "\"It's obvious that the level of traveling scholars we sent out has gone down once we got accustomed to using Akasha. I think it's necessary to restrict access to Akasha for new students.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431203,
					"content": "\"How could you say that? Don't you know the cults in the desert without Akasha have resorted to devouring raw poisonous snakes to gain wisdom?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431204,
					"content": "\"Other than Greater Lord Rukkhadevata, it's the Akasha that ensured the purity of our knowledge.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "This week's botany seminar presented by Forest Watcher Tighnari will take place at Pardis Dhyai as usual. Everyone is welcome to sign up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431302,
					"content": "Everyone interested in botany may come, regardless of who you are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431303,
					"content": "Apologies, due to too many people signing up for the seminar, the Akademiya has decided to limit attendance to Amu{RUBY#[S]Biology}rta students and ranger personnel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "\"Anyone read the latest novel from Yae Publishing House? It's by a Sumeru author named Pursina or something... Obviously an Amurta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431402,
					"content": "\"If only I got into Amurta... I could sightsee all day and still got time to write stories. Nope, I just had to end up in Haravatat, where it's only researching and writing papers for me, with no chance of seeing the outside.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431403,
					"content": "\"What, someone got published by Yae Publishing House before I did? That's going to hurt my credibility as a light novel authority...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "\"Actual business is run completely different from what the textbooks described... If only I had stayed in the Grand Bazaar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431502,
					"content": "\"Now I can't write papers and am out of money.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431503,
					"content": "\"If this keeps up, I better drop out of school and join the Eremites.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "\"It's not I'm biased towards anyone from the desert, but I think the General Mahamatra should be a renowned researcher, especially for academic issues that couldn't be solved with fisticuffs.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431602,
					"content": "\"Heh, it's still a lot better than when you Rtawahist were running things, at least there's no bias. Or do you really think no one knows the real stories behind the annual publication rate?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431603,
					"content": "\"Listen, you Kshahrewar! You better have proofs or I'll take this up with the matra!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "\"I can stand accepting foreign enrollees, but letting them access the Akasha is another thing entirely...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431702,
					"content": "\"Putting aside the influence foreign minds might exert on the Akasha, who knows how much damage the outgoing knowledge will do to Sumeru trading.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431703,
					"content": "\"Researchers concerned about economics? That's fresh.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431704,
					"content": "\"That's why you Haravatat are known as snobs. I wouldn't be here if I didn't want to learn to create a better paint!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "\"Haven't seen that desert dwarf in a while... Guess we can relax a bit.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431802,
					"content": "\"Wonder what got into the disciplinary staff to stop me from passing the evaluation this semester.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431803,
					"content": "\"You can pass the evaluation just by showing up, so don't blame others for you not studying. And even though the matra is short-staffed, still be careful what you say.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431804,
					"content": "\"The matra is just the hierarchy flaunting their authority. Hold on, I just got a message from the Akasha...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431805,
					"content": "\"Guess we all ought to watch our steps.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324319",
							"2"
						],
						"stepId": 7324319,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "\"...Regarding the investigation of Zandik... Dastur... Cause of death... Possible murder...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431902,
					"content": "\"...Zandik... following the delisting... regarding Eleazar... but lacking evidence...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431903,
					"content": "\"...Records suddenly disappeared... Year unknown... Eleazar outbreak began...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431904,
					"content": "\"...Prior to disappearance... Legend of Varuna... obsessed with...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732431905,
					"content": "(The following content has been thoroughly defaced as to be completely incomprehensible.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324320",
							"2"
						],
						"stepId": 7324320,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "\"After perusing the Starlog by the great sage of Tabari, I finally realized whether it be the war of gods or downfall of ancient empires, it was all a microcosm of the celestial movements.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432002,
					"content": "\"The starry sky above us is the only thing eternal.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432003,
					"content": "\"Uh, sentimentality aside, are you Rtawahist just going to summarize all ancient events in one lump sum?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432004,
					"content": "\"Wish you would examine it from the historical perspective, not just stargaze and contemplate.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432005,
					"content": "\"What do you know!? This is called exploring the laws of the universe! No wonder all you Vahumana are bookworms!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
		{
			"id": 7324321,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"302821",
							"3"
						],
						"stepId": 302821,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "\"As a student studying abroad, I feel the Dendro Archon's greatness more each day that I'm in the Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432102,
					"content": "\"In Mondstadt's time, it would take digging through a dozen books just to sort out the different theories to a simple question.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Message Board"
				},
				{
					"id": 732432103,
					"content": "\"But the relevant info is available on the Akasha Terminal just by thinking about it. I believe there's no better creation in the world.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Message Board"
				}
			]
		},
