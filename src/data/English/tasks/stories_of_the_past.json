				"points": []
			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "And a pleasure to share stories of the past with you, Miss Guillotin, over this wonderful glass of water.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510204,
					"content": "Very well. Wherever you're going next, I wish you a smooth journey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}