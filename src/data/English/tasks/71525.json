			"dialogs": [
				{
					"id": 716662001,
					"content": "Hello, all. I am Iron Tongue Tian, here with an official signboard for the Arataki Blazing Armor Beetle Battle Boot Camp. It also doubles as your permit to run the event.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662002,
					"content": "Whoa! Is this supposed to be... Bull-Chucker and Crimson Staff? It's so over the top!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716662003,
					"content": "Oh, sweet! Sadly, it's not my own original artwork... But check out that design! And that linework!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662004,
					"content": "It's so cool! It's epic! It captures exactly how awesome I look as a pro beetle-fighter in the heat of battle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662005,
					"content": "Dude! ...Wait, not that — how do they usually address strangers in this part of the world?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662006,
					"content": "Maybe... \"esquire\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716662007,
					"content": "That's the one! Tian Esquire, your artwork is incredible! Words cannot express the Arataki Gang's gratitude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662008,
					"content": "You can drop the \"esquire,\" Don Arataki. Also, I'm no artist — just a storyteller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662009,
					"content": "This promotional artwork was done by a young lady at the Ministry of Civil Affairs. Yanfei looks out for her a lot, so when she heard about your event, she offered to contribute some artwork.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662010,
					"content": "Ohh, so this is Yanfei's doing! Man, she really thought of everything... This is exactly what we needed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662011,
					"content": "Young Grandmaster Hanakado here tells me that your boot camp is an ambitious training program that could shape the future of beetle-fighting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662012,
					"content": "I'm no beetle-fighter myself, but I've heard a lot about it, and have always wanted to try it out for myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662013,
					"content": "Who knows — it might just give me the inspiration for a great new story to tell in the neighborhood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662014,
					"content": "Beetle fighting is something you have to have a natural affinity for. Take Skycleaving White-Iron Lavender Melon for instance: She battled with great prowess on her first time after only a short demonstration.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716662015,
					"content": "Once Tian Esquire has grasped the basics of beetle-fighting and understands the appeal, we might get a lot of free publicity from his storytelling.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716662016,
					"content": "Dude! That would be awesome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662017,
					"content": "Alright, Squirt! Squat! Squire! ESQUIRE! Ahehehehehem... Uh... m—may the best man win!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
