					}
				]
			},
			"dialogs": [
				{
					"id": 716662101,
					"content": "Wonderful!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662102,
					"content": "I can see that the Arataki Gang has transformed beetle fighting into a fiercely competitive high-adrenaline sport. Yes, there are the rudiments of a fine tale here, to be told time and again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662103,
					"content": "Great dueling with you, Tian Esquire! The pleasure was alllllright!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662104,
					"content": "The phrase is \"the pleasure was all mine,\" Oni King.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Grandmaster Hanakado"
				},
				{
					"id": 716662105,
					"content": "Ah, details, schmetails! Point is... Thank you for supporting our boot camp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662106,
					"content": "I extend my gratitude to you too, Don Arataki. I intend to stay here and watch a while longer to further enrich my writing. Please, pay no regard — just pretend I'm not here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "Listen to the Next Breakdown"
				},
				{
					"id": 716662107,
					"content": "Man, I've never fought against someone so... cultured before! My mind's buzzing from all those fancy words. What's that buzzy feeling called again? Oh yeah — learning!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662108,
					"content": "Looks like the Arataki Blazing Armor Beetle Battle Boot Camp is getting off to a good start!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
