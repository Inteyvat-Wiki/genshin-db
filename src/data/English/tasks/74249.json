				"points": []
			},
			"dialogs": [
				{
					"id": 742490201,
					"content": "Ahhh! I'll never get tired of leisurely afternoon teas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "(Let's sit like this for a little while longer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742490204,
					"content": "My, my... Joyful times truly do pass by in a flash.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "I think it's time I started clearing up.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
