	"talks": [
		{
			"id": 7903301,
			"completionStepIds": [
				7903306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903306",
							"2"
						],
						"stepId": 7903306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "Huh, the projection is actually at the center of the stage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330102,
					"content": "What are those two doing? One seems to be talking and the other is sitting on the ground.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330103,
					"content": "Ooh, Paimon knows! She must have been telling the person sitting on the ground a story before they went to bed. That's the kind of picture this is!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330104,
					"content": "Do Fatui listen to bedtime stories too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "You never know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330106,
					"content": "Agafya, Persikov has ordered us to perform some signal reception tests. Looks like all four of us have to go... Chevka will probably get mad at me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330107,
					"content": "Come on, Yakov, orders are orders, Chevka isn't going to blame you for them!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330108,
					"content": "...You know what, if you're that scared, I'll go with you to talk to Chevka, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330109,
					"content": "Huh, so she wasn't telling a story after all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330110,
					"content": "But this snippet just kinda comes outta nowhere. We can't tell what's going on at all...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903307",
							"2"
						],
						"stepId": 7903307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "Seriously? That conch just floated up from inside the well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330202,
					"content": "Well, it is being affected by the Mirage...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#That's pretty amazing. Ooh, look, {NICKNAME}! Someone's bending over... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330205,
					"content": "#Don't move, {NICKNAME}, behind you...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330206,
					"content": "Uhh, should I be very concerned...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "Oh, wait, no. It's just the image projected from the conch. It just appeared behind you so suddenly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330209,
					"content": "Two signal testing sets...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330210,
					"content": "You know, I honestly thought that he was in serious trouble this time. Who knew this was just about being assigned slightly more annoying work! So yeah, that was a relief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330211,
					"content": "Hah! You should have seen how afraid he was of getting scolded by you. It was almost like watching a little brother cower at the thought of his older brother scolding him. Y'know... do you think he's just afraid of disappointing us?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330212,
					"content": "I mean, we're just squad-mates... but it does sometimes feel like we're family as well...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330213,
					"content": "Family, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330214,
					"content": "Um, Paimon gets the feeling that we just eavesdropped on something we really shouldn't have...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330215,
					"content": "To be honest, these Fatui don't seem all that bad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330207,
					"content": "This isn't the time for pranks, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "There was probably a pocket of air inside the shell...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903305",
							"2"
						],
						"stepId": 7903305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "Hey, looks like those two people are lying on the ground... Are they stargazing?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330302,
					"content": "To be honest, this image seems a bit weird...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330303,
					"content": "Yakov, what did the commander say to you that's got you so down?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330304,
					"content": "Well, the waves were really choppy, so I slipped and fell while carrying the device. Fortunately, I was quick enough to save it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330305,
					"content": "But the commander still gave me an earful and ordered our squad to do signal reception tests. I mean, ugh, that's the toughest job around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330306,
					"content": "Oh come on, don't feel so down. We've done this stuff a hundred times before. Hey, chin up! Go get yourself something to eat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330307,
					"content": "They're pointing towards something high up. Are they looking for something to eat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330308,
					"content": "Wait, is this conch crooked somehow?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}