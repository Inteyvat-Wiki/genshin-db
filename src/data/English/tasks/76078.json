				]
			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "Normally, once the nearby monsters are cleared out, the rifts around here should disappear on their own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "So why does the Wild Hunt's presence still linger...? This is far too strange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "Could there be something I’ve overlooked? Something else that's been tainted by the Wild Hunt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7607805,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
