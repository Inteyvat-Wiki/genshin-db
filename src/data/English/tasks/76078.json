			"dialogs": [
				{
					"id": 760780301,
					"content": "(Though the monsters have dispersed, the darkness has not faded. You may need to enlist the help of a professional who knows more about the Wild Hunt.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Observe"
				}
