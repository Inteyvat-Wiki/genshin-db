						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "There's an Oath Lantern here as well. It must have belonged to someone who came before us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "The lantern is still stained with the Wild Hunt's corruption. It's not hard to imagine what happened...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "From the day we take up the Oath Lantern, our lives are bound to the flame within it, until the moment our rightful mission is fulfilled.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "To you, who fought to your last breath for the peace and safety of Nod-Krai, I offer my deepest respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "I will take your lantern for now. Rest assured, the crown of the honored fallen will keep your legacy safe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "I'll bring it back to headquarters, rekindle its flame, and entrust it to someone worthy of carrying your will forward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga cleans the lantern, then carefully puts it away.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "With that, the Wild Hunt has been wiped out from this place, and our predecessor's spirit has finally found its rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
