			"dialogs": [
				{
					"id": 760780101,
					"content": "Normally, once all the monsters that follow the Wild Hunt have been defeated, the stench of its taint should fade along with them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780102,
					"content": "But this fissure persists... Unusual, but not unprecedented.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780103,
					"content": "Let's search the area. Perhaps something unclean still remains.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7607804",
							"2"
						],
						"stepId": 7607804,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
