				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus",
					"Reckless Pallad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "In this area, huh... Are you sure, Pallad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "I'm very sure, Mr. Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020203,
					"content": "Discussing Joel's dad?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "Ah, if it isn't the Traveler! Joel sent you, I'll wager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "That child has asked someone to come ask us for news practically every day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "This time, though... We've got some good news for him, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "Previously, we were organizing some special training on Dragonspine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "It might be best if I explained the rest, Mr. Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020209,
					"content": "So, while taking part in that training, I wound up straying from the arranged path due to a huge blizzard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020210,
					"content": "As I was groping my way back on track, I saw a blurred silhouette on a cliff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020211,
					"content": "I thought that this must be a lost adventurer, just like myself, so I yelled for their attention.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020212,
					"content": "Unfortunately, before I could attract that person's attention... My cries attracted some monsters first.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020213,
					"content": "Now I don't know about you, but I wasn't confident that I could take them on in such conditions, so I beat a hasty retreat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020214,
					"content": "Once I got back, I related the matter to Mr. Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020215,
					"content": "So the person you saw was Joel's father?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "We're not sure ourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "Regardless, at least now we know that *someone* is trapped on Dragonspine. As such, I believe a rescue is in order.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Whether that person is Joel's father Joserf or not... Now that is up to fortune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "Either way, I've already dispatched all with the capability to explore Dragonspine to fan out and search.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "I'll get ready as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020222,
					"content": "I'll come along.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Really? That's amazing! Let's head out together, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020223,
					"content": "I'll go beat those monsters up.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "That could have been any old lost adventurer, you know...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
		{
