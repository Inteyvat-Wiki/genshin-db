				"points": []
			},
			"dialogs": [
				{
					"id": 708020301,
					"content": "Well, at least this area's safe now. Thanks a lot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020302
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020302,
					"content": "About Joserf...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020303
					]
				},
				{
					"id": 708020303,
					"content": "Unfortunately, I didn't find anything earlier, either.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020304,
					"content": "However, since the coast is clear, I'll continue my search now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "Reckless Pallad"
				},
				{
					"id": 708020305,
					"content": "Would you mind helping me make a trip back to inform Mr. Cyrus that I've begun search efforts? Thanks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Reckless Pallad"
				}
			]
		},
		{
