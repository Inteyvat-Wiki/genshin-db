				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020501,
					"content": "Hey there! What's the latest news?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020502
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020502,
					"content": "Oh... So Uncle Cyrus hasn't found my dad yet, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020503,
						708020504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020503,
					"content": "Have a little faith in him.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				},
				{
					"id": 708020505,
					"content": "I know... I'll ask Uncle Cyrus for more details when he gets here, then. Thanks a bunch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020506
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020506,
					"content": "Where are you, Daddy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020504,
					"content": "They've got some clues, at least.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				}
			]
		},
