					"Joel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020101,
					"content": "Will I really find Dad this time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020102,
					"content": "Any news about your father?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "Oh, it's you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020104,
					"content": "Pallad told me that Uncle Cyrus might have found some news about my dad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020105,
					"content": "He can't be sure yet, but according to Pallad, their latest leads seem pretty promising, so they might just find him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020106,
					"content": "I'd love to go up Dragonspine with them, but Uncle Cyrus says that I should stay in the camp, and that they'll tell me once they get more news...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020107,
					"content": "Could you help me look for Uncle Cyrus and ask him, please?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020108,
					"content": "I've got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "I... I'm afraid that the news... might be bad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020111,
					"content": "Either way... I'm counting on you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020109,
					"content": "Not going yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
		{
			"id": 7080202,
			"completionStepIds": [
				7080203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
