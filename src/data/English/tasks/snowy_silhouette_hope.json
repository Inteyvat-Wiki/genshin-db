				"points": []
			},
			"dialogs": [
				{
					"id": 708020401,
					"content": "Ah, Traveler, you've returned!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020402,
						708020404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020402,
					"content": "Pallad has begun searching.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "Has he now? Hah! I knew he always had a responsible bone in him somewhere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020406,
					"content": "Once I've finished the matters I have on hand, I'll go to Dragonspine to check on that boy Joel myself and give him the news.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020407,
					"content": "So if you would, please tell him that I'll be right with him shortly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020408,
					"content": "It will take a moment for me to finish my work. Don't keep the lad waiting, now!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020404,
					"content": "Will we really find that person?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "...Well, there's no guarantee, of course. I can only say that we'll do all we can.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
