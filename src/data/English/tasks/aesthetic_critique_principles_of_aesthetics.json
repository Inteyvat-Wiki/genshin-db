			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "It lacks tension... What's going on?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "I feel like we're missing something... decisive...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "Taking photos, are we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "That's right — this Kamera is the engine of inspiration for my paintings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "My name is Depierris, and I am a painter — most pleased to meet you, most pleased indeed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "Uh... huh. Likewise...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "Now, I would normally treat a newfound friend to a coffee, but alas, there is no café to be found nearby.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "Hmm. Well, why don't you take this Fonta — let us have a toast, and we'll consider ourselves formally acquainted! Have you been to Fontaine before, by the way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "I'm a first-time visitor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Ah, then you're in for a good time! Head into the city and see the sights — like the waterways stretching out overhead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Then you can head out into the streets and see the intricate machines, even if not all of them have aesthetic value — well, in the opinion of this humble painter, anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "And finally, you can sit yourself down at a café and appreciate a cup of coffee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "Who knows, perhaps someone will come to chat you up while you do so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Still, if the person who comes up to you claims to be from some sort of \"Kamera Club\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Then be on your guard for their words of folly... There are those amongst them who are engaged in it, in any case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "And what are these elements doing exactly?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "What, you ask? No less than set cultural life in our grand Fontaine on the path to annihilation!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "Now, this is no mere fearmongering. Can you guess what they speak of in this club?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "\"If we speak only of pictures, then those taken by Kameras are far superior to paintings.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "I mean, just listen to that \"if we speak only of pictures\" nonsense — and it is but nonsense, no matter how loudly they proclaim it to be the truth!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "If we simply present images as they are, where would the space be for aesthetics?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Well, it is true that some of us are indeed figuring out how to draw even better naturalistic work... But even that is rooted in their aesthetic sense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "Aesthetics! Aesthetics are the key — do you understand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "N—Not really...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "The observation of the world through the artist's eyes is merely the first step. We must explore sensibility and beauty through the brush to bring a masterpiece forth from the heart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "Not all those who love Kameras are brutish imbeciles bereft of all artistic sense, of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "I have many friends who love Kameras, and I love speaking to them. At times, their photos inspire me, and my paintings inspire them in turn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "Those who know nothing of art and only know how to blow their own trumpets... Oh, how they make my blood boil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "They disgrace those who love photography and painting alike! They truly are... *cough*... *cough*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Calm down, get some water...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Ah, thank you... I cannot prevent my rage from boiling over every time I speak of this matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "As such, I, along with some friends, have decided to use this Kamera to take pictures that may be used as material with which to create a series of paintings.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "Afterward, we will place these paintings alongside the pictures used to create them in an exhibition — and then, all shall see the difference between paintings and photography!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "Yet, *sigh* I see little meaning in the various pictures I've taken. My friends tell me that the best sights may be found in the direst of lands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Underwater, for example, or on cliffs, or perhaps the deep wood where few humans go... But I dare not go to such places alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "And hiring adventurers may take too much time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "#Hmm... Dear {M#sir}{F#lady}, would you mind coming under an artist's employ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "As long as you don't make me do the painting...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "No need to worry! We shall both simply do what we're good at.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "You need not worry about the payment either. I often hire adventurers as guards on my inspiration-gathering trips, so I know the rules.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "It's just that this matter was too urgent, and I could not hire anyone in time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Well, that's settled, then. With your help, I grow ever more confident in my odds of producing good work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "I'm only really good at adventurer stuff.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "S—Somewhat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "Will these... elements do anything to me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Just as they have done for Fontaine — they will destroy the cultural life you should have shared in.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "Are you a Kamera hobbyist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "The Kamera, my hobby? No, no, it is merely a reference tool — I am fonder of my paintbrush by far.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
