			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "Traveler! You've come at just the right time! I just found a wondrous photo-taking spot — all I need is a little help from you!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "Still looking for inspiration, are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Of course. This is far from enough materials — a single photo will not allow me to create a full picture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "I usually need several dozen pictures — sometimes even a hundred — for use as reference material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "That many, huh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "As I've told you before, the focus of painting is \"creation.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "If you simply impress the things you see upon the canvas as-is, that is not \"painting\" — that is \"photography.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "What a painter must truly do is to use their sensitivity and aesthetic sense to observe the world around them, before curating, transforming, and editing it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Until such a time as the most beautiful aspect of every object can be abstracted and then engraved upon the canvas to complete one painting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "Well, that was as clear as mud.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "You... Alright. Basically, I'll only use the prettiest parts of these pictures as reference.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "For example, the light-shadow balance here is excellent, but the scenery is lacking by contrast — as such, I will only refer to its use of the former.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "The other picture contains a traveler in a most fascinating pose, and the next features a most magnificent building...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "It is almost like playing with a puzzle in your mind, with the beauty or beastliness of the final product depending solely on your aesthetics and understanding.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "This is not a rigorous way of putting things, since we can also change or abstract the sights within the reference material themselves... but that's all you need to understand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "So you still need my help, please and thank me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Uh... Right, yes, that's right! Your photo-taking skills are incredible — indeed, my friends have wanted to come see you in person after witnessing your work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "I'm sure that with your help, I'll be able to create something truly extraordinary.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "So please, for the sake of human aesthetics — and for the Mora I've prepared — please help me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "So I'll have to continue gathering material for you, or something.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Speak more simply!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Do the pictures have different uses?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
