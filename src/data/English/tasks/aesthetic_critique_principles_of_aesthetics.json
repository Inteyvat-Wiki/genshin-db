					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400904",
							"2"
						],
						"stepId": 2400904,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400906",
							"2"
						],
						"stepId": 2400906,
						"stateName": "QUEST_STATE_UNFINISHED"
