					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090601,
					"content": "Let me see... Those friends of mine gave me some suggestions that I've written in my notebook.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090602,
					"content": "What did I even write here? Let me see... Uh, underwater... rugged rocks... the plants on the rocks... the rocks' contours...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090603,
					"content": "Uh, yes, that's right. I was studying rocks — obsessively, in fact, for their ability to best exhibit natural beauty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090604,
					"content": "Anyway, I'd like you to help me snap a shot of underwater rocks. I wonder what their contours will be like...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
