			]
		},
		{
			"id": 2400908,
			"completionStepIds": [
				2400908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400908",
							"2"
						],
						"stepId": 2400908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "Have you got the picture?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090802,
					"content": "Here it is.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "Let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090804,
					"content": "Ah! Perfection! Perfection! I never expected you to be quite so outstanding a photographer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090805,
					"content": "From this image shall I filter the best material possible!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090806,
					"content": "Thank you so much. Mm... Where did I leave that Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090807,
					"content": "Alright, this is for you — please, take it! If the chance arises in the future, please, do help me take a few more pictures!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090808,
					"content": "Now then... What about the composition...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400909,
			"completionStepIds": [
				2400901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400901",
							"2"
						],
						"stepId": 2400901,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2400902",
							"4"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "This... This isn't good...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090902,
					"content": "What photo do you need taken this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "This time... Well, there's no need to take any photos. Actually, I have another favor to ask of you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090905,
					"content": "Ahem, this is quite embarrassing, but, ah... Could you help me find something to eat... Garlic Baguette, for example?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090906,
					"content": "You... didn't bring anything to eat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "No! I brought a lot of bread, along with some jam and jerky. That should've been enough for the day...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090909,
					"content": "But I put the foodstuffs aside to focus on the painting, and I soon got engrossed... By the time I realized that I was hungry, they were gone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090910,
					"content": "Maybe some animal or hungry passerby made off with it on the sly — in which case, I do hope it fills their tummies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090911,
					"content": "Unfortunately, mine shall have to be filled some other way... And I cannot return to the city now — not without having gathered enough material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090912,
					"content": "Wait just a moment, then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "I'll be counting on you, then. You can get some in the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090915,
					"content": "Haha... Ooh, I feel a little weak. Is it the hunger? Or have I just been thinking too much...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090913,
					"content": "I'll get you what you need.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "Did you... run out of Mora to buy food?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "Where to this time?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
		{
			"id": 2400910,
			"completionStepIds": [
				2400914
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400909",
							"2"
						],
						"stepId": 2400909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091001,
					"content": "Thank you for your help! This should be enough to fill my stomach...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Here, you've earned this. Now, to grab a few quick bites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "It might be worth bringing biscuits that may be stored in my bag next time...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400911,
			"completionStepIds": [
				2400901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_B_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2400901",
							"0"
						]
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_LESS",
