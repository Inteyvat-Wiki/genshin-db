			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "Hey Kaeya, you promised to tell me the story about the Jinni-in-a-bottle if I didn't run off. Remember?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171302,
					"content": "Ah, yes. Alright, where did I leave off...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171303,
					"content": "Oh, I remember! The Jinni came out, and was going to eat the shepherd boy who opened the bottle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171304,
					"content": "Right, as the Jinni opened its wide, menacing mouth, the shepherd boy suddenly had an idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171305,
					"content": "Did he throw a Jumpy Dumpty into the Jinni's mouth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171306,
					"content": "Haha, I'm sure that's what he would have done if he had a Jumpy Dumpty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171307,
					"content": "But the shepherd boy didn't have anything like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171314,
					"content": "He said to the Jinni, \"Wait, how could your massive body fit inside such a small bottle? I won't ever believe it unless I see with my own eyes!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171308,
					"content": "The Jinni became angry, and said, \"Mwahaha. Foolish boy, you dare question my powers!?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171309,
					"content": "The Jinni then returned inside the bottle and the boy swiftly sealed it shut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171310,
					"content": "Yay! That mean Jinni won't ever come out again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171311,
					"content": "But, can the Jinni sleep inside such a tiny bottle? It's probably not very comfortable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171312,
					"content": "No, but the Jinni was captured and sealed away in the bottle because it did many bad things.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171313,
					"content": "So the most important thing to remember is, if you do something bad and don't want to get locked up, then don't get caught.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
