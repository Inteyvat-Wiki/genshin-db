					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401171502,
					"content": "But, just as the General said... If we can restore the domain, then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				}
			]
		},
