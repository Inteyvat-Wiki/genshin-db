			},
			"dialogs": [
				{
					"id": 191430901,
					"content": "I was just doing some cleaning when I suddenly heard a loud noise outside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430902,
					"content": "I got to the door just in time to see <color=#00E1FFFF>a shadowy figure disappear up that tree</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430903,
					"content": "This is a busy street... Surely it wouldn't be a burglar, would it...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aikawa Susumu"
