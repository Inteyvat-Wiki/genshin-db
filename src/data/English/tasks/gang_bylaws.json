						191431102
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431102,
					"content": "You can count on that... We ain't going anywhere right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 191431103,
					"content": "Yes, I can see that. But you'd better not change your mind once you've caught your breath.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431104,
					"content": "We won't! Never again!",
