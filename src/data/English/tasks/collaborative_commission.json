			"dialogs": [
				{
					"id": 761290101,
					"content": "Thank you again for all the help you've given the Guild, Boss Nefer, Miss Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761290102,
					"content": "There's no need for that. Not when this is really a collaboration between us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290103,
					"content": "That's true, but I still want to thank you, Boss Nefer, for being so willing to help the Guild with the... complicated investigative work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290104,
					"content": "The Adventurers' Guild has also sent several folks to help us with our work. We're all working together towards the same goal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290105,
					"content": "I hope our future collaborations will be just as pleasant, Mr. Sarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290106,
					"content": "You can rest assured, Boss Nefer, that the Adventurers' Guild...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290107,
					"content": "Oh, I should be clear about this. You can absolutely trust that we at the Nod-Krai Adventurers' Guild are your ever-reliable partners.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290108,
					"content": "Heh, that much is clear to me, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290109,
					"content": "(Good, good, just keep talking like that, Boss Nef, my dearest Boss Nef, please don't look at me, please don't look at me, please don't look at me...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, why are you keeping so quiet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290111,
					"content": "(NO, she looked at me!!! Fine, just don't look at the commission board, please don't look at the commission board, please don't look at the commission boar—)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "Huh? M-me? Um, I don't have anything to say! Um... Thanks... for the commission...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Oh, we should also thank you for your assistance, Miss Jahoda. Without you, the paperwork at the Guild would've piled up into a mountain by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290114,
					"content": "No need for thank me... I'm getting paid, so I have to do the job right, of course...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(*Sigh* Looks like she has forgotten everything I taught her to say...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290116,
					"content": "By the way, since we're all here...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290117,
					"content": "(No! We had such a good vibe going, Boss! Please just give me a break, Boss!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Mr. Sarin, would you please bring over the latest batch of commissions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, pick the commission you believe matters the most.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290120,
					"content": "I want you to think this over carefully, so take your time, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290121,
					"content": "Okay... Yes, Boss...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(Ugh!!! I'm DOOMED!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
