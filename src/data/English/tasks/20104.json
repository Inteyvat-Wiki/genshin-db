			"dialogs": [
				{
					"id": 201040301,
					"content": "What did you go and do that for!? You've burned down the haystack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040302,
					"content": "Gee thanks... now Adelinde's gonna freak out for sure — and on top of that, she's definitely gonna fire us too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040303,
					"content": "It was an accident...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "Ugh, we should've just kept on picking them out one by one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040305,
					"content": "Darn it... There's no way back from this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040306,
					"content": "I, ah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "Traveler, you'd better get outta here. This was our responsibility.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040308,
					"content": "It's our fault for getting someone to help who doesn't know a thing about cleaning.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040309,
					"content": "What is Adelinde gonna do when she finds out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040310,
					"content": "She's gonna be so mad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
