				"objectNames": [
					"Moco"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "What're we gonna do!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040102,
					"content": "Adelinde is totally gonna freak out...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040103,
					"content": "What's up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "So, Adelinde asked us to tidy up the area around the Winery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040105,
					"content": "Most places were fine, but there are all these haystacks lying around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040106,
					"content": "Connor said he's storing them here because he needs them for something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040107,
					"content": "They're bound pretty tight, so at least they didn't get blown away in the wind. But still, a load of leaves got blown in among the hay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040108,
					"content": "We worked really hard at it, but we still didn't manage to get all the leaves out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040109,
					"content": "If we keep on at this pace, the head housemaid Adelinde is gonna freak out... What're we gonna do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040110,
					"content": "Allow me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "Seriously? You're awesome! Thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040112,
					"content": "So, the leaves are hard to get rid of?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "When they're mixed in with the hay they sure are. We have to pick them out one by one, which takes forever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040114,
					"content": "If you've got a better idea, I'm all ears!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
		{
			"id": 2010402,
			"completionStepIds": [
				2010404
			],
