				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10039301,
					"content": "Tell me about your husband.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039302
					]
				},
				{
					"id": 10039302,
					"content": "Over there. He's the innkeeper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039303
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039303,
					"content": "Don't be led astray by the cheeky grin on his face. He is a rather formidable martial artist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039304,
					"content": "I also practice martial arts, as do the kitchen staff. It is a hiring requirement.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039305
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039305,
					"content": "You have to have nimble use of your hands and feet when you're serving guests, don't you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 100394,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
