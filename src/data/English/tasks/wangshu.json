					"nextDialogs": [
						10030308
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10030308,
					"content": "Mortal souls are not as robust as those of adepti, nor can your blood carry this level of adeptal energy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030309
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10030309,
					"content": "It's for your own good. Leave. Now.",
