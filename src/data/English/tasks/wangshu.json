			},
			"dialogs": [
				{
					"id": 10039401,
					"content": "Who are you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039402
					]
				},
				{
					"id": 10039402,
					"content": "My name is Goldet and I come from Mondstadt. I am the boss here at the Wangshu Inn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039403,
					"content": "Lest you think I was the boss' wife.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039404,
					"content": "I'm the boss, with a capital \"B-O-S-S.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039405,
						10039410
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039405,
					"content": "I've heard the rumors...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "Hahaha, well I'd hardly be able to operate an inn in this location without connections with the Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039407,
					"content": "What I mean is I obviously need their approval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039408,
					"content": "All that other nonsense is just rumors, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039409,
					"content": "Speaking of which, have you got any interesting news to share?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039410,
					"content": "Whose is this kitty?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039411
					]
				},
				{
					"id": 10039411,
					"content": "*sigh* ...This cat invited itself here... But it's cute, so I let it stay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039412,
					"content": "Its name is Wei. That was quite simply the first name we thought of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039413,
					"content": "You might find Wei causes a bit of mischief — you know what cats are like. But please refrain from stooping to the same level yourself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
