					"id": 10031701,
					"content": "...You two again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031702
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031702,
					"content": "Wait! Don't go disappearing again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031703,
					"content": "What's this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031704
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031704,
					"content": "It's your favorite, Almond Tofu! As well as this distant traveler's best dish — a Satisfying Salad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031705,
					"content": "#{NICKNAME}! Quick! Tell him everything before he finishes eating!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031706,
					"content": "Rex Lapis... How could this be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031707
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031707,
					"content": "I... can't imagine it. Though times have changed, I've never imagined a Liyue without him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031708
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031708,
					"content": "The ruling Qixing... Just what role have they played in this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031709
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031709,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031710
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031710,
					"content": "I will seek Moon Carver, Mountain Shaper, and Cloud Retainer. It is time they too made their decisions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031711,
						10031712
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031711,
					"content": "Will the adepti take over his role in Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031713
					]
				},
				{
					"id": 10031713,
					"content": "Adepti do not turn on their responsibilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031714
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031714,
					"content": "I have my reasons to not want to be tainted by the mortal realm, but... responsibilities are responsibilities.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031715
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031715,
					"content": "Our god is the God of Contracts after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031716
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031716,
					"content": "Wait! Paimon still has one last question.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031717,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031718
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031718,
					"content": "That... Dusky Ming. She's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031719,
					"content": "When conquering demons, on occasion, you can come across spirits who have never hurt anyone, yet are also not yet able to be moved on.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031720
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031720,
					"content": "So I asked the innkeeper and the boss if they could keep her here for a time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031721
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10031721,
					"content": "So really, Wangshu Inn was looking after her! Really keeping a wide range of business going, huh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031712,
					"content": "Will the adepti interrogate the Qixing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031713
					]
				}
			]
		},
