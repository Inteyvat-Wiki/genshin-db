				},
				{
					"id": 10031602,
					"content": "Wow... You really are something...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031603
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10031603,
					"content": "I am in your debt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031604
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10031604,
