			"dialogs": [
				{
					"id": 10031001,
					"content": "Hehe... Scared of something so insignificant. Hard to believe he was once a notorious bandit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031002
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031002,
					"content": "You don't seem that afraid of ghosts, boss lady.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031003,
					"content": "Gods and ghosts, I've seen it all before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031004
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031004,
					"content": "Come to think of it, others don't seem to know there's an adeptus here at the inn, except for the boss lady...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031005,
					"content": "Shh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031006
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031006,
					"content": "Say any more and you'll be divulging my little secret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031007
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031007,
					"content": "Right. Best you two be off. Go see to it that little ghost doesn't go scaring anybody else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031008
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031008,
					"content": "Not that I'm ordering you around. It's like the adeptus said, mortal souls are not as robust as those of the adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031009
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031009,
					"content": "So as to not be harmed when dealing with the adepti, you can start by practicing with that ghost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031010,
						10031012
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031010,
					"content": "Sounds good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031011
					]
				},
				{
					"id": 10031011,
					"content": "But how should we persuade the ghost?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031013,
					"content": "There is a calligraphy painting in the inn known as the Witness Sigil. It's been in circulation for over a thousand years. Go take a look at it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031014
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031014,
					"content": "Once you have, look for a place outside where you can see the exact same Witness Sigil formation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031012,
					"content": "But how should we persuade the ghost?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031013
					]
				}
			]
