				"objectNames": [
					"Smiley Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030601,
					"content": "Can't you see I'm on a break kid? Scram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030602,
					"content": "Excuse me, we'd like an Almond To—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Scram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030604,
					"content": "Whoa, this chef guy's service is about as good as that Wagner guy's back in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030605,
					"content": "It's for the boss, Goldet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030607,
					"content": "I see. If it's for the boss, then guess I don't have a choice now, do I?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030608,
					"content": "But my heart's not really in it right now, not enough to make a dessert as painstaking as Almond Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030609,
					"content": "And why is that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030610,
					"content": "A fencer's hand must be steady, so too must the hand of a chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030611,
					"content": "But my hands, I'm... they're not steady...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030612,
					"content": "Because ahh, a traveler once told me that this inn... is haunted.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030613,
					"content": "And then, just now — just now! In the kitchen... I saw something... something not right.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030614,
					"content": "(This chef looks so intimidating, but speak of ghosts and he becomes weak.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030615,
					"content": "I keep thinking... even Wangshu Inn isn't safe. I—I can't keep a steady hand for something like Almond Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030616,
					"content": "#Alright {NICKNAME}. In the name of high-quality Almond Tofu, we need to go check this kitchen out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
