						10030903
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 10030903,
					"content": "Okay, so he's useless now. What do we do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030904
					],
					"speakerTitle": "Paimon"
