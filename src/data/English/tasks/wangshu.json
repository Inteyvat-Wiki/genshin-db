						10030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030311,
					"content": "Argh! Paimon's... peeved! All he does is think about himself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030312,
					"content": "Paimon wants to give him an ugly nickname... but if you tick off an adeptus, the only thing you'll probably ever find in treasure chests is cabbages! Bleurgh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030313
					],
					"speakerTitle": "Paimon"
				},
				{
