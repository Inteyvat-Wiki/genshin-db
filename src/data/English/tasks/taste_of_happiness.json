				"points": []
			},
			"dialogs": [
				{
					"id": 730390101,
					"content": "My brothers have all done some self-reflection. Festival Utsava is a happy occasion, so Arapacati shouldn't get mad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "That's right, Arapacati. Don't get mad. Happy occasions should be celebrated with the \"taste of happiness\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "It's time to show off the results of our cooking training!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "I have been ready for a long while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730390105,
					"content": "Yay, it's the Festival Utsava Feast! Paimon's been waiting for this!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "Alright! The Festival Utsava Feast!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "Water from Vanarana is the best water and makes the best soup. Nara will love it for sure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#I shall deliver the \"taste of happiness\" to Nara {NICKNAME} and Paimon, and let them \"teach\" my brothers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "It's the only way to make food Nara will like. That's how guests should be treated.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Would you mind teaching them to cook, Nara {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
					"content": "Best we not get our hopes too high...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
		},
