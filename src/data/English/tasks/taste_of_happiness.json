				"points": []
			},
			"dialogs": [
				{
					"id": 730391101,
					"content": "Woohoo! And that's our piping-hot Radish Veggie Soup all ready to go! The Aranara should be done with their dishes too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7303912,
			"completionStepIds": [
				7303908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303908",
							"2"
						],
						"stepId": 7303908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapacati",
					"Arachatora",
					"Arasaka",
					"Arapas",
					"Araphala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#You still have to ask {NICKNAME} to help, or you will end up cooking the same dishes as before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391201,
					"content": "According to the improvement method from Paimon, Aranara finishes the dish under your guidance.\\nAfter that, you enjoy the dish with Aranara...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "How's the taste of true-blue gourmet Nara food, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391203,
					"content": "#Hmm... While it was Arapacati's suggestion for Nara {NICKNAME} to teach my brothers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391204,
					"content": "Nara dishes... Is this what Nara call \"the taste of happiness\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391205,
					"content": "Happiness is fleeing from me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730391206,
					"content": "Vanarana's water is obviously the Best Water, so how did something like this get made from it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730391207,
					"content": "The Unrivaled Fresh Fruit is still delicious, though. Yum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730391208,
					"content": "Eh? You Aranara think it's awful? Paimon thought it was pretty yummy, though...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391209,
					"content": "I have no idea how \"awful\" is supposed to taste, but the flavor of this dish... has \"impact.\" You know, like the kind you get from running full-speed into a tree...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391210,
					"content": "Wow... This has gotta be a massive case of culture clash.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391211,
					"content": "#Still, it's rude to say that, my brothers. You should be thanking Nara {NICKNAME} instead!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391212,
					"content": "*whimper* I'm sorry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391213,
					"content": "Don't say \"sorry\"! Say \"Thank you!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391214,
					"content": "#Thank you, Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391215,
					"content": "#But it's okay as long as Nara {NICKNAME} and Paimon enjoy the food! Don't mind them. If our Nara friends are happy, we're happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391216,
					"content": "#That said, Nara {NICKNAME} is totally different from Nara Varuna, who told us a lot of things about \"{M#brothers}{F#sisters}.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391217,
					"content": "#But Nara {NICKNAME} is very quiet. Are you feeling unwell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391218,
					"content": "#Uh, say something, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391219,
					"content": "Thanks for your concern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "#Is that so? I'm glad. Once again, thank you. These petals are from Arapacati and her brothers. They're for you, Nara {NICKNAME} and Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391223,
					"content": "We hope the two of you will enjoy more of the \"taste of happiness\" here in Vanarana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391220,
					"content": "(Remain silent.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#Anyway, no need to worry, Arapacati! {NICKNAME}'s fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "Paimon"
				}
			]
		},
