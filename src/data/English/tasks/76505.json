			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME}? Paimon? What are the chances? I heard you'd gone to Nod-Krai, but I didn't think we'd meet up again so soon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "Yeah! Paimon thought she was seeing things, too! Why're you so far from home, Varesa? Are you traveling as well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Hehe, you could say that! I'm here to buy a batch of agricultural machinery for our orchard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Dad says that Nod-Krai's got some good stuff that can make our fruit grow better and save me some effort. Y'know, so I'll have more time to sleep... uh, and work out, of course!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "And when I got here, I found sooo much delicious stuff you can't find in Natlan! So apart from official business, I've been spending most of my time feasting!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "...Honestly, now that it's almost time to leave, I don't quite want to...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "So I'm going to walk around while I still can — I'll try everything I haven't tried, and see everything I haven't seen yet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#What about you? Let me guess... Our hero, {NICKNAME}, is out defending justice in a new land. Am I right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "We're just looking around at the moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "Ooh, I get that too! Getting to a new place means having loads of new stuff to see — just makes you want to get it all on Kamera, doesn't it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "Speaking of which... Agh! I should be taking more photos of the awesome grub I've been having, too!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "That way, I might be able to get Uncle Atolli to recreate those dishes via the pictures once I'm back home!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "And who knows, a career in food photography might await you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "Ehe, you think so? Me, a food photographer... That sounds awesome, to be honest! Coming into contact with great food every day, then taking pictures of them at their best and most mouth-watering...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "But before you go take pictures of delicious food...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "Eh? You wanna take a picture of me? You really wanna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "H—Hang on. My hair's not all messy, is it? Do I still have sauce around my mouth? Ohh, if I knew I'd meet you here, I'd have put on some of the accessories I bought at the market yesterday!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "You're great just as you are!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "Okay! I—I'll leave it up to you, then!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Your happy face is more than good enough for a photo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "Could we take a picture of you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "And looking for some photo-op material while we're at it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
