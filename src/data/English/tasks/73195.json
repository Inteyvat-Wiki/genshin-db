				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "\"I've been to many nations and watched countless performances. There isn't a shred of doubt in me that Nilou is the best dancer in Teyvat. But not only were the pedants from the Akademiya unable to appreciate her performance, they even complained about it! What an insult to art!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951102,
					"content": "\"Based on my experience in Mondstadt, we should organize a fan club for Nilou. Then those people who don't know anything about art wouldn't dare to insult her again.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951103,
					"content": "\"A fan club... Is that a part of Mondstadt's culture? Anyway... A perfect performance is a joint effort of everyone in the troupe. Placing all the attention on a single person is just not fair.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951104,
					"content": "\"Moreover, I believe that art itself is a bond that brings people together. I'm very happy that you enjoyed Nilou's performance.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951105,
					"content": "\"Based on that elegant handwriting, you must be a young lady, right? It's so good to know that there's someone else who enjoys watching dance performances. May I ask if you would like to have a cup of coffee together sometime?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951106,
					"content": "\"Sorry, I'm very busy. Please speak to my manager if you need any help.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951107,
					"content": "\"Looks like this guy got rejected. The final message is clearly written by a tough man... he's probably the bodyguard of a rich lady or something.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
