				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950101,
					"content": "This Bulletin Board is set up by Vizier to publicize important matters in Sumeru City. Questions or doubts regarding the notices on the Bulletin Board can be posted here as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "\"Notice: We are looking for experts to deal with Rishboland Tigers\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950202,
					"content": "The message of the notice is blotted with a paintbrush. Beside it is a sentence in slanting, childish handwriting...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950203,
					"content": "\"Rishboland Raja just wanted to play with people!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "\"If you see dancing fairies after consuming mushrooms, please do not be alarmed. It is a normal reaction.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950302,
					"content": "\"But if the plants around you are starting to speak, please seek help from the nearest Forest Ranger immediately.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "\"Due to unknown reasons, The Withering has been showing signs of expansion in both quantity and size throughout the forest.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950402,
					"content": "\"Not only does The Withering cause vegetation in the area to wilt, it may also be lethal to wildlife and even humans. The Forest Watchers have set up Contamination Zones to mark the area under the influence of The Withering. Please stay away from such areas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950403,
					"content": "\"If you notice a new patch of The Withering in the forest, please contact a nearby Forest Ranger to have it handled professionally.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "The matra have discovered multiple cases of illegal Canned Knowledge trade during recent inspections in local bazaars.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950502,
					"content": "Trading of Canned Knowledge is prohibited by the Akademiya and will be severely punished upon discovery.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950503,
					"content": "The Akademiya will not be held responsible for any consequences of illegal usage of Canned Knowledge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "\"The annual Sabzeruz Festival is just around the corner. A grand festival will be held in the Grand Bazaar same as last year.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950602,
					"content": "\"To heat up the festive ambiance, our lady has prepared a special subsidy for all participating merchants.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950603,
					"content": "\"Let's celebrate Lesser Lord Kusanali's birthday together!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "\"Our lady left home and still hasn't returned. If you see a young girl with brown hair wearing a blue and purple dress, please contact the Homayani family. You will be duly thanked for your help!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950702,
					"content": "\"If our lady herself sees this poster, please contact us immediately. Your parents are very worried about you.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "\"He's back! My Lord, Al-Ahmar, is back!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950802,
					"content": "\"The day he returns will be the day of retribution for all you leaf-heads!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950803,
					"content": "This is fake news, and we are currently investigating its source. All matters in Sumeru are posted regularly in the Akasha. Please do not trust any rumors.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "\"My friend, are you troubled by anything? Look no further! The Almighty Lord Sangemah Bay is here to give you all the answers you seek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950902,
					"content": "\"All it costs is a little Mora, and all your problems will be resolved in no time.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950903,
					"content": "\"Take action before it's too late! Contact information...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731950904,
					"content": "This Bulletin Board is set up by Sir Vizier to regulate market transactions. Please do not post any advertisements here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319510,
			"completionStepIds": [
				7319510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319510",
							"2"
						],
						"stepId": 7319510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "\"Does anyone know where to find an excellent storyteller? It has to be someone who can tell a story exactly as it is.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951002,
					"content": "\"I'm being haunted by a terrifying Jinni. It's threatening to kill me if I don't tell it the exact same story every day. It's been a month now, and my brain is turning to mush from this torture...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951003,
					"content": "\"What a strange experience. But I've heard of a storyteller called Maddah in Puspa Café. He might be able to help you.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
