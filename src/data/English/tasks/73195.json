			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "\"Magic bottles for sale. Magic bottles that can harness the power of spirits. Please leave your payment here. Grants any wish, only one Mora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951202,
					"content": "\"Magic bottles for sale. Magic bottles that grant any wishes. The price is only one Mora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951203,
					"content": "\"I'm a Jinni. Just give me one Mora and I'll grant any wish of yours.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951204,
					"content": "\"The Citadel of Regzar is investigating the recent string of scams. Please do not panic.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951205,
					"content": "\"Any victims who have further questions may seek consultation for just one Mora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
