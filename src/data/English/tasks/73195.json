			"dialogs": [
				{
					"id": 731951501,
					"content": "If you encounter anyone with a blank gaze or muttering to themselves in the forest, they are researchers in Satyavada Life. Please do not disturb them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951502,
					"content": "If they cause any concern, please report it to the Mahamata for proper handling of the matter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
