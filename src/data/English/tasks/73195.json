			"dialogs": [
				{
					"id": 731951601,
					"content": "\"I heard that Diwan used to be an organization that spoke out for us downtown commoners, but now it just obeys whatever the Mahamata say.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951602,
					"content": "\"Vizier too. That man never keeps his word. He's only there when the Mahamata tries to shed responsibility.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951603,
					"content": "The Akademiya's guidance to all administrative bodies is based on the guidance of Greater Lord Rukkhadevata. Please refrain from slander.",
