			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "\"I hired a pretty decent mercenary a while ago. I think she's called Flame-Mane or something...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951402,
					"content": "\"I brought her along with me each time I went out to the sea for business. Doesn't matter if it's Treasure Hoarders or the Millelith — with her by my side, there was nothing to fear. I made a fortune all thanks to her.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951403,
					"content": "\"But I don't think I've seen her accepting any commissions lately, and I heard monsters have increased in number on the path to Liyue... I may have to put my money in the Kalimi Exchange if this goes on.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951404,
					"content": "\"You don't sound like someone who does legit business... But if it's the Flame-Mane, I heard that she's been hired by the Homayani family. You're gonna have to wait quite a while before she's available again.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951405,
					"content": "\"And a word of advice, your money will be better spent buying 100 carpets than investing in the Kalimi Exchange!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Bulletin Board"
				},
				{
					"id": 731951406,
					"content": "\"You're absolutely right! Please visit our shop to buy some carpets! I can even explain in detail about how you can use each of them!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulletin Board"
				}
			]
		},
