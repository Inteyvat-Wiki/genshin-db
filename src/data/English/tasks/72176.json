				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kid Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "Eh, is it too hard for you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760203,
					"content": "That's because Paimon was just warming up!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "#{F#Big sis}{M#Big bro}, do you want to try again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760205,
					"content": "#Of course! {NICKNAME}, we need to show Kid Kujirai how good we are!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "One more try!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "Woohoo! The goal is to find the Temari within the time limit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kid Kujirai"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kid Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#{F#Big sis}{M#Big bro} is amazing, you found it right away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Hoho, {NICKNAME} is a seasoned traveler who has been to many nations.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "Wow! Have you also been to Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760705,
					"content": "Certainly have.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "That's so cool! I heard from that Big Sister that there are many beautiful places in Mondstadt, like Stormterror's Ruins with super-duper tall towers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760707,
					"content": "It's Stormterror's Lair.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Yup! I wonder if that tower is taller, or if the Almighty Shogun's Tenshukaku is taller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760710,
					"content": "Kid Kujirai, why are you out alone in the wild?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Because when my sister was fishing, she thought I would scare the fish away, so she let me go out to play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760712,
					"content": "Once, I met that Big Sister who was an adventurer. She saw that I was bored, so she gave me a lot of Temari, and told me to \"find greedy travelers to play with.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760713,
					"content": "Greedy travelers...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "We're not greedy! We're worried! Paimon's worried that you might be bored playing by yourself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "#That's right, I think {F#big sis}{M#big bro} is really nice, I'm so happy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760716,
					"content": "Alone in the wilderness...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "You're a kid alone in the wild, aren't you afraid of running into danger? And you even have \"good stuff\" on you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "#You're really kind, {F#big sis}{M#big bro}. Don't worry, that Big Sister adventurer taught me. As long as I do something to it, the Temari can turn into a bomb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760719,
					"content": "Eek, that's so dangerous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "It's not! I've blasted away a lot of bad guys, like hilichurls and slimes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760721,
					"content": "You're the dangerous one!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "#Oh yes, {F#big sis}{M#big bro}, if you want to play a game of Temari with other friends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760723,
					"content": "I'll leave a Temari here! Here are the rules...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760724,
					"content": "When you hide a Temari, you have to hide it within the time of a Temari song. The person who is looking for it will also find it within a song's time. That will make things fair!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760725,
					"content": "Got it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "It's so scary to think that we're actually playing with bombs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "#Don't be scared, {F#big sis}{M#big bro}. Big Sister adventurer told me \"Only the bad guys will be bombed. Probably.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760728,
					"content": "\"Probably!?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "#I'm off to play somewhere else! Bye-bye, {F#big sis}{M#big bro}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kid Kujirai"
				},
				{
					"id": 721760708,
					"content": "Is that so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}