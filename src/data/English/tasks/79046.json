						],
						"stepId": 7904612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "The speaker continues to describe the strange scene in front of you—\\nThe two wise sages slowly drop the remedy onto the petrified body of the Hydro Eidolon, and a strange phenomenon begins to occur...\\nAs though time were flowing backward, the petrified Hydro Eidolon begins to return to normal...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "*sob* ...So that is how it feels to be turned to stone... The pain, the agony! I cannot let my friends suffer this fate any longer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790461103,
					"content": "Water Droplet, how could you just charge ahead like that without saying anything!? You scared Paimon half to death! It's a good thing we got the remedy so quickly...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461104,
					"content": "That ghost was so scary, I was so terrified I couldn't even speak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790461105,
					"content": "Also, you are so wise that I think you don't even need me to remind you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790461106,
					"content": "Even if I turned completely into a stone, I knew you guys would save me right after you got the remedy, and things would be just like before! So there was no real need to worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790461107,
					"content": "Huh... uh, did Paimon get too invested in the play? Paimon was just so worried about the Water Droplet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461108,
					"content": "It's good to dive into your role.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "Eh... Paimon is a guest who's here to have fun, but she let the acting get to her head... It's a little embarrassing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461111,
					"content": "But anyway, we succeeded! Now you can take the remedy and save your friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461112,
					"content": "Thank you, thank you! I... I'm forever indebted to you for all that you've done!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790461113,
					"content": "My companions and I will always remember your kindness in our hearts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790461114,
					"content": "It's nothing!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "Paimon hopes those ghosts won't cause any more trouble...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461117,
					"content": "Whenever you guys play in the forest, you'll have to be more careful! No more coming to this castle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461118,
					"content": "Congratulations, congratulations! The impeccable plans and stratagems of the wise sages and the bravery of the Hydro Eidolons has become a perfect partnership, and the curse of the ghosts will soon be completely lifted!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790461119,
					"content": "After the timely arrival of the wise sages, the ghosts will never again be so reckless. The lonely Hydro Eidolon and its friends can now play again, without fear or worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790461120,
					"content": "The dense, eerie forest is now gradually showing its peaceful, quiet side...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790461121,
					"content": "Thus ends \"Petrifying Gaze,\" thank you for watching!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790461122,
					"content": "Hooray, we finished \"Petrifying Gaze\"! Paimon really got into it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461123,
					"content": "Hmm... the combination of lines on the stage and narration by the speaker does a great job of working the audience! Paimon wonders where Daiya learned to do that...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461124,
					"content": "If we get a chance, we should definitely ask her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461115,
					"content": "No need to be so polite!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "It means Paimon's having fun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
		},
