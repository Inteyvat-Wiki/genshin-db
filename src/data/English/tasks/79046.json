			},
			"dialogs": [
				{
					"id": 790460101,
					"content": "All actors and actresses have arrived, and all stage mechanisms are operating normally.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790460102,
					"content": "This performance of \"Petrifying Gaze,\" a play from \"Daiya's Three-Day Reverie,\" will now begin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "Park Announcement Speaker"
				},
				{
					"id": 790460103,
					"content": "On the edge of a thick and eerie forest, two wise and learned sages happen upon a Hydro Eidolon, wandering alone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790460104,
					"content": "Please, help me... someone help me! I don't want to abandon my friends...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460105,
					"content": "Water Droplet!? Wait, did the Water Droplet talk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460106,
					"content": "It's actually the sound of the speaker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "Oh, so this Water Droplet is actually a main character in this play, and we have to act along with it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460109,
					"content": "It is truly fortunate that these two wise sages have already researched the language of Hydro Eidolons in depth, and can understand its plea for help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790460110,
					"content": "This must be a fated encounter! Such a portentous meeting, could you even entertain the notion of not assisting this Hydro Eidolon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790460111,
					"content": "Wow! We have our own characters too? That's really cool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460112,
					"content": "Let's get back on topic.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "We... while we were lost in the woods, we happened upon an ancient castle and accidentally awoke the evil spirits slumbering within...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460115,
					"content": "Two of their leaders, they... they laid curses upon us! Now, the moment a ghost sees us, we... we turn to stone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460116,
					"content": "I barely managed to escape, but my companions...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460117,
					"content": "*sob* ...They must be in such pain... Is this our fault?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460118,
					"content": "Of course not! Even if those ghosts got up on the wrong side of the bed, that's no excuse to be bullies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460119,
					"content": "Those jerks! Turning lost Water Droplets into stone... that's even worse than bullying! Those ghosts are all super bad guys!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460120,
					"content": "If we teach them a lesson they won't soon forget...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "No, the two ghost leaders never show themselves, and the castle is vast... even the strongest and most capable person could never find them...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460123,
					"content": "But I heard one of the ghosts say that deep within the castle is a chest, and that chest contains an ancient hex-cleansing remedy. That is the only hope...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460124,
					"content": "The chest is locked inside a secret chamber, and you must first find the hidden key.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460125,
					"content": "But... I've already been cursed, and if I go back alone, I'll certainly be seen by the ghosts... then I'll be turned to stone and trapped forever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460126,
					"content": "That sounds easy! We'll escort you there, find the key, and get that remedy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460127,
					"content": "As long as you avoid those... ghosts' gaze, you'll be fine, right? It'll be a walk in the park!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460128,
					"content": "That's right, you are both... wise sages, and you must certainly know what to do... Please, I'm begging you...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "Lone Hydro Eidolon"
				},
				{
					"id": 790460129,
					"content": "Paimon sure got into character quickly.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "Hehe, it sounds pretty straightforward.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460132,
					"content": "Even if we can't beat up the mastermind, taking down the ghosts and saving the Water Droplet's companions should be a piece of cake for you, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460133,
					"content": "C'mon, little Water Droplet, let's go find that remedy, lift your curse, and save your friends!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460130,
					"content": "You guessed exactly where the plot was going.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "...Can we save your companions?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "What happened to your companions?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "Just treat it like the Water Droplet's lines.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
		{
