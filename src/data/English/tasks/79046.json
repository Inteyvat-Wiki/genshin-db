			"dialogs": [
				{
					"id": 790460901,
					"content": "Though, if a Water Droplet has turned to stone, can it still drink a potion? And how does water even drink water...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460902,
					"content": "Oh! Maybe this remedy is the kind you rub on! Let's try it out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7904610,
			"completionStepIds": [
				7904610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904610",
							"2"
						],
						"stepId": 7904610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "Ugh! It's impossible to avoid their line of sight! This is just cheating!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461002,
					"content": "Paimon just wants to kick those ghost mechanisms right over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461003,
					"content": "Hey, wait, Water Droplet! What are you doing! There's ghosts there, it's dangerous!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461004,
					"content": "Insolent beings, have you gone insane? Or have you abandoned all hope, and simply wish to see your friends in the next world?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "Angry Wraith Leader"
				},
				{
					"id": 790461005,
					"content": "Oh no! It used its body to block their gaze... why does it have such a noble spirit of self-sacrifice!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "Happy Wraith Leader"
				},
				{
					"id": 790461006,
					"content": "A sudden twist! The lonely Hydro Eidolon has thrown itself in front the ghost's vision, using its body to block the fatal gaze, and is slowly turning to stone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790461007,
					"content": "The Water Droplet turned to stone... just so we could get the key...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461008,
					"content": "The Water Droplet can still be saved!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "Oh, right! That's right! As long as we aren't in their line of sight too long, we should be okay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461011,
					"content": "Did the Water Droplet figure that out? It's so smart and brave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}, let's find the key and get the remedy, fast! We can't let the Water Droplet suffer too long!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461009,
					"content": "We have to hurry!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904612",
