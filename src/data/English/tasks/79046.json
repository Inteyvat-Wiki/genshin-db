			"dialogs": [
				{
					"id": 790461301,
					"content": "The two sages watch the poor Hydro Eidolon slowly turn into unfeeling stone before their very eyes, and it no longer responds to their anguished calls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461302
					],
					"speakerTitle": "Narrator On Speaker"
				},
				{
					"id": 790461302,
					"content": "But this was not in vain! For it was only so willing to sacrifice itself, because it believed in the two sages from the bottom of its heart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narrator On Speaker"
