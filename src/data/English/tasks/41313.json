			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "What now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130802,
					"content": "We'd like you to come to Lantern Rite with us.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "...We've had the talk about crowded places. Do not make me repeat myself. Best you go alone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130804,
					"content": "I didn't say you have to go to Liyue Harbor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "...What is that supposed to mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130806,
					"content": "You wouldn't go to the festival, so we brought the festival to you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "You \"brought the festival to me\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130808,
					"content": "Okay, so there's a bunch of delicious snacks just laid out below the inn, and a bunch of Xiao lanterns, and there's practically no one else around to have to worry about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130809,
					"content": "There's even Almond Tofu and Grilled Tiger Fish...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "Better hurry up or the food's gonna go cold. Come on down!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
						],
						"stepId": 4131314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "Ta-da! Your very own, miniature Lantern Rite festival! Well if it doesn't look mouth-watering...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130902,
					"content": "So this is what you meant by bringing the festival to me... *sigh* Is there no end to the peculiarities of human behavior?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130903,
					"content": "Does it serve any grander purpose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130904,
					"content": "This way you can take part in Lantern Rite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "...Is that so? Hmph, human motives defy my attempts to fathom them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130907,
					"content": "Less fathoming, more eating! Come on, dig in, before it gets cold!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130908,
					"content": "Mmm-mmm, okay, Paimon's gonna concentrate on eating now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130909,
					"content": "Ahh... Now that we're done with the most important part of the celebration, we should be heading out to see the Mingxiao Lantern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130910,
					"content": "Come with us, Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "You may take your leave. There's nothing for me over there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130912,
					"content": "You might as well keep us company on the way there.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "Yeah, the Mingxiao Lantern may not be your thing, but... surely, there's no harm in taking a walk with us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130915,
					"content": "The road from here to Liyue Harbor is long and full of dangers... We need someone to ensure our safety!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130916,
					"content": "Nobody says you have to enter the city... You can just see us off at the outskirts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130918,
					"content": "...Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130919,
					"content": "So be it. I shall accept your proposal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130920,
					"content": "There you go! Alright, time to hit the road!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130913,
					"content": "O Vigilant Yaksha, please escort us safely to the city.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "Lantern Rite is meant to include everyone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
		{
			"id": 4131311,
			"completionStepIds": [
				4131311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131311",
							"2"
						],
						"stepId": 4131311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413131101,
					"content": "This is as far as I will go. Please see yourselves into the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131102,
						413131104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131102,
					"content": "Wait a second.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131103
					]
				},
				{
					"id": 413131103,
					"content": "What now?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131105
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131105,
					"content": "You are obviously one of the heroes this festival is all about... Why don't you want to get involved?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131106,
					"content": "I... detest the rabble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131107
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131107,
					"content": "No cares in the world, so peaceful, so joyful... They are nothing like me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131108
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131108,
					"content": "Too long have I spent slaughtering, accompanied by the burden of suffering that follows in its wake. Crossing paths with all those jubilant people will only make me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131109,
					"content": "...That's all I have to say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131110,
					"content": "Farewell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131111
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131111,
					"content": "Are you sure you don't want to go with us?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131112
					]
				},
				{
					"id": 413131112,
					"content": "Are you really so enamored with such trivial amusements?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131113,
					"content": "What do you think?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131114
					]
				},
				{
					"id": 413131114,
					"content": "Hey! This is a legitimate festival, not some trivial amusement!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131115,
					"content": "...Legitimate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131116
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131116,
					"content": "Enough. Go watch your lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131117
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131117,
					"content": "But stay vigilant. Keep your eyes open for any menace. If you find yourself in trouble... speak my name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131118
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131118,
					"content": "Sure you'd make it into the city in time to come to the rescue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131119
					]
				},
				{
					"id": 413131119,
					"content": "Anywhere. Anytime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131120
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131120,
					"content": "Whether yours or Liyue's, I hear all cries for help, all prayers for peace, and all the wishes carried by the lanterns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131104,
					"content": "(...Never mind, he can see it from here.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131105
					]
				}
			]
		},
