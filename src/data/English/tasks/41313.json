			"dialogs": [
				{
					"id": 413135201,
					"content": "Heh, Smiley Yanxiao's no run-of-the-mill chef, huh? Oh, you should visit the city after our meal. You'll just make it in time to see the Mingxiao Lantern being released.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413135202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413135202,
					"content": "I can't believe you managed to talk him into dining with us. That's a first! And I've known him for years...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
