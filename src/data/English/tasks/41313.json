			"trigger": {
				"objectNames": [
					"Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "So, is the matter resolved?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130202,
					"content": "We took care of it, but—",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "—Good.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130204,
					"content": "Are you really not going to see the Mingxiao Lantern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "No. As I said, I am not partial to crowded areas. Especially at this time of the year.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130206,
					"content": "The Mingxiao Lantern this year is Skybracer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "Yeah, it's a super impressive-looking giant deer, let's go take a look together!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130208,
					"content": "\"Skybracer...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130209,
					"content": "Huh, a Mingxiao Lantern nonetheless. A fleeting creation of human hand. It means nothing to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130210,
					"content": "If this short-lived spectacle is one you wish to witness, I suggest you go to the city.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131303",
							"2"
						],
						"stepId": 4131303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "Sounds like you and Xiao took care of business again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130302,
					"content": "Word certainly got around, the news even reached us here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130303,
					"content": "*sigh* And yet, another year's Lantern Rite will soon be over, and he still won't go and take a look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130304,
					"content": "*sigh* ...All these long years and I've never seen him attend the Lantern Rite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130305,
					"content": "I'd go as far as to say, it'd be easier bringing the festival to him than the other way around...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130306,
					"content": "Bring the festival to him... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130307,
					"content": "Nice idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "Yeah! If Xiao won't go to the Lantern Rite, then let's bring the Lantern Rite to him!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130309,
					"content": "...Sorry? Surely you realize I was joking... How would you \"bring the Lantern Rite to him,\" exactly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130310,
					"content": "When we were in the city checking out the festivities, we learned how to make Xiao Lanterns. We even found a food stall serving local delicacies...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130311,
					"content": "So much tasty food, so many pretty Xiao lanterns, not to mention... um... what else... Oh, the bygone heroes, his old friends.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130312,
					"content": "Aren't those the heart and soul of the Lantern Rite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130313,
					"content": "You're not wrong, but where would we set all that up...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130314,
					"content": "Now that you mention it, I wonder... We'd need enough space to set up our own stall. Hmm... There might just be enough room <color=#00E1FFFF>below the inn</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130315,
					"content": "Let's take a look and choose a space. I believe I know the kind of stall you're after...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130316,
					"content": "Hmm, there should be a few styles we can reference, let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131307",
							"2"
						],
						"stepId": 4131307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "Here's not too bad... and it's safely away from all the foot traffic. A fitting choice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130702,
					"content": "We've got ourselves a nice spot, now we need to build a proper stall. I've thought about it, and I believe I know roughly how to go about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130703,
					"content": "If you'll excuse me for a moment, I'll try to figure out where to start...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130704,
					"content": "And voila! A little rough around the edges, but it should serve us well. What do you think?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130705,
					"content": "I think you've missed your true calling! Such expert carpentry...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "It was no big deal! Just a little bit of DIY that I picked up years ago. I've forgotten most of it, actually.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130707,
					"content": "Well, we can check the stall off our to-do list. It looks quite festive decorated with that Xiao Lantern, wouldn't you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130708,
					"content": "You know how to make Xiao Lanterns too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "Well yes, but in my generation, it's just the norm for everyone who grew up in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130710,
					"content": "Anyway, speaking of festivities... No celebration is complete without a feast. Do you know what you would like on the menu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130711,
					"content": "Almond Tofu, that's for sure! We've made it for Xiao before.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130712,
					"content": "And Grilled Tiger Fish.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "Almond Tofu and Grilled Tiger Fish, hmm... What an interesting combination of flavors! I'll have a word with Smiley Yanxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130714,
					"content": "He should be able to rustle those up in no time. Luckily, the inn's pantry contains all the necessary ingredients.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130715,
					"content": "Oh, it's about time to summon our honored guest. Could you fetch him? The food should be ready by the time you come down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 4131308,
