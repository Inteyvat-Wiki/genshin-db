			"dialogs": [
				{
					"id": 230260501,
					"content": "Have you been outside the Sumeru City? There are some barriers around the desert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260502
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260502,
					"content": "My question is: what's the name of those barriers?",
					"roleType": "TALK_ROLE_NPC",
