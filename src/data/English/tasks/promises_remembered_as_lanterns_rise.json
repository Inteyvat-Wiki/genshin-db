			},
			"dialogs": [
				{
					"id": 718240301,
					"content": "Well, did you deliver the Xiao Lantern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240302,
					"content": "I guess... we can consider it sent.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "I believe so, too. This should cheer her up a bit at least.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240304,
					"content": "I wonder, what sort of wish would that child make?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
