			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Smiley Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "I have to hurry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718240102,
					"content": "Is business that good?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "No. But it's the Lantern Rite now. Lots of people have headed back to the city to spend the festive period there, so we're short-staffed. I'm basically doing everything myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718240104,
					"content": "We're not getting too many guests, though, so things aren't too bad. I can still handle it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718240105,
					"content": "*cough* Also, I should thank you for helping me previously. If it hadn't been for your help, I don't think I'd ever have been able to return to work...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718240106,
					"content": "Ah. So recently...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "N—No! Definitely not, believe me! I—If she were to show up again, I d—don't know if my heart could take it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718240109,
					"content": "If you really want to ask about... her... you should just go ask the boss. I—I don't know anything, I swear...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Smiley Yanxiao"
				},
				{
					"id": 718240107,
					"content": "So, has she...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
