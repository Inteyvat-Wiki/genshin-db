			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "Traveler! How can I help?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240202,
					"content": "About Dusky Ming...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "Oh, her? She's been quite well-behaved since that incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240204,
					"content": "But I do feel bad for that child. Whenever a festive period rolled along in the past, she'd get lonelier as the inn grew livelier. As a result, she would wind up starting trouble and scaring the guests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240205,
					"content": "But I'm sure that she just wants someone to play with her. She is only a child, after all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240206,
					"content": "Can we send her a Xiao Lantern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "You want to send her a Xiao Lantern? That's not a bad idea. The only trouble is that she's quite hard to find...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240209,
					"content": "If you're looking for her, you should hang a Xiao Lantern atop one of the trees in the nearby forest at night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240210,
					"content": "That way, she should be able to see it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240207,
					"content": "I wonder if she'd like a Xiao Lantern...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
		{
			"id": 7182403,
			"completionStepIds": [
				7182413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
