						760860102
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760860102,
					"content": "Looks like she wants to play Moon Chess again. Let's play with her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760860103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760860103,
					"content": "Ah, it's you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760860104
					],
					"speakerTitle": "The Damselette"
				},
				{
					"id": 760860104,
					"content": "Care for a game of chess?",
