			},
			"dialogs": [
				{
					"id": 790490101,
					"content": "What's a diary doing hidden in the corner like this?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790490102,
					"content": "It turns out that the huge stone slab outside is the one that Idyia gave to the painter as a canvas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790490103,
					"content": "Hmm, it seems not only had he found landscapes he loved in the Veluriyam Mirage, but also made friends with Water Droplets and found some new inspirations for his paintings!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790490104,
					"content": "Quite the fortunate encounter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "Eek! Now that you mention it, Paimon's heard of some people that go nuts after a failure! They just keep trying harder and harder until they lose themselves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "Read"
				},
				{
					"id": 790490107,
					"content": "Thanks to the painting tools Idyia provided and the company of the Water Droplets, he stayed on the right track!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Read"
				},
				{
					"id": 790490105,
					"content": "Better than practicing to the point of obsession...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				}
			]
		},
