				"points": []
			},
			"dialogs": [
				{
					"id": 230270201,
					"content": "Traveler, what a coincidence. We meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270202,
					"content": "Are you still doing your research?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "Yes. Ladep and Pharez requested more data, so here I am, continuing my work.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270204,
					"content": "That said, I wonder how those roots are doing right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270205,
					"content": "Traveler, if you would, please help me record the conditions of the Divine Tree roots once again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
