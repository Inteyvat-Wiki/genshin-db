					"content": "But that means... We passed the trial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100804
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100804,
					"content": "Hehe, yep! Now then, let's check out what's in this box...",
					"roleType": "TALK_ROLE_NPC",
