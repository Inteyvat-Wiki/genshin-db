						100100802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100802,
					"content": "The note implied things wouldn't be that simple. Guess it was because of those monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100803
					],
					"speakerTitle": "Paimon"
				},
				{
