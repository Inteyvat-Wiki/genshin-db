				{
					"id": 100100805,
					"content": "Oh, it's...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100806
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100806,
					"content": "A tiny hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100807,
					"content": "A hat for Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100808
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100808,
					"content": "In the Dodo Clan, only the awesomest and bestest Dodocos in the land can earn the acknowledgment of the Dodo-King!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100809,
					"content": "Their job is to help out and protect all the other Dodocos, so the Dodo-King gives them a special hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100810,
					"content": "That way, the other Dodocos will recognize them and know who they can go to for help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100811
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100811,
					"content": "Oh! So now your Dodoco is one of these special Dodocos with a hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100812,
					"content": "Exactly! The hat makes Dodoco a Dodo-Sorcerer now! She can use special spark magic to help even more people!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100813
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100813,
					"content": "Klee—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100814
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100814,
					"content": "The Knights have informed me about explosions being heard from the forest outside the city...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100815
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100815,
					"content": "#Um, {M#Mr.}{F#Miss} Honorary Knight, Paimon... A little help please...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100816,
					"content": "Ah, that's because we cleared out a Hilichurl camp over there, and a bunch of Slimes too. Plus, we were working on Klee's task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100817,
					"content": "That's right!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100818,
					"content": "Mm... And as for the fish over here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100819,
					"content": "I... might have blasted them. But it's because there were monsters in the lake! I didn't do it on purpose! It's not like those other times...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100820,
					"content": "I see. I take it those other times were on purpose, then?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100821
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100821,
					"content": "Um, they weren't... not on purpose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100822
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100822,
					"content": "*sigh*... I noticed the destroyed camp on the way here, and I saw the monsters fleeing along the shore of Starfell Lake.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100823
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100823,
					"content": "#Am I correct in assuming that's all the damage, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100824,
						100100826
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100824,
					"content": "The rest was Paimon's doing.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100825
					]
				},
				{
					"id": 100100825,
					"content": "...Yeah. You know Paimon, clearing out monsters with a single punch! She's just awesome like that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100827,
					"content": "Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100828
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100828,
					"content": "Come with me. Let's head back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100829
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100829,
					"content": "Ohh... Is it confinement for Klee again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100830
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100830,
					"content": "#Well, {NICKNAME}'s vouching for you, so I suppose your punishment will just have to be... a meal at the Good Hunter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100831
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100831,
					"content": "You've been out and about all day. I'm sure you must be hungry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100832
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100832,
					"content": "You're the best, Master Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100833
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100833,
					"content": "You two are more than welcome to join as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100834
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100834,
					"content": "Haha, awesome! Paimon's been craving some Sweet Madame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100835,
					"content": "Jean treats you, Paimon, and Klee to a meal at the Good Hunter... \\nAh, along with Dodoco, the newly crowned \"Dodo-Sorcerer\" of course. \\nWith that, the trial comes to a successful close.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 100100826,
					"content": "That's all the damage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100827
					]
				}
