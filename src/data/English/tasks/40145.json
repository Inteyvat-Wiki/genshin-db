			"dialogs": [
				{
					"id": 401450101,
					"content": "After a brief trial period, the potion shop opens to great success...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "*sigh* We just keep getting swarmed with more and more customers. It's been nonstop work for so long, Paimon's starting to feel a bit lightheaded...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450103,
					"content": "Business sure is booming...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "We've got a lot of orders. Paimon's not sure we can fill them all on our own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450106,
					"content": "Maybe we should hire some help...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450107,
					"content": "Taking a break, cuties?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450108,
					"content": "I was just looking at the sales data, and it seems like you two have quite the talent for business. The potions seem to be flying off the shelves!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450109,
					"content": "Oh, Lisa! Perfect timing! We were just talking about how we could use some help around the shop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450110,
					"content": "Oh? Are the orders piling up already? Having trouble keeping up?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450111,
					"content": "Yep, we're officially swamped! Paimon never thought we'd get this many customers...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450112,
					"content": "Well, I can't say I'm surprised by the success. I was actually anticipating this kind of response.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450113,
					"content": "While you two were busy with the shop, I was talking with Freda about some possible ways to make the business more efficient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450114,
					"content": "After observing your work, I made note of several improvements we can make to the brewing, cultivation, and sales aspects of the business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450115,
					"content": "Wait, so you've been doing things behind the scenes this whole time!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450116,
					"content": "Paimon kinda thought you were just slacking off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450117,
					"content": "Hey now, I'm actually pretty reliable when it counts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450118,
					"content": "So how are we supposed to put those improvements in action?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450119,
					"content": "Well, I discussed things over with Freda, and the two of us came up with a plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450120,
					"content": "I'll let her give you the details, though. Why don't you go and find her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450104,
					"content": "We've made quite the name for ourselves.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
