			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME}! Paimon! Hello! Is there something I can help you with?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450202,
					"content": "Well, we've been a bit swamped lately, so Lisa recommended we find some ways to increase our efficiency...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450203,
					"content": "Ah, yes! I discussed that with her as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450204,
					"content": "Currently, there are three areas you can improve — brewing, cultivation, and sales.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450205,
					"content": "Increasing your efficiency in these areas will make it much easier to run your business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450206,
					"content": "#Wow, that sounds just like what we need! Let's give it a try, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450207,
					"content": "Improve operating efficiency...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "Looks like all the preparations needed for this upgrade have been made! Please try it out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450209,
					"content": "Purchase supplies...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "You're in luck! I just got a new batch of provisions! Please take a look and see if anything catches your eye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450211,
					"content": "Goodbye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "Best of luck with your business!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				}
			]
		}
	]
