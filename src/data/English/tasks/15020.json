			"dialogs": [
				{
					"id": 150201001,
					"content": "Oh, are you here to help? Thank goodness! There's no way I could do this all by myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201002
					],
					"speakerTitle": "Bold Investigator"
				},
				{
					"id": 150201002,
					"content": "The blockage here has to be cleared using a special bomb, but carrying explosives up that steep slope would be a recipe for disaster...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201003
					],
					"speakerTitle": "Bold Investigator"
				},
				{
					"id": 150201003,
					"content": "If I dropped it, or slipped and fell, I'd be blown to bits in an instant. So my plan was to transport the bomb to the other side, then send it over in a hot air balloon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201004
					],
					"speakerTitle": "Bold Investigator"
				},
				{
					"id": 150201004,
					"content": "All I need now is for someone else to <color=#00E1FFFF>strike the balloon at the right moment, dropping the payload right on top of the spout...</color> and problem solved!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201005
					],
					"speakerTitle": "Bold Investigator"
				},
				{
					"id": 150201005,
					"content": "What do you think? Simple enough, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201006
					],
					"speakerTitle": "Bold Investigator"
				},
				{
					"id": 150201006,
					"content": "I think I can handle that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201007
					]
				},
				{
					"id": 150201007,
					"content": "Is that hot air balloon up there yours, too?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201008
					]
				},
				{
					"id": 150201008,
					"content": "Huh? Oh, THAT one... No, I've got no idea who that belongs to. Or how they got it up so high...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201009
					],
					"speakerTitle": "Bold Investigator"
				},
				{
					"id": 150201009,
					"content": "I just wish I could fly up there and check out what kind of tech they're using... Ah well, getting the trial arena back in order is more important.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201010
					],
					"speakerTitle": "Bold Investigator"
				},
				{
					"id": 150201010,
					"content": "I'll head over and set up now. Let me know when you're ready!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bold Investigator"
				}
			]
		},
