				"points": []
			},
			"dialogs": [
				{
					"id": 150200701,
					"content": "How strange... why is there so much solid phlogiston here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200702
					],
					"speakerTitle": "Doubtful Investigator"
				},
				{
					"id": 150200702,
					"content": "Could be from the Children of Echoes...? Maybe it got swept up here due to the Ley Line disturbances. <color=#00E1FFFF>And I did see those strange markings on the cliff...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200703
					],
					"speakerTitle": "Confused Investigator"
				},
				{
					"id": 150200703,
					"content": "Ugh, I can't think of a way to resolve this... Short of going all the way to the Children of Echoes to borrow a <color=#00E1FFFF>tepetlisaur</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doubtful Investigator"
				}
			]
		},
