			},
			"dialogs": [
				{
					"id": 150200101,
					"content": "Oh, hey there, Chasca. Did Elder Allpa send you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200102,
					"content": "Yeah, she's got other things on her plate right now. How are things looking here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200103,
					"content": "Hmm, well, the inspection revealed numerous blockages all over the trial arena. It looks like they're the result of ley line disorders caused by repeat Abyss invasions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200104,
					"content": "Theoretically, we just need to clear those obstacles, and the arena will fill up with gaseous phlogiston again. But that's proving difficult to achieve in practice, for all sorts of reasons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200105,
					"content": "Why don't you head on down and check things out for yourself? Feel free to ask the staff for more details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
			"id": 1502002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
