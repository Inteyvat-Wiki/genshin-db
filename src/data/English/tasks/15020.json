			},
			"dialogs": [
				{
					"id": 150200801,
					"content": "#Hm? Chasca, {NICKNAME}? This is a surprise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "Elder Allpa? Huh? So... where's this aggressive qucusaur we've heard about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "Already flew away. Looks like it backed off once it realized that reinforcements were coming.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "So why do you think it attacked these people in the first place? Was it after the food?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "No, these merchants aren't even transporting food...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "Ah! Thank goodness! The Phlogiston Wings are intact!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Young Merchant"
				},
				{
					"id": 150200807,
					"content": "...Phlogiston Wings?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "Ahh, thank you so much for coming to our rescue. These Phlogiston Wings are our most prized goods. If anything happened to them, it would ruin us...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200809,
					"content": "...Wait a minute, are you the merchants that were looking to collaborate with us? Warmi told me about you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "Yeah, that's us! So... I take it you're Elder Allpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200811,
					"content": "I am. You must be exhausted from your journey, not to mention shaken up from the attack. Let me bring you back to our tribe to rest — we can talk business after you've recovered.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "But Elder Allpa, what about the qucusaur attack?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Well, our guests here weren't seriously injured, and their goods are intact... Perhaps that qucusaur was just having a bad day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "There are so many of them around here, you'd expect something like this every once in a while. I don't think we need to pursue it any further... More importantly, how are the preparations for the flying trials going? Is everything in order over at the arena?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "Everything's on track.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "Huh? Did you say... flying trials? Wow, what a coincidence! Sounds like a perfect use case for our Phlogiston Wings! You'll be pleasantly surprised by what they can do!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200818,
					"content": "Oh, really? ...Now I'm intrigued.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Hehe, well then let's forget all about this qucusaur attack for now... We have some serious business to discuss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200820,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "So that's it? That all went smoother than expected... Well, guess we'd better get going... Huh? Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "What are you looking at?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "A bloodstained feather...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "The incident is forgotten about, and peace returns to the Flower-Feather Clan.\\nThe next few days are uneventful — except for the flying trial preparations, which continue at an accelerated pace...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "The trials will be able to start very soon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
