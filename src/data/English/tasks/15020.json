			},
			"dialogs": [
				{
					"id": 150200501,
					"content": "Are you ready? This should be a piece of cake for Chasca, but still, try to be careful.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200502,
						150200504
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200502,
					"content": "I'm sure she'll be fine!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200503
					]
				},
				{
					"id": 150200503,
					"content": "Alright, then spread your wings and fly!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200504,
					"content": "Not yet, I need a little more time.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
