					"Cautious Investigator"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150200201,
					"content": "Hmm... I think it should be possible to clear this spout <color=#00E1FFFF>with just a few hard hits</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200202
					],
					"speakerTitle": "Cautious Investigator"
				},
				{
					"id": 150200202,
					"content": "But there are signs of strange life in here... Meddling with it might be dangerous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cautious Investigator"
				}
			]
		},
		{
			"id": 1502003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
