					}
				]
			},
			"dialogs": [
				{
					"id": 150200401,
					"content": "Wow, you took care of everything in no time at all... Incredible work!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200402,
					"content": "Now, we just have to wait until the gaseous phlogiston is fully replenished. Then we can kick off the retrials.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200403,
					"content": "Hmm... Actually, Inkanak, I'd like to do a test flight first, just to make sure we're not missing anything. Could you arrange that for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200404,
					"content": "Huh? But... you only just finished getting the arena ready, there could still be other hazards we're unaware of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200405,
					"content": "All the more reason to have me test it out. Think of it as another inspection.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200406,
					"content": "Eh... I guess you're right — with your flying skills, you won't be in any serious danger, even if there are hazards we overlooked...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200407,
					"content": "The conditions in this area seem a little unstable, but a test-flight is the only way to catch any lingering issues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200408,
					"content": "Alright, I'll get things set up for you. Just let me know when you're ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
