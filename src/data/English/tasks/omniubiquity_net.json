	"talks": [
		{
			"id": 7267201,
			"completionStepIds": [
				7267201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267201",
							"2"
						],
						"stepId": 7267201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "Ugh, that Wakamurasaki... I shouldn't have let her know about Kageroumaru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720102,
					"content": "What's wrong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "Oh, hello there, Traveler. Do you still remember the Ubiquity Net, by any chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720104,
					"content": "After we settled the previous incident, I explained all that happened to a friend of mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720105,
					"content": "Her name is Wakamurasaki, and she's... Well, she calls herself a \"designer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720106,
					"content": "She was quite inspired by the manner in which you used the net.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720107,
					"content": "So she's been badgering me this whole time to help her look up new techniques with which she can continue modifying the Ubiquity Net...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720108,
					"content": "I couldn't deal with all that nagging, so I did find her something new in that ancient collection of mine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720109,
					"content": "If the fancy takes you, Traveler, go to her place. If I don't miss my guess, she's probably finished her modifications by now.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267202",
							"2"
						],
						"stepId": 7267202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wakamurasaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "Well, that should certainly do it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720202,
					"content": "Hello there, are you Wakamurasaki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "That's me! What do you need?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720204,
					"content": "Well, I'm here about the Ubiquity Net...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "Oh, are you? ...Ohh, I remember now. You must be that Traveler! Sango told me about you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720206,
					"content": "The way in which you operated that Net was truly impressive. Inspiring, in fact!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720207,
					"content": "I've heard that you've been modifying it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "Aye, that's right! Hehe... Sango dug up an all-new Onmyou technique for me and all!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720209,
					"content": "I used that technique to modify this net once again, and I name this new model the \"Omni-Ubiquity Net\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720210,
					"content": "According to Sango, this technique is able to detain the essence of living creatures before using certain objects as media to recreate the shape of that living being.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720211,
					"content": "She even says that the utmost achievement of such an Onmyoudou technique is to recreate a human essence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720212,
					"content": "Such essences can answer questions and will never lie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720213,
					"content": "I must say that such a technique would be of unbelievable help to a detective like Sango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720214,
					"content": "You know what? I actually think that's why she told me about that technique and allowed me to make changes to the net...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720215,
					"content": "Ah, ah! But don't you go around telling anyone that. I'm only telling you this because you and Sango are friends, alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720216,
					"content": "I—Is it really that amazing?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "Um, not yet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720219,
					"content": "No matter how I modify it, this net can only be used to recreate the essences of small creatures. It has no effect on humans whatsoever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720220,
					"content": "You know what, Traveler? Take this net with you. Who knows, seeing you in action might give me some inspiration again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720221,
					"content": "Here, take it with you — and remember, it's the Omni-Ubiquity Net now, not just the Ubiquity Net!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720222,
					"content": "Go on, then, go catch a few lil' animals to test it out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720217,
					"content": "Were your modifications successful?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
			"id": 7267204,
			"completionStepIds": [
				7267204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267204",
							"2"
						],
						"stepId": 7267204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wakamurasaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "How did it go? Well?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720402,
					"content": "It was a one-and-done...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "Hmm... I suppose that was inevitable...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720404,
					"content": "Like I said before, this technique can detain the essence of a small animal, but if you want to retain that essence and recreate that animal, you will need a separate medium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720405,
					"content": "I integrated those techniques into the Net, such that it is also the essence-retention device and the recreation medium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720406,
					"content": "That sounds... complicated...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "Well, basically, each net can only be used once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720408,
					"content": "This is an issue that I haven't been able to solve yet, either. If the medium can't stand repeated use, the cost of this device will be way too high...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720409,
					"content": "I'll continue doing research into this net and try to fix the problem as soon as possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720410,
					"content": "If you still need Omni-Ubiquity Nets, you can come find me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720411,
					"content": "And uh... even though these nets can catch small animals, they're a bit of a fuss to put together...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720412,
					"content": "So, next time you want one of these nets, you'll have to pay me a nominal fee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720413,
					"content": "Relax! You're Sango's friend, I won't charge you too much. You'll get a good rate, I promise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				}
			]
		},
		{
			"id": 7267205,
			"completionStepIds": [
				7267205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267205",
							"2"
						],
						"stepId": 7267205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "Did you find Wakamurasaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720502,
					"content": "So, here's the deal with the Omni-Ubiquity Net...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "\"Omni-Ubiquity Net\"... You know what? It's not a bad name. Still, that technique...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720504,
					"content": "Can that technique really detain a human's essence?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Uh, no. That's not possible.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720506,
					"content": "There are only records of such an onmyoudou technique existing. Any practicum has long disappeared into the mists of time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720507,
					"content": "The technique that I taught Wakamurasaki can only do that for small animals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720508,
					"content": "Wait, then why didn't you tell her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Oh, that? I just wanted Wakamurasaki to help me spread a certain something around.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720510,
					"content": "\"Bantan Sango Detective Agency's president is currently asking someone to create a net using Kamuna Onmyoudou that can make people tell the truth.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720511,
					"content": "The long-lost Kamuna Onmyoudou, the Bantan Sango Detective Agency, and a net that can indeed detain the essences of small creatures.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720512,
					"content": "Put all three together, and you have an urban legend that both sounds impressive, and that actually has a grain of truth to it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720513,
					"content": "For most people, these urban legends are just little stories... But for criminals who already have the seed of fear in their hands, such tales are not so simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720514,
					"content": "Ah, so that's how it is...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "The other side of it is... Well, Wakamurasaki was starting to get on my nerves with that whole \"find me the strongest onmyoudou technique ever!\" nonsense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720516,
					"content": "I told her many, many times that such things don't exist, but she wouldn't listen! So I had no choice but to give her *something* to work with so she'd get off my back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720517,
					"content": "What if Wakamurasaki doesn't tell anyone about this?",
