			"dialogs": [
				{
					"id": 4620401,
					"content": "Ooh, lemme see what's inside!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620402,
					"content": "\"She doesn't love him at all. The passion rushing through the clear spring is just a front. When she's cold and alone, her true heart is revealed.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620407,
					"content": "There's another map.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620403,
					"content": "More riddles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620404,
					"content": "Paimon's dizzy already. Oh, no! Paimon used up all her brain juice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620405,
					"content": "You never had any to begin with...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "Paimon'll let you have all the fun. Or, you could get Kaeya to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
