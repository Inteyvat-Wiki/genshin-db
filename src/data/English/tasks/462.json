							"46207",
							"2"
						],
						"stepId": 46207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"46206",
							"3"
						],
						"stepId": 46206,
						"stateName": "QUEST_STATE_FINISHED"
