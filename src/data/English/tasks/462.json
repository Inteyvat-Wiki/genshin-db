			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME}! You're back! Looks like you got the intel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620502,
					"content": "Yes and no. It's a lot more complicated than that.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620503,
					"content": "\"Three six-armed giants reside in the city in the lake. Two guard the statue, one, the treasure.\" What do you make of it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620504,
					"content": "Riddles? How quaint. Let me think...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620505,
					"content": "\"City in the lake\" is clearly Mondstadt... As for the Six-Armed Giants... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620506,
					"content": "Crabs?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "Giant crabs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620508,
					"content": "Aside from asking just where we would find giant crabs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620509,
					"content": "Crabs have eight legs, not six...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620516,
					"content": "The windmills, then?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "Should be... the windmills?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "Hey! That's smart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620519,
					"content": "A windmill has six blades... It fits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620510,
					"content": "Wow! That makes sense!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620511,
					"content": "So, out of the three windmills, two are close to the statue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620512,
					"content": "The other one is guarding...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620513,
					"content": "Ooh! Ooh! This one Paimon knows! The treasure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620514,
					"content": "Hehehe... Let's hope it's really that simple.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620515,
					"content": "#Come on, {NICKNAME}! Let's go take a look around that windmill!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
