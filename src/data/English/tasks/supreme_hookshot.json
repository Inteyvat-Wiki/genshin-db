			"dialogs": [
				{
					"id": 230310601,
					"content": "Great, we have all the materials. Now witness the creation of a unique bait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310602,
					"content": "Kayvan skillfully prepares the bait.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "Alright, here goes. Hooks away!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310604,
					"content": "Hook depth good... Flow speed moderate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310605,
					"content": "You gotta be quiet. The fish are really sensitive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310606,
					"content": "Even the footsteps on the bank could startle them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310607,
					"content": "I'm standing still.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "Then be patient and wait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310610,
					"content": "Kayvan catches a wet package.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "What is this? That's no fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310612,
					"content": "I sure have never seen a \"fish\" like that.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "So that happened again. Just as expected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310614,
					"content": "Don't worry, outlander, stay calm. Don't gripe too much about the details.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310615,
					"content": "Everything that comes with a hook could be considered a \"fish.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310616,
					"content": "Let me tell you, I didn't just invent the title of \"the greatest angler\" out of thin air.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310617,
					"content": "After all, always catching lifeless things that could never bite the bait is something quite special, wouldn't you say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310618,
					"content": "Other anglers have praised my unique talents.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310619,
					"content": "They might be comforting you...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "So basically, you catch everything but fish...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310622,
					"content": "Ahem! I don't care what they think! A—At least I never go home empty-handed!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310623,
					"content": "I'll come again if I fail today, and I'll definitely catch a fish someday!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310624,
					"content": "Anyway, thanks for finding the materials. Please take your payment here. I'm fishing somewhere else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310625,
