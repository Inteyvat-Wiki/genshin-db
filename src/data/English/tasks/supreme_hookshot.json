						230310202
					]
				},
				{
					"id": 230310202,
					"content": "I'm feeling... Zaytun Peach today.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310203,
					"content": "It's common, but few consider it an ingredient with which to make bait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310204
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310204,
					"content": "Please find that for me, would you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
