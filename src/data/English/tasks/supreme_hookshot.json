						230310402
					]
				},
				{
					"id": 230310402,
					"content": "I'm feeling... How about a mushroom today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310403
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310403,
					"content": "The mushrooms I usually use are found in a special area, I'll show you where they can be found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310404
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310404,
					"content": "Please find this sort of mushroom for me.",
