			},
			"dialogs": [
				{
					"id": 220150501,
					"content": "I didn't meet a single detective in all my time in Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "Mondstadt... Oh, you mean Mondstadt City. I've heard of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150503,
					"content": "The two most famous things about Mondstadt are its wine and its freedom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150504,
					"content": "Hahaha, those two things really compliment each other... I suspect that if there were detectives in Mondstadt, their business would be booming every day.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
