			},
			"dialogs": [
				{
					"id": 220150601,
					"content": "I've never seen a detective in Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150602
					]
				},
				{
					"id": 220150602,
					"content": "Liyue doesn't really need detectives. I've heard about how much they value contracts there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150603,
					"content": "Besides, they have the Millelith, who quickly solve problems large and small...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150604,
					"content": "Even if there were a detective agency, I suspect it would have to close down due of lack of business.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
