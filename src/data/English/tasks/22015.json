				{
					"id": 220150901,
					"content": "So I'll wait for your news and of course, you will get paid. Plus... it's a chance for you to experience the life of a detective.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150902,
						220150905
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150902,
					"content": "Aren't you worried about your assistant?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150903
					]
				},
				{
					"id": 220150903,
					"content": "He's very skilled and tough. No need to worry about him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150904
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150904,
					"content": "After all, he used to be a Doushin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150905,
					"content": "Why didn't you go with your assistant?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150906
					]
				},
				{
					"id": 220150906,
					"content": "Well, how should I put it... we both have our roles to play.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150907
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150907,
					"content": "He is responsible for gathering evidence and clues and I'm responsible for analyzing them to uncover the truth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150908
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150908,
					"content": "A reasonable division of labor is the basis for an agency to function well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
