	"talks": [
		{
			"id": 800201,
			"completionStepIds": [
				800202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800202",
							"2"
						],
						"stepId": 800202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "Honorary Knight! Hi, how have you been? Do you need anything today?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020102,
					"content": "Agh... But I should first make it clear that if you need to borrow the Holy Lyre der Himmel again, we cannot oblige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020103,
					"content": "(It seems she still hasn't realized it's just an illusion...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020104,
					"content": "We're here to ask some questions about something. Barbara, have you heard about \"the first Field Tiller\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020105,
					"content": "Hmm... What's that? \"Field Tiller\"... What does it do?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020106,
					"content": "Ah, of course you wouldn't know anything about that, hehe... Okay, next question: Has the Church ever lost a Statue of The Seven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020107,
					"content": "Huh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020108,
					"content": "You're here to ask about that old story? Well, I didn't expect that... That was such a long time ago, barely anyone mentions it nowadays.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020109,
					"content": "A long time ago, there was indeed one Statue of The Seven that disappeared one night without a trace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020110,
					"content": "Nearly every member of the Church joined the search for it, but it was never found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020111,
					"content": "In the Church's records, as you might assume, this incident has been called \"The Lost Statue of The Seven.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020112,
					"content": "Hmm... Of course.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020113,
					"content": "Of course?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020114,
					"content": "Uh, nothing! So, do you have any other clues— uh, Paimon means... any other strange stories?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020115,
					"content": "(Sorry, Barbara, but we can't tell you about the statue we saw just yet... Like Dain said outside, it's for your own good...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020116,
					"content": "Other strange stories? I'm not sure, let me think about what other unusual incidents are in the Church's records... Oh, \"The Tyrant's Final Fury\"? No, that's from another time, probably unrelated...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020117,
					"content": "\"The Tyrant's Final Fury\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020118,
					"content": "Oh, this refers to a time of great danger that engulfed Old Mondstadt, the place now known as Stormterror's Lair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020119,
					"content": "Many, many years ago, there was a time when balls of fire would rain from the sky whenever anyone approached Old Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020120,
					"content": "Balls of fire raining from the sky!? How terrifying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020121,
					"content": "People at that time believed that it was a curse laid down by the God of Storms, so they referred to it as \"The Tyrant's Final Fury.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020122,
					"content": "This strange phenomenon continued for about a year. No one was ever able to solve it, it just gradually ceased on its own.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020123,
					"content": "So bizarre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "Right! Later, the theory of \"The Tyrant's Final Fury\" became less probable in the eyes of the Church. Common reasoning dictates that the God of Storms wouldn't shoot fireballs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020126,
					"content": "Perhaps it was something else that caused the disaster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020127,
					"content": "Anyway, this incident might not be related to \"The Lost Statue of The Seven,\" but I just can't think of any other strange incidents that might be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020128,
					"content": "It's okay. Thanks anyway!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020129,
					"content": "There's that pointless word \"thank you\" again. I can never get used to hearing it...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020130,
					"content": "Oh, Rosaria, it's you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020131,
					"content": "If you're looking for the Knights of Favonius, they're busy with those monsters again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020132,
					"content": "\"Those monsters\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020133,
					"content": "Those monsters that tried to attack Mondstadt last time, during the Stormterror incident.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020134,
					"content": "Wasn't that the Abyss Order!? They're at it again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020135,
					"content": "Indeed. They are gathering in <color=#00E1FFFF>Wolvendom</color>, causing great unrest among the wolves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020136,
					"content": "Could it be... that the Abyss Order is targeting the spirit of Lupus Boreas? As for what purpose, I can't say for certain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020137,
					"content": "Master Jean has already headed off to <color=#00E1FFFF>Wolvendom</color>. I must also begin to make a move myself.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020138,
					"content": "Th—Then I will go as well!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020139,
					"content": "Master Jean said you should stay at the church, and continue your work with the clergy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020140,
					"content": "B—But... you're also a member of the clergy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020141,
					"content": "Don't worry, I will go to help as well.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "Right, we'll go give Master Jean a hand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020143,
					"content": "Oh... Okay, if the Honorary Knight will be there, then...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020144,
					"content": "But please, everyone, be careful. May the Anemo Archon protect you all.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020124,
					"content": "It's not necessarily related to the tyrant...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
			"completionStepIds": [
				800205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800205",
							"2"
						],
						"stepId": 800205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "Whew... There sure are a lot of enemies around here!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020202,
					"content": "The closer we get to the target, the more enemies there are. Hmph, fits the Abyss Order's style.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020203,
					"content": "We should hurry and find Lupus Boreas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "Yeah! Let's go!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020205,
					"content": "I'm... not going any further.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020206,
					"content": "Huh? Why not? Is it because you're afraid of fluffy animals?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020207,
					"content": "That's... probably not it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "It has nothing to do with wolves. It's because Boreas was an ancient god, yet he willingly became a servant of The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020210,
					"content": "I cannot possibly agree with his actions. I don't desire any interaction with him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020211,
					"content": "Besides, you're the one people like. I'm... less likable.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020212,
					"content": "You really despise The Seven, huh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "There's nothing special about gods anyway.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020216,
					"content": "It's just my opinion, but a word of advice: Always be on your guard when around gods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020217,
					"content": "You shouldn't place too much trust in them. But at the same time, don't go too far in the opposite direction... Don't go trying to overthrow them, or hunt them down.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020218,
					"content": "Even if the god in question is your sworn enemy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020219,
					"content": "Don't trust them, and don't hunt them... That's some awkward advice. Does Dain hate The Seven, or is he protecting them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020220,
					"content": "Why is your opinion so contradictory?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020222,
					"content": "Lest I repeat the failings of my forebears.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020223,
					"content": "I... will tell you one final fact.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020224,
					"content": "Huh? What fact?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020225,
					"content": "The destruction of the nation of Khaenri'ah by the gods... is the reason the Abyss Order now seeks to destroy the nations watched over by The Seven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020226,
					"content": "Well, enough chit-chat. We should get back to business. I will go take care of the remaining Abyss Order members in the area. Try and keep your visit with Boreas brief. Afterward, let's meet at the entrance to Wolvendom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020227,
					"content": "Oh... There he goes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020228,
					"content": "What a strange man.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020229,
					"content": "I can kind of see where he's coming from.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "Yeah, that's true. You also keep your guard up against unfamiliar gods.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020231,
					"content": "At the Rite of Descension in Liyue, your decision was very similar to what Dain would do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020232,
					"content": "When there's a lack of trust, it's best to just avoid the situation entirely...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "*sigh* Not the easiest situation...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020234,
					"content": "Honorary Knight! Paimon! What are you two doing here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020235,
					"content": "Oh, Master Jean! So glad we found you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020236,
					"content": "Rosaria told us that you came here to fight the Abyss Order, so we came to help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020237,
					"content": "Then your help is greatly appreciated. The Abyss Order's sudden offensive is very strange, they have surrounded Wolvendom. I am preparing to send out some knights to fight back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020238,
					"content": "I just scouted out all of Wolvendom... but I did not see you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020239,
					"content": "Rosaria told me that the Abyss Order is going after Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020240,
					"content": "But the Abyss Order and Boreas... What is the connection between them?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020241,
					"content": "They just like to cause trouble. Do they really need a reason?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020242,
					"content": "The Abyss Order already went after Dvalin, it's not too surprising that they would also go after another one of the Anemo Archon's buddies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020243,
					"content": "Hmm... That is true...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020244,
					"content": "Regardless, whether the reason behind the present threat is clear or not, I'll handle the situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020245,
					"content": "Honorary Knight, please go and check if Lupus Boreas is in any danger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020246,
					"content": "This god's spirit... he does not often see people. But I hear that you have met him before. Maybe it is best that you are also the one to meet him this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020247,
					"content": "I'll do it.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "Okay, be careful. Thank you for your help, Honorary Knight of Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020214,
					"content": "You really don't like social interaction, huh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "I have no problem interacting with people. But interacting with gods... that's a different story.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020208,
					"content": "Aren't fluffy things cute?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
