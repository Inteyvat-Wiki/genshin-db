					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "I see... Has the Abyss Order already launched a new operation...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020502,
					"content": "This could very well have something to do with the Defiled Statue. We should go as well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020503,
					"content": "But, what is the Abyss Order going to Wolvendom for anyway? Are they looking to do the same as they did with Dvalin? Aaaah... Not again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020504,
					"content": "No, that's not likely.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020505,
					"content": "Unlike Osial, who was just suppressed, Andrius died long ago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020506,
					"content": "Today it is just his spirit that stands guard over Wolvendom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020507,
					"content": "The Abyss Herald may just be targeting the spirit of Andrius in an attempt to garner some information from one of the Anemo Archon's old companions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
