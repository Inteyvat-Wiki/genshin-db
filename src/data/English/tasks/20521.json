				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "How can she go adventuring without her adventure fuel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "\"Adventure fuel\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "Oh, I mean hot food. I was talking about Iris, the explorer — she should really get some hot food in her...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "She wants to organize an expedition into the mountains for a team of explorers. But she plans to head up alone first, camp out for a bit, and observe the conditions before coming up with a definite plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "The camp isn't all that far away, and it's still easy enough getting supplies delivered there...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "But still, camping up in the mountain, out in the snow... I feel like a hot meal would give her the extra energy she needs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "I, however, wouldn't dare make the trip myself... what about you? Could you deliver this Cream Stew to Iris for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Thanks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "This dish has been made fresh and is still piping hot. You'd better get it to Iris quickly. In these conditions, it'll go cold fast, and it won't be worth eating if that happens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "That said, worst-case scenario, if you run into trouble along the way and the food becomes collateral damage, just come back here and I'll cook you a new one.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "Where do I find her?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "She said that the camp is partway up the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "She's a seasoned adventurer and knows to exercise caution. She won't have strayed far from the camp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
		{
			"id": 2052102,
