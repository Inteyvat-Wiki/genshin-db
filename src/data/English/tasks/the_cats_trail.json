			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2204103",
							"2"
						],
						"stepId": 2204103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220410301,
					"content": "How does your task go? Have you found Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410302,
					"content": "Sure did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "...Wait, what? It's run off again!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220410304,
					"content": "I'll go get it back!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "No, there's no need to give chase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410307,
					"content": "It is me that that child is still angry at... I will teach them a lesson personally later.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410308,
					"content": "Ah, it is almost old enough to be an adult cat. Why is it still so stubborn? What would we do if it frightened the humans coming to the shrine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410309,
					"content": "Right. This is for you as thanks for your help.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410310,
					"content": "*sigh* Why can't this child be as teachable as Meshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410305,
					"content": "Well, I never...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				}
			]
		}
	]
