				"points": []
			},
			"dialogs": [
				{
					"id": 220410101,
					"content": "You time your arrival well. I was just fretting about something.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410102,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "Do you recall that child, Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410104,
					"content": "That little rascal went off to play nearby and has not returned. I am most worried.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410105,
					"content": "Please, help to search for Konbumaru and bring him back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410106,
					"content": "Consider it done.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "Wonderful. Remember, you need to find Konbumaru and bring him back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410108,
					"content": "Is it the only one who ran off?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "Indeed... Perhaps it was my previous scolding that displeased it so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410110,
					"content": "Ah, why will this child not listen to instruction...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410111,
					"content": "Either way, please find Konbumaru and bring him back here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 2204102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
