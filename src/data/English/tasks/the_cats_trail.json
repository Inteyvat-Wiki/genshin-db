			},
			"dialogs": [
				{
					"id": 220410201,
					"content": "I am counting on you to bring Konbumaru back to this shrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
