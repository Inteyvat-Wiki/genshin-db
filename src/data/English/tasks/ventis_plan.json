			},
			"dialogs": [
				{
					"id": 3740301,
					"content": "Eh? She didn't even bat an eyelid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740302,
					"content": "But, I have at least learned what I wanted to know.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740303,
					"content": "She didn't deny that the Cathedral is enshrining the Holy Lyre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740304,
					"content": "#Now, {NICKNAME}, since you're the hotshot of the Knights of Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740305,
					"content": "Maybe you can give it a shot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
