			},
			"dialogs": [
				{
					"id": 200031001,
					"content": "Hello. How may I assist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031002
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031002,
					"content": "Excuse me, have you seen a girl who looks something like this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200031003
					]
				},
				{
					"id": 200031003,
					"content": "You describe Mona's distinguishing features to Wyratt...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200031004
					]
				},
				{
					"id": 200031004,
					"content": "Oh! I know who you're talking about. It's the girl with the really big hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031005
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031005,
					"content": "She often comes by to consult some of the texts we keep here. She spends the whole day reading, so she's quite the memorable patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031006
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031006,
					"content": "That said, she hasn't swung by recently. I doubt you'll find her hereabouts...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031007
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031007,
					"content": "Seems we're a little late.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200031008
					]
				},
				{
					"id": 200031008,
					"content": "If she does come by, I'll make sure to tell her that you're looking for her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031009
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031009,
					"content": "That's all I can do for you in this case, unfortunately...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031010
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031010,
					"content": "No problem. Thank you.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200031011
					]
				},
				{
					"id": 200031011,
					"content": "Think nothing of it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031012
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031012,
					"content": "Well, looks like Mona's not in the library. Guess we've got to tell Goth that we couldn't find her...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
