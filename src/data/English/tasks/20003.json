					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200031102,
					"content": "Excuse me, have you seen a girl who looks something like this...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200031103
					]
				},
				{
					"id": 200031103,
					"content": "You describe Mona's distinguishing features to Sara...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200031104
					]
				},
				{
					"id": 200031104,
					"content": "Oh, you mean Mona, don't you? At one time, she came by every evening to grab some salad — she sometimes even asked me for an extra egg or two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200031105,
					"content": "Guess she's as short of Mora as ever, huh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200031106,
					"content": "She hasn't come once in the past few days, though.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200031107,
					"content": "If you're in a hurry to find her, I can pass a message on to her for you the next time she comes by to get salad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031108
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200031108,
					"content": "Thanks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200031109
					]
				},
				{
					"id": 200031109,
					"content": "Looks like Mona hasn't been to Good Hunter. Ugh, guess we've got to go tell Goth that we couldn't find her today...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
