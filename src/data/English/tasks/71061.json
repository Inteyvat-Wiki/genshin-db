					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610401,
					"content": "#Hail {NICKNAME}! Hail Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610402,
					"content": "If Xamaran may be so bold, you Two-Legs do have a saying: \"A helping hand must see things to the end.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610403,
					"content": "You mean more errand-running, huh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "But do human sayings really apply to mushrooms?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "Amongst Two-Legs, you two do indeed deserve the title of \"The Wise.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610406,
					"content": "We are both living beings bathing in the blessings of the earth. It's natural for us to help each other out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610407,
					"content": "Please take this — the Blessings of Wisdom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610408,
					"content": "You obtain the Blessings of Wisdom.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Wow... What's this? It looks kinda suspicious, actually...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610410,
					"content": "Xamaran can smell the lingering scent of foul energy in the air but cannot tell where its source lies. Follow the water and you shall find it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610411,
					"content": "#You merely need to use the Blessings of Wisdom on the source, {NICKNAME}, and Xamaran's kin will take care of the rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610412,
					"content": "The source of the foul energy... That's indeed something that can't be left unattended.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "...But why don't you deal with it yourself?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME}, you are far more humorous than Paimon. Xamaran doesn't have legs whereas you do. As one of the legless, Xamaran shan't meddle too much with the matters of the Two-Legs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
