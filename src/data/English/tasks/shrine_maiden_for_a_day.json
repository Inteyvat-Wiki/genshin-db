				"objectNames": [
					"Inagi Hotomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191451601,
					"content": "I pray that the Electro Archon will bless that lady and her granddaughter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451602,
					"content": "I wanted to ask — does she have vision problems?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "Oh, you noticed? Yes, she can't see very well. We always get a little worried for her safety every time she comes up the mountain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "But she always refuses our offers to help. She insists that she knows the route like the back of her hand after walking it so many times in her life...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "Luckily, there are shrine maidens along the way who can at least keep an eye on her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "May the Electro Archon watch over her and her granddaughter on their respective journeys...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		},
