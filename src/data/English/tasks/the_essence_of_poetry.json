					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225011301,
					"content": "I have given your words much thought, my liege, but the meteorites are too rare a sight to be missed. I will go nonetheless.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011302,
					"content": "You...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011303
					]
				},
				{
					"id": 225011303,
					"content": "But if I were to immediately go close to those meteorites, I fear I might be attracted by them only, thus missing the world around them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011304,
					"content": "A poet's worst nightmare is to have eyes for one thing only. If I were to merely observe those meteorites, I doubt that anything good should come from my brush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011305,
					"content": "So I shall first observe them from afar, taking in the surroundings, before moving in for a closer look...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011306,
					"content": "And then... Hmm, wait. With so many monsters on the road, and no one to accompany me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011307,
					"content": "Traveler, perhaps you might be so kind as to dispose of the monsters that might bar our path?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011308,
						225011310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011308,
					"content": "Okay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011309
					]
				},
				{
					"id": 225011309,
					"content": "Wonderful! Most splendid! I shall be depending on you, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011310,
					"content": "Just promise me you won't touch those meteorites...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011311
					]
				},
				{
					"id": 225011311,
					"content": "I—I... Alright, I promise. Come now, why would I put myself in harm's way when I know that touching them may put me in an unending slumber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011312
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011312,
					"content": "Yet, one wonders what those consigned to such torpor by the meteorites might dream of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011313,
					"content": "*coughs* I—I was just joking! Please help me deal with those monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
