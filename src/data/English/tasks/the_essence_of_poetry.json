			"dialogs": [
				{
					"id": 225010901,
					"content": "Are you sure that you can deal with the risks?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010902
					]
				},
				{
					"id": 225010902,
					"content": "Well, I will bring a guard with me, naturally — just in case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010903
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010903,
					"content": "It might be difficult to hire someone right now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010904
					]
				},
				{
					"id": 225010904,
					"content": "Um... hmm. Yes, that's... You make a good question, my liege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
