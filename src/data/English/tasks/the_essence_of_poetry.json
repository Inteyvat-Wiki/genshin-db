			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225011101,
					"content": "Your writing's pretty good already.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011102
					]
				},
				{
					"id": 225011102,
					"content": "I am unworthy of such praise. But alas, how can a poet live with themselves if they cannot write poetry?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
