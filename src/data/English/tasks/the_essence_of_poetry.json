				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225011001,
					"content": "Inspiration doesn't guarantee good execution.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011002
					]
				},
				{
					"id": 225011002,
					"content": "Haha, Now, I do not mean to brag, my liege. But though I, Qingzhou, may lack talent, I have still published many a popular verse. You need not worry on my behalf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250111,
			"completionStepIds": [
