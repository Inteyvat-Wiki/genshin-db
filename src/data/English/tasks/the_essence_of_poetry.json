			"dialogs": [
				{
					"id": 225011801,
					"content": "Ah, is this, then, a meteorite? Curious. Most curious...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011802
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011802,
					"content": "Don't touch it, now.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011803
					]
				},
				{
					"id": 225011803,
					"content": "Oh? Ah, it's you, my liege... I am aware of the danger. Please do not worry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011804
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011804,
