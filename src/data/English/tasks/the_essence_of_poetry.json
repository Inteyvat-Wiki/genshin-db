			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225011201,
					"content": "I have given your words much thought, my liege, and valid are your concerns. I shall not risk myself unnecessarily by seeking those meteorites out.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011202,
					"content": "That's good...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "What's more, a unique stroke does not good poetry make. It is in the many fine details that one's broader quality may be judged.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011204,
					"content": "We may be able to compose a fine verse from a flower or some other small object. Yet the number of poems written in praise of flora are many indeed...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011205,
					"content": "Hmm... It is said that outsiders see clearly, yes? Well then, Traveler, what sort of flower do you think I should as reference for composing my poem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250113,
			"completionStepIds": [
				2250115
			],
