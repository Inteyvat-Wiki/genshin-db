	"talks": [
		{
			"id": 2250101,
			"completionStepIds": [
				2250101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
							"2"
						],
						"stepId": 2250101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "Hmm... No, this verse will not do. It won't do at all. *sigh* I really must go and see for myself...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010102,
					"content": "Is something the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "How do you fare this day, my liege? My name is Qingzhou. I might add that I consider myself a poet, if I may be so bold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010104,
					"content": "By some strange chance, I received a single strain of poetic inspiration of late, but I have yet to find a continuation worthy of its brilliance since...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010105,
					"content": "Recently, the skies have been strange, and meteorites have fallen in flame to the earth. It is truly a rare sight to see on this mortal plane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010106,
					"content": "It came to my mind that if I were to gain some inspiration from observing one such meteorites up close, that next, elusive sentence in my poem may yet surface...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010107,
					"content": "Th—That might not be appropriate...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "Not appropriate? Whatever might you mean by that?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250102,
			"completionStepIds": [
				2250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
							"3"
						],
						"stepId": 2250101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"2"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "What are you referring to as \"inappropriate\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010202,
					"content": "You'll be knocked unconscious if you touch those meteorites...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "Ah, I've heard tell of this. But if I but observe them up close, nothing untoward will befall me, yes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010204,
					"content": "Can you guarantee that you won't touch them?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "W—Well, I shall exercise restraint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250103,
			"completionStepIds": [
				2250103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"3"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010301,
					"content": "There's a better way to view those meteorites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010302
					]
				},
				{
					"id": 225010302,
					"content": "A better way, you say? ...Hmm, you do have a point. If I but gaze into the meteor's flame, but ignore all that surrounds it, would that not be overly narrow of me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250104,
			"completionStepIds": [
				2250104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"3"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010401,
					"content": "You can write poetry from here, can't you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010402
					]
				},
				{
					"id": 225010402,
					"content": "That simply won't do, my liege. If I stay cloistered and safe all my life, then what would the poems I write be, if not the groans of the healthy, or the pontifications of a fool?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"3"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010501,
					"content": "There are monsters near those meteorites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010502
					]
				},
				{
					"id": 225010502,
					"content": "Haha, of course. I have traversed many a place in Liyue, and have seen many a foul beast. If the road is indeed too dangerous, then I shall just hire a guard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250106,
			"completionStepIds": [
				2250106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"3"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010601,
					"content": "Not everything you write has to shock the world, right?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010602
					]
				},
				{
					"id": 225010602,
					"content": "You speak truly — the best verses are divinely inspired, and the finest hands are guided by chance. And yet, this verse has plagued me for far too long. I must continue it somehow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250107,
			"completionStepIds": [
				2250107
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"3"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010701,
					"content": "Will looking at a meteorite really inspire you?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010702
					]
				},
				{
					"id": 225010702,
					"content": "Ah, you think too little of me, my liege. Were I to gaze upon one, I would surely write you a fine verse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250108,
			"completionStepIds": [
				2250108
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"3"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010801,
					"content": "But if you were to fall into a slumber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010802
					]
				},
				{
					"id": 225010802,
					"content": "Of this you need not fret, my liege. I shall show the utmost restraint. Yet, if the meteorites do indeed consign people to slumber, one wonders what they dream of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010803
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010803,
					"content": "Yes, how very curious... Ahem! I was merely theorizing. Do not worry, I will not put myself at such a risk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250109,
			"completionStepIds": [
