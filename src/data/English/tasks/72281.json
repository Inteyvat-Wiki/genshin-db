			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Gorou",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722811601,
					"content": "#{NICKNAME}, Paimon, thank you for coming to see us off.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811602
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811602,
					"content": "How was your trip to Ritou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811603
					]
				},
				{
					"id": 722811603,
					"content": "Very worthwhile. The book review session was a big success, and I feel very positive about the forthcoming talks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811604,
					"content": "Gorou also made a great contribution. He procured a whole batch of useful books for Watatsumi Island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811605
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811605,
					"content": "I may have won the prize, but ultimately it was Yae Miko who gave us all these books for free. If I have the chance in the future, I must thank her properly.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811606
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811606,
					"content": "Speaking of, didn't Yae Miko send you a letter yesterday? What did it say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811607
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811607,
					"content": "Oh, I almost forgot! I'll read it now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811608,
					"content": "Dear Gorou, I suppose you must have been extremely nervous when you heard about the prospect of the award ceremony and the photo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811609
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811609,
					"content": "It came as a surprise indeed to learn that not only did you accept those conditions, you also made your own demands. Your courage has won my respect.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811610
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811610,
					"content": "Those books are a token of my goodwill to Watatsumi Island, and also my gift to you. I do hope you like them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811611
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811611,
					"content": "Ah yes, I'm sure that by this point you must be feeling ever so grateful for my kindness and are looking for a way to repay me, yes? Well, here's your chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811612
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811612,
					"content": "Yae Publishing House will host an event next month, and we are looking for someone to dress up as a character from a light novel and interact with the fans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811613
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811613,
					"content": "Gorou, you are not only patient but also very beautiful. Why don't you come and help us? I'll prepare a tailor-made outfit, just for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811614
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811614,
					"content": "Oh, and by the way — it'll be a woman's outfit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811615
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811615,
					"content": "Aaaaah!!! I knew it, I knew she was up to something!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		}
	]
}