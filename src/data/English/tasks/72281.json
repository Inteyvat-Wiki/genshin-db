	"talks": [
		{
			"id": 7228102,
			"completionStepIds": [
				7228102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228102",
							"2"
						],
						"stepId": 7228102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810201,
					"content": "#{NICKNAME}, Paimon, nice to see you again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810202,
					"content": "Wow, it's Kokomi and Gorou. So the Divine Priestess and the general of Watatsumi Island have come to take part in the Irodori Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810203,
					"content": "Yes, but we are not here representing Watatsumi Island's administration. We were invited as individuals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810204,
					"content": "Things are quiet in Watatsumi Island at the moment, and I wanted to buy some books. So, I decided to make the trip here.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810205
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810205,
					"content": "Gorou was not greatly interested in the Irodori Festival. But he said if I was going to Ritou, he would join me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810206,
					"content": "Her Excellency is traveling outside of Watatsumi Island and also meeting her pen pal today. As her general, it is my duty to ensure her safety at every turn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810207
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810207,
					"content": "...Pen pal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810208,
					"content": "Yes. We started corresponding just recently.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810209
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810209,
					"content": "My pen pal and I share very similar tastes in light novels, and we always have a lot of interesting thoughts to share. Of course, there are also times when we fiercely disagree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810210,
					"content": "Since we were both coming to the Irodori Festival this time, we decided to take the opportunity to hold a book review session, and discuss our views on various novels in more depth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810211
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810211,
					"content": "Sounds pretty professional! Hey, since you both like novels, why don't you try writing one together? Who knows, maybe you'll shake things up on the Inazuman literary scene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810212,
					"content": "Hehe, that's a very interesting idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810213,
					"content": "#It's almost time, {NICKNAME}. Gorou and I must go to meet my pen pal at the agreed upon location.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810214
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810214,
					"content": "Kokomi, Paimon's super curious about this pen pal of yours. Can Paimon come with you? Don't worry, Paimon will just watch from a distance and won't interrupt anything.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810215,
					"content": "Hmm, let me think... Yes, I think it should be fine for you two to come with me. Alright, let's go together.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 7228104,
			"completionStepIds": [
				7228104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228104",
							"2"
						],
						"stepId": 7228104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Gorou",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810401,
					"content": "This is the meeting spot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810402
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810402,
					"content": "There's no one else around. It looks like we're early...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810403
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810403,
					"content": "My, my, who have we here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810404,
					"content": "M—Miko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810405,
					"content": "(Oh no, Paimon hadn't counted on running into Miko! She and Kokomi are on different sides, and they also believe in different gods...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810406,
					"content": "(Are they gonna end up... having a fight?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810407,
					"content": "Lady Guuji of the Grand Narukami Shrine — no wonder. I was just wondering where that air of superiority was coming from.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810408,
					"content": "Hehe, if it isn't the leader of Watatsumi Island, who looks as soft as a jellyfish, but whose words sting like one, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810409,
					"content": "Uh oh... this is getting out of control fast...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810410,
					"content": "Hello, nice to meet you, \"Fried Tofu With All the Frills.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810411,
					"content": "The pleasure is all mine, \"Sole of the Deep.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810412,
					"content": "Hehehehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810413,
					"content": "Hey... what's going on here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810414,
					"content": "Miko is Kokomi's pen pal!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810415,
					"content": "No, it can't be. Look at them, clearly they already knew each other! Does that mean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810416,
						722810417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810416,
					"content": "This so-called meeting of pen pals...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				},
				{
					"id": 722810418,
					"content": "Hmm? Whatever are you talking about? I don't understand. I'm simply here for the book review session with Miss Sole of the Deep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810419,
					"content": "Let's go. The venue for this meeting is in the Kanjou Commission headquarters up there. The view is excellent, making it a perfect place to drink tea and discuss creative ideas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810420
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810420,
					"content": "Who holds a book review in the Kanjou Commission? You seriously expect anyone to believe that!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810421,
					"content": "You're not here to talk about shaking up the Inazuman literary scene... You're here to talk about shaking up things in Inazuma as a whole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810422,
					"content": "Hehe, Watatsumi Island will soon hold formal talks with the Shogunate on Inazuma's future development. It's essential to have an informal meeting like this one before the formal talks begin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810423,
					"content": "Right. Especially with someone outside of the Shogunate like myself, who is in a good position to test out where each party draws the lines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810424,
					"content": "But this is just our first meeting. It's a little too early to announce it to the general public.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810425,
					"content": "Huh, okay then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810426,
					"content": "By the way, where is your general? Didn't you say he would be joining you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810427,
					"content": "Huh, that's right... Where did Gorou go...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810428,
					"content": "Gorou went to buy some books for me. He won't be attending the book review.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810429
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810429,
					"content": "Oh, what a pity. I was rather looking forward to seeing his fluffy ears again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810430
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810430,
					"content": "#{NICKNAME}, I'd like to talk to you for a moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810431
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810431,
					"content": "What's up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810432
					]
				},
				{
					"id": 722810432,
					"content": "I have been getting the sense that Gorou does not like having to deal with Guuji Yae, so I was initially reluctant to bring him to Ritou with me this time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810433
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810433,
					"content": "I noticed he instinctively hid as soon as he saw her just now. However, Gorou has a strong sense of responsibility, and will feel ashamed when he next sees me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810434
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810434,
					"content": "So, I would like to give him the task of buying some books for me to make things easier for him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810435
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810435,
					"content": "But Gorou rarely buys anything. So as a favor for me, I'd like to ask you to accompany him.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810436
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810436,
					"content": "Sure, leave it to me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810437
					]
				},
				{
					"id": 722810437,
					"content": "Kokomi, you focus on the meeting with Miko. Leave the books to us and Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810438,
					"content": "Thank you. I made a list of the books I'd like to buy. Please pass it on to Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810417,
					"content": "...is just a cover-up?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				}
			]
		},
		{
			"id": 7228105,
			"completionStepIds": [
				7228105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228105",
							"2"
						],
						"stepId": 7228105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810501,
					"content": "Gorou, are you alright?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810502,
					"content": "Ah! It's you... *sigh* I wasn't expecting you-know-who to show up — it completely caught me by surprise. I had no idea what to say to her... Next thing I knew, I'd apparently already taken cover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810503
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810503,
					"content": "I came here to ensure the safety of Her Excellency, but now I'm useless... I've become a burden instead.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810504
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810504,
					"content": "Gorou, don't be so hard on yourself. Actually, Kokomi asked us to give you a very important task.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810505,
					"content": "You give Kokomi's list of books to Gorou.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722810506
					]
				},
				{
					"id": 722810506,
					"content": "Her Excellency's purchase list... Got it, this is how Her Excellency wants me to make up for my mistakes! No problem, just leave it to me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810507
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810507,
					"content": "Gorou, let us come with you. We can show you around the Irodori Festival while we're at it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810508,
					"content": "Thank you so much!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
		{
			"id": 7228107,
			"completionStepIds": [
				7228107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228107",
							"2"
						],
						"stepId": 7228107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou",
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810701,
					"content": "There is a children's storybook on this list called \"Night at Mt. Yougou.\" I think this is the stand where it's being sold.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810702
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810702,
					"content": "A children's storybook?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810703,
					"content": "Yes. It's for the children of Watatsumi Island. Her Excellency says that this book is simply written and very useful for learning new words.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810704
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810704,
					"content": "Hello, I'll take five copies of \"Night at Mt. Yougou,\" please.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810705
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810705,
					"content": "Thank you for your patronage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810706
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 722810706,
					"content": "Wow, you're a lucky customer! There's a coupon in one of the books you just bought which entitles you to a free gift!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810707
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 722810707,
					"content": "Wow, Gorou got a free gift! That's amazing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810708,
					"content": "Here you go — a toy fox, it's all yours!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810709
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 722810709,
					"content": "What? A—A toy fox?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810710
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810710,
					"content": "Are you okay? The hair on your tail is standing on end...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810711
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 722810711,
					"content": "I'm fine, thanks for the gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810712
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810712,
					"content": "#{NICKNAME}, could you maybe, uh, look... l— look after the toy for me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810713
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810713,
					"content": "Are you sure?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810714
					]
				},
				{
					"id": 722810714,
					"content": "Yes. As a thank-you gift for coming with me to buy the books.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810715
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810715,
					"content": "*sigh* Seems like Gorou still hasn't recovered from seeing Miko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810716,
					"content": "Okay, next up... Hmm, this isn't the focus of this trip, but let's go buy a light novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810717
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810717,
					"content": "It says on the list that Her Excellency had an editor called Onodera purchase the latest issue of \"A Legend of Sword\" for her in advance. We'd better not keep him waiting too long.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810718
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810718,
					"content": "Oh, we know him. We'll lead the way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7228109,
			"completionStepIds": [
				7228109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228109",
							"2"
						],
						"stepId": 7228109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou",
					"Onodera"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810901,
					"content": "Excuse me, are you Mr. Onodera? I'm here to pick up the new issue of \"A Legend of Sword\" for \"Sole of the Deep.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810902
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810902,
					"content": "Hello there, yes, I have the book right here. I heard \"Sole of the Deep\" is a VIP of the Irodori Festival, but couldn't make it here in time for the signing event due to the shipping schedule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810903
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 722810903,
					"content": "Also, if you have these books available, please give me one of each. Thank you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810904
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810904,
					"content": "Alright, let me see...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810905
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 722810905,
					"content": "Oh my goodness, it's your lucky day today, sir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810906
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 722810906,
					"content": "You are the 100th reader to buy \"The Saga of Hamavaran\"! That entitles you to receive a special-edition version with a review personally written by Lady Yae herself!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810907
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 722810907,
					"content": "Ugh... are you serious?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810908
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810908,
					"content": "Are you okay? You don't look very well.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810909
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 722810909,
					"content": "I—I'm fine. Thank you for the books.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810910
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810910,
					"content": "Her Ex.... \"Sole of the Deep\" asked me to buy this book, after all. I'm sure she'll be very happy to receive a special version with a chief editor's review, hah, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810911
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810911,
					"content": "Gorou does not look like he's enjoying this at all. Paimon doesn't know if he's lucky or unlucky.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810912,
					"content": "Oh, one other thing — because of the amount of your purchase, you're able to enter the Yae Publishing House's lucky draw. Please come with me, right this way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onodera"
				}
			]
		},
		{
			"id": 7228111,
			"completionStepIds": [
				7228111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228111",
							"2"
						],
						"stepId": 7228111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Onodera",
					"Murata",
					"Gorou",
					"Youta",
					"Akito"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722811101,
					"content": "Sir, please take your lucky draw whenever you are ready.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811102
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 722811102,
					"content": "Just turn the handle and a prize ball will come out. Maybe today's your lucky day!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811103
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811103,
					"content": "Come on, Gorou, go for it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811104,
					"content": "Let me see... Wow, incredible! You got the golden ball, that's the grand prize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811105
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811105,
					"content": "Gorou, you're a lucky dog today! So what is the grand prize, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811106,
					"content": "The grand prize is a full collection of each light novel published by Yae Publishing House!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811107
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811107,
					"content": "Not only is the prize awarded personally by Lady Yae, but you will also have the chance to shake hands and take a photo with her to commemorate the occasion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811108
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811108,
					"content": "What? Not only do I have to meet her... but I have to shake her hand and take a photo with her, too!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811109
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811109,
					"content": "Gorou! Hang in there!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811110
					]
				},
				{
					"id": 722811110,
					"content": "What? This guy won the Yae Publishing House's grand prize? Wow, that's so lucky!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811111
					],
					"speakerTitle": "Youta"
				},
				{
					"id": 722811111,
					"content": "An entire set of all their light novels... That's worth a lot of money!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811112
					],
					"speakerTitle": "Akito"
				},
				{
					"id": 722811112,
					"content": "Ugh... Um, excuse me, Ma'am, could we discuss this? I don't actually want the light novels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811113
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811113,
					"content": "Huh? You mean you want to give up the prize?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811114
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811114,
					"content": "Gorou! Don't give up your prize! If you don't want to see Miko, that's fine — we'll figure something out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811115,
					"content": "No, that's not what I meant. I'm not giving up the prize, and I can cope with the ceremony and the picture-taking.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811116
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811116,
					"content": "But I have a request. I would like to ask Yae Publishing House to change the prize from light novels to books on agricultural science of equivalent value.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811117
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811117,
					"content": "Agricultural science?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811118,
					"content": "Yes. The land in Watatsumi Island is quite barren and always yields a poor grain harvest. We've been looking for new ways to improve the residents' lives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811119
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811119,
					"content": "One of Her Ex... Sole of the Deep's core objectives for the Irodori Festival was to purchase some works on crop cultivation and aquaculture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811120
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811120,
					"content": "If I can get these books as my prize instead, we can save a lot of money, and Sole of the Deep can buy some other useful resources, too.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811121
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811121,
					"content": "I see. I understand your request, but I don't have the authority to grant it. Lady Yae will have to have the final say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811122
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811122,
					"content": "I will contact Lady Yae now — please wait for our reply at The Five Kasen Plaza. Depending on the situation, Lady Yae might need to negotiate this matter with you further in person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811123
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811123,
					"content": "Okay, understood.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
		{
			"id": 7228113,
			"completionStepIds": [
				7228113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228113",
							"2"
						],
						"stepId": 7228113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou",
					"Murata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722811301,
					"content": "Gorou, that was pretty brave of you. You clearly don't like having to deal with Miko, but you still agreed to the ceremony and even made your own demands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811302,
					"content": "You think so? I guess I got a burst of courage when I thought about Her Excellency's orders and the people of Watatsumi Island.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811303
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811303,
					"content": "I am the general of Watatsumi Island's armed forces. How can I let something like this defeat me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811304
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811304,
					"content": "I'm ready now. I feel like I'm back on the battlefield. Even if Yae Miko does come to negotiate with me, I won't let myself be pressured by her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811305
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811306
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811306,
					"content": "You still look pretty nervous, though, Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811307,
					"content": "Haha... well, probably because I just realized she might make a cunning counter-request just to toy with me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811308
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811308,
					"content": "Sorry for keeping you all waiting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811309
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811309,
					"content": "How did it go? What did Guuji Yae say?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811310
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811310,
					"content": "Lady Yae has agreed to your request to swap the light novels for books on agricultural science.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811311
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811311,
					"content": "That's great.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811312,
					"content": "Additionally, Lady Yae says that she will include a few extra works, considering your intended use for those books.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811313
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811313,
					"content": "You may accompany me to Yae Publishing House's warehouse to select your preferred books. I believe your return ship leaves tomorrow night? We will package the selected books and take them directly onto the ship for you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811314
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811314,
					"content": "You'll package the books? Then, what about the ceremony?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811315
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811315,
					"content": "Lady Yae said selecting the books may take up a lot of your time and energy. To ensure you have fond memories of the Irodori Festival, she decided to cancel the ceremony.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811316
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811316,
					"content": "Although, she did leave you a letter. You can read it in your own time.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811317
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811317,
					"content": "I didn't think Yae Miko would cancel the ceremony. Huh, I was so convinced that she would try and make a fool out of me. Now it seems like I was overly suspicious of her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811318
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811318,
					"content": "Anyway, I'll go with the editor to pick the books now. I won't trouble you guys anymore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811319,
						722811320
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811319,
					"content": "See you tomorrow night, Gorou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				},
				{
					"id": 722811321,
					"content": "Great. See you tomorrow night.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811320,
					"content": "We'll see you off at the harbor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				}
			]
		},
		{
			"id": 7228116,
			"completionStepIds": [
				7228116
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
