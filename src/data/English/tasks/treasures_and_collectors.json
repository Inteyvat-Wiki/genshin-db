					"nextDialogs": [
						750090202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090202,
					"content": "This little ball... It looks kinda like a component or something. You like it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090203,
					"content": "Rrrah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "Though we didn't dig it up, since we did find it here... It might be something really valuable!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090205,
					"content": "Let's ask when we leave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
