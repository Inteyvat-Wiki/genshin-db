			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411311301,
					"content": "Have you found anything?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311302,
						411311305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311302,
					"content": "I did.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311303
					]
				},
				{
					"id": 411311303,
					"content": "Wonderful! Let me see.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311304,
					"content": "Ah, a fresh Sweet Flower. Not bad at all. It is indeed abnormal. This must be the influence of the meteorites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311305,
					"content": "That might be problematic.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311306
					]
				},
				{
					"id": 411311306,
					"content": "Hmm? What do you mean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311307,
					"content": "You were attacked while gathering flowers by... flowers? There are flowers that attack people?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311308,
					"content": "Aha, that must be the meteorites' influence! That would explain why those flowers are so special.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311309,
					"content": "I'm not sure there's a relation there...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311310
					]
				},
				{
					"id": 411311310,
					"content": "That's right! What do meteorites have to do with flowers, anyway?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411311311,
					"content": "No, no, no, believe me. This flower is most certainly special in some way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311312
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311312,
					"content": "There's nothing special about this flower, though...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311313
					]
				},
				{
					"id": 411311313,
					"content": "No, comrades, no. It was found beside one of those meteorites, so of course there's something special about it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311314
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311314,
					"content": "But this Sweet Flower doesn't look, smell, or feel any different from ordinary ones.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411311315,
					"content": "Well, as for that... that's not something you need to worry about.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311316
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311316,
					"content": "Here's your compensation, as we agreed. It was a pleasure doing business with you.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311317
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311317,
					"content": "Now, how to use this Sweet Flower... In a perfume, or as a bookmark? Perhaps it might even be good dried...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
