					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411311401,
					"content": "Alright then, you both make very good points. The meteorites do seem too dangerous. I shan't endanger myself unnecessarily on their account.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311402
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311402,
					"content": "Ah, but it still seems like such a shame to let such a huge opportunity go by like this...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
