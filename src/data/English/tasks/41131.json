			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411311101,
					"content": "Alright, alright. I understand. You mean to dissuade me from touching those meteorites, don't you?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311102
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311102,
					"content": "I don't think you'll accept this commission either, will you? Well, if you don't want to, it's fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311103
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311103,
					"content": "It'll be difficult to hire more guards on short notice, yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311104
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311104,
					"content": "But I won't give up! Even if I can't get my hands on a meteorite, I won't give this opportunity up so easily!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311105
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311105,
					"content": "Well, Traveler, I may not be going to get a meteorite, but I'll need you to help me with something else.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311106,
					"content": "If those meteorites really are so fascina— I mean, dangerous, that they can cause those who touch them to faint...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311107,
					"content": "Then the things around those fallen meteorites must also have been affected.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311108,
					"content": "Traveler, can you look for something in the area where they fell that you can bring back here? Plants, flowers... anything will do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311109,
						411311111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311109,
					"content": "Got it...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311110
					]
				},
				{
					"id": 411311110,
					"content": "Thank you. I simply cannot let such an opportunity slip by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311111,
					"content": "Is this what merchants are like?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311112
					]
				},
				{
					"id": 411311112,
					"content": "Haha. I'll take that as a compliment. I'm counting on you, then.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113112,
