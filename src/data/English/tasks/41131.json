				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310601,
					"content": "You're doing pretty well for yourself. There's no need to take risks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310602
					]
				},
				{
					"id": 411310602,
					"content": "Risks? Comrade, do you know what we say in Snezhnaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310603
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310603,
					"content": "Pursue perfection, comrade, pursue perfection! We must never rest on our laurels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310604
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310604,
					"content": "Use ever more refined techniques, earn ever more Mora — that is how one should behave as a merchant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113107,
			"completionStepIds": [
				4113107
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
