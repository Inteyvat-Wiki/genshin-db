			},
			"dialogs": [
				{
					"id": 411310201,
					"content": "There will be a lot of monsters, you know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "I do, and that's what I'll need you for, Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113103,
			"completionStepIds": [
				4113103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "I'm sure others have had this idea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "Why, of course — and that's precisely why we should make haste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310303,
					"content": "If you're willing to help, Traveler, let's set out at once.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310304,
					"content": "Every second we spend shooting the breeze is Mora we could stand to lose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310305,
					"content": "Wow, we're not getting through to him at all, are we?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310306,
					"content": "Maybe we can convince him that his scheme won't make money, or that the meteorites are really dangerous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
				4113104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "You'll faint if you touch those meteorites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "Hmm? Ah, yes, I'd heard that rumor. This could certainly pose a problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310403,
					"content": "But I believe that there are machines that can resolve this issue... There should be, right?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310404,
					"content": "Ooh, he's starting to come around. Is he... weighing the profits and losses of this scheme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310405,
					"content": "Let's keep it up. We've got to convince him that this venture won't make money and that the meteorites are super dangerous.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113105,
			"completionStepIds": [
				4113105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310501,
					"content": "Are you sure you can find matching ornaments?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310502
					]
				},
				{
					"id": 411310502,
					"content": "Oh, don't worry about that. I will find them one way or another.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310503
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310503,
					"content": "Silver, gold, precious stones... I should be able to get any of those easily.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
