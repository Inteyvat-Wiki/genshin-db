			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411311201,
					"content": "I wonder if there's any way to turn these meteorites that render people unconscious into normal rock...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311202
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311202,
					"content": "Hmm, no, that's not right. If they turn back into normal rocks, there'd be no profit to be made...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113113,
