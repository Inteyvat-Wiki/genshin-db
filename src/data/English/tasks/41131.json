			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310701,
					"content": "Perhaps you could go to the Adventurers' Guild...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310702
					]
				},
				{
					"id": 411310702,
					"content": "Ha! They rejected my commission, saying that \"you shouldn't touch those meteorites.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310703
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310703,
					"content": "Adventurers' Guild, my foot! There's hardly any spirit of adventure there.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310704
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310704,
					"content": "Isn't that because they also find those meteorites dangerous?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310705
					]
				},
				{
					"id": 411310705,
					"content": "Hmm... When you put it that way, it does make sense. But surely they can't be that dangerous...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113108,
			"completionStepIds": [
				4113108
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310801,
					"content": "Those meteorites are very heavy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310802
					]
				},
				{
					"id": 411310802,
					"content": "Ah, that's a small issue. I have already chartered us a vehicle. Surely those meteorites cannot cause even hot air balloons to stop moving.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113109,
			"completionStepIds": [
				4113109
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310901,
					"content": "Will the Millelith even let you go?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310902
					]
				},
				{
					"id": 411310902,
					"content": "Oh, come now, dear comrade. We're not doing anything illegal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310903
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310903,
					"content": "Understand this: this shower of meteorites is a disaster indeed, but I plan to turn it into opportunity!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113110,
			"completionStepIds": [
				4113110
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411311001,
					"content": "But the people who buy those ornaments will...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411311002
					]
				},
				{
					"id": 411311002,
					"content": "Agh, you're right... Even if I'm able to skirt the issue with machinery, those ornaments will need to be worn, won't they?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311003
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311003,
					"content": "If my customers are rendered unconscious, that... might reflect poorly upon me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311004
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311004,
					"content": "Well, we could fashion it into a decoration that could be displayed far from anyone. But wouldn't that reduce the price significantly?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411311005
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411311005,
					"content": "Hmm, this is tricky...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113111,
			"completionStepIds": [
				4113101,
				4113111,
				4113121
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
