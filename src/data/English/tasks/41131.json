	"talks": [
		{
			"id": 4113101,
			"completionStepIds": [
				4113122
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "Hmm... Not bad. I could make quite a pile off this. But there's just one problem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310102,
					"content": "What problem might that be?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "Eh? Oh, Traveler, it's you. You've come at just the right moment! Might I interest you in a... Let's call it a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310107,
					"content": "...a wonderful, mysterious, never-before-seen, surefire-profit of a business proposition?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310108,
					"content": "I just need a little help from you, and we will both reap great rewards from it.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310104,
					"content": "The Northland Bank is a maximum-security facility, you know.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "Well, of course it is. Why, even the guards are from Snezhnaya. So... Wait, what? What were you thinking about?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310106,
					"content": "It seems as though your travels have broadened your horizons — your thoughts are truly imaginative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310112,
					"content": "But my business proposition is one that is both realistic and down-to-earth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310113,
					"content": "I suppose you know of those meteorites that fell from the sky?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310114,
					"content": "I want to find one of those meteorites, hack a few pieces off it, and bring them back.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310115,
					"content": "Afterwards, we will hire an able craftsman to carve them into jewelry and ornaments...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310116,
					"content": "Think about it. Ornaments made from a meteorite. Rings, necklaces, bracelets and earrings... Sure to fetch a fine price with the rich and wealthy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310117,
					"content": "Your part in this is simple, Traveler. You just need to make sure that my work remains undisturbed by monsters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310118,
					"content": "How about it? Do we have a deal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310119,
					"content": "You shouldn't go near those meteorites.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "What? Why not? I'm not letting this business opportunity pass me by.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310109,
					"content": "Did you find something new in Liyue's legal codices?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "Um, honestly, Liyue's laws are very well written indeed. One can hardly find a single loophole in them.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310111,
					"content": "*cough* B—But that's not the point! I always make sure to follow the law!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
			"id": 4113102,
