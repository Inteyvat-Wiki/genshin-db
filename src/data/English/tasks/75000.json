			"dialogs": [
				{
					"id": 750000901,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}. That'll be your name from now on, little guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000902,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000903
					]
				},
				{
					"id": 750000903,
					"content": "...Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#Looks like our little friend loves this name! Well, with any luck, we'll solve the mystery that surrounds you while we're in Natlan... Ah, and maybe we'll get some clues as to why {NICKNAME} was able to suddenly enter that Saurian's body...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "#Oh yeah, are you okay, by the way, {NICKNAME}? You suddenly turned into a Saurian back there... Are you feeling uncomfortable in any way?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "Oh, just a little Saurian-sick.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "What's that even supposed to mean!? This isn't the time for jokes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Still, {NICKNAME}, Paimon's never heard of anyone in Natlan who can turn into a Saurian... This is kinda weird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "Seriously, we only just got here, and it feels like so much has already happened... Anyway, how do we get outta here?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "Hmm? You know where the exit is?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000908,
					"content": "Becoming a Saurian for a bit was alright.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "Well, it'd best stay that way! Things could go south real fast if some day you were to turn into a Saurian and be unable to transform back...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				}
			]
		},
