			"dialogs": [
				{
					"id": 750000101,
					"content": "Hey, hey, big guy... You okay? Can you stand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000102,
					"content": "Oh no, it looks really weak. Ugh, seriously! Those floaty ghostly dogs are always up to no good... In fact, make that all things floaty!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000103,
					"content": "You're fairly floaty, as floaty things go...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "Paimon's nothing like those guys!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000105,
					"content": "Anyway, forget that for now. Let's see if we can get this guy something to eat, and then... We'll let it rest for a while.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000106,
					"content": "It'll be feeling better soon, Paimon's sure of it!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000107,
					"content": "It's too late...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "No...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000110,
					"content": "...*heavy breathing*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "Big Guy?"
				},
				{
					"id": 750000111,
					"content": "#Oh no. It must be in so much pain, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000112,
					"content": "We've defeated your foes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "...*heavy breathing*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "Big Guy?"
				},
				{
					"id": 750000115,
					"content": "Is... there something else that's on your mind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "Is there... Something you'd like to tell me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "Stretch... out your hand... Chosen of... Dragons... Reach out to me...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "Join... strengths, and then... Witness all... and thus, liberate all...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#What's going on, {NICKNAME}? This is no time to zone out!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000120,
					"content": "It's nothing. Just a bit of a daze...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000121
					]
				},
				{
					"id": 750000121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000122
					],
					"speakerTitle": "Big Guy?"
				},
				{
					"id": 750000122,
					"content": "...Hrooo... Rrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000123
					],
					"speakerTitle": "Big Guy?"
				},
				{
					"id": 750000123,
					"content": "Is that your desire, or...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000124
					]
				},
				{
					"id": 750000124,
					"content": "(Reach out to the dying beast...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000125
					]
				},
				{
					"id": 750000125,
					"content": "What are you doing... Err...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000126,
					"content": "#{NICKNAME}, you...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000113,
					"content": "You can rest now, big guy. You did good.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000108,
					"content": "It's been holding out for far too long...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				}
			]
		},
