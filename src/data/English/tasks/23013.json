			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "Lutong, my dear Lutong, are you sure... this is the place?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130102,
					"content": "Yes, Mr. Garcia, this is where Slimes are most often found.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130103,
					"content": "I am most certain of that. However...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130104,
					"content": "Would you agree that the Slimes are mildly overwhelming in quantity?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130105,
					"content": "Mr. Garcia, this is how we end up when we are caught short financially.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130106,
					"content": "You are... Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "Traveler! What a coincidence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130109,
					"content": "What are you doing here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "Haha. Why, I'm here for...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130111,
					"content": "Trouble.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130112,
					"content": "Valiant adventure! Please, Lutong, could you not...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130113,
					"content": "As you wish, sir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130114,
					"content": "In truth, I'm here to look for Slime Condensate to use as the lubricant for my Numbering Machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130115,
					"content": "Unfortunately, most of the Slime Condensate on sale is of low quality as it's kept for too long. Besides...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130116,
					"content": "Mr. Garcia purchased too many books...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130117,
					"content": "Oh come now, those were... necessary expenditures — that left us short of Mora, yes, but still!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130118,
					"content": "That's why we came here, to collect some fresh Slime Condensate ourselves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130119,
					"content": "But as you can see, though our good Lutong is from Liyue, he knows neither martial arts nor culinary skills.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130120,
					"content": "Fortunately, I have a gift for accounting... all thanks to the complex tax rules of the Ministry of Civil Affairs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130121,
					"content": "...As for me, I can't possibly hit anyone with the components of my Numbering Machine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130122,
					"content": "Do you need my help?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "Well, in a sense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130124,
					"content": "Yes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130125,
					"content": "Lutong, do we... um... do we have any Mora left?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130126,
					"content": "Well, I believe we'll find a way to get by after we pay the Traveler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130127,
					"content": "Splendid. Traveler, I'd appreciate it if you could kindly retrieve some Slime Condensate for me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130107,
					"content": "What brings you here?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
			"id": 2301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
