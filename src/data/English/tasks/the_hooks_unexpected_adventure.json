			"trigger": {
				"objectNames": [
					"Helbet",
					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "Please try the new bait again, Mr. Kayvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "I've done that so many times, but the results are just the same as before!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "Huh? Why are the two of you fishing together again?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "Traveler, we meet again.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Hello, you two.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "Have you found out why the fish refuse to take the bait?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Haha! Nope. A researcher and I tried methods like modifying the fishing rod, adjusting the bait, and improving our techniques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "We tried so many different bodies of water and angles... I even tried fishing in a pond full of fish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "But no matter what I did, I could only fish up things that aren't fish.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "Don't worry, Mr. Kayvan. Didn't that researcher promise to keep researching? He'll definitely determine the reason behind all this for us.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "See, he even designed a new bait for you, and he wants me to stay here with you and record every detail about your fishing process down...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "I hope he really succeeds... But until then, I'll just continue fishing my way.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "If you would, Traveler, could you get me some more material for bait?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "Did you learn anything from the researchers?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
