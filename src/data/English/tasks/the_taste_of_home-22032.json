		},
		{
			"id": 2203208,
			"completionStepIds": [
				2203201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203201",
							"2"
						],
						"stepId": 2203201,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"12042",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "Ahh, it would be nice to have some Liyue cuisine about now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320802,
					"content": "What's the matter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "Huh, that outfit... You're the Traveler, aren't you? I'm sorry, I'm just feeling a little homesick right now...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320804,
					"content": "Did you just say you wanted to have some Liyue cuisine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "Huh? Wait... You know how to make Liyue cuisine? That's great!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320819,
					"content": "Th—Then, please help me! Please make me some authentic Liyue dishes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320820,
					"content": "Let me think... What I'd really like to eat right now is...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320821,
					"content": "Hmm... I want to eat fish! I miss the fish my mom made when I was a kid...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320822,
					"content": "She'd wash the fish, make slashes on both sides, stuff it with spices and aged wine and marinate slightly, fry it in a pan until golden brown...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320823,
					"content": "Then, she'd add hot water and sauce to simmer, before finally seasoning over high heat, thickening the sauce, plating, and serving... Ah, that's the real deal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320824,
					"content": "My younger brother would jump and cheer \"It's ready! The food's ready!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320825,
					"content": "*sobs* My mom is really good at cooking fish, but when can I go back to eat it?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320805,
					"content": "Do you need help with anything?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "Ah, right. Allow me to me introduce myself. I'm Tang Wen, a historian from Liyue. Previously, I was doing some field research on the unique customs and folklore of Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320807,
					"content": "I'd finished collecting all the material I needed, in fact, and was preparing to head back to Liyue. But so many big things have happened in Inazuma recently...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320808,
					"content": "So I feel like I'm living in historic times here, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320809,
					"content": "The happenings of this particular period will certainly leave a strong mark in the annals of Teyvat's history.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320810,
					"content": "To witness such history with one's own eyes, and then record all of it in a true, complete, and clear manner for posterity — that is what a historian should do.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320811,
					"content": "But... as exciting as this cause is to me, it won't satisfy my stomach...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320812,
					"content": "Hungry, are we?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "Well, I wouldn't say that exactly... Inazuma's food is actually pretty tasty.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320814,
					"content": "I really like the tempura here, although it's, well... They just wrap everything in batter and fry it, you know?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320815,
					"content": "But after eating Inazuman cuisine for a long time, I started to miss dishes from back home. Sadly, I couldn't find a restaurant here that could make authentic Liyue cuisine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320816,
					"content": "So I finally decided to post a \"cuisine commission\" at the Adventurers' Guild a few days ago, but there hasn't been any response since...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320817,
					"content": "May I give it a try?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
}