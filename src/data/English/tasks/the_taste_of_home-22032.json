						220320702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320702,
					"content": "Let's see... Paimon's favorite fish dishes lately are...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320703,
					"content": "Spicy Black-Back Perch Stew!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320704,
					"content": "Sweet and sour Squirrel Fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320705,
					"content": "And the almighty Mondstadt Grilled Fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320706,
					"content": "Aren't these all your favorite food?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
