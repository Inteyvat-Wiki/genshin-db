			"dialogs": [
				{
					"id": 220320601,
					"content": "Hmm? Why does th—this dish taste... so... so interesting.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320602,
