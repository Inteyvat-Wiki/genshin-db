						220320203,
						220320204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320203,
					"content": "Please enjoy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "Let's see... What dishes did we talk about just now?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Oh right... Squirrel Fish, Black-Back Perch Stew, and Mondstadt Grilled Fish!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320206,
					"content": "Let's decide and give it to Miss Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
