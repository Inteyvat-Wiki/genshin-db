						220320709
					]
				},
				{
					"id": 220320709,
					"content": "Sounds great! Let's quickly make Black-Back Perch Stew for Miss Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320710,
					"content": "Squirrel Fish then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "Yay! Let's quickly make Squirrel Fish for Miss Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320712,
					"content": "Mondstadt Grilled Fish then.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "Nice! Let's quickly make Mondstadt Grilled Fish for Miss Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
