						751490903
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490903,
					"content": "과거의 성을 넘어 신성한 산의 심장으로 가라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490904
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490904,
					"content": "그림자 속의 적을 제거하고… 불을 붙여… 꺼져가는 잿더미를…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490905
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490905,
					"content": "콜록, 콜록…. 다, 다들 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490906
					],
					"speakerTitle": "페이몬"
				},
				{
