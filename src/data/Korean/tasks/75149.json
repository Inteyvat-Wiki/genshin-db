						751490907
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490907,
					"content": "왜 그래? 머리가 어지러운 거야? 하긴, 그렇게 높은 곳에서 떨어졌으니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490908
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490908,
					"content": "다친 곳은 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490909
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490909,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490910
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490910,
					"content": "#좋았어, 괜찮은 것 같네. {NICKNAME}, 넌…? 괜찮은 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490911,
						751490913
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490911,
					"content": "글쎄, 팔다리는 다 붙어있네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490912
					]
				},
				{
					"id": 751490912,
					"content": "「팔다리는 다 붙어있네」는 무슨! 휴우… 아무튼 다친 곳은 없어 보여서 다행이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490915
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490915,
					"content": "음… 화산 안에 이렇게 큰 공간이 있을 줄이야. 근데 왜 이렇게 어둡지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490916,
						751490918
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490916,
					"content": "얼른 빛을 뿜어 내, 페이몬!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490917
					]
				},
				{
					"id": 751490917,
					"content": "알겠어, 잠깐만…이라고 할 줄 알았냐! 내가 낼 수 있는 건 빚밖에 없다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490920,
					"content": "음… 우선 주변을 탐색해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490921
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490921,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490918,
					"content": "페이몬, 횃불",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490919
					]
				},
				{
					"id": 751490919,
					"content": "당연히 가지고 있을 것처럼 말하지 말라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751490913,
					"content": "정신줄을 놓칠 뻔했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490914
					]
