			"dialogs": [
				{
					"id": 740732201,
					"content": "장치 위쪽의 공간을 자세히 확인했지만 아무것도 찾지 못했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732202
					]
				},
				{
					"id": 740732202,
					"content": "여긴 여전히 아무것도 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740732203,
					"content": "그래서 캐터필러, 우리가 찾고 있는 게 대체 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732204
					],
					"speakerTitle": "안"
				},
				{
					"id": 740732204,
					"content": "우리는 수선화 십자 성검을 단조할 재료를 찾고 있는 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732205
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732205,
					"content": "수선화 십자 결사회는 지하의 나라와 고대 폰타인의 신비 철학을 바탕으로, 그들이 필요로 하는 가상 물질 4개를 물질의 세계에 구현해 냈어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732206
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732206,
					"content": "이해할 수 없습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732207
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 740732207,
					"content": "신비한 것은 경험에만 작용해. 원소력보다 더 상식을 벗어난다고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732208
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732208,
					"content": "저는 몇십 년 전 아카데미아 소론파의 교재를 입문에서 중급까지 수록했습니다만, 원소력도 그렇게 신기하진 않았습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732209
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 740732209,
					"content": "그래? 어쨌든 결론적으로 이건 폰타인의 고대법과 지하 고대 국가의 기술이 합쳐진 거라고 보면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732210
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732210,
					"content": "세상에는 「기억」, 「염원」, 「영혼」, 그리고 「인격」이라는 네 가지 물질이 나타났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732211
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732211,
					"content": "혼동을 방지하기 위해 「기억」의 결정, 「염원」의 결정, 「영혼」의 결정, 그리고 「인격」의 결정이라고 부를게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732212
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732212,
					"content": "그게 왜 성검을 만드는 데 필요한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740732213,
					"content": "수선화 십자 결사회의 신비 철학에서 신전은 축소된 우주를, 구성원은 신들의 대행자를, 성스러운 기름은 단련의 의지를 의미하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732214
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732214,
					"content": "성검은 모든 걸 절단하는 「이성」이야. 그건 온전한 사람의 의지로부터 태어나야 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732215
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732215,
					"content": "굉장히 심오하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732216
					]
				},
				{
					"id": 740732216,
					"content": "하하, 신비 철학이라는 게 원래 그래. 비슷하다 싶으면 다 갖다 붙이는 거야. 이런 게 마법이 되면 가짜가 진짜로 변하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732217
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732217,
					"content": "아무튼 빨리 다음 장소로 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐터필러"
				}
			]
