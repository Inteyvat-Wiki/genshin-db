			"dialogs": [
				{
					"id": 740732101,
					"content": "장치 위쪽의 공간을 자세히 확인했지만 아무것도 찾지 못했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732102
					]
				},
				{
					"id": 740732102,
					"content": "결국 여기에는 아무것도 없는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740732103,
					"content": "그렇지 않아. 분명 누군가가 먼저 가져간 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732104
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732104,
					"content": "그럼 우리 계획은 실패한 거잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740732105,
					"content": "「이성」이 탄생하려면 4개의 상한이 하나로 합쳐져야 해. 나머지 상한을 먼저 확보한다면 아직 기회는 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732106
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740732106,
					"content": "그럼 서둘러서 다음 장소로 이동하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안"
				}
			]
