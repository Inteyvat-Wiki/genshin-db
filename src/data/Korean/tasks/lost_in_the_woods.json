			"dialogs": [
				{
					"id": 750000101,
					"content": "이봐… 덩치, 너 괜찮아? 일어날 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750000102,
					"content": "아주 허약해 보이네. 대체 무슨 일이 있었던 거지…? 그 떠다니는 개들은 정말 짜증이 난다니까. 역시 떠다니는 녀석 중에 좋은 녀석은 단 하나도 없다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750000103,
					"content": "너도 떠다니잖아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "지금 날 그딴 녀석들이랑 같은 취급하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750000105,
					"content": "#{NICKNAME}, 이 얘긴 그만하고, 어서 먹을 걸 찾아서 이 덩치에게 먹여준 다음… 푹 쉬게 해주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750000106,
					"content": "그러면 기운을 어느 정도 차릴 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750000107,
					"content": "이미 늦었어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "이럴 수가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750000110,
					"content": "…후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "덩치?"
				},
				{
					"id": 750000111,
					"content": "#흑흑, 얘 지금 엄청 괴로운가 봐, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750000112,
					"content": "적은 내가 처리했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "…후후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "덩치?"
				},
				{
					"id": 750000115,
					"content": "아직도… 미련이 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "뭔가… 알려주고 싶은 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "손을… 손을 내밀라. 용에게… 선택받은 자여… 손을 내밀라…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "힘을… 연결하고, 모든 것을 목격한 뒤, 모든 것을 해방하라…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#{NICKNAME}, 왜 그래! 빨리, 뭐라도 하라구. 지금은 멍때리고 있을 때가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750000120,
					"content": "아, 잠깐 헛것을 본 것 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000121
					]
				},
				{
					"id": 750000121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000122
					],
					"speakerTitle": "덩치?"
				},
				{
					"id": 750000122,
					"content": "……우… 우…",
