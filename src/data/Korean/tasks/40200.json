				]
			},
			"dialogs": [
				{
					"id": 402000101,
					"content": "야경이 좋네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000102
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000102,
					"content": "밤바람에서 느껴지는 바다 이슬 꽃의 산뜻함, 거리 향수 가게의 향기, 그리고 진한 커피 향까지. 참 평화로워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000103
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000103,
					"content": "옥상에 테라스가 있는 작은 술집에서 스파클 와인 두 잔을 곁들이면, 절묘한 취기를 만끽할 수 있을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000104,
						402000105
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000104,
					"content": "지금은 한가로운 휴가니까 마시자고요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				},
				{
					"id": 402000106,
					"content": "그래… 그럼 같이 찾아보자. 성안 어딘가에 놀랄 만한 보물 술집이 숨겨져 있으려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000107
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000107,
					"content": "다만 카브리에르 상회가 문을 닫기 전에 나랑 같이 이 옷에 어울릴 만한 향수 몇 병 골라주겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000108
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000108,
					"content": "거기에 정교한 시계, 흥미로운 태엽 장식, 독특한 공예의 장신구 같은 기념품들도 빼먹을 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000109,
						402000110
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000109,
					"content": "일을 할수록 소비욕이 강해지는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000111,
					"content": "티바트에서 가장 견문이 넓고 독특한 심미관을 지닌 여행자가 옆에 있는데, 당연히 이번 기회를 꽉 잡아야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000112
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000112,
					"content": "흠… 만족이야. 썩 괜찮은 이국 여행이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000113
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000113,
					"content": "넉넉하게 사나흘 천천히 즐기면 촉박함으로 인한 아쉬움이 덜할 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000114,
						402000115
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000114,
					"content": "휴가를 마음껏 즐기겠다고 했잖아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000116,
					"content": "어쩔 수 없어, 벌써 다음 일거리가 들어왔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000117
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000117,
					"content": "이번 사건의 정식 보고서 작성과 화물 통관 체계 개선에 협조도 해야 하고, 다음 임무 지점으로 이동할 준비도 해야 해——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000118
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000118,
					"content": "노드크라이 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000119,
						402000120
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000119,
					"content": "저랑 페이몬의 다음 목적지도 거기예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000121,
					"content": "안심해. 그냥 정보 쪽 동료를 만나서 서로 이득이 될 방안만 확인하는 거니까. 서로 간섭하지 않을 경계도 포함해서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000122
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000122,
					"content": "자세한 건 나중에 얘기하고, 이 즐거운 폰타인 여행을 기념으로 같이 사진 한 장 찍을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000123,
						402000124
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000123,
					"content": "저를 업계로 이끌어준 걸 기념하기 위해서도요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000125,
					"content": "#그래, 이젠 내 등 뒤를 완전히 맡길 수 있겠어, 신예 에이스 수사 요원 {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000126
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000126,
					"content": "가장 중요한 「영상 기록 장치」로 이 중대한 순간을 촬영하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000127
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402000127,
					"content": "노드크라이에서 만날 때도 이번처럼 완벽한 협력을 기대할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야란"
				},
				{
					"id": 402000124,
					"content": "우리의 성공적인 협력을 기념하기 위해서도요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000120,
					"content": "어떤 긴급 상황이 발생한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000115,
					"content": "왜 또 일하러 가려는 것 같죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000110,
					"content": "소비욕을 터뜨릴 때는 바로 지금입니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000105,
					"content": "큰 사건을 하나 끝냈으니 마음껏 마시죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				}
			]
		},
		{
			"id": 4020002,
			"completionStepIds": [],
