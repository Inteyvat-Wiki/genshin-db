				]
			},
			"dialogs": [
				{
					"id": 100051301,
					"content": "알베도, 웬일로 한가해 보이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051302
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051302,
					"content": "뭐, 라인도티르 주인님이 남기신 「과제」를 완수했으니, 조금은 쉬어도 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051303
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051303,
					"content": "봐! 말을 채 끝내기도 전에 귀찮은 일이 찾아왔잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051304,
					"content": "세바스, 여긴 어쩐 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051305
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051305,
					"content": "알베도, 아는 사이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051306
					]
				},
				{
					"id": 100051306,
					"content": "응. 세바스도 라인도티르 스승님의 창조물이야. 굳이 따지자면 내 「가족 구성원」이라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051307
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051307,
					"content": "역시 네 가족 관계는 특이하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051308
					]
				},
				{
					"id": 100051308,
					"content": "굳이 따지자면? 그게 무슨 말투지? 그 큰 집에 딱 하나 있는 집사인 나한테",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051309
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051309,
					"content": "너와 라인도티르 주인님이 사용한 병이나 기구도 전부 내가 혼자 치운단 말이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051310
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051310,
					"content": "너… 고양이 아니야? 고양이가 어떻게 집사를 해? 병이랑 기구도 정리하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051311,
					"content": "넌 어떻게 하늘을 날지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051312
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051312,
					"content": "응? 난 원래 이랬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051313,
					"content": "나도 마찬가지야. 이미 존재하는 사실을 문제 삼지 마. 애초에 답이 없는 문제니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051314
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051314,
					"content": "너, 너어어… 왠지 열받아! 나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051315,
						100051316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051315,
					"content": "페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				},
				{
					"id": 100051317,
					"content": "나… 이제 쟤 얘기 안 들을래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051318,
					"content": "됐어, 잡담은 여기까지. 알베도, 라인도티르 주인님의 명령으로 전언을 전하러 왔다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051319
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051319,
					"content": "크흠… 큼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051320
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051320,
					"content": "「알베도, 네가 그 과제에 대해 『스스로 납득할 수 있는 해답』을 찾아서 기뻐」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051321
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051321,
					"content": "「하지만, 해답을 찾은 문제는 더 이상 생각할 의미가 없어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051322
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051322,
					"content": "「네 머릿속에서 쉬지 않고 흔들리는 시계추가, 이제는 『무료함』에 닿을 때가 됐겠지?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051323
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051323,
					"content": "「그럼, 이번에는 너 스스로에게 한 번 질문해 보렴」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051324
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051324,
					"content": "「『알고 있는 답』을 버리고 『미지의 문제』를 찾는 거야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051325
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051325,
					"content": "「문제는 언제나 답보다 재미있어. 시간을 때우기에도 훨씬 좋지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051326
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051326,
					"content": "「다음에 만날 때, 네가 어떤 『문제』를 가져올지 정말 기대되는걸」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051327
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051327,
					"content": "「만약 나조차 생각하지 못한 문제를 발견한다면 더할 나위 없이 좋겠지만…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051328
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051328,
					"content": "「그럴 가능성은 희박할 거야. 그래도 일단 노력해 보렴. 운이 좋으면 날 깜짝 놀라게 할 수 있을지도 모르지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051329
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051329,
					"content": "「참, 문제를 고민하거나 답을 찾기 위한 『자신』을 따로 만들어 내진 마. 내가 이미 해봤는데 소용없더라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051330
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051330,
					"content": "「마지막으로, 세바스를 통해 선물을 하나 보냈으니까 받아둬. 세바스는 배고픔을 느끼지 않으니까 먹을 거 주지 말고」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051331
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051331,
					"content": "가르침을 따를게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051332
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051332,
					"content": "크흠, 크흐흠… 라인도티르 주인님의 말씀은 여기까지야… 정말 힘들군, 켁켁… 크흠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051333
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051333,
					"content": "그럼 난 이만 이 얼어 죽을 것 같은 곳에서 가보겠어. 몬드성에도 말을 전해야 할 사람이 있어서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051334
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051334,
					"content": "몬드성?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051335
					]
				},
				{
					"id": 100051335,
					"content": "몬드성에 라인도티르와 관련된 사람이라면… 아! 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051336
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051336,
					"content": "그는 「갓 탄생한」 존재지만, 라인도티르 주인님께서는 일찍이 그가 해결해야 할 「과제」를 예견해 두셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051337
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051337,
					"content": "됐어, 이제 정말 가봐야겠다. 너무 추워서 꼬리가 다 아파",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051338
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051338,
					"content": "라인도티르 주인님께서 보내신 「선물」은 테이블 위에 놓아뒀으니, 잊지 말고 잘 챙기도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051339
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051339,
					"content": "알베도… 네 가족 관계가 점점 더 복잡해지는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051340
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051340,
					"content": "이젠 고양이까지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051341
					]
				},
				{
					"id": 100051341,
					"content": "그치만 이 고양이를 정말 「가족 구성원」이라고 할 수 있어? 집사라고 주장하긴 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051342
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051342,
					"content": "세바스는 스승님이 아주 오래전에 만들어낸 존재야. 일반적인 논리대로면, 내 「손윗사람」인 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051343
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051343,
					"content": "다만 우리는 일반적인 「가족」이 아니니까, 그런 정의는 의미가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051344
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051344,
					"content": "하지만 그 시절에 세바스의 보살핌을 많이 받은 건 사실이야. 병이나 기구도 정리해 주고, 가끔은 내 그림 모델이 되어 주기도 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051345
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051345,
					"content": "잠깐만, 혹시 오늘 그린 이 고양이가 세바스야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051346
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051346,
					"content": "맞아. 이건 내 버릇인데, 뭔가를 생각할 때 무의식적으로 손을 같이 움직이는 편이야. 이러면 생각이 더 잘 정리되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051347
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051347,
					"content": "이때 보통 세바스의 초상화를 그리곤 하지…. 수도 없이 그려서 이젠 생각하지 않아도 손이 알아서 움직이는 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051348,
						100051349
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051348,
					"content": "그러고 보니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051350,
					"content": "그냥 평범한 고양이인 줄 알았는데! 그런 배경이 있었을 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051351
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100051351,
					"content": "이제 너희도 이 고양이의 이름을 알게 됐네. 나중에 시간 되면 우리에 대해 더 자세히 이야기해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051352
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051352,
					"content": "하지만 지금은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051353
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051353,
					"content": "「나무는 가장 완벽한 열매를 자랑으로 여긴다. 그것은 참으로 원만하고 흠잡을 데 없다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051354
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051354,
					"content": "「하지만 꿈이 깃든 씨앗이여, 껍질 속 우주의 왕으로 그치지 말아라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051355
					],
					"speakerTitle": "「라인도티르」"
				},
				{
					"id": 100051355,
					"content": "…생각을 좀 해야 할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 100051349,
					"content": "전에도 알베도가 고양이를 그린 걸 본 적이 있어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051316,
					"content": "세바스의 주인은 라인도티르야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				}
			]
		},
