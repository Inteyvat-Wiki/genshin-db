			"dialogs": [
				{
					"id": 100050201,
					"content": "알베도, 역시 여기 있었구나. 음… 그림 그리고 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100050202,
					"content": "응. 전엔 너무 바빠서 시간이 없었는데, 요즘 좀 한가해져서 다시 연습 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050203
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050203,
					"content": "많은 일을 겪긴 했지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050204
					]
				},
				{
					"id": 100050204,
					"content": "맞아. 그래도 너희랑 기사단 사람들이 도와준 덕분에 무사히 해결할 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050205
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050205,
					"content": "스승님이 내게 남긴 마지막 과제도 해결했고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050206
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050206,
					"content": "결과만 놓고 보자면 더없이 완벽해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050207
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050207,
					"content": "설탕은 최근 성장이 빨라서, 이젠 혼자서도 연금술 관련 업무를 많이 처리하고 있고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050208
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050208,
					"content": "기사단에도 당장은 내가 나서야 하는 일이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050209
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050209,
					"content": "과제도, 업무도, 귀찮은 일도 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050210,
						100050211
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050210,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				},
				{
					"id": 100050212,
					"content": "아니야. 그냥, 매일 머리를 쓰는 생활에 너무 익숙해졌었나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050213
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050213,
					"content": "갑자기 이렇게 한가해지니까, 솔직히 조금 적응이 안 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050214
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050214,
					"content": "나도 모르게 자꾸 해결해야 할 문제가 있는지 생각하게 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050215
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050215,
					"content": "하지만 아쉽게도, 지금의 몬드성은 이미 모든 문제의 「완벽한 해답」을 찾은 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050216
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050216,
					"content": "잠깐 쉬어가는 것도 나쁘지 않아. 매일 너무 바쁘게 움직이면 몸이 지쳐버린다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100050217,
					"content": "정 기운이 안 나면 우리랑 같이 놀러 가자. 게으름 피우는 건 내 전문이거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100050218,
					"content": "하하, 그럼 페이몬한테 한 수 배워야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050219,
						100050220
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 100050219,
					"content": "진짜로 해결할 문제가 필요하다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050221,
					"content": "쉬잇! 그런 말 하지 마! 네가 그런 말을 할 때마다 매번 귀찮은 일이——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100050220,
					"content": "걱정하지 마, 내가 있는 곳엔 언제나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050211,
					"content": "별로 안 좋은 일처럼 말하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				}
			]
		},
