					"nextDialogs": [
						100051403
					],
					"speakerTitle": "세바스"
				},
				{
					"id": 100051403,
					"content": "으악! 세, 세바스, 갑자기 어디서 튀어나온 거야? 전혀 눈치 못 챘어",
					"roleType": "TALK_ROLE_NPC",
