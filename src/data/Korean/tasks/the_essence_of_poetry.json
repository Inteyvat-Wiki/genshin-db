			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "구체적으로 왜 「안 된다는」 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "청주"
				},
				{
					"id": 225010202,
					"content": "운석을 만지면 잠에 빠질 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "음, 저도 그런 얘길 듣긴 했습니다. 하지만 가까이서 보기만 한다면 괜찮지 않을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "청주"
				},
				{
					"id": 225010204,
					"content": "절대 운석을 안 만지겠다고 맹세할 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "그…그야 물론이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "청주"
				}
			]
		},
