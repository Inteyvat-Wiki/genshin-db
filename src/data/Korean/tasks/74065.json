			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"무푸알"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740650301,
					"content": "왜 이제야 오는 거야? 원류바다 이종은 이미 우리가 다 쫓아냈다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740650302,
					"content": "그러고 보니, 드디어 나도 겪어보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "무푸알"
				},
				{
					"id": 740650303,
					"content": "겪어 보다니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740650304,
					"content": "현장에 있는 다른 사람들이 내가 도착하기 전에 사건을 다 해결해서, 난 아무것도 할 필요가 없는 상황 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "무푸알"
				},
				{
					"id": 740650305,
					"content": "이건 너희 보수야. 정말 고마워. 오늘은 두 다리 쭉 뻗고 잘 수 있겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "무푸알"
				}
			]
		}
	]
