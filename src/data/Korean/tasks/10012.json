						100120394
					],
					"speakerTitle": "테오도르"
				},
				{
					"id": 100120394,
					"content": "…오늘 밤에, 목표를 데려와야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120395
					],
					"speakerTitle": "로엔"
				},
				{
					"id": 100120395,
					"content": "그리고 그 목표는… 우리와 함께 「지옥」으로 떨어질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "로엔"
				},
				{
					"id": 100120338,
					"content": "초대 대단장과도 겨룬 적이 있다면서요?",
