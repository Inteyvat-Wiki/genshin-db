					"nextDialogs": [
						100120393
					],
					"speakerTitle": "로엔"
				},
				{
					"id": 100120393,
					"content": "그럼… 이제 뭘 어쩌자는 거야?",
					"roleType": "TALK_ROLE_NPC",
