				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "오늘 어떤 점장의 장사가 잘되는 걸 봤어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "음… 장사가 잘돼서 부자가 된다? 좋아, 아주 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071103,
					"content": "끈기 있게 기다리면서 심혈을 다해 장사를 하면 분명히 성공할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071104,
					"content": "이건 분명 인생이든 사랑이든 전부 같다고 알려주는 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071105,
					"content": "큼! 흠흠… 그 정말 고마워. 난 천천히 잘 생각해 봐야 할 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071106,
					"content": "기명 누나! 나도 언젠간…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지화"
				}
			]
		},
