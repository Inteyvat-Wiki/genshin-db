			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"지화"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071801,
					"content": "고양이 한 마리랑 물고기가 친구가 됐어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071802
					]
				},
				{
					"id": 221071802,
					"content": "이런 것도 찾아내다니… 정말 열심히 찾아줬구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071803
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071803,
					"content": "그런 우정이라니… 그 고양이든 물고기든 전부 엄청 위대한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071804
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071804,
					"content": "완전히 사랑이잖아! 사랑의 힘이면 모든 걸 초월할 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071805
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071805,
					"content": "괜찮다면 그 둘에게 경의를 표하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071806
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071806,
					"content": "특히 그 물고기 말이야. 상대방이 고양이인 걸 알면서도 최선을 다해 표현했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071807
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071807,
					"content": "그럼 이제 당신의 마음을 표현하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071808
					]
				},
				{
					"id": 221071808,
					"content": "무슨 뜻이야? 그 물고기를 가져온 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071809
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071809,
					"content": "너… 혹시… 설마 그 물고기를 잡은 건 아니지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071810
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071810,
					"content": "이런 종을 뛰어넘는 우정은 최선을 다해 지켜줘야 하는 거 아냐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071811,
					"content": "게다가 이런 좋은 징조를 어렵게 찾았는데 무슨 짓을 한 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071812,
					"content": "됐어, 나 혼자 있게 해줘. 조용히 생각할 게 있으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지화"
				}
			]
		},
