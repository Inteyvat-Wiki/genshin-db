				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "지붕 위에 새 한 쌍이 있었어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "음…! 그거 좋은데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071003,
					"content": "비둘기 두 마리가 무리에서 벗어나 서로만을 바라보고 상대방을 위해서만 날개를 활짝 펼치고 하늘을 난다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071004,
					"content": "이건 나도 나만 사랑해주는 이를 만날 수 있다는 걸 암시하고 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071005,
					"content": "그리고 그녀와 함께 어려움을 극복하고 혼잡한 인파 속에서 벗어나 자유의 날개를 같이 펼친다는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221071006,
					"content": "큼! 수고했어…. 기명 누나를 다시 한번 찾아가 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지화"
				}
			]
		},
		{
