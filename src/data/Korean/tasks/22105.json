			"dialogs": [
				{
					"id": 221050101,
					"content": "완전 짜증 나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221050102,
					"content": "왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "이 객잔 주변이 좀 이상한 것 같은데, 그게 정확히 뭔질 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221050104,
					"content": "게다가 유달리 민감한 사람들만 우리 객잔에 묵어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221050105,
					"content": "조금만 영향을 받아도 문짝이 떨어지고 마루판도 좀 부서진다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221050106,
					"content": "손님들이 수리비를 내긴 하지만 곳곳이 망가져있어서 외관상 좋지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221050107,
					"content": "난 여기서 손님을 받고 있을 테니까, 객잔 주변을 한번 둘러봐줄래? 이상한 게 있으면 처리해주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221050108,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221050109,
					"content": "이 손님들은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "손님? 신경 쓰지 마. 일 년 내내 밖에서 고생하는 사람들이니까. 민감할 수밖에 없지 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221050112,
					"content": "주변을 둘러보는 것뿐이니까 어렵진 않을 거야. 그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르 고데트"
				}
			]
