			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이오로이"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "이오로이, 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740102,
					"content": "낭! 들키다니! 너희는 대체… 이 냄새는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740103,
					"content": "젊은 친구, 너희였구나. 하도 오랜만이라 냄새를 잊었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740104,
					"content": "이오로이는 그대로네, 아직도 사람만 보면 무서워해! 그리고 여전히 돌 안에 갇혀 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740105,
					"content": "낭?! 이 어린 녀석이, 그 말, 무슨 뜻이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740106,
					"content": "이오로이의 봉인이 하루라도 빨리 풀렸으면 좋겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "고작 인간의 봉인 따위! 내가 조금만 힘을 쓰면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740109,
					"content": "크흠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740111,
					"content": "#흥, 어쨌든 아이들이 네 신세를 많이 진 것 같더군. 작은 너구리들이 냄새가 좋은 노란 털 {F#이모가}{M#삼촌이} 자주 놀아줘서 기분 좋다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740112,
					"content": "#노란 털 {F#이모}{M#삼촌}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "나는 모든 인간이 너구리 요괴 일족을 봉인한 녀석처럼 나쁘고 무섭다고 생각했는데 지금 보니까 착한 인간도 있는 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740116,
					"content": "대부분의 사람은 착해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "#맞아, 나랑 {NICKNAME}이(가) 만난 사람들은 대부분 착했어. 이오로이가 봉인 당한 것도 비녀를 훔쳐서였잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740119,
					"content": "흥, 비녀는 이미 돌려줬잖아. 나중에 산령 선방을 따라 법술을 배우는 녀석을 만나게 되면 내 봉인을 풀어 달라고 말해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740120,
					"content": "내가 여기 이렇게 오래 앉아 있게 된 건 다 그 망할 여우 녀석 때문이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740121,
					"content": "(투덜거리는 이오로이는 딱 할아버지 같아)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740122,
					"content": "(나이가 엄청 많은 건 사실이니까)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "젊은 친구, 너희들은 손도, 발도 돌이 아니니까 분명 많은 곳에 가 봤겠지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740124,
					"content": "#흐흥, 나와 {NICKNAME}(은)는 바다 건너편에서 왔다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740125,
					"content": "이오로이에게 리월과 몬드 얘기를 해준다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "…바깥세상에 이렇게 많은 곳들이 있었다니, 정말 굉장하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740127,
					"content": "지금까지 내게 보고를 하는 건 작은 너구리들밖에 없었거든, 그래서 바깥세상이 어떤지 전혀 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740128,
					"content": "예전에 난 요고우산 꼭대기에서 북쪽의 바다 건너편을 바라봤어. 거기엔 엄청 높은 산이 있었거든. 어쩌면 요고우산보다 더 높을지도 몰라. 그래서 거기가 대체 어딘지 늘 궁금했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740129,
					"content": "그 방향은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "그 방향은 아마 드래곤 스파인일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740132,
					"content": "우낭낭, 설산… 듣기만 해도 뱃가죽이 시리네. 그 녀석은 대체 왜 그런 곳에 가려고 했는지 알 수가 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740133,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740134,
					"content": "크흠, 전에도 얘기했지만 너희는 좋은 인간이야, 그러니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740135,
					"content": "뭔가 부탁할 일이 있는 말투네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740136,
					"content": "낭! 난 쇼군님의 명을 받고 진수의 숲을 지키는 은신 수호사정님이시다! 돌에 봉인되지만 않았어도 8 다다미 같은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740137,
					"content": "우리가 도울 일이 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "나는 자유롭게 움직일 수 없지만 아이들은 괜찮아. 너희들한테 작은 너구리를 데리고 바깥세상에서 「수행」하는 걸 부탁하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740144,
					"content": "데려갈 작은 너구리는 「길법사」야. 지난번에 너희랑 같이 논 후부터 너희를 다시 만나고 싶다는 얘길 입에 달고 살거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740145,
					"content": "괜찮긴 한데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "응, 우린 길법사의 말을 알아들을 수 없으니까 같이 여행하는 건 어렵지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740148,
					"content": "그럴 리가. 우리 너구리 요괴 일족은 인간들의 말을 알아들을 수 있어. 하지만 너희 인간들은 평범한 너구리 요괴의 언어를 알아들을 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740149,
					"content": "뭐어! 그랬단 말이야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740150,
					"content": "하지만 여행 동료라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "여행하면서 얘기를 나누는 게 더 좋은 거 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#페이몬과 {NICKNAME}처럼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740153,
					"content": "낭, 하는 수 없군. 전에 너구리 요괴 일족의 법술로 너희들에게 밥을 만들어 준 적이 있었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740154,
					"content": "내가 지금 이 모양 이 꼴이지만 길법사가 하는 말을 알아들을 수 있게 하는 「밥」을 만드는 일쯤이야 어렵지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740155,
					"content": "오예! 맛있는 거다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740156,
					"content": "맛있는 거까진 아니야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "흥, 내 솜씨를 얕보지 말라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740158,
					"content": "이오로이가 어디서 만들어 낸 건지 자세히 설명하긴 어렵지만…\\n어쨌든, 페이몬과 여행자는 이오로이의 뱃가죽 위에 놓인 「맛있어 보이는」 음식을 먹는다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "정말 맛있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740160,
					"content": "그건 물론이지, 난 과거 진흙 덩어리와 너구리 털로 모둠 회를 만들어 오가타 오니 네 마리를 쩔쩔매게 만든 이오로이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 726740161,
					"content": "이오로이 대단해! 그럼 아까 우리가 먹은 건 뭐로 만든 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740162,
					"content": "어떤 일은 모르는 게 약일 때도 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726740164,
