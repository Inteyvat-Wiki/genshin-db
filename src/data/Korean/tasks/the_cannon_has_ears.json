							2288.888,
							469.032,
							4564.64
						],
						"pointId": 340300480
					}
				]
			},
			"dialogs": [
				{
					"id": 746870301,
					"content": "와, 드디어 교대다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "마린"
				},
				{
					"id": 746870302,
					"content": "어라? 두 분이 여긴 어쩐 일이세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "마린"
				},
				{
					"id": 746870303,
					"content": "뭐… 뭔가 문제라도 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "우리 언제 만난 적이 있던가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746870305,
					"content": "아뇨, 오히려 더 좋죠! 두 분처럼 대단한 사람들이 도와주러 온 거니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "마린"
				},
				{
					"id": 746870306,
					"content": "직장에서도, 마을에서도 모두가 두 분이라면 어떤 일이든 안심하고 맡길 수 있다고 말했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "마린"
				},
				{
					"id": 746870311,
					"content": "그에 비하면 저쪽의 두 분은, 믿을 수 있을 것 같기는 한데… 뭔가 말로 설명할 수 없는 묘한 이질감이 느껴진단 말이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "마린"
				},
				{
					"id": 746870312,
					"content": "하긴, 인간의 마음은 굉장히 복잡하니까… 슬쩍 한 번 도와주는 게 좋으려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "마린"
				},
				{
					"id": 746870313,
					"content": "이질감이라뇨?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "아니에요, 일단 급한 일부터 처리하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "마린"
				},
				{
					"id": 746870315,
					"content": "포탑 조작법은 어렵지 않아요. 두 분이라면 순식간에 한 녀석도 남기지 않고 처리할 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마린"
				},
				{
					"id": 746870307,
					"content": "우리 전에 만난 적 있지 않나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "기억하고 계시네요? 전에 「슈벨마 시네마 파크」에서 직원을 모집할 때 이력서를 냈었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "마린"
				},
				{
					"id": 746870309,
					"content": "어… 그, 그랬던 것 같기도 하고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746870310,
					"content": "두 분의 실력은 이미 잘 알고 있으니까 어떤 일이든 맡길 수 있겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "마린"
				}
			]
		}
	]
}