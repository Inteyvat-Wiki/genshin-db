				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "음? 이 광석이랑 이 광석은 다른 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300102,
					"content": "물론이지, 이 두 광석으로 만든 물건은 품질도 가격도 완전히 다르단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "장 씨"
				},
				{
					"id": 210300103,
					"content": "음… 근데 이 두 광석은 왜 이렇게 조금밖에 안 남은 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300104,
					"content": "휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "장 씨"
				},
				{
					"id": 210300105,
					"content": "뭐 하고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "#{F#누나}{M#형아} 안녕하세요, 지금 아빠를 도와 주문한 철기를 검사하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300107,
					"content": "대장장이 아저씨가 저한테 작은 검을 하나 만들어준다고 했어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300108,
					"content": "근데 요즘 원료가 부족해서 아빠가 주문한 철기들이 늦게 도착할 거 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300109,
					"content": "제 검은 언제쯤 만들어질지 모르겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300110,
					"content": "휴, 어쩔 수 없어 요즘 손님들이 너무 많아서 광석을 거의 다 썼거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "장 씨"
				},
				{
					"id": 210300111,
					"content": "광물이 많이 나는 곳은 마물들이 차지하고 있어서 채광을 하러 갈 수도 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "장 씨"
				},
				{
					"id": 210300112,
					"content": "어쩔 수 없이 시간이 좀 지난 후에 모험가들이랑 같이 채광하러 가야 할 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "장 씨"
				},
				{
					"id": 210300113,
					"content": "그럼 전 언제까지 기다려요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300114,
					"content": "#제가 다른 사람이 말하는 걸 들었는데요, {F#누나}{M#형아}가 마물을 잘 물리치지 않나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300115,
					"content": "혹시 도와주실 수 있나요? 제발 부탁드릴게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300116,
					"content": "내게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "혹시 가서 상황을 좀 알아봐 줄 수 있을까? 평소에 채광을 하던 장소를 지도에 표시해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "장 씨"
				},
				{
					"id": 210300119,
					"content": "음, 다 됐어, 이곳들이야. 마물들이 많으니까 조심해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "장 씨"
				},
				{
					"id": 210300120,
					"content": "#그럼 부탁드릴게요, {F#누나}{M#형아}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				},
				{
					"id": 210300117,
					"content": "알, 알겠어… 방법을 생각해 볼게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
