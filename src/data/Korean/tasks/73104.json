	"talks": [
		{
			"id": 7310401,
			"completionStepIds": [
				7310401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310401",
							"2"
						],
						"stepId": 7310401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"케이반",
					"호베트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "좀 도와주세요. 진심으로 일을 부탁하러 당신을 찾아온 거잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040102,
					"content": "안 돼요. 도와줄 수 없으니 그만 돌아가세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040103,
					"content": "오잉, 둘이 왜 다투고 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731040104,
					"content": "이봐요, 이방인. 혹시 날 대신해 이 아가씨를 설득해 줄 수 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040105,
					"content": "갑자기 찾아와서는 놔주질 않아요. 나보고 자기를 도와 골동품들을 낚아달래요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040106,
					"content": "물고기들이 다 도망가 버린 건 고사하고, 계속 이렇게 내 소중한 시간을 허비하고 있다고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040107,
					"content": "이봐요, 아가씨. 이렇게 서두르는 걸 보니 설마 골동품을 낚아 큰돈이라도 벌겠다는 심산인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040108,
					"content": "그런 게 아니에요, 케이반 씨. 전 아카데미아의 협력처에서 일하고 있는 호베트예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040109,
					"content": "그 골동품들은 아카데미아에서 연구를 위해 수집한 유물이고, 전 그걸 관리하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040110,
					"content": "하지만 바로 어제, 유물을 운송하는 배에 문제가 생겼어요. 그 바람에 몇 개가 강에 빠져 물살을 타고 하류로 흘러들었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040111,
					"content": "그럼 전문 인양단을 찾아야죠! 나 같은 낚시꾼을 찾아서 어쩌자는 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040112,
					"content": "인양단을 찾는 건 너무 오래 걸려요. 전에 「낚싯바늘 끝의 절경」으로 불리는 케이반 씨가 거의 매일 유실물을 낚는다는 얘길 들었거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040113,
					"content": "게다가 케이반 씨는 이곳 수역에서 자주 낚시하시잖아요. 그래서 유물을 낚아달라고 부탁하려고요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040114,
					"content": "급한 마음에 지푸라기라도 잡으려는 거네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "크흠, 호베트 아가씨. 아가씨 일은 안타깝지만 저는 일개 어부일 뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040118,
					"content": "전 오직 물고기를 낚기 위해 낚싯대를 던지죠. 그러니 낚여 올라오는 것도 물고기뿐이랍니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040119,
					"content": "그런데 물고기는 아직 한 마리도 낚지 못했잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731040120,
					"content": "쳇! 전 낚시 기술을 연마하겠다는 일념뿐이라 다른 목적을 위해 낚시할 생각은 추호도 없다고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040121,
					"content": "그러니 다른 사람에게 부탁해 보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040122,
					"content": "으… 네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040123,
					"content": "아니면… 더 이상 유실물을 낚아달라고 하지 않을 테니, 장소를 이동해서 낚시하는 건 어때요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040124,
					"content": "제가… 돈을 지불하고 당신은 낚시하는 걸로 해요! 제발 부탁이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040125,
					"content": "이보세요, 전 그저 낚시꾼일 뿐이라고요! 낚시꾼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040126,
					"content": "장소를 바꾸는 것도 나쁘지 않은 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "부탁할게요. 여기, 보수도 준비했어요. 제발 절 좀 도와주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040129,
					"content": "당신들 정말… 알겠어요. 그럼 기분전환 하는 셈 치고 장소를 바꿀게요. 어디에서 하길 원하는 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040130,
					"content": "정말 감사합니다! 저를 따라오시면 돼요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040131,
					"content": "여행자, 지난번처럼 낚시용 미끼로 쓸 재료들을 부탁할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040132,
					"content": "어디 보자… 이번에 쓸 특별 재료는 민트인데, 꼭 제가 자주 가는 곳에서 채집해야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040133,
					"content": "대략적인 위치는 지도에 표시해 뒀어요. 재료를 가져다주면 꼼꼼하게 계산해서 보수를 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040134,
					"content": "그럼 전 호베트 씨와 먼저 낚시 포인트에 가 있을게요. 잠시 후에 그곳에서 만나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040127,
					"content": "낚시꾼이라면 원래 다양한 걸 낚는 법이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "케이반 씨가 낚시한다면 확실히…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "난 대어를 낚기 위해 낚시하는 거라고요!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "케이반"
				}
			]
		},
		{
			"id": 7310403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
