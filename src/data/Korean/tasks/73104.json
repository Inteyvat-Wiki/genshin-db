			"dialogs": [
				{
					"id": 731040701,
					"content": "자, 그럼 오늘의 두 번째 낚시를 시작하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040702
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040702,
					"content": "정신을 집중해야 하니, 당신들은 아무 소리도 내지 말아줘요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040703
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040703,
					"content": "케이반이 온 정신을 집중해 낚시를 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040704
					]
				},
				{
					"id": 731040704,
					"content": "으악! 저길 보세요! 슬라임이 아주 많아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040705
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040705,
					"content": "하?! 이런 상황은 처음이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040706,
						731040707
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040706,
					"content": "제게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040708
					]
				},
				{
					"id": 731040708,
					"content": "왜 케이반이 낚시할 때면 항상 이렇게 귀찮은 일들이 생기는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731040707,
					"content": "케이반 씨는 계속 낚시하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040708
					]
				}
			]
		},
		{
			"id": 7310409,
			"completionStepIds": [
				7310409
			],
