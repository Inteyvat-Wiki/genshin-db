				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040901,
					"content": "정말 대단해요! 덕분에 위기를 넘겼어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040902
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040902,
					"content": "유물을 전부 되찾으면, 보수를 더 신청해서 여러분께 감사를 표할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040903
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040903,
					"content": "호베트 씨, 내가 진정한 대어를 낚을 거라는 생각은 눈곱만큼도 안 하고 있군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040904
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040904,
					"content": "잠깐, 대어가 미끼를 물었어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040905
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040905,
					"content": "케이반이 힘차게 낚싯대를 들어 올린다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040906
					]
				},
				{
					"id": 731040906,
					"content": "이번엔 또… 뭐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040907
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040907,
					"content": "앗, 이건 또 다른 유물 보따리예요! 정말 잘됐다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040908
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040908,
					"content": "이렇게 순조로울 줄은 몰랐어요. 벌써 유물을 두 개나 찾다니! 역시 케이반 씨예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040909
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040909,
					"content": "…방금 그 말은 하지 말걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040910
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040910,
					"content": "물고기는 언제든 낚을 수 있지만 유물은 그렇지 않죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040911
					]
				},
				{
					"id": 731040911,
					"content": "하지만 아직 대어를 낚아보지도 못했다고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040912
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040912,
					"content": "너무 상심하지 마. 유물을 낚음으로써 좋은 일을 한 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040913
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731040913,
					"content": "마지막… 낚시 포인트가 비마라 마을 근처에 있어요. 거긴 안전한 편이니 어서 가도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040914
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 731040914,
					"content": "예예, 이미 두 손 두 발 다 들었네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040915
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040915,
					"content": "정말 이상해요. 내 낚시 방법이 잘못된 건지 아니면 낚시용 미끼가 잘못된 건지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040916
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040916,
					"content": "휴, 이제 신경 쓰지 않을래요…. 여행자, 이번엔 신선한 뚠뚠 복숭아 채집을 부탁할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040917
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040917,
					"content": "마지막 낚시 포인트니까, 이번엔 특제 낚시용 미끼를 사용할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040918
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 731040918,
					"content": "여행자, 그럼 부탁할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케이반"
				}
			]
		},
