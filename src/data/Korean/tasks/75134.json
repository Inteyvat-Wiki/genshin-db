				]
			},
			"dialogs": [
				{
					"id": 751340201,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "우왓, 바깥쪽은 완전히 심연에 침식됐네. 언제 떨어져도 이상하지 않을 것 같아. 초록이가 말한 게 이거였나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751340203,
					"content": "안쪽에 뭐가 있는지는 모르겠지만, 아무리 봐도 제단 같지는 않은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751340204,
					"content": "「틀에 박힌 논리에만 의존하면…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "아아, 알겠다. 아마 초록이는 저 심연이 무서워서 들어오지 않으려고 했던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751340206,
					"content": "심연을 내버려 둘 순 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "맞아. 초록이는 저 심연이 무서워서 들어오지 않으려고 했던 거야. 저걸 내버려둘 순 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751340208,
					"content": "#가자, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "잠깐만, 나는 빼놓고 둘이서만 가는 거야? 너무해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751340211,
					"content": "아무튼 저 더러운 것들을 제거하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
