						751340454
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751340454,
					"content": "검은 용이 이곳의 주인인 것처럼 그려졌네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340455
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751340455,
					"content": "용이 성 위에 도사리고 있어요…",
