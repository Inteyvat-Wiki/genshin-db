						],
						"pointId": 16779
					}
				]
			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(새 둥지 안에 찢어진 쪽지들이 흩어져 있다. 쪽지 위 글씨까지 조각난 것 같다…)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "이 쪽지들… 설마 둥지를 만들려고 일부러 찢은 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708090303,
					"content": "위에 글씨도 있는 것 같은데, 맞춰서 뭐라고 써 있는지 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708090304,
					"content": "결국엔 직접 맞춰야 하는 거야…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "넌 궁금하지도 않아? 어쩌면 보물지도일 수도 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708090306,
					"content": "페이몬의 계속되는 재촉에 못 이겨 쪽지를 맞췄다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "어디 보자… 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708090308,
					"content": "이… 이건 설마… 「범죄 계획서」?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708090309,
					"content": "범죄 계획서를 새한테 뺏기는 사람이 어디 있어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "하… 하지만 소설엔 그런 전개가 자주 나오잖아! 완벽한 계획일수록 가장 말도 안 되는 곳에서 구멍이 나기 마련이라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708090313,
					"content": "그럼 근처 술집에 가서 알아볼까? 혹시 누가 「최근에 누가 범죄를 저지르려고 한다!」 같은 얘기 못 들었냐고 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708090311,
					"content": "믿어서 손해 볼 건 없지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "마… 맞아, 만에 하나라는 것도 있잖아… 정말로 누가 범죄를 저지를 생각이라면, 나중에 후회해 봤자 늦는다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7080904,
