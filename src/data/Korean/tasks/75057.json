				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "와… 방금 무서운 소리가 들리길래 보러 왔더니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010802,
					"content": "오면서 「이상한 생각 하지 말자, 티투, 별일이야 있겠어」라고 위로했는데, 정말로 큰일이 일어났군요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010803,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "여기 작은 산룡이 있었군요…. 당신이 저 이방인 두 분을 이곳으로 데리고 온 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010805,
					"content": "그리고 이 「그림자 바늘」은… 당신들이 꽂아 넣은 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010806,
					"content": "…설마 그러면 안 되는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#어? 그럼, {NICKNAME}, 우리 엄청 나쁜 일을 한 거 아니야…? 차라리 목격자가 한 명뿐일 때…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010808,
					"content": "#하하, 그렇게 무서운 소리 하지 마시지요, 그리 심각한 상황은 아닙니다. 오히려 좋은 일을 해주었다고 할까요? {M#형제}{F#아가씨}는 {NICKNAME} 님이고, 당신은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010813,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#여기는 {REALNAME[ID(2)|SHOWHOST(true)]}(이)예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "음, 제 이름은 티투입니다. 부족에서 이야기를 말하는 {RUBY#[D]이야기꾼} 일을 맡고 있고, 골짜기에 있는 돌기둥들을 「돌보는」 것 또한 같이하고 있지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010816,
					"content": "물론 여러분이 꽂아 넣은 돌기둥은 세 「작은 그림자 바늘」 중 하나로, 제가 관리하는 것이지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010817,
					"content": "과, 관리라니… 역시 우리가 돌기둥을 떨어뜨려서 나타 현지인이 배상을 요구하려는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010818,
					"content": "우으, 방금 진짜 이름을 말하지 말았어야 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010819,
					"content": "배상… 「티투의 머릿속이 번뜩였다. 이대로 눈앞의 사람을 협박하면 목적을 달성할 수 있을지도…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010820,
					"content": "이런 줄거리엔 이런 서술이 들어가야 할 것 같네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010821,
					"content": "음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "아, 이야기 생각에 정신이 팔려서 죄송합니다. 저는 부족에서 이야기를 말하는 {RUBY#[D]이야기꾼}일을 맡아 오랫동안 이야기를 해왔는데, 최근에는 직접 이야기를 생각해내야 할 때가 되었거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010823,
					"content": "안 그래도 요즘 그것 때문에 걱정이었는데, 「그림자 바늘」에도 문제가 생기더군요…. 옛말에 사람이 재수 없을 때는 용도 재수가 없다더니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010824,
					"content": "흠흠, 여러분을 협박할 생각은 없습니다. 정말 협박하고 싶었다면 머릿속의 문장을 말하지도 않았겠지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010825,
					"content": "보십시오, 저희는 이름을 주고받고 싸우지도 않았으니 이미 친구가 된 셈입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010826,
					"content": "여러분이 그런 친구의 부탁을 들어주실지는 모르겠지만요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010827,
					"content": "…배상을 요구하는 것만 아니라면요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "당연히 아닙니다. 뭐라고 해야 좋을까, 그렇지, 혹시 골짜기를 돌아다닐 때 금빛 문양이 새겨진 거대한 고체 열소 덩어리를 못 보셨습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010829,
					"content": "구역의 중심에 있어서 눈에 잘 띄었을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010830,
					"content": "그랬던 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "제가 말하려던 건 사실 그 커다란 돌기둥과 관련된 겁니다…. 그 돌기둥은 부족 사람들에게 「그림자 바늘」이라고 불리는 건데, 최근에 문제가 조금 생겼습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010834,
					"content": "여러분을 만나기 전에는 하마터면 포기할 뻔했습니다. 심지어 자신에게 이렇게 말했지요. 「『그림자 바늘』의 문제를 해결하지 못하면 부족을 멸망시킨 재앙의 이야기를 쓰는 것도 좋겠지…」라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010835,
					"content": "잠깐만, 그냥 돌기둥 하나일 뿐인데 부족이 멸망하는 거랑 무슨 상관인 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010836,
					"content": "게다가 네가 계속 말하는 「그림자 바늘」과 우리가 꽂아 넣었다는 그 「작은 그림자 바늘」 모두 커다란 돌기둥이잖아, 대체 왜 그렇게 부르는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010837,
					"content": "음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#아, {NICKNAME} 님과 페이몬 모두 이방인이니 더 자세히 설명해야겠군요. 이건 사실 부족의 한 전설과 관련이 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010839,
					"content": "이야기에서는 이렇게 말하고 있지요, 대영혼께서 화산 대왕의 그림자를 꿰매기 위해 「그림자 바늘」을 이곳에 매달았다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010840,
					"content": "하지만 진짜 역사는 이렇습니다. 그 기둥의 아래에는 사실 심연이 봉인되어 있거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010841,
					"content": "나타의 이야기는 대부분 이런 식입니다. 수사와 은유로 가득한, 경고의 뜻을 담은 이야기 말이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010842,
					"content": "잠깐, 그 말은 즉 저 밑에 실제로 심연이 봉인되어 있다는 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010843,
					"content": "예, 최근 세 개의 작은 「그림자 바늘」 중 두 개가 떠올랐습니다. 세 번째가 떠오를 때면 아마 아래에 있는 안 좋은 것들이 파도처럼 쏟아져 나올 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010844,
					"content": "그래서 여러분이 하나를 꽂아 넣은 걸 보고, 뜻밖의 일에 기뻐한 겁니다. 그러니 당연히 여러분이 배상할 필요도 없지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010845,
					"content": "그리고 여러분께 부탁하고 싶은 게 있습니다. 다른 「작은 그림자 바늘」 하나도 눌러줄 수 있으실지요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010846,
					"content": "#으음… 어떡하지, {NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010847,
					"content": "…심연과 관련된 일을 손 놓고 바라보고 있을 수는 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#좋아, 이거 봐, {REALNAME[ID(2)|SHOWHOST(true)]}도 그렇다잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010851,
					"content": "이거 참… 어둠이 깊을 때면 불빛이 나타난다더니, 하하, 위기의 순간에는 영웅이 나타나는가 봅니다. 인간의 가능성이란 언제나 이런 때 눈부시게 빛나는 것이겠지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010852,
					"content": "#어쩌면 이것도 훌륭한 이야기가 될지도 모르겠네요. {NICKNAME} 님, 당신은 이야기 속 영웅조차 갖추지 못했던 기질을 품고 있습니다. 벌써부터 기대가 되는군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010853,
					"content": "갑시다, 영웅님들, 바로 출발해서 떠오른 「그림자 바늘」을 마저 보러 가시지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티투"
				},
				{
					"id": 750010848,
					"content": "혹시 저희가 도울 수 있는 게 있을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "모르겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "그렇군요, 굉장히 커다란 것이라 눈에 많이 띄었을 텐데, 그래도 괜찮습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010809,
					"content": "페이몬이 한 거예요, 저는 지켜봤을 뿐이에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "와, 너 이럴 때마다 항상 날 모함하는데, 나도 화낼 줄 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750010811,
					"content": "#하하, 긴장하실 것 없습니다. 차라리 안도할 일이죠. 이 작은 숙녀분은 페이몬 님이고, {M#형제}{F#아가씨}의 이름은 어떻게 되시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "티투"
				},
				{
					"id": 750010812,
					"content": "#저는 {NICKNAME}(이)예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}