				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "안녕… 나한테 무슨 볼일 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 220270202,
					"content": "저, 저기…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270203,
					"content": "칠기에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "…감실에 공양할 칠기를 직접 만들겠다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 220270205,
					"content": "부탁해요, 나나츠키 누나! 정말 이루고 싶은 소원이 있어요! 그리고… 절대 누나의 비법을 누설하지 않을게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270206,
					"content": "도료 배합의 문제가 아냐. 정교한 칠기를 제작하려면, 도료 말고도 오랫동안 축적한 경험과 연습이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 220270207,
					"content": "시간도 시간이지만… 이건 돈 문제기도 해. 우리 가문의 칠기 기술은 현재 나까지 4대째 이어지고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 220270208,
					"content": "난 칠기를 연구하기 위해 수메르로 가서 공부를 한 적도 있어. 그러니까, 네가 단기간에 칠기 제작을 배운다는 건… 불가능해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 220270209,
					"content": "그… 그래요? 하지만, 감실에 뭘 공양하면 좋을지 몰라서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270210,
					"content": "난 감실에 바치는 공양품은 가격보다도 그 물건에 담겨 있는 「마음」이 더 중요하다고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 220270211,
					"content": "네가 가장 좋아하는 물건을 정성을 담아 공양한다면, 신의 응답을 받을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 220270212,
					"content": "내가 가장 좋아하는 물건을… 정성을 담아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270213,
					"content": "음, 알 것 같기도 하고 모를 것 같기도 해요. 그래도 고마워요, 나나츠키 누나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270214,
					"content": "#{F#누나}{M#형아}, 일단 감실로 가요. 뭘 공양하면 좋을지 {F#누나}{M#형아}랑 상의하고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼타"
				}
			]
		},
		{
