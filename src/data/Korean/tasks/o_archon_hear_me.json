				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "칠기… 대체 어떻게 만드는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270102,
					"content": "칠기는 어디에 쓰려고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "#{F#누나}{M#형아}구나… 그게 사실… 감실에 대해서 알고 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270104,
					"content": "사람들이 그랬어요. 감실에 진귀한 공양품을 바치면 바라던 염원이 이뤄진다구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270105,
					"content": "예쁜 칠기는 비싸잖아요. 감실에 칠기를 공양한다면, 틀림없이 응답이 올 것 같아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270106,
					"content": "하지만 전 칠기를 살 돈이 없어서 직접 만들어보려구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270107,
					"content": "사람들이 「야요이 칠기」의 나나츠키 누나가 전문가래요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270108,
					"content": "#{F#누나}{M#형아}, 칠기에 대해 물어보러 나랑 같이 나나츠키 누나한테 가줄 수 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270109,
					"content": "물론이지, 바로 출발하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#{F#누나}{M#형아}, 고마워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270111,
					"content": "왜 혼자 안 가고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "나나츠키 누나는 평소에… 너무 엄해서, 혼자서 가기가 좀 무서워요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270113,
					"content": "#{F#누나}{M#형아}가 같이 가주면, 괜찮을 거 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼타"
				}
			]
		},
		{
