			"dialogs": [
				{
					"id": 220270401,
					"content": "「삼색 경단」이 좋겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "그런가요… 알겠어요! 마침 삼색 경단이 하나 있어요. 엄마가 만들어준 건데, 아까워서 아직 못 먹었거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270403,
					"content": "그… 그냥 신께 공양할래요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270601,
					"content": "신이 제 소원을 들어주셨으면 좋겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270602,
					"content": "#지금까지 도와줘서 고마워요, {F#누나}{M#형아}. 이건 답례라고 생각하고 받아줘요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220270603,
					"content": "내일 다시 이곳으로 와볼래요. 제발… 신이 응답을 해주셨으면 좋겠어요…",
					"roleType": "TALK_ROLE_NPC",
