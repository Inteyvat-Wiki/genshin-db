			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페리트",
					"파무크",
					"페이몬",
					"오르한",
					"셰프켓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231601,
					"content": "깔끔하게 보물 사냥단을 처리하고 나서야.\\n페리트와 파무크가 도착한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231602
					]
				},
				{
					"id": 730231602,
					"content": "대장!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231603
					],
					"speakerTitle": "페리트"
				},
				{
					"id": 730231603,
					"content": "죄송해요. 저희가 조금 늦었죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231604
					],
					"speakerTitle": "파무크"
				},
				{
					"id": 730231604,
					"content": "조금 늦은 정도가 아닌데? 상황이 전부 끝났잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730231605,
					"content": "아 그게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231606
					],
					"speakerTitle": "페리트"
				},
				{
					"id": 730231606,
					"content": "대체 어딜 갔다 온 거야! 아무리 찾아도 코빼기도 안 보이더니… 앗, 이 술 냄새는 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231607
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231607,
					"content": "헤헤, 소문을 퍼뜨리는 가장 좋은 방법은 술에 취한 척하는 거잖아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231608
					],
					"speakerTitle": "페리트"
				},
				{
					"id": 730231608,
					"content": "그런 다음 거짓 정보를 흘리는 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231609
					],
					"speakerTitle": "파무크"
				},
				{
					"id": 730231609,
					"content": "아무리 봐도 진짜로 취했는데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231610
					]
				},
				{
					"id": 730231610,
					"content": "#너희 진짜… {NICKNAME} 아니었으면, 난 보물 사냥단에게 흠씬 얻어터졌을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231611
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231611,
					"content": "#{NICKNAME}(이)가 이렇게 손쉽게 보물 사냥단 녀석들을 전부 쓰러뜨릴 줄은 몰랐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231612
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231612,
					"content": "#그야 당연하지. {NICKNAME}(은)는 실력자니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730231613,
					"content": "하긴 지난번에 너희를 막아서려 할 때도 간단하게 날 쓰러뜨렸지. 하지만 이건… 내 상상을 뛰어넘는 수준이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231614,
						730231615
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231614,
					"content": "칭찬 고마워요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				},
				{
					"id": 730231616,
					"content": "#셰프켓, 네가 그렇게 믿던 보물 사냥단까지 우리… {NICKNAME}한테 전부 당했어. 어디 더 할 말이 남아 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231617
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231617,
					"content": "제, 제가… 이렇게 많은 동물을 밀렵하게 된 건 어렸을 때 겪은 트라우마 때문이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231618
					],
					"speakerTitle": "셰프켓"
				},
				{
					"id": 730231618,
					"content": "제 얘길 들어주세요…. 그건 제가 아직 어린아이였을 때…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231619,
						730231620
					],
					"speakerTitle": "셰프켓"
				},
				{
					"id": 730231619,
					"content": "듣고 싶은 사람 없어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231621,
					"content": "자, 이 녀석을 체포했으니까 너희가 속아서 황혼새를 사냥한 일도 청산된 거야. 다음부턴 대상을 가려서 믿어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231622
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231622,
					"content": "그러게 처음부터 내 말을 들었다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231623
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231623,
					"content": "뭐야! 넌 그때 다짜고짜 달려들었잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231624
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730231624,
					"content": "아, 그랬지…. 난 성격이 너무 급해, 다음부턴 좀 냉정하게 대처해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231625
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231625,
					"content": "다음에는 그런 일이 없었으면 좋겠어. 너희도 남이 하는 말은 쉽게 믿지 말고 조심해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231626
					],
					"speakerTitle": "오르한"
				},
				{
					"id": 730231626,
					"content": "알겠어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231627
					]
				},
				{
					"id": 730231627,
					"content": "다음부턴 조심할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231628
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730231628,
					"content": "오르한이 셰프켓을 체포해서 떠난다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730231620,
					"content": "이야기 좀 그만 지어내요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231615,
					"content": "더 칭찬하면 날아가 버릴지도 몰라요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				}
			]
		},
