				"points": []
			},
			"dialogs": [
				{
					"id": 80051501,
					"content": "위를 봐, 연못이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051502,
					"content": "연못조차 거꾸로 돼있다니, 정말 신기한 광경이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051503,
					"content": "이 연못 왜 이런 건지 알아, 데인?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051504,
					"content": "이 연못은 도시와 하나인 모양이야. 이것도 고대 문명이 남긴 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051505
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051505,
					"content": "중요한 건… 저주를 약화시키는 효과가 이 연못에서 비롯된 듯해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051506
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051506,
					"content": "여기 있으니까 몸에서 여태껏 느껴본 적 없는 평온함이 느껴져. 전보다 강해진 걸 보니, 연못에 「정화」 비슷한 효과가 있는 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051507
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051507,
					"content": "「정화」? 그럼… 연못 물로 저주를 완전히 정화할 수는 없을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051508,
					"content": "불가능해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051509
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051509,
					"content": "그렇게 확신해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051510,
					"content": "난 500년 동안 자아를 유지하면서 저주와 공존해 왔어. 저주에 관해서 나보다 잘 아는 사람은 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051511
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051511,
					"content": "그건 이 세계의 인과와도 같은 낙인이야. 신의 저주 자체로도 지위로 따지자면 인간보다 위지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051512
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051512,
					"content": "저주가 끊임없이 내 모든 걸 침투하고, 내 일부가 되어가고 있는 게 느껴져. 그리고 날 점차 「대체」하고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051513
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051513,
					"content": "저주의 침식을 어느 정도 억제하는 건 가능해도, 정화는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051514
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051514,
					"content": "신체 중 일부를 불태운다고 생각하면 돼. 그전에 목숨을 부지할 수도 없을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051515
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051515,
					"content": "엥?! 그럼 꼴까닥하는 거잖아! 이럴 수가… 정화할 수 없는 저주라니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051516,
					"content": "여기서 느껴지는 연못의 정화 효과는 아직 한참 부족해. 간신히 저주를 억제하는 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051517
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051517,
					"content": "아래의 이 장치는 또 뭐지? 뭔가 위화감이 느껴져…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051518,
						80051519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051518,
					"content": "설마 심연 교단의 물건?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80051520
					]
				},
				{
					"id": 80051520,
					"content": "솔직히 이런 구조의 장치는 나도 처음 보는군. 심연 교단이 설치한 거라고 의심할만해. 설마, 그들이 무언가를 준비하고 있는 건가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051521
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051521,
					"content": "(덜컹덜컹…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051522
					],
					"speakerTitle": "조사"
				},
				{
					"id": 80051522,
					"content": "으앗! 깜짝이야, 주변에 있는 문이 다 열렸어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051523
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051524
					],
					"speakerTitle": "할프단"
				},
				{
					"id": 80051524,
					"content": "으앗, 할프단이라는 그 기사야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051525
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051525,
					"content": "나한테 할 얘기라도 있나? 할프단",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051526
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051526,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051527
					],
					"speakerTitle": "할프단"
				},
				{
					"id": 80051527,
					"content": "가버렸네… 근데 이번엔 갑자기 사라지지 않았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051528
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051528,
					"content": "따라오라는 것 같군. 어때, 같이 갈 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80051529,
						80051530
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80051529,
					"content": "새로운 단서일 수도 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80051531
					]
				},
				{
					"id": 80051531,
					"content": "그렇긴 해… 그럼… 우리도 가볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80051530,
