						200290113
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290112,
					"content": "뭔가 또 해줄 얘기가 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "하하하, 내가 알려줄 수 있는 「우인단 이야기」는 이미 다 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290115,
					"content": "이번에 나를 도와주면 보수로 금은보화를 챙겨줄게, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290116,
					"content": "혹시 내가 릴리에게 들려준 그 동화를 듣고 싶은 거라면…",
