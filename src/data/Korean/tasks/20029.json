			"dialogs": [
				{
					"id": 200290401,
					"content": "선물은 구했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290402,
					"content": "돌아가면 무슨 일을 하시게 되는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "무슨 일을 하냐고? 그건… 위에서 시키는 일을 하게 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290404,
					"content": "휴, 운이 나쁘면 또 이상한 곳으로 발령 날 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290405,
					"content": "제발 이나즈마만 아니었으면 좋겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290406,
					"content": "근데 왜 갑자기 발령이 난 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
