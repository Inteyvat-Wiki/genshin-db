					"nextDialogs": [
						200290907
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290907,
					"content": "표정이 왜 이렇게 진지해, 설마 나랑 작별 인사하려고 그러는 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "빅토르"
				},
