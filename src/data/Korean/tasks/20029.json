			},
			"dialogs": [
				{
					"id": 200290101,
					"content": "후… 드디어 돌아갈 수 있게 됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290102,
					"content": "이제 돌아가는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "아? 너는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290104,
					"content": "맞아, 방금 위에서 스네즈나야로 복귀하라는 명령이 내려왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290105,
					"content": "내게… 다른 집행관님 산하로 들어가게 될 거고, 더 이상 몬드에 있을 필요가 없다고 하더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290106,
					"content": "도대체 어떤 집행관님 산하로 발령이 났는지 모르겠지만 제발 「스카라무슈」만 아니었으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290107,
					"content": "언제쯤 떠나는데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "그건 아직 안 알려줬어, 때가 되면 바로 떠날 수 있게 짐부터 미리 싸둬야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290109,
					"content": "하, 드디어 이곳을 떠날 수 있게 됐다. 이제 더 이상 수녀한테 무시당하지 않아도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290110,
					"content": "아, 맞다. 우리 오랜 시간 같이 일했는데, 마지막으로 부탁 하나만 들어줄 수 있을까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290111,
					"content": "항상 그랬듯이 날 도와주면 보수는 꼭 챙겨줄게, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290112,
					"content": "뭔가 또 해줄 얘기가 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "하하하, 내가 알려줄 수 있는 「우인단 이야기」는 이미 다 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290115,
					"content": "이번에 나를 도와주면 보수로 금은보화를 챙겨줄게, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290116,
					"content": "혹시 내가 릴리에게 들려준 그 동화를 듣고 싶은 거라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290117,
					"content": "무슨 일을 도와주면 되죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "맞아… 실은 이번에 도와달라고 한 것도 릴리 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290121,
					"content": "몬드성에서 이 「나쁜 우인단 아저씨」의 얘기를 들어주는 사람은 릴리와 너 두 명뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290122,
					"content": "지금 떠나면 아마 다시 몬드성에 올 기회가 없을 것 같아서… 릴리에게 선물을 주고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290123,
					"content": "하지만 내가 물건 살 때 거리의 시선이 곱지 못하다는 거 너도 잘 알잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290124,
					"content": "그러니까 부탁 좀 할게, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290125,
					"content": "마죠리에게 가서 아이에게 줄 만한 선물이 있는지 좀 봐줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290118,
					"content": "아직도 릴리랑 놀아주고 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "그냥 가끔… 아주 가끔씩 놀아주고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 200290113,
					"content": "우인단 얘기가 정말 많은 것 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
