			"dialogs": [
				{
					"id": 200290201,
					"content": "어서 와 여행자. 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290202,
					"content": "어린 아이에게 줄 선물에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "어린 아이에게 줄 선물이라… 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290204,
					"content": "음… 그러고 보니 요즘 장난감을 만들고 있긴 한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290205,
					"content": "장난감에 색을 칠할 때 고리고리 열매가 많이 필요해. 하지만 내가 가지고 있는 고리고리 열매를 이미 다 써버렸거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290206,
					"content": "슈스터에게 야외로 나가서 고리고리 열매를 따오라고 부탁을 했지만 아직까지 안 돌아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290207,
					"content": "여행자, 괜찮다면 야외로 나가서 슈스터를 좀 찾아봐 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290208,
					"content": "고리고리 열매만 충분하면 장난감은 금방 만들 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290209,
					"content": "제게 맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "<color=#00E1FFFF>울프 영지 근처</color>에 가서 고리고리 열매를 딴다고 했으니까 그 근처에서 찾아보면 될 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290212,
					"content": "그럼 부탁 좀 할게, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200290210,
					"content": "슈스터가 어디로 간다고 했죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
