			"dialogs": [
				{
					"id": 3740201,
					"content": "내가 하는 거 잘 봐——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740202,
					"content": "수녀 누나, 안녕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740203,
					"content": "바람 신의 가호가 함께하길. 어린 시인, 무슨 일이죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740204,
					"content": "사실, 몬드성을 위기에서 구할 비밀을 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740205,
					"content": "네? 역시 바람 신의 가호가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740206,
					"content": "하지만 이 일은 기사단에 알려주세요. 저처럼 평범한 수녀가 무슨 도움이 되겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740207,
					"content": "아하하, 누나도 도와줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740208,
					"content": "…천공의 하프라든가… 하프만 있다면 풍마룡을——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740209,
					"content": "돌아가주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740210,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740211,
					"content": "풍마룡이 제아무리 흉악하더라도, 단장 대행께서 마음만 먹으면, 토벌을 못 할 이유도 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740212,
					"content": "그건 안 돼. 그렇게 되면 풍마룡은 죽잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740213,
					"content": "동풍을 거역한 어리석은 짐승, 바람의 신께서 돌아오시더라도 쉽게 용서하지 않으실 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740214,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740215,
					"content": "어… 저기, 누나~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740216,
					"content": "안 되는 건 안 되는 거예요~ 꼬마 시인",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740217,
					"content": "(이 아이가 누나라고 부르니까 알 수 없이 기분이 좋아… 이상하네…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740218,
					"content": "후… 하는 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740219,
					"content": "더는 못 참아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740220,
					"content": "독실한 신도여, 기뻐하라! 이 몸이 바로 <color=#00E1FFFF>바람의 신 바르바토스</color>이니라——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740221,
					"content": "놀랐지? 놀라서 울고 싶지? 드디어 모시는 신을 만났는데, 어때? 감동했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3740222,
					"content": "다른 볼일 없으시다면 전 처리할 서류가 있어서 이만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740223,
					"content": "야아아——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "벤티"
				}
			]
		},
