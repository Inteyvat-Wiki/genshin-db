					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740402,
					"content": "안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "아, 당신은… 그 기사단의 신인이죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740406,
					"content": "어쩐 일로 오신 거죠? 단장 대행께서 주신 업무인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740411,
					"content": "맞아요, 천공의 하프를 빌리러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "그렇군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740413,
					"content": "의심하는 건 아니지만 방금 전 수상한 시인이 하프를 빌리면서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740414,
					"content": "자신이 바르바토스라 헛소리를 하더군요. 무슨 꿍꿍이가 있는 게 분명해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740415,
					"content": "천공의 하프는 마음대로 사용할 수 없어요. 지금은 하르파스툼 축제 때만 사용하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740416,
					"content": "빌릴 때는 단장, 주교님, 그리고 시민 대표의 동의와 서명이 필요한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740417,
					"content": "기사단의 서류는 가져오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740418,
					"content": "단장님은 아무 말씀 없으셨는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "아무튼 서류가 필요한 일이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740423,
					"content": "다른 일 없으시면, 전 바빠서 이만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게틀린드"
				},
				{
					"id": 3740419,
					"content": "미안, 깜빡했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
