				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "괜찮네… 「캣테일 술집」은 정말 좋은 곳이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010102,
					"content": "무슨 술집이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "응? 아… 여행자구나. 너 설마 「캣테일 술집」을 모르는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010104,
					"content": "모르는 것 같네. 못 들어봤으니 가본 적도 없겠군…. 휴, 넌 인생의 절반을 손해 본 거나 다름없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010105,
					"content": "「캣테일 술집」엔 기묘한 칵테일이 정말 많아. 네가 한 번도 마셔본 적 없던 거라고 장담할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010106,
					"content": "게다가 거긴 이름처럼 가게에 귀여운 고양이들이 아주 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010107,
					"content": "그렇게 귀여운 고양이들한테 둘러싸여서 맛있는 칵테일을 마시다 보면… 항상 시간 가는 걸 까먹는다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010108,
					"content": "지금 영업 중인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "음… 하지만 넌 아직 술을 마실 수 있는 나이가 아닌 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010111,
					"content": "뭐 괜찮아! 그 디오나라고 하는 바텐더는 몬드성 최고의 바텐더야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010112,
					"content": "무알코올 음료를 만드는 것쯤은… 그녀한텐 식은 죽 먹기지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010113,
					"content": "게다가, 디오나는 아주 귀여워. 작은 고양이 같다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010114,
					"content": "딸… 국! 결국, 말해버렸네, 안 돼, 안 되지. 이 일은 반드시 디오나한테 비밀로 해줘… 알겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010115,
					"content": "아무튼, 「캣테일 술집」은 바로 저 뒤에 있으니까 가고 싶으면 한번 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010116,
					"content": "난… 음! 난 저쪽에서 술 좀 깰게. 너무 많이 마셨나 봐. 5차는 무리야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 191010109,
					"content": "저도 마시고 싶어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}