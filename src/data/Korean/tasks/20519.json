					"호프만"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "…보물 사냥단 …아! 미안, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 205190302,
					"content": "보물 사냥단이 몬드성 주변을 맴돌고 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "보물 사냥단? 우리도 마침 보물 사냥단 한 팀을 추적하려던 참이었어. 그 녀석들이 감히 몬드성에 접근하다니, 대체 뭘하려는 건지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 205190304,
					"content": "하지만 분명 좋은 의도는 아니겠지. 이 사건에 수많은 인력이 투입돼서… 아마 당분간 네 보고를 처리할 틈은 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 205190305,
					"content": "그래도 네 보고는 일단 기록해뒀어. 그 보물 사냥단을 처리하고 나면 위에 보고할게. 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호프만"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
