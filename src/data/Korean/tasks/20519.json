					"베일"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "아직도 준비 중이야? 그럼 준비되면 출발해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205190402,
					"content": "그분이 대체 누구죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "아무리 물어도 알려주지 않을 거야. 이건 이 업계의 기본 자질이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205190404,
					"content": "혹시 누설하더라도… 그 정보는 「일부러」 누설하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205190405,
					"content": "아, 그럼 생각해봐. 내가 방금 한 말 중에 「일부러」 흘린 건뭐였을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베일"
				},
				{
					"id": 205190406,
					"content": "당신들의 목적은 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "목적이라… 그분의 목적은 나도 몰라. 아마도 이 몬드성을 지키려는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "베일"
				},
				{
