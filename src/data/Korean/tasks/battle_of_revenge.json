				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "넌? 하하하, 저번에 그 애송이 아니야? 왜 또 무기를 바치러 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "「해란귀」 두목"
				},
				{
					"id": 728040302,
					"content": "내 무기를 찾으러 왔다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040303,
					"content": "음… 좋아 배짱은 좋군. 근데 달랑 한 명만 데리고 오다니, 날 너무 얕보는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "「해란귀」 두목"
				},
				{
					"id": 728040304,
					"content": "그 용기가 가상해서 도전할 기회를 주지. 자, 앞으로 와서 나랑 한번 놀아보자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "「해란귀」 두목"
				},
				{
					"id": 728040305,
					"content": "근데… 내 부하들이 심심할 테니, 네가 데리고 온 녀석과 놀게 해주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "「해란귀」 두목"
				},
				{
					"id": 728040306,
					"content": "얼마든지 덤벼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "하하하, 큰소리치기는. 얘들아, 가서 저놈과… 재밌게 놀아줘라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "「해란귀」 두목"
				},
				{
					"id": 728040309,
					"content": "우린 자리를 옆으로 옮기지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "「해란귀」 두목"
				},
				{
					"id": 728040310,
					"content": "그럼 부탁할게, 여행자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040311,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "정말 고마워. 빨리 처리하고 도우러 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040313,
					"content": "큰소리치기는, 날 베고 싶으면 실력으로 보이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「해란귀」 두목"
				},
				{
					"id": 728040307,
					"content": "재미없기만 해봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
