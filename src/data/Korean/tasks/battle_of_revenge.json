				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "아야! 살려줘, 살려줘! 어디서 나타난 놈이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "「해란귀」"
				},
				{
					"id": 728040207,
					"content": "나쁜 놈! 내 무기를 돌려줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040208,
					"content": "아, 아직도 그 무기 타령이야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "「해란귀」"
				},
				{
					"id": 728040209,
					"content": "난 그 무기만 있으면 돼, 어디 있는지 알려주면 살려는 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040210,
					"content": "그건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "「해란귀」"
				},
				{
					"id": 728040211,
					"content": "시간 낭비하지 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "살려줘! 왜 이렇게 급해. 말할 틈은 줘야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "「해란귀」"
				},
				{
					"id": 728040214,
					"content": "그… 그 무기는 두목한테 바쳤어. 그걸 원한다면 저기 야영지에 가서 찾아봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "「해란귀」"
				},
				{
					"id": 728040215,
					"content": "눈치는 빠르구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040216,
					"content": "그럼 난 이만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "「해란귀」"
				},
				{
					"id": 728040217,
					"content": "꺼져!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "「해란귀」"
				},
				{
					"id": 728040219,
					"content": "싸움은 못 하는데 도망치는 건 잘하네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040220,
					"content": "동료를 이렇게 쉽게 버리다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "해란귀는 이익을 위해 모인 오합지졸이라 충성이나 신념은 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040222,
					"content": "문제가 생겼을 때 뒤도 안 돌아보고 도망가는 건 당연한 행동이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040223,
					"content": "그래도 네 덕분에 일이 쉽게 끝났어. 네가 아니었으면 놈이 쉽게 포기하지 않았을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040224,
					"content": "이제 해란귀 본진으로 가야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040225,
					"content": "그전에 계획을 세우자. 내가 두목을 처치할 테니, 넌 남은 잔챙이를 쓸어줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040226,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "그럼 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 728040227,
					"content": "혼자 10명은 거뜬해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "다음 사람에게 물어봅시다…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
