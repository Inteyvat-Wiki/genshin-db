				]
			},
			"dialogs": [
				{
					"id": 760620101,
					"content": "괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760620102,
					"content": "마게스가 조금 다치긴 했지만… 목숨엔 지장 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620103
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760620103,
					"content": "어떻게 된 거지… 둘은 연인 사이 아니었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760620104,
					"content": "이런 게 「부부싸움」이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620105
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760620105,
					"content": "그런 단어는 또 어디서 배운 거야… 아무튼 저 녀석을 막아야 해… 너희도 봤지? 우기 몸이 새까만 게… 꼭 숯댕이 같았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760620106,
					"content": "근데 덩치가 저렇게 큰 건, 다른 숯댕이를 많이 먹어서 그런 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760620107,
					"content": "페이몬… 그 질문의 답은 조금 기다려 줘… 내가 저 녀석만큼 커지면 말해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620108
					],
					"speakerTitle": "숯댕이"
				},
				{
					"id": 760620108,
					"content": "으… 알았어. 그나저나 이제 어떡하지? 우기가 돌아왔으니, 일단 철수하고 다음 기회를 노려야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760620109,
					"content": "그러면 늦어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620110
					]
				},
				{
					"id": 760620110,
					"content": "응… 고대 달 폭풍이 벌써 우기엔 권역까지 다가왔어. 거기엔 작은 생명체들이 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620111
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760620111,
					"content": "마게스를 돌봐주고 있어. 우리가 고대 달의 근원을 가져올게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760620112
					]
				},
				{
					"id": 760620112,
					"content": "응. 조심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620113
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760620113,
					"content": "마게스를 치료하는 데 시간이 좀 걸리니까, 그동안 우기의 주의를 끌어줘. 내가 갈 때까지만 버티면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620114
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760620114,
					"content": "달 바다에 무리 지어 사는 작은 월령들을 보내서 널 도우라고 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620115
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760620115,
					"content": "알겠어! 맡겨줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760620116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760620116,
					"content": "나도… 도울게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "숯댕이"
				}
			]
		},
