				"points": []
			},
			"dialogs": [
				{
					"id": 730220301,
					"content": "음? 너였구나. 오랜만이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220302
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220302,
					"content": "엇? 여긴 어디지? 동굴인가? 으음… 어지러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220303
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220303,
					"content": "넌 누구야? 왜 여기서 자고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220304,
					"content": "내가 누구였더라… 음, 머리가 어지러워. 내 이름이 뭐였지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220305
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220305,
					"content": "내 이름은 아란팔라야. 헤헤, 생각났어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220306
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220306,
					"content": "네가 바로 아란팔라구나! 어디 갔나 했더니 여기 숨어서 자고 있었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220307,
					"content": "아란팔라… 너희들이 내 이름을 어떻게 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220308
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220308,
					"content": "응? 나라잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220309
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220309,
					"content": "드디어 제대로 정신을 차렸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220310,
					"content": "드디어 깼네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220311
					]
				},
				{
					"id": 730220311,
					"content": "흑흑, 난 아직 준비가 안 됐어. 날 죽으로 만들지 말아줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220312
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220312,
					"content": "뭐? 널 죽으로 만든다고? 그게 무슨 소리야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220313,
					"content": "동, 동생이 말해줬어. 나처럼 어리바리한 요정은 나쁜 나라한테 잡혀가서 죽이 될 거라고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220314,
						730220317
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220314,
					"content": "그러고 보니 너 맛있어 보인다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220315
					]
				},
				{
					"id": 730220315,
					"content": "으아아아악!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220316
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220316,
					"content": "#야! {NICKNAME}. 그런 농담하지 마! 아란팔라, 누구도 널 죽으로 만들지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220318,
					"content": "정말…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220319
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220319,
					"content": "정말이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220320,
					"content": "진짜로 진짜지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220321
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220321,
					"content": "#우리가 왜 널 속이겠어. 내 이름은 페이몬이야. 이 키 큰 나라는 {NICKNAME}이고. 아란파카티가 우릴 여기로 보냈어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220322,
					"content": "아란파카티? 걔는 잘 지내고 있어? 난 여기 얼마나 있었던 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220323
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220323,
					"content": "얼마라고 했더라? 내 기억엔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220324,
					"content": "어디 보자… 수많은 달이 뜨고 지기 전에 새싹이 흙을 뚫고 나와 큰 나무가 되었지. 아란파카티 몇 개만큼 높더라…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220325,
						730220327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220325,
					"content": "일곱 개",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220326
					]
				},
				{
					"id": 730220326,
					"content": "#아, 역시 {NICKNAME}. 기억력도 좋다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220329,
					"content": "아, 시간이 그렇게나 많이 흐른 거야? 큰일이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220330
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220330,
					"content": "어쨌든 그렇게 된 거야. 우트사바 축제가 곧 시작되겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220331
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220331,
					"content": "아란팔라에게 자초지종을 설명한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220332
					]
				},
				{
					"id": 730220332,
					"content": "아, 곧 우트사바 축제를 보낼 시간이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220333
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220333,
					"content": "그래. 그래서 아란파카티는 네가 바나라나로 돌아오길 바라고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220334
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220334,
					"content": "아… 난 아직 「요리 수행」을 끝내지 못했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220335
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220335,
					"content": "응? 너 자고 있던 거 아니었어? 난 네가 자고 있는 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220336
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220336,
					"content": "「잠」? 아, 그냥 예전 일을 생각했던 것뿐이야. 잠들다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220337
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220337,
					"content": "아란나라에게 있어 잠드는 건 아주 심각한 일인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220338
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220338,
					"content": "음… 어디서부터 말해야 할까. 목숨이 위태로울 때 우리는 「휴면」 상태에 들어가. 그리고 모든 기억과 꿈을 「씨앗」에 압축하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220339
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220339,
					"content": "위기에서 벗어나고 인연이 닿아 그 씨앗이 다시 숲으로 돌아오면 다시 아란나라로 자랄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220340,
						730220341,
						730220342
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220340,
					"content": "까다로워 보이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220344,
					"content": "나도 알아. 나라는 잠을 자야 한다는 걸. 예전에 나한테도 나라 친구가 한 명 있었어. 너처럼 반짝반짝 빛나는 금빛의 나라였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220345
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220345,
					"content": "전에 나와 그 나라 친구도 「가장 신선한 열매」를 따기 위해 이곳에 왔었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220346
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220346,
					"content": "#그래서 그 뒤로 열매를 딸 때면 항상 여기로 오고 있어. 만약 {F#그}{M#그녀}가 돌아오거나 새로운 나라 친구를 만난다면 함께 열매를 먹을 수 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220347
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220347,
					"content": "이번에도 「가장 신선한 열매」를 굉장히 많이 땄다고… 응? 왜 이것밖에 안 남았지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220348
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220348,
					"content": "오는 길에 일몰 열매가 잔뜩 떨어져 있더니. 전부 네가 떨어트린 거였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220349
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220349,
					"content": "많이 떨어져 있었어? 음, 괜찮아. 가장 신선하고 가장 맛있는 열매는 아직 나한테 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220350
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220350,
					"content": "음… 왜 그렇게 많이 떨어트린 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220351
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220351,
					"content": "난 형제들이랑 함께 「요리 수행」을 하러 나왔어. 그런데 다들 신선한 열매야말로 가장 좋은 식자재라는 걸 모르더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220352
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220352,
					"content": "그런데 내가 열매를 따려던 순간, 그래. 내가 열매를 따려던 그 순간, 갑자기 아주아주 큰 몬스터가 나타났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220353
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220353,
					"content": "엄청 컸어. 아란팔라의 5배 정도되는 키에 꼬리도 길었고 길을 걸을 때마다 땅이 흔들렸지. 그리고 「마라나」와 비슷한 기운도 느껴졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220354
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220354,
					"content": "그리고 굉장히 단단했어. 아란마, 아란바리카 정도 되는 아란나라들도 힘을 좀 들여야 처치할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220355
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220355,
					"content": "뭐? 걔들이 그렇게 강하단 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220356
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220356,
					"content": "응. 하지만 난 약해서 여기 숨어 과거의 일을 회상하며 몬스터가 떠나길 기다릴 수밖에 없었어. 그러다 정신을 차려보니 너희들이 내 눈앞에 나타난 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220357
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220357,
					"content": "그렇게 무시무시한 몬스터가 바로 밖에 있다고. 난 나갈 수 없어. 미안해, 나의 「여동생」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220358
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220358,
					"content": "안 돼. 이제 곧 우트사바 축제란 말이야. 지금 돌아가야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220359
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220359,
					"content": "우트사바 축제에는 아무 걱정도 없어야 한단 말이야. 그런데 이 동굴 밖에는 내 목숨을 위협하는 걱정거리가 버티고 있어… 후… 우트사바 축제를 위해 걱정거리를 만들 순 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220360
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220360,
					"content": "쿨쿨-쿨쿨- 나라바루나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220361
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220361,
					"content": "아, 이 녀석…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220362
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220362,
					"content": "#{NICKNAME}, 이제 어떡하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220363,
						730220364
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220363,
					"content": "대형 몬스터부터 해치우자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220365,
					"content": "…아무리 무서워도 풍마룡보다 더 무섭겠어? 아란나라가 풍마룡을 보면 어떤 반응일지 궁금하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220366
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220366,
					"content": "「아란팔라의 100만 배 정도 되는 크기였어!」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220367
					]
				},
				{
					"id": 730220367,
					"content": "「머리부터 꼬리까지 달이 떠오르고 달이 지는 것만큼 길었어!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220368
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220368,
					"content": "어쨌든 일단 밖에 있는 몬스터부터 처치하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220364,
					"content": "헉, 대형 몬스터라니. 너무 무섭다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220341,
					"content": "아주 편리한걸?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220342,
					"content": "페이몬, 넌 씨앗으로 변할 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220343
					]
				},
				{
					"id": 730220343,
					"content": "너 나한테 무슨 불만 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220344
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220327,
					"content": "페이몬은 기억력도 참 좋다니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220328
					]
				},
				{
					"id": 730220328,
					"content": "헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220317,
					"content": "누구도 널 죽으로 만들지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220318
					]
				}
			]
		},
