			"dialogs": [
				{
					"id": 730220101,
					"content": "안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220102,
					"content": "쿨쿨-쿨쿨-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220103
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220103,
					"content": "이봐! 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220104,
					"content": "으음, 좋은 열매야. 쿨쿨-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220105
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220105,
					"content": "젠장, 깊게도 잠들었네. 음… 맞다. 아란파카티가 말했었지. <color=#00E1FFFF>풀 원소의 힘</color>을 사용하면 깨울 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220106,
					"content": "#{NICKNAME}, 너한테 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7302202,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
