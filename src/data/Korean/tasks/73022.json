			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"아란팔라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220201,
					"content": "음? 너였구나. 오랜만이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220202
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220202,
					"content": "엇? 여긴 어디지? 동굴인가? 으음… 어지러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220203
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220203,
					"content": "넌 누구야? 왜 여기서 자고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220204,
					"content": "내가 누구였더라… 음, 머리가 어지러워. 내 이름이 뭐였지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220205
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220205,
					"content": "내 이름은 아란팔라야. 헤헤, 생각났어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220206
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220206,
					"content": "네가 바로 아란팔라구나! 어디 갔나 했더니 여기 숨어서 자고 있었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220207,
					"content": "아란팔라… 너희들이 내 이름을 어떻게 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220208
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220208,
					"content": "응? 나라잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220209
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220209,
					"content": "드디어 제대로 정신을 차렸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220210,
					"content": "드디어 깼네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220211
					]
				},
				{
					"id": 730220211,
					"content": "흑흑, 난 아직 준비가 안 됐어. 날 죽으로 만들지 말아줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220212
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220212,
					"content": "뭐? 널 죽으로 만든다고? 그게 무슨 소리야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220213,
					"content": "동, 동생이 말해줬어. 나처럼 어리바리한 요정은 나쁜 나라한테 잡혀가서 죽이 될 거라고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220214,
						730220217
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220214,
					"content": "그러고 보니 너 맛있어 보인다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220215
					]
				},
				{
					"id": 730220215,
					"content": "으아아아악!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220216
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220216,
					"content": "#야! {NICKNAME}. 그런 농담하지 마! 아란팔라, 누구도 널 죽으로 만들지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220218,
					"content": "정말…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220219
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220219,
					"content": "정말이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220220,
					"content": "진짜로 진짜지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220221
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220221,
					"content": "#우리가 왜 널 속이겠어. 내 이름은 페이몬이야. 이 키 큰 나라는 {NICKNAME}이고. 아란파카티가 우릴 여기로 보냈어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220222,
					"content": "아란파카티? 걔는 잘 지내고 있어? 난 여기 얼마나 있었던 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220223
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220223,
					"content": "얼마라고 했더라? 내 기억엔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220224,
					"content": "어디 보자… 수많은 달이 뜨고 지기 전에 새싹이 흙을 뚫고 나와 큰 나무가 되었지. 아란파카티 몇 개만큼 높더라…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220225,
						730220227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220225,
					"content": "일곱 개",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220226
					]
				},
				{
					"id": 730220226,
					"content": "#오오! 역시 {NICKNAME}(이)야. 기억력도 좋다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220229,
					"content": "아, 시간이 그렇게나 많이 흐른 거야? 큰일이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220230
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220230,
					"content": "어쨌든 그렇게 된 거야. 우트사바 축제가 곧 시작되겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220231,
					"content": "아란팔라에게 자초지종을 설명한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220232
					]
				},
				{
					"id": 730220232,
					"content": "아, 곧 우트사바 축제를 보낼 시간이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220233
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220233,
					"content": "그래. 그래서 아란파카티는 네가 바나라나로 돌아오길 바라고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220234,
					"content": "아… 난 아직 「요리 수행」을 끝내지 못했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220235
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220235,
					"content": "응? 너 자고 있던 거 아니었어? 난 네가 자고 있는 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220236,
					"content": "「잠」? 아, 그냥 예전 일을 생각했던 것뿐이야. 잠들다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220237
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220237,
					"content": "아란나라에게 있어 잠드는 건 아주 심각한 일인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220238,
					"content": "음… 어디서부터 말해야 할까. 목숨이 위태로울 때 우리는 「휴면」 상태에 들어가. 그리고 모든 기억과 꿈을 「씨앗」에 압축하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220239
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220239,
					"content": "위기에서 벗어나고 인연이 닿아 그 씨앗이 다시 숲으로 돌아오면 다시 아란나라로 자랄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220240,
						730220241,
						730220242
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220240,
					"content": "까다로워 보이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220244,
					"content": "나도 알아. 나라는 잠을 자야 한다는 걸. 예전에 나한테도 나라 친구가 한 명 있었어. 너처럼 반짝반짝 빛나는 금빛의 나라였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220245
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220245,
					"content": "전에 나와 그 나라 친구도 「가장 신선한 열매」를 따기 위해 이곳에 왔었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220246
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220246,
					"content": "#그래서 그 뒤로 열매를 딸 때면 항상 여기로 오고 있어. 만약 {F#그}{M#그녀}가 돌아오거나 새로운 나라 친구를 만난다면 함께 열매를 먹을 수 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220247
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220247,
					"content": "이번에도 「가장 신선한 열매」를 굉장히 많이 땄다고… 응? 왜 이것밖에 안 남았지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220248
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220248,
					"content": "오는 길에 일몰 열매가 잔뜩 떨어져 있더니. 전부 네가 떨어트린 거였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220249
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220249,
					"content": "많이 떨어져 있었어? 음, 괜찮아. 가장 신선하고 가장 맛있는 열매는 아직 나한테 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220250
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220250,
					"content": "음… 왜 그렇게 많이 떨어트린 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220251
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220251,
					"content": "난 형제들이랑 함께 「요리 수행」을 하러 나왔어. 그런데 다들 신선한 열매야말로 가장 좋은 식자재라는 걸 모르더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220252
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220252,
					"content": "그런데 내가 열매를 따려던 순간, 그래. 내가 열매를 따려던 그 순간, 갑자기 아주아주 큰 몬스터가 나타났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220253
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220253,
					"content": "엄청 컸어. 아란팔라의 5배 정도되는 키에 꼬리도 길었고 길을 걸을 때마다 땅이 흔들렸지. 그리고 「마라나」와 비슷한 기운도 느껴졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220254
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220254,
					"content": "그리고 굉장히 단단했어. 아란마, 아란바리카 정도 되는 아란나라들도 힘을 좀 들여야 처치할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220255
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220255,
					"content": "뭐? 걔들이 그렇게 강하단 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220256
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220256,
					"content": "응. 하지만 난 약해서 여기 숨어 과거의 일을 회상하며 몬스터가 떠나길 기다릴 수밖에 없었어. 그러다 정신을 차려보니 너희들이 내 눈앞에 나타난 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220257
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220257,
					"content": "그러고 보니 오는 길에 「유적 드레이크」와 마주쳤는데, 설마 네가 말한 대형 몬스터가 그건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220258
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220258,
					"content": "나라는 그렇게 불러…? 그럴지도 모르겠다. 아마 맞을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220259,
						730220260
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220259,
					"content": "그건 이미 처리했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220264
					]
				},
				{
					"id": 730220264,
					"content": "#몬스터보다 훨씬 더 작은 나라{NICKNAME}한테 그런 힘이 있다니. 대단하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220265
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220265,
					"content": "응. 그럼 출발하자. 착한 나라, 우리 같이 열매도 먹자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220260,
					"content": "헉, 대형 몬스터라니. 너무 무섭다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220261
					]
				},
				{
					"id": 730220261,
					"content": "…정말 그렇게 무서워?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220262
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220262,
					"content": "응응. 나라들도 그 괴물이 얼마나 무시무시한 존재인지 아는 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220263
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220263,
					"content": "#걱정하지 마. 널 만나기도 전에 {NICKNAME}이(가) 벌써 해치워버렸으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220264
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220241,
					"content": "아주 편리한걸?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220242,
					"content": "페이몬, 넌 씨앗으로 변할 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220243
					]
				},
				{
					"id": 730220243,
					"content": "너 나한테 무슨 불만 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220244
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220227,
					"content": "페이몬은 기억력도 참 좋다니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220228
					]
				},
				{
					"id": 730220228,
					"content": "헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220217,
					"content": "누구도 널 죽으로 만들지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220218
					]
				}
			]
		},
