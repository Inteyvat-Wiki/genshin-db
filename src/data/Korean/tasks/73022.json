				},
				{
					"id": 730220502,
					"content": "아란팔라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220503,
					"content": "응? 페이몬이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220504
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220504,
					"content": "#그래. {NICKNAME}이(가) 밖에 있던 「대형 몬스터」를 처치했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220505,
					"content": "#몬스터보다 훨씬 더 작은 나라{NICKNAME}한테 그런 힘이 있다니. 대단하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220506,
						730220507
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220506,
					"content": "그렇게 대단한 건 아냐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				},
				{
					"id": 730220508,
					"content": "응. 그럼 출발하자. 착한 나라, 우리 같이 열매도 먹자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220507,
					"content": "꽤 까다로운 상대였어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				}
			]
		},
		{
			"id": 7302206,
