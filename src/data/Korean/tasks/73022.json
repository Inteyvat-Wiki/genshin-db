				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220601,
					"content": "음… 그럼 「가장 신선한 열매」로 요리를 만들어 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220602
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220602,
					"content": "「가장 신선한 열매」는 평범한 열매랑 뭐가 달라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220603,
					"content": "나도 알아. 나라들의 눈에 모든 열매는 똑같아 보인다는걸. 하지만 사실은 다 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220604
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220604,
					"content": "「가장 신선한 열매」는 건강한 나무에서만 열리고, 건강한 나무는 바람이 불면 가장 먼저 노래하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220605
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220605,
					"content": "건강한 나무에서 자란 아이들은 우리에게 축복이나 마찬가지야. 그게 바로 「가장 신선한 열매」지. 나라 친구가 말했어. 이 과일을 먹으면 노래를 부를 때처럼 기분이 좋아진다고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220606
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220606,
					"content": "그렇게 좋은 열매로 얼마나 맛있는 요리를 만들 수 있을지 너무 기대된다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220607,
					"content": "아란팔라는 바로 요리를 시작했다…\\n그는 들고 있던 열매를 여러 조각으로 나누었다…\\n그리고 그중 몇 조각을 건네준다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220608
					]
				},
				{
					"id": 730220608,
					"content": "우리는 신선한 열매를 함께 맛보았다.\\n기대한대로 신선한 과일의 맛이었다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220609
					]
				},
				{
					"id": 730220609,
					"content": "좋네. 고마워, 건강한 나무야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220610
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220610,
					"content": "잠깐, 이게 요리라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220611,
					"content": "「가장 신선한 열매」는 그 자체로도 이미 「최고의 진미」야. 별도의 조리를 하지 않아도 이미 완벽한 맛을 가지고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220612
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220612,
					"content": "백 번 듣는 것보다 한 번 맛보는 게 낫지. 맛을 보면 내 말이 무슨 뜻인지 알 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220613
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220613,
					"content": "맛있긴 한데 그냥 과일 맛인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220614
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220614,
					"content": "과일이니까 과일 맛이 나겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220615
					]
				},
				{
					"id": 730220615,
					"content": "그렇긴 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220616,
					"content": "왜 너희 나라도 과일을 썰어 접시에 담은 다음 나무 판에 올려놓는 요리 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220617
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220617,
					"content": "응? 그런가? 잠깐, 너 설마 모둠 과일을 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220618,
					"content": "모둠 과일을 요리라고 할 수 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220619,
						730220621
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220619,
					"content": "그렇지 않을까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220620
					]
				},
				{
					"id": 730220620,
					"content": "모둠 과일을 요리라고 하는 건 좀 이상한 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220623,
					"content": "음… 그런 사소한 거엔 신경 쓰지 마. 좋은 식자재를 찾으면 그 자체가 요리니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220624
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220624,
					"content": "식자재를 찾기 위해서는 숲 여기저기를 뒤져야 해. 숲에 가까워지는 거야말로 「요리 수행」의 진정한 의미라고 할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220625
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220625,
					"content": "그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220626
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220626,
					"content": "그렇다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220627
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220627,
					"content": "「가장 신선한 열매」도 얻었고 「최고의 진미」도 만들었으니 이번 「요리 수행」은 끝났다고 볼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220628
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220628,
					"content": "이제 당당하게 바나라나로 돌아갈 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220629
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220629,
					"content": "#음… 나라{NICKNAME}와(과) 페이몬이 없었다면 대형 몬스터 때문에 동굴에 갇힌 채로 이번 우트사바 축제를 놓치고 말았을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220630
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220630,
					"content": "그래. 얼른 바나라나로 돌아가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220631
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730220631,
					"content": "그래, 그래… 우트사바 축제를 놓치면 분명 내 여동생한테 혼나겠지… 생각만 해도 끔찍해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730220621,
					"content": "요리라고 할 순 없지 않을까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220622
					]
				},
				{
					"id": 730220622,
					"content": "그러니까. 딱히 조리과정도 없고… 요리라고 부르는 건 이상한 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "페이몬"
				}
			]
		},
