			"dialogs": [
				{
					"id": 722340201,
					"content": "왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340202,
					"content": "장소는 아직 다 못 찾았어? 아깝네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340203,
					"content": "다시 한번 얘기해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340204,
					"content": "하나는 협곡의 거리의 가장 높은 곳에 있는 석문 아래, 또 하나는 상야의 사당 옆 산호에 둘러싸인 빈터, 그리고 마지막은 뱀의 심장에 있는 폐허야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340205,
					"content": "내가 세 곳에 다 표식을 남겼어. 밝게 빛날 수 있도록 높은 곳에 등불을 걸었거든. 쉽게 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
