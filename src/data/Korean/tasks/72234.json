			"dialogs": [
				{
					"id": 722340301,
					"content": "왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340302,
					"content": "다 가봤어? 이곳저곳 많이 다녀본 너에게는 별거 아닌 풍경일지도 모르겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340303,
					"content": "나쁘지 않았어요. 독특하던데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "생각해 보니까 너 말고 다른 사람에게 알려준 적이 없네. 네 감상을 들은 걸로 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340306,
					"content": "다른 곳엔 이곳보다 더 아름다운 풍경이 있겠지. 여긴 어둡고, 먹을 것도 변변치 않은 데다 용 도마뱀도 경계해야 하니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340307,
					"content": "하지만 오래 살다 보니 아쉬운 마음이 생기나 봐. 그곳에서 본 풍경을 떠올리면 여전히 그리운 느낌이 들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340308,
					"content": "너도 그런 느낌을 느껴본 적 있어? 이런 곳이라도 오래 살면 집이란 느낌이 들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340309,
					"content": "아마도요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340312,
					"content": "…아무튼, 쓸모없는 얘기 들어줘서 고마워. 귀중한 건 아니지만 가진 게 이것뿐이네, 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카바야마"
				},
				{
					"id": 722340310,
					"content": "아니요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "그저 그래요. 더 웅장한 풍경도 본 적 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
