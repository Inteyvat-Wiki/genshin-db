				7304801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7304801",
							"2"
						],
						"stepId": 7304801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아란무후쿤다",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730480101,
					"content": "정말 그립다. 이 광경을 마지막으로 본 지 벌써 수백 해나 지났네… 이렇게 다시 바나라나의 꿈을 볼 수 있다니, 너희 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480102
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480102,
					"content": "와! 나이가 그렇게 많은 줄 몰랐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480103,
						730480104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730480103,
					"content": "아란나라가 「해」라는 개념을 쓰는 건 처음 들어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				},
				{
					"id": 730480105,
					"content": "그래? 더 많은 기억과 지식을 흡수해서 그런 걸 거야. 꿈속의 바나라나는 낮이나 밤이 존재하지 않는 평화로운 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480106
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480106,
					"content": "게다가 우린 수명이 매우 길어서 「시간」에 대한 개념이 거의 없어. 우린 나무가 자라고, 꽃이 피고, 달이 떠오르는 걸 보며 시간의 흐름을 추측하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480107
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480107,
					"content": "곧 우트사바 축제가 시작될 테니, 비야의 열매도 열리겠구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480108
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480108,
					"content": "흠… 그러고 보니 비야의 열매가 뭐야? 아란자랑 아란마는 얘기한 적 없는 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730480109,
					"content": "#너희는 아란나라의 친구니까 아란라칼라리의 원리는 들어봤을 거야. 나라{NICKNAME}, 페이몬, 알고 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480110
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480110,
					"content": "아란나가 기억의 힘이랬어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480111
					]
				},
				{
					"id": 730480111,
					"content": "아란나? 진짜 보고 싶다, 별일 없으면 좋겠네. 좀 덜렁대는 아이긴 하지만, 너희를 친구로 생각해서 말해준 건 확실해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480112
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480112,
					"content": "비야의 열매는 기억과 꿈을 추출해서 열매를 맺어. 나 같은 아란나라에겐 가장 소중한 결실이라고 할 수 있지. 그리고 비야의 열매는 열매인 동시에 희망의 씨앗이기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480113
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480113,
					"content": "다른 사람을 돕기 위한 거라면, 비야의 열매가 모두 이뤄줄 거야. 너희랑 비야의 열매를 준비하는 아란나라도 다른 사람을 돕고 싶은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480114,
						730480115
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480114,
					"content": "라나를 살리고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480116,
					"content": "#응, 그럼 문제없겠네. 나라{NICKNAME}(은)는 아란나라의 친구니까, 이거 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480117,
						730480118
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480117,
					"content": "이건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480119,
					"content": "꽃 한 송이… 아란나랑 아란나킨도 우리한테 꽃을 줬었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730480120,
					"content": "그랬구나. 시간은 많이 지났지만 관습은 그대로라니 정말 기뻐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480121
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480121,
					"content": "#전에 나도 아란자, 아란지… 그리고 아란파카티랑 같이 나라바루나에게 꽃을 줬어. {M#그녀}{F#그}는 우리의 둘도 없는 친구야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480122
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480122,
					"content": "이 꽃은 아란나라의 우정의 징표야. 이 꽃을 받으면 아란나라와의 우정을 약속했다는 뜻이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480123
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480123,
					"content": "우리 아란나라들은 말주변이 없거든. 그래서 인간 친구가 꽃을 받아줬다는 건 우리에게 매우 자랑스러운 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480124
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480124,
					"content": "#나라{NICKNAME}에 대한 얘기 많이 들었어. 그래서 나에겐 너도 소중한 친구야. 게다가 내 꽃을 받아주다니, 나로서는 더없는 영광이지. 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480125,
						730480126
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480125,
					"content": "천만에",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480127,
					"content": "#우린 다시 만나게 될 거야. 그때는 나라{NICKNAME}, 페이몬이 우리 집에 놀러 왔으면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480128
					],
					"speakerTitle": "아란무후쿤다"
				},
				{
					"id": 730480128,
					"content": "앗, 사라졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730480129,
					"content": "정말 이상한 아란나라네. 됐어, 우리 다른 아란나라나 찾으러 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730480126,
					"content": "고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480118,
					"content": "잘 간직할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480115,
					"content": "아란나는 친구를 돕고 싶어 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480104,
					"content": "넌 다른 아란나라랑 다른 시간 개념을 가지고 있는 것 같네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				}
			]
		}
	]
}