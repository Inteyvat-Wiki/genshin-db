			"dialogs": [
				{
					"id": 742510201,
					"content": "이렇게 물을 나누며 옛이야기를 나누니 기쁘군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "느비예트"
				},
				{
					"id": 742510202,
					"content": "(조금 더 앉아있자)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 742510204,
					"content": "네. 앞으로의 여정에 행운이 함께하시길 바랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "느비예트"
				},
				{
					"id": 742510203,
					"content": "티타임을 슬슬 끝내야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "「산드로네」"
				}
			]
		}
