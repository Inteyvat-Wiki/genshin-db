				"points": []
			},
			"dialogs": [
				{
					"id": 746860101,
					"content": "안녕, 대모험가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860102
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860102,
					"content": "대편집자라고 불러주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860103
					]
				},
				{
					"id": 746860103,
					"content": "광고 마스터라고 불러주세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860104
					]
				},
				{
					"id": 746860104,
					"content": "하하, 광고 제작이 재미있었나 보구나! 다행이다. 안 그랬으면 귀한 재회의 시간을 따분한 일에 써버렸다고 회의감이 들었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860105
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860105,
					"content": "우린 자주 못 만나잖아. 전 세계를 여행하는 모험가를 찾는 건 하늘에서 별 따기지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860106
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860106,
					"content": "가끔은 이렇게 카페에서 만나기도 하지만, 어떨 때는 네 행방을 수소문해 봐도 아무도 모르더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860107
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860107,
					"content": "좋은 점은 널 만날 때마다 흥미진진한 이야기를 들을 수 있어서 영원히 지루하지 않다는 거고, 단점은 너와의 만남이 언제든지 마지막이 될 수 있다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860108,
						746860109
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860108,
					"content": "그 정도는 아닌 것 같은데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860110
					]
				},
				{
					"id": 746860110,
					"content": "하하, 좋아. 나도 계속 불평만 하다간 공익 광고에 나오는 뒷방 늙은이가 될 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860111
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860111,
					"content": "의뢰받았던 광고는 거의 다 끝냈고, 이제 다음 장편 영화를 이어서 작업해야지. 떨어져 있는 동안에는 각자의 꿈을 위해 노력하자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860112
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860112,
					"content": "그럴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860113
					]
				},
				{
					"id": 746860113,
					"content": "아, 그래도 시간 날 때 같이 밥 한 끼 먹자! 폰타인이 아니라도 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746860114
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860114,
					"content": "디어 헌터, 만민당, 람바드 술집… 캠핑이나 사냥도 괜찮아… 내가 따라갈 수만 있다면 말이지…. 아무튼 연락해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비에"
				},
				{
					"id": 746860109,
					"content": "제가 자주 찾아올게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746860110
					]
				}
			]
		}
	]
}