			"dialogs": [
				{
					"id": 708000701,
					"content": "너희 왔구나, 고기는 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 708000702,
					"content": "가져왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "그래, 어디 보자… 정말 신선하네, 이 정도면 되겠어. 메인 재료는 됐고, 「바람 내음」을 낼 수 있는 보조재료만 구하면 되는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 708000704,
					"content": "음, 「바람 내음」이 깃든 재료라면… 「민들레 씨앗」만 한 게 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 708000705,
					"content": "여행자, 민들레 씨앗 좀 구해다 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 708000706,
					"content": "맡겨 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "그럼 부탁할게, 난 고기 손질하고 있을 테니까 다 구하면 나한테 갖다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "브룩"
				}
			]
		},
