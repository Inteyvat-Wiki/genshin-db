			"dialogs": [
				{
					"id": 752570201,
					"content": "재밌을 것 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "좋아요! 그럼 먼저 시작하실 분?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "이스틀리"
				},
				{
					"id": 752570203,
					"content": "여성분 먼저 하시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "인티"
				},
				{
					"id": 752570204,
					"content": "나도 동의해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "베네딕트"
				},
				{
					"id": 752570205,
					"content": "정말 신사다운 청년이네. 너희랑 같이 사진 찍고 싶구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "수마"
				},
				{
					"id": 752570206,
					"content": "네? 안… 안 될 것도 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "인티"
				},
				{
					"id": 752570207,
					"content": "크흠, 나도 상관없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "베네딕트"
				},
				{
					"id": 752570208,
					"content": "음… 젊은이가 세 명 더 있으면 좋겠는데, 모아줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "수마"
				},
				{
					"id": 752570209,
					"content": "음… 그리고 폭죽도 있으면 좋겠어. 젊었을 때 그런 분위기를 정말 좋아했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "수마"
				},
				{
					"id": 752570210,
					"content": "좋아요. 그럼 시작할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이스틀리"
				}
			]
