			},
			"dialogs": [
				{
					"id": 721080101,
					"content": "드디어 도착했어. 여기가 진수의 숲이구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080102,
					"content": "옛 친구가 진수의 숲 깊은 곳에 있다고 가면 무녀가 말했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080103,
					"content": "그럼 어서 숲 안쪽으로 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7210804,
			"completionStepIds": [
				7210816
			],
			"beginWay": "TALK_BEGIN_AUTO",
