			"dialogs": [
				{
					"id": 721080901,
					"content": "응응, 잘했어. 다들 기뻐하더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080902,
					"content": "…응? 어, 괜찮아. 내가 물어봐줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080903,
					"content": "「교부 코반」이 「너희는 분명히 사람인데 왜 몸에서 너구리의 냄새가 나지?」라고 물어달래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080904,
					"content": "…맞아! 사실대로 알려줘! 너희 몸에서는 왜 우리와 같은 냄새가 나지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080905,
					"content": "응? 이제야 물어보는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080906,
					"content": "가면 무녀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "참! 그런 일이 있었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080909,
					"content": "전에 가면 무녀가 너구리 요괴족에게 몰래 배운 법술로 만든 거라면서 푸짐한 식사를 대접했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080910,
					"content": "뭐? 우리 법술을 몰래 배우다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080911,
					"content": "으, 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080912,
					"content": "뭐야, 그 망할 여우 녀석. 살아있었으면 째깍 와서 인사할 것이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080913,
					"content": "가면을 쓴 무녀. 너의 「옛 친구」라고 하던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080914,
					"content": "가면? 난 가면도 무녀도 모른다구. 여우는 한 마리 알지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080915,
					"content": "그 망할 여우 녀석이 무녀 행세하는 것 같은데. 그 무녀, 어떻게 생겼지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080916,
					"content": "흰 여우 탈을 쓰고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080917,
					"content": "다른 건?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080918,
					"content": "검은 단발머리였어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "무녀 복장에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080922,
					"content": "낭… 모르겠네. 그런 사람은 본 적 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080923,
					"content": "그렇구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080924,
					"content": "…응? 응, 그래, 나만 믿으라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080925,
					"content": "「쇼우세이」가 「놀아줘서 아주 재밌었어, 고마워!」라고 전해달래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080926,
					"content": "페이몬도 즐거웠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080927,
					"content": "빗에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "난 천하에 이름을 떨쳤던 너구리 요괴 이오로이라고, 당연히 약속은 지켜. 이 빗은 너에게 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080929,
					"content": "그런데 이 빗으로 뭘 하려는 거야? 머리 빗게? 암내가 날지도 모른다낭",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "이오로이"
				},
				{
					"id": 721080930,
					"content": "그러니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721080920,
					"content": "무녀 복장에",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080921
					]
				},
				{
					"id": 721080921,
					"content": "검은 단발머리였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "페이몬"
