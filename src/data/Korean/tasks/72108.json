				},
				{
					"id": 721081103,
					"content": "와! 돌이 사라졌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081104,
						721081105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721081104,
					"content": "신기해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721081106
					]
				},
				{
					"id": 721081106,
					"content": "이것이 바로 너구리 요괴의 법술인가! 재미있는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721081107,
					"content": "고마워. 「길법사」! 다음에 우리 다시 숨바꼭질 놀이 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721081108,
					"content": "앗!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 721081105,
					"content": "뭔가 으스스해",
					"roleType": "TALK_ROLE_PLAYER",
