			"dialogs": [
				{
					"id": 401970101,
					"content": "이 지경까지 온 이상, 난 이걸 추가해야 한다고 생각해——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970102,
					"content": "소금요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "에스코피에"
				},
				{
					"id": 401970103,
					"content": "아니, 후추",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970104,
					"content": "음! 절묘하네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "에스코피에"
				},
				{
					"id": 401970105,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401970106,
					"content": "뭘 연구하고 있어? 새로운 디저트야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401970107,
					"content": "디저트에 후추를 넣진 않을걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "디저트 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "에스코피에"
				},
				{
					"id": 401970109,
					"content": "대본이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970110,
					"content": "엥?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "나의 친애하는 파트너이자 촬영 기사 겸 신입 감독! 영화 애호가들의 사랑 속에서 창작은 영원히 멈추지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970112,
					"content": "내 무대에 무미건조한 각본은 설 자리가 없어. 마치 하늘에서 쏟아지며 관중들이 재채기를 연발하게 하는 후추 같은 반전이 있어야 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970113,
					"content": "영화뿐만 아니라 접시도 무대죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "에스코피에"
				},
				{
					"id": 401970114,
					"content": "에밀리 씨한테 들었는데, 후추를 조향에 응용할 수도 있대요. 그럼 디저트에도 가능하지 않을까 싶은데요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "에스코피에"
				},
				{
					"id": 401970115,
					"content": "음! 후추의 자극이 크림의 달콤함을 더 돋보이게 할 수 있을지도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970116,
					"content": "음, 두 사람은 창작적인 면에서 죽이 잘 맞는 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401970117,
					"content": "물론 후추 케이크가 어떤 맛일지 나는 상상이 안 되지만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401970118,
					"content": "뭐야 뭐야? 에스코피에가 새로운 케이크를 만드는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970119,
					"content": "후추 케이크, 후후추추",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "완전 짜릿해! 완성하면 나 꼭 먹어보게 해 주라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970121,
					"content": "내 착각인가? 일이 끝나니까 어째 다들 열정이 더 타오르는 거 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401970122,
					"content": "안 될 게 뭐 있어? 노력에 성과가 있을 때가 가장 즐거운 순간이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970123,
					"content": "마치 마카롱을 구울 때처럼, 당도가 걱정된다고 재료를 아껴선 안 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970124,
					"content": "마카롱은 설탕을 팍팍 넣어야 하는 법이니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970125,
					"content": "설탕 팍팍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970126,
					"content": "설탕 팍팍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 401970127,
					"content": "…음, 근데 무슨 설탕을 넣어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 401970128,
					"content": "르핀 폴린 씨, 왔구나! 물건은 완성했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970129,
					"content": "물론이죠, 아주 순조로워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 401970130,
					"content": "응? 뭔가 중요한 임무가 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401970131,
					"content": "맞아요. 이걸 받아주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 401970132,
					"content": "이건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "와, 멋있다! 전시회 전경이네. 모두의 그림까지 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401970134,
					"content": "헤헤, 시네마 파크가 크게 성공한 만큼, 이색적인 기념품을 만들어 보자고 상의했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970135,
					"content": "이 테마파크는 모두가 한 땀 한 땀 만들어 낸 거잖아. 마치 모두가 한 획씩 그려낸 이 지도처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970136,
					"content": "물론 대부분은 그림 실력이 뛰어난 르핀 폴린 씨가 그린 거지만, 우리도 최선을 다해 각자의 획을 그었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "에스코피에"
				},
				{
					"id": 401970137,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970138,
					"content": "#그리고 이것 말고도 {NICKNAME} 너에게 줄 특권이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970139,
					"content": "——바로 내 이미지에 수염을 추가할 권리!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "푸리나"
				}
			]
		},
		{
			"id": 4019702,
