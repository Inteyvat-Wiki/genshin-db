					"르핀 폴린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401970201,
					"content": "좋았어, 난 <color=#C4D6EAFF>하얀색</color>으로 그릴래",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "크림 맛 수염인가… 아주 전통적이고 아주 맛있지. 응, 허락할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 401970401,
					"content": "#자, 이 기념 지도는 이제 {NICKNAME}의 소유물이니까 원하는 맛의 수염을 얼마든지 그려도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970402,
					"content": "헤헤, 뭔가 엄청 맛있을 것 같은 지도잖아, 잘 간직할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401970403,
					"content": "너희가 좋아한다면 더할 나위 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401970404,
					"content": "테마파크의 여러 면이 완벽하게 꾸며졌어. 이젠 일의 피로를 잊고, 마음껏 놀아보자구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나비아"
				}
			]
		},
		{
			"id": 4019703,
			"completionStepIds": [
				4019703,
				4019705
