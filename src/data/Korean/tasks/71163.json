				]
			},
			"dialogs": [
				{
					"id": 711630301,
					"content": "뭐야? 우리가 어떻게 여기 온 거지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630302,
					"content": "어때? 내가 준비한 선물이 마음에 드나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630303,
					"content": "자백, 너 여기 있었구나! 이 우산은 뭐야? 갑자기 「슝」 하고 우리를 여기로 데려왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630304,
					"content": "너희도 기억력이 좋지 않은가 보군. 전에 나랑 탔던 걸 벌써 잊은 것이냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630305,
					"content": "이러면 좀 기억이 나겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630306,
					"content": "앗! 이건… 달 궁전 마차잖아! 어쩐지 눈에 익더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630307,
					"content": "후후, 기억 속 마차를 본떠 만든 것일 뿐이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630308,
					"content": "#이것도 {NICKNAME}이(가) 가져다준 그 옥 증표 덕분이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630309,
					"content": "아~ 전에 뭐 하나 만들어 주겠다고 한 게 이거였구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630310,
					"content": "그래. 이 옥 증표로 만든 마차는 너희를 목적지까지 빠르게 데려다줄 수 있어서, 여행에 꽤 도움이 될 게다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630311,
					"content": "받아두거라, 두 안내자여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630312,
					"content": "대단해…. 그냥 한 말인 줄 알았는데, 이렇게 빨리 만들어내다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630313,
					"content": "나도 처음에는 옥 증표의 영기가 다 흩어져, 시간이 좀 걸리겠다고 생각했다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630314,
					"content": "하지만 다행히, 여기는 침옥 협곡이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630315,
					"content": "응? 침옥 협곡이 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630316,
					"content": "우리가 지금 침옥 협곡의 어디에 있는지 알고 있느냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630317,
					"content": "음… 유롱항?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630318,
					"content": "후후, 아직 이곳에 대해 잘 모르는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630319,
					"content": "우리가 서 있는 이곳은, 리월의 지맥이 교차하는 여덟 개의 주요 지점 중 하나다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630320,
					"content": "휴생상두(休生傷杜), 경사경개(景死驚開)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "넌 내 생각보다 이곳을 더 잘 아는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630322,
					"content": "아! 나도 생각났어, 지맥의 팔문 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630323,
					"content": "그래. 이곳은 팔문 중 하나인 대길문——생문(生門)의 중심지니라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630324,
					"content": "생문은 성장과 번영, 만물의 소생을 관장하지. 그래서 짧은 시간 안에 옥 증표의 영기를 보충해 마차를 만들 수 있었던 게야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630325,
					"content": "와, 그 정도로 효과가 대단하다고? 침옥 협곡은 풍수가 좋구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630326,
					"content": "그래… 이곳이야말로, 너희가 평화롭게 살아갈 곳이겠구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630327,
					"content": "너희…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711630328,
					"content": "…아니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630329,
					"content": "자, 다른 볼일은 없으니 너희 할 일을 하러 가보거라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630330,
					"content": "나는 산을 더 거닐 생각이니, 여기서 헤어지자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630331,
					"content": "고마워요, 자백 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "천만에. 네가 날 깨워 주었으니, 오히려 내가 빚을 졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630333,
					"content": "다 종려 씨 덕분이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "나도 그에게 같은 말을 했다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630335,
					"content": "그리고 그를 통해, 네가 긴 여행을 하고 있다는 것도 알게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630336,
					"content": "다음 목적지는 저 먼 곳에 있는 설국인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630337,
					"content": "네, 거긴 스네즈나야라고 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "스네즈나야… 어떤 나라인지는 잘 모른다만, 얼음과 눈으로 뒤덮인 길이라면 순탄치만은 않을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630339,
					"content": "앞으로 도움이 필요하면, 언제든 날 찾아오거라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "자백"
				},
				{
					"id": 711630340,
					"content": "그럴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "그래, 잘 가렴",
					"roleType": "TALK_ROLE_NPC",
