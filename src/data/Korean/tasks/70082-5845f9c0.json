				]
			},
			"dialogs": [
				{
					"id": 700820101,
					"content": "오돌프!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700820102,
					"content": "#안녕, 페이몬, 그리고 {NICKNAME}… 도와줘서 고마워. 이제 윈슬로도 더는 심연에 맞서 싸운 기사들의 묘를 옮기자고 난리치진 않겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820103
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820103,
					"content": "그 얘기가 나와서 말인데, 난 아직도 이해가 안 간다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700820104,
					"content": "바람을 일으킨 건 고작 광풍의 핵이었잖아. 근데 왜 굳이 윈슬로 앞에서 기사단 유령이 장난친 거라고 한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700820105,
					"content": "그 「유령」은 사실 다른 사람이 아니라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820106
					]
				},
				{
					"id": 700820106,
					"content": "당신이였군요, 오돌프",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820107
					]
				},
				{
					"id": 700820107,
					"content": "어? 그래? 근데 아까 맥주도 한 모금 마셨잖아. 유령이 맥주를 마셔?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700820108,
					"content": "그 「유령」이 이 유령은 아니지. 아하하, 나름 잘 숨겼다고 생각했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820109
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820109,
					"content": "…뭐? 설마… 처음부터 유령 같은 건 없었고, 전부 오돌프의 속임수였던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700820110,
					"content": "「속임수」라는 말이 이렇게 와닿은 건 처음이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820111
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820111,
					"content": "내가 장치를 좀 손봤어. 그리고 원소 생물을 끌어들이는 유도제도 조금 뿌렸지. 처음엔 그냥 윈슬로를 살짝 겁만 주려던 거였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820112
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820112,
					"content": "바람 슬라임 몇 마리 정도만 오면 며칠 지나지 않아 알아서 흩어질 거라 생각했거든… 마침 스네즈나야 쪽에 일도 생겨서, 돌아왔을 땐 이미 다 끝났을 줄 알았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820113
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820113,
					"content": "결국 광풍의 핵을 끌어들였군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700820114
					]
				},
				{
					"id": 700820114,
					"content": "그래, 그때부터 일이 훨씬 복잡해졌지. 난 그가 묘를 옮기지 못하게 하려던 거지, 그렇게 망가지길 바란 건 아니였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820115
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820115,
					"content": "그래서… 너희가 나타났을 때 진짜로 바람 신에게 감사했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820116
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820116,
					"content": "어라? 그럼 우리가 안 왔으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700820117,
					"content": "그럼 내가 직접 광풍의 핵을 쫓아내 보든가, 아니면 기사단에 진실을 털어놨겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820118
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820118,
					"content": "하지만 진실을 알게 된 윈슬로는 크게 화냈을 거야. 어쩌면 묘비까지 부숴 버렸을지도 몰라. 원래 그런 성격이거든. 수년째 변함없이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820119
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820119,
					"content": "#그러니 큰 도움이 됐어. {NICKNAME}, 페이몬. 심연에 맞서 싸우다 이곳에서 희생된 페보니우스 기사들을 대신해서 고맙다는 말을 전할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820120
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820120,
					"content": "음, 뭔가 이상한 느낌이 들긴 하지만, 결과적으로는 좋은 일 한 셈이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700820121,
					"content": "하하, 그래. 다 내 탓이지… 「온갖 음산한 기운을 막아내는 건 결국 넓은 아량과 당당한 마음뿐」… 근데 나도 그걸 실천하진 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700820122
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700820122,
					"content": "아는 것과 지키는 건 별개의 문제니까. 그래도 나름 반성은 하고 있어. 바람 신께서 알고 계신다면, 이번만은 눈감아 주시길 바랄 뿐이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오돌프"
				}
			]
		}
	]
}