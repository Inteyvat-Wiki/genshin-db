			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"도도 통신기"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "…이렇게 경치가 아름다운 곳에서 이런 말도 안 되는 일을 처리하게 될 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670202,
					"content": "느낌이 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "그럭저럭 괜찮아, 네가 도와준다면 더 좋을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670204,
					"content": "구체적으로 뭘 도와주면 되는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400670205,
					"content": "윽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670206,
					"content": "음… 음… 도와줄 게 별로 없는 거 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670207,
					"content": "지, 지금 우릴 얕보는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400670208,
					"content": "아니야, 나도 방금 느낀 건데, 넌 말이 많지 않지만, 일을 항상 완벽하게 끝내고 묵묵히 다른 사람들을 위해 많은 일을 해왔잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670209,
					"content": "너야말로 가장 필요한 동료라고 생각해. 네가 있으면 왠지 모르게 마음이 놓이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670210,
					"content": "멋대로 기대하면 상대방에게 부담을 줄 수도 있지만, 난… 점성술사는 관찰력이 있어야 한다고 생각해. 다른 사람의 장점을 발견하는 것도 일종의 관찰이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670211,
					"content": "그러니까 우리를 칭찬하고 싶은 거였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400670212,
					"content": "칭찬이 아니라 사실을 말했을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670213,
					"content": "그렇구나, 모나는 인정하기 싫은 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "다른 사람을 칭찬했다는 걸 인정 못하는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400670215,
					"content": "왜, 왜 웃어, 객관적인 평가일 뿐, 널 칭찬한 게 아니야! 칭——찬——아니라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400670216,
					"content": "#난 앞으로도 계속 천문을 관찰할 거야. 또 얘기하자, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "모나"
				}
			]
		},
