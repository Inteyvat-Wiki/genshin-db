			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"울라프"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030401,
					"content": "하아… 하아…. 이제 좀 살겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030402
					],
					"speakerTitle": "울라프"
				},
				{
					"id": 110030402,
					"content": "고마워, 이 수프 진짜 맛있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030403
					],
					"speakerTitle": "울라프"
				},
				{
					"id": 110030403,
					"content": "어쩌다가 이렇게 된 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030404
					]
				},
				{
					"id": 110030404,
					"content": "멧돼지를 쫓아서 여기까지 왔는데 그 멧돼지가 저기 있는 지하 유적으로 도망쳐버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030405
					],
					"speakerTitle": "울라프"
				},
				{
					"id": 110030405,
					"content": "쫓아 들어가 보니 엄~청 큰 얼음 나무가 보이더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030406
					],
					"speakerTitle": "울라프"
				},
				{
					"id": 110030406,
					"content": "내 몸은 순식간에 얼어붙어버렸지. 깨어난 후 바로 뛰쳐나와 여기까지 오고 나니 힘이 다 빠져서 움직일 수가 없더구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030407
					],
					"speakerTitle": "울라프"
				},
				{
					"id": 110030407,
					"content": "얼음 나무? 나무가 사람을 공격할 수도 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030408
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110030408,
					"content": "그래, 나도 들어만 봤지, 직접 본 건 처음이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030409
					],
					"speakerTitle": "울라프"
				},
				{
					"id": 110030409,
					"content": "엄청 위험해 보이는데… 저 유적 근처엔 안 가는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110030410,
					"content": "맛있을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030411,
						110030412
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110030411,
					"content": "…에?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				},
				{
					"id": 110030413,
					"content": "바로 이거야! 승패를 결정짓는 식자재가 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030414
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110030414,
					"content": "진정해, 향릉. 그런 건 먹는 게 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110030415,
					"content": "그건 먹어봐야 알지. 빨리 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030416
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110030416,
					"content": "또 가버렸어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030417,
						110030418
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110030417,
					"content": "우리 먼저 갈게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030419,
					"content": "괜찮아, 난 걱정 말고 네 친구부터 쫓아가. 거긴 아주 위험하다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "울라프"
				},
				{
					"id": 110030418,
					"content": "아저씨는 일단 샘물 마을로 돌아가세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030412,
					"content": "그것도 먹으려고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				}
			]
		},
