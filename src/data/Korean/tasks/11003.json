			},
			"dialogs": [
				{
					"id": 110030201,
					"content": "추… 추워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030202
					],
					"speakerTitle": "울라프"
				},
				{
					"id": 110030202,
					"content": "몸이 너무 차! 빨리 체온을 올려야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030203
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110030203,
					"content": "여기에 불을 피우자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110030204,
					"content": "응, 그리고 따뜻한 수프가 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030205
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110030205,
					"content": "#{NICKNAME}, 난 여기서 아저씨를 돌보고 있을 테니까 <color=#00E1FFFF>따뜻한 수프</color> 좀 준비해줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030206
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110030206,
					"content": "오는 길에 츄츄족 야영지를 본 것 같아. 거기에 솥이 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030207
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110030207,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030208
					]
				},
				{
					"id": 110030208,
					"content": "응, 수프가 완성되면 바로 돌아와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "향릉"
				}
			]
		},
		{
			"id": 1100304,
			"completionStepIds": [
				1100304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
