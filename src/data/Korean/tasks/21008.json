					"성화"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "횃불은 왜 또 꺼지는 거야...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "성화"
				},
				{
					"id": 210080001,
					"content": "횃불이 왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "아, 여행자구나...저기 앞쪽에 전망대 3개가 보이지? 원래 저 위에 횃불이 켜져 있어야 하는데...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "성화"
				},
				{
					"id": 210080003,
					"content": "귀리 평원은 길이 험하고 몬스터들도 숨어 있어. 횃불은 행인들에게 길을 밝혀주기도 하고, 몬스터로부터 안전하다는 걸 알려주기도 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "성화"
				},
				{
					"id": 210080004,
					"content": "하지만...주변의 몬스터를 처치하느라 바빠서 횃불에 불을 계속 피워줘야 하는 걸 깜빡했지 뭐야. 알아챘을 땐 이미 횃불이 전부 꺼진 후였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "성화"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"성화"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "왜 직접 안 가는 거야...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "음, 그러니까 누가 횃불에 대해 알아보러 오면...내가 시간을 끌어야 하잖아...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "성화"
				},
				{
					"id": 210080103,
					"content": "만약에 네가 여기 서 있거나 아무도 없다면 큰일 나지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "성화"
				},
				{
					"id": 210080104,
					"content": "그러니까 횃불 좀 밝혀줘! 여행자, 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "성화"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
