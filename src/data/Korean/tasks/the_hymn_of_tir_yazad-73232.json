							"7323224",
							"2"
						],
						"stepId": 7323224,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소루쉬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732322401,
					"content": "「자{RUBY#[D]스펜타의 심장}비심」을 모두 연꽃으로 갖고 왔네. 이제 소루쉬 말대로 「신의 의식」을 깨울 수 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732322402,
					"content": "그럼 진정한 「기{RUBY#[D]압조르}우제」를 시작할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322403
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732322403,
					"content": "이제 난 크{RUBY#[D]신성한 빛}바레나 힘을 빌려 「가오케레나」가 다시 거룩한 꽃을 피우게 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322404
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732322404,
					"content": "그러면 거룩한 연꽃은 지금까지 쌓여온 오염을 뿜어낼 거고, 그 오염은 마물로 변해 우리를 방해하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322405
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732322405,
					"content": "하지만 걱정할 것 없어. 「신의 의식」이 깨어나면 감로의 힘이 우리를 지켜줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322406
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732322406,
					"content": "거룩한 꽃이 피기만 하면 감로를 온 대지에 뿌려서 모든 오염을 정화할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732322407
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732322407,
					"content": "자, 이제 용자의 최종 결전을 시작할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소루쉬"
				}
			]
		},
		{
			"id": 7323225,
