			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소루쉬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320601,
					"content": "이봐! 어서 일어나, 소루쉬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732320602,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320603
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732320603,
					"content": "휴, 드디어 일어났네. 아까 위에 있을 때 갑자기 기절해서 깜짝 놀랐다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732320604,
					"content": "응… 난 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320605
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732320605,
					"content": "네가 기절한 후에 어머니 나무가 열렸어. 그래서 우리는 여기까지 들어왔는데… 혹시 여기가 주르반이 말한 거대한 연꽃 「가오케레나」인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732320606,
					"content": "그래서 소루쉬, 아까는 대체 어떻게 된 거야? 화관에 문제가 생긴 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732320607,
					"content": "방금 어머니 나무로 돌아간 대지의 기억을 봤어. 수많은 페리와 다{RUBY#[D]켄리아}흐리의 장치, 인간의 용사가 마물과의 전투에서 목숨을 희생했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320608
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732320608,
					"content": "얼굴을 가린 검사와 외팔의 현자, 그리고 최초의 페리는 골짜기에서 나온 마물들을 무찔렀고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320609
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732320609,
					"content": "마지막에 그들의 의지는 모두 신{RUBY#[D]크바레나}성한 빛을 따라 어머니 나무로 돌아가 하늘에서 단비가 되어 내렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320610
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732320610,
					"content": "다{RUBY#[D]켄리아}흐리의 장치라… 설마 진짜 나세주나가 말한 대로는 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732320611,
					"content": "주르반에게 물어봐야겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732320612
					]
				},
				{
					"id": 732320612,
					"content": "음… 그런데 이제 우리 뭘 해야 하지? 주르반이 무슨 오염을 없애라고 했던 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732320613,
					"content": "「신의 의식」 속에 있는 「오염된 영역」으로 들어가서, 오염에 갇힌 「자{RUBY#[D]스펜타의 심장}비심」을 갖고 나와야 「신의 의식」을 깨울 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320614
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732320614,
					"content": "내가 본 기억 속에서 그곳은 끝없는 허무의 공간이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320615
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732320615,
					"content": "그럼 어떻게 들어갈 수 있는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732320616,
					"content": "날 따라오면 돼. 영웅들의 「속마음」을 따라가면 거기로 갈 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소루쉬"
				}
			]
		},
		{
			"id": 7323218,
			"completionStepIds": [
				7323218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
