			"dialogs": [
				{
					"id": 413590101,
					"content": "「영롱한 소등도」에 온 걸 환영해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413590102,
					"content": "이번에도 다른 도안을 준비했나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "당연하지. 네가 두 번 다 풀어버려서 이번엔 제일 어려운 걸로 준비했다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413590104,
					"content": "근데 도안 3개로 그림 하나를 완성하는 건 똑같아. 이번에도 어려운 건 <color=#00E1FFFF>「연동」</color>이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413590105,
					"content": "하하, 잘 고민해 보라구. 이번 그림은 <color=#00E1FFFF>「학」</color>이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413590106,
					"content": "그림을 다 맞추고 나서 보물을 찾으러 가면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소천"
				}
			]
		},
