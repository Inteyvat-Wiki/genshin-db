			"dialogs": [
				{
					"id": 740772501,
					"content": "#{NICKNAME}, 책에 뭐가 껴 있는지 좀 봐줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772502
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772502,
					"content": "와, 열쇠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740772503,
					"content": "맞아. 시모어가 음파로 대략 스캔해 봤는데, 그 문의 열쇠가 맞더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772504
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772504,
					"content": "예전에 폰타인성에서 여길 압수 수색했다면서? 왜 책에 숨겨진 열쇠를 발견하지 못한 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740772505,
					"content": "어쩌면 압수 수색 자체가 없었을지도 몰라. 방금 여기 노트를 뒤져봤는데 대략 이유를 이해할 수 있었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772506
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772506,
					"content": "왜 조용히 문만 닫고 떠났는지 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772507
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772507,
					"content": "음, 그게 무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740772508,
					"content": "별거 아냐. 이 정도면 충분했다고 생각했나 봐. 아래엔 언제든 작동할 수 있는 태엽 장치가 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772509
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772509,
					"content": "출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐터필러"
				}
