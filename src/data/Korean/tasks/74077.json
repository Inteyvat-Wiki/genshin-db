			"dialogs": [
				{
					"id": 740770701,
					"content": "여기에도 일부 장서와 나르치센크로이츠의 노트가 있네. 흥미롭긴 하지만 전부 결말이 없는 것들이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770702
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740770702,
					"content": "캐터필러, 궁금한 게 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770703
					]
				},
				{
					"id": 740770703,
					"content": "응, 얼마든지 물어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770704
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740770704,
					"content": "결사회 사람은 태엽 장치를 싫어하잖아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770705
					]
				},
				{
					"id": 740770705,
					"content": "근데 이 탑엔 왜 톱니바퀴가 많은 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770706
					]
				},
				{
					"id": 740770706,
					"content": "확실히 흥미로운 질문이네. 하지만 지금은 내 추론만 얘기할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770707
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740770707,
					"content": "내가 볼 때, 이곳의 메인 테마는 톱니바퀴가 아니라 시계야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770708
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740770708,
					"content": "야코브나 혹은 나르치센크로이츠에게도 시계 소리는 특별한 의미가 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770709
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740770709,
					"content": "특별한 의미?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770710
					]
				},
				{
					"id": 740770710,
					"content": "시계 종이 울릴 때 세계는 종결되고 모험은 끝나지. 혹은 꿈에서 깨거나. 누가 알겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐터필러"
				}
			]
