			},
			"dialogs": [
				{
					"id": 740772201,
					"content": "더 궁금한 게 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772202
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772202,
					"content": "일이 다 끝나면 라느와한테 갈 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772203
					]
				},
				{
					"id": 740772203,
					"content": "가보긴 하겠지. 근데 아마 계속 떠돌아 다닐 거야. 마음속에 아직 풀리지 않은 질문이 많이 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772204
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772204,
					"content": "야코브의 말을 듣고 「게시의 책」이 그들의 과거사와 관련됐다는 게 떠올랐어. 어쩌면 나에 관한 단서가 있을지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772205
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772205,
					"content": "여전히 과거가 신경 쓰이는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772206
					]
				},
				{
					"id": 740772206,
					"content": "응. 근데 그것보단 오래전에 읽었던 소설이 행복한 결말을 맞이했는지가 더 궁금해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772207
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772207,
					"content": "그걸 위해서 난 산도 물도 넘을 수 있어. 진심이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772208
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740772208,
					"content": "너 또 농담하는 거지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772209
					]
				},
				{
					"id": 740772209,
					"content": "조금은. 근데 난 멋진 꿈이 어떻게 끝나는지는 정말 궁금해. 진심이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐터필러"
				}
			]
		},
