			},
			"dialogs": [
				{
					"id": 740772301,
					"content": "#또 묻고 싶은 게 있으십니까, {NICKNAME} 님?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772302
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 740772302,
					"content": "앞으로 어떻게 할 계획이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772303
					]
				},
				{
					"id": 740772303,
					"content": "모든 게 끝난 후를 말씀하시는 겁니까? 만약 다시 마리안 님을 만날 수 있다면, 저는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772304
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 740772304,
					"content": "저는 마리안 님이 제가 마메흐 님께 돌아가는 걸 허락해 주셨으면 합니다. 그리고 셋이 함께 여행하길 바랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772305
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 740772305,
					"content": "넌 정말 좋은 개구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772306
					]
				},
				{
					"id": 740772306,
					"content": "당신의 뜻을 잘 이해하지 못하겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772307
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 740772307,
					"content": "넌 정말 믿음직한 프로토타입 기계야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740772308
					]
				},
				{
					"id": 740772308,
					"content": "칭찬 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시모어"
				}
