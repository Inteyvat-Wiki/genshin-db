			"dialogs": [
				{
					"id": 150420101,
					"content": "야호——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420102,
					"content": "햇살! 파도! 어룡!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420103,
					"content": "흥분한 나머지 자기 고대 이름이 「우{RUBY#[S]단결}모자」인 것도 잊은 모양이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150420104,
					"content": "빨리 와, 여기야 여기! 아이 정말, 빨리~ 뛰어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420105,
					"content": "지금 가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150420106,
					"content": "봐! 이게 뭐게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420107,
					"content": "나무판?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150420108,
					"content": "글씨를 봐야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420109,
					"content": "오오, 관광 지도네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150420110,
					"content": "관광 지도! 그거라면 거대 보물 창고의 열쇠 못지않은 가치가 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420111,
					"content": "응, 모험의 시작을 상징하는 거니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150420112,
					"content": "마치 맹렬하게 타오르는 열소 씨앗 같달까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420113,
					"content": "열소? 어… 그건 일종의 에너지 맞지? 그 말은… 쳐다보기만 해도… 힘이 마구 솟는다는 뜻인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150420114,
					"content": "맞아! 그리고 엄청 중요하다는 뜻이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420115,
					"content": "지도가 있으면, 언제든 길을 확인하면서 자기만의 자유로운 모험을 떠날 수 있으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420116,
					"content": "오오, 자유! 모험!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "아샤"
				},
				{
					"id": 150420118,
					"content": "잠깐만… 뭔가 수상해. 말에 숨겨진 뜻이 있는 것 같은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150420119,
					"content": "자, 그럼 해산!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420120,
					"content": "관광 명소에 도착하자마자 해산하라고 하는 가이드가 어딨어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150420121,
					"content": "말라니도 혼자 놀고 싶을 때가 있겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "역시 내 파트너라니까! 내 편 들어준 거 절대 잊지 않을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420124,
					"content": "다들 봐봐, 여기 두 프로그램 옆에 「테스트 대기」라고 적혀있어. 아무래도 무슨 문제가 생긴 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420125,
					"content": "그러니까 각자 관심 있는 프로그램을 체험해 보면서 테스트를 도와주면 어때? 파도파도만이 하루라도 빨리 오픈할 수 있도록!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420126,
					"content": "수상 프로그램만 보면 우리는 내팽개칠 줄 알았는데, 생각보다 많이 신경 써주는구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150420127,
					"content": "헤헤, 그리고 마지막엔 저 커다란 어룡 근처에서 모이자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420128,
					"content": "내 오랜 가이드 경험으로 볼 때, 이 구역의 메인 도전 입구는 분명 저쪽에 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420129,
					"content": "그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150420130,
					"content": "그럼 해산! 다들 지도 잘 보고 다녀!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "말라니"
				},
				{
					"id": 150420122,
					"content": "오늘은 「가이드」도 휴가인 거지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
