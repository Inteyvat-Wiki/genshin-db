			"dialogs": [
				{
					"id": 150421401,
					"content": "어땠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150421402,
					"content": "쉬웠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "큰소리 치기는, 그래도 꽤 잘했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150421408,
					"content": "나도 스태프한테 제안해 봐야겠어. 나중에 개선해줄지도 모르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150421409,
					"content": "그래도 어쨌든… 두 선수한테 승패를 가릴 기회는 줘야 하지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "차스카"
				},
				{
					"id": 150421404,
					"content": "눈이 침침해요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "하하, 확실히 집중력을 유지하는 데는 체력이 소모되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150421406,
					"content": "재밌었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "그래? 같은 판단을 내린 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "차스카"
				}
			]
		},
