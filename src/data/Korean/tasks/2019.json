			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「시뇨라」",
					"페이몬",
					"라이덴 쇼군"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "기세등등하게 아주 줄줄이 달려드는군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190102,
					"content": "여기가 천수각인 걸 몰랐다면, 길거리 장터로 착각할 뻔했다니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190103,
					"content": "이제 좀 얌전해지겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190104,
					"content": "아, 「시뇨라」가 쿠죠 사라를…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20190105,
					"content": "이나즈마 백성들의 잘못은 내가 처벌한다. 그대는 자격이 없어, 「시뇨라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20190106,
					"content": "…그것참 죄송하게 됐군요, 쇼군님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190107,
					"content": "「시뇨라」!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "그래그래, 나 못 잊는 거 나도 알아. 입이 닳도록 부를 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190109,
					"content": "날 미워하는 것도 알아… 끈질긴 여행자, 여기서 널 만난 게 하나도 이상하지 않은걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190110,
					"content": "암암리에 사안을 퍼뜨리고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "쇼군 앞에서 내 「죄」를 고발하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190113,
					"content": "후후후… 난 스네즈나야에서 온 외교 사절일 뿐이야. 무슨 소리를 하는지 도통 모르겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190114,
					"content": "우린 안중에도 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20190115,
					"content": "신의 눈을 잃은 백성을 위해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "내 관심 밖의 사람과 일에 대해서 그만 좀 떠들어줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190118,
					"content": "이름 모를 엑스트라들이 「영원함」에 다다르기 위한 혁명의 디딤돌이 된 것만으로도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190119,
					"content": "그들의 짧은 생에 있어 엄청난 영광 아닌가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190120,
					"content": "내 말 맞죠, 쇼군님?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20190122,
					"content": "벤티의 신의 심장도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "과거까지 들추는 거야? 너 뒤끝 장난 아니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190125,
					"content": "스네즈나야 여왕 폐하의 꿈은 이 세상에서 가장 고결하고 순수하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190126,
					"content": "그에 반해 네가 말한 것들은… 거론할 가치도 없는 「필수적인 희생」에 지나지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190127,
					"content": "끝을 낼 때가 됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "하, 끝을 내? 하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190129,
					"content": "나도 네 얼굴이 지겨워지던 참이었는데, 이렇게 무대포일 줄은 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190130,
					"content": "큰소리치기 전에 넌 지금 이나즈마의 1급 수배범인 걸 자각하라고. 제 처지나 생각할 것이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190131,
					"content": "천수각에 쳐들어와 쇼군 앞에서 망발을 늘어놓는 건, 대놓고 잡아가라는 거 아닌가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190132,
					"content": "너와 나의 차이를 알길 바라. 지위든… 실력이든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190133,
					"content": "너에게——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "——「어전시합」을 신청하겠다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190136,
					"content": "음",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20190137,
					"content": "이 패를 꺼내 들다니… 너도 이 나라의 「규칙」을 이용할 줄 안다 이건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190138,
					"content": "억지로 너와 날 동등한 위치로 올려놓다니. 인정할게, 좀 뜻밖이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190139,
					"content": "하지만 패자는… 죽어. 잘 알고 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20190141,
					"content": "후후후… 그럼 어느 한쪽이 끝을 볼 때까지… 이 귀하신 몸이 함께 한 곡 춰주마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「시뇨라」"
				},
				{
					"id": 20190123,
					"content": "리월을 위험에 빠트린 것도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "사안에 잠식당한 전우를 위해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "이나즈마를 장악하려 하다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
