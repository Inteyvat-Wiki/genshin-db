			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"가이각스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "여어! 또 만났군. 이런 우연이 있나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790102,
					"content": "실례지만 당신은…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "가이각스야! 바람의 행방, 기억 안 나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790106,
					"content": "아, 너였구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706790107,
					"content": "이제 기억났어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "전혀 기억 안 나는 표정인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790109,
					"content": "뭐, 그건 됐고. 잠깐 이쪽으로 와 봐. 이 「바람의 행방」은 기억하고 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790110,
					"content": "전에 직접 테스트해 보고 이런저런 조언을 해줬잖아. 하나같이 좋은 아이디어라 전부 채택했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790111,
					"content": "그래서 규칙이랑 내용을 조금… 아니, 정확히 말하자면 여러 번 고쳤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790112,
					"content": "이해하기 어려운 건 아니죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "걱정 마, 새로 만든 버전은 분명 마음에 들 테니까. 지금부터 간단히 설명해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790115,
					"content": "우선 새로운 「바람의 행방」에 「발신기」라는 걸 추가했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790116,
					"content": "레인저가 「발신기」 4개를 작동시키면 헌터를 쓰러뜨리고 승리를 차지할 수 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790117,
					"content": "반면 헌터 쪽은… 똑같아. 예전처럼 레인저를 전부 붙잡으면 이기는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790118,
					"content": "다만 이번 「바람의 행방」에서는 레인저가 헌터에게 붙잡혀도 바로 탈락하는 게 아니라, 「감시 구역」이라는 장소로 이동하게 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790119,
					"content": "일정 시간이 지나거나 다른 레인저의 도움을 받으면 붙잡힌 레인저는 「감시 구역」에서 탈출할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790120,
					"content": "대신 한 번 잡혔던 사람이 또다시 붙잡히면… 그때는 탈락하게 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790121,
					"content": "조금 복잡한 것 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "안심해. 들을 땐 그렇게 느껴질지 몰라도 몇 판 해보면 바로 이해할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790124,
					"content": "그럼 한번 해볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "좋았어! 그럼 이쪽으로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790126,
					"content": "다른 일이 있어서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "그래, 난 한동안 여기 머물 거니까 시간 날 때 다시 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가이각스"
				},
				{
					"id": 706790122,
					"content": "새로 추가된 규칙이 많네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "이상한 내용을 추가한 건 아니죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "아… 바람의 행방의!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "가이각스야! 하긴 뭐, 나도 내 이름보다 바람의 행방이 더 유명해지는 걸 바라니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "가이각스"
				}
			]
		}
	]
}