				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80060501,
					"content": "이 깊은 지하에 어떻게 이런 꽃이 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80060502,
					"content": "죽은 츄츄족들을 위한 꽃인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060503,
						80060504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80060503,
					"content": "무슨 꽃인지 알아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				},
				{
					"id": 80060505,
					"content": "어, 그러고 보니 나도 낯이 익어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80060506,
					"content": "켄리아의 국화——「인티바트」. 과거 켄리아 대지 곳곳에 만개했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060507,
					"content": "이 꽃의 수명은 2주에 불과해. 하지만 누군가에 의해 꺾여서 켄리아의 대지를 떠나면, 꽃잎은 더 이상 성장하지 않고 무척이나 단단해져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060508,
					"content": "고향 땅에 돌아와서야 꽃잎은 다시금 부드러워지고 마침내 흙으로 돌아가지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060509,
					"content": "그래서 인티바트는 「나그네」를 상징하고, 「고향의 따스함」이라는 의미를 담고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060510,
					"content": "#{M#제 동생 머리에 있는 꽃이에요}{F#제가 깨어났을 때부터 머리에 있던 꽃이에요}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "앗! 그럼 그 꽃이 여기에 나타났다는 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80060512,
					"content": "#{F#왕자}{M#공주} 전하, 드디어 동의하신 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "심연 사도"
				},
				{
					"id": 80060513,
					"content": "「천리」에 대항하는 것에 너무 집중한 나머지 「나라를 부활시키는」 사명을 소홀히 했어",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "그래, 이렇게 우유부단해선 안 돼",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "「장치」가 곧 완성됩니다. 언제든 분부를 내려주십시오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "심연 사도"
				},
				{
					"id": 80060516,
					"content": "성공 가능성은?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "이론상으로는, 대략…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "심연 사도"
				},
				{
					"id": 80060518,
					"content": "됐어, 설령 1퍼센트의 희망밖에 없다 해도…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "우리도 다를 거 없지. 이미 심연 속에 있으니",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "「그들」에겐 긍지조차 없이 사느니 하루빨리 「순환」으로 돌아가는 게 나아",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "「그들」에게 더 이상… 무고한 죄를 짊어지게 해선 안 돼",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "전하의 결단이 곧 교단의 행운입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "심연 사도"
				},
				{
					"id": 80060523,
					"content": "#{F#오빠}{M#루미네}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "무언갈 본 모양이군. 뭘 봤는지 알려줄 수 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060525,
					"content": "맞아, 한참이나 멍해 있던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80060526,
					"content": "방금 본 장면을 데인슬레이프에게 얘기한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "「쌍둥이」에게만 있는 기묘한 연계인가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060528,
					"content": "그들이 어떤 장치를 이용해서 저주를 정화하려는 것 같군. 우리가 전에 봤던 그 물건일 수도 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060529,
					"content": "게다가… 나라를 「부활」시킨다고 했다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060530,
					"content": "맞아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "그 고집불통, 아직도 포기를 못 했군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060533,
					"content": "보아하니, 교단은 이 장소를 이용해서 츄츄족에게 걸린 저주를 정화하고 원래대로 복원시키려는 모양이야…. 켄리아 부활의 기반으로 삼으려고 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060534,
					"content": "「국민」이 없으면 「국가」를 논할 수 없는 법이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060535,
					"content": "어떻게 생각하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "흥, 어리석기는. 1퍼센트의 가능성도 없는 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060538,
					"content": "내가 말했듯이, 저주와 500년을 공존한 사람으로서 나보다 저주를 잘 아는 사람은 없어… 구원 같은 건 존재하지 않아. 저주는 되돌릴 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060539,
					"content": "저주를 강제로 제거하려 든다면, 고통 말고 아무것도 얻을 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060540,
					"content": "그러니 정신 바짝 차리고 스스로 끊임없이 경고해야 돼——그것들은 더 이상 인간이 아니라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060541,
					"content": "여기에 집착해서 감정을 과하게 몰입하면 점점 더 깊이 빠져들 거야…. 그리고 결국 그들처럼 위선이라는 더러운 늪에 빠지고 말겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060542,
					"content": "구원할 가치가 있는 것에 집중하자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060543,
					"content": "제가 왜 당신을 믿어야 하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060545,
					"content": "#하하… 하긴. 우린 고용 관계에 불과하지만, {M#그녀}{F#그}는 네 가족이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060546,
					"content": "#네가 {M#그녀}{F#그}를 택하는 건 당연한 일이지. 문제 될 것 전혀 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060547,
					"content": "네가 어떤 선택을 하든 내 마음은 변하지 않아. 심연을 저지하는 게 내가 걷기로 한 길이야. 의견이 엇갈린다면 차라리 지금…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060548,
					"content": "이번엔 믿을게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "그렇다고 당신을 완전히 신뢰하는 건 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "그렇군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060552,
					"content": "1%의 확률로 구원받을 수 있고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "누구에게도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "게다가 그 츄츄족들은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "전에 내가 물었던 세 가지 질문이 무의미하진 않은 모양이군. 넌 이 세계를 보는 너만의 방법을 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060559,
					"content": "네 솔직한 생각을 얘기해 줬으니, 나도 더 이상 숨길 필요 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060560,
					"content": "현재로서 나한테 심연을 저지하는 것보다 더 중요한 건——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060561,
					"content": "심연이 이렇게 독단적으로 할프단과 다른 기사들의 「마지막 염원」을 짓밟게 둘 순 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060562,
					"content": "이해해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "심연이 언제 나타날지 몰라. 경계를 늦추지 말고 계속 전진하자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80060563,
					"content": "앞으로도 계속 협력하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "이미 스스로의 마지막 정착지를 선택했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "다른 생명을 대신해서 그런 선택을 내릴 자격은 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "99%의 확률로 고통스럽게 죽는 거잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "#{F#오빠}{M#루미네}의 방식을 인정할 수 없는 것뿐이니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "성공할 가능성이 있을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "그게 사명이라고 했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "이런 꽃을 본 적이 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		},
