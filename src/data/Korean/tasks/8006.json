				"points": []
			},
			"dialogs": [
				{
					"id": 80060401,
					"content": "조금 허름한 츄츄족 영지야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80060402,
					"content": "여기도 불쌍해 보이는 츄츄족들이 있네. 일부는… 생명의 기운이 느껴지지 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80060403,
					"content": "할프단이 우리한테 보여주려는 게 여긴가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80060404,
					"content": "어떻든 간에 여긴 자세히 조사할 가치가 있어. 사소한 것 하나 놓치지 말고 주변을 둘러보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데인슬레이프"
				}
			]
		},
		{
			"id": 800605,
			"completionStepIds": [
				800605,
				800609,
				800610,
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800605",
							"2"
						],
						"stepId": 800605,
