			},
			"dialogs": [
				{
					"id": 80062101,
					"content": "이 상자들은 츄츄족이 음식을 저장하는 곳이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80062102,
					"content": "거의… 다 빈 것 같네. 츄츄족은 생명의 끝에 다다르면 음식을 안 먹어도 되는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80062103,
					"content": "나라면 적어도… 음식의 맛이 그리울 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 800622,
			"completionStepIds": [
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800605",
							"2"
						],
						"stepId": 800605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80062201,
					"content": "이 츄츄족들… 생명의 기운이 전혀 안 느껴져. 곧 어둠과 하나가 될 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80062202,
					"content": "항상 시끄러운 츄츄족들이 이런 방식으로 늙어갈 줄이야. 놀라워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80062203,
					"content": "츄츄족과 좋은 기억은 별로 없지만, 마지막 순간에는 안식을 취했으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 800655,
			"completionStepIds": [
				800605,
				800609,
				800610,
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800605",
							"2"
						],
						"stepId": 800605,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PLAYER_CHOOSE_MALE",
