				"points": []
			},
			"dialogs": [
				{
					"id": 705280401,
					"content": "길드는 도와주겠다는 거야, 말겠다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280402,
					"content": "여행자! 미안해, 방금 길드 일로 고민하느라 잠깐 한눈을 팔아버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280403,
					"content": "윈드블룸 축제 때문에 온 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280404,
					"content": "마침 모험가 길드에서 게임을 하나 출시했는데, 분명 재미있을 거야. 참여하면 보상도 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280405,
					"content": "어때, 한번 해볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280406,
					"content": "게임을 간단하게 소개해줄게. 게임의 개발자는 이 게임에 「꽃놀이 체스」라는 이름을 붙였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280407,
					"content": "흩날리는 꽃잎과 그 꽃잎을 쫓는 바람에서 영감을 받았다고 하던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280408,
					"content": "게임에도 꽃잎을 쫓는 듯한… 그런 낭만적인 느낌을 담았다고 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280409,
					"content": "어, 엄청 시적이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "그 친구는 음유시인이라서… 그 뭐랄까… 상상력이 풍부하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280412,
					"content": "쉽게 말하자면 체스판 위에 있는 「윈드블룸 풍선」을 최대한 많이 모아야 하는 게임이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280413,
					"content": "풍선을 모으는 과정에서 이런저런 장애물을 피해야 하지…. 물론 게임판 위엔 각종 보조 아이템도 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280414,
					"content": "그 친구가 자세한 게임 설명서를 만들었으니까 이따가 한번 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280415,
					"content": "관심 있으면 언제든지 놀러 와, 참여하면 보상도 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플라우엔"
				},
				{
					"id": 705280410,
					"content": "보, 복잡하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}