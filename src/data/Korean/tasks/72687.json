	"talks": [
		{
			"id": 7268701,
			"completionStepIds": [
				7268701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268701",
							"2"
						],
						"stepId": 7268701,
						"stateName": "QUEST_STATE_UNFINISHED"
