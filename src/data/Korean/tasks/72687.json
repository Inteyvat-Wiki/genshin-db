				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"후시조메"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870101,
					"content": "인연이 닿은 분이시군요, 안녕하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870102
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870102,
					"content": "두 분의 모든 행동에서 향기가 풍기는 걸 보니, 필시 운치 있는 물건의 세례를 받으신 분들이 틀림없군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870103
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870103,
					"content": "#응? 우리 몸에서 향기가 난다고? 여기 좀 와봐, {NICKNAME}, 킁킁",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870104,
					"content": "진짜네, 네 몸에서 맛있는 버섯고기말이의 냄새가 나! 이 언니, 정말 보는 눈 있네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870105,
						726870106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870105,
					"content": "그 향기를 얘기하는 게 아닐 텐데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				},
				{
					"id": 726870107,
					"content": "맞아, 이 익숙한 전개는… 알겠다! 이 언니도 우리 도움이 필요한 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870108,
					"content": "두 분은 맡은 바 임무에 최선을 다하는 가이드시니, 분명 저를 위해 더욱 많은 손님을 모을 수 있겠죠. 하지만 전 두 분이 손님으로 이 축제를 즐길 수 있기를 바라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870109
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870109,
					"content": "시간 괜찮으시면 여러분만의 전용 「꽃 그림자가 드리운 정원」을 만들어 보시겠나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870110
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870110,
					"content": "「꽃 그림자가 드리운 정원」이 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870111,
					"content": "저도 알고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870112
					]
				},
				{
					"id": 726870112,
					"content": "보시다시피, 전 원예사에요. 옆에 진열된 화분대는 「꽃꽂이」로 이루어진 「화원」이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870113
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870113,
					"content": "정성껏 다듬은 꽃을 화기에 담고 다양한 장식을 더해 테이블 위의 정원 같은 정경을 만드는 거죠. 그게 바로, 원예의 결정체인 「꽃 그림자가 드리운 정원」이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870114
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870114,
					"content": "야시로 봉행의 지원을 받아, 전 「꽃 그림자가 드리운 정원」 몇 개를 이로도리 축제에 전시하게 됐어요. 손님들께 원예의 아름다움을 알리고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870115
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870115,
					"content": "「꽃 그림자가 드리운 정원」에 관심이 있다면 지금 바로 체험하실 수 있답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870116
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870116,
					"content": "확실히… 이 원예 작품들은 정말 예뻐. 그리고 되게 고상하게 들리네. 근데 왠지 엄청 어려울 거 같은데… 우리가 할 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870117,
						726870118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870117,
					"content": "페이몬은 손재주가 없거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870119,
					"content": "걱정 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870120
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870120,
					"content": "손님들이 원예의 매력을 충분히 느낄 수 있도록, 미리 부품을 제작해 두어 「꽃 그림자가 드리운 정원」의 제작 단계를 어느 정도 간소화했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870121
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870121,
					"content": "「메인 꽃」, 「배경」과 「초석」을 선택하고 적당히 조합하면 「꽃 그림자가 드리운 정원」을 만들 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870122
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870122,
					"content": "물론, 가장 중요한 건 원예의 「표현」을 음미하는 거예요. 그러니 구도의 사고력을 시험하기 위한 「꽃 퀴즈」 네 개를 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870123
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870123,
					"content": "매일 「꽃 퀴즈」를 완료하면 그에 맞는 꽃과 「화원」을 기념으로 가져가실 수 있고, 그뿐만 아니라 추가 상품도 받아 가실 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870124
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870124,
					"content": "정말? 좋은데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870125,
					"content": "#{NICKNAME}, 이 언니가 엄청 열심히 원예를 홍보하고 있잖아. 우리가 도와주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870126,
						726870127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870126,
					"content": "아름다운 원예를 위해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870128,
					"content": "그럼 지금 바로… 뭐였더라? 아! 우리만의 「꽃 그림자가 드리운 정원」을 만들자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870129,
					"content": "원예에 정성과 열정을 쏟아주셔서 정말 고마워요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870130
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870130,
					"content": "그럼 지금 바로 시작하죠, 오늘의 「꽃 퀴즈」는 「보랏빛 벚꽃, 맑은 모래의 향기」입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870131
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870131,
					"content": "퀴즈의 깊은 뜻을 헤아리고 꽃과 화기에 집중하면서 두 분 만의 「꽃 그림자가 드리운 정원」을 만들어 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870127,
					"content": "추가 상품을 위해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870128
					]
				},
				{
					"id": 726870118,
					"content": "페이몬은 자유분방한 게 습관이라서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870119
					]
				},
				{
					"id": 726870106,
					"content": "포인트가 틀렸잖아, 페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870107
					]
				}
			]
		},
		{
			"id": 7268705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268702",
							"2"
						],
						"stepId": 7268702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"후시조메"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "며칠간은 여기서 계속 스가타노 이로도리 축제의 손님 안내 업무를 맡을 거예요. 반드시 「꽃 그림자가 드리운 정원」의 정교함을 느끼게 해주겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870202,
					"content": "두 분, 매일 공개되는 「꽃 퀴즈」를 잊지 마세요. 총 4문제가 여러분의 답변을 기다리고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870203,
					"content": "물론 두 분께서 또 다른 문제가 생기신다면 제가 최대한 해결해 드리겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870204,
					"content": "이곳의 꽃에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "제가 사용한 꽃은 모두 「사쿠야 꽃집」이 제공한 꽃들이에요. 「사쿠야 꽃집」이 키운 꽃들은 흠잡을 데 없는 품질과 저렴한 가격을 자랑하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870206,
					"content": "사쿠야를 만난 적이 있을지도 모르겠네요. 저희는 같은 선생님 밑에서 「꽃꽂이」를 배웠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870207,
					"content": "사쿠야도 꽃꽂이에 대한 조예가 깊어요. 하지만 이로도리 축제의 손님들이 끊이질 않아서, 약간 긴장한 것 같아요. 이런 환경에서 꽃꽂이를 할 수 있을지 걱정인가 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870208,
					"content": "그래서 다른 손님들한테도 그녀의 「사쿠야 꽃집」을 소개시켜 줄 생각이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870209,
					"content": "기회가 된다면 우리도 도와줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726870219,
					"content": "그럼 다른 도움이 필요하시나요, 두 분?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870220,
					"content": "감사합니다, 후시조메 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "천만에요. 여러분만 괜찮으시다면 언제든지 절 찾아오세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870210,
					"content": "야시로 봉행에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "야시로 봉행은 줄곧 이나즈마의 꽃꽂이 사업을 지원하고 있어요. 정확하게 말하자면 이번 이벤트에 투자한 귀인이 바로 그 백로공주에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726870212,
					"content": "백로공주는 어릴 적부터 꽃꽂이에 뛰어난 재능을 보였어요. 그녀의 「꽃꽂이」를 보고, 운 좋게 그녀와 꽃꽂이 대해서 얘기한 적도 있어요",
