				},
				{
					"id": 150330808,
					"content": "그래, 그 유명 인사가 바로 나야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150330809
					]
				},
				{
					"id": 150330809,
					"content": "다음에 내 옷에 사인해 주라~ 소중히 간직할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150330812
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 150330812,
					"content": "참, 그래서 여긴 무슨 일로 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "얀사"
				},
				{
					"id": 150330810,
					"content": "조금 부끄럽네…",
