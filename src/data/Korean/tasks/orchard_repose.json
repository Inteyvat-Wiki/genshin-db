					"content": "응응. 참, 기왕 여기까지 왔으니까 과일 좀 따 먹자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150331414
					],
					"speakerTitle": "바레사"
				},
				{
