			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"캐서린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260101,
					"content": "여행자, 안녕. 또 만났네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260102
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260102,
					"content": "최근에 의뢰한 임무들을 훌륭하게 수행해 줬어. 이제 모험가 길드의 VIP 회원이라고 손색없겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260103,
						700260105
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260103,
					"content": "과찬이세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260104
					]
				},
				{
					"id": 700260104,
					"content": "이나즈마 모험가 길드 지부는 다른 지부와 자주 연락하는 편이야. 덕분에 네가 몬드와 리월에서의 활약은 이미 다 들었고. 정말 대단하던걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260107,
					"content": "이번에 널 부른 건 간단한 조사 의뢰를 부탁하고 싶어서야. 조사할 구역은 츠루미에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260108
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260108,
					"content": "츠루미 지역 날씨는 특이하게도 항상 안개로 뒤덮여있다고 해. 하지만 조사만 하는 거라 큰 위험은 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260109
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260109,
					"content": "길드에서는 이 의뢰를 경험이 많은 모험가에게 의뢰했는데 츠루미로 갔다가 바로 돌아와서는 의뢰를 취소했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260110
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260110,
					"content": "다른 설명은 안 하고 그저 자신의 능력이 부족해서 의뢰를 포기하겠다고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260111
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260111,
					"content": "그 모험가 이후로 꽤 오랫동안 의뢰를 내걸어 놨지만, 의뢰를 받는 사람이 아무도 없었어. 의뢰인도 답답한지 몇 번이고 찾아왔지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260112
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260112,
					"content": "그래서 생존 능력이 출중하고, 경험도 더 많은 모험가라면 이번 의뢰도 해결할 수 있지 않을까 하고 생각하던 차에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260113
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260113,
					"content": "네가 딱 떠오르더라고. 여행자, 어때? 의뢰에 관심 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260114,
						700260117
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260114,
					"content": "수상한 냄새가 나네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260115
					]
				},
				{
					"id": 700260115,
					"content": "이해해. 그 모험가가 포기할 거라곤 나도 생각 못 했거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260116
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260116,
					"content": "츠루미는 인적도 드물어서, 모험가 길드도 그곳 상황에 대해 아는 게 많지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260120
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260120,
					"content": "음, 그럼 의뢰 난이도를 조금 낮추면 고려해 볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260121
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260121,
					"content": "조사하면서 만약 어려운 일이나 위험한 일이 생기면 즉시 조사를 중단하고, 길드로 돌아와 도움을 요청하는 것으로 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260122
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260122,
					"content": "의뢰인은 수메르 「아카데미아」에서 온 학자야. 처음에는 츠루미의 기후에 대해서 연구하려고 했는데, 연구하는 과정에 있어서 문제가 생겼나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260123
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260123,
					"content": "그래서 여기에서 조사 의뢰를 부탁한 거야. 의뢰 보수로 연구 경비의 반 이상을 내놨다고 들었어. 보수가 엄청 두둑해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260124,
						700260125
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260124,
					"content": "의뢰를 받을게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260126
					]
				},
				{
					"id": 700260126,
					"content": "정말 고마워. 지도에 조사할 곳을 표시해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260127
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260127,
					"content": "조심해야 해. 그럼 행운을 빌게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260128
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260128,
					"content": "별과 심연을 향해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260125,
					"content": "시도해봐도 손해는 아니니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260126
					]
				},
				{
					"id": 700260117,
					"content": "생각 좀 해볼게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260118
					]
				},
				{
					"id": 700260118,
					"content": "알 수 없는 위험 때문에 주저하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260119
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260119,
					"content": "실은 다른 모험가들도 같은 이유로 거절한 적이 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260120
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700260105,
					"content": "본론부터 말씀하시죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260106
					]
				},
				{
					"id": 700260106,
					"content": "넌 역시 소문처럼 시원시원하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260107
					],
					"speakerTitle": "캐서린"
				}
			]
		},
		{
			"id": 7002602,
			"completionStepIds": [
				7002603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
