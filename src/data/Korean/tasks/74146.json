			"dialogs": [
				{
					"id": 741460201,
					"content": "#…연산 프로세스 중지. {NICKNAME} 님, 무슨 일이십니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460202,
						741460209,
						741460214,
						741460220
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460202,
					"content": "현재 상황에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460203
					]
				},
				{
					"id": 741460203,
					"content": "물의 정령·안 님과 수선화 십자 결사회 잔당·캐터필러와의 소통을 통해 일부 유효한 정보를 습득했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460204
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460204,
					"content": "저는 프로토타입 기계 4ACV07입니다. 기요틴에 의해 설계되었으며 제 주인인 마리안 님을 보필하고 지키기 위해 존재합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460205
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460205,
					"content": "아쉽게도 현재 마리안 님에 대한 유효한 정보는 이 이상 습득하지 못했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460206
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460206,
					"content": "또한 물의 정령·안 님이 제공할 수 있는 정보는 극히 제한적입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460207
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460207,
					"content": "수선화 십자 결사회 잔당·캐터필러는 모든 정보를 제공하지 않았습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460208
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460208,
					"content": "분석을 위해 더 많은 시간이 필요합니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460209,
					"content": "시모어에 대해 더 알고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460210
					]
				},
				{
					"id": 741460210,
					"content": "저는 프로토타입 기계 4ACV07입니다. 기요틴에 의해 설계되었으며 제 주인인 마리안 님을 보필하고 지키기 위해 존재합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460211
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460211,
					"content": "제겐 폰타인 자연철학 학원의 최첨단 광학 설비와 기억 저장 유닛, 논리 유닛 등의 각종 기능 모듈이 탑재되어 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460212
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460212,
					"content": "덕분에 저는 마리안 님의 일상생활을 기록하는 동시에 수사 요원의 조수로서 실력을 발휘할 수 있었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460213
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460213,
					"content": "현재 최우선 목표는 마리안 님을 찾아 그분의 안전을 확보하는 것입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460214,
					"content": "마리안에 대해 더 알고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460215
					]
				},
				{
					"id": 741460215,
					"content": "제 설계 및 제작 목적은 제 주인이신 마리안 님을 보필하고 지키는 것입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460216
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460216,
					"content": "현재 최우선 목표는 마리안 님을 찾아 그분의 안전을 확보하는 것입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460217
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460217,
					"content": "물의 정령·안 님의 일부 행동에서 마리안 님의 과거 행동과 유사한 특징이 관찰됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460218
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460218,
					"content": "다만 그들을 이루는 요소… (시끄러운 기계음), …(시끄러운 기계음)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741460219
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460219,
					"content": "알림: 주기적으로 기록 공간을 정리하면 해당 문제의 발생 빈도를 효과적으로 감소시킬 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시모어"
				},
				{
					"id": 741460220,
					"content": "아무것도 아니야. 이만 가볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741460221
					]
				},
				{
					"id": 741460221,
					"content": "#알겠습니다. 행운을 빕니다, {NICKNAME} 님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시모어"
				}
			]
		},
		{
			"id": 7414603,
