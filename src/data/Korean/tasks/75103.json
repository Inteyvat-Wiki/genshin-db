					}
				]
			},
			"dialogs": [
				{
					"id": 751030101,
					"content": "와, 생선 살코기다! 너희 여기서 뭐 하는 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751030102,
					"content": "#응? 아, 안녕! 금발 {M#오빠}{F#언니} 그리고 흰… 흰… 음, 동생이려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030103,
					"content": "난 이와이랑 이곳에서 둥둥 펭귄이 올라오기를 기다리고 있어. 어차피 따로 할 일도 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030104,
					"content": "음, 둥둥 펭귄이 올라오기를 기다린다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751030105,
					"content": "우, 우우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "이와이"
				},
				{
					"id": 751030106,
					"content": "자자, 이와이 착하지. 인내심을 갖고 기다려야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030107,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "이와이"
				},
				{
					"id": 751030108,
					"content": "아무튼 우린 놀러 온 거야. 론코 아저씨 말고는 아무도 여기에 오지 않아서 사실상 우리 비밀기지나 다름없어! 그런 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030109,
					"content": "그런데 오늘은 둥둥 펭귄에게 선수를 뺏겼지 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030110,
					"content": "그래서 이 생선 살코기로 둥둥 펭귄을 유인하려고 했어. 둥둥 펭귄은 생선 살코기를 좋아하니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030111,
					"content": "하지만 둥둥 펭귄을 유인하지 못한 것 같은데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "맞아, 너무 멀어서 냄새가 안 났나 봐. 먼저 녀석들을 땅 위로 끌어내야 할 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030117,
					"content": "론코 아저씨라면 <color=#00E1FFFF>「녀석들을 몸통박치기로 밀어 올리면 된다!」</color>라고 하겠지… 안타깝게도 나랑 이와이는 힘이 너무 약해서 되려 녀석들한테 밀려버릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030118,
					"content": "#음… {NICKNAME}, 우리가 한번 해볼까? 둥둥 펭귄을 육지로 밀어 올리면 생선 살코기에 이끌릴지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751030112,
					"content": "그렇구나, 페이몬도 사실은 둥둥 펭귄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "동글동글하고 생선을 좋아하니까… 확실히 둥둥 펭귄이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "파니야"
				},
				{
					"id": 751030114,
					"content": "웅, 웅!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "이와이"
				},
				{
					"id": 751030115,
					"content": "아니거든! 그나저나 둥둥 펭귄들을 전혀 유인하지 못했잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "페이몬"
				}
			]
		},
