	"talks": [
		{
			"id": 7307101,
			"completionStepIds": [
				7307101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
