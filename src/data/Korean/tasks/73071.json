				{
					"id": 730710601,
					"content": "우와… 온통 달콤달콤꽃이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710602
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710602,
					"content": "바샤, 조심해. 그렇게 빨리 뛰면 넘어져!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710603,
					"content": "헤헤, 꽃이 정말 활짝 피었네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710604
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710604,
					"content": "#{NICKNAME}, 페이몬! 얼른 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710605
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710605,
					"content": "#바샤는 정말 성격이 급하다니까. {NICKNAME}, 우리도 얼른 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
