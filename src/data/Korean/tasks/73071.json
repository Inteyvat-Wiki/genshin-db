					"바샤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710201,
					"content": "달콤달콤꽃은 씨앗만 있으면 더 많은 달콤달콤꽃을 심을 수 있어. 하지만 빵은 달라. 먹으면 바로 없어지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710202
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710202,
					"content": "빵도 먹은 만큼 다시 자랄 수 있다면, 더 이상 굶주리는 사람이 없을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바샤"
				}
			]
		},
		{
			"id": 7307103,
			"completionStepIds": [
				7307103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307103",
							"2"
						],
						"stepId": 7307103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바샤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710301,
					"content": "안녕, 바샤. 아직 여기 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710302,
					"content": "#페이몬이랑 {NICKNAME}, 모두 안녕. 응, 난 여기서 잘 지내고 있으니까 걱정하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710303
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710303,
					"content": "진짜 버틸 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710304,
					"content": "아직도 돌아가라고 설득하고 싶어? 난 너희랑 안 갈 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710305
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710305,
					"content": "그래… 네가 싫다면 강요하지 않을게. 그나저나 전에 말했던 「달콤달콤꽃이 가득한 모밭」 기억나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710306,
					"content": "아, 그건 그냥 혼자만의 생각이었어. 그런 곳이 없다는 건 잘 알고 있으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710307
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710307,
					"content": "음… 어른스러운 건 여전하네. 나이랑 너무 안 어울려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710308,
					"content": "아무튼 이번엔 좋은 소식을 전해 주러 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710309,
					"content": "달콤달콤꽃이 가득한 모밭이 정말 있었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710310
					]
				},
				{
					"id": 730710310,
					"content": "맞아! 믿기지 않을 수도 있지만, 전에 널 구해 줬던 「숲의 요정」을 기억해? 걔네들은 아란나라라고 하는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710311,
					"content": "#그 아란나라를 도와서 나랑 {NICKNAME}(이)가 비파랴스를 잔뜩 심었거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710312,
					"content": "그래서 대지가 다시 기억하게 된 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710313
					]
				},
				{
					"id": 730710313,
					"content": "맞아, 아란나쿨라가 그랬어. 바나는 모든 걸 기억하고 있기 때문에, 대지가 다시 기억하게 되면 모밭에 비파랴스가 태어난대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710314,
					"content": "그런 어린애들이나 믿는 이야기라면 예전에 많이 들어 봤어. 그래도 좋은 마음으로 알려 줘서 고마워, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710315
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710315,
					"content": "너도 어린애잖아! 잠깐, 아니야! 이야기가 아니라 전부 사실이라니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710316,
					"content": "응응, 어른들은 항상 그런 식으로 말하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710317
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710317,
					"content": "무슨 말을 해도 안 믿네. 그…그럼 「백문이 불여일견」이지! 함께 가서 직접 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710318,
					"content": "이야기를 위해서 장소까지 준비한 거야? 그렇다면 꼭 가 보고 싶은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710319
					],
					"speakerTitle": "바샤"
				},
				{
					"id": 730710319,
					"content": "으… 내 말은 다 사실이라니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730710320,
					"content": "#{NICKNAME}, 바샤를 아란나라의 모밭으로 데려가자. 직접 눈으로 보면 믿을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7307104,
			"completionStepIds": [
