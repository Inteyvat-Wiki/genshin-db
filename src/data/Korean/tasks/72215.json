			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「네코」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "다 걸었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150302,
					"content": "응, 다 걸었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "야옹, 잘됐다. 이제 신사도 조금 시끌벅적해지겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150305,
					"content": "음? 왜 아직 아무도 안 오는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150306,
					"content": "이렇게 빨리 올 리가 없잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "휴, 인간은 역시 이해하기 어려워. 물론 넌 예외라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150309,
					"content": "아직 사람은 없지만… 쇠구슬을 걸어뒀으니, 고양이 녀석들이 길을 잃을 일은 없겠다, 야옹",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150310,
					"content": "바위 인간이 석상이 조금만 있으면 완성된다고 했으니 꼭 와야 하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150311,
					"content": "아, 맞다, 그리고 이상한 일이 발생했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150312,
					"content": "초록 초록 인간들에게 히비키와 도메키에 관해서 물었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150313,
					"content": "초록 초록 인간들은 히비키가 누구인지 모르고 있더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150314,
					"content": "하지만 키 큰 초록 초록 인간은 「아코 도메키」를 안다고 했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150315,
					"content": "「도적」인가, 「토벌」인가… 그러면서 도메키가 나쁜 사람이라고 했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150316,
					"content": "분명히 잘못 알고 있는 거야. 히비키랑 자주 같이 놀았는데 도메키가 나쁜 사람일 리 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150317,
					"content": "그 인간이 멍청해서 그런 걸 거야, 난 지금 자네 빼고 믿을 사람이 없는 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150318,
					"content": "히비키… 대체 언제 돌아오는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722150307,
					"content": "이렇게 간단할 리가 없잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}