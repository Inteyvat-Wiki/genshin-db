			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"장순"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070101,
					"content": "이걸 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070102
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070102,
					"content": "왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070103
					]
				},
				{
					"id": 223070103,
					"content": "난 예전에 남십자함대의 선원이었어. 근데 재수없게 다쳐버렸지 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070104
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070104,
					"content": "선단에서 나와 생계를 위해 보물지도 몇 장을 박래라는 장사꾼에게 저당잡혔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070105
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070105,
					"content": "정말 보물이 있다면 나와 절반으로 나누기로 했어. 근데 아직까지 소식이 없는 걸 보니, 못 찾은 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070106
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070106,
					"content": "이렇게는 못 기다리겠어. 날 도와 보물을 찾아줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070109,
						223070116
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070107,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070108
					]
				},
				{
					"id": 223070108,
					"content": "그럼 부탁할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070120,
					"content": "일단 <color=#00E1FFFF>박래</color>에게 가서 <color=#00E1FFFF>보물지도</color>를 받아. 그리고 <color=#00E1FFFF>보물을</color> 찾아서 바로 <color=#00E1FFFF>그에게 줘</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070121
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070121,
					"content": "이미 이야기해뒀으니, 그가 내 몫을 맡아둘 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "장순"
				},
				{
					"id": 223070109,
					"content": "그런데 왜 함대에서 나왔어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070110
					]
				},
				{
					"id": 223070110,
					"content": "내 몸은 내가 잘 알아. 언제 고질병이 도질지 모르는 상태였어. 함대에 폐가 될 것 같아서 나왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070111
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070111,
					"content": "그 후에 예전에 모았던 자질구레한 것들로 여기에서 장사를 시작했어. 그런데 장사도 잘 안 되고 물건도 거의 동났네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070112
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070112,
					"content": "보물지도가 몇 장 있었어. 전에 함대에 있을 때 획득한 전리품이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070113
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070113,
					"content": "그런데 걷기도 힘겨운 이 몸으로 탐험을 할 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070114
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070114,
					"content": "난 이 보물지도를 박래라는 자에게 저당잡히고 돈을 받았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070115
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070115,
					"content": "그런데 그도 직접 보물을 찾으러 갈 수 없나봐. 평범한 상인이잖아…. 그러니까 보물 찾기는 네게 밭길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070116
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070116,
					"content": "정말 엄청난 보물이 있을까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070117
					]
				},
				{
					"id": 223070117,
					"content": "하하하, 그렇진 않을 거야. 이 보물지도도 함대에서 나눠준 전리품이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070118
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070118,
					"content": "정말 엄청난 보물이 있다면, 함대 사람들이 벌써 단서를 찾아 보물을 발견했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070119
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223070119,
					"content": "하지만 엄청난 보물이 아니어도 삼등분해도 될 정도로 돈은 될 거야. 그러니까 네게 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "장순"
				}
			]
		},
