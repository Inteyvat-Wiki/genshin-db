					"박래"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070201,
					"content": "이봐, 친구. 뭐가 필요해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070202
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223070202,
					"content": "보물지도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070203
					]
				},
				{
					"id": 223070203,
					"content": "보물지도? 음… 장순이 내게 넘긴 이것들을 말하는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070204
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223070204,
					"content": "흠, 정말 무슨 보물이 있는지 찾으러 가려고? 난 그냥 재미로 가지고 있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070205
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223070205,
					"content": "딱 봐도 넌 진짜 모험가야. 보물이란 말에 눈이 돌아가잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070206
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223070206,
					"content": "어쨌든 난 이 보물지도 필요없으니 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070207
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223070207,
					"content": "하지만 정말로 보물을 찾게되면 똑같이 나눠야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070208
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223070208,
					"content": "여기 오랫동안 맡겨뒀으니 보관료는 지불해야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "박래"
				}
			]
		},
