						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"오렐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "아니야… 이 부분은 논리가 잘못됐어. 다른 각도에서 접근을 해봐야겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240060302,
					"content": "이렇게 하면… 아냐, 역시 틀려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240060303,
					"content": "어라? 잡혀버렸네요. 집합 장소로 갈게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240060304,
					"content": "음… 이 관점이 맞나? 아니야. 윽… 맞나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오렐"
				}
			]
		},
		{
