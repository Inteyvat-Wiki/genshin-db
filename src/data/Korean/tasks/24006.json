			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "오렐 오빠가 생각을 정리할 수 있을지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "로위"
				},
				{
