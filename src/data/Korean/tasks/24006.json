				"objectNames": [
					"베루"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#결국 찾았네. {M#형아}{F#누나}는 역시 대단하다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240060202,
					"content": "그럼 난 집합 장소로 갈게. 형은 좀 더 버텨줬으면 좋겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240060203,
					"content": "왜 형이 좀 더 버텨주길 바라는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "형이 그랬거든. 숨바꼭질을 하고 나면 새로운 생각이 잔뜩 떠오른다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240060205,
					"content": "형은 떠오르는 것들이 너무 많다면서 매번 바닥에 쭈그려 앉아 한참 동안 기록하곤 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240060206,
					"content": "그런 생각들은 엄청 귀중한 거니까, 방해하면 안 된다고 로위가 그랬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240060207,
					"content": "그래서 나랑 로위는 우리 형이 숨을 차례가 되면 형이 생각을 다 정리할 때까지 일부러 시간을 끌고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240060208,
					"content": "대신… 형이 술래가 됐을 때도 한참을 기다려야 한다는 게 문제긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베루"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
