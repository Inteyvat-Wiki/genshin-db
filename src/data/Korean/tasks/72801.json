					"코즈에"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010201,
					"content": "「코모레 찻집」에는 무슨 일로 오셨습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "코즈에"
				},
				{
					"id": 728010202,
					"content": "램지에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "그 상인이요? 찻집에 있는 건 맞아요. 요즘 뭔가 힘든 것 같던데 무슨 일이 있는 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "코즈에"
				},
				{
					"id": 728010204,
					"content": "안쪽으로 들어가시면 찾을 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "코즈에"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
