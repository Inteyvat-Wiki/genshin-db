				},
				{
					"id": 728010502,
					"content": "여기서 출항… 비행한다면 꽤 운치 있겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "램지"
				},
				{
					"id": 728010503,
