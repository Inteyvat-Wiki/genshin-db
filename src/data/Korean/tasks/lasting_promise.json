					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070308,
					"content": "아야카를 방해하지 않으려고 그런 거구나. 뭔가 사연 있는 노트 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070309,
					"content": "근데 아야카의 표정을 보니까… 보물지도 같진 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070310,
					"content": "음, 대체 뭐가 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070311,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070312,
					"content": "후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070313,
					"content": "여행자님, 페이몬 님, 오래 기다리게 해서 죄송해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070314,
					"content": "괜찮아, 이 정도면 엄청 빨리 본 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070315,
					"content": "노트는 다 봤어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "네, 다 봤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070317,
					"content": "이 노트의 진실을 두 분께도 말씀드려야 할 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070318,
					"content": "제가 생각했던 것과는 완전히 다르지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070319,
					"content": "다르다고? 여우 신시(神使)가 남긴 노트가 아닌 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070320,
					"content": "네, 아니에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070321,
					"content": "「츠바키」 씨의 정체는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070322,
					"content": "제 어머니예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070323,
					"content": "뭐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070324,
					"content": "놀라셨죠? 저, 저도 깜짝 놀랐어요…. 하지만 노트 첫머리에 그렇게 적혀 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070325,
					"content": "「츠바키는 평소의 나와 같으면서도 다르다. 츠바키일 때 난 카미사토 카요가 아닌 평범하기 그지없는 여자이다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070326,
					"content": "「이곳에는 평범한 사람으로서 내 소소한 일상을 남기고자 한다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070327,
					"content": "노트에는 대부분 어머니의 소소한 고민들이 적혀 있어요…. 「츠바키」와 관련된 것들도 사실은 어머니의 생각일 뿐이구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070328,
					"content": "그러니까 설계도와 외국 요리는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070329,
					"content": "네, 제 어머니가 시도해보고 싶었던 것들이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070330,
					"content": "이상하게 여기실지 몰라도, 전 어머니의 이런 행동이 충분히 이해돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070331,
					"content": "왜냐면 사실… 사실 저에게도 이런 면이 있거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070332,
					"content": "노트를 보면서 마치 제 생각을 들킨 것 같아서 당황스럽기까지 했죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070333,
					"content": "아야카…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070334,
					"content": "어머니는 아버지에게 시집와서 줄곧 카미사토 가문의 일을 도맡아 하셨어요. 야시로 봉행은 신분이 높아서 관리할 게 무척 많거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070335,
					"content": "또 행동 하나하나가 가문을 대변하고 사람들이 언제나 주시하고 있기 때문에 하고 싶은 일을 하시기엔 시간이 부족했을 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070336,
					"content": "부모님이 돌아가시고 저와 오빠는 카미사토 가문의 모든 걸 이어받았죠. 그동안의 어려움은 외부인이 상상하기조차 힘들 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070337,
					"content": "매번 골치 아픈 일을 겪을 때마다 '어머니도 이렇게 하셨나? 어머니라면 어떻게 하셨을까?'라고 생각하곤 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070338,
					"content": "아마 어머니를 너무 오랫동안 못 봬서 그런 거겠죠. 이젠 그분의 위엄 있고 고아했던 모습만 기억나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070339,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "하지만… 그게 아니었던 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070341,
					"content": "이 노트를 읽으면서 어머니도 저와 같단 걸 느꼈어요. 어떤 직책을 맡고 있든 저희도 그저 평범한 사람일 뿐이란 걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070342,
					"content": "예쁜 옷을 좋아하고, 다양한 음식을 먹고 싶고, 보지 못한 풍경을 보고 싶어 하는 평범한 사람이요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070343,
					"content": "유치하다고 생각하실 수도 있지만… 저도 카미사토 아야카가 아닌 그냥 평범한 소녀로 사는 건 어떨까 하는 생각도 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070344,
					"content": "어머니는 항상 이나즈마 현지의 민간축제에 가보고 싶어하셨다고 노트에 적혀 있었어요. 맑은 날 밤, 집에서 먼 곳을 바라보면 가끔 축제의 불빛이 보인다고 하셨죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070345,
					"content": "저도 본 적 있거든요! 인파 속에서 밝은 초롱 불빛이 밤하늘을 환히 밝히는 모습을요… 가끔은 그곳의 치안이 걱정될 정도라니까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070346,
					"content": "다만, 저희 신분으로 섣불리 축제에 참가했다간 실례가 될지도 모르죠. 특히 저희 부모님 세대 땐, 야시로 봉행과 사람들 사이가 그리 가깝지 않았거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070347,
					"content": "말리는 사람이 없어도 야시로 봉행 사람이 갑자기 나타난다면, 모두 저희가 뭘 하러 온 건지 의아해할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070348,
					"content": "어머니는 모두가 어색해하지 않고 축제의 즐거움과 자유를 즐기길 바란다고 하셨어요…. 사람들을 방해하고 싶지도 않고 그럴 여유도 없으셔서 결국 한 번도 못 가보신 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070349,
					"content": "그랬구나…. 그럼 설계도에 그린 건 어머니가 축제 때 입고 가고 싶었던 옷인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070350,
					"content": "네, 축제에서 가끔 파는 이국적인 음식도 드셔보고 싶었을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070351,
					"content": "외람되지만… 어머니한테 이런 소녀스러운 면이 있는 줄은 몰랐네요, 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070352,
					"content": "외람은 무슨~ 오히려 귀엽고 책임감 강한 엄마구나 싶은걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070353,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070354,
					"content": "어쩌다 보니 제가 어머니 꿈을 이뤄드리곤 있지만, 축제만큼은 저도 가드릴 수가 없네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070355,
					"content": "어머니가 이루시는 걸 볼 기회도 없을 거고요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070356,
					"content": "충분히 잘하고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "네, 그렇죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070359,
					"content": "…감사해요, 여러분! 덕분에 깨달음을 얻은 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070360,
					"content": "저와 어머니는 어떤 면에서 아주 똑같다고 할 수 있죠. 어머니가 겪은 일을 저도 똑같이 겪어야 하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070361,
					"content": "어머니는 실현할 수 없는 것들을 「츠바키」에게 맡기셨죠. 전… 결심했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070362,
					"content": "앗! 설마 너도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070363,
					"content": "아뇨, 전…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070364,
					"content": "전 이런 방법을 쓰진 않을 거예요. 대신… 하루하루를 후회 없이 살아야겠다는 목표가 생겼어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070365,
					"content": "그… 여행자님, 저… 흠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070366,
					"content": "후… 진정, 진정하자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070367,
					"content": "혹시 이곳 축제에 관심 있으신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070368,
					"content": "포스터 봤을 때부터 쭉 가보고 싶었어! 아야카도 관심 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070369,
					"content": "아야카, 너도 축제 안 가봤어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "아아, 비웃지 마세요! 저도 일전엔 걱정이 많았지만… 이제 상관없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070371,
					"content": "원하는 걸 이루기 위해 제 마음의 소리에 귀 기울이기로 했거든요. 여행자님이라면 제가 맘대로 굴어도 절 탓하지 않으실 거고요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070372,
					"content": "저, 저… 여행자님과 함께 축제에 가보고 싶어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070373,
					"content": "물론이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "가자가자! 축제엔 분명 먹을 게 많겠지? 재밌는 것도! 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "페이몬"
				},
				{
