			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "여기가 그 귀인의 거처인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070102,
					"content": "음… 왜 이렇게 으스스하지… 사람 사는 곳 같지 않은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070103,
					"content": "저, 저도 이럴 줄은 몰랐어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070104,
					"content": "이상하네요, 노트에 분명 여기라고 나와 있는데. 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070105,
					"content": "우리가 착각한 걸 수도 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "으… 마음이 좀 흔들리네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070108,
					"content": "하지만 여기까지 온 이상 들어가 보는 게 좋겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070109,
					"content": "응, 맞아. 뭔가 서프라이즈가 있을 수도 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070110,
					"content": "참, 노트엔 어떻게 적혀 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070111,
					"content": "그게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070112,
					"content": "「학은 머리를 장식할 꽃 <color=#00E1FFFF>한</color> 송이를 물어 오고, 흰 토끼는 달빛 <color=#00E1FFFF>네</color> 조각을 치맛자락으로 꿰맸다. 난 단정히 차려입고 <color=#00E1FFFF>동쪽을 향해</color> 츠바키의 이름을 <color=#00E1FFFF>일곱</color> 번 외쳤다. 그러자 어느새 그녀의 집으로 가는 오솔길에 서 있었다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070113,
					"content": "동화 같은 이야기야…. 설마 이렇게 하면 「츠바키」가 아야카네 엄마를 마중 나온 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070114,
					"content": "점점 더 선인 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "아무래도 무슨 암호 같네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070116,
					"content": "좀 더 가보고 판단해야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120070117,
					"content": "응!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120070106,
					"content": "설마 정말 여우 신시(神使)?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
