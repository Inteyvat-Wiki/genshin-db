				"points": [
					{
						"sceneId": 3,
						"position": [
							-2157.813,
							174.161,
							5993.665
						],
						"pointId": 3964
					},
					{
						"sceneId": 3,
						"position": [
							-2156.834,
							174.01,
							5993.106
						],
						"pointId": 3965
					}
				]
			},
			"dialogs": [
				{
					"id": 735120101,
					"content": "오오, 정말 고마워! 넌 정말 용감한 모험가구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120102
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120102,
					"content": "다행히 시간이 많이 지나지 않아서 부품 상태는 양호한 편이야. 약간만 손보면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120103
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120103,
					"content": "비나약이 기계를 만지작거린다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735120104
					]
				},
				{
					"id": 735120104,
					"content": "…비나약?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120105
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120105,
					"content": "어어, 거의 다 됐어! 조금만 기다려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120106
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120106,
					"content": "——비, 나, 약!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120107
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120107,
					"content": "으악! 슈리야? 언제 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120108
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120108,
					"content": "비나약 씨가 부품을 만지고 있을 때요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120109
					]
				},
				{
					"id": 735120109,
					"content": "여기는 마물 때문에 위험하다고 네 입으로 말하지 않았어? 왜 너까지 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120110
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120110,
					"content": "…그냥 부품이 걱정돼서 온 것뿐이야. 계획에 차질이 생기면 언제 아카데미아로 돌아갈 수 있을지 모르니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120111
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120111,
					"content": "하, 그럼 그렇지! 봐, 부품은 전부 찾았어. 돌아가서 조금 더 확인하면 바로 조립할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120112
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120112,
					"content": "말이 나와서 말인데, 이건 무슨 기계의 부품인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735120113,
					"content": "아, 소개하는 걸 깜빡했구나. 이건 「모래 벌레 살충포」야. 우리의 졸업 작품이었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120114
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120114,
					"content": "——왜 그렇게 이상한 주제를 선택한 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735120115,
					"content": "너도 졸업 작품 주제를 선정해보면 이유를 알 수 있을 거야…. 크흠, 아무튼 중요한 건 이게 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120116
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120116,
					"content": "정식으로 소개할게. 내 이름은 슈리야, 아무르타 학부의 졸업생이고, 주전공은 사막생물학과 환경학이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120117
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120117,
					"content": "…여기 있는 이 기계 바보는 크샤흐레와르 학부 출신이야, 응용장치학을 전공했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120118
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120118,
					"content": "——내 이름은 비나약이야. 도와줘서 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120119
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120119,
					"content": "둘이 배우는 게 완전히 다른데… 같이 일을 할 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735120120,
					"content": "말도 마… 졸업 작품 계획서를 통과시키기 위해 이 녀석과 손을 잡은 건 내 학창 시절 최대의 실수였으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120121
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120121,
					"content": "그렇게 말하면 안 되지. 우리 둘 다 무사히 졸업했잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120122
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120122,
					"content": "그래, 졸업! 우리가 동기들보다 몇 년이나 늦었는지 계산해볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120123
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120123,
					"content": "어쨌든 졸업은 했잖아! 듣자 하니 작년에야 겨우 계획서가 통과된 사람도 있다던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120124
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120124,
					"content": "아아… 그만하자! 이런 무의미한 논쟁은 학창 시절에 했던 걸로 이미 충분해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120125
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120125,
					"content": "시작은 맨날 본인이 하면서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120126
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120126,
					"content": "무슨 소리야? 우리가 처음 프로토타입을 만들었을 때도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120127,
						735120128
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120127,
					"content": "그만! 그만하세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				},
				{
					"id": 735120129,
					"content": "음… 사이가 이렇게 안 좋은데 아카데미아는 대체 왜 너희 둘을 보낸 건지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735120130,
					"content": "휴, 사실 아카데미아에서 우릴 보낸 거라고 하기도 좀 그래…. 원래 이 일은 우리 학부의 쿠나르 교수님이 책임져야 할 일이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120160
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120160,
					"content": "그분은 우리 지도 교수님의 지도 교수님인데, 우리가 졸업 작품 심사를 할 때 옆에 계셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120161
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120161,
					"content": "교수님은 아마도 그때 「아카데미아의 젊은 학자들이 무슨 모래 벌레포를 만들었군」이란 인상을 가지신 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120162
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120162,
					"content": "그래서 이번에 「젊은이들이 마음껏 활약할 수 있도록 해야지!」, 뭐 이런 말과 함께 우리를 잡아다 여기로 보내신 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120163
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120163,
					"content": "졸업하고 나서 딱히 만난 적도 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120131
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120131,
					"content": "지도 교수님까지 쿠나르 교수님의 말에 설득되는 바람에… 크흠, 하지만 이건 내가 「모래 벌레 살충포」를 다시 세상 밖으로 드러낼 수 있는 기회야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120132
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120132,
					"content": "——조립만 끝나면 저 벌레 놈들에게 그 위력을 보여줄 수 있을 거라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120133
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120133,
					"content": "또 시작했네, 이 기계 바보 같으니…. 아무튼 내 입장에서 말하자면 난 사막의 생태 균형을 맞추기 위해 모래 벌레가 난동을 부리는 원인을 조사하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120134
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120134,
					"content": "모험가, 솜씨가 굉장한 것 같던데 혹시 우리가 사막에 머무는 동안 당신을 고용할 수 있을까? 우리의 안전을 지켜주는 경호원으로 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120135,
						735120136
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120135,
					"content": "모라만 있으면 뭐든 가능해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120137,
					"content": "걱정 마. 이번 파견 업무에 아카데미아가 다른 지원은 거의 안 해줬어도 경비만큼은 많이 챙겨줬거든. …어떤 사람이 그 대부분을 기계 업그레이드에 써버렸다는 게 문제지만 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120138
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120138,
					"content": "그, 그건 꼭 필요한 일이었다고! …근데 왜 나한테 말할 때만 그렇게 가시가 바짝 돋쳐 있는 거야? 좀 좋게 말해주면 안 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120139
					],
					"speakerTitle": "비나약"
				},
				{
					"id": 735120139,
					"content": "——그럼 네가 좋게 말이 나오게 행동을 해야 할 거 아냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120140
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120140,
					"content": "우와, 또 시작이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120141,
						735120142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735120141,
					"content": "싸우려면 뒤쪽에서 편하게 싸우세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120143,
					"content": "아… 미안. 학창 시절 습관 때문에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120144
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120144,
					"content": "일단 부품을 아루 마을로 가져가서 손봐야 하니까, 조립은 내일이 돼야 시작할 수 있을 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120145
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120145,
					"content": "모래 벌레가 나타났던 곳 근처에 「모래 벌레 살충포」를 설치하는 게 우리 계획이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120146
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120146,
					"content": "그럼 우리가 낸 소음 때문에 다른 마물들이 몰려올 수도 있는데, 그땐 네가 나서줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120147,
						735120148
					],
					"speakerTitle": "슈리야"
				},
				{
					"id": 735120147,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120149,
					"content": "그럼 이제 변론을 계속해도 되겠지? 슈리야, 내가 경비를 쓴 데는 다 그만한 이유가 있다고",
