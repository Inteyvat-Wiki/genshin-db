			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사샤",
					"우부"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "후, 훨씬 보기 좋네. 사샤가 보면 우릴 자랑스러워하겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230102,
					"content": "강도야! 대낮에 강도라니——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230103,
					"content": "뭐?! 강도가 어디 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230104,
					"content": "너희 둘 말이야! 내 걸작을 파괴한 것도 모자라 보물상자를 가져갔잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230105,
					"content": "진짜로 모험가 길드 사람의 짓이었네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "내가 뭘 어쨌는데? 오히려 너네가 뭘 했는지 보라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230109,
					"content": "그러니까 이 못생긴 것들이 너의 「걸작」이라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230110,
					"content": "무례하군, 못생겼다니? 장치 예술이 뭔지 몰라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230111,
					"content": "폰타인의 예술 교육은 아직 갈 길이 멀었군…. 근데 뭐야, 너흰 폰타인 사람이 아닌 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230112,
					"content": "#응, 우린 폰타인 사람 아니야. 얘는 {NICKNAME}, 난 페이몬이지. 너와 마찬가지로 모험가 길드 사람이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230113,
					"content": "흑흑, 사악한 조직의 일원이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "맞아, 하지만 유니폼은 필수가 아니라 사악한 초록 옷은 아니지. 참으로 다행이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230117,
					"content": "난 모험가이자 설치 예술가인 우부야. 너희가 헛소리를 하는 걸 보니 평소에도 미친 짓을 하고 다녔을 것 같네… 이번만은 봐줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230118,
					"content": "응? 사실은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230119,
					"content": "뭐? 난 작품 복원해야 하니까 감사 인사하고 싶으면 빨리해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230120,
					"content": "감사 인사는 무슨, 대신 불만은 잔뜩 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "사샤"
				},
				{
					"id": 740230121,
					"content": "사샤!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230122,
					"content": "내가 왔으니 페이몬 동생은 이제 안심해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "사샤"
				},
				{
					"id": 740230123,
					"content": "사악한 초록 옷 씨, 당신이 설치한 함정은 우리가 다 없애버렸거든! 그러니까 사악한 함정으로 아름다운 폰타인을 파괴하려는 생각은 얼른 그만둬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "사샤"
				},
				{
					"id": 740230124,
					"content": "무슨 음모? 잠깐, 다 없애버리다니… 너희들 내 예술작품을 다 파괴한 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230125,
					"content": "어, 없앤 게 아니라 주위 경치에 어울리게 위치를 재배치한 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230126,
					"content": "너, 너희 같은 꼬마들이 예술을 알아? 내 설치 예술, 내 작품이… 평범하게 변하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230127,
					"content": "그런데 그거 정말 예술 맞아? 내가 예술은 잘 모르지만 딱 봐도 이상한 게 예술이라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230128,
					"content": "당연하지, 예술의 경계는 예술가가 정하는 거야. 예술가가 창작한 작품은 당연히 예술 작품이라 불리지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230129,
					"content": "누가 예술가인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "사샤"
				},
				{
					"id": 740230130,
					"content": "당연히 나지. 위대한 장치 예술가, 우부",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230131,
					"content": "사악한 조직을 쓰러트리고 폰타인의 미래를 수호하는 예술가 연맹 창립자로서 말할게, 그건 예술이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "사샤"
				},
				{
					"id": 740230132,
					"content": "뭘… 쓰러트린다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230133,
					"content": "사악한 조직이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "보통은 그… 장치 예술이었던가? 그걸로 풍경을 파괴하는 모험가 길드를 지칭해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230136,
					"content": "농담하지 마, 그런 연맹은 들어본 적도 없어. 꼬마 아가씨, 대체 무슨 자격으로 내 작품이 예술이 아니라는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230137,
					"content": "난 화가야, 예술가인 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "사샤"
				},
				{
					"id": 740230138,
					"content": "응? 꼬마 아가씨, 예술가는 소꿉장난이 아니야. 네가 하고 싶다고 되는 게 아니라고. 작품도 있어야 하고 다른 사람의 인정도 받아야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230139,
					"content": "그럼 사악한 초록 옷에겐 무슨 자격이 있는데? 초록 옷 씨의 작품, 그러니까 설치 예술이란 게… 사악한 함정들을 말하는 거야? 그 작품들을 인정하고 박수 쳐준 사람이 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "사샤"
				},
				{
					"id": 740230140,
					"content": "내 작품의 매력을 알아보지 못하는 평범한 사람들이 너무 많아서 그래. 천재는 외로운 법이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230141,
					"content": "모두가 이해할 수 있는 예술부터 시작하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "맞아. 만약 알아주는 사람이 없다면 너무 앞서갔다고 해야 하나, 아니면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230145,
					"content": "무슨… 아니거든? 내 작품은 완벽해. 문제가 있을 리 없잖아. 단지 너희가 모르고, 다른 사람들도 그 가치를 모를 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230146,
					"content": "젠장, 난 포기하지 않아. 두고 보자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "우부"
				},
				{
					"id": 740230147,
					"content": "우부가 비틀거리며 떠난다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "고집이 센 적이네. 하지만 나도 쉽게 포기하지 않을 거야. 폰타인 예술의 미래는 나에게 달려 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "사샤"
				},
				{
					"id": 740230149,
					"content": "다들 목표가 있네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "잘된 건가? 잘된 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230143,
					"content": "알아볼 사람이 아예 없는 거죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "그렇게 말하니 실패작 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230135,
					"content": "현재로선 그 쓰러트릴 대상이 당신 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "안녕하세요, 동료여",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "이름도 모르는데 동료라고 할 수 있나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740230107,
					"content": "맙소사, 사악한 초록 옷이잖아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "아이고, 헛소리를 하는 강도라니. 오늘 무슨 날인가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "우부"
				}
			]
		},
