			"dialogs": [
				{
					"id": 761480101,
					"content": "으악! 방금 어디 갔던 거야? 깜짝 놀랐잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761480102,
					"content": "내가 네 이름을 얼마나 불렀는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761480103,
					"content": "응? 어째서 페이몬은 무념무상의 공간으로 끌려가지 않은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480104,
					"content": "어쩌면, 먹고 자는 것 외에는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "아무 생각도 없어서 그런 게 아닐까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "흠, 일리가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480107,
					"content": "아무래도 멜란타가 화난 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480108,
					"content": "#{NICKNAME}, 최대한 빨리 널 멜란타와 대면하게 해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480109,
					"content": "일단 장소를 옮기자. 여기는 안전하지 않으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480110,
					"content": "음, 아무도 신경 쓰지 않는 것 같지만… 다들 안녕? 내 이름은 알라라야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알라라"
				}
			]
		},
