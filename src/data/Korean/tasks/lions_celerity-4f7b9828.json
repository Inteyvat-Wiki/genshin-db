				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "또 여기로 돌아왔네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480702,
					"content": "사람의 수명으로 따지자면, 지난번에 여기 왔던 건 전전전전전전…생 때의 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480703,
					"content": "아무래도 우린 무념무상의 공간에 빠진 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480704,
					"content": "그래서, 어떻게 빠져나가야 하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "명상으로 마음과 생각을 다스리고, 모든 갈망을 버리면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480706,
					"content": "아무 생각도 하지 않는 무념무상의 상태를 유지하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480707,
					"content": "간단해 보이지? 하지만 개인의 자질과 갈망에 따라, 그걸 해내는 데 몇 년이 걸릴 수도 있고 몇백 년이 걸릴 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480708,
					"content": "하지만 너처럼 세계의 운명을 짊어진 사람이라면… 갈망을 떨쳐낼 수 없겠지. 그래서도 안 되고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480709,
					"content": "그럼 어쩌죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "일단 차이틀린트부터 찾은 다음에 생각하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "오른쪽이"
				},
				{
					"id": 761480712,
					"content": "뭘 주워 온 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "잠깐, 오른쪽이도 같이 끌려 들어온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480714,
					"content": "그렇다면 아직 기회가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761480715,
					"content": "오른쪽이도 파수꾼이니까, 이 조각에 담긴 힘을 사용해 강제로 출구를 열 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "이스토리아"
				},
				{
