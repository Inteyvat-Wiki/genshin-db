					{
						"sceneId": 6,
						"position": [
							1006.518,
							1015.976,
							880.314
						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "이곳 환경이 이렇게 특별할 줄이야…. 그렇다면 푸르시나 볼트의 에너지 시스템으로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010202,
					"content": "#음? {NICKNAME}, 페이몬, 정말 오랜만이야. 층암거연에는 웬일로?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010203,
					"content": "그러고 보니 헤디브에게서 네 소식을 들었었어. 층암거연에서 탐사대를 많이 도와줬다며?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010204,
					"content": "하지만 지금의 층암거연 환경은 전보다 훨씬 열악하고 위험해졌어. 가볍게 산책할 수 있는 곳이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010205,
					"content": "당신은?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "얼마 전에 만났었잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010207,
					"content": "내가 만날 때마다 귀찮은 일을 부탁했다고 해도 일부러 모르는 척 하면 많이 섭섭하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010208,
					"content": "됐어. 그럼 다시 한번 소개하지. 나는 수메르 아카데미아 학자 호세이니야. 이전에 전도 원판의 연구를 위해 이나즈마에서 현지 조사까지 했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010209,
					"content": "지금은 연구비가 다 떨어져서 어쩔 수 없이 수메르에 돌아가야 하는 신세가 되었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010210,
					"content": "오, 어렴풋이 기억나는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715010211,
					"content": "기억났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010212,
					"content": "어, 그 원판 인간!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715010213,
					"content": "… 분명히 말하건대 난 무슨 원판 인간이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010214,
					"content": "아무튼, 수메르로 돌아가는 길에 같은 아카데미아 학자인 헤디브의 부탁을 받았어. 예전에 연구 경비 문제때문에 헤디브의 도움을 좀 받았거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010215,
					"content": "그래서 이번엔 내가 층암거연에 와서 그를 도와주려 한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010216,
					"content": "이 정도면 충분히 설명한 거 같고… 근데 너희는 지금 왜 층암거연에 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010217,
					"content": "헤디브의 의뢰를 받고 왔어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "오오…! 너희였구나. 헤디브가 도움을 요청할 사람을 찾는다고 했을 때 어떤 사람이 올지 걱정이 됐었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010220,
					"content": "너희들이라면 안심이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010221,
					"content": "이번 층암거연의 검은 진흙 분출 사건은 나 홀로 처리하려면 꽤 힘들 것 같았어. 너희의 도움이 있으면 해결 확률이 쪼금 더 높아질 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010222,
					"content": "뭘 도와주면 되나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "「푸르시나 볼트」라고 들어봤어? 지맥의 힘을 교란시키는 힘을 방출하는 장치야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010224,
					"content": "내 추측이 맞는다면… 검은 진흙이 분출되는 곳에 「푸르시나 볼트」를 설치해 지맥의 움직임을 교란시키면 검은 진흙을 처리할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010225,
					"content": "그런데 검은 진흙과 지맥은 무슨 관련이 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715010226,
					"content": "검은 진흙은 지맥의 변동에 따라 이곳에 나타났기에 높은 확률로 지맥과 관련이 있을 거야…. 이건 나와 헤디브가 토론하여 얻어낸 결과야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010227
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010227,
					"content": "그래서 볼트를 이용해 지맥을 교란하거나 이곳 지맥이 외부로 통하는 출구를 폐쇄하면 검은 진흙의 분출을 멈출 수 있다는 판단이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010228
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010228,
					"content": "그렇군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010229
					]
				},
				{
					"id": 715010229,
					"content": "다만 이전에는 「푸르시나 볼트」로 지맥을 교란시키는 정도였다면 이번에는 「완전히 폐쇄」하려 해. 처음 해보는 시도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010230
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010230,
					"content": "내가 이미 약간의 계산을 거쳐 볼트의 일부 파라미터를 조정해놓았어. 이론상으로는 문제가 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010231
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010231,
					"content": "하지만 이론은 결국 이론인 거고, 실제 실험을 통한 검증이 필요하거든. 그래서 아까 시험 가동을 하려 했는데 실험에는 리스크가 동반되니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010232
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010232,
					"content": "제가 해 볼게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010233
					]
				},
				{
					"id": 715010233,
					"content": "음… 그럼 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010234
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010234,
					"content": "나도 옆에서 관찰할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715010218,
					"content": "도와주러 왔어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				}
			]
		}
	]
