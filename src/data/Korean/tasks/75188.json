			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"파카린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "세 녀석이 다 돌아왔네. 고마워, 다 네 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880402,
					"content": "지나가던 용사 친구, 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880403,
					"content": "아직도 등이 뻐근하긴 하지만, 꼬마 용들이 옆에 있어 줘서 그런지 한결 나아진 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880404,
					"content": "내가 부자는 아니지만 그래도 약간의 보수는 줄 수 있지. 자, 이걸 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "파카린"
				}
			]
		}
	]
}