				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "부탁 좀 할게. 밭에 가서 우리 집 <color=#00E1FFFF>어린 용 세 마리를</color> 이리로 데려와 줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "파카린"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"파카린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "어이! 그래, 맞아, 너!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880202,
					"content": "걷는 것도 그렇고 달리기도 빠른 걸 보니… 운동을 꾸준히 하는 사람같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880203,
					"content": "우리 「비옥한 터전」의 용사인가? 아니면 다른 부족에서 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880204,
					"content": "그냥 지나가던 모험가예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "그렇구나, 아쉬운걸. 휴, 하긴 일손이 부족할 때 갑자기 도와줄 사람이 나타나는 건 꿈에서나 있을 법한 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880207,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "그러니까, 보다시피 여긴 내 농장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880209,
					"content": "지금까진 나 혼자 이 농장을 관리해 왔는데, 최근에는 그럴 수가 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880210,
					"content": "며칠 전에 부족의 용사들과 겨루기를 하다가 등을 다쳤거든…. 그래, 바보 같은 짓인 거 알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880211,
					"content": "결국 지금은 아버지를 도와서 새로 밭을 일굴 수도, 내 농장을 관리할 수도 없게 됐어. 솔직히 말하자면 걷는 것도 힘든 지경이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880212,
					"content": "그래서 며칠간 도와줄 사람을 찾고 있었는데 때마침 네가 나타난 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880213,
					"content": "그냥 지나가는 길이라니… 아쉽지만 어쩔 수 없지. 농사를 지으려면 매일 밭에 와야 하거든. 오다 말다 하면 밭은 금방 못쓰게 되어 버려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880214,
					"content": "하지만 지금은 먼 곳에 있는 부족까지 가서 사람을 구할 힘도 없어. 휴, 내가 키우는 어린 뿔룡 몇 마리 말고는 도움을 청할 곳도 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880215,
					"content": "그런데 요 며칠간은 말썽꾸러기 녀석들도 말을 안 들어. 세 마리 다 밭에서 빈둥대기만 하고 나한테 오라고 해도 절대 안 온다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880216,
					"content": "그래서 말인데 부탁 하나 해도 될까? 나 대신 녀석들을 데리고 와줄 수 있어? 정말 걷기가 힘들어서 그래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880217,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "다행이다. 평소에는 말도 잘 듣고 밭일할 때도 같이 있어 주더니 요 며칠은 왜 그러는지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880219,
					"content": "가서 인사하면 우리 집 꼬마 녀석 세 마리가 알아서 돌아올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "파카린"
				},
				{
					"id": 751880205,
					"content": "전 나타 사람이 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
