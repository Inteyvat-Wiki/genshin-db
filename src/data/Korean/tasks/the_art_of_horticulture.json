			"dialogs": [
				{
					"id": 721830101,
					"content": "이게… 씨앗이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721830102,
					"content": "이건 「울림풀」의 씨앗이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830103,
					"content": "이 식물에 대해서 잘 알아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "음, 조금은 알죠. 옛날에 이 식물을 본 적이 있어요. 그리고 씨앗의 기이한 점도 들은 적이 있고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830105,
					"content": "제 기억에 의하면… 이 식물은 바람이 없어도 뇌명의 소리를 따라 은은하게 떨었어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830106,
					"content": "꽃이 피면 이쁜가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "생긴 것만 보면… 이쁘다고 할 수 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830108,
					"content": "「울림풀」을 심고 싶으세요? 적당한 땅이 없을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830109,
					"content": "제 땅에 심으면 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "그, 그래요? 역시 여행자는 다르네요… 벌써 영지도 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830111,
					"content": "실례가 안 된다면, 그 영지는 어디…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830112,
					"content": "이나즈마 내에 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "아! 당신의 몬드와 리월에서의 활약은 소문으로 들어 익히 잘 알고 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830114,
					"content": "그런 쾌거를 이루었으니 영지를 얻는 건 당연하죠, 대단하세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830120,
					"content": "야, 네가 말하는 「땅」이 설마 할머니가 준 「속세의 주전자」는 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721830121,
					"content": "그 안에 진짜 그런 물건이 있어? 할머니가 말한 적 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721830122,
					"content": "돌아가서 물어보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "좋아, 할머니한테 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721830124,
					"content": "선인은 대단해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "그, 그래? 할머니가 대단하긴 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721830126,
					"content": "좋아, 할머니한테 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721830115,
					"content": "주전자 안에 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "주… 전자? 장난이 지나치시군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830117,
					"content": "당신의 몬드와 리월에서의 활약은 소문으로 들어 익히 잘 알고 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830118,
					"content": "그럼 영지는 리월 아니면 몬드에 있겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "마다라메 하쿠베에"
				},
				{
					"id": 721830119,
					"content": "와, 정말 대단해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "마다라메 하쿠베에"
				}
			]
		},
