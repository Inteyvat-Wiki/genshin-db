				"points": []
			},
			"dialogs": [
				{
					"id": 200680301,
					"content": "…어서 먹어, 다 먹고 빨리 가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680302,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "또 너야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680308,
					"content": "도대체 뭐하러 온 거야? 또 오리랑 비둘기를 다치게 하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680309,
					"content": "이 감자전 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "감자전? 어라, 이 감자전 만드는 법은 어떻게 알았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680312,
					"content": "알겠다. 그레이스 엄마를 찾아 간 거지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680313,
					"content": "흥, 이걸로 내가 용서해 줄 줄 아나 본데, 꿈 깨! 네가 비둘기랑 오리한테 한 짓을 누구보다도 잘 알고 있으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680314,
					"content": "…하지만, 엄마가 이 감자전을 보낸 건 내가 더는 소란 피우지 않았으면 하는 마음일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680315,
					"content": "엄마는 노라랑 글로리 누나도 돌봐야 하는데 나까지 폐를 끼치면 철이 없는 거라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680316,
					"content": "미리 말해두지만, 난 너를 용서한 게 아니야! 그냥 더는 엄마를 귀찮게 하고 싶지 않을 뿐이야, 알았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680317,
					"content": "흥, 하지만… 넌 나 같은 어린애가 한 말쯤은 금방 잊어버리겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680318,
					"content": "우리 아빠가 돌아오면, 네가 무슨 짓을 했는지 다 이를 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티미"
				},
				{
					"id": 200680310,
					"content": "이 감자전을 받아줘!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "티미, 저기…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "또 너야? 대체 언제까지 이럴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200680304,
					"content": "무, 무슨 일 있니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "몰라서 물어!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "티미"
				}
			]
		},
