					"그레이스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "휴, 이걸 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680102,
					"content": "음, 무슨 일 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "마침 잘 왔어. 네가 오리한테 무슨 짓을 했는지 티미한테 다 들었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680104,
					"content": "너도 참… 휴, 네 사연을 모르는 것도 아니라 어떻게 말해야 할지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680105,
					"content": "네 용기와 힘을… 어떻게 그런 일에 쓸 수가 있니…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680106,
					"content": "너무 배고파서 그만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "음… 배가 고프면 제대로 일해서 돈을 벌면 되잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680110,
					"content": "네 실력이라면 모험가 길드에서도 상위권 안에 들겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680113,
					"content": "에휴, 이미 일어난 일을 말해서 뭐 하겠니. 티미는 요새 그 일 때문에 계속 우울해하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680114,
					"content": "예전에 티미의… 아버지에게 배워놓은 레시피가 있어. 「바람버섯」이 들어간 「몬드 감자전」인데, 티미가 가장 좋아하는 음식이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680115,
					"content": "「바람버섯」 세 개만 구해 줄래? 티미가 이걸 먹으면 기분이 좀 나아질 거야…. 그럼 너도 그에게 사과할 수 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680116,
					"content": "제게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "그럼 빨리 좀 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680120,
					"content": "바람버섯이라면… 성 남쪽에 있는 집들의 지붕 밑에서 구할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680121,
					"content": "빨리 좀 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680117,
					"content": "버섯이라면 얼마든지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "세 개면 충분해. 많이 가져와서 티미가 화날 때마다 꺼내 쓰기라도 하게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680107,
					"content": "그냥 실수로…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "실수로 비둘기와 오리를 잡았다고? 그럼 네가 만났던 강적들도 「실수」로 처치한 거겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680108,
					"content": "원래 힘은 이렇게 평소에 쌓아두는 거죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "너… 너 진짜… 됐어, 네 실력만큼은 확실히 인정할게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "그레이스"
				}
			]
		},
