			"dialogs": [
				{
					"id": 200680401,
					"content": "고마워, 이거면 충분해. 잠깐만 기다려줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680402,
					"content": "자, 이 「몬드 감자전」을 티미에게 갖다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680403,
					"content": "앞으론 이런… 나쁜 짓은 하지 말아줘. 득보다 실이 더 많잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680404,
					"content": "내 조언을 잘 기억해둬. 다음에 또 나와 티미를 실망시키지 말고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200680405,
					"content": "하지만… 에휴, 모든 사람이 내 조언을 기억하고 있더라면 빅토리아 수녀님도 지금처럼 바쁘시지 않겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				}
			]
		},
