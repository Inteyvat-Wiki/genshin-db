			"dialogs": [
				{
					"id": 760650101,
					"content": "왔구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650102,
					"content": "콜롬비나가 여기에 있을 줄이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "응, 네가 왔으니까 이제 우리는 함께 여기 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650104,
					"content": "내가 올 줄 알고 있었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "언제 올지는 몰랐지만, 결국 와줄 거라고 믿었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650106,
					"content": "마치 달과 티바트 사이에 서로를 끌어당기는 인력이 있는 것처럼, 넌 언제나 나를 찾아내잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650107,
					"content": "자, 같이 앉자. 네 자리는 비워뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650108,
					"content": "지난번엔 네 우주선에서 티바트를 함께 봤잖아. 이번엔 별하늘을 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650109,
					"content": "닌키와 학자들이 이 별하늘에 이끌린 이유를 알 것 같아. 그곳의 특별한 인력이 내게도 느껴지거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650110,
					"content": "닌키와 메시지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "걱정 마, 위험한 일은 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650112,
					"content": "닌키는 무사해. 내가 호송에 쓴 힘조차 느껴지지 않을 만큼 먼 곳으로 갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650113,
					"content": "하지만 궁금한 게 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650114,
					"content": "뭐가 궁금한데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "음, 아주 많아. 예를 들면, 다른 사람들도 달바라기의 메시지를 받을 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650116,
					"content": "그 메시지를 받은 사람, 혹은 다른 존재는… 누구일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650117,
					"content": "그들은 어떤 생각을 품고 있을까? 우리처럼 사랑하고, 또 증오할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650118,
					"content": "우리처럼 심연에 둘러싸여 있어도, 저 아름답고 신비로운 별하늘에 이끌릴까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650119,
					"content": "또 우리처럼 낯선 자에게 다가가 손을 흔들며 「만나서 반가워」라고 인사하고 싶어 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650120,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650121,
					"content": "과연 별하늘의 깊은 곳엔 아직 어둠에 삼켜지지 않은 문명이 남아 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650122,
					"content": "있을 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650124,
					"content": "예전에 우리 우주선이 어떤 메시지를 받았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "무슨 메시지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650126,
					"content": "유효한 내용은 거의 다 유실됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "하지만 지적 문명의 메시지임은 분명해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "너무 먼 길을 지나와서 그렇게 된 걸까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650129,
					"content": "그래도 충분히 기뻐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650130,
					"content": "#참, {NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650131,
					"content": "응?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "네 고향도 저 별하늘 깊은 곳에 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650133,
					"content": "언젠가 네 여정의 출발점을 청소하고 싶어진다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650134,
					"content": "기꺼이 거들어 줄게, 네가 달 청소를 도와줬던 것처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650135,
					"content": "그럼 잊지 않고 널 초대할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "파티를 또 여는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650137,
					"content": "파티를 한 번 더 열자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650139,
					"content": "그 파티를 「귀환의 밤」이라고 부르는 건 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650140,
					"content": "낮일지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "그럼 낮부터 밤까지 놀자. 친구도 다 부르고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "콜롬비나"
				},
				{
					"id": 760650142,
					"content": "정말 재밌겠는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "날씨도 좋고 친구도 모두 모인 날에, 그 밤이 찾아왔으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "콜롬비나"
				}
			]
		}
	]
}