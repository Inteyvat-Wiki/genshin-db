				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "와! 고기 상태가 정말 좋네… 정말 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140402,
					"content": "고기를 요리해서 먹으면, 조각 속도가 좀 더 빨라질 수 있을 거 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140403,
					"content": "그게 무슨 관계가 있는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "좋은 고기를 먹으면 힘이 나잖아! 옛날엔 생선만 먹어서 힘이 안 났는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140405,
					"content": "안 그래도 계속 이대로 가면 작업 기간이 길어질까 봐 걱정했는데… 덕분에 고기를 먹고 힘을 낼 수 있게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140406,
					"content": "어쨌든 사람… 음, 고양이 의뢰를 받고 하는 일이니 작업 기간은 될 수 있으면 연장하고 싶지 않아서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140407,
					"content": "아무튼 최대한 빨리 조각상을 완성하도록 할게. 조각상이 완성되면 좋은 일이 있을 거라고 대리 궁사님이 그러던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140408,
					"content": "무슨 좋은 일인지는 모르겠지만… 헤헤, 조금 기대는 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140409,
					"content": "작품이 완성되면 꼭 보러 와야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오오시마 준페이"
				}
			]
		}
	]
