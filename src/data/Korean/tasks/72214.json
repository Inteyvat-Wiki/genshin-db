			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "정말… 믿기지 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140102,
					"content": "조각상을 다 만들었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "처음에는 전혀 나를 안 닮았었는데 가면 갈수록 날 닮은 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140104,
					"content": "인간은 정말 대단하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140105,
					"content": "시끄럽긴 하지만, 난 대리 궁사니 이런 사소한 일은 신경 쓰지 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140106,
					"content": "나 대신 이 생선을 키 큰 인간에게 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140107,
					"content": "이건 좋은 물건이니, 저번에 원하던…「복수」로 충분할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140108,
					"content": "생선밖에 없어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "음냥, 「콘부마루」에게 아기들을 데리고 참새를 잡아 오라고 했는데, 많이 못 잡았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140110,
					"content": "어린애들은 생선을 잡는 게 더 쉽거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140111,
					"content": "「보수」겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "야옹야옹, 정말 귀찮군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722140113,
					"content": "어서 전해줘, 이건 좋은 물건이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
