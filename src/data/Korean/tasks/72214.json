			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"오오시마 준페이"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "드디어 모양이 잡혀가는군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140202,
					"content": "하하, 왔어. 어서 조각상 한번 봐. 대리 궁사님을 좀 닮은 것 같아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140203,
					"content": "어느 정도 모양이 잡혀가네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "그렇지? 하하하, 며칠 동안 열심히 밤새워서 작업한 보람이 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140207,
					"content": "으윽, 배가 고파서… 먹을 걸 좀 구해와야겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140208,
					"content": "이건 네코가 준 생선이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "오… 와, 대리 궁사님의 마음은 고맙지만… 다른 걸 좀 먹고 싶어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140210,
					"content": "며칠 동안 생선만 먹었더니, 더 이상 못 먹겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140211,
					"content": "매일 직접 먹을 걸 찾아다니는데 운이 좋으면 참새나 비둘기를 잡는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140212,
					"content": "휴, 짐승고기를 좀 먹고 싶어, 쫄깃쫄깃하고 육즙이 많은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140213,
					"content": "음… 여행자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140214,
					"content": "괜찮다면… 짐승고기 3개만 구해줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140215,
					"content": "난 사냥에는 정말 소질이 없어서, 며칠 동안 짐승고기는 구경도 못 했어… 그러니까 부탁 좀 해도 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140216,
					"content": "알겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "그럼 짐승고기 3개만 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140217,
					"content": "나루카미섬에 가서 먹고 오면 되는 거 아닌가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "첫째론 너무 멀고, 두 번째는… 나루카미섬에 가면 조각할 때의 흐름이 끊겨서… 돌아오면 원래 있던 그 느낌이 사라질 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140219,
					"content": "그냥 여기서 간단하게 먹고 조각을 계속하는 게 낫지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722140205,
					"content": "조각이 네코보다 많이 크네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "당연하지, 대리 궁사님이 일반 고양이보다 많이 크지만… 원래 크기보다 좀 더 크게 해야 기백을 느낄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "오오시마 준페이"
				}
			]
		},
