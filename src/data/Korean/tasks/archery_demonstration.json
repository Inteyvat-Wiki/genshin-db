			},
			"dialogs": [
				{
					"id": 220470101,
					"content": "또 빗나갔네… 도대체 뭐가 문제인 건지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470102,
					"content": "아직 활 쏘는 연습 하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "너는 지난번의… 저번에 시범을 보여줘서 고마웠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470104,
					"content": "네 덕에, 벌써…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470105,
					"content": "백발백중인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "아, 그 정도까지는 아니고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470108,
					"content": "하지만, 10발 중의 5발은 과녁에 맞힐 수 있게 됐어… 모든 게 네가 시범을 보여준 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470109,
					"content": "교관님의 요구와는 아직도 거리가 좀 있지만, 계속해서 노력할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470110,
					"content": "맞다, 여기까지 온 김에, 다시 한번 시범을 보여주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470111,
					"content": "그럼 더욱 빠르게 발전할 수 있을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470112,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "고마워, 열심히 배울게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470120,
					"content": "시범을 부탁해. 열심히 배워볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470114,
					"content": "저번의 문제점들은 다 고쳤나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "그러니까… 자세가 올바르지 않고, 힘이 충분하지 않고, 활을 잡은 손이 안정적이지 않다는… 문제들 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470116,
					"content": "솔직히 말하자면, 아직도 조금씩 고쳐가는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470117,
					"content": "다만 이런 문제들 외에, 내가 더 걱정되는 건… 전장에 나갔을 때, 내가 배운 이 기술들을 발휘할 수 있을지가 걱정이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470118,
					"content": "큼, 이런 문제들 때문에 고민하기 전에, 일단 내 무예부터 갈고닦아야 하겠지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470119,
					"content": "시범을 부탁해. 열심히 배워볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470106,
					"content": "백 보 밖에서도 명중이 가능하다거나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
		},
