			"dialogs": [
				{
					"id": 220470301,
					"content": "왜 그래? 방금 활을 쏠 때, 살짝 실수가 있던 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470302
					],
					"speakerTitle": "쇼우지"
				},
				{
					"id": 220470302,
					"content": "과녁을 다시 배치해줄 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470303
					]
				},
				{
					"id": 220470303,
					"content": "알겠어, 지금 가서 과녁을 배치할게. 조금 뒤에 돌아와 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼우지"
