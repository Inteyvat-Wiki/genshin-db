			"dialogs": [
				{
					"id": 150250101,
					"content": "두 분이 장로님이 선택한 분들인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "토르테크"
				},
				{
					"id": 150250102,
					"content": "넌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150250103,
					"content": "족장님의 파견으로 두 분의 안내를 맡게 된 길잡이 토르테크입니다. 상황은 족장님의 전령에게 전해 들었으니, 따라오시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "토르테크"
				}
			]
		},
		{
