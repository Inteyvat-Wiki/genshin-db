				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "고, 고마워, 후… 이 자식들 방심한 틈을 타 공격을 하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620102,
					"content": "누구시죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "난 후지와라 토시코라고 해, 이곳에서… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620105,
					"content": "아니지, 날 구해줬으니… 사실대로 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620106,
					"content": "사실 난 선조께서 남겨주신 보물을 찾고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620107,
					"content": "보, 보물!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721620108,
					"content": "찾았어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "하하, 물론이지. 난 단서를 쫓아 보물을 숨겨둔 곳을 찾았고 들어가는 방법도 찾아냈지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620110,
					"content": "하지만… 장치를 작동하고 보물이 묻힌 곳에 들어가려는 순간 마물들의 습격을 받았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620111,
					"content": "다행히 마물을 무찔러준 덕분에 무사할 수 있었어. 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620112,
					"content": "그리고… 그게, 미안하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620113,
					"content": "날 계속 보호해줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620114,
					"content": "계속 보물을 찾아야 하는데 주위에 마물들이 너무 많아서, 나 혼자 처리하기는 무리일 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620115,
					"content": "도와주면… 보물을 좀 나누어줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620116,
					"content": "진짜 보물이 있는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "무조건 찾을 수 있어! 믿어줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620119,
					"content": "보물이 묻힌 곳에 들어가는 장치까지 다 찾아놨어. 저기 확인해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620120,
					"content": "근데 그 장치는 일반적인 방법으로는 열리지 않고 특수한 방법으로 열어야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620121,
					"content": "선조가 남긴 지도가 있어. 그 안에 이 장치를 풀 수 있는 단서가 있는 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620122,
					"content": "하지만… 하하하… 난 여는 방법을 아직 잘 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620123,
					"content": "아, 한번 봐봐, 혹시 뭐라도 알아낼 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "후지와라 토시코"
				},
				{
					"id": 721620124,
					"content": "휴, 이 장치는 도대체 어떻게 푸는 거야…",
