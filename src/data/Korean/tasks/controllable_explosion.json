	"talks": [
		{
			"id": 7365201,
			"completionStepIds": [
				7365201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365201",
							"2"
						],
						"stepId": 7365201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하자나드",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736520101,
					"content": "드디어 돌아온 거야? 오래 기다렸어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520102
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520102,
					"content": "자, 「재용해 약제」의 효과에 대해 자세히 알려줘 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520103
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520103,
					"content": "하자나드, 아주 신났네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520104
					]
				},
				{
					"id": 736520104,
					"content": "그럼 단점부터 얘기할게. 마음의 준비해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520105,
					"content": "하자나드에게 「재용해 약제」의 단점과 장점을 자세히 설명한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520106
					]
				},
				{
					"id": 736520106,
					"content": "그렇구나… 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520107
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520107,
					"content": "지금 혼합하는 포션의 양을 정밀하게 조절할 수 없어서 폭발 효과가 불안정한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520108
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520108,
					"content": "소형 폭약에 커버를 씌워서 충격파를 줄이고, 미리 배치한 약제의 배열을 최적화할 필요가 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520109
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520109,
					"content": "음, 개선 작업은 오래 걸리지 않겠지만 자금이 문젠데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520110
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520110,
					"content": "비상용 예산을 남겨두길 잘했어. 앞으로 매일 한 끼만 먹고 낡은 장비를 팔면 충분할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520111
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520111,
					"content": "매일 한 끼만 먹는다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520112,
					"content": "안 돼, 그건 못 참지! 자금이 부족하다고 왜 진작 말하지 않았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520113,
					"content": "아, 걱정하지 마. 약속한 보수는 절대 한 푼도 빠뜨리지 않을 거야. 이 예산은 미리 계획된 부분이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520114
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520114,
					"content": "난 원래 자주 한 끼만 먹어. 가끔은 일주일에 세 끼만 먹기도 하고, 이미 적응돼서 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520115
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520115,
					"content": "너무 애쓰지 마요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520116
					]
				},
				{
					"id": 736520116,
					"content": "그래도 마음에 걸려서 확실히 물어봐야겠어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520117,
					"content": "하자나드, 왜 그렇게 유명한 학자가 되고 싶은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520118,
					"content": "학술 연구가 정말 좋아서? 아님 자신의 재능을 증명하고 싶어서? 그것도 아니면 연금술로 모라를 많이 벌 수 있어서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520119,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520120
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520120,
					"content": "갑자기 물어보면 뭐라고 대답해야 할지… 아마도 예전에 괴롭힘을 당했던 게 억울했나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520121
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520121,
					"content": "내 실력을 증명할 수만 있다면, 더 여유롭게 살 수 있을 거라고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520122
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520122,
					"content": "그런 이유였구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520123,
					"content": "그래서 학술 연구를 시작한 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520124
					]
				},
				{
					"id": 736520124,
					"content": "응, 지식이 전부인 나라에선 당연히 학술 실력에 따라 출세의 길이 펼쳐지니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520125
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520125,
					"content": "나는 딱히 재능도 없고 IQ도 평범해. 그래서 인기 없는 연구 과목을 골라서 성과를 내기 위해 최선을 다하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520126
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520126,
					"content": "혼자 오랫동안 연구에만 몰두하다 보니, 다른 사람과 잘 어울리지도 못하고 성질도 괴팍해졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520127,
						736520128
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520127,
					"content": "그래도 세상에는 좋은 사람들이 많아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				},
				{
					"id": 736520129,
					"content": "그래, 지금의 너는 더 대단한 목표가 생겼잖아. 좀 더 당당하게 살아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520130,
					"content": "편안한 마음으로 다른 사람과 소통하다 보면, 틀림없이 더 많은 사람의 도움을 받게 되고 함께 연구를 이어 나갈 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520131,
					"content": "그건 나도 잘 알고 있어, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520132
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520132,
					"content": "난 일상생활이나 대인관계에 대해 고민하는 것보다 연금술 연구가 훨씬 재미있고 수월하다는 걸 깨달았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520133
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520133,
					"content": "너희를 만나고 나서 나도 반성했어. 확실히 감정을 잘 추슬러야 할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520134
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520134,
					"content": "아무튼 「재용해 약제」 테스트를 도와줘서 고마워. 이제 성으로 돌아가서 논문을 써야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520135
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520135,
					"content": "약속했던 보수 외에 이것도 선물할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520136
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520136,
					"content": "이게 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520137
					]
				},
				{
					"id": 736520137,
					"content": "내가 가진 최고의 연금솥이야. 예전에 열심히 저축한 돈으로 비싸게 주고 산 건데, 결국 아까워서 한 번도 못 썼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520138
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520138,
					"content": "야! 갑자기 왜 가장 소중한 도구를 다른 사람한테 줘 버리는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520139,
					"content": "「재용해 약제」는 전통 포션과 달라서 내가 새로 설계한 기구로만 만들 수 있어. 그래서 더 이상 이 연금솥은 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520140
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520140,
					"content": "너희한테 주기로 한 보수 중에 다른 약속도 있었잖아. 이 연금솥으로 약속을 증명하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520141
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520141,
					"content": "이걸로… 차나 수프를 끓여 봐! 이 솥은 추출을 촉진하는 기능이 있어서 차나 수프를 더 맛있게 끓일 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520142
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520142,
					"content": "이렇게까지 말했으니까… 거절은 못 하겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520143
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520143,
					"content": "힘내요, 하자나드",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520144
					]
				},
				{
					"id": 736520144,
					"content": "당연하지! 좋은 소식 기다려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520145
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736520145,
					"content": "하자나드가 떠났다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736520146
					]
				},
				{
					"id": 736520146,
					"content": "#{NICKNAME}, 말해 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520147
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520147,
					"content": "우리 이번에 좋은 일 한 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520148,
						736520149
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520148,
					"content": "일상적인 모험일 뿐이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520150,
					"content": "맞아, 결론을 내리기엔 아직 이른 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520151
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520151,
					"content": "이 일을 잊고 살다가 어느 날 갑자기 하자나드가 유명한 학자가 됐다는 소식을 듣고, 하자나드의 초대를 받는 날이 올지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736520152
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520152,
					"content": "그만 생각하고 가자. 이 연금솥으로 차를 끓여보고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736520149,
					"content": "우리도 평정심을 가져야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520150
					]
				},
				{
					"id": 736520128,
					"content": "과거의 일에 얽매일 필요 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736520129
					]
				}
			]
		}
	]
}