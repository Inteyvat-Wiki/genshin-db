					"아비"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400690601,
					"content": "음, 저건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400690602,
					"content": "또 「문」이네, 이번에도 그런 사람들이 있는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690603
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400690603,
					"content": "상관없어, 얼마든지 오라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690604
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690604,
					"content": "누나, 헤어스타일이 정말 이상해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690605
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690605,
					"content": "그래? 난 멋지다고 생각하는데, 너도 다시 한번 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690606
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690606,
					"content": "머리를 양 갈래로 치켜올리고 뾰족한 장식을 달았잖아요. 그렇게 다니는 사람이 어디 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690607
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690607,
					"content": "네가 틀렸어. 남들과 다르니까 난 잊혀지지 않는 깊은 인상을 남길 수 있어. 나중에 또 날 보면 바로 알아볼걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690608
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690608,
					"content": "네… 그럴 거 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690609
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690609,
					"content": "머리와 의상, 피부, 몸매 모두 누군가에게 보여주려는 것만은 아니야. 자신 취향대로 꾸미는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690610
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690610,
					"content": "정말요? 하지만 제가 강아지가 그려진 옷을 입으면 사람들이 「아비는 정말 강아지 같아」라고 한단 말이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690611
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690611,
					"content": "그런 말은 그냥 무시해. 너 강아지 좋아하잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690612
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690612,
					"content": "맞아요, 좋아해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690613
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690613,
					"content": "네 친구들도 강아지를 좋아하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690614
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690614,
					"content": "네, 걔들도 좋아해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690615
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690615,
					"content": "그러면 네 친구들도 분명 그 옷을 좋아할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690616
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690616,
					"content": "…음, 근데 누나는 왜 사람들이 좋아하는 스타일로 안 묶는 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690617
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690617,
					"content": "어쩔 수 없어. 난 이게 좋거든. 이 머리를 하기 전엔 사람들이 싫어하는지도 전혀 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690618
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690618,
					"content": "근데 왜 안 바꿔요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690619
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690619,
					"content": "이 헤어스타일은 내 음악과 삶에 잘 어울리거든. 흔해 빠진 스타일은 너무 평범하고 활력이 없어. 공연할 때 방해되기도 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690620
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690620,
					"content": "싫으면 싫어하라 그래, 난 절대 안 바꿔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690621
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690621,
					"content": "그럼 누나 친구들도 싫어하나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690622
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690622,
					"content": "그럴 리가, 다들 멋있다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690623
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690623,
					"content": "…친구들이 응원해 주니 진짜 부럽다. 제 친구들은… 절 이곳에 버리고 갔는데, 흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690624
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690624,
					"content": "이런, 왜 울어! 무슨 일이야? 누나한테 말해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690625
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690625,
					"content": "룰루랑 소몽이가… 저랑 안 놀아줘요… 오늘 부두에서 만나기로 했는데, 아직도 안 왔어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690626
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690626,
					"content": "새파랗게 어린 것들이 약속을 안 지키다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690627
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400690627,
					"content": "여기 가만히 있어, 내가 주변을 살펴볼 테니까. 찾으면 녀석들을 데리고 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690628
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400690628,
					"content": "…네! 정말 고마워요, 누나. 앞으로는 양 갈래 머리가 이상하다고 하지 않을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400690629
					],
					"speakerTitle": "아비"
				},
				{
					"id": 400690629,
					"content": "하, 보는 눈이 있구나. 그럼 이따 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "신염"
				}
			]
		},
