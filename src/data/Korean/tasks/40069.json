					"듣기"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691101,
					"content": "참새들은 산 정상의 샘물을 마시니까 아름다운 노래를 부를 수 있는 거야. 집안사람들을 보렴, 아무도 노래를 즐기지 않는데, 네가 노래를 잘 부를 리 없잖니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691102
					],
					"speakerTitle": "신염의 어머니"
				},
				{
					"id": 400691102,
					"content": "그럼 나도 그 샘물을 마시면 되잖아? 엄마, 잠시 나갔다 올게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "신염"
				}
			]
		},
		{
			"id": 4006912,
			"completionStepIds": [
				4006912
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006912",
							"2"
						],
						"stepId": 4006912,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"신염",
					"카에데하라 카즈하",
					"모나",
					"향릉",
					"운근"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400691201,
					"content": "도착했어, 바로 여기야. 신발 벗을 필요 없고 다들 편하게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691202
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691202,
					"content": "실례할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691203
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400691203,
					"content": "의자가 있네, 앉아서 좀 쉬어야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691204
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400691204,
					"content": "음? 안에서 무슨 소리가 나는 거 같은데…. 너희들은 쉬고 있어. 내가 가서 확인해 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691205
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691205,
					"content": "불도 안 켜져 있고, 아무도 없… 으악?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691206
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691206,
					"content": "짜잔! 생일 축하해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691207
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691207,
					"content": "다 큰 녀석들이 불도 안 켜고 뭐 하는 거야, 깜짝 놀랐잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691208
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691208,
					"content": "운근 네 말이 맞았어, 엄청 놀라잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691209
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691209,
					"content": "그래도 생일인데 이 정도는 놀라게 해줘야죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691210
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691210,
					"content": "너희 둘, 그렇게 귀여운 얼굴로 이런 것 좀 하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691211
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691211,
					"content": "네? 그렇게 말하면 섭섭해요. 귀여우면 이런 장난 못 친다는 법이 있나요? 안 그래요, 향릉?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691212
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691212,
					"content": "맞아, 맞아! 누룽지도 그렇게 귀여운데 장난꾸러기잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691213
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691213,
					"content": "알았어, 알았어. 내가 잘못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691214
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691214,
					"content": "북두 언니는 오늘 일이 있다고 못 왔어. 대신 선물이랑 축하한다는 말을 전해달래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691215
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691215,
					"content": "자, 이건 북두 언니가 준비한 외국 악보와 특별 제작한 비수야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691216
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691216,
					"content": "신염, 전 저희 집안 사람들에게 금비녀와 철제 머리띠를 만들어 달라고 부탁했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691217
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691217,
					"content": "철제 머리띠?! 천 년 된 대장간 가문이 그런 걸 만들었다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691218
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691218,
					"content": "그게 왜요? 머리띠는 작지만 기술이 집약된 물건이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691219
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691219,
					"content": "후후, 난 특별한 걸 준비했지. 얼마 전에 길거리에서 안경을 쓴 대장장이를 만났는데, 돌멩이에 대해서 잘 아는 것 같았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691220
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691220,
					"content": "난 그런 거 안 믿지만, 그 사람에게 돌멩이를 골라달라고 했어. 근데 정말 비취를 고른 거 있지! 헤헤, 그래서 바로 펜던트 크기로 조각해서 끈으로 묶어 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691221
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691221,
					"content": "와, 비취 펜던트를 준비한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691222
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691222,
					"content": "그럼, 아아, 그건 목에다 걸지 말고 악기에다 걸어둬! 네 악기를 볼 때마다 꾸며주고 싶었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691223
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691223,
					"content": "이렇게 귀한 선물이라니, 소중히 간직할게! 정말 고마워, 넌 참 세심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691224
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691224,
					"content": "후후, 향릉이 세심한 건 하루 이틀도 아니었는걸요. 하지만 그 돌멩이에 대해 잘 아는 사람 이야기를… 조금 더 해주세요. 재미있으면 극에 넣으려고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691225
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691225,
					"content": "나도 잘 모르겠어. 한동안 아팠는데, 그때 좀 비몽사몽한 느낌이었고 몸이 내 몸처럼 느껴지지 않더래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691226
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691226,
					"content": "그런데 갑자기 몸이 나았대! 이유는 모르겠지만 그때부터 한눈에 좋은 돌을 구분하게 됐다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691227
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691227,
					"content": "음… 정말 이상한 일이군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691228
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691228,
					"content": "아아, 이제 이야기는 그만하고 음식이 식기 전에 어서 먹자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691229
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 400691229,
					"content": "잠깐만요, 신염, 외국 상인한테 배운 거 있잖아요? 저번에 제 생일 때 저한테 알려준 그거요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691230
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691230,
					"content": "음? 아, 생일 소원 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691231
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691231,
					"content": "네네, 그거요. 외국에서는 촛불을 켜고 케이크 커팅도 한다고 했잖아요, 저희는 그런 건 준비 못 하고 향릉의 음식만 가지고 왔거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691232
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691232,
					"content": "괜찮아, 그냥 혼자 상상하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691233
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400691233,
					"content": "그럼 셋을 셀 테니 소원을 비세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400691234
					],
					"speakerTitle": "운근"
				},
				{
					"id": 400691234,
					"content": "하나——",
