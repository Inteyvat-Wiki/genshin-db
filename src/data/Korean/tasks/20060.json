			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "잠깐… 달콤달콤꽃은 충분한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200600402,
					"content": "바로 <color=#00E1FFFF>젤리안나 수녀님</color>에게 가야 하나? 아님 좀 더 찾아야 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
