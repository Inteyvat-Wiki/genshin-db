						200600907
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600907,
					"content": "부끄럽군요. 아들이 고생하는데 도와줄 수가 없으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600908
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600908,
					"content": "아들에게 걱정 안 끼치는 것밖에 해줄 게 없네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600909
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600909,
					"content": "아, 맞다. 이거 받아요. 이 늙은이가 준비한 선물이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "터너"
				},
				{
					"id": 200600904,
					"content": "젤리안나 수녀님이 쉬라고 하시던데…",
