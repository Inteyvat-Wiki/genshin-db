			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"터너"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "손님, 안녕하세요. 내 아들 가이를 아십니까? 컥… 콜록…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "괜찮아요, 고질병인데 대단한 건 아닙니다. 근데 계속 차도가 없네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600104,
					"content": "예전에 <color=#00E1FFFF>성당</color>에 가서 진찰을 받았는데, 수녀님들도 단번에 고칠 수 없고 약으로 완화시켜야 한다고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600105,
					"content": "휴, 나이가 많아서 오래 못 걷는 바람에 전에는 모코와 하일리에게 약을 지어달라고 부탁했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600106,
					"content": "두 사람에게 오늘 마침 일이 있어서… 콜록… <color=#00E1FFFF>젤리안나 아가씨</color>에게 부탁했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600107,
					"content": "약재만 가지고 가면 수녀님이 약을 지어줄 겁니다. <color=#00E1FFFF>달콤달콤꽃 3인분</color>만 있으면 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600108,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600109,
					"content": "콜록, 컥… 그럼 부탁해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600112,
					"content": "달콤달콤꽃 3인분을 가지고 성당의 젤리안나 수녀님에게 가서 약을 지어요. <color=#00E1FFFF>가이에겐 절대 알리지 말고요</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600113,
					"content": "성당과 페보니우스 기사단은 관계가 있다고 들었어요. 그 녀석은 페보니우스 기사니 언행에 주의해야 됩니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600114,
					"content": "이 아비 때문에 실수한다면 큰일이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600115,
					"content": "군소리가 너무 많았네요. 어서 가봐요. 길에서 조심하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "터너"
				},
				{
					"id": 200600110,
					"content": "아드님인 가이 씨에게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "터너"
				},
				{
					"id": 200600111,
					"content": "아이고, 애가 밖에서 고생하는데 발목 잡을 순 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "터너"
				}
			]
		},
