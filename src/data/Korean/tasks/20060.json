				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600701,
					"content": "터너 씨는 참…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200600702,
					"content": "약을 지으러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "어? 모코와 하일리가 안 오고 어떻게 네가 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200600704,
					"content": "약재를 수집했겠지? 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "젤리안나"
				}
			]
		},
		{
			"id": 2006008,
			"completionStepIds": [
				2006009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
