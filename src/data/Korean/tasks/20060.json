					"젤리안나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "약을 다 지었어. 하지만 이걸로는 병을 근본적으로 고칠 수 없어. 병을 완전히 고치려면 약을 계속 먹고 쉬어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200600802,
					"content": "그에게 여러 번 말했는데 귓등으로도 안 들어. 계속 이거면 된대. 아무리 설득해도 안 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200600803,
					"content": "어서 약을 터너 씨에게 가져다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200600804,
					"content": "고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200600805,
					"content": "천만에, 해야 할 일을 했을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200600806,
					"content": "고생하셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200600807,
