				"points": []
			},
			"dialogs": [
				{
					"id": 200600301,
					"content": "이 정도면 충분하겠지. 이제 <color=#00E1FFFF>젤리안나 수녀님</color>에게 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
