			"dialogs": [
				{
					"id": 700110101,
					"content": "Yaya dala! Kundala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110102
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700110102,
					"content": "Mimi nye odomu! Kundala nye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110103
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700110103,
					"content": "Nye Odomu? Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110104
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700110104,
					"content": "Mimi tomo, mimi plata odomu! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110105
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700110105,
					"content": "Mani…? Zido mi, mi dada. Nye kundala? Mi plata yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110106
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700110106,
					"content": "우와… 이 녀석 성격 더러운 것 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110107,
						700110108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700110107,
					"content": "머스크, 조심해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110109
					]
				},
				{
					"id": 700110109,
					"content": "괜찮아, 흥분하지 마. 무슨 뜻인지 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110110
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700110110,
					"content": "에엥…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700110111,
					"content": "적을 처치해달라는 것뿐이야. 지도에서… 이쯤이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110113
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700110113,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110114
					]
				},
				{
					"id": 700110114,
					"content": "그 녀석 위치는 지도에 표시해뒀으니까 난 먼저 돌아갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110115
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700110115,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700110108,
					"content": "우리가 나설까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110109
					]
				}
			]
		},
