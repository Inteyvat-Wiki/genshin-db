			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"관해"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "으윽, 아이고… 괴로워…. 나, 나한테 볼일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "관해"
				},
				{
					"id": 413400302,
					"content": "아규의 약에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "아아, 고마워! 내가 주문한 거야…. 딱 맞게 왔군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "관해"
				},
				{
					"id": 413400304,
					"content": "휴우, 약이 있어서 다행이네. 밤에 바닷바람을 쐐서 감기 걸린 모양이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "관해"
				},
				{
					"id": 413400305,
					"content": "소화불량 아니었어요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "그럴 리가. 난 위장이 아주 튼튼하다고. 예전엔 한 끼에 생선구이 3마리 정돈 거뜬했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "관해"
				},
				{
					"id": 413400307,
					"content": "지금도 친구들 중에서 밥 먹고 술 마시는 건 내가 1등이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "관해"
				},
				{
					"id": 413400308,
					"content": "아무튼, 빨리 약부터 먹어야겠어. 이따 또 술자리가 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "관해"
				},
				{
					"id": 413400309,
					"content": "몸 잘 챙기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "하하하, 괜찮아. 난 아직 팔팔하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "관해"
				},
				{
					"id": 413400312,
					"content": "그래도 걱정해 줘서 고마워. 조심할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "관해"
				},
				{
					"id": 413400310,
					"content": "건강 관리는 젊을 때 해야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
		{
