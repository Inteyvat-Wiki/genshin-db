			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아규"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "수고했어요. 약은 다 배달하셨죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "아규"
				},
				{
					"id": 413400402,
					"content": "그 사람들 계속 안 나을 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "어쩔 수 없습니다. 평소에 관리를 안 하면 위장병은 완치가 어려워요. 병 날 때마다 약을 먹을 수밖에 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "아규"
				},
				{
					"id": 413400405,
					"content": "그래도 덕분에 저도 숨 좀 돌리겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "아규"
				},
				{
					"id": 413400406,
					"content": "소등에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "소등 날리기요? 저흰… 보통 안 해요. 소등은 소원을 빌기 위해 날리는 거잖아요. 「불복려」가 무슨 소원을 빌겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "아규"
				},
				{
					"id": 413400408,
					"content": "다른 가게들은 장사가 잘 되게 해달라고 하겠지만, 사람들의 병을 고치는 약방이 그런 소원을 빌 순 없으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "아규"
				},
				{
					"id": 413400409,
					"content": "아규 씨는 정말 착하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "하지만 저 개인적으론 소등을 날리고 싶어요. 모처럼의 축제니까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "아규"
