					"마나오"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "어이, 친구! 가격 착한 좋은 물건이 있는데, 한번 볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "마나오"
				},
				{
					"id": 752650102,
					"content": "응? 이건 어룡 인형이잖아? 느긋한 시장에서 본 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 752650103,
					"content": "보는 눈이 있네. 하지만 내 물건이 더 저렴해. 50% 할인이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "마나오"
				},
				{
					"id": 752650104,
					"content": "왜 그렇게 싸요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "헤헤, 친구, 그건 신경 쓰지 마. 나만의 루트가 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "마나오"
				},
				{
					"id": 752650106,
					"content": "훨씬 저렴하긴 한데 인형 색깔이 조금 이상해. 설마 가짜는 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 752650107,
					"content": "가짜? 보는 눈도 없는 녀석이… 저리 가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "마나오"
				},
				{
					"id": 752650108,
					"content": "얼른 가! 너희한테 안 팔아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마나오"
				}
			]
		},
