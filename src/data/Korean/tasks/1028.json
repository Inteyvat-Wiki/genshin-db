			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"연비"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "음? 뭐지, 어떻게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280402,
					"content": "왜… 왜 제자리로 돌아왔지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280403,
					"content": "우리가 왔던 곳인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280404,
					"content": "네, 출발했던 곳이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280405,
					"content": "하지만 우리가 잘못 간 것도 아니잖아. 계속 출구로 향하는 길로만 갔고 뒤 돌아간 적 없는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280406,
					"content": "나도 그랬던 걸로 기억해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280407,
					"content": "여행자, 너도 그렇게 생각하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280408,
					"content": "맞아요, 제대로 갔을 텐데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "뭐지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280410,
					"content": "이나즈마에선 상인이 밤길을 걷다가 너구리 요괴의 꾀에 넘어가서 날이 밝을 때까지 같은 곳을 맴돈다는 이야기가 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280411,
					"content": "한곳만 빙빙 도는 거잖아. 페이몬도 들어 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280412,
					"content": "알면 얘기가 쉬워지지. 내 생각엔 지금 우리도 비슷한 상황에 처한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280413,
					"content": "하지만 괜찮아, 나한테 퇴마해주는 조수가 있거든. 이런 일이 있을 땐 그 친구를 불러야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280414,
					"content": "오니인 이토한테 퇴마해주는 동료가 있다니… 간도 크네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280415,
					"content": "둔한 게 형님의 장점 중 하나지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280416,
					"content": "나와라, 우시!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280417,
					"content": "음메——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "우시"
				},
				{
					"id": 10280418,
					"content": "이 친구가 바로 아라타키파의 숨겨진 멤버, 우시야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280419,
					"content": "음메 음메",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "우시"
				},
				{
					"id": 10280420,
					"content": "오, 우시가 인사하고 있어. 우시라고 불러도 되고 우시 형님도 괜찮아. 우시는 길을 잘 찾으니까 이젠 얘만 따라가면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280421,
					"content": "숨겨진 멤버도 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280422,
					"content": "왠지 못 미더운데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280423,
					"content": "글쎄",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280424,
					"content": "가라, 우시! 우리를 위해 길을 찾아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280425,
					"content": "음메——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "우시"
				},
				{
					"id": 10280426,
					"content": "우시가 주변에 숨겨진 출구가 있는지 확인하기 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "음메… 음메… 음메!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "우시"
				},
				{
					"id": 10280428,
					"content": "음? 오오… 뭐?! 그럴 리가?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280429,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280430,
					"content": "우시가 근처를 다 돌아봤는데 출구 같은 건 없대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280431,
					"content": "들어오는 길이 있으면 나가는 길이 있을 텐데. 안 되겠어… 내가 확인해 보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280432,
					"content": "다들 눈치챘어? 처음에 우리가 위에서 떨어졌다고 생각했잖아. 그때까지만 해도 엄청 높은 곳에 출구가 있었는데… 지금은 사라졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280433,
					"content": "어떻게 이럴 수 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280434,
					"content": "지하에 있는 이 구조물은 생각처럼 단순하지 않은 모양이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280435,
					"content": "…내가 주변을 살펴볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280436,
					"content": "주변에는 온통 암벽뿐인데… 우리가 잘못 기억한 거 아닐까? 처음부터 떨어진 적이 없었다던가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280437,
					"content": "이봐, 겁먹은 거냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280438,
					"content": "누, 누가 겁먹었다고 그래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280439,
					"content": "음메——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "우시"
				},
				{
					"id": 10280440,
					"content": "우시도 네가 겁먹은 것 같대. 괜찮아, 무서우면 말해, 우리가 지켜줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280441,
					"content": "페이몬, 내가 있잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "가만히 있는다고 해결되는 건 없어. 다시 길을 찾아보자고. 시노부, 넌 은인이랑 같이 다녀. 내가 여행자와 페이몬이랑 다닐게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280443,
					"content": "알겠어요, 다들 조심하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280444,
					"content": "은인은 너무 과분하고, 연비라고 불러요. 이토 씨는 한 조직의 형님이라 그런지 리더십이 뛰어나네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280445,
					"content": "에이, 뭘. 그냥 이토라고 불러. 이제부터 동료니까 서로 도와야지. 페이몬, 무서우면 이 몸이 눈 가려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280446,
					"content": "일행이 흩어져서 주변을 살폈지만 큰 수확은 없었다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "…휴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280448,
					"content": "출구가 진짜 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280449,
					"content": "음메!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "우시"
				},
				{
					"id": 10280450,
					"content": "여기, 아무래도 뭔가 잘못됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280451,
					"content": "형님, 그쪽 상황은 어때요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280452,
					"content": "아무런 수확 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "방금 얼핏 사람 몇 명을 본 것 같은데… 진짜 귀신이라도 있는 거 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280454,
					"content": "지금 분위기에서 이런 말 하면 그렇지만, 이토 너도 오니 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280455,
					"content": "아니! 내가 말한 건 그런 게 아니라, 갑자기 나타났다가 사라지는 귀신 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280456,
					"content": "음? 이토, 너 설마… 귀신을 무서워하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280457,
					"content": "이런, 들켜버렸네요, 형님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280458,
					"content": "누, 누가 그래! 말도 안 되는 소리 하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280459,
					"content": "헤헤, 네가 그러니까 나 별로 안 무서워졌어…. 이봐, 소몰이 청년, 무서우면 내가 눈 가려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280460,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280461,
					"content": "난 다른 할 일을 찾아봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280462,
					"content": "(어? 시노부가 옆에서 돌멩이를 줍더니 주머니에서 나뭇가지와 제비꽃 열매를 꺼냈어… 으음?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "소금 조금에… 후추도 좀 넣고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280464,
					"content": "제비꽃 열매 굽는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "응, 구우면 맛있거든. 너도 이따가 먹어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280466,
					"content": "좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "음… 짠맛이랑 단맛 중에 뭐가 좋아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280468,
					"content": "다 좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "음, 그럼 다 먹어봐. 이럴 때일수록 정신을 가다듬어야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280470,
					"content": "내 추측이 맞다면 이곳에는 나와 형님이 알면 안 되는 비밀이 숨겨져 있을 가능성이 커. 걱정 마, 너희가 기밀에 대해 얘기하는 걸 형님이 방해 못하도록 주의시킬게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280471,
					"content": "와, 뭘 굽고 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280472,
					"content": "연비 씨도 좀 먹어 볼래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280473,
					"content": "난 배 안 고파. 너희 먼저 먹어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280474,
					"content": "그나저나 시노부랑은 정말 오랜만에 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280475,
					"content": "그렇네요. 제가 리월에서 공부할 때 마지막으로 봤으니까요. 연비 씨가 한번 수업 때 대리 교사로 왔었잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280476,
					"content": "대리 교사… 아, 생각났어. 겨울이었던 것 같은데, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280477,
					"content": "네, 다들 연비 씨 수업이 재밌다고 했었어요. 그럼… 선배라고 불러야겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280478,
					"content": "좋아, 그 호칭 나쁘지 않은데? 마음에 들어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280479,
					"content": "후배와 같이 이런 일에 처할 줄은 상상도 못했지만, 이것도 인연이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280480,
					"content": "연비가 수업도 했다니, 다재다능하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "게다가 수업이 엄청 재밌어서 학생들한테 인기도 많았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280482,
					"content": "하하하, 과찬이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280483,
					"content": "다들 여기 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280484,
					"content": "야란, 우리도 흩어져서 찾아봤는데 근처에서 출구는 못 찾았어. 그쪽은? 뭐 찾은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280485,
					"content": "아니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280486,
					"content": "그리고… 이런 말 하기 싫지만, 마음의 준비를 하는 게 좋을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280487,
					"content": "계속 나갈 길을 못 찾으면, 당분간 지하에서 지내야 할 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280488,
					"content": "…내 생각도 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10280489,
					"content": "…그렇군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280490,
					"content": "하지만 들어갈 수만 있고, 나가지 못하는 공간은 존재하지 않아. 그건 말이 안 돼…. 다른 방법을 계속 생각해 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280491,
					"content": "출구처럼 보이는 곳을 발견해도, 다들 안전을 확보한 상태에서 탐색을 진행해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10280492,
					"content": "(그나저나 소도 여기 있었지. 난처한 일이 생기면 이름을 부르라고 했잖아)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "(…응, 좋은 방법일지도 몰라)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "이봐, 왜 그렇게 심각한 표정을 지어? 뭐 하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280495,
					"content": "소도 여기 있잖아, 기억나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "소… 맞아! 소한테 도움을 청하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280497,
					"content": "시도해 볼 만한 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "좋아, 한번 해보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280499,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "소, 들려?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280502,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "소?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "반응이 없네…. 소는 언제 어디서든 부르면 무조건 나타나는 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280505,
					"content": "설마 소도 우리의 기운을 못 느끼는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10280506,
					"content": "(……)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "(그게 사실이라면 뭘 의미하는 걸까? 이 지하는… 대체 어떻게 된 거지?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
