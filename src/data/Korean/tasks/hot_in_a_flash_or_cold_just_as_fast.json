						"position": [
							3426.561,
							449.586,
							4456.811
						],
						"pointId": 15214
					}
				]
			},
			"dialogs": [
				{
					"id": 746890101,
					"content": "(저 사람은… 스승님이 말씀하신… 금발의 여행자와 날아다니는 흰색 요정…?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890102
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890102,
					"content": "응? 우리를 계속 쳐다보면서 중얼거리고 있는데, 혹시 우리 얼굴에 뭐라도 묻었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746890103,
					"content": "앗! 죄, 죄송해요! 일부러 그런 건 아니에요! 저… 전 그냥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890104,
						746890105
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890104,
					"content": "긴장 풀고 천천히 얘기하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890106
					]
				},
				{
					"id": 746890106,
					"content": "#전 니네트라고 해요. 스승님인 르핀 폴린께서 당신이 최고의 파트너 페이몬 님과 함께하는 전설적인 모험가 {NICKNAME} 님이라고 하셨어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890107
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890107,
					"content": "저, 정말로 여러분을 만나게 될 줄은 몰랐네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890108
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890108,
					"content": "아! 르핀 폴린의 제자였구나! 요즘 사업이 잘 돼가나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746890109,
					"content": "네! 그리고 스승님 덕분에 제가 인생의 밑바닥에서 일어설 수 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890110
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890110,
					"content": "무슨 일 있었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890111
					]
				},
				{
					"id": 746890111,
					"content": "원래는 다른 선생님 밑에서 촬영 기술을 배우고 있었는데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890112
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890112,
					"content": "어엿한 사진작가가 되기 위해 모아둔 돈을 전부 투자해서 당시 가장 비싼 촬영 장비 세트를 구매했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890113
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890113,
					"content": "선생님도 제 실력이 꽤 괜찮다고 하셨고… 좋은 사진만 찍으면 돈을 벌 수 있을 거라 생각했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890114
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890114,
					"content": "하, 하지만 거리에 나가 사람들만 보면, 긴장돼서 말 한마디도 못 걸었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890115
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890115,
					"content": "「안녕하세요, 사진 찍어드릴까요?」라고 말하고 싶었지만, 도저히 입 밖으로 나오질 않더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890116
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890116,
					"content": "결국 손님들은 모두 말솜씨 좋고 적극적으로 호객하는 사진작가들에게로 가버렸죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890117
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890117,
					"content": "결국 전 모라를 다 써버렸고, 소중한 사진기까지 생활비로 팔아야 할 지경까지 이르렀죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890118
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890118,
					"content": "정말 쉽지 않았겠네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890119
					]
				},
				{
					"id": 746890119,
					"content": "그때, 르핀 폴린 스승님을 만났어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890120
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890120,
					"content": "스승님은 제 장비와 사진을 보고 절 격려해 주었고, 새로운 사진기를 테스트하는 것도 도와달라고 했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890121
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890121,
					"content": "스승님은… 제가 찍은 사진에는 다른 사람들에게는 없는 고요함과 따뜻함이 있다고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890122
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890122,
					"content": "그래서! 스승님께서 이 「순간」 렌즈를 성공적으로 개발하셨을 때, 저는 누구보다도 기뻤어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890123
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890123,
					"content": "「순간」 렌즈? 그건 어디에 쓰는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746890124,
					"content": "고속으로 움직이는 사람의 동작과 얼굴을 선명하게 포착할 수 있는 렌즈인데요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890125
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890125,
					"content": "하지만… 아직은 최종 테스트 단계라서, 촬영을 통해 많은 데이터를 수집하고 성능을 검증해야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890126
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890126,
					"content": "스승님께서 최근 바쁘셔서 이 임무를 저한테 맡기셨어요. 처음엔 테스터를 모집해서 도움을 받을까 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890127
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890127,
					"content": "낯선 사람에게 말을 걸려 하면 긴장해서 자꾸 말을 더듬는 습관 때문에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890128
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890128,
					"content": "사람들은 절 수상한 사람으로 여긴 거 같아요… 며칠이 지났는데도 도와주려는 사람이 없었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890129
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890129,
					"content": "흑흑… 이렇게 간단한 일도 해결 못 한다니, 전 정말 쓸모없는 사람이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890130
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890130,
					"content": "울지 마! 이건 네 잘못이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746890131,
					"content": "낯선 사람에게 갑자기 부탁하는 건, 누구한테나 쉬운 일이 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890132,
						746890133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746890132,
					"content": "자책할 거 없어요. 충분히 노력했잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890134
					]
				},
				{
					"id": 746890134,
					"content": "#그래! {NICKNAME}은(는) 사진 실력도 뛰어나고, 친구도 많아서 전혀 문제 없다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746890135,
					"content": "정, 정말요? 진짜 도와주시는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890136
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890136,
					"content": "#와아——! 저, 정말 감사드립니다! {NICKNAME} 님!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890137
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890137,
					"content": "그럼 「순간」 렌즈가 탑재된 이 특제 사진기를 잘 부탁드릴게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890138
					],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890138,
					"content": "이걸로 친구들의 가장 생동감 넘치고 특별한 순간을 기록해 주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니네트"
				},
				{
					"id": 746890133,
					"content": "그리고 이 일은 우리가 도와줄 수 있을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890134
					]
				},
				{
					"id": 746890105,
					"content": "우리 아는 사이인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890106
					]
				}
			]
		}
	]
}