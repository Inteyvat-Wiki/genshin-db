			"dialogs": [
				{
					"id": 221100301,
					"content": "어때? 처치했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100302,
					"content": "처치했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "유적 헌터도 처치하다니… 엄청난 실력자인데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100304,
					"content": "…「검」과 관련된 물건은 역시 못 찾았겠지? 후… 예상대로네, 벌써 이 말만 몇 번째인지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100305,
					"content": "괜찮아. 내 의뢰를 이렇게나 많이 해결해주다니, 수고했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100306,
					"content": "「장봉」, 도대체 어디 있는 거냐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100307,
					"content": "분명 찾을 수 있을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "…날 위로해주는 거야? 이런 사소한 일로 좌절하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100310,
					"content": "언제 어디가 됐든 꼭 찾고 말 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100311,
					"content": "수색 범위를 계속 넓혀야겠어. 나중에 너한테 도움을 요청할 수도 있겠지. 보수는 확실히 지급할 테니까, 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100316,
					"content": "여기 보수 줄게. 난 이제 의뢰를 선별하러 가야겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100317,
					"content": "…「장봉」, 꼭 찾아내고야 만다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100308,
					"content": "이 의뢰들… 「검」과 아무 관련 없는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "사실 「검」과 관련된 의뢰를 엄청 많이 받았었는데… 아무 수확도 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100313,
					"content": "게다가 내 생각에… 큰형님이 무기를 놓칠 정도면 분명히 엄청 위험한 상황이었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100314,
					"content": "그래서 위험한 지역의 의뢰들을 수락하면서 「장봉」을 찾고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 221100315,
					"content": "근데 충분히 위험한 의뢰가 나 혼자선 다 못할 정도로 많아서 너한테 도움을 요청한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "란 누님"
				}
			]
		}
