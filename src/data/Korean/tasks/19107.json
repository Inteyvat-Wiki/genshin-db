					"코너"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191079701,
					"content": "엘저 씨, 정말이지 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079702
					],
					"speakerTitle": "코너"
				},
				{
					"id": 191079702,
					"content": "코너 씨, 지금 중요한 건 디오나가 우리의 열정을 느끼게 하는 거예요. 아시겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079703
					],
					"speakerTitle": "엘저"
				},
				{
					"id": 191079703,
					"content": "아, 알겠어요. 엘저 씨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "코너"
				}
			]
		},
		{
			"id": 1910798,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
