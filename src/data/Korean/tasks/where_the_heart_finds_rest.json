			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"신학"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110150401,
					"content": "우와… 다들 착석했네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110150402,
					"content": "군옥각에서 응광의 연회에 참여하는 건 처음이야! 맛있는 거 엄청 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110150403,
					"content": "여기에 계신 분 모두 저 응광의 귀빈입니다. 오늘 부디 마음껏 즐기다 가세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150404
					],
					"speakerTitle": "응광"
				},
				{
					"id": 110150404,
					"content": "술을 못 하시는 분은 음료로 대신해 주세요. 마음을 즐겁게 하는 건 술뿐만이 아닙니다. 군옥각의 아름다운 경치도 여러분의 마음을 취하게 할 것입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150405
					],
					"speakerTitle": "응광"
				},
				{
					"id": 110150405,
					"content": "들으셨어요? 오늘 운 선생이 무대에 오른대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150406
					],
					"speakerTitle": "영배"
				},
				{
					"id": 110150406,
					"content": "허, 솔직히 전 그것 때문에 왔습니다! 운 선생의 공연은 하나도 빠짐없이 보거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150407
					],
					"speakerTitle": "주단"
				},
				{
					"id": 110150407,
					"content": "이번 무대는 《사원을 가른 신녀》라고 하던데, 운 선생 아버지가 쓴 작품 말입니다. 너무 기대돼서 밤잠까지 설쳤다고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150408
					],
					"speakerTitle": "주단"
				},
				{
					"id": 110150408,
					"content": "어, 보세요. 운 선생이 무대에 올랐어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150409
					],
					"speakerTitle": "시우"
				},
				{
					"id": 110150409,
					"content": "어때요? 나쁘지 않은 무대였죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150410
					],
					"speakerTitle": "운근"
				},
				{
					"id": 110150410,
					"content": "진짜 대단해! 나중에 페이몬도 배우고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110150411,
					"content": "좋은 무대였어. 그리고… 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150412
					],
					"speakerTitle": "신학"
				},
				{
					"id": 110150412,
					"content": "아니에요, 신학 씨 덕분에 《사원을 가른 신녀》가 더 완전해졌어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150413
					],
					"speakerTitle": "운근"
				},
				{
					"id": 110150413,
					"content": "연극은 막을 내리지만, 인생은 그렇지 않죠. 앞으로 꼭 리월항의 일원이 될 수 있으리라 믿어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150414
					],
					"speakerTitle": "운근"
				},
				{
					"id": 110150414,
					"content": "고마워. 변화의 「계기」를 이미 찾은 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150415
					],
					"speakerTitle": "신학"
				},
				{
					"id": 110150415,
					"content": "운 선생… 딸꾹… 여기 계셨군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150416
					],
					"speakerTitle": "주단"
				},
				{
					"id": 110150416,
					"content": "음? 이 백, 백발의 아가씨한텐 뭔가 특이한 분위기가, 마치 선인 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150417
					],
					"speakerTitle": "주단"
				},
				{
					"id": 110150417,
					"content": "#설마 당신이 그 신녀? 그리고 이분은, 그 유명한 {NICKNAME} 아닙니까? 하하, 여기까지 헛걸음한 건 아닌 것 같군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150418
					],
					"speakerTitle": "주단"
				},
				{
					"id": 110150418,
					"content": "저도 여기 좀 껴도 되죠? 자, 같이 이야기 좀 해봅시다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150419
					],
					"speakerTitle": "주단"
				},
				{
					"id": 110150419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150420
					],
					"speakerTitle": "신학"
				},
				{
					"id": 110150420,
					"content": "콧구멍이나 눈으로 남은 술을 마시고 싶지 않다면, 당장 자리를 뜨는 게 좋을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150421
					],
					"speakerTitle": "신학"
				},
				{
					"id": 110150421,
					"content": "이 익숙한 느낌은… 신학을 처음 만났을 때로 돌아간 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110150422,
					"content": "아직 갈 길이 멀었네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110150423
					]
				},
				{
					"id": 110150423,
					"content": "힉! 뭡니까 당신!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110150424
					],
					"speakerTitle": "주단"
				},
				{
					"id": 110150424,
					"content": "진정해, 신학. 진정하라고——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
