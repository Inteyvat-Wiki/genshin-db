			"dialogs": [
				{
					"id": 751320501,
					"content": "주의하라…. 칠흑의 적이 떠도는 곳을, 모든 것을 잠식하는 적을",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
				},
				{
					"id": 751320502,
					"content": "이방의 용사여…. 궁금한 게 있는가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
				},
				{
					"id": 751320503,
					"content": "영웅의 벽화에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "동쪽, 빛나는 나무가 흔들리는 동굴 속이다. 두루마리를 쥔 이야기꾼이 말했듯, 과거의 이야기 속에도 공포는 숨어 있다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
				},
				{
					"id": 751320505,
					"content": "어쩌면 그 그림자는 과거의 이야기에서 탈출구를 찾고 있을지도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
				},
				{
					"id": 751320506,
					"content": "안개가 자욱한 바다에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "서쪽에 있는 안개로 뒤덮인 섬은 과거 의식이 거행되던 성소였다. 또한 명룡과 계약을 맺은 자들이 거처로 삼은 곳이기도 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
				},
				{
					"id": 751320508,
					"content": "그러나 더러운 진흙이 흘러나오면서 성소는 칠흑의 소굴이 되어버렸고, 그곳은 봉인되어 잊혔다…. 아아, 그러나 교활한 적은 쉬이 포기하지 않으리니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
				},
				{
					"id": 751320509,
					"content": "색 잃은 안개에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "오치카나타라 불리던 고대의 성이 파괴되었을 때 탄생한 부정한 안개다. 당초 봉인되어 있었으나… 세월과 망각은 강대한 적이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
				},
				{
					"id": 751320511,
					"content": "누군가가… 다시 한번 색 잃은 안개를 몰아내 준다면 좋으련만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
				},
				{
					"id": 751320512,
					"content": "아뇨, 딱히 궁금한 건 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "아아… 반드시… 반드시 주의하라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "수수께끼 그라피티에 깃든 의지"
