	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아란파카티",
					"아란마",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "앗! 금빛의 나라다. 으아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130102,
					"content": "#무서워하지 마, 아란파카티. 나라{NICKNAME}(은)는 이야기에 나오는 그 나라처럼 착한 나라야. 나라{NICKNAME}(이)랑 페이몬이 모두를 많이 도와줬거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130103,
					"content": "#응, 아란파카티는 아란마를 믿으니까 두렵지 않아. 풀과 잎과 씨앗이 하는 말도 믿어. 분명 착한 나라일 거야. 나라{NICKNAME}와(과) 페이몬, 만나서 반가워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130104,
					"content": "안녕, 아란파카티!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130105,
					"content": "사실 난 나쁜 사람이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "야! 그런 장난치지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130107,
					"content": "아니야, 아란파카티는 알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130108,
					"content": "#바람이 많이 부는 곳에 작은 씨앗이 있어. 그들은 나라와 함께 바나라나에 왔는데 나라{NICKNAME}(은)는 착한 나라라고 알려 줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130109,
					"content": "예전에 아란마도 비슷한 얘기를 했어! 바람이 많이 부는 곳에서 온 씨앗이라면… 민들레를 말하는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130110,
					"content": "풍차 국화일지도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#비야의 열매가 열릴 수 있도록 나라{NICKNAME}가(이) 아란나를 도와주기로 했어. 그래서 우린 우트사바 축제를 함께 준비할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130116,
					"content": "아차차… 우트사바 축제…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130117,
					"content": "아란파카티, 조금 이상해 보여. 무슨 고민이라도 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130118,
					"content": "아란파카티의 「오빠」들이 오랫동안 바나라나로 돌아오지 않았어. 이렇게 계속 돌아오지 않는다면, 우리 「남매」는 우트사바 축제를 함께 즐길 수 없을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130119,
					"content": "바나라나에서 아란차토라, 아란사카, 아란파스, 아란팔라를 본 지도 한참 된 것 같네. 그 일이 있고 나서 지금까지 한 번도 못 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130120,
					"content": "한참이라면… 얼마나 오래된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130121,
					"content": "아주아주 많은 달이 뜨고 졌어. 그때 막 피었던 새싹이 이제 아란파카티 일곱 배만큼 자라서 아란나라가 비를 피할 수 있는 큰 나무가 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130122,
					"content": "씨앗이 큰 나무가 됐다니…. 와! 그럼 꽤 많은 시간이 지난 거잖아! 설마 아란파카티의 오빠들이 실종된 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130123,
					"content": "「실종」? 그게 뭔데? 씨앗을 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130124,
					"content": "우와! 나라는 씨앗을 실종이라고 부르는구나! 신기해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130125,
					"content": "#진짜 신기하다! 나라{NICKNAME}(이)라면 분명 아주 많은 실종을 가지고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130126,
					"content": "그 뜻이 아니라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130127,
					"content": "「어디로 갔는지 알 수 없다」라는 뜻이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "아, 아냐. 아란파카티는 아란차토라, 아란사카, 아란파스, 아란팔라가 어딨는지 알아. 오빠들은 실종되지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130129,
					"content": "오빠들은 바나라나 밖에서 오랫동안 「요리 수행」을 하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130136,
					"content": "그렇구나. 「요리 수행」이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130137,
					"content": "페이몬이 관심 있는 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#크흠! 페이몬은 「{NICKNAME}의 요리 수행」에 더 관심이 많거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130139,
					"content": "그나저나 「요리 수행」이라는 게 정확히 뭐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130140,
					"content": "그건 지난번 우트사바 축제에서 있었던 일이야. 그때 나라가 아주 다양한 「요리」를 만들어서 아란나라한테 맛보여 줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130141,
					"content": "아란차토라와 다른 아란나라들은 우트사바 축제에서 나라에게 「요리」를 해 주고 싶대. 그래서 계속 「요리 수행」 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130142,
					"content": "…갑자기 우트사바 축제가 기대되네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130143,
					"content": "하지만 그건 아란나라가 먹는 건데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "미식은 모든 생물의 공통된 언어라 괜찮아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130146,
					"content": "그나저나 아란파카티는 오빠들이 어딨는지 알면서 왜 찾으러 가지 않는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130147,
					"content": "곧 우트사바 축제가 열리잖아. 아란파카티는 준비할 게 아주아주 많거든. 오빠들 찾으러 갈 시간이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130148,
					"content": "우트사바 축제 때문에 바나라나를 떠나 수행 중이면서 축제가 곧 시작되는 것도 모르다니…. 아란차토라, 아란사카, 아란파스, 아란팔라 이 바보들!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130149,
					"content": "#그럼 우리에게 맡겨! 어차피 우리도 아란마와 함께 우트사바 축제를 준비하고 숲속에 있는 아란나라를 찾아야 하거든. {NICKNAME}, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130150,
					"content": "우리한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "그런데 아란차토라, 아…아란 뭐였지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130153,
					"content": "아란차토라, 아란사카, 아란파스, 아란팔라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130154,
					"content": "으윽, 아란나, 아란마, 아란자, 아란파카티… 아란나라의 이름은 왜 이렇게 외우기가 힘든 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130155,
					"content": "페이몬, 이름이 별로라고 하면 안 돼. 아란나라가 속상해할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130156,
					"content": "휴, 알겠어. 그래서 우리가 걔네를 어떻게 찾아야 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130157,
					"content": "걔네들은… 예전에 바나라나에서 요리 수행을 하다가 연기를 너무 많이 내서 아란파카티한테 쫓겨났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130158,
					"content": "그때 다들 겁에 질렸었지. 어떤 아란나라는 너무 놀라서 수면 상태에 빠졌을 정도니까. 다행히 아란마가 용감하게 연기를 혼내 줬는데 그래도 화가 안 풀려서 오빠들을 내쫓아 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130159,
					"content": "숲에서 <color=#00E1FFFF>모락모락 피어오르는 연기 기둥</color>을 발견하면 오빠들을 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130160,
					"content": "그러니까 네가 쫓아낸 거였네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130161,
					"content": "응, 왜 뭐가 잘못됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130162,
					"content": "#아니야… {NICKNAME}, 그럼 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130163,
					"content": "참, 그리고 또 하나 알려줄 게 있어. 오빠들이 이상해지면 <color=#00E1FFFF>풀 원소의 힘</color>으로 오빠들을 「찰싹」해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130164,
					"content": "오빠들 때문에 예전에 바나라나가 온통 연기에 뒤덮인 적이 있거든. 그 뒤로 겁에 질리거나 이상한 버섯을 보면 사방팔방 뛰어다녀",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130165,
					"content": "하지만 아란나라는 초목의 요정이라서 <color=#00E1FFFF>풀 원소의 힘</color>만 흡수하면 다시 정신을 차리고 회복할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130166,
					"content": "#이해했어, 그럼 {NICKNAME}(은)는 달콤달콤 닭고기 스튜만 먹으면 회복하니까 달콤달콤 닭고기 스튜의 요정이겠네. 꽤 일리 있는 말인 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130167,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130169,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130170,
					"content": "…그럼 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130172,
					"content": "#나라{NICKNAME}(이)랑 페이몬, 힘내!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란마"
				},
				{
					"id": 730130171,
					"content": "아무튼 출발하자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "응",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "나도 기대돼!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "그 기분 이해해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#나라{NICKNAME}도 내 기분을 이해한다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130132,
					"content": "#응, {NICKNAME}도 잃어버린 {F#오빠가}{M#동생이} 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130133,
					"content": "#오, 나라{NICKNAME}의 {F#오빠}{M#동생}도 「요리 수행」을 하러 간 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130134,
					"content": "음? 뭔가 오해한 것 같은데… 실종은 「어디로 갔는지 알 수 없다」라는 뜻이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130135,
					"content": "아, 그렇구나. 아란파카티의 오빠들은 실종된 게 아니야. 오빠들은 바나라나 밖에서 아주 오랫동안 「요리 수행」을 하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730130111,
					"content": "솔방울일지도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "바람이 이야기의 씨앗을 가져다준 걸지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730130114,
					"content": "안녕",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
