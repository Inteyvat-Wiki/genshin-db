			"dialogs": [
				{
					"id": 20150101,
					"content": "#{NICKNAME}, 텟페이는 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150102,
						20150103
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150102,
					"content": "계속 눈치를 못 챘어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				},
				{
					"id": 20150104,
					"content": "…이미 군대에 퍼진 사안을 모두 회수하라고 지시했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150105
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150105,
					"content": "대다수의 생명력이 줄어들긴 했지만 그리 심각하진 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150106
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150106,
					"content": "반면 일부는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150107
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150107,
					"content": "산고노미야 님, 부상병 군영을 따로 하나 꾸려서 그들의 상태를 지켜보는 게 좋을 것 같습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150108
					],
					"speakerTitle": "고로"
				},
				{
					"id": 20150108,
					"content": "다들 사안인 걸 알면서도 사용하겠다고 난동을 부리네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150109
					],
					"speakerTitle": "고로"
				},
				{
					"id": 20150109,
					"content": "이 일은 너한테 맡길게. 난 전선에 가봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150110
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150110,
					"content": "큰 사건이 터졌으니 병사들의 사기가 흔들릴 거야. 막부군이 혼란을 틈타 공격하기라도 하면 다 헛수고가 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150111
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150111,
					"content": "#{NICKNAME}, 넌 어쩔 계획이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150112
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150112,
					"content": "우인단의 계획을 저지할 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150113
					]
				},
				{
					"id": 20150113,
					"content": "안 돼, 그건 너무 위험해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150114
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150114,
					"content": "쇄국령이 실행되고 있으니 사안은 이나즈마에서 생산했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150115
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150115,
					"content": "이 정도의 인력과 물력을 동원하려면 현지 세력이 뒷받침되어야만 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150116
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150116,
					"content": "그들을 막으려면 사안 생산 공장을 파괴하는 수밖에 없어. 하지만 거긴 강력한 군대가 지키고 있겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150117
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150117,
					"content": "너에게 이런 위험을 떠안게 할 순 없어. 최소한 군대와 함께…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150118
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150118,
					"content": "시간이 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150119
					]
				},
				{
					"id": 20150119,
					"content": "산고노미야 님, 저희가 너무 급박하게 사안을 회수한 탓에 우인단의 스파이가 분명 눈치챘을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150120
					],
					"speakerTitle": "고로"
				},
				{
					"id": 20150120,
					"content": "군대를 정비하는 데 또 시간을 쏟는다면, 소문을 듣고 미리 도망칠 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150121
					],
					"speakerTitle": "고로"
				},
				{
					"id": 20150121,
					"content": "알겠어… 생각 좀 해볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150122
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150122,
					"content": "사안을 회수할 때 생각해봤는데, 공장은 크고 폐쇄적이며 원활한 재료 공급을 위해 교통로와 가까운 곳에 있어야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150123
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150123,
					"content": "이런 조건에 맞는 곳은 많지 않아. 병사들이 사안을 받은 장소로 미뤄볼 때 공장은 <color=#00E1FFFF>야시오리섬</color> 남서쪽의 바다와 맞닿은 절벽에 있을 것으로 추정돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150124
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150124,
					"content": "널 막진 않겠지만 꼭 조심해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150125
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150125,
					"content": "우린 이미 전우를 많이 잃었어. 너까지 잃고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150126
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20150126,
					"content": "우리도 가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150127
					]
				},
				{
					"id": 20150127,
					"content": "어? 그 <color=#00E1FFFF>사안 공장</color>에 가게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20150128,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150129
					]
				},
				{
					"id": 20150129,
					"content": "진짜? 마음 굳힌 거야? 알았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20150103,
					"content": "상태가 급격히 악화됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				}
			]
		},
