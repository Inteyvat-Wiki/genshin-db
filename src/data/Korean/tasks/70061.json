			"dialogs": [
				{
					"id": 700610701,
					"content": "어? 돌아왔구나? 어떻게 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "레오폴디네"
				},
				{
					"id": 700610702,
					"content": "쫓아냈어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "와, 정말 고마워. 자, 여기 보수야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "레오폴디네"
				},
				{
					"id": 700610704,
					"content": "일했으면 합당한 대가를 받아야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "레오폴디네"
				},
				{
					"id": 700610705,
					"content": "이제 꽃을 다시 심을 수 있겠네. 이번에는 동물이 밭을 망치지 않았으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레오폴디네"
				}
