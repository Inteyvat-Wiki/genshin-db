				"points": []
			},
			"dialogs": [
				{
					"id": 120100101,
					"content": "#{F#누나}{M#형아}, 우린 「너구리 요괴」를 찾고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100102
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100102,
					"content": "혹시 「너구리 요괴」 어디 있는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100103
					],
					"speakerTitle": "사이카"
				},
				{
					"id": 120100103,
					"content": "「너구리 요괴」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100104,
					"content": "엥, 너구리 요괴 몰라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100105
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100105,
					"content": "엄청 강하고 영악한 요괴야. 여러 형태로 변하고 신출귀몰한 데다가 사람들을 속이기도 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100106
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100106,
					"content": "그 「요괴」가 우리 집 쌀도 훔쳐먹었어. 한번은 아빠를 강에 빠뜨린 적도 있다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100107
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100107,
					"content": "완전 장난꾸러기네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100108,
					"content": "너구리 요괴는 왜 찾으려는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100109
					]
				},
				{
					"id": 120100109,
					"content": "드디어 그 녀석을 물리칠 방법을 찾았거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100110
					],
					"speakerTitle": "사이카"
				},
				{
					"id": 120100110,
					"content": "아빠가 그러는데, 「너구리 요괴」는 집에 돌아가지 않는 사람을 괴롭힌대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100111
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100111,
					"content": "「너구리 요괴」만 쫓아내면 우린 언제든지 놀러 나갈 수 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100112
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100112,
					"content": "안 무서워? 엄청 강한 요괴라며?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100113,
					"content": "너희 부모님도 걱정하실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100114,
					"content": "아닌데? 오늘 아빠한테 「너구리 요괴」 잡으러 갈 거라고 했는데 아무 말 안 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100115
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100115,
					"content": "어쩌면 지금은 약해서, 어디 숨어서 쉬고 있는 걸지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100116
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100116,
					"content": "맞아! 「너구리 요괴」가 요력을 회복하기 전에 집에 가면 괜찮을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100117
					],
					"speakerTitle": "사이카"
				},
				{
					"id": 120100117,
					"content": "흐음, 정확히 뭔진 모르겠지만 좀 이상한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100118,
						120100119,
						120100120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100118,
					"content": "표적이 되면 집에 숨어도 소용없지 않을까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100121,
					"content": "응, 「너구리 요괴」는 실존하지 않는 단순한 상상 속 요괴 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100122,
						120100123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100122,
					"content": "나도 그렇게 생각해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100124,
					"content": "그럼 말해주자. 무작정 찾아다니게 하는 건 시간 낭비잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100125,
					"content": "얘들아, 「너구리 요괴」 안 찾아도 돼. 실제론 존재하지 않으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100126,
					"content": "에——?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100127
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100127,
					"content": "그럴 리가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100128
					],
					"speakerTitle": "사이카"
				},
				{
					"id": 120100128,
					"content": "말도 안 돼, 우리 아빠는 거짓말 안 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100129
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100129,
					"content": "너희들이 걱정돼서 그렇게 얘기한 거겠지. 멋대로 돌아다니면 위험하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100130,
					"content": "아니야, 아니라구! 「너구리 요괴」는 진짜 있다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100131
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100131,
					"content": "맞아, 요이미야 누나가 요괴를 쫓아내는 법을 알려주려고 무기까지 준비해 줬는걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100132
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100132,
					"content": "엥, 요이미야…? 요이미야 누나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100133,
					"content": "언니한테 「너구리 요괴」에 대한 얘기를 했더니, 무서워할 필요 없다면서 쫓아내는 방법을 알려준다고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100134
					],
					"speakerTitle": "사이카"
				},
				{
					"id": 120100134,
					"content": "그 뒤로 한참을 기다렸는데, 드디어 요이미야 누나가 오늘이 절호의 기회라고 해서 「너구리 요괴」를 찾으러 나온 거라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100135
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100135,
					"content": "맞아, 요이미야 누나는 항상 우리랑 놀아주고 재미있는 이야기도 해준단 말야. 누나가 거짓말할 리 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100136
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100136,
					"content": "그, 그치만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100137,
					"content": "흥, 우리 요이미야 누나한테 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100138
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100138,
					"content": "자, 잠깐, 기다려봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100139,
					"content": "에휴, 화나게 해 버렸네. 그치만, 난 아이들이 걱정돼서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100140,
					"content": "근데 여기서 요이미야 이름이 나올 줄은 몰랐네. 일단 따라가 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100123,
					"content": "아이들이 못 돌아다니게 겁주려고 지어낸 얘기겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100119,
					"content": "그런 요괴는 한 번도 본 적 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100120,
					"content": "아버지의 반응이 좀 이상한데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				}
			]
		},
		{
			"id": 1201002,
			"completionStepIds": [
				1201002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201002",
							"2"
						],
						"stepId": 1201002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"요이미야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100201,
					"content": "에구, 너무 속상해하지 마. 누나가 농담한 거야. 「너구리 요괴」가 없을 리 없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100202
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100202,
					"content": "그, 그치만, 「너구리 요괴」를 본 적 없는 건 사실인걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100203
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100203,
					"content": "「너구리 요괴」가 엄청 강한 요괴라서 그래. 그러니까 너희들이 필요한 거잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100204
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100204,
					"content": "응…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100205
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100205,
					"content": "초조해할 필요도, 실망할 필요도 없어. 멋진 히어로가 되려면 인내심과 지혜가 필요한 법이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100206
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100206,
					"content": "지금은 못 찾아도 불꽃축제가 시작되기 전에는 분명 나타날 거야. 그전에 우리 집에 와서 무기 챙겨가는 거 잊지 마, 알겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100207
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100207,
					"content": "요이미야 특제 폭죽을 터뜨리면, 그 대단한 「너구리 요괴」도 깜짝 놀라서 도망갈걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100208
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100208,
					"content": "집이랑 밭, 그리고 엄마 아빠 모두 이젠 너희들이 나서서 지킬 차례야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100209
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100209,
					"content": "알았어! 요이미야 누나가 그렇다면야, 좀 더 기다릴게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100210
					],
					"speakerTitle": "마츠자카"
				},
				{
					"id": 120100210,
					"content": "아, 맞다, 잠시만. 이 쪽지 하나씩 가져가. 집에 가서 엄마 아빠한테 드리고 잘 보관해 두시라고 말씀드려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100211
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100211,
					"content": "내가 줬다고 하면 무슨 뜻인지 아실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100212
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100212,
					"content": "알았어! 고마워, 요이미야 누나! 그럼 먼저 갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100213
					],
					"speakerTitle": "이와오"
				},
				{
					"id": 120100213,
					"content": "요이미야 언니, 고마워! 언니도 빨리 와서 우리랑 놀아주기다?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100214
					],
					"speakerTitle": "사이카"
				},
				{
					"id": 120100214,
					"content": "알았어, 조심해서 가! 이따 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100215
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100215,
					"content": "저, 저기…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100216,
						120100217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100216,
					"content": "오랜만이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				},
				{
					"id": 120100218,
					"content": "역시 너희들이었구나. 아이들 말 듣고 대충 짐작하고 있었어. 괜찮아, 너희 탓이 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100219
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100219,
					"content": "「너구리 요괴」는 아이들 사이에서 인기가 어마어마하거든. 그의 존재를 섣불리 부정해 버리면 당연히 애들이 실망하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100220
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100220,
					"content": "어쨌든 「너구리 요괴」는 실존하지 않는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100221,
					"content": "응, 처음 들었을 때부터 여기저기 돌아다니는 아이들을 겁주기 위해 어른들이 지어낸 이야기라는 걸 알고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100222
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100222,
					"content": "근데 아이들이 물어봤을 때, 난 사실을 말해주는 대신 「너구리 요괴」는 귀엽게 생긴 장난꾸러기지만 사람을 해치지는 않는다는 정도로만 말해줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100223
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100223,
					"content": "그들이 믿고 있는 너구리 요괴의 형상은 다 내가 지어낸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100224
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100224,
					"content": "네 아이디어였구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100225,
					"content": "하지만 아이들을 계속 속이는 건 옳지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100226
					]
				},
				{
					"id": 120100226,
					"content": "그럴 수도 있겠지. 하지만 그걸 밝히는 사람이 나일 필요는 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100227
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100227,
					"content": "밖에서 노는 아이들 걱정에 지어낸 얘기일 수도 있지만, 우리가 모르는 다른 이유가 있을 수도 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100228
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100228,
					"content": "그걸 전혀 모르는 상태에서 내가 섣불리 「너구리 요괴」 같은 건 없다고 얘기해 버리면 아이들이 상처 받을 수도 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100229
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100229,
					"content": "그리고 애들한텐 진짜인지 가짜인지보다 즐거운 게 더 중요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100230
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100230,
					"content": "나도 동경하는 것들이 있거든. 불을 붙이면 빙글빙글 돌면서 무지갯빛을 뿜어내는 「화염 다이아몬드」나 산속에 살면서 선경으로 가는 길을 안내해 주는 「안개 정령」 같은 거 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100231
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100231,
					"content": "실존하지 않는다는 걸 알면서도 믿고 싶은 거지. 근데 누가 나한테 「바보야, 그런 건 이 세상에 없어」라고 한다면ㅡ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100232
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100232,
					"content": "흥, 메롱이다. 여차하면 돌도 던질 거야! 짜증 나니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100233,
						120100235
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100233,
					"content": "무슨 느낌인지 알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100234
					]
				},
				{
					"id": 120100234,
					"content": "그치! 거짓말이면 어때, 멋있고 로맨틱하잖아. 다른 사람이 왈가왈부할 건 아니지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100237,
					"content": "어렸을 때 굳게 믿었던 것들과 직접 겪은 일들은 시간이 지나면서 무엇과도 바꿀 수 없는 보물이 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100238
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100238,
					"content": "너희도 어릴 땐 사악한 드래곤을 물리친 용사나 어둠을 베는 성검 같은 걸 믿었잖아? 똑같은 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100239
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100239,
					"content": "동화의 환상을 깨버리면 아이들한텐 무슨 얘길 해주게? 이나즈마가 지금 쇄국 상태라고? 아니면 「안수령」에 대한 일? 이런 건 너무 이르잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100240
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100240,
					"content": "으응… 맞아! 너무 일러!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100241,
						120100242
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100241,
					"content": "페이몬, 마지막 한 마디만 기억나는 거지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100243,
					"content": "하하, 이해 못 했어도 괜찮아. 어쨌든 걱정 마, 아이들은 내가 꼭 지켜줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100244
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100244,
					"content": "나도 슬슬 돌아가 봐야겠네. 「나가노하라 불꽃축제」가 코앞이라서 할 일이 태산이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100245
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100245,
					"content": "「나가노하라 불꽃축제」? 너희 집에서 주최하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100246
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100246,
					"content": "응, 우리 가문 이름이 들어갔으니까. 이나즈마에서는 꽤 유명한 행사야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100247
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100247,
					"content": "참, 혹시 지금 바빠? 시간 되면 같이 가자. 너희를 위해 엄청 예쁜 폭죽을 준비할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100248,
						120100249
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100248,
					"content": "예전부터 보고 싶었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100250,
					"content": "헤헤, 그럼 일단 우리 아버지 만나러 나가노하라로 가자! 축제 전까지 완성해야 될 폭죽이 몇 개 남아있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100249,
					"content": "그럼 사양하지 않을게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100242,
					"content": "맞춰주려고 무리할 필요 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100235,
					"content": "왠지 애 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100236
					]
				},
				{
					"id": 120100236,
					"content": "진짜든 가짜든 상관없으니까! 멋있고 로맨틱하면 된 거야. 다른 사람이 왈가왈부할 건 아니지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100217,
					"content": "또 만났네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				}
			]
		},
		{
			"id": 1201003,
			"completionStepIds": [
				1201003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201003",
							"2"
						],
						"stepId": 1201003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"나가노하라 류노스케"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100301,
					"content": "아버지, 저 왔어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100302
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100302,
					"content": "이제 곧 불꽃축제지? 사람들이 주문한 폭죽도 거의 준비됐을 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100303
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100303,
					"content": "처음 보는 얼굴이네, 새로 사귄 친구? 아니면 손님?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100304
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100304,
					"content": "둘 다요. 여기 온 지 얼마 안 됐거든요. 이나즈마에 왔는데 불꽃 구경을 안 해볼 순 없잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100305
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100305,
					"content": "하하하, 어찌 됐든 일단 좀 앉거라. 이 나가노하라 류노스케가 우리 가문의 유구한 역사에 관해 얘기해주마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100306
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100306,
					"content": "그건 좀 이따가요. 그전에 물어볼 게 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100307
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100307,
					"content": "먼 옛날…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100308
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100308,
					"content": "휴, 또 아버지 맘대로 이야길 시작하셨네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100309
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100309,
					"content": "미안, 아버지는 예전에 다친 뒤로 귀가 잘 안 들리셔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100310
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100310,
					"content": "근데 방금은 묘하게 아귀가 들어맞았는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100311,
					"content": "그 후로 오랜 세월이 흘러 사람들은 어떤 광석의 가루를 태우면 엄청 예쁜 색이 만들어진다는 걸 알게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100312
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100312,
					"content": "아버지, 잠깐만요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100313
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100313,
					"content": "어? 왜 그러니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100314
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100314,
					"content": "전에 주문했던 폭죽 재료 도착했어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100315
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100315,
					"content": "어제 제작한 폭죽은 다 보냈지. 그저께랑 그끄저께 것도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100316
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100316,
					"content": "아니, 아버지, 재료 말이에요. 전에 주문한 재료",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100317
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100317,
					"content": "오늘 것도 얼추 다 끝나가니 걱정 말거라. 아버지 솜씨 아직 녹슬지 않았으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100318
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100318,
					"content": "아니, 재료요! 폭죽 만들 때 사용하는 재료, 광석이요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100319
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100319,
					"content": "뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100320
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100320,
					"content": "광석 재료요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100321
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100321,
					"content": "아아, 광석 재료?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100322
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100322,
					"content": "그래 맞아, 광석 재료!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100323,
					"content": "아, 미안… 제대로 전달돼서 너무 기쁜 나머지 그만, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100324,
					"content": "재료라면 아직 안 왔다. 찾아와서 이유를 말하긴 했는데 제대로 못 들었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100325
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100325,
					"content": "괜찮아요. 그것만 알면 충분해요. 나중에 만들죠 뭐. 재료 도착하면 잘 받아만 두셔요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100326
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100326,
					"content": "그래, 걱정 말거라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100327
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 120100327,
					"content": "미안, 좀 시끄러웠지? 아버지한테 물어볼 일이 생기면 지금처럼 번거로울 때가 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100328,
						120100330
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100328,
					"content": "근데 되게 친절하신 거 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100329
					]
				},
				{
					"id": 120100329,
					"content": "헤헤, 그치? 좋은 분이라 모두에게 존경받고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100332,
					"content": "귀가 안 좋으셔서 다른 사람이랑 다투거나 다른 사람의 의견을 부정하지 않고 늘 허허 웃으면서 들어주실 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100333
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100333,
					"content": "어릴 땐 아버지가 날 굉장히 이해해 준다고 생각했어. 내가 하는 말이면 무조건 다 맞다고 하시니까 아무리 사소한 얘기도 다 들려드렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100334
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100334,
					"content": "나중에야 아버지가 싱글벙글 웃기만 하시는 게 귀가 잘 안 들리셔서라는 걸 알게 됐지만, 그래도 매일 아버지께 조잘거렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100335
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100335,
					"content": "음? 왜 그랬어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100336
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120100336,
					"content": "그냥, 아버지가 웃는 것만 봐도 기분이 좋더라. 그래야 아버지도 외롭지 않을 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100337
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100337,
					"content": "그나저나 불꽃축제가 코앞인데 재료가 아직 안 왔다니, 다른 방법을 생각해 봐야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100338
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100338,
					"content": "저기, 요이미야? 돌아왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100339
					],
					"speakerTitle": "사쿠지로"
				},
				{
					"id": 120100339,
					"content": "우악?! 깜짝아. 함부로 말하지 말라니까요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100340
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100340,
					"content": "미, 미안…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100341
					],
					"speakerTitle": "사쿠지로"
				},
				{
					"id": 120100341,
					"content": "잠시만요, 금방 갈게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120100330,
					"content": "요이미야랑 성격이 비슷하신 거 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100331
					]
				},
				{
					"id": 120100331,
					"content": "헤헤, 다들 그러더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "요이미야"
				}
			]
		},
		{
