					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040603
					]
				},
				{
					"id": 750040603,
					"content": "그럼… 봉인을 풀 테니 부디 조심하십시오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
