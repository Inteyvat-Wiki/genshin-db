				},
				{
					"id": 750040604,
					"content": "조금 더 준비하고 올게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750040605
					]
				},
				{
					"id": 750040605,
					"content": "네, 준비가 끝나면 언제든 말해주십시오…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티투"
				}
			]
		},
