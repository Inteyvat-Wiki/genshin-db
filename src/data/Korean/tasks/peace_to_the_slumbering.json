				{
					"id": 750040305,
					"content": "쉬익—그리고 벗어나, 벗어나——어째서 재앙을——떠나지 않는 거야——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750040306
					],
					"speakerTitle": "???"
