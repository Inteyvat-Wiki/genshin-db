					"speakerTitle": "아란판두"
				},
				{
					"id": 730141210,
					"content": "#하지만 이 문제를 먼저 해결해야 해. 나라{NICKNAME}, 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란판두"
				}
			]
		},
		{
			"id": 7301413,
			"completionStepIds": [],
