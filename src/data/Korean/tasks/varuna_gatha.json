			},
			"dialogs": [
				{
					"id": 730141301,
					"content": "#세 개의 잎을 가지 방향으로 돌리기만 하면 돼. 나라{NICKNAME}, 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란판두"
				}
			]
		},
		{
			"id": 7301415,
			"completionStepIds": [
				7301415
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301415",
							"2"
						],
						"stepId": 7301415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아란판두",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141501,
					"content": "#고마워 나라{NICKNAME}. 남은 건 아란판두한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141502
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141502,
					"content": "하지만 너무 오래돼서 성공할 수 있을지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141503
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141503,
					"content": "어?! 실패할 수도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141504,
					"content": "성공해 본 적은 있지만, 이번엔 성공할 수도, 실패할 수도 있어. 지난번과 그전에 태양이 떠올랐지만, 그다음에도 해가 뜨는지는 알 수 없는 것처럼 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141505,
					"content": "다음번에 해가 떠야만 페이몬은 「아. 해가 또 떴네」라고 말할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141506,
					"content": "흑흑… 너무 무서워… 만약 해가 뜨지 않으면 어떡하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141507,
					"content": "#페이몬 겁먹지 마. 나라{NICKNAME}(은)는 나라바루나처럼 태양 같은 금빛을 지닌 용감한 나라잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141508,
					"content": "#나라바루나는 우리에게 달과 해를 가져다줬어. 나라{NICKNAME}도 반드시 할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141509,
					"content": "#…응! 나도 믿어, {NICKNAME}. 어떤 어려움이 닥쳐와도 꼭 이겨낼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141510,
					"content": "걱정 말고 나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "하지만 지금은 나, 아란판두에게 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141512,
					"content": "와——성공한 거… 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141513,
					"content": "응. 이쪽의 가지와 잎은 이미 치료됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141514,
					"content": "잘됐다! 그런데 아란나라의 춤은 참 재밌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141515,
					"content": "페이몬도 아란나라에게 배워보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "괜찮은 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141517,
					"content": "페이몬의 식사량이라면, 운동을 많이 해야 하긴 하지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "#음음! {NICKNAME}(이)랑 같이 동분서주하는 걸로 이미 충분해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141519,
					"content": "하지만 이걸로 바루나 신기가 완전히 치료된 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141520,
					"content": "아직도 바나에 세 곳이 흩어져 있어. 아란바리카는 강하니까, 어쩌면… 하지만 아란나쿨라와 아란쿤티는 여전히 걱정이야. 이상한 비 때문에 바나가 더욱 위험해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141521,
					"content": "#나와 {NICKNAME}이(가) 가서 상황을 보고 올게. 바루나 신기를 수리하지 못하면 우리도 아무 걱정 없이 우트사바 축제를 준비할 수 없을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141522,
					"content": "#페이몬과 나라{NICKNAME}이(가) 도와줘서 바루나 신기는 금방 수리되고, 바나도 예전처럼 생기를 되찾을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141523,
					"content": "아란나쿨라는 <color=#00E1FFFF>야스나 유경</color>에 들어갔어. 바나의 깊은 곳에는 아란나라의 나라바루나에 대한 기념비가 있거든. 하지만 「버섯몬」과 「포자」 때문에 오랫동안 찾아가지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141524,
					"content": "아란나쿨라는 진흙, 씨앗과 같이 지내는 것에 익숙해졌고, 진흙에서 태어난 것에 대해선 훤히 꿰뚫고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141525,
					"content": "그를 찾아서 아란판두의 이름을 알려주면 더 이상 무서워하지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141526,
					"content": "오, 소심한 아란나라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141527,
					"content": "#아란바리카의 아란라칼라리는 아주 강해! 그… 그래도 페이몬과 나라{NICKNAME}이(가) 가서 한 번 살펴봐줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141528,
					"content": "#아란바리카는 쇠 냄새를 풍기는 <color=#00E1FFFF>다흐리의 폐허</color>에 있어… 페이몬과 나라{NICKNAME}, 조심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141529,
					"content": "응. 조심할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "아란쿤티는 <color=#00E1FFFF>꿈의 숲</color>에 있고, 그곳에는 꿈의 입구가 있어. 그는 나라와 더 멀어졌어, 만약 숨어버리면 우리의 음악을 연주해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141531,
					"content": "맞아, 예전에 아란나라의 악보를 받은 적이 있어. 만약 아란쿤티를 찾지 못하면 음악을 연주해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141532,
					"content": "아란판두는 「쉼터」에 먼저 가서 바나의 상황을 관찰하면서 기다릴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141533,
					"content": "아란나쿨라, 아란바리카, 아란쿤티는 다 알고 있어. 가지와 잎을 치료한 후 「쉼터」에서 모이자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141534,
					"content": "#금빛의 나라, 용감한 나라, 아란무후쿤다가 나라{NICKNAME}을(를) 돌봐주길",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141535,
					"content": "좋아! 우리한테 맡겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"아란판두"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "와! 방금 저쪽에 있던 거 뭐야?! 정말 멋있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141702,
					"content": "#나라{NICKNAME}와(과) 페이몬은 이제서야 알았구나. 저게 바로 바루나 법보야. 바루나 신기는 더 깊은, 뿌리처럼 깊숙한 곳에 존재해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141703,
					"content": "우리가 나라바루나를 너무 쉽게 생각한 것 같아. 이렇게 규모가 클 줄 몰랐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141704,
					"content": "만만찮은 힘이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "검은 비가 내리기 전, 나라바루나는 바나에 도착하지 않았었어. 아란무후쿤다와 초목의 왕은 바루나 신기를 창조했고, 비는 많은 것을 탄생시켰지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141706,
					"content": "검은 비와 검은색 진흙, 그리고 아주 많은 나쁜 것들이 바나를 아수라장으로 만들어 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141707,
					"content": "#{F#그}{M#그녀} 전에는 그토록 용감한 나라를 본 적이 없어. 햇빛이 잠든 안개를 몰아내듯, 아란나라와 함께 바루나 신기를 고쳐줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141708,
					"content": "나라바루나는 지금 바나라나에 없어. 아란무후쿤다도 바나라나에 없어… 하지만 아란나라는 다시 한번 바루나 신기를 수리해 줬어. 우트사바 축제를 위해, 바나를 위해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141709,
					"content": "우리는 예전에 아란자와 아란마와 함께 우트사바 축제를 준비하기로 약속했거든. 속담 중에 나라가 많아야, 땔감이 많고 그래야 불길이 더 세다고 했어. 맞지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141710,
					"content": "히익——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141711,
					"content": "아! 아니 아니, 내 말은 나라가 많아야 일이 더 쉬워진다는 거였어! 겁먹지 마. 불이랑 아무 상관도 없어! 전혀!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141712,
					"content": "페이몬. 이런 경우가 바로 「제 꾀에 제가 넘어간다」는 상황인 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "잉… 수메르에 온 만큼 나도 지식을 보여주려고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141714,
					"content": "#아란판두는 안 무서워, 페이몬은 착해. 나라{NICKNAME}(이)랑 나라바루나처럼 아란나라의 친구야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141715,
					"content": "아란나쿨라, 아란바리카, 아란쿤티와 아란판두는 바루나 신기를 수리하려는 거야. 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141716,
					"content": "「포자」와 「버섯몬」이 너무 많아서 할 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141717,
					"content": "아란판두한테는 아란바리카처럼 유능한 아란라칼라리가 없어. 「버섯몬」은 이상한 비 때문에 더 흉악해졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141718,
					"content": "잠깐, 「아란라칼라리」… 전에 아란나라가 이걸로 마라나를 막아 낼 수 있다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141719,
					"content": "아란라칼라리는 강해서 「버섯몬」을 쫓아버릴 수 있어. 하지만 아란판두의 아란라칼라리는 약해서 「버섯몬」에게 꼼짝 못 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141720,
					"content": "뭐? 아란라칼라리를 그렇게 사용할 수도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141721,
					"content": "아마 어떤 능력을 그렇게 부르는 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#나라{NICKNAME}이(가) 페이몬보다 똑똑해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141723,
					"content": "흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141724,
					"content": "아란나라들은 서로 다른 아란라칼라리를 갖고 있어. 하지만 모든 아란나라는 바나의 초목으로부터 아란라칼라리를 사용할 수 있는 능력을 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141725,
					"content": "아란바리카의 아란라칼라리는 아주 강해. 아주 큰 「버섯몬」도, 쇠의 어른 나라도 두려워하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141726,
					"content": "쇠의 어른 나라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141727,
					"content": "#쇠로 된 어른 나라는 아주 커, 나라{NICKNAME}처럼 두 개의 손, 두 개의 다리를 갖고 있지만 눈은 하나야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141728,
					"content": "아. 유적 가디언 말하는 거구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141729,
					"content": "페이몬 똑똑하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730141731,
					"content": "아! 저 나무에도 「버섯몬」이 있어… 아란바리카는 그들을 물리칠 수 있어, 하지만 아란판두는 안 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141732,
					"content": "#나라{NICKNAME}도 「버섯몬」을 무서워하지 않아. 비록 아란라칼라리를 사용한 건 아니지만 아주 강해. 바람이 나뭇잎을 쓸어내리듯이 슉——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141733,
					"content": "#이대로 내버려 두면 「포자」와 「버섯몬」이 점점 많아질 거야… 나라{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141734
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730141734,
					"content": "#우리한테 맡겨! 나라{NICKNAME}의 능력으로 반드시 「슉——」 해결할 거야! 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}