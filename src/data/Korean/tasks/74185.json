				]
			},
			"dialogs": [
				{
					"id": 741850101,
					"content": "에스테, 우리 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850102,
					"content": "오오, 너희 왔… 잠깐, 너흰 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850103,
					"content": "#응? 그새 우리를 잊어버린 거야? {NICKNAME}(이)랑 페이몬이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME}, 페이몬… 낯익긴 하지만 그건 꿈속에서 들은 이름인데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850105,
					"content": "엥, 그치만 그때 에스테는 깨어 있었는걸. 게다가 우린 물 아래에서도 만났었고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850106,
					"content": "후우… 마을 사람들이 전부 석상으로 변해 나만 마을에 덩그러니 남겨진 꿈을 꿨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850107,
					"content": "나중에 두 명의 용자가 나타나 모두를 구하는 임무를 맡았지…. 설마 그게 꿈이 아니었던 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850108,
					"content": "꿈일 수도 있고, 아닐 수도 있죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "맞아. 어쨌든 다들 정상으로 돌아왔잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850111,
					"content": "그런데 다들 이상한 꿈을 꿨나 봐. 대체 무슨 일이 있었던 거지? 집단 최면에 걸리기라도 했던 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850112,
					"content": "그걸 설명하려면 하루를 다 써도 모자랄 거야. 그러니까 최면 이야기는 나중에 하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850113,
					"content": "어라? 그러고 보니 너희들, 굉장히 영적으로 보이는 고양이를 데려왔네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850114,
					"content": "확실히 영적이긴 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "얘는 우리 동료야. 비록 같이 여행을 떠날 수는 없지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850118,
					"content": "마침 잘됐네. 우리 클럽에 고양이 집이 있는데, 최면술을 연구하던 친구가 고양이를 데리고 여행을 떠난 이후로 줄곧 비어 있는 상태거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850119,
					"content": "너희만 괜찮다면 이곳에 맡기는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850120,
					"content": "왠지 모르게 특별한 인연이 느껴져서 그래. 너희 대신 내가 잘 보살펴줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850121,
					"content": "고양이 집은 문 옆에 있어. 가보면 바로 보일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에스테"
				},
				{
					"id": 741850116,
					"content": "이 고양이는 우리 동료예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "그렇긴 한데, 이 녀석과 함께 여행을 떠날 수는 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850109,
					"content": "그건 중요하지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
