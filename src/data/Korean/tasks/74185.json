				]
			},
			"dialogs": [
				{
					"id": 741850301,
					"content": "헤헤, 「우스」! 앞으로 여기가 네 집이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850302,
					"content": "야옹?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "우스"
				},
				{
					"id": 741850303,
					"content": "근데 기분이 왠지 묘하네. 카시오도는 이제 여기에 없잖아. 그럼 지금의 「우스」는 대체 정체가 뭘까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850304,
					"content": "카시오도에게 빙의되지 않은 고양이일까, 아니면 우리와 모험했던 우스 씨인 걸까…? 으으, 너무 혼란스러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850305,
					"content": "그런 문제를 고민하는 건 페이몬한테 안 어울려",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "전혀 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850309,
					"content": "아무튼 우스에게 새로운 집도 찾아줬으니, 한가할 때 와서 놀아주면 되겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741850310,
					"content": "야아옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "우스"
				},
				{
					"id": 741850307,
					"content": "「우스」는 「우스」일 뿐이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "이해는 안 되지만 그 말이 맞는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
