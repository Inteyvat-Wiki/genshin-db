			"dialogs": [
				{
					"id": 740320401,
					"content": "우리 왔어! 의사가 이거 주래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740320402,
					"content": "레치레이드 씨가 건네받은 「순수의 물」을 단번에 들이켰다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "훨씬 나아진 기분이군! 활력이 돌아온 것 같구먼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "레치레이드"
				},
				{
					"id": 740320404,
					"content": "벌써요!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "효과가 너무 빠르잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740320408,
					"content": "아흐덴 선생은 역시 자격을 갖춘 의사라니까. 병을 제대로 고쳐주지. 이 늙은이와는 달라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "레치레이드"
				},
				{
					"id": 740320409,
					"content": "그럼 누리끼리한 돌은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740320410,
					"content": "아주 큰 문제일세!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "레치레이드"
				},
				{
					"id": 740320411,
					"content": "으… 두통은 해결된 것 같은데 다른 문제가 남았네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740320412,
					"content": "이제 계속 일할 수 있겠군. 이 늙은이 대신 다녀와 줘서 고맙네. 이 특별 허가 쿠폰은 내 작은 성의니까 받게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "레치레이드"
				},
				{
					"id": 740320413,
					"content": "항상 건강하길 바라마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레치레이드"
				},
				{
					"id": 740320406,
					"content": "애초에 병은 없었던 게 아닐까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320407
					]
				},
				{
					"id": 740320407,
					"content": "병은 진짜일세. 약도 진짜니까!",
					"roleType": "TALK_ROLE_NPC",
