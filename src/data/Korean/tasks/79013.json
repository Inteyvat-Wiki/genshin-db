					"nextDialogs": [
						790131102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790131102,
					"content": "#{NICKNAME}, 여긴 볼프강의 메모가 없는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790131103,
					"content": "아직 여기로 오지 않았다는 뜻이겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "그럼 우리가 먼저 밀실의 장치를 전부 처리해 두는 게 어때? 그럼 밀실에 갇히지 않을 거 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790131105,
					"content": "하지만 만약 반복적으로 발동되는 장치라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "그럼 어떡하지? 음, 그럼 메시지를 남기는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790131108,
					"content": "잘 보이는 곳에 장치를 푸는 방법을 메시지로 남겨두는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790131106,
					"content": "우리가 지금 푼다고 해도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
