					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#음, 이곳에 돌아오니 {REALNAME[ID(2)|SHOWHOST(true)]}이(가) 신이 난 것 같아. 뭔가 우리한테 하고 싶은 말이 있는 걸까나?",
