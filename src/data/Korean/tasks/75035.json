							7601.63
						],
						"pointId": 8838
					},
					{
						"sceneId": 3,
						"position": [
							-1325.08,
							140.986,
							7600.912
						],
						"pointId": 8840
					}
				]
			},
			"dialogs": [
				{
					"id": 750350401,
					"content": "어서 오세요! 보석을 가공하고 싶으신 거라면 제대로 찾아오셨어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350402
					],
					"speakerTitle": "이믹스"
				},
				{
					"id": 750350402,
					"content": "안녕, 이 보석을 가공해서 우리 꼬마 산룡에게 선물하려고 해. 자, 이 보석이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750350403,
					"content": "와! 정말 흔치 않은 보석이네요. 이 크기에, 이 정도의 투명도라니…. 다만 맞춤 제작하려면 제법 난이도가 있을 것 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350404
					],
					"speakerTitle": "이믹스"
				},
				{
					"id": 750350404,
					"content": "왠지 그다음에 나올 말이 예상되는데. 추가 요금을 받아야겠다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750350405,
					"content": "아, 아니에요! 제가 그런 말을 하는 사람처럼 보이시는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350406
					],
					"speakerTitle": "이믹스"
				},
				{
					"id": 750350406,
					"content": "이곳은 보석 세공 전문점이에요. 좋은 보석이 있다면 그것을 예쁘게 다듬어서 우리의 이름이 보석과 함께 널리 퍼지기를 바랄 뿐이죠. 그런 식으로 바가지를 씌우지는 않아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350407
					],
					"speakerTitle": "이믹스"
				},
				{
					"id": 750350407,
					"content": "다만 훌륭한 장인이 최고의 재료를 원하듯이, 남다른 보석에는 뛰어난 장인이 필요하죠. 마침 제가 「보석 세공의 달인」 한 분을 알고 있으니까 그분께 맡기면 되겠네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350408
					],
					"speakerTitle": "이믹스"
				},
				{
					"id": 750350408,
					"content": "정말이야? 그럼 그 「보석 세공의 달인」이라는 사람 좀 빨리 데려와 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750350409,
					"content": "아쉽게도 그분을 만나려면 미리 예약을 해야 해요. 예약이 없으면 그분은 영감을 수집하러 나가시거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350410
					],
					"speakerTitle": "이믹스"
				},
				{
					"id": 750350410,
					"content": "영감 수집?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350411
					]
				},
				{
					"id": 750350411,
					"content": "네, 쿠라호 사부님은 장인들 중에서도 아주 특별한 분이시거든요. 그분은 보석 장인이라면 단순히 도면대로 다듬는 것에 그쳐서는 안 되고, 자연의 아름다움을 관찰할 줄도 알아야 한다고 생각하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350412
					],
					"speakerTitle": "이믹스"
				},
				{
					"id": 750350412,
					"content": "예를 들면, 호수의 물결에서 광택 내는 기법을 배우고… 구름의 변화에서 문양 투각 기법을 배우는 거죠. 그분은 그런 걸 「영감 수집」이라고 하세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350413
					],
					"speakerTitle": "이믹스"
				},
				{
					"id": 750350413,
					"content": "으윽… 너무 복잡한 이야기야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750350414,
					"content": "혹시 급하시면 그분이 자주 돌아다니시는 곳을 알려드릴게요! 오늘은 이쪽으로 간다고 하셨어요. 제가 위치를 표시해 드릴게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이믹스"
				}
			]
		},
