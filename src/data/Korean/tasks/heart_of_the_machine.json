					"content": "꾸륵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020103
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020103,
					"content": "꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020104
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020104,
					"content": "이곳에서 멈췄어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020105,
					"content": "자세히 보면 여기 식물들은 확실히 조금 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020106
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020106,
					"content": "지맥 에너지도 다른 곳보다 훨씬 강해. 이곳이 우리가 찾던 곳 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020107
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020107,
					"content": "마음의 준비하고 가서 확인해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타이나리"
				}
			]
		},
