				"points": []
			},
			"dialogs": [
				{
					"id": 130020401,
					"content": "이건——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020402,
						130020403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020402,
					"content": "처음 보는 기계야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020404
					]
				},
				{
					"id": 130020404,
					"content": "지맥 에너지는 이곳에서 흘러나오고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020405
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020405,
					"content": "이 장치… 쉴 틈 없이 지맥을 뽑아내고 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020406
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020406,
					"content": "대체 누가 한 짓이지? 결과는 전혀 고려를 안 한 건가? 이렇게 지맥 활동을 파괴하면 자체 복구가 안 된단 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020407
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020407,
					"content": "이럴 수가… 당장 멈춰야겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020408,
					"content": "어디 보자… 음… 제어 장치를 못 찾겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020409,
					"content": "어지러워지기 시작했어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020410
					]
				},
				{
					"id": 130020410,
					"content": "여기 있으면 지맥 에너지로 샤워하는 거나 마찬가지야. 신체에 돌이킬 수 없는 손상을 입힐 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020411
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020411,
					"content": "#{NICKNAME}, 페이몬을 데리고 일단 나가. 난 이걸 어떻게 끌지 연구해 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020412
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020412,
					"content": "하지만… 아무리 너라고 해도 지맥의 영향을 안 받는 건 아니잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020413,
					"content": "우리도 남을게. 널 혼자 이곳에 둘 수 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020414,
					"content": "그럼 같이 찾자. 제어 장치가 안 보이는 거 보면 근처에 「숨겨진 문」이 있을 거야——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020415
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020415,
					"content": "꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020416
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020416,
					"content": "꾸륵! 꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020417
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020417,
					"content": "그 문이 어디 있는지 아는 거야? 이봐, 기다려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020403,
					"content": "느낌이 안 좋아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020404
					]
				}
			]
		},
