				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130020801,
					"content": "이것 좀 봐, 새 비디오테이프를 찾았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020802,
					"content": "날짜도 적혀있네! 어디 보자… 반년 전 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020803,
					"content": "시간이 많이 흘렀네. 그동안 무슨 일이 있었을까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020804
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020804,
					"content": "비디오테이프를 넣자 영사기에 과거의 화면들이 재생되기 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020805
					]
				},
				{
					"id": 130020805,
					"content": "이럴 수가, 너도 조작 실수로 고장이 나는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020806
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020806,
					"content": "커피 내리는 건 아직 어렵나 보네. 아니면 내가 설정한 값이 잘못된 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020807
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020807,
					"content": "꾸륵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020808
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020808,
					"content": "자, 다 고쳤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020809
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020809,
					"content": "꾸르륵?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020810
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020810,
					"content": "「집게」 부품에 물이 들어간 바람에 합선돼서 「뇌」에서 전달한 신호가 전해지지 않은 모양이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020811
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020811,
					"content": "내 정신 좀 봐, 이렇게 말해도 못 알아듣지? 괜찮아, 새로운 부품으로 바꿨으니 문제없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020812
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020812,
					"content": "어디 불편한 곳 없는지 한번 움직여볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020813
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020813,
					"content": "꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020814
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020814,
					"content": "다음에는 조심해! 이제 경비도 간당간당하거든. 비상용 부품이랑 에너지도 별로 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020815
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020815,
					"content": "꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020816
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020816,
					"content": "기분 좋아 보이네. 카르카타, 그거 알아? 어제 꿈을 꿨는데, 꿈에서 네가 말을 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020817
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020817,
					"content": "아카데미아에선 「기계 지능은 통계학의 연장선일 뿐이다」 같은 말이나 했잖아? 우리가 대화하는 걸 보더니 다들 놀라 자빠지더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020818
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020818,
					"content": "꾸르륵?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020819
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130020819,
					"content": "하지만 아쉽게도 꿈이었어. 아무 생각 없어 보이는 네 모습을 봐. 대화는커녕, 내가 없어져도 넌 아무렇지 않겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020820
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020820,
					"content": "됐어, 다음 달 에너지를 어떻게 해결할지나 생각해 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020821
					],
					"speakerTitle": "아바투이"
				},
				{
					"id": 130020821,
					"content": "영상은 여기서 끝이 난다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020822
					]
				},
				{
					"id": 130020822,
					"content": "아바투이는 아카데미아를 떠나고 나서 아무런 소식도 없이 사라졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020823
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020823,
					"content": "낙담해서 기계 생명체 연구를 멈췄을 줄 알았는데, 이곳에 숨어서 실험을 계속했을 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020824
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130020824,
					"content": "그래도 나쁜 사람 같지는 않던데, 카르카타의 고장 난 부품도 고쳐줬잖아. 왜 지맥을 건드릴 생각을 했을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020825
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130020825,
					"content": "그가 「에너지」에 대해 말한 걸 들었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020826
					]
				},
				{
					"id": 130020826,
					"content": "조금 더 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타이나리"
				}
			]
		},
		{
			"id": 1300209,
			"completionStepIds": [
				1300208
			],
