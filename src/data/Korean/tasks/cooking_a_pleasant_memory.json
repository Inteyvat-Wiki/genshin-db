			"dialogs": [
				{
					"id": 730190101,
					"content": "이슬 먹고 빨리 자라렴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190102,
					"content": "안녕! 너는 아…아란 뭐였더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190103,
					"content": "아란파카티의 오빠 맞지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "오, 순발력 좋았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190107,
					"content": "…얼른 자라서 맛있어지렴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190108,
					"content": "말이 전혀 안 통하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190105,
					"content": "아란사카",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "아란사카! 네가 아란사카야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
