			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190402,
					"content": "어, 안녕…. 뭐 필요한 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190403,
					"content": "응, 어떤 물건이 필요한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190404,
					"content": "하하, 다들 「어떤 물건」 때문에 나를 찾아와. 근데 그냥 「어떤 물건」이라고 하면 나도 「어떤 물건」인지 알 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190405,
					"content": "음… 알겠어. 어떻게 얘기해야 하지? 우리가 원하는 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190406,
					"content": "하얗고 네모난…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "하얗고 네모난?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190408,
					"content": "응, 꽉 쥐면 모래처럼 부서지고 단단한 거품 안에 들어 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190409,
					"content": "이상한 설명이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190410,
					"content": "그렇게만 얘기해서는 뭔지 모르겠는걸. 그 하얗고 네모난 물건은 어디 쓰이는 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190411,
					"content": "용도가 뭔지는 알고 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190412,
					"content": "먹는 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "먹을 수 있고, 하얗고 네모나다…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190416,
					"content": "아! 그래. 뭔지 알았다…. 하하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190417,
					"content": "왜 웃는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190418,
					"content": "하하하, 하얗고 네모나면서 꽉 쥐면 부스러지고… 먹을 수 있는 거라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190419,
					"content": "바로 「설탕」이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190420,
					"content": "단단한 거품이라면 설탕을 담은 유리병이겠지. 맙소사, 단단한 거품이라니. 하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190421,
					"content": "뭐야, 설탕이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190422,
					"content": "난감하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "웃겨서 눈물이 다 나오네. 요 몇 년간 장사 때문에 바빠서 마지막으로 이렇게 웃어본 게 언제였는지도 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190425,
					"content": "그러고 보니 옛날 일이 생각나네…. 어릴 때 친구가 설탕을 처음 맛보더니 재밌는 말을 했었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190426,
					"content": "「이 하얗고 네모난 거 너무 맛있어! 환상적이야! 신나는 맛이야」라며 무척 즐거워했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190427,
					"content": "하하… 오래전 일이지. 지금은 그 친구가 어떻게 생겼는지도 기억이 안 나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190428,
					"content": "아, 신나게 웃었으니 보답으로 설탕은 그냥 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190429,
					"content": "감사합니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "조심해. 단단한 거품이 아무리 단단해도 땅에 떨어지면 부서지니까. 「단단한 거품」… 하하하하하!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이아네시"
				},
				{
					"id": 730190423,
					"content": "민망하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "요리에 쓰여요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "요리에 쓰이고 하얗고 네모난 거라면 설마 조미료인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "이아네시"
				}
			]
		},
