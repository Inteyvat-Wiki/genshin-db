			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "앗! 나라다…. 키도 크고 너무 무서워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190202,
					"content": "제발… 따지 말아 줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190203,
					"content": "걱정하지 마. 안 건드려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190204,
					"content": "다행이다. 후후… 이 뚠뚠 복숭아들은 씨앗일 때부터 내가 정성 들여 하나하나 심은 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190205,
					"content": "아, 아니지. 너희 나라들은 나빠! 남이 심은 뚠뚠 복숭아에 함부로 손을 대다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190206,
					"content": "나라들은 왜, 왜 이런 나쁜 습관을 지니고 있는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190207,
					"content": "우린 아무것도 안 했어. 손도 안 댔다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190208,
					"content": "아무것도 안 했는데도 이렇게 무섭다니…. 정말 뭐라도 했으면 무서워서 기절했을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190209,
					"content": "이봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190210,
					"content": "아니야, 아란사카… 힘들게 심은 뚠뚠 복숭아랑 「요리 수행」을 생각해…. 여기서 물러서면 안 돼, 무서워하면 안 된다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190211,
					"content": "역시 네가 아란사카구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190212,
					"content": "너, 너희가 내 이름을 어떻게 알아? 어디서 온 나라들이길래…. 만나자마자 내 이름까지 알다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190213,
					"content": "네가 말했잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "말이 씨가 된다더니… 다 끝났어. 내 이름은 이제 무서운 저주에 사용되겠지…. 제발 살려줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190215,
					"content": "뚠뚠 복숭아를 달라는 것만 아니면 뭐든 다 들어줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190219,
					"content": "그렇게 긴장할 필요 없어. 우린 사실 아란파카티의 부탁으로 널 찾아온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190220,
					"content": "아, 아란파카티? 아, 숲속의 한 줄기 빛 같은 나의 사랑하는 「동생」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190221,
					"content": "아란사카에게 자초지종을 설명한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "이런, 우트사바 축제가 벌써 다가오다니…. 그럼 너희들은 이번 우트사바 축제에 참여하러 온 나라야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190223,
					"content": "아까 너희를 보고 나쁜 나라라고 해서 미안해. 착한 나라만 바나라나의 우트사바 축제에 참여할 수 있으니까, 너희는 분명 착한 나라일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190224,
					"content": "난 아직 「요리 수행」을 끝내지 못해서 바나라나로 돌아갈 수 없어…. 하지만 우트사바 축제는 반드시 참가해야 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190225,
					"content": "왜 더 초조해하는 거야…. 네가 심은 뚠뚠 복숭아가 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190226,
					"content": "…내, 내가 심은 뚠뚠 복숭아만으로는 부족하단 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190227,
					"content": "「신나는 맛」을 꼭 얻어야 해. 「신나는 맛」이 없으면 뚠뚠 복숭아는 그저 뚠뚠 복숭아일 뿐이라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190228,
					"content": "아란차토라, 아란파스, 아란팔라는 세상에 「신나는 맛」 같은 건 없다고 생각해. 하지만 내가 꼭 만들어서 보여줄 거야. 너희들도 맛보게 해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190229,
					"content": "「신나는 맛」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "헤헤, 난 「신나는 맛」을 먹어본 적 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190232,
					"content": "「신나는 맛」은 하얗고 만지면 부서져…. 그리고 흰색 바루카로 변하지. 하지만 바루카처럼 딱딱하고 아프진 않아. 단단한 거품 안에 들어 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190233,
					"content": "…흰색 바루카?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "흰색 바루카라면 하얀 모래를 말하는 거겠…지? 근데 단단한 거품은 뭐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190236,
					"content": "으, 모르겠다. 그 「신나는 맛」은 어디 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190237,
					"content": "그건 왜 물어봐? 설마 나한테서 「신나는 맛」을 빼앗아 가려고? 끔찍해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190238,
					"content": "널 도와주려는 건데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "날 도와줘? 뭘? 나 혼자서도 얻을 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190242,
					"content": "다만 거긴 나라들이 너무 많고, 그중에 한 명은 나라바루카의 냄새까지 풍겨서… 윽, 무서워…. 나라가 조금만 적었어도 나 혼자 할 수 있었을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190243,
					"content": "…휴, 그래. 나 혼자서는 절대 못 구해. 난… 간다르바 성곽에는 못 가겠어. 거긴 나라도 많고 전부 죽은 나무들뿐이라 너무 무서워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190244,
					"content": "간다르바 성곽에 사는 나라 친구가 한 명 있었는데, 시간이 너무 많이 흘러서 이젠 내 목소리를 못 듣더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190245,
					"content": "그렇구나, 그럼 네가 말한 「신나는 맛」은 간다르바 성곽에 있겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190246,
					"content": "「신나는 맛」은 땅에서 자라나는 게 아니라 나라가 만든 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190247,
					"content": "꼭 다시 한번 맛보고 싶어. 처음 먹었을 때의 황홀함이 아직도 생생해. 너무나 환상적인 맛이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190248,
					"content": "나랑 나라 친구는 숲속에서 함께 나뭇잎 사이로 떨어지는 햇살이 몇 개인지 세곤 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190249,
					"content": "우린 함께 노래하고, 함께 「신나는 맛」을 먹었어. 그래서 나뭇잎 사이로 비치는 햇살을 보면 친구가 떠오르고, 친구를 생각하면 「신나는 맛」이 떠올라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190250,
					"content": "난 아란파카티한테 그 맛을 보여주고 싶어. 우트사바 축제가 시작되면 나라한테도 그 맛을 보여줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190251,
					"content": "#좋아, 그럼 페이몬이랑 {NICKNAME}에게 맡겨! 맞지, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190252,
					"content": "나도 신나고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "정말? 날 속이는 거 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190255,
					"content": "절대 아냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190256,
					"content": "그보다 간다르바 성곽에는 사람이 너무 많잖아. 누구를 찾아가야 하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190257,
					"content": "그건 내가 알려줄게. 조금 전에 어떤 나라가 여기를 지나서 <color=#00E1FFFF>간다르바 성곽으로 가는 걸 봤어</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190258,
					"content": "등에 뭔가 커다란 걸 짊어지고 있었어. 나라가 뭔가 담을 때 쓰는 물건 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190259,
					"content": "등에 뭔가 커다란 걸 짊어지고 있다라… 음, <color=#00E1FFFF>배낭 아니면 보따리</color>겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190260,
					"content": "알겠어. 우리가 「신나는 맛」을 찾아올게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190253,
					"content": "아란파카티와 약속했으니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "와! 페이몬, 너 무섭다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "야! 난 그저 아란사카를 도와주려는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730190234,
					"content": "…단단한 거품?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "네가 말하는 「신나는 맛」은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "우린 진작 알고 있었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "뭐? 진작 알고 있었다고? 오래전부터 날 노려왔던 거야…. 설, 설마 나한테 원하는 게 있어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730190218,
					"content": "설마 뚠뚠 복숭아는 아니겠지? 아, 안 돼. 다른 건 다 줘도… 뚠뚠 복숭아는 절대 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "아란사카"
				}
			]
		},
