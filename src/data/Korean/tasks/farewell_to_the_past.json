						120410304
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410304,
					"content": "어? 이제 괜찮아? 조금 더 쉬어야 되는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410305,
					"content": "괜찮아. 많이 나아졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410306
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410306,
					"content": "솜씨가 아주 대단하던데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410307
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410307,
					"content": "마물들은 분명 다시 돌아올 겁니다. 그때는 수계 사냥개 정도가 아니겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410308
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410308,
					"content": "두 분은 빨리 쇼군님과 함께 이나즈마성으로 돌아가 대장님이 이끄는 군대와 합류하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410309
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410309,
					"content": "쇼군님이 무사히 돌아오신 걸 보면, 다들 사기가 하늘을 찌를 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410310
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410310,
					"content": "너희들은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410311,
					"content": "저희는 여기에 남아 마물이 더는 앞으로 가지 못하도록 막겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410312
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410312,
					"content": "다들 힘을 합치면 마물이 아무리 많아도 해치울 수 있을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410313
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410314,
						120410315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410314,
					"content": "(저들의 마음속 「현실」을 깨트릴 필요는 없어)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410316
					]
				},
				{
					"id": 120410316,
					"content": "저희에게 맡기세요! 전투는 익숙하니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410317
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410317,
					"content": "하지만 쇼군님은 특별하십니다. 쇼군님만이 이 절망적인 상황을 반전시킬 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410318
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410318,
					"content": "이나즈마가 어떤 위협에 직면하든, 저희는 영원히 쇼군님을 따를 것입니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410319
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410320
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410320,
					"content": "정말 고마워. 이나즈마의 밝은 미래를 너희들한테 약속하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410321
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410321,
					"content": "늦은 약속이지만, 적어도 지금부터 시작이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410322
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410322,
					"content": "걱정 마세요, 쇼군님. 쇼군님의 그 말만 있다면 저희는 절대 지지 않습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410323
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410323,
					"content": "쇼군님과 함께 이나즈마가 잃은 것들을 반드시 되찾을 겁니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410324
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410324,
					"content": "진리가 웅대하듯 번개 신 또한 영원하리!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410325
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410325,
					"content": "진리가 웅대하듯 번개 신 또한 영원하리!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410326
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410326,
					"content": "사라…졌네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410327,
						120410328
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410327,
					"content": "방금의 약속은 저들에게 한 건가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410329
					]
				},
				{
					"id": 120410329,
					"content": "둘 다야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410330
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410330,
					"content": "사람들의 희생은 날 고통스럽게 했어. 하지만 난 그들이 자신을 불태워 밝은 빛을 내는 모습을 외면했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410331
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410331,
					"content": "난 몇백 년 동안 그들의 의지를 저버린 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410332
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410332,
					"content": "「저들에게 말하는 건 아무런 의미가 없어. 저들은 지맥에 남아있는 기억일 뿐이니까」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410333
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410333,
					"content": "그렇다 해도 난 저들에게… 그리고 지금까지도 날 굳게 믿고 있는 백성들에게 말해주고 싶었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410334
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410334,
					"content": "그들의 마음이 지금이라도 응답을 받았으니 그래도 보답을 받았다고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410335
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410335,
					"content": "위로해 줘서 고마워. 하지만 이건 이나즈마의 신으로서 응당 해야 하는 일이야. 내가 너무 늦은 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410336
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410336,
					"content": "그 무사의 말처럼, 난 내가 한 명의 전사로서 감당해야 할 것만 감당하면 된다고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410337
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410337,
					"content": "하지만 이나즈마에 필요한 건 마코토 같은 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410338
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410338,
					"content": "나와 마코토는 완전히 다르고, 난 그녀가 될 수 없어. 하지만 내가 해야 하는 일은 마코토와 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410339
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410339,
					"content": "인간은 에이 씨의 신뢰를 받을 가치가 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410340
					]
				},
				{
					"id": 120410340,
					"content": "맞아. 인간은 강하고 강인하며, 자랑스러워할 만해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410341
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410341,
					"content": "모두가 존경하는 라이덴 쇼군이, 백성들의 발목을 잡을 순 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410342
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410342,
					"content": "오? 고민이 벌써 다 풀린 것 같네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410343
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410343,
					"content": "이나즈마는 새로운 변화와 가능성을 맞이할 거야. 하지만 아직 시간이 필요해. 「과거」가 우리에게 남긴 상처는 「미래」의 시간이 치유해 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410344
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410344,
					"content": "시간이 오래 걸린다 해도, 난 포기하지 않아. 이게 나의 약속이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410345
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410345,
					"content": "수계 사냥개를 처치했으니, 이 일은 어느 정도 해결했어. 지금 상황을 봐선, 저들은 큰 위협이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410346
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410346,
					"content": "남은 일은, 예를 들어 사건의 원인 규명이나, 뿌리 보호라든지, 그런 일은 텐료 봉행이나 야시로 봉행의 사람에게 맡기면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410347
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410347,
					"content": "응. 그럼 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410348
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410348,
					"content": "에이가 겉으론 침착해 보이지만, 속으로는 심란하겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410349
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410349,
					"content": "왠지 그동안 많이 변한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410350
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410350,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410351
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410351,
					"content": "에이, 왜 그래? 빨리 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410352
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410352,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410353
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410353,
					"content": "에이 씨!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410354
					]
				},
				{
					"id": 120410354,
					"content": "왜 그래? 또 어디 아파?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410355
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410355,
					"content": "몸이… 안 움직여져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410356
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410356,
					"content": "상태가 생각보다 심각한 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410357,
						120410358
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410357,
					"content": "조금 쉴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410359
					]
				},
				{
					"id": 120410359,
					"content": "아니, 「그녀」가 날 부르고 있어. 지금이 가장 좋은 기회야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410360
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410360,
					"content": "#{NICKNAME}, 나 좀 부축해 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410361
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410361,
					"content": "나루카미 다이샤 아래의 동굴로 갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410362
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410362,
					"content": "동굴? 거기에 뭐가 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410363
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410363,
					"content": "그곳은… 과거를 베어내고 미래로 나아갈 수 있는 전장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410358,
					"content": "일단 이나즈마성으로 돌아가요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410359
					]
				},
				{
					"id": 120410328,
					"content": "아니면 자신에게 한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410329
					]
				},
				{
					"id": 120410315,
					"content": "그럼 부탁할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410316
					]
				}
			]
		},
