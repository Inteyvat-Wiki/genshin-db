			"dialogs": [
				{
					"id": 120410701,
					"content": "지금 우리 내쫓긴 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410702,
					"content": "이제 어떡해? 진짜로 에이랑 쇼군이 안에서 계속 싸우게 둘 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410703,
					"content": "에이의 말은 일리가 있지만, 이렇게 해야만 쇼군의 작동 법칙을 바꿀 수 있다고 해도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410704,
						120410705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410704,
					"content": "에이는 몸이 없어. 쇼군이 있어야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410706
					]
				},
				{
					"id": 120410706,
					"content": "그렇지? 그리고 에이는 너무 고집스러워서 사지로 들어가기 쉬워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410707,
					"content": "승부에 너무 집착해서 초심을 잃는다면… 다시는 나오지 못할지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410708,
						120410709
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410708,
					"content": "지금 떠나기엔 너무 일러",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410710
					]
				},
				{
					"id": 120410710,
					"content": "응! 전처럼 빨리 시험을 돌파할 수 있게 에이를 도와줘야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410711
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410711,
					"content": "안에 있는 시간을 단축하거나, 이길 수 있게 직접 도와주는 방법은 없을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410712
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410712,
					"content": "음…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410713
					]
				},
				{
					"id": 120410713,
					"content": "에이가 안에서 잘못되면 안 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410714
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410714,
					"content": "하지만 그곳은 이제 우리의 입장을 허락하지 않는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410715
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410715,
					"content": "도와주려면 먼저 안에 들어가야 하는데. 어떡하지, 어떡하지? 부딪혀볼까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410716
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410716,
					"content": "야에 미코 씨를 찾아가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410717
					]
				},
				{
					"id": 120410717,
					"content": "아! 미코가 있었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410718
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410718,
					"content": "이상한 공간에 대해 얼마나 아는지 모르지만… 다른 선택지가 없으니까. 아—— 가자, 산으로!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410709,
					"content": "우리 일이 아직 안 끝났잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410710
					]
				},
				{
					"id": 120410705,
					"content": "하지만 이 방법밖에 없는 건 아닐거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410706
					]
				}
			]
