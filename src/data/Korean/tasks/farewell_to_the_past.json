			},
			"dialogs": [
				{
					"id": 120410201,
					"content": "에이, 아니면 우리한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410202,
						120410203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410202,
					"content": "상태가 안 좋은 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410204
					]
				},
				{
					"id": 120410204,
					"content": "난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410205
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410205,
					"content": "미안하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410206
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410206,
					"content": "괜찮아. 에이는 일단 잠시 쉬면서 체력을 회복하고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410207,
					"content": "마물은 우리가 상대할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410208,
					"content": "어… 또 빛이 나네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410209,
						120410210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410209,
					"content": "곧 올 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410211
					]
				},
				{
					"id": 120410211,
					"content": "여, 여기는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410212
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410212,
					"content": "당신들은… 앗, 쇼군님도 여기 계셨군요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410213
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410213,
					"content": "쇼군님, 괜찮으십니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410214
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410214,
					"content": "윽… 난 괜찮아. 몸이 조금 굳은 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410215
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410215,
					"content": "마지막 순간까지 쇼군님과 함께하겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410216
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410216,
					"content": "마물들이 또 몰려오고 있다! 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410217
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410217,
					"content": "안 돼. 너무 위험해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410218
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120410218,
					"content": "이건 우리가 해야 될 일입니다! 위험을 두려워했다면 애초에 무기를 들지 않았을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410219
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410219,
					"content": "걱정하지 마세요, 쇼군님. 이런 때에야말로 신이 저희에게 하사하신 힘에 더 큰 의미가 생깁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410220
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410220,
					"content": "저건, 신의 눈?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410221,
					"content": "맞습니다. 전지전능하신 신께서 힘을 인간에게 하사하신 건 분명 우리에게 큰 기대를 걸고 있다는 뜻이라 생각합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410222
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410222,
					"content": "지금 쇼군님이 곤경에 빠지셨으니, 저희가 약속을 지킬 차례입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410223
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410223,
					"content": "당시의 무인은 신의 눈을 그렇게 생각했구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410224,
						120410225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410224,
					"content": "희망으로 가득 차 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410226
					]
				},
				{
					"id": 120410226,
					"content": "다들 쇼군님이 어디로 가셨는지 몰라서 절망했지만, 지금 찾았습니다. 쇼군님은 바로 이곳에 계십니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410227
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410227,
					"content": "쇼군님만 계신다면, 우리의 희망은 다시 타오를 것이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410228
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410228,
					"content": "그 희망은 어둠을 뚫고 나아가는 빛이 될 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410229
					],
					"speakerTitle": "후카미"
				},
				{
					"id": 120410229,
					"content": "다들! 날 따르라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410230
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410230,
					"content": "우리도 싸울 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120410231,
					"content": "윽…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120410232
					],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410232,
					"content": "알겠습니다. 꼭 자신을 잘 보호하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후지키"
				},
				{
					"id": 120410225,
					"content": "투쟁의 마음은 흔들린 적이 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410226
					]
				},
				{
					"id": 120410210,
					"content": "이번엔 뭘까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410211
					]
				},
				{
					"id": 120410203,
					"content": "무리하시면 안 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120410204
					]
				}
			]
		},
