				"points": []
			},
			"dialogs": [
				{
					"id": 120040101,
					"content": "음, 이제 뭘 해야 할까…. 무슨 계획 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040102,
					"content": "여행자님, 페이몬 님, 잠깐만 기다려주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040103
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040103,
					"content": "응? 아야카?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040104,
					"content": "무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040105
					]
				},
				{
					"id": 120040105,
					"content": "부탁드리고 싶은 게 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040106
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040106,
					"content": "걱정하실 필요 없답니다. 야시로 봉행이나 카미사토 가문의 부탁이 아닌, 제 개인적인 부탁이거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040107
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040107,
					"content": "개인적인 부탁? 사적인 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040108,
					"content": "네, 제 어머니에 관한 일이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040109
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040109,
					"content": "좀 갑작스러우시겠지만… 이 일은 당신에게만 부탁할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040110
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040110,
					"content": "자세히 말해줄래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040111
					]
				},
				{
					"id": 120040111,
					"content": "며칠 전, 오래된 물건들 속에서 어머니가 남기신 노트를 한 권 찾았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040112
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040112,
					"content": "여러 가지 일들이 적혀 있었는데, 거기서 제가 한 번도 들어본 적 없는 이름을 발견했죠. 게다가 아주 많이 적혀 있어서 자꾸 신경이 쓰여요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040113
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040113,
					"content": "어머니의 친구 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040114,
					"content": "너도 들어본 적 없는 이름이라고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040115
					]
				},
				{
					"id": 120040115,
					"content": "네. 부모님이 돌아가신 지 몇 년이나 지났지만, 부모님 지인들은 저와 오빠가 거의 다 알고 있거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040116
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040116,
					"content": "그래서… 이분이 누군지 너무 궁금하고, 꼭 한번 만나보고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040117
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040117,
					"content": "그분의 이름은 「츠바키」라고 적혀 있었는데, 어머니가 아주 소중하게 생각하셨던 분 같아요. 개성 넘치고 재밌는 분 같더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040118
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040118,
					"content": "여자 이름 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040119,
					"content": "네, 그분을 만나고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040120
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040120,
					"content": "그럼 우리가 뭘 도와주면 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040121,
					"content": "그 사람을 찾아주면 되는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040122,
					"content": "아니요, 노트에 그분의 주소가 적혀있어서 바로 찾아가면 돼요. 제가 여행자님께 의뢰를 드린 건… 인사 선물 때문이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040123
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040123,
					"content": "그리고 방금 말한 건 다 비밀로 해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040124
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040124,
					"content": "이런 일은 원래 오빠와 해결해야 하지만, 지금 오빠가 너무 바쁜 데다가… 다른 현지인분들을 이 일에 연루시키고 싶지도 않아서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040125
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040125,
					"content": "그래서 이방인이 필요한 거구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040126
					]
				},
				{
					"id": 120040126,
					"content": "맞아요. 당신은 예의 바르고 배려심 넘치는 데다, 아주 믿음직스러워서 당신과 함께라면 안심할 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040127
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040127,
					"content": "응응! 선물 준비라면 우리가 도와줄 수 있어. 보수는… 맛있는 거 사주면 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040128,
					"content": "좋아요. 이 기회에 두 분과 함께 여기저기 둘러보려고 했는데, 괜찮다면 저랑 같이 가요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040129
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040129,
					"content": "#완전 콜이지! {NICKNAME}, 그치?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120040130,
					"content": "응",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040131
					]
				},
				{
					"id": 120040131,
					"content": "감사합니다! 그럼 바로 출발할까요? 먼저 오구라의 가게로 가죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040132
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120040132,
					"content": "좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}