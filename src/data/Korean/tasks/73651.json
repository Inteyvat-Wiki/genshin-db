	"talks": [
		{
			"id": 7365101,
			"completionStepIds": [
				7365101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7365101",
							"2"
						],
						"stepId": 7365101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하자나드",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736510101,
					"content": "헤헤헤, 하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510102
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510102,
					"content": "드디어 완성! 이제 입증하는 단계만 남았다! 이게 바로 연금용 포션의 최강 형태라는 걸 모두에게 증명할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510103
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510103,
					"content": "…저 사람은 왜 벼랑 끝에 서서 바보같이 킥킥거리지? 혼자서 중얼대기까지 하고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510104,
					"content": "#소름 끼쳐. {NICKNAME}, 우리 저 이상한 사람한테 가까이 가지 말자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510105,
						736510106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510105,
					"content": "만약 고민이 있는 사람이라면?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510107
					]
				},
				{
					"id": 736510107,
					"content": "야, 다른 사람을 너무 걱정하는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510108,
					"content": "응? 너희들 언제 나타난 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510109
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510109,
					"content": "뒤에서 수군대기나 하고, 너무 실례잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510110
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510110,
					"content": "난 스판타마드 학부의 유망주 하자나드라고! 나중에 내가 유명한 학자가 되면 너희를 해코지하는 글을 쓸 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510111
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510111,
					"content": "너 정말 사납구나! 이름도 발음하기 어려워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510112,
					"content": "잠깐? 너 설마… 기담에 나왔던 「날아다니는 하얀색 스마트 도우미 단말기」야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510113
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510113,
					"content": "뭐 그런 기담이 다 있어, 그런 별명 처음 듣거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510114,
					"content": "아무튼 「날아다니는 하얀색 스마트 도우미 단말기」를 데리고 다니는 금발 이방인이라… 틀림없어. 운이 좋네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510115
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510115,
					"content": "크흠! 들어봐. 나는 전투를 해야하는 사람을 더 강하게 만들어 줄 수 있어. 나랑 거래하는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510116,
						736510117
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510116,
					"content": "익숙한 전개…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510118
					]
				},
				{
					"id": 736510118,
					"content": "이상하게 생각할 거 없어. 티바트 곳곳에는 연금술의 최고 가치를 발굴하기 위해 힘쓰는 나 같은 연금술사가 꽤 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510119
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510119,
					"content": "전투를 보조하는 건 연금술의 중요한 기능이야. 포션의 효과를 극대화할 수 있다면 전투의 규칙을 새로 쓸 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510120
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510120,
					"content": "너희 정도의 견문이라면, 분명 다른 포션을 연구하는 연금술사를 만난 적 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510121
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510121,
					"content": "하지만 나에 비하면 대부분의 다른 연금술사들은 입문 수준이고, 진전이 있는 사람은 아주 소수일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510122
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510122,
					"content": "예를 들면, 몬드의 한 연금술사가 「분사식 액체 포션의 광역 살포에 의한 전투 환경의 변화」라는 연구 논문을 발표했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510123
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510123,
					"content": "너무 유치해! 보조성 휘발 성분을 첨가한다고 해도, 포션을 살포하는 속도와 농도는 규격에 맞출 수 없다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510124
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510124,
					"content": "갑자기 청산유수가 됐네. 자기가 이 분야의 최고라는 걸 증명하고 싶나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510125,
					"content": "그래서 거래 내용은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510126
					]
				},
				{
					"id": 736510126,
					"content": "그래, 하자나드. 더 강력한 포션을 만들어서 우리한테 특가로 팔 생각이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510127,
					"content": "좋은 질문이야! 마침 내 최신 연구 성과를 보여주려던 참이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510128
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510128,
					"content": "난 두 종류의 고농도 포션을 조각 형태의 결정으로 만들었어. 그리고 그걸 여러 개의 작은 조각으로 나누어서 고압으로 밀봉된 연금 장치에 넣었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510129
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510129,
					"content": "포션을 사용하려면 장치 내부에 있는 소형 폭약에 불을 붙이면 돼. 그럼 두 개의 포션의 일부가 순식간에 기체로 변해서 충분히 혼합되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510130
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510130,
					"content": "그다음 폭발의 압력으로 포션의 증기를 장치 밖으로 분출하면, 증기가 넓은 공간에 퍼지면서 전투를 도울 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510131
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510131,
					"content": "나는 이 과정을 「재용해 효과」, 장치를 「재용해 장치」, 포션을 「재용해 약제」라고 불러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510132
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510132,
					"content": "재…용해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510133,
					"content": "폭…폭발?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510134
					]
				},
				{
					"id": 736510134,
					"content": "강력한 폭발이 끝나면 공기는 상쾌한 향기로 가득 차고, 그에 따라 사용자의 힘도 급속히 증가하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510135
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510135,
					"content": "어때? 매력적이지? 해보고 싶지 않아? 전투 중에 포션의 효과를 잘 살피고 몇 가지 세부적인 성능만 기록해 주면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510136
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510136,
					"content": "물론 공짜는 아니고, 꽤 괜찮은 보수가 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510137
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510137,
					"content": "그저 우리를 실험 대상으로 삼을 생각뿐이구나? 위험할 것 같으니까 사양할래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510138,
					"content": "사고가 날 경우, 보수의 천 배에 달하는 배상을 한다면 한번 생각해 볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510139,
					"content": "문제없어, 어차피 이미 여러 번 실험했는걸. 내 장치는 100% 안전해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510140
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510140,
					"content": "너무 쉽게 받아들이는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510141,
						736510142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510141,
					"content": "우리도 모라가 부족한 건 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510143
					]
				},
				{
					"id": 736510143,
					"content": "음… 하긴, 기담 간행물에 이름을 올릴 정도의 사람이라면 모라가 넘쳐나겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510144
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510144,
					"content": "그럼… 그럼… 부탁할게, 제발 도와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510145
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510145,
					"content": "지금까지 너희한테 사납게 굴고, 또 푼돈으로 매수하려고 해서 정말 미안해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510146
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510146,
					"content": "내 실험을 완성하는 걸 도와준다면 너희를 큰 은인으로 모실게! 내가 유명한 학자가 돼도 절대 푸대접하지 않을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510147
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510147,
					"content": "와! 갑자기 태도가 바뀌었어. 이런 약속까지 하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510148
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510148,
					"content": "기회주의자네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510149
					]
				},
				{
					"id": 736510149,
					"content": "결국 내가 도움을 요청하는 상황인데, 남에게 빌붙어야 할 땐 올바른 태도를 보여야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510150
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510150,
					"content": "이런 모습 꼴 보기 싫다는 건 나도 알지만, 분명 앞으로 나 같은 사람을 또 만나게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510151
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510151,
					"content": "적어도 나는 보상이랑 약속은 했잖아. 세상에는 빈손으로 부탁하는 날강도도 있다고. 나 정도면 솔직히 꽤 성실한 편이지 않니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510152
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510152,
					"content": "음, 다른 사람의 속내를 멋대로 추측하는 건 예의가 아니지만, 겁주려고 하는 말은 아닌 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510153
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510153,
					"content": "페이몬 마음이 약해졌네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510154
					]
				},
				{
					"id": 736510154,
					"content": "여기까지 말이 나온 김에, 연금용 포션이 얼마나 대단한지 한번 보고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510155
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510155,
					"content": "게다가, 하자나드도 나쁜 의도는 없어 보여. 그저 연구 때문에 마음이 급해서 조금 이상하게 보였던 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510156,
					"content": "연구를 마치면 괜찮은 사람으로 변할지도 모르지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510157
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510157,
					"content": "오? 어떻게 장치를 테스트할지 상의하고 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510158
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510158,
					"content": "근처에 마침 비경이 하나 있는데, 다른 모험가들의 보고에 따르면 이번 전투 테스트에 적합할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510159
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510159,
					"content": "정말 천연덕스럽네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510160
					]
				},
				{
					"id": 736510160,
					"content": "내 미래는 모두 너희에게 맡겼어. 그냥 쿨하게 승낙해 주라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510161
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510161,
					"content": "음… 어차피 일반적인 모험 의뢰랑 다를 바 없으니까 우리가 맡지 뭐. 비경에 가서 이 장치를 테스트해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736510162
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736510162,
					"content": "좋아, 약속! 그럼, 난 여기서 좋은 소식을 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하자나드"
				},
				{
					"id": 736510142,
					"content": "연금술이 없어도 강해질 수 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510143
					]
				},
				{
					"id": 736510117,
					"content": "이런 얘기 어디서 들어 본 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510118
					]
				},
				{
					"id": 736510106,
					"content": "충동적으로 행동할 수도 있으니까 막아야지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736510107
					]
				}
			]
		}
	]
}