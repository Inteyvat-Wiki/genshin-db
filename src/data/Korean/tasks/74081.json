						],
						"pointId": 6386
					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "앗, 설마… 우리 큰 사고를 친 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811702,
					"content": "이상하네요. 방금 심하게 흔들린 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811703,
					"content": "저도 느꼈어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "으아, 우리가 위층에 있는 장치를 건드린 탓일지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811706,
					"content": "어라? 문을 잠그고 문지기용 태엽 장치도 뒀었던 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811707,
					"content": "잠깐 쉬게 하고 문을 열었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "어, 어쩔 수 없었다고! 그 녀석들이 먼저 공격했으니까 정당방위 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811710,
					"content": "마이아르데 선배의 실험 기계가… 작동했을 리가 없을 텐데요. 선배는 에리니에스섬에 적당한 실험 장소를 찾은 이후엔 거의 돌아오지 않으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811711,
					"content": "그도 그럴게 정원 무도회장같이 풍경이 아름다운 곳에서 사람들에게 연구 결과까지 선보일 수 있는데, 이런 음습하고 허름한 연구실에 돌아오고 싶을 리 없잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811712,
					"content": "보쉬에 씨가 사임하신 이후 다들 이곳의 자료처럼 폰타인 과학원의 곳곳에 흩어졌어요. 소파 하나조차 남지 않았죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811713,
					"content": "실험 기계만 이곳에 남아서 돌아오지 않을 사람들을 기다리고 있었어요. 그런데 가만히 이곳에 서서 대기하던 기계들이 어떻게 됐는지 보시라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811714,
					"content": "태엽이 금방이라도 튀어나올 것처럼 엉망이 되어버렸잖아요. 만약 이 일이 마이아르데 선배 귀에 들어가면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811715,
					"content": "제가 한 거예요. 죄송합니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "미, 미안해…. 이거 비싼 거야? 물어내라고 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811719,
					"content": "안심하세요. 마이아르데 선배가 이 일을 알면 분명 웃었을 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811720,
					"content": "선배는 늘 실험 기계의 춤을 방해하려다 녀석들에게 당하곤 제자리에 앉아 큰 소리로 웃던 사람인걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811721,
					"content": "참, 아직 자기소개도 안 했네요. 전 폰타인 과학원의 연구원인 세비녜예요. 두 분은요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811722,
					"content": "#이쪽은 {NICKNAME}, 난 페이몬이야. 우리는… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811723,
					"content": "절대 다른 목적은 없고 그냥 지나가던 길이었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "맞아! 지나가던 길이었어. 이곳에 보물이 있다고 생각해서 왔을 리가 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811726,
					"content": "보물찾기 코너가 추가된 폐허 관광을 하시려고요? 하지만 아쉽게도 이곳은 겉보기엔 폐허지만… 아니, 실제로도 폐허긴 한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811727,
					"content": "폐허 관광 추천 장소로 뽑힌 적이 없답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811728,
					"content": "그래? 그럼 우린 이만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811729,
					"content": "…잠깐만요. 혹시 신 폰타인 과학원을 아시나요? 가실 거면 저 대신 신 폰타인 과학원에 가서 쉬세레이 선배를 찾아주실 수 있나요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811730,
					"content": "신 폰타인 과학원으로 가지 않을 건데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "이걸 어쩌죠…? 할 일은 많은데 마이아르데 선배의 실험 기계가 고장 났으니 빨리 회수해 가라고 알려줘야 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811733,
					"content": "#으으… {NICKNAME}, 우리가 도와주자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811734,
					"content": "소식을 전달해 주신다니 정말 다행이에요! 그럼 천공 테이프를 회수하는 일도 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811735,
					"content": "밖의 장치를 건드리지 말 걸 그랬네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "어려운 일도 아닌데 너무 그러지 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811737,
					"content": "연구 자료를 회수해 주신다는 핑계가 생겼으니 의뢰비는 윗선에 비용을 청구할 수 있겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811738,
					"content": "뭐? 그래도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811739,
					"content": "연구를 도와주시는 건 사실이니까 당연하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811740,
					"content": "만약 규정에 어긋나면 사무원 측에서 기각하겠죠. 그땐 제가 의뢰비를 부담하면 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811741,
					"content": "연구원들은 자주 이런 일을 하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "적어도 전 안 그래요. 다른 사람은 잘 모르겠네요. 관련해서 이야기를 들은 게 있지만… 음, 외부인에게 말할 만한 정보는 아니에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811743,
					"content": "천공 테이프 세 개를 회수해야 해요. 책장에는 세 개밖에 없을 테니까 금방 찾을 수 있을 거예요. 그럼 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811744,
					"content": "그동안 전 실험 기계를 확인해야겠네요. 오랜 시간 유지 보수를 하지 않아서… 폭주라도 하면 곤란하거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811745,
					"content": "알겠어. 그럼 천공 테이프를 회수하면 확인받으러 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740811736,
					"content": "네, 제게 맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "다른 보물을 찾으러 가야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "혹시 이곳에 보물이 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "실험 기계의 강도를 업그레이드하는 건 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "마이아르데 선배가 했었어요. 완성품은 당신의 기대에 부응할지도 모르겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "세비녜"
				},
				{
					"id": 740811708,
