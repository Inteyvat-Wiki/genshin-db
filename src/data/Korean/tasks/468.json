				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"터너"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "손님, 어서 오세요. 혹시 제 아들이 편지 같은 걸 보내지 않았나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680601,
					"content": "당신은?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "저요? 와이너리 친구들은 저를 터너라고 부르지요. 이 다운 와이너리의 농부입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680603,
					"content": "우리는 대대손손 여기서 경작을 하며 살아왔죠. 만약 여기서 와인을 마셔봤다면 80%~90%는 제 손을 거쳐간 거라고 장담할 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680604,
					"content": "그래서 역대 와이너리 오너들은 우리를 후하게 대접해주고 있지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680605,
					"content": "근데… 자손들도 평생 농사를 지어야 한다고 생각하니까…그건 또 별로라서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680701,
					"content": "당신의 아드님은?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "가이! 제 아들은 가이이라고 합니다, 아주 귀한 아들이죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680703,
					"content": "뭐라구요? 들어본 적이 없다고요? 괜찮습니다, 몬드에서 그 아이를 모르는 사람은 없으니, 당신도 언젠간 알게 되겠죠, 하하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680704,
					"content": "분명 몬드성에서 가장 뛰어난 페보니우스 기사가 될 거예요. 스스로 장담했으니 분명히 그렇게 될 거라 믿고 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680705,
					"content": "휴, 제 뒤를 이어 이 밭에서 농사나 짓게 할 수 없어서 어릴 때부터 아낌없이 지원했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680706,
					"content": "그래도 재능이 있어서 16살에 견습 기사가 되었지 뭔가요, 아들놈만 믿고 있으면 우리도 신분 상승을 할 수 있을 수도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680801,
					"content": "안녕",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "다음에 봐요, 만약 제 아들 가이를 보게 된다면 시간 날 때 집에 들르라고 좀 전해주세요~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "터너"
				}
			]
		},
