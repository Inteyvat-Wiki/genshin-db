					"터너"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680301,
					"content": "전 다른 일이 있어서 이만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "그렇군요, 그럼 어쩔 수 없이 아들이 휴가로 돌아올 때까지 기다려야겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "터너"
				}
			]
		},
		{
			"id": 46804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46802",
							"3"
						],
						"stepId": 46802,
						"stateName": "QUEST_STATE_FINISHED"
