			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "혹시 도움 필요하신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "당신은…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680203,
					"content": "…여행자구나, 참 착하기도 하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680204,
					"content": "지금이 포도 농사에서 가장 중요한 시기인데… 갑자기 멧돼지 떼가 나타나서 다 망치고 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680205,
					"content": "아들도 곁에 없어서 혼자 쫓아내지도 못하고… 그냥 두 눈 뜨고 멧돼지들이 날뛰는 걸 두고 볼 수밖에 없다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "터너"
				},
				{
					"id": 4680206,
					"content": "저 멧돼지들을 쫓아내는 걸 도와준다면, 이 터너 이름을 걸고 보답하겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "터너"
				}
			]
		},
		{
			"id": 46803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
