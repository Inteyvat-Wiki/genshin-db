			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#오! {NICKNAME} 아니야? 마침 잘 왔어. 앉아서 한잔할래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080102,
					"content": "여기서 너희를 보니까 정말 반갑네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080103,
					"content": "두 분이 여긴 어쩐 일로?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "잠깐, 두 사람 설마 같이 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705080105,
					"content": "'응광 님'께서 뜬금없이 휴가를 보낸다길래, 이 일대로 여행 왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080106,
					"content": "근데 우린 여행에 대한 이해가 다른가 봐. 산도 몇 개 안 올랐는데, 벌써 여기에 쉬러 오다니, 정말 사치병이라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080107,
					"content": "그 말은 좀 섭섭한걸. 네 취향을 고려해서 일부러 술 마실 수 있는 곳을 고른 건데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080108,
					"content": "아무래도 대선장님께선 안 다녀본 데가 없어서 이런 작은 주점으론 성에 안 차나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080109,
					"content": "알았어, 여긴 내가 살게. 됐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080110,
					"content": "북두가 산다고? 우리 몫도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705080111,
					"content": "페이몬, 우리는 바텐더잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "그러게, 습관적으로 그만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705080113,
					"content": "두 분, 뭘 드실 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "베툴라 작은 사이즈로. 최대한 새콤하게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080115,
					"content": "선셋, 큰 사이즈로. 땡큐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080116,
					"content": "네, 잠시만 기다려주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
			"completionStepIds": [
				7050804
