			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080202,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080203,
					"content": "어, 어때? 아무 말도 안 하니까 긴장되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705080204,
					"content": "음… 지난날의 쓴맛과 현재의 행복이 느껴지는 맛이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080205,
					"content": "자수성가의 맛? 그게 대체 무슨 맛이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080206,
					"content": "후훗… 신맛에서 단맛이 느껴지고, 잔향이 오래 가네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080207,
					"content": "음… 작은 사업을 시작했는데 과일 장사는 돈이 안 된다는 걸 깨달은 맛?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080208,
					"content": "콕 집어 말할 필요 없잖아. 옛일은 흘러가도록 내버려 두자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080209,
					"content": "하하, 존귀하신 천권성한테도 길에서 과일 팔던 시절이 있었단 걸 누가 상상이나 하겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080210,
					"content": "나처럼 말이야. 아무리 봐도 어민 출신 티가 안 나잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080211,
					"content": "그럴 리가. 내가 볼 땐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080212,
					"content": "북두 선장의 바다를 꿰뚫어 보는 눈과 파도를 뚫고 전진하는 열정을 보면, 평생 바다와 함께 살아온 사람 같은걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080213,
					"content": "이봐, 비꼬는 거 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080214,
					"content": "그래 봤자 나한테 무슨 이득이 있다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080215,
					"content": "네 말솜씨를 누가 당하겠어. 오늘은 내가 살 테니까 거기까지만 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080216,
					"content": "음… 그럼 몇 잔 더 마실래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080217,
					"content": "한잔 더 드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "최선을 다해 모시겠습니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "바텐더, 렛츠기릿!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705080220,
					"content": "바로 그 기세야! 그럼 나도 한 잔 더!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080234,
					"content": "두 사람의 잔을 다시 채워준다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "몬드의 주스는 정말 맛있네. 매일 마실 수 있으면 좋을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080222,
					"content": "응? 농담이지? 일몰 열매 전용 무역 루트를 만들겠다는 둥 그런 얘기 하지 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080223,
					"content": "듣고 보니 구미가 당기는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080224,
					"content": "진심이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080225,
					"content": "농담이지. 이미 규모가 꽤 있는 무역이라 내가 나설 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080226,
					"content": "#{NICKNAME}, 오늘 고마웠어. 나중에 한가한 일자리를 찾고 싶으면, 내 전속 바텐더를 해도 되겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080227,
					"content": "「사조성」호에 와도 되고. 다들 술이라면 사족을 못 쓰거든. 오면 술이랑 고기를 실컷 먹을 수 있어. 분명 만족할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "북두"
				},
				{
					"id": 705080228,
					"content": "북두 선장, 지금 나랑 경쟁하는 거야? 그럴 필요 없어. 여행자의 음료가 마시고 싶으면 군옥각에 오면 되잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "응광"
				},
				{
					"id": 705080229,
					"content": "(나 정말 인기 많네!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "아무래도 네가 저 둘 손에 넘어간 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705080231,
					"content": "기회 되면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "양쪽 다 갈게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}