						],
						"stepId": 7322006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"제트",
					"릴루페르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732200601,
					"content": "미안…. 갑자기 무슨 말을 해야 할지 몰라서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200602
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200602,
					"content": "시간이 흐르는 걸 잊기라도 한 듯 모든 게 멈춰있어. 신비로운 광경은 둘째치고, 왠지 모르게 마음이 편안해져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200603
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200603,
					"content": "이런 곳에서 세상을 떠난 신과 영원히 잠든다라…. 후, 부모님이 떠나지 않았다면 좋았겠지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200604
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200604,
					"content": "그래도 두 분이 이곳에서 영원히 시간에 잊히지 않았으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200605
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200605,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200606
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200606,
					"content": "하지만 우리가 조각의 힘을 흐트러뜨리고 유지 장치를 파괴했으니… 여긴 곧 무너져내리고 결국 모래에 묻히고 말 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200607
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200607,
					"content": "그렇게 되면 오아시스를 유지하던 여주인의 일말의 힘도 사라지겠지…. 되돌릴 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200608
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200608,
					"content": "응… 알아. 그래도 그전에 우리 부모님은 다시 만나게 될 거야… 한 번도 떨어진 적 없었던 것처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200609
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200609,
					"content": "어쩌면 언젠간 나도 이곳에 돌아오겠지…. 모험이 지겨워지고 「집」이라고 부를 곳이 전혀 남지 않게 되면 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200610
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200610,
					"content": "다시 돌아오는 그날엔 반갑게 「돌아왔어요!」라고 말하고 부모님 사이에 누워 잠들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200611
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200611,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200612
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200612,
					"content": "제트… 그날이 오려면 아직 멀었다구! 음… 제브라엘이 정말 기뻐하겠어. 무덤덤한 얼굴이겠지만 분명 속으로는 좋아하고 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732200613,
					"content": "고마워, 페이몬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200614
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200614,
					"content": "#{NICKNAME}, 이기적인 내 소원을 위해 함께해 줘서 고마웠어…. 그런데 지금은 혼자서 부모님과의 시간을 보내고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200615,
						732200617
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200615,
					"content": "이해해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200616
					]
				},
				{
					"id": 732200616,
					"content": "응… 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				},
				{
					"id": 732200617,
					"content": "그래도 돌아가는 건 잊지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200618
					]
				},
				{
					"id": 732200618,
					"content": "걱정 마…. 곧 뒤따라갈게. 하하, 벌써 여기서 사는 건 좀 아니잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				}
			]
		},
		{
			"id": 7322008,
			"completionStepIds": [
				7322008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322008",
							"2"
						],
						"stepId": 7322008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"제트",
					"바벨",
					"릴루페르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732200801,
					"content": "바벨 대모, 우리 왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200802
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200802,
					"content": "「영원의 오아시스」의 비밀을 밝혀냈어요. 부족이 오갈 수 있게 길도 뚫어놨고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200803
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200803,
					"content": "부모님의 숙원을 이룰 기회를 주셔서 정말 고마웠어요…. 비록 두 분은 타니트의 보우를 받지 못한다 해도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200804
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200804,
					"content": "됐어. 네 숙원은 항상 기억하고 있었단다. 아이들의 소원을 들어주는 건 대모로서 당연히 해야 할 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200805
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200805,
					"content": "고맙습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200806
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200806,
					"content": "수고했다, 제트. 그나저나 아자릭 일은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200807
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200807,
					"content": "대모의 판단이 맞았어요…. 배신자가 확실해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200808
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200808,
					"content": "어, 아자릭이 배신할 거란 걸 알고 있었어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732200809,
					"content": "아니, 심증만 있어서 계속 지켜보고 있었지. 근데 아자릭이 그렇게 빨리 본모습을 드러낼 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200810
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200810,
					"content": "바벨 대모가 경고했지만, 당시 난 아자릭을 믿었었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200811
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200811,
					"content": "보세요, 그 녀석이 우인단과 결탁했다는 증거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200812
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200812,
					"content": "제트가 바벨 대모에게 아드라피의 편지를 건넸다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732200813
					]
				},
				{
					"id": 732200813,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200814
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200814,
					"content": "너무 슬퍼하지 마세요 바벨 대모…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200815
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200815,
					"content": "그래… 흑심을 품었다는 건 진작 눈치챘지만 내 손으로 직접 처리할 수가 없었구나…. 그 아이를 아꼈으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200816
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200816,
					"content": "부족의 상황이 점점 위태로워지고 있군…. 잘 키운 아이 둘을 잃었으니, 앞으로 부족의 대소사는 네가 맡아줘야겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200817
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200817,
					"content": "어… 그럼 제트가 진급한 거야? 축하해, 제트!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200818
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732200818,
					"content": "진급? 하하… 사막과 안 어울리는 말이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200819
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200819,
					"content": "사막인에겐 계급 개념이 없거든. 책임지는 일이 많아질수록 더 많은 권력을 쥐게 될 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200820
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200820,
					"content": "제트… 타니트의 미래가 네게 달렸단다. 절대 부족을 실망시키지 말도록 해라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200821
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200821,
					"content": "부족이라… 이제 절 진정한 타니트 부족의 일원으로 인정해주는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200822
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200822,
					"content": "바보 같은 소리. 난 늘 그렇게 생각해왔다. 무슨 일이 있었든 넌 우리와 같은 피가 흐르는 타니트의 딸이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200823
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200823,
					"content": "네… 고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200824
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200824,
					"content": "음, 수상한 일에 대해 얘기한다는 걸 깜빡한 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200825
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732200825,
					"content": "#{NICKNAME}, 아까 우리가 뭘 봤더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200826,
						732200845
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732200826,
					"content": "협곡의 버려진 야영지에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200827
					]
				},
				{
					"id": 732200827,
					"content": "넌 오아시스에 부족인을 보내 죽게 내버려 뒀지. 그래서 「금기」를 운운하며 출입을 막은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200828
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200828,
					"content": "그런데 왜 그런 말은 쏙 빼고 우릴 위험한 곳으로 보낸 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200829
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200829,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200830
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200830,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200831
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200831,
					"content": "존경하는 릴루페르 님, 일전의 오해에 대해서는 사과하도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200832
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200832,
					"content": "하지만 타니트 부족이 얼마 전부터 구라바드 유적과 「영원의 오아시스」를 탐사한 건 사실입니다…. 부족인을 여럿 보냈었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200833
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200833,
					"content": "덕분에 그곳들의 위치와 지형을 파악할 수 있었고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200834
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200834,
					"content": "하지만 너무 위험한 탓에 살아 돌아오는 이도, 얻을 수 있는 정보도 거의 없었죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200835
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200835,
					"content": "그래서 계획을 중단하고 부족의 금기 구역으로 지정한 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200836
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200836,
					"content": "아자릭, 그 배신자 녀석도… 동료들과 함께 협곡과 유적에 갔었죠. 그 아이가 길을 안내해줄 거라고 믿었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200837
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200837,
					"content": "그런데 왜 얘기해주지 않았나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200838
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200838,
					"content": "너희가 무사히 돌아오리란 걸 알았으니까. 넌 내 신뢰하는 후배란다, 제트",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200839
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200839,
					"content": "너의 지혜와 용기, 부족인과 친구를 향한 진심과 배려를 전부 보았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200840
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200840,
					"content": "내 딸이 사막에 묻히지 않았다면 너와 똑같았을 거야. 어떤 위험이 닥쳐와도, 그게 설령 모래폭풍이라 해도 극복해냈겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200841
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200841,
					"content": "그래서 널 믿으며 묵묵히 기도했단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200842
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200842,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200843
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200843,
					"content": "…죄송해요, 바벨 대모. 제가 괜한 트집을…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200844
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200844,
					"content": "아니, 사과할 사람은 나야. 나 때문에 오해와 불신이 생겼으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200864
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200864,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200865
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200865,
					"content": "미안, 내가 쓸데없는 걱정을 했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200866
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200866,
					"content": "#오해가 다 풀려서 정말 다행이야. {NICKNAME}, 타니트 부족의 손님으로 온 걸 영원히 환영한단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200867
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200867,
					"content": "존귀한 「지니의 주인」이여, 필요한 게 있으면 얼마든지 얘기하렴. 최대한 들어줄 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200868
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200868,
					"content": "뭐든 상관없어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200869
					]
				},
				{
					"id": 732200869,
					"content": "그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200870,
						732200873,
						732200876
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200870,
					"content": "보수로 모라를 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200871
					]
				},
				{
					"id": 732200871,
					"content": "바로 그거야! 모라, 모라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200872
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732200872,
					"content": "자, 네가 받아야 할 보수야. 그리고… 제트를 보살펴줘서 고맙구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200881,
					"content": "이제 더 붙잡아두진 않을게. 고마웠어. 「지니의 주인」… 언젠가 다시 우리 타니트 부족에 들러줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200882
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200882,
					"content": "우린 너와 릴루페르 님의 인도를 따르는 존재니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200873,
					"content": "기념품을 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200874
					]
				},
				{
					"id": 732200874,
					"content": "엥? 모라가 아니라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200875
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732200875,
					"content": "타니트와의 우정은 기념할 만한 가치가 있지. 소박한 선물이지만 마음에 들길 바란다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200876,
					"content": "제트의 생일 축하연에서 저 대신 건배해주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200877
					]
				},
				{
					"id": 732200877,
					"content": "맞아, 내 몫까지도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200878
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732200878,
					"content": "응…? 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200879
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200879,
					"content": "훗… 이게 외부인의 전통인가? 뭐, 알겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200880
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200880,
					"content": "너희를 위해 그 정도는 해주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200845,
					"content": "배신자의 편지에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200846
					]
				},
				{
					"id": 732200846,
					"content": "편지대로라면 아자릭과 아드라피는 네가 「배신자의 딸」 제트를 아끼고, 후계자로 여겨서 배신한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200847
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200847,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200848
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200848,
					"content": "넌 한때 「외부인」을 통해 「북방인」과 교류했으면서, 부족의 「외부인」 무리를 없애려 했다며?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200849
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200849,
					"content": "너희들의 은어는 못 알아듣겠으니… 무슨 뜻인지 설명해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200850
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732200850,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200851
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200851,
					"content": "존경하는 릴루페르 님, 일전의 오해에 대해서는 사과하도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200852
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200852,
					"content": "하지만 타니트 부족을 유지하려면 무역이 필수입니다. 북방인 녀석들은 거래 상대일 뿐이고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200853
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200853,
					"content": "부족의 전반적인 일을 내가 다 처리한다지만 어떻게 놈들의 속내까지 알 수 있겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200854
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200854,
					"content": "얼마 못 가 이익보다 위험이 많다는 것을 깨닫게 되었고… 내부의 배신자부터 제거할 수밖에 없었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200855
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200855,
					"content": "그래서 제트가 필요한 거예요. 늘 부족을 위해 배신자를 신속하게 제거하니까요. 그녀의 충성심과 실력은 높이 사고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200856
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200856,
					"content": "그런데 왜 얘기해주지 않았나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200857
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200857,
					"content": "너희가 무사히 돌아오리란 걸 알았으니까. 넌 내 신뢰하는 후배란다, 제트",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200858
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200858,
					"content": "너의 지혜와 용기, 부족인과 친구를 향한 진심과 배려를 전부 보았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200859
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200859,
					"content": "내 딸이 사막에 묻히지 않았다면 너와 똑같았을 거야. 어떤 위험이 닥쳐와도, 그게 설령 모래폭풍이라 해도 극복해냈겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200860
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200860,
					"content": "그래서 널 믿으며 묵묵히 기도해왔다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200861
					],
					"speakerTitle": "바벨"
				},
				{
					"id": 732200861,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200862
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200862,
					"content": "…죄송해요, 바벨 대모. 제가 괜한 트집을…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200863
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732200863,
					"content": "아니, 사과할 사람은 나야. 나 때문에 오해와 불신이 생겼으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200864
					],
					"speakerTitle": "바벨"
				}
			]
