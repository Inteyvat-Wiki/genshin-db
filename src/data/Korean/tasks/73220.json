					"content": "너도 따라오는 걸 잊지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				},
				{
					"id": 732201321,
					"content": "「연인」이나 「원수」에게 얽매이지 않아도 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
