			"dialogs": [
				{
					"id": 230080101,
					"content": "곧 성공할지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080102,
					"content": "여행자, 저기 잠깐만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080103,
					"content": "무슨 일이세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "슬라임 응축액이 필요해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080106,
					"content": "그게… 며칠 동안 네가 가지고 온 진흙들을 여러 비율로 혼합해 봤거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080107,
					"content": "여러 차례의 실패를 거친 끝에 드디어 쓸만한 혼합 비율을 찾아냈어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080108,
					"content": "이런 비율로 혼합된 「젤리 진흙」은 굳기 전에는 가소성이 별로 좋지 않지만, 완전히 굳은 뒤엔 아주 견고하다는 걸 발견했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080109,
					"content": "슬라임 응축액 비율이 부족한 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080110,
					"content": "그러니까… 슬라임 응축액 세 개를 더 구해다 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080111,
					"content": "그것만 있으면 내가 원하는 진흙을 만들어낼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아킴"
				},
				{
					"id": 230080104,
					"content": "이번엔 어떤 게 필요하신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
