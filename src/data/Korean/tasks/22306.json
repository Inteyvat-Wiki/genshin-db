			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"장순"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060101,
					"content": "이걸 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060102
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060102,
					"content": "무슨 일이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060103
					]
				},
				{
					"id": 223060103,
					"content": "난 예전에 남십자함대의 선원이었어. 근데 재수없게 다쳐버렸지 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060104
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060104,
					"content": "함대에서 나왔는데, 생활이 막막해서 박래라는 장사꾼한테 보물지도 몇 장을 담보로 돈을 좀 받았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060105
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060105,
					"content": "진짜 보물이 있으면 나랑 반띵하기로 했어. 근데 아직까지 소식이 없는 걸 보니, 못 찾은 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060106
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060106,
					"content": "더는 못 기다리겠어. 날 도와 보물 좀 찾아줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060107,
						223060109,
						223060116
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060108
					]
				},
				{
					"id": 223060108,
					"content": "그럼 부탁 좀 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060120
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060120,
					"content": "일단 <color=#00E1FFFF>박래</color>에게 가서 <color=#00E1FFFF>보물지도</color>를 받아. 그리고 <color=#00E1FFFF>보물을</color> 찾아서 바로 <color=#00E1FFFF>그에게 줘</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060121
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060121,
					"content": "이미 이야기해뒀으니, 그가 아마 내 몫을 맡아줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "장순"
				},
				{
					"id": 223060109,
					"content": "근데 왜 함대에서 나왔어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060110
					]
				},
				{
					"id": 223060110,
					"content": "내 몸은 내가 잘 알아. 언제 이 고질병이 다시 도질지 모르는 상태였어. 함대에 폐를 끼칠 것 같아서 나와버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060111
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060111,
					"content": "그 후에 예전에 모았던 자질구레한 것들로 여기에서 조그맣게 장사를 시작했어. 그런데 장사도 잘 안되고 물건도 거의 동났네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060112
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060112,
					"content": "보물지도가 몇 장 있었어. 전에 함대에 있을 때 획득한 전리품이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060113
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060113,
					"content": "근데 걷기도 힘겨운 이 몸으로 탐험을 하는 건 무리였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060114
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060114,
					"content": "그래서 박래라는 자한테 그 보물지도를 담보로 돈을 받았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060115
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060115,
					"content": "그런데 그 자도 직접 보물을 찾으러 갈 수는 없나 봐. 아무래도 평범한 상인이니까… 그래서 그런데 보물찾기를 네게 맡겨도 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060107,
						223060116
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060116,
					"content": "정말 엄청난 보물이 있을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060117
					]
				},
				{
					"id": 223060117,
					"content": "하하하, 그렇진 않을 거야. 이 보물지도도 함대에서 나눠준 전리품이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060118
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060118,
					"content": "정말 엄청난 보물이 있었다면, 벌써 함대 사람들이 먼저 단서를 모아 보물을 발견했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060119
					],
					"speakerTitle": "장순"
				},
				{
					"id": 223060119,
					"content": "하지만 엄청난 보물이 아니어도 삼등분할 정도의 돈은 될 거야. 그러니까 부탁 좀 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060120
					],
					"speakerTitle": "장순"
				}
			]
		},
		{
