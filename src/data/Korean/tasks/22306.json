			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"박래"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060201,
					"content": "이봐, 친구. 뭐가 필요해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060202
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223060202,
					"content": "보물지도를 받으러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060203
					]
				},
				{
					"id": 223060203,
					"content": "보물지도? 음… 장순이 내게 넘긴 이것들을 말하는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060204
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223060204,
					"content": "흠, 정말 무슨 보물이 있는지 찾으러 가려고? 난 그냥 우스갯소리라고 생각했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060205
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223060205,
					"content": "딱 봐도 넌 진짜 모험가 같군. 보물이란 말에 눈이 돌아가잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060206
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223060206,
					"content": "어쨌든 난 이 보물지도 필요없으니, 가져가든지 말던지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060207
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223060207,
					"content": "하지만 정말로 보물을 찾게 된다면 똑같이 나눠 줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060208
					],
					"speakerTitle": "박래"
				},
				{
					"id": 223060208,
					"content": "여기 오랫동안 맡겨뒀으니 보관료 정도는 지불해야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "박래"
				}
			]
		},
