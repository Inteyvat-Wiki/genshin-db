					"핀치 씨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414220201,
					"content": "핀치, 핀치!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220202
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414220202,
					"content": "어이구, 깜짝이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220203
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414220203,
					"content": "엔도라는 학습 능력이 빠르니까, 놀라는 게 당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414220204,
					"content": "날 핀치라고 부르는 게, 마치 그녀 같아서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220205
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414220205,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414220206,
					"content": "「매일, 세상의 만물을 탐구하기 위해 비틀거리며 앞으로 나아가는 아이가 있어요. 그가 보는 모든 건 그의 일부가 되죠——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220207
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414220207,
					"content": "「그 아이가 내딛는 발걸음은, 그렇게 일생이 되죠」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220208
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414220208,
					"content": "나도 그 시를 알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220209
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414220209,
					"content": "우리와 당신들의 생명은 아주 달라요. 그러니까 살아있는 동안은 서로를 이해할 수 없을지도 모르죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220210
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414220210,
					"content": "하지만 우리의 생명은 같은 것이기도 해요. 늘 새로운 걸 경험하고 새로운 기회를 만나며 바다로 흘러가니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220211
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414220211,
					"content": "그래서 그녀는 「밤하늘의 별이 모두 꺼질 때, 모든 물줄기와 꿈이 같은 바다로 흘러가게 될 거야. 그때 우린 다시 만나게 될 테지」라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220212
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414220212,
					"content": "…그렇구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220213
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414220213,
					"content": "생명의 물줄기는 계속해서 흐르고 있어요. 당신도 걸음을 멈추지 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220214
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414220214,
					"content": "하하하, 역시 그녀답군. 날 어린아이 취급하는 말투는 여전하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220215
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414220215,
					"content": "알았으니 당분간 좀 혼자 있게 해주렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220216
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414220216,
					"content": "#그럼 {NICKNAME}, 우리도 코너 씨한테 다시 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4142203,
