			},
			"dialogs": [
				{
					"id": 414220301,
					"content": "오오, 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220302
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414220302,
					"content": "자네들이 나섰으니 아마 일이 깔끔하게 해결됐겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220303,
						414220304
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414220303,
					"content": "당연하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				},
				{
					"id": 414220305,
					"content": "아마 며칠 지나면 물의 쓴맛이 바로 사라질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414220306,
					"content": "아, 그래. 문제의 근원을 해결했어도 물이 깨끗해지려면 시간이 필요할 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414220307
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414220307,
					"content": "그럼 모험가 길드에 문제가 해결됐다고 알릴게. 정말 고맙네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "코너"
				},
				{
					"id": 414220304,
					"content": "과정이 복잡하긴 했지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414220305
					]
				}
			]
		},
		{
			"id": 4142204,
			"completionStepIds": [
				4142204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
