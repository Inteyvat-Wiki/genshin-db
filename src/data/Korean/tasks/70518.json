				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182501,
					"content": "미안한데, 이렇게 낮은 가격은 받아들일 수 없어. 정 주문할 생각이라면 내가 가격을 제시할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
