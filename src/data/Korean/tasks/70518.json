				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182201,
					"content": "올해는 풍년이라 양조 비용이 낮아지긴 했지만, 이 가격은 받아들이기 힘들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게오르크"
				}
			]
		},
		{
