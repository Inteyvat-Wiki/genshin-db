				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182301,
					"content": "좋아, 예년 가격과 거의 근접하네. 이 가격으로 정하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게오르크"
				}
			]
		},
		{
			"id": 7051824,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"게오르크"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182401,
					"content": "이 가격은… 조금 아쉽긴 하지만 단골손님인 셰비르메 씨를 봐서 수락할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게오르크"
				}
			]
		},
		{
			"id": 7051825,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
