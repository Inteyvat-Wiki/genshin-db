				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705182601,
					"content": "전처럼 담당자를 보내서 음료를 셰비르메 씨의 가게까지 배송해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182602
					],
					"speakerTitle": "게오르크"
				},
				{
					"id": 705182602,
					"content": "그러니까 걱정 마, 영수증 잘 챙겨두는 거 잊지 말고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182603
					],
					"speakerTitle": "게오르크"
				},
				{
					"id": 705182603,
					"content": "좋아, 계속해서 자금을 마련하자. 목표는 최대한 빨리 충분한 「와인 젤리」를 수집하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705182604,
					"content": "베른하르트가 원하는 방식대로 자금 마련을 하라고 했었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705182605,
					"content": "외지 손님의 주문을 도와주면 수고비를 받을 수 있을 거야. 그러면 양조 재료를 많이 팔 필요 없겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705182606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705182606,
					"content": "그래도 혹시 모르니까 다른 술장수들한테도 한번 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
