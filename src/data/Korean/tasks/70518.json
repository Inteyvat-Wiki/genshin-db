			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"베른하르트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180101,
					"content": "잠깐만! 명성이 자자한 명예 기사, 그리고 「티바트 최고의 가이드」 페이몬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180102
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180102,
					"content": "제발 부탁이야, 날 도와줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180103
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180103,
					"content": "엥! 나를 그렇게 부르는 사람이 있다니? 내 명성이 드디어 널리 퍼진 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180140,
					"content": "음… 낯익은데 어디서 봤더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180104,
					"content": "기사단 본부 로비에서 만난 적이 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180105
					]
				},
				{
					"id": 705180105,
					"content": "맞아, 난 페보니우스 기사단, 헤르타 대장님이 이끄는 보급 소대의 대원, 베른하르트라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180106
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180106,
					"content": "너희랑 친분도 없는데… 시간이 없어서 염치 불고하고 도움을 청하게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180107
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180107,
					"content": "제발 이번 자선 판매 행사를 살려줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180108
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180108,
					"content": "살려달라고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180109
					]
				},
				{
					"id": 705180109,
					"content": "자선 판매 행사라… 진 단장한테서 얼핏 들었던 것 같아. 근데 무슨 문제라도 생긴 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180110,
					"content": "페보니우스 기사단은 와인 축제 기간에 자선 가게를 운영할 예정이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180111
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180111,
					"content": "가게의 수익은 생계가 어려운 아이들이나 노인들을 위한 자선 사업에 사용될 예정이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180112
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180112,
					"content": "담당자는 제비뽑기로 정했는데, 내가 당첨됐어… 이번 자선 판매를 위해 많은 사람에게 도움을 구했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180113
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180113,
					"content": "평소엔 보관과 운송이 주된 업무라, 뭘 팔아야 할지조차 잘 모르겠어. 가게 운영은 더 말할 것도 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180114
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180114,
					"content": "그래서 너희한테 도움을 구하고 싶어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180115,
						705180116
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180115,
					"content": "이해해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				},
				{
					"id": 705180117,
					"content": "맞아, 부담 가질 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180118,
					"content": "자선 판매는 몬드의 아이들과 노인들을 위한 뜻깊은 행사잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180119,
					"content": "얘는 명예 기사고, 나는 기사단의 친구니까. 기사단을 돕는 건 당연해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180120,
						705180121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180120,
					"content": "우리가 도울게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180122,
					"content": "정말 고마워! 그럼 최대한 간략하게 설명할게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180123
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180123,
					"content": "행사 시작 전에, 우리는 가게 운영 자금인 <color=#00E1FFFF>「와인 젤리」</color>를 마련해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180124
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180124,
					"content": "인근의 술장수들은 양조 재료가 시급한 상황이니까, 상인들한테 재료를 판매하면 대량의 「와인 젤리」를 얻을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180125
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180125,
					"content": "그 밖에도 와인 축제 기간에 음료를 대량으로 구매하려는 외국 손님들이 있어. 그 손님들은 주문을 도와줄 대리인을 찾는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180126
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180126,
					"content": "장기적인 거래가 될지도 모르니까, 외국 손님들은 대체로 거액을 제시하는 편이야. 그리고 술장수와도 가격을 조율할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180127
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180127,
					"content": "그 차액이 우리가 받을 수 있는 수고비야. 물론 동등한 가치의 「와인 젤리」와 교환할 수도 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180128
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180128,
					"content": "그러니까 술장수들에게 양조 재료를 제공하고, 외국 손님을 도와 주문과 가격 흥정을 하는 게 우리의 임무인 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180129,
					"content": "생각보다 어려운 일은 아니네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180130,
					"content": "우리가 잘하는 일이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180131
					]
				},
				{
					"id": 705180131,
					"content": "정, 정말이야? 진짜 다행이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180132
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180132,
					"content": "사실 이미 주문을 하나 받았어——수메르의 셰비르메 씨가 <color=#00E1FFFF>「바캉스 과일주」 50상자</color>를 사고 싶대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180133
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180133,
					"content": "이 음료는 <color=#00E1FFFF>「천사의 몫」 노점</color>에서 살 수 있어. 가게 주인은 <color=#00E1FFFF>게오르크</color> 씨야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180134
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180134,
					"content": "게오르크 씨는 온화하지만 절대 손해 보지 않는 성격이니까, 신중하게 협상하는 게 좋을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180135
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180135,
					"content": "난 가게를 열 준비를 하고 있을게. 「와인 젤리」를 충분히 모으면 여기로 와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180136
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180136,
					"content": "그리고, 가게 관련 물자는 신경 쓸 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180137
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180137,
					"content": "공급처에 연락을 해뒀으니까 자금만 충분하면 물자를 배송해 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180138
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180138,
					"content": "좋아, 가게 준비는 너에게 맡길게. 자금 준비는 우리한테 맡겨달라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180139,
					"content": "부탁할게, 정말 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705180121,
					"content": "어떻게 도우면 돼요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180116,
					"content": "누구에게나 익숙하지 않은 일이 있기 마련이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				}
			]
		},
		{
			"id": 7051802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051802",
							"2"
						],
						"stepId": 7051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"게오르크"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180201,
					"content": "게오르크 씨, 안녕. 우리는 셰비르메 씨의 대리인이야. 「바캉스 과일주」 50상자를 주문하고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180202,
					"content": "오? 셰비르메 씨는 우리 가게의 단골손님이지, 주문량도 일정한 편이고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180203
					],
					"speakerTitle": "게오르크"
				},
				{
					"id": 705180203,
					"content": "그나저나, 올해는 얼마를 제시할 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게오르크"
				}
			]
		},
		{
			"id": 7051803,
			"completionStepIds": [
				7051803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051803",
							"2"
						],
						"stepId": 7051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바바라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180301,
					"content": "여행자, 페이몬, 여기 있었네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180302
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180302,
					"content": "오! 바바라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180303,
						705180304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180303,
					"content": "안녕, 바바라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				},
				{
					"id": 705180305,
					"content": "네, 즐거운 와인 축제 보내세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180306
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180306,
					"content": "몬드의 가장 열띤 축제 중 하나인 와인 축제에서 두 분을 만날 수 있어서 기뻐요. 부디 와인 축제를 마음껏 즐겨주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180307
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180307,
					"content": "그러고 보니, 방금 게오르크 씨에게서 두 분이 「와인 젤리」를 수집하고 있다고 들었는데. 정말인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180308
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180308,
					"content": "혹시, 기사단의 자선 판매를 돕는 중이신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180309
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180309,
					"content": "응, 우리도 기사단의 일원이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180310,
					"content": "몇 군데 더 돌아다니면서 가게 개업에 필요한 자금을 마련해야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180311,
					"content": "개업하고 또 무슨 문제가 생길지는 몰라도, 우리가 있으니 괜찮을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180312,
					"content": "정말 든든해요! 헤헤… 두 분이 도와주신다면 큰 성공을 거둘 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180313
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180313,
					"content": "네 말대로 됐으면 좋겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180314
					]
				},
				{
					"id": 705180314,
					"content": "저도 기사단의 작은 자선 판매 행사를 도운 적이 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180315
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180315,
					"content": "비록, 제가 도울 수 있는 건 가게 앞에서 노래 부르는 거밖에 없었지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180316
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180316,
					"content": "참! 그때 음유시인 벤티를 만났어요! 그의 초대를 받고 즉흥적으로 함께 공연했었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180317
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180317,
					"content": "벤티가 연주하는 곡은 고풍스럽고 우아했어요. 저는 분위기를 망칠까 봐, 처음에는 작은 소리로 따라 불렀죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180318
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180318,
					"content": "다행히 벤티가 화음으로 절 리드해준 덕분에 빠르게 호흡을 맞출 수 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180319
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180319,
					"content": "결국 청중들은 만족했고, 상품도 엄청 잘 팔렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180320
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180320,
					"content": "바바라와 각설이가 합동 공연을 했었구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180321,
					"content": "나도 듣고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180322
					]
				},
				{
					"id": 705180322,
					"content": "아쉽지만 이번에는 일정이 겹쳐서 힘들 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180323
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180323,
					"content": "페보니우스 성당은 와인 축제 기간에 경치 좋은 곳에서 특별한 성가대 활동을 선보일 예정이라서 연습에 참가해야 해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180324,
						705180325
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180324,
					"content": "난 괜찮으니까 바쁘면 얼른 가봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180326,
					"content": "응, 둘 다 뜻깊은 일이니까 다 같이 파이팅하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180327,
					"content": "고마워요! 비록 남아서 노래를 부를 순 없지만 저도 뭔가 돕고 싶어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180328
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180328,
					"content": "전… 다른 사람들한테 가게를 홍보할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180329
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180329,
					"content": "음… 큰 포스터를 만드는 게 나을까요, 아니면 전단지를 만드는 게 나을까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180330
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180330,
					"content": "홍보 문구도 잘 생각해 봐야겠어요! 사인을 추가하면 조금 더 정성스럽게 보이지 않을까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180331
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180331,
					"content": "음, 아니면 집집마다 돌아다니면서 홍보할까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180332
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180332,
					"content": "우와, 바바라가 홍보를 도와준다면 가게의 인지도가 엄청 오를 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180333,
						705180334
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180333,
					"content": "힘들지 않을까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180335,
					"content": "이건 제가 할 수 있는 사소한 일이에요. 그렇게 얘기하시면 부끄러워요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180336
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180336,
					"content": "#다른 분한테도 홍보 노하우를 물어보고 고민해볼게요! {NICKNAME}, 페이몬, 나중에 봐요~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180337
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180337,
					"content": "그리고… 기사단과 성당 분들도 두 분을 자랑스럽게 생각할 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180338
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 705180338,
					"content": "응! 같이 힘내자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180339
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180339,
					"content": "#갑자기 의욕이 넘치네! {NICKNAME}, 멋진 모습을 보여줘야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705180334,
					"content": "무리하지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180325,
					"content": "자선 판매는 우리한테 맡기면 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180304,
					"content": "즐거운 와인 축제 보내",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				}
			]
		},
		{
