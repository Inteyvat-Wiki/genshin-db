						220280801
					]
				},
				{
					"id": 220280801,
					"content": "네! 그럼 그렇게 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280802
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280802,
					"content": "이번에도 신이 응답을 주셨으면 좋겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280803
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280803,
					"content": "내일 다시 와서 특별한 일이 일어났는지 봐야겠어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280804,
					"content": "참, 지금까지 같이 동행해줘서 고마워요, 이거 받으세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280805
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280805,
					"content": "신이 제 소원을 들어주셨으면 좋겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
