			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쇼타"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#{F#누나}{M#형아}! 엄청난 일이 있었어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280102,
					"content": "저번에 감실에 공양하고 나서 제 소원이 진짜 이뤄졌어요… 조금이긴 하지만! 정말 조금 이뤄진 거긴 하지만… 이건 신의 응답이 틀림없어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280103,
					"content": "무슨 소원을 빌었는데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "음… 제가 보는 만화가 있는데, 그 작품 만화가가 더 빨리 그려서 이틀에 한번 연재해달라고 빌었어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280105,
					"content": "근데 그 만화가가 정말로 한 화 분량을 두 배로 늘렸어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280106,
					"content": "하지만… 연속 3주나 휴재한대요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280107,
					"content": "소원을 이뤄주는 방식이 꽤 균형 있네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "음… 어쨌든, 신이 제 소원을 들어주신 게 분명해요. 소원이 완벽히 이루어지지 않은 건 제 공양이 부족했던 탓이겠죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280110,
					"content": "그래서 오늘은 다른 곳의 감실에도 공양할래요! 그럼 신이 제 소원을 완전히 들어주시겠죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280111,
					"content": "아빠랑 엄마한테 물어봤는데, 근처에 감실이 두 개 더 있대요! 하나는 코모레 찻집 근처에 있고, 하나는 성 밖으로 가는 길에 있대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280112,
					"content": "#{F#누나}{M#형아}, 어느 감실에 먼저 가는 게 좋을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280108,
					"content": "왠지 한 화 더 적어진 것 같은 느낌이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
