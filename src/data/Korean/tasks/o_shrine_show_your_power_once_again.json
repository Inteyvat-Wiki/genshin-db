				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280901,
					"content": "여기예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280902
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280902,
					"content": "옛날에 어떤 아저씨가 무예의 향상을 바라며 이 감실에 단조용 철광석을 공양했대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280903
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280903,
					"content": "나중에 그 아저씨가 비무 대회에 나갔는데, 상대를 엄청 쉽게 이겨버렸대요. 그리고 아저씨는 무예가 뛰어나다고 칭송받기도 했구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280904
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280904,
					"content": "하지만 아저씨는, 상대들이 몸이… 안 좋았다고 하던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280905,
						220280906
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280905,
					"content": "썩 믿음이 가지 않는 신이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280907,
					"content": "하지만 어쨌든 다들 신 덕분이라고 생각하고 있어요. 그래서 이 감실에 소원을 빌면 응답을 들을 수 있을지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280908
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280908,
					"content": "이 얘긴 그만 해요! 이번에는 뭘 공양하는 게 좋을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280909
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280909,
					"content": "그 아저씨처럼 철광석을 공양하면, 대답을 들을 수 있을지도 몰라요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280910
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280910,
					"content": "대장간 앞에서 광석 몇 개를 줍긴 했는데, 품질이 그렇게 좋지 않아요. 대장장이 아저씨가 공짜로 가져가도 괜찮다고 하셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280911
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280911,
					"content": "그리고… 전에 근처에서 주운 신선한 해초를 끓여서 위에 설탕을 뿌렸어요… 이거 엄청 맛있거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280912
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280912,
					"content": "근데 신이 냉채를 좋아하실지는 모르겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280913
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280913,
					"content": "#{F#누나}{M#형아} 생각은 어때요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼타"
				},
				{
					"id": 220280906,
					"content": "다른 사람의 퇴보로 이긴 셈인가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "쇼타"
				}
			]
		},
