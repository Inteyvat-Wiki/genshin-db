			"dialogs": [
				{
					"id": 760280301,
					"content": "#으흑, 드디어 찾았다, {NICKNAME}! 아까 그 빛나는 것들이 부딪치고 나서, 폭발의 충격파에 날아갔는데 다행히 다치진 않았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760280302,
					"content": "한참을 날아서 겨우 여기까지 왔네…. 네가 무사해서 정말 다행이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760280303,
					"content": "나도 한참을 날았어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "그랬구나…. 뭐? 잠깐, 날았다니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760280305,
					"content": "페이몬에게 방금 전에 본 광경을 설명한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#으음, 티바트에 그런 곳이 있다는 얘기는 못 들어봤는데… {NICKNAME}, 뭔가 이상한 환각을 본 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760280307,
					"content": "하지만 네가 무사하다니 다행이야! 여긴 이해하기 힘든 일이 너무 많아. 우리 빨리 떠나자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760280312,
					"content": "우으, 그렇게 위험한 물건일 줄이야. 게다가 보물도 못 찾았어…. 대체 왜 이곳에 나타난 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760280313,
					"content": "또 그 빛나던 녀석들이 선령이 아니라면 대체 뭐였던 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760280308,
					"content": "이상한 곳으로 날아간 것 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280309
					]
