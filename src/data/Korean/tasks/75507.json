			"completionStepIds": [
				7550701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7550701",
							"2"
						],
						"stepId": 7550701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"헬카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755070101,
					"content": "#{NICKNAME}, 페이몬, 고마워. 너희가 도와주지 않았다면 이 임무를 해내지 못했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070102
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070102,
					"content": "이제 나도 「조직」에 초대해 줄 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070103
					]
				},
				{
					"id": 755070103,
					"content": "정말 가입하고 싶은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755070104,
					"content": "음, 나이가 좀 걸리긴 하는데… 그보다 다른 사람의 의견을 물어봐야 할 것 같아. 투표로 통과하는 것도 선례가 없었던 일은 아니거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070105
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070105,
					"content": "나중에 노드크라이에 가게 되면 나샤 마을의 「스페란자」에 가 봐. 카르야라고, 우리 조직의 일원은 아니지만 믿을 만한 사람이 있거든. 그녀가 널 도와줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070106
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070106,
					"content": "#알겠어. 그나저나 {NICKNAME}이(가) 싸울 때 사진을 찍고 노트에 그림을 그리던데? 완전 전문가 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070107,
						755070108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755070107,
					"content": "내 전투 기술을 훔치려는 건 아니겠지…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070109
					]
				},
				{
					"id": 755070109,
					"content": "음… 너희한테는 얘기해도 되겠지. 내 임무는 100 종류의 마물에 대한 정보를 수집하는 거야. 너희 덕분에 나타와 폰타인 부분은 완료했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070110
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070110,
					"content": "다음 목적지는 수메르인데… 거기에선 도금 여단한테 의뢰하면 될 것 같아. 하지만 그전에 완성한 도감을 나샤 마을로 보내야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070111
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070111,
					"content": "와, 마물 도감을 만들고 있었구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755070112,
					"content": "응, 노드크라이에는 더 이상 내가 모르는 마물이 없거든. 그래서 다른 지역에 가 보기로 한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070113
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070113,
					"content": "메이시는 겁은 많아도 마물 이야기 듣는 건 좋아해. 도감이 완성될 때마다 메이시한테 줬었는데, 언제나 두 눈을 반짝이며 즐거워했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070114
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070114,
					"content": "걔가 몸이 안 좋아서 멀리 나올 수 없는 게 아쉬워, 아니면 같이 왔을 텐데. 그리고 카르야 말로는 도감이 잘 완성되면 출판할 수 있을지도 모른대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070115
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070115,
					"content": "출판된 도감을 가지고 돌아가서 그 애의 베개 아래 몰래 숨겨두면, 깨어났을 때 깜짝 놀라겠지…? 크흠, 어쩌다 보니 이런 얘기까지 해버렸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070116
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070116,
					"content": "헤헤, 헬카는 친구를 정말 아끼는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755070117,
					"content": "친구보단… 가족에 가까워. 혈연관계는 아니지만. 앗, 이런 얘기는 그만하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070118
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070118,
					"content": "참, 도감의 사본을 너희한테 줄게. 원본 사진은 보관해야 하고 메이시한테도 보내야 해서 줄 수 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070119,
						755070120
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070119,
					"content": "괜찮아, 나도 사진에 대해서 조금은 알고 있으니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070121
					]
				},
				{
					"id": 755070121,
					"content": "그럼 다행이고. 나도 이제 슬슬 다음 목적지로 가야겠네. 아마 며칠 후면 출발할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070122
					],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070122,
					"content": "조심해서 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755070123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755070123,
					"content": "너희도 잘 가. 앞으로 순조로운 여행이 되길 바랄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "헬카"
				},
				{
					"id": 755070120,
					"content": "마물은 언제든 볼 수 있으니까, 상관없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070121
					]
				},
				{
					"id": 755070108,
					"content": "혹시 화가나 영화 감독이라거나…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755070109
					]
				}
			]
		}
	]
}