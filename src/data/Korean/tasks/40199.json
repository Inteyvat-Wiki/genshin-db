				]
			},
			"dialogs": [
				{
					"id": 401990601,
					"content": "수확이 괜찮네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990602
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990602,
					"content": "어떤 핵심 장소로 향하는 문의 열쇠 같아. 전서구 통 안에는 암호로 적힌 짧은 쪽지가 많네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990603
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990603,
					"content": "으익… 정말로 범죄 도구들이 숨겨져 있잖아… 진짜 대담한 녀석들이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401990604,
					"content": "천암군을 관찰하다가 들켜서 조사받을까 봐 안 무서운가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401990605,
					"content": "이 물건들을 봤을 때, 「검은돈 영주」의 감시자는 아마 어민으로 위장했을 거야, 정신력도 엄청난 녀석들일 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990606
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990606,
					"content": "자신은 그저 조용한 곳을 찾아 쉬고 있었을 뿐이라고 주장하면, 천암군도 이렇다 할 증거 없이 일반 시민을 체포해 조사할 순 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990607
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990607,
					"content": "으… 어떤 뻔뻔한 얼굴을 들이밀었을지 상상이 가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990608,
						401990609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401990608,
					"content": "그래도 우리가 이것들을 찾았네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990610
					]
				},
				{
					"id": 401990610,
					"content": "기물을 숨긴 흔적이 아직 선명해. 이곳에 배치된 감시자 중 에들러 경찰관에게 체포되지 않고 활동 중인 녀석이 있단 얘기지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990611
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990611,
					"content": "그러니 조심해. 상대가 우리가 조사 중이라는 걸 눈치채서는 안 되니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990612
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990612,
					"content": "야란은 철저히 준비해 온 듯, 정교한 도구 세트를 꺼내 먼저 열쇠를 복사한 뒤, 쪽지 안의 암호를 기록했다….\\n이후 야란은 현장을 원래 모습으로 되돌려 조사 흔적을 완전히 제거했다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990613
					]
				},
				{
					"id": 401990613,
					"content": "자, 내 추측이 검증됐으니 검은돈 영주가 이곳에 감시자를 뒀다는 건 확실해졌고, 그럼 화물은 어디에 숨겼을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990614
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990614,
					"content": "어떻게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990615,
						401990618
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990615,
					"content": "감이 올 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990616,
						401990617
					]
				},
				{
					"id": 401990616,
					"content": "감시 작전은 시간에 매우 민감하니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990621,
					"content": "완벽한 직감이야. 너한테 많은 암시는 필요 없겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990622
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990622,
					"content": "전서구가 짧은 시간 내에 비행 가능한 거리를 원으로 표시하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990623
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990623,
					"content": "등대의 시야와 사람들의 눈을 피할 수 있는 길을 찾으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990624
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990624,
					"content": "추정해 낼 수 있는 위치는… 명원산 북쪽의 여울인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990625
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401990625,
					"content": "이렇게 보면 상당히 의심스러운 지역이네. 산을 엄폐물로 삼기에도 좋고, 문자 그대로 「등잔 밑이 어둡다」는 말을 활용했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990626
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990626,
					"content": "이걸로 다음 목적지는 확실해졌어, 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야란"
				},
				{
					"id": 401990617,
					"content": "편지 전달이 빨라야겠죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990618,
					"content": "아직 오리무중이에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990619,
						401990620
					]
				},
				{
					"id": 401990619,
					"content": "하지만 중요한 정보를 전달하려면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990620,
					"content": "전서구의 비행시간을 고려해야겠죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990609,
					"content": "이 단서들 덕에 조사에 진전이 있겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990610
					]
				}
			]
