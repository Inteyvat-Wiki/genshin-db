					}
				]
			},
			"dialogs": [
				{
					"id": 401990401,
					"content": "음, 여기부터 조사하면 되겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990402
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990402,
					"content": "야란을 따라 침옥 협곡 북동쪽 인적 없는 곳을 가로질렀다…\\n야란의 지도대로 우리는 은밀한 곳에서 해변을 관찰하며, 「암중에서 관찰하는 감시자」가 됐다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990403
					]
				},
				{
					"id": 401990403,
					"content": "「검은돈 영주」 두목과 직접적인 만남은 하지 못했으며, 주변 환경에도 이상한 점은 발견되지 않았다.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990404
					]
				},
				{
					"id": 401990404,
					"content": "근데… 여긴 그냥 평범한 들판이잖아? 나쁜 놈의 흔적은 하나도 없는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990405,
						401990406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401990405,
					"content": "조급해하지 마, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990407
					]
				},
				{
					"id": 401990407,
					"content": "음, 어떤 역할을 맡아야 하는지 잘 알고 빨리 몰입했구나. 최고 수사 요원 못지않은 속도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990408
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990408,
					"content": "지금 우린 「미끼」가 필요해. 「검은돈 영주」의 장물이란 미끼가. 「핵심 물품」을 찾는 게 사람 찾는 것보다 중요하단 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990409
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990409,
					"content": "장물을 찾으려면 상대의 은신 거점을 확정 짓는 게 가장 중요하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990410
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990410,
					"content": "그것보다는, 여기 시야가 참 좋지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990411
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990411,
					"content": "그러고 보니… 유롱항 항구가 보이고 멀리 물 위의 배랑 탑이 보이네… 저 탑은 뭐 하는 곳이었더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401990412,
					"content": "천암군의 등대야. 평소엔 수역을 감시하고, 필요할 땐 등불 신호로 일정한 통신 역할도 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990413,
						401990419
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990413,
					"content": "이곳의 장점이 뭔지 알겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990414
					]
				},
				{
					"id": 401990414,
					"content": "오? 어떤 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990415,
						401990416,
						401990417
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990415,
					"content": "천암군의 움직임을 엿보는 데 유리하니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990418,
					"content": "십중팔구 그럴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990425
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990425,
					"content": "천암군은 오랫동안 매일같이 순찰 부대를 파견해 침옥 협곡의 주요 지역 치안을 빈틈없이 유지했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990426
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990426,
					"content": "이곳의 시야 이점으로 천암군의 등불 신호를 관찰해 행동 규칙을 추측하면, 「검은돈 영주」의 장물 운송은 상당히 유리해져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990427
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990427,
					"content": "그렇담 주변에 「검은돈 영주」의 감시자가 남긴 흔적이 있을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990428
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990428,
					"content": "너… 너무 복잡해. 무슨 말인지 하나도 못 따라가겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990429
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401990429,
					"content": "어쨌든 이 <color=#00E1FFFF>「영상 기록 장치」</color>로 주변 상황을 조사하고 기록해 봐. 세심히 단서를 찾으면 분명 성과가 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야란"
				},
				{
					"id": 401990416,
					"content": "역정찰하기 딱 좋잖아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990417,
					"content": "위험 노선을 피해 장물을 운송하는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990419,
					"content": "사실 이곳의 특출난 점을 모르겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990420
					]
				},
				{
					"id": 401990420,
					"content": "그냥 한번 맞혀봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990421,
						401990422,
						401990423
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990421,
					"content": "천암군을 관찰하면서 자신은 숨는 거요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990424,
					"content": "봐, 네 직감은 예리하다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990425
					],
					"speakerTitle": "야란"
				},
				{
					"id": 401990422,
					"content": "여기서 감시하면서 주도권을 잡는 거요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990423,
					"content": "거점이 아닌 관찰 장소가 아닐까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990406,
					"content": "아직은 악당을 잡을 때가 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990407
					]
				}
			]
		},
