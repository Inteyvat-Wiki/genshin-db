					"로위"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040401,
					"content": "#에이, 잡혀버렸네…. 엥? {M#오빠}{F#언니}는 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240040402,
					"content": "오렐이랑 베루의 친구야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "아! 걔네들이 말하는 거 들었어. 숨바꼭질 엄청 잘한다고 베루가 그러던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240040404,
					"content": "#오늘 직접 보게 됐네. {M#오빠}{F#언니} 진짜 잘하는구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240040405,
					"content": "패배를 인정할게. 그럼 집합 장소에서 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "로위"
				}
			]
		},
