					"오렐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040201,
					"content": "…이 페이지는 전에 읽었던 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240040202,
					"content": "지금… 책 읽고 있는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "#{M#형아}{F#누나}가 이렇게 빨리 올 줄은 몰랐네요. 이제 막 책을 펼쳤는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240040205,
					"content": "이 책은 로위네 아빠가 주신 건데, 모르는 게 있으면 물어봐도 된다고 하셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240040206,
					"content": "근데… 헤헤, 이 책은 솔직히 이해할 수 있는 부분이 거의 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240040207,
					"content": "#어쨌든 저는 집합 장소로 돌아갈게요. 전 {M#형아}{F#누나}한테 잡힌 거고, 게임을 하려면 규칙을 따라야 하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오렐"
				},
				{
					"id": 240040203,
					"content": "정말 열심히 공부하는구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
		{
			"id": 2400403,
