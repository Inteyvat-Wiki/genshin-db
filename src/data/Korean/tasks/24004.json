			},
			"dialogs": [
				{
					"id": 240040301,
					"content": "#으악! {M#형아}{F#누나} 엄청 빠르네! 방금 다른 곳에 숨으려고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040302
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240040302,
					"content": "에휴, 집합 장소로 돌아가야겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베루"
