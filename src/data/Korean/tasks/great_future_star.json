	"talks": [
		{
			"id": 7367601,
			"completionStepIds": [
				7367601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367601",
							"2"
						],
						"stepId": 7367601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바누"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760101,
					"content": "#{M#오빠}{F#언니}, 어때요? 미래의 별은 찾았나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760102
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760102,
					"content": "여섯 개 다 찾았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760103
					]
				},
				{
					"id": 736760103,
					"content": "헤헤, 잘됐네요. 그럼 이제 거대한 미래의 별을 소환할 수 있겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760104
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760104,
					"content": "#{M#오빠}{F#언니}, 출발 전에 준비 단단히 해두세요. 거대한 미래의 별을 소환할 때 예상 밖의 일이 벌어질지도 모르니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760105
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760105,
					"content": "#제가 특별한 일을 할 때마다 항상 뜻밖의 일이 일어나더라고요. 전 준비 다 됐으니까 {M#오빠}{F#언니}도 조심하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760106
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760106,
					"content": "저번에 집에서 대형 황금 화살을 쐈는데, 갑자기 마당이 폭발했어요. 「사과」가 달려와서 저와 살마를 입에 물고 달리지 않았다면 큰일 났을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760107
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760107,
					"content": "와, 너무 위험한 거 아니야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760108,
					"content": "근데 괜찮을 거예요. 웬만하면 통제 가능한 문제들이니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760109
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760109,
					"content": "마당이 폭발했다고 했잖아! 그건 충분히 큰 문제라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760110,
					"content": "괜찮아요, 무서워할 것 없어요. 준비 다 되면 지도에 표시한 곳에서 만나요. 전 먼저 출발할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760111
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760111,
					"content": "#{NICKNAME}, 나 예감이 안 좋아. 우리 조심해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7367603,
			"completionStepIds": [
				7367602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367602",
							"2"
						],
						"stepId": 7367602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바누"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760301,
					"content": "와! 이제 마지막 장치만 남았어요. 이번 최종 시련은 엄청 간단해 보이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760302
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760302,
					"content": "이번?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760303
					]
				},
				{
					"id": 736760303,
					"content": "그렇네요. 전에 봤던 장치들이 이것보다 훨씬 복잡했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760304
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760304,
					"content": "어떤 것은 여러 방법을 시도해서 유일한 해결책을 찾아내야만 했고, 어떤 것은 틀리면 파괴되어버리기도 해서 엄청 번거로웠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760305,
						736760306
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760305,
					"content": "네가 하는 게 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760307
					]
				},
				{
					"id": 736760307,
					"content": "하지만 제 경험상, 이 장치는 살마가 평소에 집에 가져오는 오래된 하급 장치랑 비슷해요. 모든 열쇠를 끼워 넣으면 풀리는 그런 걸 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760308
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760308,
					"content": "바누, 평소에도 이런 이상한 장치를 많이 만져?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760309,
					"content": "네, 살마랑 「사과」랑 같이 여러 재밌는 곳으로 가서 재미있는 걸 자주 하거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760310
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760310,
					"content": "이번 미래의 별 찾기도 마찬가지예요. 평소에 살마랑 같이 설정을 만드는 것도, 뜻밖의 일이 벌어지는 것도, 엄청 재밌잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760311
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760311,
					"content": "매일 집 앞 근처만 돌아다니고, 매일 똑같은 일만 하면 너무 재미없잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760312
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760312,
					"content": "#그건 동감이야. {NICKNAME}(와)과 나도 자주 익숙한 곳을 떠나 신기한 곳에서 탐험하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760313,
					"content": "무서운 것도 많았지만, 엄청 즐겁고 멋있는 일들도 많았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760314,
					"content": "다행이네요. 저흰 좋은 친구가 될 수 있을 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760315
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760315,
					"content": "하지만 먼저 말해 둘 게 있어요. 이곳저곳을 돌아다니는 건 재밌지만 위험하기도 해서, 전 항상 만반의 준비를 다 하고 다녀요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760316
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760316,
					"content": "살마는 도움을 청할 때 상대방을 잘 관찰해야 한다고 했어요. 보물 사냥단이나 낯선 도금 여단 어른들한테 부탁하면 안 된대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760317
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760317,
					"content": "#{M#오빠}{F#언니}는 착한 사람처럼 보여서 부탁한 거예요. 하지만 착한 언니 오빠들한테 도와달라면서 피해를 줄 수는 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760318
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760318,
					"content": "#그게 제 원칙이니까요. 만약 {M#오빠}{F#언니}가 무섭다면 괜찮아요. 저 혼자서도 이 장치를 해제할 수 있거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760319,
						736760320
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760319,
					"content": "농담이야, 내가 무서워하겠어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760321
					]
				},
				{
					"id": 736760321,
					"content": "#그럼 알겠어요. 어쨌든 {M#오빠}{F#언니}, 걱정 안 해도 돼요. 미래의 별 여섯 개를 전부 장치 안에 넣기만 하면 되니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바누"
				},
				{
					"id": 736760320,
					"content": "위험한 것 같으니, 역시 내가 할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760321
					]
				},
				{
					"id": 736760306,
					"content": "갑자기 할 일이 생각났어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760307
					]
				}
			]
		},
		{
			"id": 7367604,
			"completionStepIds": [
				7367604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7367604",
							"2"
						],
						"stepId": 7367604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"살마",
					"바누"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736760401,
					"content": "바누, 다친 데 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760402
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760402,
					"content": "이 정도는 별것도 아니야. 네가 책에서 그랬잖아. '상대할 수 없으면 바로 도망쳐라'라고. 일찌감치 구석으로 피해 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760403
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760403,
					"content": "맞다, 살마. 왜 「사과」까지 데려온 거야? 지금은 집을 잘 지키고 있어야 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760404
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760404,
					"content": "「사과」가 널 걱정해서 날 따라오더라고. 너도 알잖아, 너랑 네 어머니 말만 듣는 거. 내가 돌아가라고 해도 안 가더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760405,
						736760406
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760405,
					"content": "잠깐만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760407
					]
				},
				{
					"id": 736760407,
					"content": "바누가 저기 갑자기 나타난 머리깃 호랑이를 알고 있나 봐. 「사과」라고도 부르고… 거기다 머리깃 호랑이랑 같이 나타난 사람까지, 이게 대체 무슨 일이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760408,
					"content": "#{M#오빠}{F#언니}, 소개할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760409
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760409,
					"content": "여기 덤벙대는 녀석은 살마예요. 제가 빌려준 《떠돌이 학자가 알아야 하는 50가지》를 썼죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760410
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760410,
					"content": "거대한 미래의 별 소환 의식이 끝나고 살마와 「사과」를 함께 소개해 드리려 했는데, 역시나 이번에도 뜻밖의 일이 생겨버렸네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760411
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760411,
					"content": "하지만 상관없어요, 굳이 찾아가지 않아도 되니까. 이번에 일어난 뜻밖의 일은 마침 잘 일어났네요. 좋았어, 다음번에도 이렇게 운이 좋아야 할 텐데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760412
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760412,
					"content": "안녕하세요, 저는 바누의 생물학적 의미의 아버지, 살마입니다.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760413
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760413,
					"content": "「사과」는 저희 가족의 중요한 일원이죠. 우아한 암컷 머리깃 호랑이랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760414
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760414,
					"content": "생, 생물학적 의미의 아빠? 으… 그게 무슨 뜻이야? 그럼 다른 점에서는 바누의 아빠가 아니란 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760415,
					"content": "그렇습니다. 저는 바누와 평등한 친구라고 생각하거든요. 저와 바누는 일상생활 속에서 집안일을 분담하는 파트너입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760416
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760416,
					"content": "아버지라는 역할은 제가 수행하는 역할들 중 아주 작은 부분에 불과합니다. 아버지보단, 전 바누의 친구가 더 되고 싶으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760417
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760417,
					"content": "방금 장치 밑에 있는 굴에 숨어서 당신들의 대화를 들었습니다. 진심으로 바누를 도와주려는 그 마음에 너무나도 감동했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760418
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760418,
					"content": "천만에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760419
					]
				},
				{
					"id": 736760419,
					"content": "으, 이 지나치게 정중한 말투… 왜 바누가 처음 만났을 때 그런 식으로 우리한테 말했는지 알 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760420,
					"content": "바누의 말투와 처세는 확실히 저랑 닮은 부분이 많지요. 하지만 전체적으로 봤을 때, 바누는 저보다 훨씬 뛰어난 아이랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760421
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760421,
					"content": "일례로, 바누가 만든 덮밥은 제가 만든 것보다 만 배는 더 맛있답니다. 이것만 봐도 충분히 대단한 일이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760422
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760422,
					"content": "그래서, 전 이렇게 즐겁고 활발한 아이와 보내는 시간이 매우 소중하답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760423
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760423,
					"content": "바누는 곧 아카데미아에 들어가겠죠. 매일같이 교실에 틀어박혀 밤늦게까지 머리를 쥐어뜯고, 마흔이 되기도 전에 머리가 하얗게 세고, 오랜 기간 끼니를 거르고 영양 부족에 시달리는 모습을 생각하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760424
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760424,
					"content": "가슴이 찢어지듯 미어지네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760425
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760425,
					"content": "바누가 아카데미아에 들어가기 전, 저는 최선을 다해 바누에게 즐거운 추억을 남겨주고 싶어요. 별을 찾는 여정도 이 목표를 위해 만든 거랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760460
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760460,
					"content": "제가 지맥과 기계학에 대해 좀 알거든요. 그래서 이곳에 설치되어 있던 장치를 살짝 손봤죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760461
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760461,
					"content": "살마, 내 질문에 대답해. 전에 미래의 별을 찾을 때도 그렇고, 방금 전도 그렇고… 저 마물들, 전부 네가 불러낸 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760462
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760462,
					"content": "아냐, 이건… 이건 사고야. 내 실수로 너희들이 위험해져 버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760463
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760463,
					"content": "#사실… 「사과」는 지금까지 네 뒤를 따라다니고 있었어. 그런데 저 모험가 {M#선생님}{F#아가씨}의 실력이 워낙 대단해 보여서, 어쩌다 보니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760464
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760464,
					"content": "살마, 너 정말… 하마터면 큰일 날 뻔했잖아! 나랑 「사과」가 없었으면 어쩌려고 그래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760426
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760426,
					"content": "#{NICKNAME}하고 함께 오래 여행했지만, 이런 이상한 아버지는 또 처음이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760427,
					"content": "이상한가요? 이상한 것도 제 인물 설정 중에 하나랍니다. 그런 평가는 제게 최고의 칭찬이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760428
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760428,
					"content": "이것도 설정의 일부인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760429
					]
				},
				{
					"id": 736760429,
					"content": "네. 안 그러면, 이 혼잡한 세상에서 저도 평범한 사람들과 다를 게 없잖아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760430
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760430,
					"content": "비록 말과 행동이 이상하더라도 저는 커다란 세상 속에서 살아가는 평범한 사람에 불과하겠지만, 엄청난 권위를 가진 현자는 가질 수 없는 헛소리의 자유를 가지고 있지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760431
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760431,
					"content": "아아! 이 얼마나 즐거운 일인가요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760432
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760432,
					"content": "#{M#오빠}{F#언니}, 살마 말 듣지 마. 항상 대충 넘어가고 싶을 때, 이런 식으로 헛소리하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760433
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760433,
					"content": "살마, 내 거대한 미래의 별은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760434
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760434,
					"content": "전에 미래의 별 여섯 개를 전부 모으고 마지막 장치를 해제하면 거대한 미래의 별을 소환할 수 있다며. 거대한 미래의 별 어디 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760435
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760435,
					"content": "안심해. 이번에는 대충 넘어가려는 게 아니니까. 봐봐, 거대한 미래의 별은 여기 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760436
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760436,
					"content": "살마가 주머니에서 별소라를 꺼내 바누에게 준다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736760437
					]
				},
				{
					"id": 736760437,
					"content": "이게 바로 미래의 별을 다 모으고 나서, 광활한 별바다를 건너 바누의 곁에 온 거대한 미래의 별이야. 봐봐, 표면에 빛나는 흰색 별이 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760438
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760438,
					"content": "이 별은 너희가 모은 미래의 별이 합쳐져서 생긴 거야. 이 거대한 미래의 별은 네 것이란다. 저 검은색 입구에 귀를 기울여봐. 별바다가 네게 말을 건네고 있네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760439
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760439,
					"content": "오! 이게 거대한 미래의 별이구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760440,
						736760441
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760440,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760442
					]
				},
				{
					"id": 736760442,
					"content": "그냥 아무 말이나 하는 거지? 이건 리월 바닷가에 널린 별소라잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760443
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760443,
					"content": "어… 살마, 별소라는 다른 설정에서의 이름이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760444
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760444,
					"content": "크흠… 그렇게 말하기도 해. 수많은 사람들의 설정에서 이건 별소라라 불리고, 바다에서 자라나. 하… 하지만 내 설정에서, 이건 거대한 미래의 별이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760445
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760445,
					"content": "아, 이해했다. 살마가 아카데미아 쓰레기 더미에서 주워오는 물건 같은 거네. 내가 「바누의 지혜」라고는 했지만, 다른 사람들은 「아에샤의 혼돈 탐지기」라고 부르는 물건처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760446
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760446,
					"content": "고마워, 살마. 이 거대한 미래의 별 엄청 마음에 들어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760447
					],
					"speakerTitle": "바누"
				},
				{
					"id": 736760447,
					"content": "엥, 이렇게 넘어간다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760448
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760448,
					"content": "이게 왜 넘어가는 거죠? 사람들은 저마다 세상을 바라보는 방식이 있어요. 제 눈에는, 이게 별바다를 건너온 거대한 미래의 별이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760449
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760449,
					"content": "세상을 보는 방식을 하나 더 받아들이는 것도 재밌지 않나요? 하물며 바누도 이 이름을 인정해 줬고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760450,
						736760454
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760450,
					"content": "완전히 변명이잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760451
					]
				},
				{
					"id": 736760451,
					"content": "#세상을 바라보는 방식을 하나 더 받아들인다라… 음, 그럼 {NICKNAME} 배낭 안에 있는 민트를 모라로 봐도 되는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760452
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760452,
					"content": "페이몬은 또 왜 그래…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760453
					]
				},
				{
					"id": 736760453,
					"content": "헤헤, 그러면 여행이 더 행복해질 거 같아서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760458
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760458,
					"content": "걱정 마세요. 아무리 저라도 모라에 대해서는 헛소리할 생각은 없습니다. 두 분에게 의뢰한 일에 대한 보수는 당연히 챙겨드려야죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760459
					],
					"speakerTitle": "살마"
				},
				{
					"id": 736760459,
					"content": "이걸 받아 주세요. 요 며칠 바누를 돌봐주셔서 감사합니다. 영원히 이 일을 잊지 않을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "살마"
				},
				{
					"id": 736760454,
					"content": "일리 있는 거 같기도 하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760455
					]
				},
				{
					"id": 736760455,
					"content": "#말리면 안 되지, {NICKNAME}. 네가 모라를 다른 물건으로 여기고 아무 데나 버린다면, 우리는 망한다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760456
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736760456,
					"content": "그럴 순 없지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736760457
					]
				},
				{
					"id": 736760457,
					"content": "저 살마라는 녀석의 궤변에는 못 당하겠어. 아직 머리가 돌아갈 때 빨리 보수 얘기를 꺼내자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736760458
					],
					"speakerTitle": "페이몬"
