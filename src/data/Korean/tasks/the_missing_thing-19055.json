					"고로"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#{NICKNAME}, 사실대로 말하지 않아서 다시 한번 사과할게. 정말 미안했지만… 나도 어쩔 수 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "고로"
				},
				{
					"id": 190551602,
					"content": "이해해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "참, 코코미도 이 사실을 알고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "산고노미야 님…? 전쟁이 너무 많은 슬픔을 가져다줬고, 우리를 성장하게 했다는 말 밖에 할 수 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "고로"
				},
				{
					"id": 190551605,
					"content": "그래서 안다는 거야 모른다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 190551606,
					"content": "어… 누가 새 상품 법안을 추진했는지 안 궁금해? 간조 봉행은 아닐 거야. 직접적인 이득이 없으니까. 거긴 우리랑 잘 아는 사람도 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "고로"
				},
				{
					"id": 190551607,
					"content": "맞아, 그러고 보니 정말 신의 도움을 받은 것처럼 갑자기 너희들을 도와줬잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 190551608,
					"content": "하하, 신이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "고로"
				},
				{
					"id": 190551609,
					"content": "얼마 전 나루카미섬에서 이로도리 축제를 열었을 때, 나와 산고노미야 님도 초대받아서 참가했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "고로"
				},
				{
					"id": 190551610,
					"content": "그때 난 시장에서 기다리고 있었고, 산고노미야 님은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "고로"
				}
			]
		},
