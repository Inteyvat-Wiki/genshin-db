			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "맞아. <color=#FFCC33FF>바깥세상</color>에는 신기한 일이 많지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "맞아, 바깥세상에는 맛있는 음식이랑 재밌는 게 많아. 흥미로운 경험도 할 수 있고, 대단한 사람들도 많이 사귈 수 있지. 예를 들면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790610203,
					"content": "사물의 아름다운 본질에 전념하는 사람이 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "정말? 난 바깥세상에는 「가치」밖에 없는 줄 알았어. 모자를 쓰고 싶어도 그러지 못하는 사람만 있다고 생각했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "에스노어"
				},
				{
					"id": 790610207,
					"content": "그게… 음, 그러니까… 케이크에 초콜릿이 잔뜩 뿌려져 있는데, 각각의 초콜릿이 전부 다른 맛인 거랑 비슷해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790610208,
					"content": "초콜릿이 전부 같은 맛이면 케이크가 너무 평범해지잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790610209,
					"content": "페이몬, 말을 아주 잘하는데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "이렇게 오랫동안 들었으면 이 정도는 해줘야지. 헤헤, 나름 일리 있는 말이었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790610212,
					"content": "그래? 조… 조금 더 고민해 볼게…. 어쩌면 가볍게 떠나는 여행이라면, 나쁘지 않을 것 같기도 하고…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "에스노어"
				},
				{
					"id": 790610213,
					"content": "조급해 할 거 없어, 에스노어. 다음 출발까진 시간이 많으니까 같이 천천히 생각해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "로젤"
				},
				{
					"id": 790610210,
					"content": "페이몬이 완전히 대화에 스며들었잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "영원히 빛을 잃지 않는 찬란한 이상과…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "꿈을 위해 노력하는 사람들이 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
