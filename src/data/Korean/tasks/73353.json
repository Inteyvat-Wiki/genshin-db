					}
				]
			},
			"dialogs": [
				{
					"id": 733530101,
					"content": "#실례지만, {NICKNAME} 님이신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530102,
						733530103
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530102,
					"content": "네, 맞아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530104
					]
				},
				{
					"id": 733530104,
					"content": "안녕하세요! 휴, 잘못 본 게 아니라 다행이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530105
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530105,
					"content": "제 소개를 해야겠죠. 전 생론파의 다스터, 다르마키르티예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530106
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530106,
					"content": "당신에 대해 들어보긴 했지만, 실제로 어떤 분인지는 잘 몰랐어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530107
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530107,
					"content": "최근 저희는 꿈에 관해 연구하고 있었거든요. 그런데 마침 풀의 신님이 꿈과 현실을 구별하는데 당신만큼 침착한 사람을 본 적이 없다고 알려주셨죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530108
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530108,
					"content": "과찬이세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530109
					]
				},
				{
					"id": 733530109,
					"content": "정말 겸손하시네요. 저희 프로젝트에서는 꿈과 현실에 관한 문제를 다루고 있는데, 데이터를 보면 잠에 들었다가 자의로 깨어나는 게 굉장히 어려운 일이더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530110
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530110,
					"content": "저희는 꿈이 사람의 심리에 미치는 영향과, 다양한 심리 문제를 개선하는 걸 연구하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530111
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530111,
					"content": "구체적으로는, 환자의 상황에 따라 맞춤형 환경 암시와 유도를 통해 적합한 꿈을 제공하는 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530112
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530112,
					"content": "간단하게 말하자면, 저희의 목표는 꿈속으로 들어가 환자의 인지를 조정해서 심리 문제를 개선하는 거랍니다. 환자와 같은 꿈에 들어가는 기술은 아직 미완성 상태예요. 그래도 풀의 신님이 도와주셔서 많은 부분이 개선됐죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530113
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530113,
					"content": "엄청 복잡하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530114
					]
				},
				{
					"id": 733530114,
					"content": "아, 죄송해요. 연구 얘기만 나오면 자꾸 말이 길어지네요. 맞아요, 좀 복잡한 건 사실이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530115
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530115,
					"content": "솔직히 꿈이 심리에 미치는 영향에 대한 의학 연구를 하고는 있지만, 실행 단계에서 한 발짝도 못 움직이고 있어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530116,
						733530117
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530116,
					"content": "제가 도와드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530118
					]
				},
				{
					"id": 733530118,
					"content": "바로 눈치채시다니, 정말 부끄럽네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530119
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530119,
					"content": "저희는 꿈속에서 맑은 의식을 유지하는 데 실패하는 바람에 좌절하고 있었거든요. 당신 같은 분이 계시다니 희망의 불씨가 보이는 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530120
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530120,
					"content": "풀의 신님께도 얼마나 감사한지 모르겠어요. 저희의 보고 내용을 듣고 당신과 상의해 보라고 얘기해주지 않으셨다면 이 프로젝트는 물거품이 됐을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530121
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530121,
					"content": "만약 이 심리 치료법이 보급되면… 아카데미아의 연간 통계에서 정신 질환 수치가 많이 낮아질 거라고 믿어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530122
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530122,
					"content": "그래서 저희를 도와주시겠다는 거 맞죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530123
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530123,
					"content": "물론이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530124
					]
				},
				{
					"id": 733530124,
					"content": "다행이에요! 제가 바로 환자 자료를 정리해 둘게요. 편할 때 언제든지 찾아와 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530125
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530125,
					"content": "먼저 실험 과정에 대해 설명해 드릴게요. 편안한 마음으로 환자와 함께 꿈속으로 들어가면 절반은 성공이라고 볼 수 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530126
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530126,
					"content": "그다음 자료의 안내에 따라 꿈속에서 환자와 관련된 뒤틀리고 이상한 부분을 찾아보세요. 그걸 바로 잡은 다음, 꿈에서 빠져나오기만 하면 끝이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530127
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530127,
					"content": "꿈에서 빠져나올 수 있는 응급조치는 다 마련되어 있으니 걱정하실 필요 없습니다. 실험의 성공보다 도와주신 분과 환자의 안전이 더 중요하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530128
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530128,
					"content": "환자마다 다른 상황이 펼쳐질 테니 적절히 대응하셔야 해요. 그럼 시간 날 때, 언제든 절 찾아주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733530129
					],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530129,
					"content": "그럴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530130
					]
				},
				{
					"id": 733530130,
					"content": "협조해 주셔서 감사해요. 그럼, 나중에 뵐게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "다르마키르티"
				},
				{
					"id": 733530117,
					"content": "도와드리면 보수는 어떻게 계산해 주시나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530118
					]
				},
				{
					"id": 733530103,
					"content": "무슨 일이세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733530104
					]
				}
			]
		}
	]
}