				"points": []
			},
			"dialogs": [
				{
					"id": 401251101,
					"content": "산고노미야 씨는 이 조개를 가지고 가지 않으실 생각인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401251102,
					"content": "전 오히려 이디이아 씨에게 맡겨두는 게 더 낫다고 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 401251103,
					"content": "와타츠미섬에는 이미 새로운 「보물」이 있으니까요. 사람들의 소원도 점점 이뤄져 가고 있고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 401251104,
					"content": "유물은 이 병 안의 신기루를 수호하면서 이곳을 거쳐 가는 여행자들의 꿈과 함께 하는 게 좋을 거 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "산고노미야 코코미"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4012501",
							"2"
						],
						"stepId": 4012501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"콜레이",
					"유라",
					"레시그",
					"클레"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "아루 마을을 통해 가면… 중간에 카라반 수도원과 선나원을 거쳐서… 수메르성으로 갈 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401251202,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401251203,
					"content": "가는 길에 뭐라도 사 갈까? 너희는 고르기만 해. 드는 건 다 내가 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "레시그"
				},
				{
					"id": 401251204,
					"content": "손에 들 수만 있다면 아무리 무거워도 상관없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "레시그"
				},
				{
					"id": 401251205,
					"content": "선물 줄 사람이 뭐 그렇게 많다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401251206,
					"content": "엄마, 알베도 오빠, 진 단장님, 레이저… 그리고 디오나 언니, 모나 언니, 피슬 언니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401251207,
					"content": "난 왜 보는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401251208,
					"content": "아니, 아무것도 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401251209,
					"content": "클레는 사람들에게 무슨 선물을 하고 싶어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401251210,
					"content": "음… 일몰 열매 맛 사탕! 그리고 버섯몬처럼 큰 모자랑, 그리고… 그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401251211,
					"content": "클레는 이야기책을 많이 많이 사서 선물하고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401251212,
					"content": "근데 엄마한테 줄 선물은 아직 못 정했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401251213,
					"content": "괜찮아, 가면서 보면 되지. 언니들이 도와줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401251214,
					"content": "응! 고마워, 언니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클레"
				}
			]
		}
	]
