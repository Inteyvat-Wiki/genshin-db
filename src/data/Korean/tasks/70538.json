			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"잘리아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381501,
					"content": "(난 월권을 행사하고 싶지 않아…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381502
					]
				},
				{
					"id": 705381502,
					"content": "(월권? 갑자기 왜 그런 이상한 단어를 사용하는 거야? 어디서 들어본 것 같기도 한데…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381503,
					"content": "(네 말은 범인을 잡는 건 다른 기사의 역할이라는 거야? 우리가 권한 밖의 일을 해서… 다른 사람의 공로를 가로채면 안 된다고?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381504,
					"content": "(음… 일리 있어! 잘리아가 잘못을 하긴 했지만 흉악한 범인은 아닌 것 같아…. 일반 기사라도 잘리아를 잡을 수 있을 거야)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381505,
					"content": "(일반 기사들에겐 쉽게 공로를 쌓을 수 있는 좋은 기회인데, 그 공로는 우리에겐 아무 쓸모도 없으니까 그냥 넘겨주는 게 좋겠어…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381506,
					"content": "(근데 지금 잘리아가 있는 곳은 너무 외진데. 짧은 시간 안에 기사들이 잘리아를 찾을 수 있을까? 잘리아를 몬드성 근처로 돌려보낼 방법이 있는지 찾아보자)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381507,
					"content": "너희들 뭘 소곤대는 거야? 혹시 내 방생 이론에 관심 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381508
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381508,
					"content": "아! 우리는… 잘리아가 물고기 얘기를 하니까… 갑자기 저녁에 뭐 먹을지 고민돼서 얘기 중이었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381509,
						705381510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381509,
					"content": "갑자기 생선구이가 먹고 싶네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381511
					]
				},
				{
					"id": 705381511,
					"content": "어? 음… 아! 맞아, 맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381512,
					"content": "잘리아, 몬드에 왔으면 몬드 생선구이를 먹어봐야지. 맛있고 먹기도 편해! 그리고… 허니캐럿그릴, 높이 쌓기, 불꽃 미트 스파게티도 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381513,
					"content": "어머! 너희들이 말하지 않았으면 깜빡할 뻔했네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381514
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381514,
					"content": "지금까지 장사에 열중하고 일이 끝나면 자연을 즐기느라 몬드성에서 맛있는 밥 한 끼 먹을 생각을 못 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381515
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381515,
					"content": "현지에 「디어 헌터」라는 식당이 품질이 좋고 저렴한 데다 배달 서비스도 있다고 해서 며칠 동안 먹을 음식을 주문했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381516
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381516,
					"content": "그때 몬드 현지의 특색 요리가 뭔지 묻는다는 걸 깜빡했지 뭐야. 배달원이 캠핑 중인 이곳을 찾을 수 있을지도 모르겠고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381517
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381517,
					"content": "그럼 이따가 몬드성으로 돌아가서 맛있는 식사를 하는 건 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381518
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381518,
					"content": "응! 현지인에게 다른 특산물은 뭐가 있는지 물어봐야겠다. 돌아가서 친구들에게 선물해야 하니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381519
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381519,
					"content": "성문 옆에 보초를 서는 기사가 두 명 있었던 것 같은데 전문가들이니까 좋은 의견을 줄 수 있겠지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381520
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381520,
					"content": "생각난 김에 얼른 해치워야겠다! 지금 바로 가야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381521
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381521,
					"content": "잘리아는 신이 나서 야영지를 떠나 몬드성으로 달려간다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705381522
					]
				},
				{
					"id": 705381522,
					"content": "결국 잘리아가 스스로 기사를 찾아가게 됐네. 이야기 중에 바로 잡히려나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381523
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381523,
					"content": "기사들도 잘리아가 일부러 그런 건 아니라는 걸 곧 알게 되겠지? 고의로 범죄를 저지른 범인이 스스로 찾아오는 경우는 없으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381524,
						705381525
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381524,
					"content": "아마 엄벌은 받지 않을 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381526
					]
				},
				{
					"id": 705381526,
					"content": "응! 잘리아에게 좀 미안하긴 하지만 잘못을 했으니 책임을 져야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381527
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381527,
					"content": "잘리아가 빨리 자신의 실수를 깨달았으면 좋겠다. 그리고 벌을 받고 나서 너무 속상해하지 않았으면 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381525,
					"content": "우리가 부드러운 방식으로 문제를 해결했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381526
					]
				},
				{
					"id": 705381510,
					"content": "몬드 생선구이 드셔보셨어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381511
					]
				}
			]
		}
	]
}