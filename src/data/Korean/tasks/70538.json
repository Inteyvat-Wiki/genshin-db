					"잘리아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705381401,
					"content": "(명예 기사로서 가만히 있을 수는 없어!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705381402
					]
				},
				{
					"id": 705381402,
					"content": "그… 미안해, 친절한 잘리아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381403,
					"content": "네가 무심결에 한 잘못이 큰 사고로 번졌고 이 일은 몬드의 법률과 관련이 있어…. 우리가 나설 수밖에 없으니까 이해해 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705381404,
					"content": "응? 무슨 소리를 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381405
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381405,
					"content": "잠깐만! 너희 왜… 주먹을 매만지는 거야? 사냥하러 가려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381406
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381406,
					"content": "에이, 그럴 필요 없어. 여기 비축한 식자재가 아직 많이 남았거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705381407
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 705381407,
					"content": "으악!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "잘리아"
				}
			]
		},
		{
			"id": 7053815,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"5160",
