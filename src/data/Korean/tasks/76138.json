							9492.938
						],
						"pointId": 14110
					}
				]
			},
			"dialogs": [
				{
					"id": 761380101,
					"content": "앗… 네페르 사장님! 세상에, 마침 잘 오셨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "좀파인코"
				},
				{
					"id": 761380102,
					"content": "결정은 했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761380103,
					"content": "네? 결정이라니… 무, 무슨 말씀을 하시는, 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "좀파인코"
				},
				{
					"id": 761380104,
					"content": "줄곧 「서리달 아이」에 가보고 싶어 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761380105,
					"content": "그래서 넌 리일리키와 안면을 트고, 그걸 계기로 「서리달 아이」를 방문할 생각이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761380106,
					"content": "아… 알고 계셨군요. 하아, 이 일은 마음속에 꼭꼭 숨겨두었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "좀파인코"
				},
				{
					"id": 761380107,
					"content": "좀파인코, 사람은 비밀을 숨길 때 「비밀을 숨기고 있다」는 사실조차 숨겨야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761380108,
					"content": "그렇지 않으면 네 속마음은 새어 나올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761380109,
					"content": "하, 고향에 있을 때도 속마음을 잘 숨기지 못했어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "좀파인코"
				},
				{
					"id": 761380110,
					"content": "이왕 이렇게 된 김에 절 좀 소개해 주실 수 있을까요? 전 외지인이라서, 무턱대고 찾아가면 리일리키 씨께 폐가 될 것 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "좀파인코"
				},
				{
					"id": 761380111,
					"content": "「서리달 아이」 사람들은 하나같이 친절해서, 방문객이 외지인이더라도 따뜻하게 맞이해 줄 거야. 심지어 그게 인간이 아니더라도 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761380112,
					"content": "네? 진짜인가요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "좀파인코"
				},
				{
					"id": 761380113,
					"content": "그래도 무턱대고 찾아가는 건 예의가 아니니 네페르 사장님이 소개 좀 해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "좀파인코"
				},
				{
					"id": 761380114,
					"content": "좋아. 지금쯤이면 식사 배급이 끝났을 테니까, 이야기하기 딱 좋은 타이밍이야. 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761380115,
					"content": "아… 이번엔 돈 안 받을게. 난 그냥 지나가던 길이었으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761380116,
					"content": "감사합니다, 네페르 사장님! 지금 바로 준비할게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "좀파인코"
				}
			]
		},
