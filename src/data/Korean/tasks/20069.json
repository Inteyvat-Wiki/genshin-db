						200690316
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690316,
					"content": "정확히는… 용기에 꽃을 담고, 그 용기를 얼음 옆에 보관하는 방법이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690317
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690317,
					"content": "그분께서 근처 설산의 저온 환경이 적합하다면서 실험을 할 거면 그곳이 좋을 거라고 알려주셨지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690318
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690318,
					"content": "근데 설산은 위험하다고 들었어요. 절 도와줄 모험가도 못 찾았고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690319
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690319,
					"content": "여행자, 꽃이 든 이 상자 3개를 설산의 눈 밑에 묻어줄 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690320,
						200690321
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690320,
					"content": "내게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690322,
					"content": "고마워요. 음… 설산은 되게 크다고 들었어요. 여러 구역이 있을 테니 장소마다 보존 효과도 다 다르겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690323
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690323,
					"content": "음, 효과를 비교해보면 좋을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690324
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690324,
					"content": "이 꽃들을 설산의 <color=#00E1FFFF>일곱신상 근처</color>와 <color=#00E1FFFF>설산 속 동굴 입구</color>에 각각 묻어주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690325
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690325,
					"content": "그리고 다시 <color=#00E1FFFF>설산에서 수역을 찾아주세요</color>…. 호수나 연못도 다 괜찮아요. 그리고 이 상자에 든 꽃을 물가에 보관해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690326
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690326,
					"content": "꽃이 상하지 않게 조심해주시구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690321,
					"content": "어디에다 묻을까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690311,
					"content": "당일 다 팔리면 좋을 텐데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690312
					]
				},
				{
					"id": 200690312,
					"content": "그럼 정말 좋죠. 하지만 매일 꽃이 조금씩 남아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690313
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690313,
					"content": "얼마 안 되긴 해도 꽃들이 이렇게 시드는 게 마음 아파요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690314
					],
					"speakerTitle": "플로라"
				}
			]
		},
