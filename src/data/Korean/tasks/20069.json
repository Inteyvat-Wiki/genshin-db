			"dialogs": [
				{
					"id": 200690201,
					"content": "꽃은 어떻게 됐나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690202,
					"content": "다 묻었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "고마워요, 당분간 꽃들을 설산에 보관하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200690204,
					"content": "후후, 도와줘서 고마워요. 이건 보수니까 받아둬요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "플로라"
				}
			]
