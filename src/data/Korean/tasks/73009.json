				},
				{
					"id": 730090202,
					"content": "(라나를 어서 낫게 해야 하는데…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730090203,
					"content": "(조용히 떠나자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7300903,
			"completionStepIds": [],
