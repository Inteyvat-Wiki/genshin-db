			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "안녕, 무슨 일이니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "갈바리엣"
				},
				{
					"id": 740300102,
					"content": "착한 마녀님, 저희 좀 도와주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "왜 너까지 라느와를 따라 하는 건데? 원하는 게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "갈바리엣"
				},
				{
					"id": 740300104,
					"content": "특별 허가 쿠폰이 아주 많이 필요해! 우리가 할만한 일이 있을까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740300107,
					"content": "너희 설마 에티앙의 게임에 참가하는 거야? 장난은 정도껏 하는 게 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "갈바리엣"
				},
				{
					"id": 740300108,
					"content": "…그러고 보니 너희에게 부탁할 일이 있긴 한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "갈바리엣"
				},
				{
					"id": 740300109,
					"content": "클라인즈가 지금 바다 침식 균열에서 그 무슨 장치였더라… 아무튼 그걸 수리 중일 텐데 너희가 가서 도와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "갈바리엣"
				},
				{
					"id": 740300110,
					"content": "보수는 클라인즈한테 달라고 하면 돼. 클라인즈도 별말 안 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "갈바리엣"
				},
				{
					"id": 740300111,
					"content": "알겠어, 우리에게 맡겨줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740300105,
					"content": "저희가 도울 일이 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "가능하면 보수가 있는 일로!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "페이몬"
				}
			]
		},
