					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "월령"
				},
				{
					"id": 761190103,
					"content": "…하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190104,
					"content": "재밌게 놀고 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761190105,
					"content": "안녕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190106,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "루오노타르"
				},
				{
					"id": 761190107,
					"content": "너도 안녕, 루오노타르",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190108,
					"content": "새로운 놀이를 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "응. 누가 「기함」에서 컵으로 친구랑 이렇게 놀길래 배워왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190110,
					"content": "보석을 컵에 넣고, 테이블 위에서 빠르게 컵을 돌리는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190111,
					"content": "그러고 멈추면, 보석이 어느 컵에 들어있는지 상대방이 맞히는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190112,
					"content": "월령들은 천 속에서 뒹굴거리는 걸 좋아하니까, 마녀의 모자를 본떠서 살짝 변형해 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190113,
					"content": "엄청 귀여워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "월령"
				},
				{
					"id": 761190115,
					"content": "그나저나 「기함」에 갔었구나? 혹시 알아보는 사람 없었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761190116,
					"content": "누가 물어보길래, 이렇게 말했어. 「달의 신처럼 꾸며 봤는데, 닮았지?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190117,
					"content": "기도의 밤 때 그 방법을 잘 써먹고 있구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761190118,
					"content": "사람들이 그걸 믿었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "음… 반신반의하는 것 같았어. 그래도 더 말을 걸진 않더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190120,
					"content": "내 연기가 부자연스러웠나? 다음에 다른 곳에서 더 시도해 봐야겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190121,
					"content": "왠지 재미 들인 거 같기도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761190122,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "루오노타르"
				},
				{
					"id": 761190123,
					"content": "루오노타르가 어디 숨는지 맞혀 보래. 한번 해볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190124,
					"content": "좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "「기함」의 룰대로, 기본 베팅금 10만 모라를 지불해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761190126,
					"content": "그런 건 안 배워와도 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
