			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"호두"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130101,
					"content": "오——! 왔어? 생각보다 빨리 왔네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130102
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130102,
					"content": "페이몬, 말실수 안 했지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130103
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130103,
					"content": "내가 그렇게 못 미덥게 생겼어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111130104,
					"content": "헤헤, 농담이야. 사실 상관없어. 신표를 주셨다는 건 어느 정도 눈치챘다는 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130105
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130105,
					"content": "사실 유령과 영혼에 관해서는 무슨 일이 일어나도 이상할 게 하나 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130106
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130106,
					"content": "그들이 깊게 파고들지 않는 것도 그런 이유에서겠지. 정말로 따라왔다면… 내가 가만히 안 있을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130107,
						111130108
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130107,
					"content": "듣기만 해도 무서워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				},
				{
					"id": 111130109,
					"content": "「생사의 경계」를 지키는 게 왕생당의 가장 중요한 업무잖아. 평소보단 진지하게 임해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130110
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130110,
					"content": "그럼 우린 봐주는 거야? 그 「경계」 넘어가도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111130111,
					"content": "물론이지. 너희들도 이미 맹우 씨처럼 휘말려 들었으니까 좀 더 보게 해줄게 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130112
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130112,
					"content": "이제부터 가서 뭘 보든, 무슨 일이 일어나든 놀라지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130113
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130113,
					"content": "거긴 생사의 경계에 있는 평범한 곳이야. 특별한 점이라면, 아무에게도 알려지지 않았다는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130114
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130114,
					"content": "그러니까 절대 놀라면 안 돼? 아니면 나오기 전에 너희의 기억을 지워버려야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130115
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130115,
					"content": "가자! 내 말을 명심해야 서로가 편할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130116
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130116,
					"content": "무, 무서워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111130117,
					"content": "호두 말대로 어차피 휘말려 들었으니까 끝까지 한번 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111130108,
					"content": "대체 진담이야 농담이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				}
			]
		},
		{
			"id": 1111302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111301",
							"2"
						],
						"stepId": 1111301,
						"stateName": "QUEST_STATE_UNFINISHED"
