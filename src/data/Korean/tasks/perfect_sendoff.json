			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"동오",
					"목석",
					"현명"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111122301,
					"content": "그러고 보니 너희 둘 다 직접 만든 물건인데, 나만 돈 주고 산 거네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "목석"
				},
				{
					"id": 111122302,
					"content": "하지만 네가 가져온 건 우리 것보다 몇 배는 더 비싸잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "동오"
				},
				{
					"id": 111122303,
					"content": "중요한 건 가격이 아니라 어릴 적 우리에게 얼마나 소중했었냐는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "현명"
				},
				{
					"id": 111122304,
					"content": "그리고, 우리한텐 절대 잊어선 안 되는 약속도 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "현명"
				}
			]
		},
		{
			"id": 1111304,
			"completionStepIds": [
				1111304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111304",
							"2"
						],
						"stepId": 1111304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"기억 속의 대범",
					"기억 속의 동오",
					"기억 속의 목석",
					"기억 속의 현명",
					"기억 속의 맹우"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130401,
					"content": "또 해등절이야. 언젠가 직접 가서 등을 볼 수 있었으면 좋겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130402
					],
					"speakerTitle": "기억 속의 동오"
				},
				{
					"id": 111130402,
					"content": "등이 없어도 소원을 빌 수 있어. 엄마가 그랬는데, 꿈을 큰소리로 외치면 나중에 반드시 이뤄진대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130403
					],
					"speakerTitle": "기억 속의 현명"
				},
				{
					"id": 111130403,
					"content": "크, 큰소리로? 그럼… 좀 창피한데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130404
					],
					"speakerTitle": "기억 속의 대범"
				},
				{
					"id": 111130404,
					"content": "누군가 먼저 외치면 네 목소리가 묻힐 테니 괜찮을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130405
					],
					"speakerTitle": "기억 속의 맹우"
				},
				{
					"id": 111130405,
					"content": "맞아! 그럼 동오 네가 먼저 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130406
					],
					"speakerTitle": "기억 속의 현명"
				},
				{
					"id": 111130406,
					"content": "그, 그럼… 난 맛있는 요리랑 간식이 가득한 큰 식당을 차리고 싶어! 절운고추 치킨도 맨날 먹구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130407
					],
					"speakerTitle": "기억 속의 동오"
				},
				{
					"id": 111130407,
					"content": "하하하, 정말 동오스러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130408
					],
					"speakerTitle": "기억 속의 목석"
				},
				{
					"id": 111130408,
					"content": "왜 웃어! 그러는 넌?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130409
					],
					"speakerTitle": "기억 속의 동오"
				},
				{
					"id": 111130409,
					"content": "당연히 돈 버는 거지! 사업을 해서 엄청 많이 벌 거야! 돈만 있으면 뭐든 할 수 있고 얼마나 좋겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130410
					],
					"speakerTitle": "기억 속의 목석"
				},
				{
					"id": 111130410,
					"content": "맞아. 돈만 있으면 그 비싼 장난감 상자도 살 수 있을 거 아냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130411
					],
					"speakerTitle": "기억 속의 맹우"
				},
				{
					"id": 111130411,
					"content": "그뿐이야? 한 사람당 하나, 아니, 여러 개씩 살 수도 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130412
					],
					"speakerTitle": "기억 속의 목석"
				},
				{
					"id": 111130412,
					"content": "목석이가 부자 상인이 되면, 난 돈 벌 필요 없겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130413
					],
					"speakerTitle": "기억 속의 현명"
				},
				{
					"id": 111130413,
					"content": "안 돼! 돈 버는 게 얼마나 힘든데, 너네도 같이 벌어야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130414
					],
					"speakerTitle": "기억 속의 목석"
				},
				{
					"id": 111130414,
					"content": "난 나중에 명소등 만드는 걸 배우고 싶어. 그 엄청 큰 거 말이야. 소등 만드는 법도 배워서 최고의 장인이 될 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130415
					],
					"speakerTitle": "기억 속의 현명"
				},
				{
					"id": 111130415,
					"content": "우와, 그럼 리월항에 안 가도 소등 날리면서 해등절 보낼 수 있겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130416
					],
					"speakerTitle": "기억 속의 대범"
				},
				{
					"id": 111130416,
					"content": "그래서, 맹우랑 대범이는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130417
					],
					"speakerTitle": "기억 속의 동오"
				},
				{
					"id": 111130417,
					"content": "난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130418
					],
					"speakerTitle": "기억 속의 대범"
				},
				{
					"id": 111130418,
					"content": "아, 사라졌어. 제일 중요한 걸 못 들었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111130419,
					"content": "정말 그립군. 이게 우리 다섯 명이 같이 보낸 마지막 해등절이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130420
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111130420,
					"content": "벌써 오랜 세월이 흘러서 다들 어른이 됐네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130421
					],
					"speakerTitle": "대범"
				},
				{
					"id": 111130421,
					"content": "그때 외쳤던 소원들은, 다 이루어졌으려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130422,
						111130423
					],
					"speakerTitle": "대범"
				},
				{
					"id": 111130422,
					"content": "이루어졌어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				},
				{
					"id": 111130424,
					"content": "그 세 사람한테 가서 신표를 받아왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130425
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111130425,
					"content": "동오 씨는 요리사, 목석 씨는 상인, 그리고 현명 씨는 소등 장인이 됐지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130426
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111130426,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130427
					],
					"speakerTitle": "대범"
				},
				{
					"id": 111130427,
					"content": "우으…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130428
					],
					"speakerTitle": "대범"
				},
				{
					"id": 111130428,
					"content": "그때 한 말은 우리 모두 가슴속에 새겨 뒀어. 무슨 일이 있어도 꼭 지켜야 할 약속이라며 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130429
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111130429,
					"content": "아무튼, 일단 이 등부터 날리자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130430
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111130430,
					"content": "#자, {NICKNAME}, 분위기 깨지 말자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130431
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111130431,
					"content": "옛날이야기 중이니까 우린 좀 멀리 떨어져 있는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호두"
				},
				{
					"id": 111130423,
					"content": "다 여기 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				}
			]
		},
		{
