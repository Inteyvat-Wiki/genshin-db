						740910403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740910403,
					"content": "응… 그, 그런 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "발롱"
				},
				{
					"id": 740910404,
					"content": "전혀 안 괜찮아 보여요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "미, 미안하지만… 날 저쪽에 있는 부두까지 데려다주겠어…?",
					"roleType": "TALK_ROLE_NPC",
