			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"지르얍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260201,
					"content": "흠흠… 이미 알고 있겠지만, 아카데미아의 학파는 저마다 연구하는 분야가 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "지르얍"
				},
				{
					"id": 230260202,
					"content": "그렇다면 아카데미아에서 학자가 가장 많고, 생론파 학자 위주로 이루어진 학부는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "지르얍"
				},
				{
					"id": 230260203,
					"content": "아무르타 학부",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "좋아, 정답이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지르얍"
				},
				{
					"id": 230260205,
					"content": "아르무타 학부",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "음, 정답이랑 정반대네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지르얍"
				},
				{
					"id": 230260207,
					"content": "아타무르 학부",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "하하, 아쉽게도 틀렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지르얍"
				}
			]
		},
		{
