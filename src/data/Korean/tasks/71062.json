				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "우리가 언제부터 「친구」였어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "물자, 무기, 정보, 아니면 모라? 다 넘친다구. 우릴 도와주면 전부 보수로 줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620122,
					"content": "저런, 우리 거지 중대장님께서 가장 수치스러운 일을 몸소 도맡아서 하고 계시네…. 정말 잘됐어. 우리 마지막 남은 체면까지 팔아 버리시고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "테무르"
				},
				{
					"id": 710620123,
					"content": "너도 그만 비아냥거려, 비꼬는 말로는 배를 채울 수 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "다닐라"
				},
				{
					"id": 710620124,
					"content": "「우리에 가입하라. 번개 같은 군화의 소리로 하늘땅을 뒤흔들자. 우리와 함께 백야의 극성으로 나아가길 원하는 자를 우리는 절대로 버리지 않을 것이다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "테무르"
				},
				{
					"id": 710620125,
					"content": "저 입 좀 닥치게 만들어 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620126,
					"content": "음… 나쁜 녀석들이긴 하지만 좀 불쌍하긴 하네. 이렇게까지 굶고 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710620127,
					"content": "부끄러운 일이긴 하지만… 보다시피 우린 전투 능력을 상실한 상황이야, 그냥 음식을 좀 구걸하고 싶은 것뿐이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안톤"
				}
			]
		},
