			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"안톤",
					"다닐라",
					"테무르",
					"라도미르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "이 녀석들 엄청 약한데? 두 세 방으로 끝났잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710620702,
					"content": "제발 그만해! 그만 때려! 우리한테 음식을 조금만 나눠준다면 어떤 지시든지 무조건 따를게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620703,
					"content": "흥… 진짜 배가 고픈 모양이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710620704,
					"content": "일단 당신들의 목적부터 알려줘요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "솔직하게 얘기할게, 너희가 어떤 의심을 품고 있든지… 우리의 임무 목표는 층암거연에 있는 재앙의 근원 뿐이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620707,
					"content": "재앙이라니…. 층암거연은 멀쩡하잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710620708,
					"content": "500년 전의 재앙은 전쟁의 전주였을 뿐이야. 칠흑의 강적과 맞서는 전쟁은 늘 지속되어 왔고, 그 전장 또한 항상 우리 발아래 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620709,
					"content": "휴, 우리 상사 중대장님이 큰소리를 칠 정도로 배가 고픈가 보네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "다닐라"
				},
				{
					"id": 710620710,
					"content": "큰소리는 항상 잘 쳤어… 근데 헛소리를 하는 건 처음이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "테무르"
				},
				{
					"id": 710620711,
					"content": "됐어, 됐어… 안토하가 하는 말이 일리가 없는 건 아냐…. 너희들, 그리고 리월 사람들은 우리의 적이 아니라는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710620712,
					"content": "적어도 우리 부대의 적은 아니라는 거지…. 우리와 흩어진 형제들은 어떻게 생각하는지 모르겠지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620713,
					"content": "좋아요… 이번만큼은 도울게요, 다음은 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "제가 당신들을 어떻게 믿죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
