				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"안톤",
					"다닐라",
					"테무르",
					"라도미르",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "휴… 정말 미안해. 우리의 지휘 체계에 작은… 고장이 발생한 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620902,
					"content": "「작은」! 「고장」?! 우린 서로 싸우고 있다고! 외부인이 우리의 전우를 격퇴하는 걸 눈 시퍼렇게 뜨고 보고 있어야만 했다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "다닐라"
				},
				{
					"id": 710620903,
					"content": "그럼? 그들이 우리까지 쓰러뜨리고 우리의 음식을 뺏어가는 걸 지켜보고만 있어야겠니? 입안에 있는 거나 다 처먹고나 말해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "테무르"
				},
				{
					"id": 710620904,
					"content": "안토하 그렇게 쉽게 말하지 마…. 지휘 체계가 고장났다는 건, 끝장이라는 거야. 위관 직급 이상의 모든 장교가 희생됐거나 실종했어…. 철수 외의 선택지는 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710620905,
					"content": "하지만 아직도 후퇴를 원하지 않는 형제들이 많아…. 다들 대장님의 유품을 지키면서 마지막 한 사람이 쓰러질 때까지 싸울 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620906,
					"content": "마지막 한 사람이 배가 고파 쓰러질 때까지겠지…. 협정에 따르면, 위에서 우리한테 음식과 명령을 전달해야 해. 하지만 우린 오랫동안 위의 소식을 전해 듣지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "다닐라"
				},
				{
					"id": 710620907,
					"content": "우인단과 집행관님에 대한 우리의 충성은 의심할 여지가 없어. 하지만 우리도 바보는 아니야…. 지금 같은 상황에선 철수가 상책이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "테무르"
				},
				{
					"id": 710620908,
					"content": "앞으로 어떻게 하실 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "음… 이 일은 너랑 상관없다는 건 알아. 바로 떠나고 싶으면 그렇게 해도 좋아. 하지만 지금 우리가 궁지에 몰린 건 사실이야, 네 도움이 절실하게 필요해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620910,
					"content": "생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "그래… 길 조심하고. 주변에 남아 있는 다른 전우들은 우리처럼 호의적이지 않을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620913,
					"content": "너한테 알려주기 적절한 정보는 아니지만… 지상 가까이에 보급소가 하나 있어. 우리에게 물자를 운송하거나 때로는 명령을 전달하고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620914,
					"content": "전에 몇몇 전우들을 보내 음식 조달을 요청했지만, 다들 지금까지 돌아오지 않고 있지…. 난 더 이상 위험을 감수할 자신이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620915,
					"content": "보급소 쪽에서도 사람이 내려오지 않은 지 꽤 됐고…. 너희가 우리 대신 상황을 좀 살펴 줬으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620916,
					"content": "생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "이런 일을 부탁해서 미안하지만, 지상의 노드 상황을 파악해야 해…. 노드의 상황을 모르면 움직이기 어렵거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710620919,
					"content": "됐어! 그렇게 복잡한 말은 하지 마! 지나가면서 유의할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710620917,
					"content": "도울게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "무슨 일을 도와주면 되죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
