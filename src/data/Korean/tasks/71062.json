				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "왔구나. 어때? 뭐 새로운 소식이라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621102,
					"content": "보급소는 이미 폐기됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "그랬구나… 그럼 뭐 좀 찾은 거라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621104,
					"content": "리월항은 더 이상 당신들을 환영하지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621106,
					"content": "그거 말고 다른 소식은 없어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621107,
					"content": "음… 편지를 하나 찾았는데, 너한테 남긴 편지 같았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710621108,
					"content": "여기요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "편지가 우인단 단원들 사이에서 전달됐다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "아, 언박 동생이구나. 알겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621111,
					"content": "뭐야? 천암군이 다 철수한 거야? 나도 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710621112,
					"content": "휴, 이 녀석들은 대체 어떻게 된 거지…. 우린 분명 천암군을 위해 싸웠던 건데! 우린 분명 동맹이었는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "다닐라"
				},
				{
					"id": 710621113,
					"content": "이제 「동맹」 같은 건 없어! 우린 이미 단절됐어…. 정확히 말하자면, 「우인단」으로서의 우리는 이미 리월과 단절된거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710621131,
					"content": "이건 배신이야! 우린 리월 사람들한테 배신당한 거라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "테무르"
				},
				{
					"id": 710621132,
					"content": "반대일 수도 있지 않을까? 「우인단」인 우리가 그들을 배신한 거라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710621114,
					"content": "웃기는 소리…. 우린 리월 사람들을 지키러 온 거라구! 출발하기 전에 대위가 했던 말 기억 안 나? 이번 원정은 타산도, 음모도 없다고 했잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "다닐라"
				},
				{
					"id": 710621115,
					"content": "하지만 우리가 음모에 당한 것일 수도 있지…. 그건 우리가 어떻게 통제할 수 있는 일이 아냐, 다닐라 형제",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "테무르"
				},
				{
					"id": 710621116,
					"content": "그래, 알겠어. 후… 결정했어, 우린 여기에서 철수할 거야, 빠르면 빠를수록 좋고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621117,
					"content": "괜찮아, 책임은 내가 전부 질게. 우리들 사이에서 탈영병이 나온다면… 그리고 그 탈영병이 제9중대의 이름에 먹칠을 한다면, 그건 나뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621118,
					"content": "다닐라의 말이 맞아. 우린 리월 사람들이 어둠의 재앙에 침식되지 않게 지켜주려고 온 거야, 이렇게 허무하게 떠나선 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710621119,
					"content": "자존심 타령할 때 같아, 미르카? 아직도 모르겠냐고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621120,
					"content": "리월 사람들은 우리의 보호가 필요하지 않아. 우리를 반기지 않는다고! 심지어는 우리의 자랑이었던 전우들을 해치우고 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621121,
					"content": "맞아요, 당신들이 리월 사람들의 신뢰를 저버렸어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "철수할 준비를 하자, 현지의 천암군한테 들키지 말고 최대한 조용하게 움직여야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621124,
					"content": "대위는 우리한테 고향에 돌아가지 못할 각오를 하라고 했어, 적어도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710621125,
					"content": "대위는 그 어떤 이의 희생도 의미가 없게 하지는 않겠다고도 했어! 우리 중대를 희생시키지 말라고도 했었고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621126,
					"content": "적어도 우리가 살아 남으면, 제9중대의 이름은 사라지지 않을 거야, 다들 알겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621127,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710621128,
					"content": "알겠어, 중대장",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "라도미르"
				},
				{
					"id": 710621129,
					"content": "자, 이의 있는 사람? 더 이상의 반대 의견은 듣고 싶지 않아. 이만 해산!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621130,
					"content": "#어쨌든, {NICKNAME}, 도와줘서 고마워. 이 모라와 물자들을 받아 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안톤"
				},
				{
					"id": 710621122,
					"content": "당신들은 퇴로를 생각해 두는 게 좋을 거 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
