						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아란마",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350201,
					"content": "#여긴 아란야마 쪽처럼 마라나의 침식을 당하지는 않은 것 같아. 정말 다행이야. 나라{NICKNAME}, 페이몬. 이게 아슈바타 나무야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350202
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350202,
					"content": "오——이상하게 생겼다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350203,
					"content": "페이몬 실례야! 아슈바타 나무가 화나잖아. 이 나무는 아주 대단하고 제일 오래된 바사라 나무야. 그 어떤 아란나라보다, 그 어떤 아란나라의 이야기보다 오래됐다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350204
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350204,
					"content": "몇 천 혹은 그 이상의 달이 존재하기 전에 아란야니 여왕이 여기서 노래를 불렀어. 그때 그녀는 막 바루카를 떠났는데 수풀이 지금처럼 무성하지 않았고 땅은 모래로 가득했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350205
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350205,
					"content": "그녀의 아란라칼라리는 그 어떤 아란나라의 것보다 강했어. 왜냐하면 그녀의 노래는 「기원의 노래」에 가까웠거든. 덕분에 사르바에 있는 아슈바타 나무는 그녀의 부름에 응해 잘 자라났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350206
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350206,
					"content": "아란야니 여왕이 아슈바타 나무에게 말했지. 숲에 나라가 많은데 그들은 똑똑하고 아름답지만 고독하다고. 그러니까 숲의 백성들을 늘려서 그들의 친구를 만들어주자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350207
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350207,
					"content": "그래서 아슈바타 나무에 예쁘고 속이 꽉 찬 석류 하나가 열렸어. 석류 안에는 수많은 씨앗이 있었는데 그중에 제일 먼저 자란 씨앗이 바로 아란무후쿤다야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350208
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350208,
					"content": "그렇게 아란무후쿤다는 최초의 아란나라가 되었어. 후에 씨앗이 모두 다 자랐고 아란나라는 커다란 나무의 나뭇잎처럼 많아졌지. 우리 아란나라와 나라는 모두 숲의 백성이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350209
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350209,
					"content": "그래서 아슈바타 나무는 대단하고 중요한 거야! 나라가 아이를 낳는 것처럼 모든 아란나라는 아슈바타 나무의 아이이자 아란야니 여왕의 아이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350210
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350210,
					"content": "그렇구나… 미안, 아란마. 아슈바타 나무는 정말 대단하네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350211,
						730350213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350211,
					"content": "친구 어머니에게 이상하다니 정말 예의없다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350212
					]
				},
				{
					"id": 730350212,
					"content": "그런 뜻이 아니었어! 크흠, 아무튼 비야의 열매는 어떻게 해야 돼…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350214,
					"content": "음, 나무의 가지와 잎을 무성하게 하고 꽃을 피우는 데 흙과 비가 필요한 것처럼, 꿈과 기억을 바사라 나무에게 줘야 해. 방금 말했듯이 아슈바타 나무는 가장 오래된 바사라 나무야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350215
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350215,
					"content": "그러니까 우리는 아란지, 아란야마, 아란마하의 바소마 열매를 아슈바타 나무에게 가져다줘야 해. 그럼 아슈바타 나무가 힘을 길러서 위대한 열매를 맺을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350216
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350216,
					"content": "아란지, 아란야마, 아란마하의 바소마 열매? 바사라 나무의 열매 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350217,
					"content": "응, 바사라 나무 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350218
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350218,
					"content": "#나라{NICKNAME}, 좀 더 아슈바타 나무 가까이 가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350219
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350219,
					"content": "와…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350220,
						730350221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350220,
					"content": "신기하다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350222,
					"content": "응, 아란나라는 모두 이 나무에서 태어났어. 너는 지금 모든 아란나라와 연결된 거야. 모든 아란나라에게 축복을 받았으니 아슈바타 나무도 너를 축복하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350223
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350223,
					"content": "화관을 쓰면 아슈바타 나무는 너를 숲의 아이로 받아들일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350224
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350224,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350225
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350225,
					"content": "아슈바타 나무의 상태가 좀 이상하네… 약해진 것 같아. 아마 최근 들어 곳곳에 나타나는 마라나 때문일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350226
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350226,
					"content": "음, 어쨌든 이제 아슈바타 나무의 꿈에 들어가서 꿈 나무에게 바소마 열매를 줘야 해. 그럼 나무도 회복할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350227
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350227,
					"content": "#지난번 아슈바타 전당에서 했던 것처럼 하란 말이지? {NICKNAME}, 손을 뻗어 봐. 그럼 우리가 「뿅뿅」하고 신기한 꿈 속에 도착할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350228,
					"content": "#응! 페이몬 똑똑하네. 나라{NICKNAME}, 준비 다 됐으면 전에 했던 것처럼 손을 뻗어서 아슈바타 나무의 꿈에 들어가는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350229,
						730350234
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350229,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350230
					]
				},
				{
					"id": 730350230,
					"content": "#방금 아란마도 마라나 얘기를 했잖아. 꿈속에서 무슨 일이 일어날지는 모르겠지만 {NICKNAME}(이)가 있으니 별문제 없겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350231,
						730350232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350231,
					"content": "(아슈바타 나무에 손을 뻗는다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350232,
					"content": "준비 좀 하고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350233
					]
				},
				{
					"id": 730350233,
					"content": "응. 준비 다 되면 나한테 말해줘. 내가 함께 갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350234,
					"content": "나 준비 좀 하고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350235
					]
				},
				{
					"id": 730350235,
					"content": "응. 준비 다 되면 나한테 말해줘. 내가 함께 갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란마"
				},
				{
