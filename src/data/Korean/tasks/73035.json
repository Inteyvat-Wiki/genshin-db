				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"아란마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350101,
					"content": "아란마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350102,
					"content": "#응! 나라{NICKNAME}와(과) 페이몬, 이슬이 맺힌 뚠뚠 복숭아처럼 기운이 넘치네. 근데 페이몬은 기쁘지 않아 보여, 악몽이라도 꿨어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350103
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350103,
					"content": "우리를 두고 갈까 봐 걱정했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350104,
					"content": "아? 페이몬 이상해. 난 여기 계속 있었는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350105,
						730350114
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350105,
					"content": "왜 그래, 페이몬?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350106
					]
				},
				{
					"id": 730350106,
					"content": "왜냐면, 왜냐면 바나라나가 꿈속에 있기도 하고 지난번 우트사바 축제가 너무 즐거워서 꿈만 같았거든! 그래서 이게 다 꿈이고 깨어나면 다 없어질까 봐 무서웠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350107,
					"content": "#나랑 {NICKNAME}만 남아서 막 여행을 떠나기 시작했을 때처럼 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350108,
					"content": "하지만 꿈속에 있었던 일은 다 진짜야. 내가 나라를 지켜봤는데 악몽은 나라를 겁쟁이로 만들어. 좋은 꿈은 나라를 기쁘게 만들지. 꿈은 바깥세상에서 일어나는 일과 똑같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350109
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350109,
					"content": "그래서 페이몬이 우리를 꿈에서 봤다 해도, 바나라나를 꿈에서 봤다 해도 그건 진짜 우리, 그리고 진짜 바나라나를 본 것과 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350110,
						730350112
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350110,
					"content": "게다가 아란마도 여기 있잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350111
					]
				},
				{
					"id": 730350111,
					"content": "맞아! 나는 같이 아슈바타 신전에 가려고 여기서 너희를 기다렸어. 그래야만 비야의 열매를 얻고 나라나를 치유할 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350116,
					"content": "#…응, 맞는 말이야. 흥, {NICKNAME}(이)가 우트사바 축제 만찬에 이상한 버섯을 넣어서 내가 이런 생각까지 하게 됐잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350117,
					"content": "가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730350112,
					"content": "게다가 우리는 라나를 도와야 하잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350113
					]
				},
				{
					"id": 730350113,
					"content": "응! 우리 아슈바타 신전으로 가자. 그래야만 비야의 열매를 얻고 나라나를 치유할 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730350114,
					"content": "너무 깊게 생각하지 마. 출발하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350115
					]
				},
				{
					"id": 730350115,
					"content": "응! 아슈바타 신전으로 가서 비야의 열매를 얻자. 그래야만 나라나를 치유할 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "아란마"
				}
			]
		},
		{
			"id": 7303502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
