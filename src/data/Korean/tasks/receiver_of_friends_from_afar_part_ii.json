			"dialogs": [
				{
					"id": 401470301,
					"content": "오늘 아침 시작이 좋네, 오늘도 잘 부탁해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470302
					],
					"speakerTitle": "언소"
				},
				{
					"id": 401470302,
					"content": "당신과 페이몬은 마감까지 정신없이 일했다. 수많은 손님이 오고 손님들의 입맛도 제각각이었지만, 손님들의 평가는 모두 호평 일색이었다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
