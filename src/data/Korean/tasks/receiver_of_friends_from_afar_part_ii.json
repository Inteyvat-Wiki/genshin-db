						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401470201,
					"content": "자, 요리가 나왔어! 맛있게 먹어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470202,
					"content": "우와, 냄새가 정말 향기로운걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470203
					],
					"speakerTitle": "파루잔"
				},
				{
					"id": 401470203,
					"content": "#…아 참, 페이몬이랑 {NICKNAME}도 아직 아침 안 먹었지? 같이 먹을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470204
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470204,
					"content": "어, 도리가 언제부터 이렇게 착했지…. 공짜 아침을 사주다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470205,
					"content": "후후, 큰 사업은 다 식사 자리에서 성사되는 법이야…. 자자! 어서 편하게 앉으라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470206
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470206,
					"content": "(평범해 보이는 요리네. 사전 조사해 본대로라면 별로 비싸진 않겠지! 3만 모라만 안 넘으면 1만 모라까진 뭐…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470207
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470207,
					"content": "#(이 요리가 하룻밤을 새운 보상이 될 수 있을까? …본전을 찾을 수 있을지는 너에게 달렸어, {NICKNAME}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470208
					],
					"speakerTitle": "파루잔"
				},
				{
					"id": 401470208,
					"content": "(힘들고… 피곤하네…. 빨리 자고 싶다…. 어서 먹고 자러 가야지…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470209
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 401470209,
					"content": "다들 각자의 생각을 품고 젓가락을 든다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470210
					]
				},
				{
					"id": 401470210,
					"content": "이건… 닭다리살인가요? 아니, 버섯 돼지고기 식감이 느껴지기도 하네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470211
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 401470211,
					"content": "음, 씹을 때마다 다른 맛이 나…. 자세히 맛보니까 훈제 향도 나고…. 정말 놀랍네. 대체 어떻게 만든 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470212
					],
					"speakerTitle": "파루잔"
				},
				{
					"id": 401470212,
					"content": "햄이요. 햄을 추가했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470213
					]
				},
				{
					"id": 401470213,
					"content": "햄? 대체 어디에… 아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470214
					],
					"speakerTitle": "파루잔"
				},
				{
					"id": 401470214,
					"content": "헤헤, 벌써 눈치챘구나! 맞아, 사실 이 요리는 여러 가지 고기가 뭉쳐진 거야! 나랑 언소가 꽤 고생했다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470215,
					"content": "어… 잘은 모르지만… 고기 종류에 따라 익히는 시간이 다르지 않나요? 그런데 이 요리는 맛이 아주 조화롭네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470216
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 401470216,
					"content": "음… 음… 그건 영업 비밀이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470217,
						401470218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470217,
					"content": "별거 아니야, 요리에 익숙해진 것뿐이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				},
				{
					"id": 401470219,
					"content": "여행자의 특별 요리였구나, 여기까지 온 보람이 있네. 참, 이 요리 이름이 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470220
					],
					"speakerTitle": "파루잔"
				},
				{
					"id": 401470220,
					"content": "아, 소개를 깜빡했네. 이 요리는 「번현급관」이야——고기가 한 가닥씩 겹치는 모습과…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470221,
					"content": "…다양한 식감을 표현한 거구나? 음, 리월의 사자성어에서 따온 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470222
					],
					"speakerTitle": "파루잔"
				},
				{
					"id": 401470222,
					"content": "원래는 다양한 악기를 동시에 연주해서 시끌벅적하다는 뜻인데…. 음, 이 요리에도 잘 어울리네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470223
					],
					"speakerTitle": "파루잔"
				},
				{
					"id": 401470223,
					"content": "어… 알고 있었구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470224,
					"content": "다들 졸업하기 전에 최소 20가지 언어를 배우잖아? 어… 설마 지금은 이런 규정이 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470225
					],
					"speakerTitle": "파루잔"
				},
				{
					"id": 401470225,
					"content": "——네? 예전에 그런 규정이 있었다고요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470226
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 401470226,
					"content": "너도 지론파라는 걸 까먹을 뻔했네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470227,
					"content": "저… 저기… 이 요리 얼마야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470228
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470228,
					"content": "헤헤——얼마 안 해. 단돈 3만 모라야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470229,
					"content": "3… 3만! 하… 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470230
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470230,
					"content": "#그나저나… 페이몬, {NICKNAME}, 아까는 내가 「같이 먹자」고 했지만… 밥을 산다고는 안 했지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470231
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470231,
					"content": "…그러니까 이건… 합석으로 봐야 하지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470232
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470232,
					"content": "——역시 세상에 공짜란 없구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470233,
						401470236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470233,
					"content": "3만 정도는 너한테 얼마 안 되는 돈이잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470234
					]
				},
				{
					"id": 401470234,
					"content": "맞아 맞아! 장사꾼은 신용이 생명이라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470235
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470235,
					"content": "흑… 1모라도 돈이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470239,
					"content": "휴, 그래… 학비 냈다고 생각하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470240
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470240,
					"content": "…수메르에 돌아가면 반드시 사람을 구해서 이 요리를 복제한 다음 큰돈을 벌고야 말겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "도리"
				},
				{
					"id": 401470236,
					"content": "이따가 지배인한테 20% 할인해 달라고 할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470237
					]
				},
				{
					"id": 401470237,
					"content": "이봐… 휴, 어차피 네 기술 때문에 비싼 거니까 아무래도 상관없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401470238,
					"content": "3만에서 20% 할인이라… 흑, 그래도 가슴이 아픈걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "도리"
				},
				{
					"id": 401470218,
					"content": "나만의 특별한 조리법이 있거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				}
			]
		},
