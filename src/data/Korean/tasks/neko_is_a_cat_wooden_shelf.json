			"dialogs": [
				{
					"id": 722090501,
					"content": "소원패 걸이를 정말 잘 고쳤네… 솜씨가 대단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722090502,
					"content": "고마워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "근데 걸려 있는 소원패는… 뭐가 적혀있는지 전혀 알아볼 수 없어. 도대체 얼마나 오래된 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722090505,
					"content": "에츠코 씨! 이것 봐봐요, 근처에서 나무 판자 몇 개를 구해서… 소원패 몇 개를… 만들어봤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722090506,
					"content": "소원패 걸이를 다 고쳤으니 소원패를 몇 개 걸어야지, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722090507,
					"content": "에츠코 씨, 소원 있어요? 제가 대신 적어줄게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722090508,
					"content": "이 신사에 소원패를 걸게…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722090509,
					"content": "하하, 기분이 참 묘하네…내가 직접 적을게, 나한테 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722090510,
					"content": "벌써 소원패 걸 준비가 다 된 거 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722090511,
					"content": "네코한테 가서 알려주자, 분명 기뻐할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722090503,
					"content": "보잘것없는 손재주죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				}
			]
		},
