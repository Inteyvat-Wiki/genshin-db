					"중재"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300101,
					"content": "여행자! 오래간만이야! 별일 없었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300102
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300102,
					"content": "우리 만난 적 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300103
					]
				},
				{
					"id": 700300103,
					"content": "아… 너… 설마 날 잊어버린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300104
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300104,
					"content": "난 「사조성」호의 1등 항해사 중재야. 전에 「사조성」호로 같이 이나즈마도 갔었잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300105
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300105,
					"content": "에이, 당연히 기억하지! 얘가 또 농담하는 거야, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300106,
					"content": "흠——그래! 그렇게 나와야지. 「사조성」호의 1등 항해사를 잊으면 되나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300107
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300107,
					"content": "흠흠, 뭘 도와드릴까요？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300108
					]
				},
				{
					"id": 700300108,
					"content": "아, 내가 아니라 잠깐 우리 함대에 있는 카즈하 아우님 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300109
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300109,
					"content": "기억하지? 이나즈마에서 돌아올 때 카즈하도 같이 돌아왔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300110
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300110,
					"content": "왜인진 모르겠지만, 돌아오던 중에 기분이 좋았는지 사람들을 불러 모아 시를 읊고 노래를 부르더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300111
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300111,
					"content": "근데 우리 배엔 북두 누님이고 소월이 그 녀석이고, 그런… 그런… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300112,
						700300114
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300112,
					"content": "고상한 취미!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300113
					]
				},
				{
					"id": 700300113,
					"content": "그래! 그런 고상한 취미가 있는 사람이 어디 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300116,
					"content": "어쨌든, 카즈하는 리월에 도착하자마자 자연 풍경을 감상하러 갔어. 우리 같은 무식쟁이들한테 질려버렸나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300117
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300117,
					"content": "그런데 얼마 지나지 않아 그가 네 행방을 잘 지켜봐달라고 연락해왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300118
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300118,
					"content": "곤경에 처한 걸까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300119
					]
				},
				{
					"id": 700300119,
					"content": "자세한 상황은 모르겠지만, 널 만나면 자길 보러 와달라고 전해주래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300120
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300120,
					"content": "그렇게 급한 일은 아닌 것 같았는데, 사소한 일이라면 굳이 네가 갈 필요 없지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300121
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300121,
					"content": "#우린 사소한 일도 자주 처리하는걸. 그치 {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300122,
						700300123,
						700300124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300122,
					"content": "맞아요, 비둘기 먹이 주는 일도 하는걸요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300125,
					"content": "오오——너희가 그런 일들까지 도울 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300126
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300126,
					"content": "어쩐지, 누님이 널 맘에 들어 하시더라니. 너의 「친근한」 면을 보신 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300127
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300127,
					"content": "아아! 말이 너무 길었네. 아무튼 카즈하 있는 곳으로 빨리 가봐. 아마 리월항 북쪽에 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300128
					],
					"speakerTitle": "중재"
				},
				{
					"id": 700300128,
					"content": "함대에 일이 있어서 배웅은 못 할 것 같네, 조심해서 가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "중재"
				},
				{
					"id": 700300123,
					"content": "맞아요, 음식 배달도 다니는걸요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300124,
					"content": "맞아요, 청소하러도 다니는걸요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300125
					]
				},
				{
					"id": 700300114,
					"content": "이상한 취미!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300115
					]
				},
				{
					"id": 700300115,
					"content": "아니, 고상한 취미지! 그런 고상한 취미를 가진 사람이 있어야 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300116
					],
					"speakerTitle": "중재"
				}
			]
		},
		{
			"id": 7003002,
			"completionStepIds": [
				7003004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7003004",
							"2"
						],
						"stepId": 7003004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카에데하라 카즈하"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700300201,
					"content": "현은 맑게 울리고 그 밑에 안족은 시들었네, 현을 지탱하느라 홀로 쓸쓸히 이우는구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300202
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300202,
					"content": "여어! 카즈하 아우님! 여기 있었어? 우리가 도우러 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300203,
					"content": "어? 너희들 왔구나. 오랜만이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300204
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300204,
					"content": "페이몬이 「카즈하 아우님」이라고 부르니까 아주 색다른걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300205
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300205,
					"content": "헤헤, 1등 항해사 중재한테 배웠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300206,
						700300207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300206,
					"content": "한가해 보이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				},
				{
					"id": 700300208,
					"content": "하하, 네 눈에 난 어깨에 운명을 짊어지고, 무거운 발걸음을 내디뎌야 하는 사람처럼 보이는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300209
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300209,
					"content": "네가 우릴 찾는다고 해서 왔는데, 여기서 이렇게 풍경을 보며 시나 읊고 있을 줄이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300210,
					"content": "이나즈마에서의 일이 끝나서 더는 미련 없어. 다시 리월에 왔으니, 이곳의 시와 음악을 탐구해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300211
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300211,
					"content": "원래는 부탁할 일이 없었는데, 너희가 늦은 덕분에 지금은 도와줘야 할 일이 생겼네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300212
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300212,
					"content": "엥? 뭐? 원래 없었는데… 지금은 생겼다는 게 대체 무슨 소리야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300213,
					"content": "헛소리하는 걸 보니까 산에서 이상한 음식을 먹은 게 분명해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300214,
					"content": "쉿——들어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300215
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300215,
					"content": "어떤 것 같아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300216
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300216,
					"content": "우와, 이 소리… 각설이의 연주랑 비슷하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300217,
					"content": "흠, 각설이? 나도 한번 만나보고 싶네. 여행자, 넌 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300218,
						700300219
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300218,
					"content": "악기가 고장 났나 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300220,
					"content": "맞아, 하지만 더 중요한 건 이 악기에 기묘한 능력이 있다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300221
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300221,
					"content": "이 이름 없는 고금은 내가 자연을 떠돌아다니다 우연히 버려진 한 동굴에서 찾은 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300222
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300222,
					"content": "낡았지만, 상태는 꽤 괜찮았어. 보자마자 손이 근질거려서 바로 연주해 봤는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300223
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300223,
					"content": "현을 타는 소리가 울리자 난 넋을 잃고 말았어. 꼭 누군가와 함께 연주하는 것 같았거든. 아주 익숙한 느낌이었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300224
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300224,
					"content": "흠, 너 뭔가 환각을 일으킬만한 걸 잘못 먹은 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300225,
					"content": "아닐 거야. 한 곡이 끝나고 나니까 정신이 돌아왔거든. 그때 주변을 둘러보니 역시 뭔가 있더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300226
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300226,
					"content": "그곳에 잡초가 무성한 걸 보면 주인이 떠난 지 오래된 게 분명한데, 의자와 테이블은 아주 깨끗하고 은은한 향기까지 느껴졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300227
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300227,
					"content": "바람 속 소란하던 잡음도 그곳에선 잠잠해졌지. 이렇게 신비한 곳이라면, 리월 전설 속에 나오는 선인의 거처 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300228
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300228,
					"content": "우와아아! 그럼 이 악기, 선인이 남기고 간 보물인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300229,
					"content": "하하, 글쎄? 그때 이 기묘한 일을 당연히 친구한테도 알려야겠다고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300230
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300230,
					"content": "하지만 난 리월에 북두 누님 말고는 친구가 너뿐이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300231
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300231,
					"content": "누님은 이런 일엔 전혀 관심이 없을 테니, 네가 오는 게 좋을 것 같더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300232
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300232,
					"content": "그래서 중재 씨한테 네 행방을 지켜봐달라고 했는데, 아쉽게도 너희가 오기 전에 망가져 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300233
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300233,
					"content": "음, 내 불찰이야. 여기저기 갖고 다니면서 너무 많이 연주했나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300234
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300234,
					"content": "아, 선인의 보물이 망가질 수도 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300235
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300235,
					"content": "번개 신조차도 영원함을 지킬 수 없었으니… 다른 건 말할 것도 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300236
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300236,
					"content": "#흑흑, {NICKNAME}, 우, 우리 속세의 주전자는 꼭 지켜야 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300237
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700300237,
					"content": "다행인 건, 고칠 순 있을 것 같아. 시간이 지나면서 에너지가 고갈돼 휴면 상태에 빠진 것 같거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300238
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300238,
					"content": "그러니까 재료만 잘 찾으면 다시 깨울 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300239
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300239,
					"content": "내가 잘못 들은 게 아니라면 재료는 아마… 유리백합일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300240
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300240,
					"content": "어떻게 알았어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300241
					]
				},
				{
					"id": 700300241,
					"content": "바람은 만물의 속삭임과 함께 세상을 가로지른다고 전에 말한 적 있지? 난 그중 일부를 들을 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300242
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300242,
					"content": "그래서 이 악기의 과거에 대해 조금이나마 알게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300243
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300243,
					"content": "가 봐, 난 여기서 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700300244
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300244,
					"content": "넌 리월항의 영웅이니까, 이 정도는 문제없겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 700300219,
					"content": "엄청 비싼 악기인가 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300220
					]
				},
				{
					"id": 700300207,
					"content": "아무것도 안 하고 쉬고 있구나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700300208
					]
				}
			]
