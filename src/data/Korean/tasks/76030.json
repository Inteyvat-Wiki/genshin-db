			"dialogs": [
				{
					"id": 760300301,
					"content": "이 정도면 충분하겠지? 엄청 많이 채집한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760300302,
					"content": "이제 돌아가자. 그림을 미완성으로 둘 순 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760300303,
					"content": "흐윽… 으앙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "리제카"
				},
				{
					"id": 760300304,
					"content": "앗! 누가 왔어. 일단 숨자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760300305,
					"content": "우으… 여긴 어디지… 엄마… 집에 갈래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "리제카"
				},
				{
					"id": 760300306,
					"content": "「서리달 아이」 사람 같은데, 길을 잃은 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760300307,
					"content": "내가 가서 도와줄게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "정말?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760300309,
					"content": "엥? 당연히 도와야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760300310,
					"content": "「서리달 아이」는 「외부인」을 경계해. 이렇게 늦은 밤에 뿔도 없이 접근하면 놀라서 도망칠 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760300311,
					"content": "하지만… 아무리 그래도 그냥 지나칠 수는 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760300312,
					"content": "음… 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760300313,
					"content": "어?",
