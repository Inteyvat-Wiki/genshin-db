			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사이노"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "더워… 어디 서늘한 곳 없나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100202,
					"content": "조금만 쉬자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "아직 가야 할 길이 머니까 조금만 더 참아. 주변 환경을 봤을 때 여기도 쉬기에 적합하진 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100204,
					"content": "후… 알았어. 사이노 넌 안 더워?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100205,
					"content": "물론 덥지. 하지만 이미 익숙해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100206,
					"content": "무슨 비결이라도 있어? 난 더 못 버틸 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100207,
					"content": "최대한 정신 바짝 차리고, 의지력으로 버티는 거야. 힘을 빼면 더욱 피곤해질 뿐이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100208,
					"content": "한 걸음씩 차근차근 걸어봐. 머리가 몸의 한계를 인식하지 못하도록. 그리고 상대적으로 안전한 곳에 가서 긴장을 푸는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100209,
					"content": "알았어. 근데 안전한 곳은 어디를 말하는 거야? 여기도 꽤 안전한 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100210,
					"content": "봐봐, 여기는 아무것도 없는 사막이고, 주변에 딱히 몬스터도… 으아! 이 전갈들은 어디서 나타난 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100211,
					"content": "조심해, 이놈들 뭔가 이상해…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사이노"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사이노"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "휴… 이곳에 전갈이 있을 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100402,
					"content": "이건 평범한 전갈이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100403,
					"content": "봐, 집게에 번호가 있어. 이건 인간이 사육한 전갈이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100404,
					"content": "그 뜻은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "우리가 경매회에 가는 걸 원치 않는 자가 있는 모양이네. 전갈들을 보내 우리를 포위한 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100406,
					"content": "어차피 주위도 모래로 가득하겠다, 우리가 당해도 알 사람이 없을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100407,
					"content": "위험했어! 우리가 경계를 풀지 않아서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100408,
					"content": "하지만 뭔가 이상해… 사막에는 고정된 길이 없을 텐데, 우리가 여기에 올 줄은 어떻게 안 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100409,
					"content": "#가만히 있어봐, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100410,
					"content": "역시… 이걸 너한테 붙였던 거군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100411,
					"content": "이게 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100412,
					"content": "묘론파가 만든 소형 위치 추적기야. 이걸로 소유자의 대략적인 방향과 위치를 알 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100413,
					"content": "이 장치는 대량 생산 허가가 나지 않았을 텐데, 이건 어디서 구한 거지…? 묘론파 학자가 연루되어 있나? 이상한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100414,
					"content": "이런 게 어떻게 얘한테 붙어 있던 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100415,
					"content": "아마 용병들과 싸울 때 붙여진 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100416,
					"content": "미안해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "당시에 꽤나 혼란스러웠으니까, 못 알아챈 게 당연해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100419,
					"content": "사이노가 발견해서 다행이야. 어서 버려버리자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130100420,
					"content": "…아니, 일단 가지고 있어. 아마 쓸모가 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100421,
					"content": "계속 경매회로 가자. 여기에 오래 있으면 또 위험한 일이 생길 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사이노"
				},
				{
					"id": 130100417,
					"content": "몰랐어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
