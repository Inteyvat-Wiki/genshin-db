						130101003
					]
				},
				{
					"id": 130101003,
					"content": "좋아! 그럼 여기서 좀 쉬다가 사이노한테 돌아가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130101006,
					"content": "주변에 앉아 조금 쉬었다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "시간이 대충 된 것 같은데, 경매회 장소로 돌아가 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130101008,
					"content": "사이노는 건진 게 있을지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130101004,
					"content": "조금 더 가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "더 가려고? 하지만 힘이 다 빠졌는걸… 여기서 조금만 쉬자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
