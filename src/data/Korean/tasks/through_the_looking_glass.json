			"dialogs": [
				{
					"id": 741401101,
					"content": "어라, 또 만났네요. 이번엔 페이몬도 데려왔군요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401102,
					"content": "윽, 지난번에 같이 「명상」으로 이곳에 왔을 때 너도 있었잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741401103,
					"content": "그랬나요? 제가 깜빡했나 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401104,
					"content": "아무튼 덕분에 「수수께끼 거울」의 위치와 꽃이 활짝 피려 하는 장소를 찾을 수 있었어요. 이곳에 대한 이해도가 올랐네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401105,
					"content": "으… 카노틸라는 여전히 알 수 없는 말들을 하는구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741401106,
					"content": "멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "응? 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401108,
					"content": "멍멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "그래, 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401110,
					"content": "(강아지랑 말하는 건가? 설마… 멜뤼진들은 강아지 언어를 할 수 있는 걸까?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741401111,
					"content": "(놀랍네)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "어쩔 수 없지. 그럼 다음에 또 보자. 흥, 그렇게 말해도 난 또 널 만나러 올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401113,
					"content": "#가요. {NICKNAME} {M#오빠}{F#언니}, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카노틸라"
				}
			]
		},
