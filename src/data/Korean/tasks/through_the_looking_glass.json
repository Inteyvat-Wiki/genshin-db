						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "휴, 또 돌아와버렸네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401302,
					"content": "그게 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741401303,
					"content": "사실 저도 제가 제멋대로라는 거 알아요. 다들 제게 잘해주죠, 두 분도 그렇고요. 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401304,
					"content": "현실 세계가 무서울 정도로 지겹다고 생각하지 않으세요? 책 속 세계가 더 아름답지 않나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401305,
					"content": "나도 그렇게 생각해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "어? 그런 생각을 하고 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741401311,
					"content": "전 「게시의 책」 속 세계가 더 아름답다고 생각해요. 이슬 맺힌 꽃잎들로 가득한 데다, 힘들게 강아지와도 친구가 되었거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401312,
					"content": "강아지… 그러고 보니 카노틸라는 강아지 언어를 알아들어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741401313,
					"content": "네? 그럴 리가요. 「게시의 책」의 강아지는 특별해요. 아니, 제가 특별한 걸지도요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401314,
					"content": "전 계속 명상으로 책 속의 세계에 들어갔어요. 그러던 어느 날 멍멍 소리가 언어로 변했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401315,
					"content": "아까 저희가 나눴던 대화는… 강아지가 제게 떠나라고 했어요. 다시는 돌아오지 말라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401316,
					"content": "휴, 그래도 전 해바라기가 가득 핀 풍경을 보고 싶네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401317,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "그, 그렇구나…. 잘 지내, 카노틸라! 우린 이만 갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741401307,
					"content": "그렇지는 않은 것 같은데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "그렇군요…. 그렇게 생각하는 게 정상일지도 모르겠네요. 제가 비정상이고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741401309,
					"content": "둘 다 비슷해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#{NICKNAME} {M#오빠}{F#언니}는 정말 강한 분이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "카노틸라"
				}
			]
		}
	]
}