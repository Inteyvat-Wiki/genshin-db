	"talks": [
		{
			"id": 2301101,
			"completionStepIds": [
				2301101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301101",
							"2"
						],
						"stepId": 2301101,
