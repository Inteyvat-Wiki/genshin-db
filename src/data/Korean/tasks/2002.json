			"dialogs": [
				{
					"id": 20020201,
					"content": "흠, 왜 코빼기도 안 보이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020202,
					"content": "됐다, 그냥 너부터 입장하는 게 좋겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020203,
					"content": "자자, 다들 조용하고 집중해줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020204,
					"content": "드디어 짜릿한 「남십자 무술대회」의 결승전이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020205,
					"content": "수차례의 대결 끝에 드디어 두 선수가 이 순간까지 올라왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020206,
					"content": "먼저, 이쪽은 다들 본 적은 없어도 명성은 익히 들어봤을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020207,
					"content": "#바로 마신 오셀을 벌벌 떨게 만들고, 우인단 집행관도 움찔하게 만든다는 이방에서 온 리월의 영웅, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020208,
					"content": "와아아아아——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "참가자"
				},
				{
					"id": 20020209,
					"content": "목 빠져라 기다렸다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "참가자"
				},
				{
					"id": 20020210,
					"content": "준결승전에서 다들 이 친구의 멋진 경기를 봤겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020211,
					"content": "오늘 결승에선 분명 더 대단한 모습을 보여줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020212,
					"content": "상대 선수는… 흐음, 아직 안 온 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020213,
					"content": "대체 어딜 간 거야. 결승전이라 이전 시합들처럼 기권이라고 판정해버릴 수도 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020214,
					"content": "미안 미안, 다들 조금만 더 기다려줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020215,
					"content": "시간을 착각한 거 아닐까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "어찌 됐든, 기다려도 안 오면 이번 결승은 미루는 수밖에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20020218,
					"content": "잠깐, 뭔가 좀 이상한 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 20020219,
					"content": "상품을 좀 확인해 봐야겠어요. 그 신의 눈을 넣어 둔 상자 말이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, 너도 우리랑 같이 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
