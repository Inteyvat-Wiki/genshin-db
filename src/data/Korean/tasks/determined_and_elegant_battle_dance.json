	"talks": [
		{
			"id": 7352901,
			"completionStepIds": [
				7352901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352901",
							"2"
						],
						"stepId": 7352901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"레피니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735290101,
					"content": "느껴지는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290102
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290102,
					"content": "그대들의 몸짓에서 흘러넘치는 「전투 스텝」의 기운… 너무 찬란해서 눈이 멀 것 같구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290103
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290103,
					"content": "타오르는 검날이 얼굴을 스칠 때면, 상대는 이미 선홍색 줄기를 내뿜고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290104
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290104,
					"content": "두꺼운 얼음 벽을 감싼 축이 우아하게 회전할 때, 그대들의 발끝은 어긋난 리듬을 밟고 있겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290105
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290105,
					"content": "무너지는 거대한 성벽이나 강철 거인의 군대 앞에서도, 그대들은 그림이나 카메라로는 담을 수 없는 민첩한 움직임을 선사할 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290106,
						735290107
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290106,
					"content": "무슨 말인지 모르겠어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290108
					]
				},
				{
					"id": 735290108,
					"content": "경외할 만한 패기로군. 역시 그대들은 내 지음이 될 자격이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290109
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290109,
					"content": "난 「검무자」 레피니라고 한다. 그대들의 이름은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290110
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290110,
					"content": "윽, 이 과장된 말투는 대체…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290111,
					"content": "#난 페이몬이고 이쪽은 {NICKNAME}(이)야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290112,
					"content": "우리 실력이 대단한 건 사실이지만, 네가 말을 너무 복잡하게 해서 전혀 못 알아듣겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290113,
					"content": "검도 없고 춤을 추는 사람 같아 보이진 않는데, 왜 스스로를 「검무자」라고 칭하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290114,
					"content": "날카로운 질문으로 내 성품을 시험하려는 거로군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290115
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290115,
					"content": "제한된 무기가 아닌 가슴속에 품은 검을 사용해, 필요할 때 물건에 결의를 투영하고 속박에서 벗어난 전법을 구사한다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290116
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290116,
					"content": "검무자에게 있어 겉치레는 중요하지 않아. 전장이라는 무대에 오르는 순간부터, 화려한 몸짓과 우아한 기법으로 모든 걸 지배할 뿐이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290117,
						735290118,
						735290119
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290117,
					"content": "그러니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290120,
					"content": "핵심을 제대로 파악했군! 하지만 가장 중요한 「결의」와 「우아함」을 빠뜨려선 안 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290121
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290121,
					"content": "잠깐… 그렇군! 그대들은 이미 결의와 우아함을 내재한 채 나와는 비교도 안 되는 경지에 오른 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290122
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290122,
					"content": "그렇다면 더 지체할 것 없이 어서 이 문을 지나 「검의 왈츠」의 무대에 올라서 주길. 그대들의 우아한 춤사위를 보고 싶군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290123
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290123,
					"content": "「검의 왈츠」에 들어가면 강적들이 그대를 완전히 무너뜨리기 위해 환영의 형태로 공격해 올 거다. 이디이아 씨가 도와준 덕분이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290124
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290124,
					"content": "가슴속 「결의」를 완전히 개방하는 순간, 그대는 마음속 가장 깊은 곳에 있던 검을 뽑아 강적을 처치할 수 있게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290125,
						735290126
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290125,
					"content": "알 것 같아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290127
					]
				},
				{
					"id": 735290127,
					"content": "그렇다. 무엇과도 비교할 수 없는 통쾌함의 극치라고 할 수 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290128
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290128,
					"content": "그럼 난 이곳에서 명상하며 좋은 소식을 기다리고 있겠다! 독보적인 검투의 춤을 즐겨보길!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290129
					],
					"speakerTitle": "레피니"
				},
				{
					"id": 735290129,
					"content": "으윽, 둘이 점점 대화가 통하는 느낌이야…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290130,
					"content": "난 이제야 알아들었다구. 방금 우리 전투 실력이 뛰어나다고 칭찬한 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290131,
					"content": "시련 비경을 관리하고 있으니까 우리 전투 솜씨를 직접 보려는 게 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290132,
					"content": "전투를 춤에 비유하다니 좀 이상하긴 하지만… 도전한다고 해서 나쁠 건 없을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290133,
					"content": "간단한 일을 심오하게 부풀리는 것도 일종의 능력이겠지? 우리도 이 화법을 배우면… 누굴 만나든 상대를 긴장시킬 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290134,
						735290135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290134,
					"content": "상대를 긴장시키는 건 자신 있는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290136
					]
				},
				{
					"id": 735290136,
					"content": "흠, 칭찬은 간단한 화술이니까. 레피니랑 많이 대화해보면 전부 배울 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290137,
					"content": "그럼 우리 「검의 왈츠」에서 멋지고 통쾌하게 전투해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290138,
					"content": "#다음엔 레피니가 또 어떤 과장된 평가를 해줄까…? {NICKNAME}, 나중에 써먹어야 하니까 그때가 되면 꼭 기억해 두자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735290135,
					"content": "우리 칭찬을 잘해주시는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290136
					]
				},
				{
					"id": 735290126,
					"content": "통쾌한 전투 시련인 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290127
					]
				},
				{
					"id": 735290118,
					"content": "옷은 중요하지 않단 말이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290119,
					"content": "뭐든지 무기가 될 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290107,
					"content": "그래도 더 칭찬해 주세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290108
					]
				}
			]
		}
	]
}