				"points": []
			},
			"dialogs": [
				{
					"id": 732950601,
					"content": "응? 「후추」잖아? 뭔 지키고 있는 것 같은데…. 잠깐, 이 기시감은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732950602,
					"content": "(우리를 알아본 건지 꼬리를 흔든다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950603
					],
					"speakerTitle": "개"
				},
				{
					"id": 732950603,
					"content": "어… 설마 줄리앙의 스케치를 지키고 있던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732950604,
					"content": "「후추」가 짧게 두 번 짖더니, 빠르게 자리를 떠난다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732950605
					]
				},
				{
					"id": 732950605,
					"content": "또 가버렸네. 지난번에도 이러더니…. 그나저나 츄츄족은 그림을 어디에 쓰려던 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950606,
						732950608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732950606,
					"content": "장식품으로 쓰려던 걸지도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950607
					]
				},
				{
					"id": 732950607,
					"content": "음… 정말 그런 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732950608,
					"content": "설마 진짜 휴지 대용으로…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950609
					]
				},
				{
					"id": 732950609,
					"content": "#으악——{NICKNAME}, 어떻게 그런 더러운 생각을!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
