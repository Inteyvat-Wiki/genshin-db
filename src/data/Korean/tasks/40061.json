				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "와타츠미섬에 남풍이 불어서 손님이 오실걸 예상하고 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 400610102,
					"content": "네가 그렇게 말할 때마다 항상 귀찮은 일이 생겼던 거 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400610103,
					"content": "그렇게 말하지 마세요. 저희는 파트너잖아요? 최고의 파트너",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 400610104,
					"content": "사실 부탁할 일이 있긴 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 400610105,
					"content": "저희 선조가 산호궁 와타츠미 어령 제사 외에 다른 시련을 추가했다는 소문이 있어요. 와타츠미섬의 존망과는 무관하지만, 진실과는 연관되어 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 400610106,
					"content": "다른… 시련?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400610107,
					"content": "와타츠미섬의 존망이 달려있던 위기는 해결되었으니 전해내려온 의무와 책임을 기반으로 말씀드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 400610108,
					"content": "「뱀의 심장」이라고 불리는 곳으로 가서 두 번째 시련에 대한 단서를 찾아보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 400610109,
					"content": "휴, 드디어 해방이다, 홀가분하네요. 이제 이 무거운 짐은 미래의 딸에게 건네주면 되겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 400610110,
					"content": "선조로부터 전해 내려온 의무가 그 한마디로 끝난 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400610111,
					"content": "…난 아직까지도 츠유코의 생각을 잘 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}