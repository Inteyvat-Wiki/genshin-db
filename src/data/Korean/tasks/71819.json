			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "어때, 소등은 가져왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "채락"
				},
				{
					"id": 718190602,
					"content": "가져왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "어디 보자… 맞아, 이 소등이야. 정말 고마워. 난 이걸 아이들에게 주러 가야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "채락"
				},
				{
					"id": 718190604,
					"content": "시간이 꽤 지체돼서 아이들이 아직 그 자리에 있을지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "채락"
				},
				{
					"id": 718190605,
					"content": "선물에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "이거 총무부에서 보낸 거지? 그럼 잘 받을게. 멀리까지 와줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "채락"
				},
				{
					"id": 718190607,
					"content": "이것도 천암군이 해야 할 일이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "소등을 찾아주는 거 말이니? 하하하, 물론이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "채락"
				},
				{
					"id": 718190609,
					"content": "소등을 찾아주고 나쁜 사람을 쫓아내거나 마물을 처치하는 일…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "채락"
				},
				{
					"id": 718190610,
					"content": "도움이 필요한 사람을 도와주는 것도 다 천암군이 해야 할 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "채락"
				},
				{
					"id": 718190611,
					"content": "자, 난 이제 그 아이들에게 소등을 돌려주러 가야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "채락"
				},
				{
					"id": 718190612,
					"content": "또 처리해야 할 일이 있어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "채락"
				}
			]
