			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"일현"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190401,
					"content": "으앙… 나, 난 아직 소원을 다 못 썼는데… 흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "일현"
				},
				{
					"id": 718190402,
					"content": "현아, 착하지. 천암군 아저씨가 가지러 가셨어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "일주"
				},
				{
					"id": 718190403,
					"content": "채락 씨에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "그 천암군 아저씨를 찾고 있는 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "일주"
				},
				{
					"id": 718190405,
					"content": "방금 현이가 소등에 소원을 쓰다가 실수로 날려버렸거든요. 저쪽으로요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "일주"
				},
				{
					"id": 718190406,
					"content": "그 천암군 아저씨가 현이 소등이 나무에 걸려있는 걸 보셨대요. 그 아저씨가 소등을 가져다주신다고 했어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "일주"
				},
				{
					"id": 718190407,
					"content": "그 소등이 특별한 거니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "저도 현이한테 그렇게 말했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "일주"
				},
				{
					"id": 718190410,
					"content": "흑… 싫어. 그건 오빠가 한참 걸려서 만들어 준 거란 말이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "일현"
				},
				{
					"id": 718190411,
					"content": "현아, 뚝. 천암군 아저씨는 금방 돌아오실 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "일주"
				},
				{
					"id": 718190412,
					"content": "죄송해요. 그 천암군 아저씨에게 급한 볼일이 있으면 저쪽으로 가보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일주"
				},
				{
					"id": 718190408,
					"content": "다시 만들면 안 돼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
