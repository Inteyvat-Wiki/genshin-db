			},
			"dialogs": [
				{
					"id": 718190201,
					"content": "엇? 난 공무 집행 중인데 무슨 일이니…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "향명"
				},
				{
					"id": 718190202,
					"content": "해등절 선물에 대해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "목소리 낮춰! 난 공무 집행 중이라니까. 무슨 선물인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "향명"
				},
				{
					"id": 718190204,
					"content": "총무부에서 보낸 거라고? 아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "향명"
				},
				{
					"id": 718190205,
					"content": "휴, 또 해등절이구나. 올해는 일찍 집에 돌아가려고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "향명"
				},
				{
					"id": 718190206,
					"content": "하지만 여기 상황을 보니까 정신 팔면 안 되겠어… 아무래도 며칠 후에나 집에 갈 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "향명"
				},
				{
					"id": 718190207,
					"content": "선물 전해주러 와줘서 정말 고마워. 수고했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "향명"
				},
				{
					"id": 718190208,
					"content": "휴, 저 사람은 대체 언제쯤 가려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "향명"
				}
			]
		},
