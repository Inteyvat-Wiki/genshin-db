				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190301,
					"content": "이 우물 물이 대체 왜 이런 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190302
					],
					"speakerTitle": "홍의"
				},
				{
					"id": 718190302,
					"content": "해등절 선물에 대해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190303
					]
				},
				{
					"id": 718190303,
					"content": "아, 이거 총부부에서 보낸 거지? 그럼 받을게, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190304
					],
					"speakerTitle": "홍의"
				},
				{
					"id": 718190304,
					"content": "근데 난 한동안 여기서 근무해야 되거든. 사람들이 축제 기간에 물을 뜨러 올지도 몰라서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190305
					],
					"speakerTitle": "홍의"
				},
				{
					"id": 718190305,
					"content": "휴, 이유는 모르겠지만 이 우물 물은 이제 마실 수 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "홍의"
				}
			]
		},
		{
			"id": 7181904,
			"completionStepIds": [
				7181905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
