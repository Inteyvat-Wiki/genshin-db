			"dialogs": [
				{
					"id": 402050101,
					"content": "안녕, 라우마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402050102,
					"content": "#{NICKNAME}와(과) 페이몬? 달빛이 밤낮으로 우리를 이어 주기를. 음… 고민이 있으신 것 같은데, 편히 말씀하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050103
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 402050103,
					"content": "역시 눈치챘구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402050104,
					"content": "달빛 아래 얼굴은 보름달의 그림자처럼, 음영이 드리워진 속마음을 드러내는 법이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050105
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 402050105,
					"content": "일단 아이노는 나서지 말라고 하자…. 달을 읊는 사자님, 내가 설명할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050106
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 402050106,
					"content": "야호다가 일행이 여기 온 이유를 아주 조심스럽게 설명한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402050107
					]
				},
				{
					"id": 402050107,
					"content": "…도둑질이요? 그런 부도덕한 짓을… 서리달 아이라면 부끄러워해야 할 일이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050108
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 402050108,
					"content": "지금은 추측일 뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050109
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 402050109,
					"content": "잠시만 기다려 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050110
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 402050110,
					"content": "며칠 전에 부족 사람들이 기계를 하나 가져오긴 했습니다. 따라오세요, 직접 만나서 따져보면 진실이 드러나겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라우마"
				}
			]
		},
