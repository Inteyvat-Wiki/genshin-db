			"dialogs": [
				{
					"id": 402050201,
					"content": "제… 제발 진정해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050202
					],
					"speakerTitle": "아초"
				},
				{
					"id": 402050202,
					"content": "아이노!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050203,
						402050206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402050203,
					"content": "더 이상의 소란은 안 돼, 아이노!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050204
					]
				},
				{
					"id": 402050204,
					"content": "하지만, 쟤들이 통통 달콤이를 없애겠다잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050205
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 402050205,
					"content": "우리가 그렇게 놔둘 리 없잖아. 이렇게 구는 건 해결 방법이 못 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402050209,
					"content": "큰일이야! 비행 기계들이 우리 창고를 급습해서, 그 기계를 빼앗아 갔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050210
					],
					"speakerTitle": "헬미"
				},
				{
					"id": 402050210,
					"content": "이 타이밍에? 설마 우리가 이 여자아이와 부딪히는 틈을 노리고 있었던 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050211
					],
					"speakerTitle": "아초"
				},
				{
					"id": 402050211,
					"content": "윽, 정찰 유닛이 엄청 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402050212,
					"content": "분명 그 암시장 상인들이 보낸 걸 거야. 역시 우릴 감시하고 있었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050213
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 402050213,
					"content": "#{NICKNAME}, 내가 여기에 임시로 월령의 길을 만들게. 너희는 월령을 불러와 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050214
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 402050214,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050215
					]
				},
				{
					"id": 402050215,
					"content": "좋아, 녀석들을 전부 격추시키자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402050206,
					"content": "네 동료에게 무슨 일이 생기게 하지 않을게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402050207
					]
				},
				{
					"id": 402050207,
					"content": "그래, 우리를 믿고 일단 진정해. 이렇게 소란을 피우는 건 좋은 방법이 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402050208,
					"content": "난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402050209
					],
					"speakerTitle": "아이노"
				}
			]
