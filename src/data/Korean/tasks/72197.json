			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쵸지"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "이 정도 수정 골수면 충분해요. 이제 저도 모험하러 출발해볼게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401903,
					"content": "몸조심해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "자주 연락해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "좀 걱정되는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401905,
					"content": "네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401906,
					"content": "야, 쵸지, 다시는 거짓말하지 마! 우리를 만나서 다행이지… 다른 사람이었으면 큰일 났을걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401907,
					"content": "그리고 나쁜 사람 만나서 떠보고 싶으면 절대 사실을 말하지 마! 다 지어내라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401909,
					"content": "페이몬이 언제 이렇게 말이 많아졌냐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "그리고 또…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401911,
					"content": "난 믿어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "이렇게 어린아이가 혼자 모험을 가는데 누가 걱정을 안 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401912,
					"content": "…진짜",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401913,
					"content": "하하하하! 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401914,
					"content": "다음에 꼭 다시 만나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401915,
					"content": "꼭 조심해야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401916,
					"content": "알겠어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401917,
					"content": "저는 타타라스나로 갈 거 같아요. 엄마가 거기서 일을 한 적이 있거든요. 엄마가 거기를 거쳐 갔는지 아는 사람이 있을 수 있으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401918,
					"content": "그리고… 나루카미섬도 가볼 거예요. 그리고 스네즈나야로 가는 배를 타고… 그다음 일은 그때 가서 생각할래요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401920,
					"content": "지금 자기가 무슨 말 하는지 알고 있기는 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "너에게 곧 다가올 위험을 알고 있기는 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401922,
					"content": "다가올 위험이 무서워서 아무것도 안 하면… 세상에 모험가라는 직업은 없었겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401924,
					"content": "어쩔 수 없네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "조심해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "와… 꼬맹이 정말 짜증 나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401926,
					"content": "하하하, 걱정하지 마세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401927,
					"content": "#여러분도 조심히 가세요! 그리고 {NICKNAME} 님도 꼭 가족을 찾기를 바라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401928,
					"content": "그래! 네 말대로 됐으면 좋겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
