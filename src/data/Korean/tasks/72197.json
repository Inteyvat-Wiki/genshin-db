					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402003
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721402005,
					"content": "라고 말하고 싶지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402006
					]
				},
				{
					"id": 721402004,
					"content": "「…급히 쓸데가 있어서, 우우…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402005
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721402007,
					"content": "여행은 어땠어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "하하하하하, 당연히 아니죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721402008,
					"content": "괜찮았어요. 아직 엄마의 흔적을 찾지는 못했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402009
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721402010,
					"content": "최선을 다해 도와줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402011
					]
				},
				{
					"id": 721402009,
					"content": "#괜찮아, 우리도 도와줄게, 괜찮지? {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402010
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721402011,
					"content": "#역시 믿을 사람은 {NICKNAME} 님밖에 없네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쵸지"
				}
			]
