				"points": []
			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#안녕하세요, {NICKNAME} 님! 잘 지내시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401703,
					"content": "내 대사를 페이몬이 뺏어가네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "잘 지내지, 너는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401705,
					"content": "페이몬 간식이 먹고 싶구나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "하하, 네가 느린 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401707,
					"content": "내 뜻은 네가 「간식」이 된다는 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "맞아, 필요해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401708,
					"content": "야——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401709,
					"content": "풉… 하하하하하!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401710,
					"content": "자자, 싸우지 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401712,
					"content": "그래, 무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "최선을 다해 도와줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "전 여기서 잘 지내고 있어요. 근데 부탁 하나만 해도 될까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401714,
					"content": "#음, 특별한 건 아니고, {NICKNAME} 님이 수정석을 채굴해 줬으면 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401716,
					"content": "난 널 믿어, 하지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "절 믿어주세요. 이번엔 정말 보답할게요… 절 믿어만 주신다면",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401718,
					"content": "왜?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "저번에 상황 설명해 주기로 약속했었잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "하지만…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401720,
					"content": "맞아, 우린 네가 수정 골수가 왜 필요한지도 모른다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401722,
					"content": "막부가 수정석 시장을 독점했잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "수정석 팔기 힘든 거 알지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "음… 여행할 돈이 있어야 엄마를 찾을 수 있으니, 광석을 팔아서 돈을 모으고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401725,
					"content": "너 지금 위험한 일을 하고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "네가 걱정돼서 그래",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "그건 제가 알아서 생각할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401727,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401728,
					"content": "쵸지, 우리 친구 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401729,
					"content": "이번에도 우리가 도와줄 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401731,
					"content": "그게 무슨 논리야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "우리한테 보답한다고 약속했잖아. 근데 네가 위험해지면 우리가 보수를 못 받겠지. 그러니 우리도 알 권리가 있어, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401732,
					"content": "풉… 페이몬 말이 맞네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401733,
					"content": "수정석 모으는 건 돈 때문만은 아니에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401734,
					"content": "그냥… 만약 부모님 모두 다른 사람처럼 「재앙신」 때문에 병에 걸렸다면",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401735,
					"content": "이 수정석들은 거대한 뱀에서 나왔으니까, 수정석으로 약을 만들 수 있을지도 모르잖아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401736,
					"content": "그리고 야스모토 선생님도 수정석이 유용할 수 있다고 말한 적 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401737,
					"content": "근데… 그게 100% 정확한 가설은 아니잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721401738,
					"content": "네, 하지만 다른 방법이 있는 건 아니잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401739,
					"content": "부모님을 찾으면… 수메르로 데리고 가서 이 기괴한 병을 치료하는 방법을 찾을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401740,
					"content": "그전에 모든 방법을 다 시도해봐야죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401742,
					"content": "도울 테니 걱정 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "이 수정석들을 잘 활용했으면 좋겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "자자, 이 정도면 설명된 거 같은데 도와주실 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721401744,
					"content": "감사합니다! 영원히 잊지 않을게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쵸지"
				}
			]
		},
