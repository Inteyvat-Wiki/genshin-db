			"dialogs": [
				{
					"id": 721971801,
					"content": "#{NICKNAME} 님, 돌아오셨네요. 수정석은 구하셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721971802,
						721971803
					],
					"speakerTitle": "쵸지"
				},
				{
					"id": 721971802,
					"content": "가지고 왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721971803,
					"content": "이제 가지러 가려고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721971804
					]
				},
				{
					"id": 721971804,
					"content": "천천히 여기서 쉬다가 가도 돼요",
					"roleType": "TALK_ROLE_NPC",
