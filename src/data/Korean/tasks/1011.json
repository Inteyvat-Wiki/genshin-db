	"talks": [
		{
			"id": 101101,
			"completionStepIds": [
				101101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101101",
							"2"
						],
						"stepId": 101101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"석두"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110101,
					"content": "어서 오세요, 손님. 「해취항」입니다. 「박석」 두 개로 운세 한번 보시겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110102
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110102,
					"content": "가격도 저렴합니다. 재물운도 불러오고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110103
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110103,
					"content": "「박석」? 그건 됐어, 우린… 무슨 돌 사러 왔더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110104,
					"content": "야박석. 최소 「촉조」급은 되는 걸로 주시게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110105
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110105,
					"content": "「촉조」급의 야박석…? 어이쿠, 관광객이 아니셨군요. 죄송합니다, 바로 가져다드리겠습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110106
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110106,
					"content": "(화면이 어두워지고, 물건을 가져온다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110107
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110107,
					"content": "이건 어떠세요? 저희 「해취항」은 꽤 오래된 옥석 가게입니다. 이 돌의 상태를 보세요! 최상급입니다. 암왕제군님이 직접 내리신 은총이라고 할 수 있죠. 안심하고 아무거나 고르셔도 됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110108
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110108,
					"content": "이 3개 다 정말 예쁘다! 평소에 보던 것과는 확실히 달라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110109,
					"content": "그럼 어떤 걸 골라야 되지? 그냥 아무거나 하나 고를까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110110,
						10110113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110110,
					"content": "옥석 도박으로 장사하는 사람을 함부로 믿어선 안 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110111
					]
				},
				{
					"id": 10110111,
					"content": "아주 좋아. 무역 도시의 생존 법칙을 어느 정도 터득했나 보군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110112
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110112,
					"content": "그럼 종려의 의견은 어때? 이 셋 중에 어느 걸 골라야 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110114,
					"content": "오호? 내 결정을 따르겠다고? 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110115
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110115,
					"content": "사실 정답은 아주 간단하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110116
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110116,
					"content": "응? 그럼 정답은…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110117,
					"content": "3개 전부 사겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110118
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110118,
					"content": "알겠습니다! 나으리, 기개와 도량이 남달라 보이시더니, 역시 시원시원하시군요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110119
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110119,
					"content": "잠깐! 잠깐만, 사장님. 방금 건 무효! 좀 더 상의해볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110120,
					"content": "(화면이 어두워지고 석두와 조금 떨어진 곳에서 종려, 주인공, 페이몬 3명의 대화로 바뀐다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110121,
					"content": "이봐! 의식에 필요한 건 하나인데, 전부 다 사버리면 모라를 3배나 낭비하는 거잖아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110122,
						10110123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110122,
					"content": "페이몬 말이 맞아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110124
					]
				},
				{
					"id": 10110124,
					"content": "모라… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110125
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110125,
					"content": "그래, 그 생각은 못 했네. 내 생각이 짧았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110126
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110126,
					"content": "응? 물건을 사면서 어떻게 모라 생각을 안 할 수가 있지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110127,
					"content": "만약 모든 일에 항상 모라를 최우선으로 생각한다면, 그건 모라에 손발이 묶인 거나 마찬가지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110128
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110128,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110129,
					"content": "모라가 화폐인 것은 맞지만, 화폐가 모라인 것은 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110130
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110130,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110131,
						10110134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110131,
					"content": "경제학 이야기를 하는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110132
					]
				},
				{
					"id": 10110132,
					"content": "이게 바로 부자들의 세계인가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110133,
					"content": "거시 경제에 대한 건 잘 알면서, 「미시」적인 절약은 잘 모르나 보네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110136,
					"content": "당황할 필요 없어. 모라에 손발이 묶인 상황이라도 해결할 방법은 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110137
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110137,
					"content": "「야박석」의 품질을 감별하는 건 확실히 까다로워. 가공되지 않은 원석은 품질과 상관없이 재질과 색감, 내부의 무늬도 그렇게 큰 차이가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110138
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110138,
					"content": "야박석은 가공된 후에야 비로소 불량품을 감별해낼 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110139
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110139,
					"content": "그때 가서 그 악덕 상인들한테 따지면, 그들은 「당신네 연장이 안 좋네」, 「불의 세기를 잘못 맞췄네」 등 핑계를 대며 발뺌할 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110140
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110140,
					"content": "큰일 날 뻔했네! 이렇게 사기당하기 쉬운 물건이었다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110141,
					"content": "하지만 감별 방법이 아예 없는 건 아니야——전문가들은 보면 딱 알지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110142
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110142,
					"content": "「달을 가리키는 손끝만 보고 달은 못 보네」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110143
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110143,
					"content": "무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110144,
					"content": "달을 가리키는 손가락을 보고, 똑똑한 사람은 달을 가리키고 있다는 걸 알지만, 그렇지 않은 사람은 달을 보지 못하고 눈앞의 손가락만 보게 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110145
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110145,
					"content": "무늬, 겉모양… 이런 건 모두 손가락이야. 야박석은 어두운 밤에 조명으로 쓰이는 기석이니, 그 「밝기」가 달인 셈이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110146
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110146,
					"content": "품질이 우수한 「야박석」은 불 원소 친화력이 강해. 즉, 고온 상태에서 광택이 밝고 푸를수록 좋은 광석이란 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110147,
						10110148
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110147,
					"content": "종려 씨는 전문가셨군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110149
					]
				},
				{
					"id": 10110149,
					"content": "천금의 가치가 있는 옥석 업계의 비밀을 알려줬으니, 이젠 너희가 직접 응용해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110150
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110150,
					"content": "천금의 가치…. 음, 다시 쓸 일은 없어 보이지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110151
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110151,
					"content": "(화면이 어두워지고, 다시 석두의 가게 앞으로 돌아와서 대화한다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110152
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110152,
					"content": "사장님, 우리 다시 왔어~ 그 돌들 불에 좀 지져보게 다시 줘봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110153
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110153,
					"content": "지, 지진다고요?! 안됩니다. 손님이 지져버리면 장사는 어떻게 합니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110154,
						10110156
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110154,
					"content": "그럼 샘플이라도 좀 주시겠어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110155
					]
				},
				{
					"id": 10110155,
					"content": "그건… 휴, 좋습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110158
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110158,
					"content": "그럼 제가 그 돌들의 샘플을 좀 떼어오죠. 손해 좀 보더라도 괜찮습니다. 친구를 사귄 셈 치죠 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110159
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110159,
					"content": "걱정 말게. 상업계의 규칙은 잘 알고 있어. 광석 품질만 좋다면, 그쪽이 손해 볼 일은 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110160
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110160,
					"content": "(화면이 어두워지고 샘플을 가져온다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110161
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110161,
					"content": "그럼 이 샘플들을 가져가세요. 조각칼로 썰어낸 겁니다. 번호도 표시해뒀어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110162,
						10110163
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110162,
					"content": "이 샘플들…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110164
					]
				},
				{
					"id": 10110164,
					"content": "…너무 얇잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110165
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110165,
					"content": "종이보다 얇아…. 아니, 벌레의 날개보다도 얇아서 거의 투명하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110166,
						10110168
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110166,
					"content": "정말 쪼잔하시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110167
					]
				},
				{
					"id": 10110167,
					"content": "쪼잔하다고요? 이 정도면 후한 거죠, 더 잘라냈다간 가게 망합니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110171
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110171,
					"content": "하지만 이렇게 얇아선 불에 닿자마자 재가 돼버리는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110172
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110172,
					"content": "장사꾼에게서 이윤을 얻길 바라는 건, 굶주린 늑대에게 방금 삼킨 고기를 다시 토해내라고 하는 것과 같아. 어쩔 수 없는 일이지. 사실 특수한 조건이라면 이 정도 두께로도 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110173
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110173,
					"content": "어떤 조건인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110174
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110174,
					"content": "고온의 「불」을 가하는 동시에, 「물」 원소의 힘으로 순식간에 불타버리지 않도록 보호하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110175
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110175,
					"content": "오? 손님께서는 식견이 정말 깊으시군요. 이해해 주셔서 감사합니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110176
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110176,
					"content": "솔직히 우리가 반드시 살 거라고 약속한 것도 아닌데, 이렇게 샘플을 요구하는 것 자체가… 불공평하지. 리월의 「계약」은 공평함을 근거로 하는 게 도리니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110177
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110177,
					"content": "그럼, 이제 실험을 진행할 장소만 찾으면 되겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110178,
						10110179
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110178,
					"content": "타타우파 협곡에 분명…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110182
					]
				},
				{
					"id": 10110182,
					"content": "아! 생각났다. 몬드의 <color=#00E1FFFF>타타우파 협곡</color>에 「미티족」 츄츄들한테 <color=#00E1FFFF>엄청 큰 솥</color>이 있었어！엄청 단단해 보였으니 아마 원소 반응도 견딜 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110183
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110183,
					"content": "#{NICKNAME}, 그럼 샘플을 챙겨서 출발해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110179,
					"content": "향릉의 주방…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110180
					]
				},
				{
					"id": 10110180,
					"content": "「만민당」 말하는 거야? 좋아, 마침 향릉이 없을 때…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110181
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110181,
					"content": "안 돼. 거긴 오가는 사람이 너무 많아. 만에 하나 원소 반응이 통제 불능 상태가 돼서 일반 민중까지 휘말리게 되면… 그런 위험은 감수할 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110182
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110168,
					"content": "사장님 솜씨가 대단하시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110169
					]
				},
				{
					"id": 10110169,
					"content": "하하하… 과찬이십니다. 이 돌들은 제 보물덩어리들인데, 거칠게 대하면 안 되죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110170
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110170,
					"content": "실수로 너무 많이 베어버리기라도 하면 큰일이라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110171
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110163,
					"content": "너무 얇은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110164
					]
				},
				{
					"id": 10110156,
					"content": "그럼 안 살 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110157
					]
				},
				{
					"id": 10110157,
					"content": "안 사신다고요…? 에이, 그, 그러지 마시고…. 좀 더 흥정해보죠! 장사의 미덕은 흥정 아닙니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110158
					],
					"speakerTitle": "석두"
				},
				{
					"id": 10110148,
					"content": "이게 바로 부자들의 품격 있는… 엘레강스 라이프인가",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110149
					]
				},
				{
					"id": 10110134,
					"content": "돈이 많은가 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110135
					]
				},
				{
					"id": 10110135,
					"content": "「푼돈」은 그냥 막 써도 될 정도로 부자인 건가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110123,
					"content": "3배가 아니라 2배지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110124
					]
				},
				{
					"id": 10110113,
					"content": "종려 씨의 의견이 듣고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110114
					]
				}
			]
		},
		{
			"id": 101104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101104",
							"2"
						],
						"stepId": 101104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110401,
					"content": "우와… 안에 수프도 있네, 츄츄족은 정말 많이 먹는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110402,
						10110403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110402,
					"content": "이젠 우리의 실험대야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110404
					]
				},
				{
					"id": 10110404,
					"content": "이 수프를 「물」 원소의 보호막으로 쓰면 되겠다. 그럼 불을 붙이고 실험을 시작해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110405,
					"content": "[동작 비고. 손을 뻗어 넣는 동작 or 돌을 넣는 동작을 표현함]",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110406,
					"content": "이렇게 하면 되겠지? 페이몬도 세 샘플의 번호와 위치를 기억해 둘게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110407,
					"content": "그럼 시작해보자! <color=#00E1FFFF>「불」 원소의 힘</color>으로 결과가 나올 때까지 솥을 가열시켜야 해——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110408,
					"content": "종려가 <color=#00E1FFFF>광택이 밝고 푸를수록</color> 품질이 좋은 거라고 했으니까, 자세히 봐야 돼～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110403,
					"content": "수프가 아깝네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110404
					]
				}
			]
		},
		{
			"id": 101109,
			"completionStepIds": [
				101109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101109",
							"2"
						],
						"stepId": 101109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"종려"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10110901,
					"content": "「야박석」은 여기 놓으면 돼. 이미 사람을 보내 보석공을 데려오라고 했어, 그들이 이걸로 의식에 필요한 도구를 만들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110902
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110902,
					"content": "그러고 보니 시간이 촉박해서 「타르탈리아」를 만나러 갈 겨를도 없었군, 그럼 보석공의 보수도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110903,
						10110904
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110903,
					"content": "일단 제가 대신 지불할게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110905
					]
				},
				{
					"id": 10110905,
					"content": "다른 방법은 없는 것 같네. 그나저나 여기가… 「송신의례」를 진행할 장소야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110906
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110906,
					"content": "그래, 여긴 의식 준비를 위해 내가 빌린 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110907,
						10110909
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110907,
					"content": "「청신의례」와 같은 장소…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110908
					]
				},
				{
					"id": 10110908,
					"content": "맞아. 같은 장소에서 진행할 예정이야. 「리월 칠성」도 묵인한 상황이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110911
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110911,
					"content": "하지만 여기서 그렇게 큰 사건이 벌어졌는데…. 아, 그럼 우린 용의자니까 천암군한테 잡히지 않게 조심해야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110940
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110940,
					"content": "그치만 절운간에서 돌아온 뒤로 귀찮은 천암군을 마주친 적이 없는 것 같아, 이게 어떻게 된 일이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110912
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110912,
					"content": "그리고 여기에 있던, 암왕제군의… 음, 선체도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110913
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110913,
					"content": "전통적인 표현으론 「선조의 허물」이라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110914
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110914,
					"content": "맞아, 그 이름이야. 종려는 모르는 게 없네. 그럼 「선조의 허물」은 칠성이 숨기고 있는 거야? 아직 범인에 대한 조사도 안 끝났는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110915
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110915,
					"content": "칠성이 이미 진실을 알고 있거나… 현장의 단서를 모두 모았다고 확신하고 있는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110916,
						10110917
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110916,
					"content": "그래도 역시 어딘가 이상하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110918
					]
				},
				{
					"id": 10110918,
					"content": "그런 건 옥경대의 거물들이 알아서 하실 거야. 가만히 있는 게 도와주는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110919
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110919,
					"content": "의식을 진행하기 전, 「선조의 허물」은 당분간 「황금옥」에 안치될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110920
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110920,
					"content": "「황금옥」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110921
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110921,
					"content": "리월의 유일한 조폐창이자… 티바트의 유일한 조폐창이기도 하지. 7개국에서 유통되는 모라는 전부 그곳에서 만들어져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110922
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110922,
					"content": "우와——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110923
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110923,
					"content": "아니, 딱히 나쁜 생각을 한 건 아냐. 그냥 「모락스」의 신분과 잘 맞는다고 생각한 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110924
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110924,
					"content": "근데, 종려는 그걸 어떻게 아는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110925
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110925,
					"content": "「송신의례」는 칠성의 묵인을 받았기 때문에 반은 공식적인 행사인 셈이지. 그래서 내부 소식을 어느 정도 알 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110926,
						10110927
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110926,
					"content": "칠성은 장소를, 타르탈리아는 자금을 제공한다라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110928
					]
				},
				{
					"id": 10110928,
					"content": "각자 목적이 있겠지…. 하지만, 이 상업 도시에서 가끔 누군가에게 이용당하는 건 이상한 일이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110929
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110929,
					"content": "「계약」의 신이 다스리는 리월에서 계약만큼은 절대 어기면 안 되지만, 그 외의 행위는 딱히 상관없다고 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110930
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110930,
					"content": "그럼 이제 의식에 쓰일 <color=#00E1FFFF>향고</color>를 구하러 가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110931
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110931,
					"content": "향고? 그건 어디서 구해? 사면 되나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110932
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110932,
					"content": "아니, 신에게 바치는 향고를 달이기 위해선, 특수한 품질의 <color=#00E1FFFF>「예상꽃」</color>이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110933
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110933,
					"content": "「예상」이라고 불리는 이 꽃의 꽃잎은 최상의 섬유질 물질로, 양단을 만드는 데 많이 사용되지. 게다가 그 향은 매우 맑고 우아해서 특히 신선을 모시는 엄숙한 경우에 많이 쓰여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110934
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110934,
					"content": "종려의 상류층 지식 타임이 또 시작됐군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110935
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10110935,
					"content": "더 자세한 설명은 필요 없어 보이니, 우선 나와 함께 상인에게 재료를 구입하러 가자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종려"
				},
				{
					"id": 10110927,
					"content": "그들은 대체 이 의식을 이용해서 무엇을 하려는 거죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110928
					]
				},
				{
					"id": 10110917,
					"content": "너무 경솔한 거 아닌가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110918
					]
				},
				{
					"id": 10110909,
					"content": "「현장」을 이렇게 사용해도 되는 건가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110910
					]
				},
				{
					"id": 10110910,
					"content": "「리월 칠성」도 묵인한 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10110911
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10110904,
					"content": "나중에 타르탈리아한테 가서 변상해 달라고 하죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10110905
					]
				}
			]
		},
