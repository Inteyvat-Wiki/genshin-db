			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "괜찮은 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "자꾸 너무 높게 올라가",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#{NICKNAME}! 한참 찾았어, 지난번에 준 바람의 날개는 잘 쓰고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810104,
					"content": "바람의 날개로 재밌게 논 모양이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810105,
					"content": "근데 너 아직 비행 허가증 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810106,
					"content": "비행 허가증? 그게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4810107,
					"content": "이름만 봐도 알 수 있잖아? 몬드성에서 합법적으로 비행하려면 비행 허가증이 있어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810108,
					"content": "어…. 그치만 지금까지 그런 건 들어본 적 없는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4810109,
					"content": "너네가 온종일 성안을 날아다녀서 다른 사람 눈에 띄었으니까 그렇지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810110,
					"content": "에헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4810111,
					"content": "그래서, 오늘 일부러 비행 허가증을 주러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4810112,
					"content": "그럴 리가! 기사는 원칙을 중시하는 법이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810113,
					"content": "비행 허가증은 시험에 합격해야 기사단에서 발급해주는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810114,
					"content": "난 오늘 네 비행 허가증 시험을 감독할 시험관 신분으로 온 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810115,
					"content": "어쨌든 너한테 바람의 날개를 준 건 나니까 내가 책임을 져야지——진 단장이라면 분명 이렇게 말했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810117,
					"content": "조금 봐줄 수 없을까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "나만 믿어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "시험… 듣는 것만으로도 귀찮아. 하지만 엠버가 감독관이니까, 그렇다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4810118,
					"content": "그렇게 쳐다보지마, 절.대.안.돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810120,
					"content": "#너라면 분명 순조롭게 통과할 거야, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810121,
					"content": "그냥 간단한 테스트일 뿐이야. 네가 풍마룡을 물리칠 때의 비행 능력을 온 몬드가 인정했어, 문제 없을 거라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810122,
					"content": "하지만 규정과 비행 기준은 지켜야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810123,
					"content": "이거 받아. 이 비행 가이드는 외울 것까진 없지만, 숙지해두는 게 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810124,
					"content": "예를 들어 두 사람이 바람의 날개 한 대를 함께 이용하면 안 되고, 규정 무게를 초과한 물건을 들고 비행하면 안 되고, 바람 슬라임을 이용해 비행하면 안 되고, 뭐 등등…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810125,
					"content": "아무튼 잘 읽어봐. 리사 언니가 마법을 가르쳐줄 때에도 두꺼운 책부터 엄청 읽게 했었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810126,
					"content": "두꺼워 보여…. 방법이 없네, 일단 읽어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4810127,
					"content": "응! 다 읽고 나면 바람이 시작되는 곳으로 날 찾으러 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4810401,
					"content": "페보니우스 기사단의 비행 가이드라, 읽기 싫게 생겼다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4810402,
					"content": "일단 읽어보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "우화 이야기 같네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "몬드 사람들이 비행을 배우는 방식은 정말 낭만적이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "좋은 이야기다…. 근데 기사단의 비행 가이드는… 전부 이런 식인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4810604,
					"content": "모르겠다. 빨리 엠버한테나 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}