			},
			"dialogs": [
				{
					"id": 710500801,
					"content": "물가에 놓은 이상한 물건에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "응? 그걸 물가에 가져갔구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500803,
					"content": "어때? 특수한 반응은 없었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500804,
					"content": "바위 용 도마뱀이 나타났어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "바위 용 도마뱀? 그걸 물에 넣으니까 바위 용 도마뱀이 됐다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500806,
					"content": "아, 바위 용 도마뱀으로 변한 게 아니라 그걸 본 바위 용 도마뱀이 헤엄쳐 나왔다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500807,
					"content": "깜짝 놀랐네. 그게 물 안에서 바위 용 도마뱀으로 변한 거였다면 내 세계관이 무너질 뻔했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500808,
					"content": "그건 대체…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "사실 간단해, 어떻게 설명해야 될까… 이렇게 하자. 내가 그 바위 용 도마뱀의 어떤 점이 특별했는지 먼저 맞혀 볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500810,
					"content": "예를 들면 물 원소가 부착되어 있었겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500811,
					"content": "그런 거 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "그럼 틀림없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500816,
					"content": "그 바위 용 도마뱀은 물 원소를 다룰 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500817,
					"content": "층암거연의 지하수는 물 원소 함량이 무척 높아. 그래서 일부 특수한 집결지에서는 네가 낚은 수초 같은 수생식물이 자라곤 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500818,
					"content": "바위 용 도마뱀, 물론 층암거연에 서식하는 기타 친수성 생물도 마찬가지야. 물 원소가 다량 함유된 수초를 먹으며 자신의 힘을 키운 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500819,
					"content": "그러니까 그것의 정체는… 물 원소가 다량 함유된 수초인 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500820,
					"content": "그냥 수초였군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "맞아, 단순한 수초야. 하지만 물 원소가 이렇게 풍부하게 함유된 수초는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500822,
					"content": "정상적인 환경에서 나올 수 없어. 모종의 순수하고 거대한 에너지가 수원 자체에 영향을 미친 게 아니라면…. 일단 이 얘기는 나중에 하고, 이 수초는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500823,
					"content": "언젠가는 자아를 가진 원소 생물이 될지도 모르겠어, 연구할 가치는 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500813,
					"content": "못 봤어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#너무 빨리 처치해서 아예 눈치도 못 챈 건가…. 정말 대단하군, 역시 전설의 {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500815,
					"content": "하지만 내 추측대로라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "헤디브"
				}
			]
		}
	]
}