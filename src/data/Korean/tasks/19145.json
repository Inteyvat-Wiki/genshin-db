			"dialogs": [
				{
					"id": 191451601,
					"content": "번개 신께서 부디 할머님과 손녀분을 보우하시길…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 191451602,
					"content": "할머니의 눈에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "눈치채셨나요? 맞아요, 눈이 잘 안 보이셔서 매번 산에 오실 때마다 걱정이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 191451604,
					"content": "하지만 저희에게 폐 끼치고 싶지 않으신지, 몇 년 동안 다니던 길이라며 항상 혼자서 내려가시겠다고 하세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 191451605,
					"content": "다행히 산길에도 무녀가 있어서 조금이나마 할머니를 보살펴드릴 수 있지만요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 191451606,
					"content": "번개 신이 보우하사, 할머님과 손녀분 모두 평안하길…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이나기 호토미"
				}
