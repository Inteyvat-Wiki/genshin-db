						220500438
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220500438,
					"content": "그렇군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220500439,
					"content": "어쩔 수 없네. 히비키는 왜 아직도 어린아이처럼 이리저리 싸돌아다니는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220500440,
					"content": "아무튼 고마웠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220500441,
					"content": "그럼, 우리 먼저 갈게요.",
