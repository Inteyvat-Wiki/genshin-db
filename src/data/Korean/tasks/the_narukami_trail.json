				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "「나루카미 다이샤」가… 여기인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220500202,
					"content": "붉은 문이 아주 많네. 인간은 붉은 색의 문을 좋아하나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220500203,
					"content": "이건 「도리이」라고 불러",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "아사세 신사에도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220500205,
					"content": "아아~알겠다, 저거 「도리이」 였구나. 새들이 사는 곳 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220500206,
					"content": "그러니까 도리이 많으면 새도 많아지는 거 맞지? 새, 좋지. 인간도 참 똑똑하구만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220500207,
					"content": "너희들, 히비키가 어딨는지 봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220500208,
					"content": "사람의 흔적은 없었어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "이 근처에, 사람이 없는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220500210,
					"content": "우리 「나루카미 다이샤」에 올라가서 무녀 들한테 물어보자.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220500211,
					"content": "「히비키」도 무녀일 텐데… 그들은 무엇을 알고 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
