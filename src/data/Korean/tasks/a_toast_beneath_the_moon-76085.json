			},
			"dialogs": [
				{
					"id": 760520501,
					"content": "꿀꺽… 꿀꺽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520502,
					"content": "단숨에 다 마셨어! 잘됐다, 마음에 드나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520503,
					"content": "별맛 안 나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520504,
					"content": "별맛 안 난다고…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520505,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520506,
					"content": "너무 빨리 마신 거 아니야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "음, 괜찮아. 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520509,
					"content": "나는 원래 사람들이 말하는 수확의 기쁨을 이해하지 못했어. 그러던 어느 날, 나뭇가지에 맺힌 열매를 만졌는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520510,
					"content": "껍질의 주름을 통해 열매의 생명력이 느껴졌어. 그건 햇빛과 물, 공기의 양분이 전환된 형태였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520511,
					"content": "열매를 씹자, 아삭한 소리와 함께 달콤한 맛이 파도처럼 밀려들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520512,
					"content": "그때 깨달았지. 향은 모든 존재를 끌어당기는 힘이라는 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520513,
					"content": "오! 심오한 감상이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520514,
					"content": "그리고 우리는 이 생명력을 빼앗아 자연의 전환을 이루고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520515,
					"content": "갑자기 잔인한 이야기가 됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520516,
					"content": "그래서 난 신선한 과일을 더 좋아해. 내가 이 세계에서 무엇을 가져갔는지 직접적으로 느낄 수 있게 해주거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520517,
					"content": "이것도 내가 이 세계에 보답해야 할 것이겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520507,
					"content": "한 잔 더 만들어 줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
