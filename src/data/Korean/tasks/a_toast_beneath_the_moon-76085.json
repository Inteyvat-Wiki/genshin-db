			"dialogs": [
				{
					"id": 760520401,
					"content": "이 향이라면 맡아봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520402,
					"content": "오? 어디서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520403,
					"content": "산드로네 방에서. 내가 이 향이 나는 음료에 관심을 가지는 걸 보곤, 일부러 한참을 안 마시고 들고만 있더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520404,
					"content": "마치… 내 질문을 기다리는 것처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520405,
					"content": "그래서 질문했어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520407,
					"content": "뭐라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520408,
					"content": "「너는 기계 오일 마셔야 하지 않아?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520409,
					"content": "그랬더니… 뭐래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520411,
					"content": "듣기 싫은 말이었어. 배우지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520412,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520413,
					"content": "한 모금 만에 흥미를 잃었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520414,
					"content": "미안, 써서 별로야. 이래서 산드로네도 이걸 마실 때 표정이 안 좋았구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520415,
					"content": "그건 다른 이유 때문인 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
