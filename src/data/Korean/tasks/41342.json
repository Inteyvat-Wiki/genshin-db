			"dialogs": [
				{
					"id": 413421202,
					"content": "오, 이 정도면 돼. 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "왕반자"
				},
				{
					"id": 413421203,
					"content": "아직 자잘한 일이 좀 남았는데… 항구에 가서 새로 도착한 물자 좀 세어줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "왕반자"
				},
				{
					"id": 413421204,
					"content": "항구에 상자 3개가 쌓여있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "왕반자"
				},
				{
					"id": 413421205,
					"content": "제게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "그럼 부탁 좀 할게. 빨리 일을 마무리 지어봐야 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "왕반자"
				}
			]
		},
