				},
				{
					"id": 413420603,
					"content": "방금 들었어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "딱 보면 척이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "이망치"
				},
				{
					"id": 413420606,
