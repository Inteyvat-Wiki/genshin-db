			"dialogs": [
				{
					"id": 752750201,
					"content": "(고풍스러운 비석. 글자 절반이 마모됐다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750202
					],
					"speakerTitle": "비석"
				},
				{
					"id": 752750202,
					"content": "…키온고지가 떠난 지 십여 년…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750203
					],
					"speakerTitle": "비석"
				},
				{
					"id": 752750203,
					"content": "…대승리…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750204
					],
					"speakerTitle": "비석"
				},
				{
					"id": 752750204,
					"content": "…이 전당을 세워… 영령을 위로한다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "비석"
				}
			]
		},
