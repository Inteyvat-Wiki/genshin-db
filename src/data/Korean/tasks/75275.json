					"nextDialogs": [
						752750303
					],
					"speakerTitle": "비석"
				},
				{
					"id": 752750303,
					"content": "…돌아오기 전에… 잿더미 바다와 검은 물결을 막아야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750304
					],
					"speakerTitle": "비석"
				},
				{
					"id": 752750304,
					"content": "…죽어서도 이루지 못한다면… 후손이 이어받아… ——글로해리",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "비석"
				}
			]
		},
