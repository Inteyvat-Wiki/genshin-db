			"dialogs": [
				{
					"id": 401360201,
					"content": "…압송 수속은 끝났어. 저 셋은 이제 너한테 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360202,
					"content": "뒤에 다른 일정이 있나 봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 401360203,
					"content": "응, 파티에 참석해야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360204,
					"content": "별일이군. 새로운 취미라도 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 401360205,
					"content": "그냥 이번 상황이 특별한 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360206,
					"content": "슈브르즈, 공작!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401360207,
					"content": "축제가 좋긴 하네. 여기까지 이렇게 시끌벅적해지다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 401360208,
					"content": "응, 폰티날리아 축제니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360209,
					"content": "그러게, 심지어 수간호사는 초호화 영양 셰이크까지 준비했더라고… 건강에도 초호화 버전이 있다니 참…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 401360210,
					"content": "방금 일 얘기하고 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401360211,
					"content": "이미 끝났어. 라이오슬리랑 「얘기」를 좀 나누었을 뿐이야. 그렇지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360212,
					"content": "난 확실하게 답하진 않았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 401360213,
					"content": "거절도 안 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360214,
					"content": "좋은 아이디어가 있어. 녀석들에게 매일 신문을 하나씩 주는 거야. 예를 들면, 20년 전 이야기가 실린 신문 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360215,
					"content": "그럼 어느 누구 씨는 불행해지겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 401360216,
					"content": "그럼 어느 두 사람은 영웅이 될 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360217,
					"content": "영웅 얘기가 나왔으니 말인데, 둘은 여기 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 401360218,
					"content": "아, 우리는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401360219,
					"content": "날 파티에 초대하려고 온 거겠지. 난 오늘이 무슨 날인지 잊지 않았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 401360220,
					"content": "헤헤, 그럼 빨리 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401360221,
					"content": "또 봐, 공작! 축제 잘 보내!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401360222,
					"content": "그래, 즐거운 축제 보내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라이오슬리"
				}
			]
		},
