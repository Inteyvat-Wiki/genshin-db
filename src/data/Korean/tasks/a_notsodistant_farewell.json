	"talks": [
		{
			"id": 7451001,
			"completionStepIds": [
				7451001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7451001",
							"2"
						],
						"stepId": 7451001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하니야",
					"소우카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745100101,
					"content": "우리가 이겼어! 버섯몬 파트너의 대승리야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745100102,
					"content": "정말 화려한 전략이었어. 역시 「금빛 유성」과 「은빛 반성」다워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100103
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100103,
					"content": "훈련사로서 너희의 재능은 상식적인 수준을 아득히 뛰어넘었어. 너희라면 어떤 상대를 만나도 버섯몬 파트너를 승리로 이끌 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100104,
						745100105
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100104,
					"content": "헤헤! 하니야 씨한테 칭찬받았다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100106
					]
				},
				{
					"id": 745100106,
					"content": "그나저나 저번엔 설산 멧돼지 왕이랑 꼭두각시 검귀를 내보내더니, 이번엔 칼날견까지 등장했네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745100107,
					"content": "소우카, 네 상대 라인업 배치는 정말 자유롭구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745100108,
					"content": "이 강적들은 각지 모험가들의 이야기 속에 전해지는 전설 같은 존재랍니다! 바다 너머의 플레이어들에게도 공감을 일으킬 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100109
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 745100109,
					"content": "저도 소설 작가로서 마음에 들고요…. 원래라면 관련 없을 캐릭터들이 한데 모여서 실력을 겨루는 장면이라니, 상상만 해도 설레지 않나요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100110
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 745100110,
					"content": "그럼 「지혜롭고 용감한 한 쌍의 별」, 이번 「미니 버섯몬 판타지」의 모든 스테이지를 플레이해 보신 소감이 어떠신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100111,
						745100113,
						745100115
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 745100111,
					"content": "더 하고 싶은데 스테이지가 모자라요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100112
					]
				},
				{
					"id": 745100112,
					"content": "음, 우리의 두 번째 예상대로인가. 다음 사전 이벤트는 최대 규모로 준비해 더 많은 스테이지를 만들어야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100117,
					"content": "아무튼 소우카는 앞으로도 폰타인 사람들이 이 게임을 좋아하게 되도록 더 많은 자료를 찾아서 더 강하고 재밌는 상대를 고안해 낼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100118
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100118,
					"content": "그럼 후원사 폰타도 우리를 위해 더 많은 자금을 대주겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100119
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100119,
					"content": "경비가 충분히 모이면, 다시 「달 연꽃컵」 같은 규모의 대회를 개최할 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100120
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100120,
					"content": "아니지, 「달 연꽃컵」보다 더 큰 대회를 열겠어! 대회의 규칙도 대폭 개선해서 감동과 재미까지 선사해야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100121
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100121,
					"content": "헤헤, 생각만 해도 설렌다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100122,
						745100123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745100122,
					"content": "필요한 일이 생기면 언제든 절 찾으세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100124
					]
				},
				{
					"id": 745100124,
					"content": "이건 장기적인 계획이니까 급할 거 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100125
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100125,
					"content": "소우카와 밸푸어 씨의 지도를 받아서 나도 조금은 제대로 된 사업가가 됐으니까, 사소한 일로 너희를 귀찮게 할 순 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100126
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100126,
					"content": "사전 이벤트와 사업 협상이 끝나도, 나랑 소우카는 한동안 폰타인에 머물면서 버섯몬 파트너에게 이곳저곳을 구경시켜 줄 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100127
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100127,
					"content": "너희한테도 주기적으로 버섯몬 파트너의 근황과 프로젝트 진행 상황을 적은 보고서를 보내려고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100128
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100128,
					"content": "물론 너희가 고정적인 수신지를 알려줘야 가능하겠지만. 안 그러면 저번처럼 너희와 연락이 끊겨버리는 상황이 발생할 수 있잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100129
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100129,
					"content": "고정적인 수신지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100130,
						745100131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745100130,
					"content": "며칠마다 한 번은 들를만한 곳이라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100132
					]
				},
				{
					"id": 745100132,
					"content": "좋네요! 그럼 제가 「지혜롭고 용감한 한 쌍의 별」에게 편지를 써서, 하니야와 버섯몬 파트너를 대표해 주기적으로 상황을 보고할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100133
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 745100133,
					"content": "응, 그렇게 하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745100134,
					"content": "「미니 버섯몬 판타지」의 열기가 아직 식지 않아서, 우리는 이벤트를 한동안 더 진행할 예정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100135
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100135,
					"content": "바쁘지 않다면 또 와서 게임을 즐겨줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100136,
						745100137
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100136,
					"content": "물론이죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100138
					]
				},
				{
					"id": 745100138,
					"content": "헤헤, 이번엔 하니야와 소우카, 그리고 버섯몬 파트너들과 멀리 떨어지지도, 오랫동안 헤어져 있지도 않게 될 것 같아. 한결 안심되는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745100139,
					"content": "다음 훈련사 대회는 어떤 모습일지 정말 기대된다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745100137,
					"content": "시간은 많아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100138
					]
				},
				{
					"id": 745100131,
					"content": "그럼 모험가 길드밖에 없겠네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100132
					]
				},
				{
					"id": 745100123,
					"content": "저희도 경영에 대해선 좀 알아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100124
					]
				},
				{
					"id": 745100113,
					"content": "딱 적당하고 좋았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100114
					]
				},
				{
					"id": 745100114,
					"content": "좋게 생각해 줘서 고마워…. 하지만 너는 워낙 바쁘고 시간이 없어서 그런 걸지도 모르니까, 예비 스테이지를 더 준비해 두는 편이 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100115,
					"content": "버섯몬 파트너만 있다면 뭐든지 좋아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100116
					]
				},
				{
					"id": 745100116,
					"content": "하하, 역시 시원시원하네. 소우카 말대로 너희는 이제 우리의 사장님이니까, 요구사항이 생기면 우리한테 바로 말해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745100117
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 745100105,
					"content": "하하, 하니야 씨도 만만치 않은걸요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745100106
					]
				}
			]
		}
	]
}