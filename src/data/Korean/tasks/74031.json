			"dialogs": [
				{
					"id": 740310101,
					"content": "이봐, 젊은 전사! 나와 겨뤄보지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310102
					],
					"speakerTitle": "니자미"
				},
				{
					"id": 740310102,
					"content": "갑자기!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740310103,
					"content": "#그게 뭐 어때서? 금발의 {M#형씨}{F#아가씨}, 네가 경험이 풍부한 강자라는 건 한눈에 알아봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "니자미"
				},
				{
					"id": 740310104,
					"content": "요즘 들어 나랑 겨뤄주는 사람이 없어서 지루하던 참인데, 특별 허가 쿠폰 줄 테니까 나랑 싸워볼래? 전에 루시모프한테 잔뜩 뜯어냈는데 쓸데가 없어서 마침 고민 중이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "니자미"
				},
				{
					"id": 740310105,
					"content": "어때? 나랑 겨뤄보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니자미"
				}
			]
		},
