			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "음… 여기에는 어떤 보물이 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100502,
					"content": "서랍 안에는 차트가 가득 쌓여 있다. 뒤적여보니 진료 카드와 회계 장부 같은 병원 서류인 듯하다.\\n실망한 채 서랍을 닫는다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "흥, 특별한 보물이라도 숨겨져 있는 줄 알았더니… 평소 모험할 때 보이는 나무상자보다 못하네! 거기엔 적어도 양배추나 새고기라도 들어 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100504,
					"content": "엥, 이게 뭐야? 안에서 떨어진 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100505,
					"content": "어디 보자… 보물의 단서일지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100507,
					"content": "으악, 「비늘병」… 엄청 끔찍해 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100508,
					"content": "다른 서류에는 뭐라고 적혀 있어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100510,
					"content": "음… 하나도 모르겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100511,
					"content": "나도 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100512,
					"content": "「신의 음성이 인도한다」… 이거 하나만 알아보겠어. 설마 진짜 이상한 소리가 나와서 사람들을 데려가는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100515,
					"content": "「지하 수맥이나 생물의 움직임」 아닐까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "응! 맞아, 지하에 유적이 있을지도 몰라! 무슨 소리가 들리면 한번 가 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732100513,
					"content": "이해 못 하는 게 나을지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "응? 넌 무슨 말인지 알겠어? 난 「신의 음성이 인도한다」… 이거 하나만 알아보겠어. 설마 진짜 이상한 소리가 나와서 사람들을 데려가는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
