			"dialogs": [
				{
					"id": 761500101,
					"content": "콜록, 콜록…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 761500102,
					"content": "괜찮아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "괜찮아. 그냥… 아주 긴 악몽을 꿨을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 761500104,
					"content": "아니, 방금 한 말은 못 들은 걸로 해 줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 761500105,
					"content": "더는 못 참겠어. 대체 왜 나한테만 이런 일이 생기는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 761500106,
					"content": "왜 나한테만 이런 일이… 아빠, 엄마, 언니까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 761500107,
					"content": "내가 여기 있으니까 진정해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "응, 너 때문에 화가 난 건 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 761500109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "오른쪽이"
				},
				{
					"id": 761500110,
					"content": "오른쪽이가 주워 온 게 뭔가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 761500111,
					"content": "난 이걸 「죽음 조각」이라 부르기로 했어. 어쩌면 인간은 죽음을 향하는 존재고, 죽음을 마주해야만 출구를 찾을 수 있을지도 모르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761500112,
					"content": "이제 가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 761500114,
					"content": "차이틀린트를 찾았으니, 이제 나갈 방법을 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761500115,
					"content": "정말 우리 힘만으로 여기서 빠져나갈 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "알라라"
				},
				{
					"id": 761500116,
					"content": "멜란타와 니힐리타는 사람을 데리고 여길 자유롭게 오갈 수 있잖아. 그럼 오른쪽이도 가능하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761500117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "오른쪽이"
				},
				{
					"id": 761500118,
					"content": "지금까지 모은 「죽음 조각」은 총 3개야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761500119,
					"content": "아, 「죽음 조각」은 임시로 붙인 이름이야. 나도 오른쪽이가 이걸 왜 모으는지는 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761500120,
					"content": "오른쪽아, 이제 어쩌지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "이스토리아"
				},
				{
					"id": 761500121,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "오른쪽이"
				},
				{
					"id": 761500122,
					"content": "얘가 가리키는 방향으로 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이스토리아"
				}
			]
		},
