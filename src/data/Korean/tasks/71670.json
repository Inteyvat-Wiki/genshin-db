					}
				]
			},
			"dialogs": [
				{
					"id": 716700201,
					"content": "음… 뭔가 이상한데, 저기 멀리 있는 지맥 침적의 연기가 볼수록 수상해. 저것 때문에 마물 문제가 생긴 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700202,
					"content": "이것 때문에 천암군이 야영지까지 만들었나 보네. 순찰하는 병사랑 구축물도 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700203,
						716700204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700203,
					"content": "전에 비슷한 침적 포인트를 본 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700205
					]
				},
				{
					"id": 716700205,
					"content": "응! 늘 그래왔듯이 하자구. 천암군과 함께 마물을 퍽퍽 쓰러뜨리고 침적 포인트를 처리하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700206,
					"content": "거기 둘, 더 가면 위험하니 멈추도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700207
					],
					"speakerTitle": "방근"
				},
				{
					"id": 716700207,
					"content": "#잠깐… 이 기백은… 설마 {NICKNAME} 교관?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700208
					],
					"speakerTitle": "방근"
				},
				{
					"id": 716700208,
					"content": "엥? 너 내가 자는 동안에 천암군에 알바라도 간 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700209,
						716700210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700209,
					"content": "내가? 믿을 수가 없어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700211
					]
				},
				{
					"id": 716700211,
					"content": "난 여기 천암군 분대를 이끌고 있는 방근이라고 한다. 소정이 그러더군, 네가 백 년에 한 번 나올 법한 인재라고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700212
					],
					"speakerTitle": "방근"
				},
				{
					"id": 716700212,
					"content": "게다가 페보니우스 기사단의 명예 기사는 긴급 상황에 대장급 지휘권을 갖게 된다는 정보도 있으니 교관이라 불러도 합리적이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700213
					],
					"speakerTitle": "방근"
				},
				{
					"id": 716700213,
					"content": "본론으로 들어가서, 나와 함께 옥형 님을 만나줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700214
					],
					"speakerTitle": "방근"
				},
				{
					"id": 716700214,
					"content": "각청도 여기 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700215,
					"content": "간단한 일이 아닌가 보네. 그냥 힘으로 해결할 수는 없겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700216,
					"content": "#옥형 님, 예상하신 대로 {NICKNAME}와(과) 그의 부관 페이몬이 왔습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700217
					],
					"speakerTitle": "방근"
				},
				{
					"id": 716700217,
					"content": "수고했어, 방근",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700218
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700218,
					"content": "오랜만이네, 넌 여전하구나. 소식을 듣자마자 바로 전선으로 달려왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700219,
						716700220
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700219,
					"content": "물론이지, 이번에도 도우러 왔어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700221
					]
				},
				{
					"id": 716700221,
					"content": "그럼 최대한 요점만 말할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700222
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700222,
					"content": "이곳의 지맥 침적 포인트는 오랫동안 안정적이었어. 근데 어째서인지 최근 갑자기 활발해지면서 수차례 마물 습격 사건을 야기한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700223
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700223,
					"content": "게다가 쏟아져 나온 마물을 제거해도 이상 현상은 사라지지 않았어. 포인트에 접촉한 사람은 기이한 비경으로 보내기까지 하고, 이런 경우는 처음이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700224
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700224,
					"content": "정말 이상하네. 설마 이 지맥 침적 포인트가… 어떤 앵커 포인트 같은 게 된 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700225,
					"content": "그럼 지금 이 정도 병력으로는 부족한 거 아니야? 얼른 지원군을 불러야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700226,
					"content": "그건 걱정 마. 현재 방어선은 아주 안정적이니까. 병사들 모두 귀리 평원 쪽에서 온 정예 부대라 경험이 풍부하거든. 일당백이라고 해도 과언이 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700227
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700227,
					"content": "진짜 문제는 따로 있어. 지맥 혼란의 근본 원인을 찾지 못하고 장기적으로 부대가 주둔하게 되면, 인력과 물자 낭비에 부대도 지쳐 버릴 거라는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700228
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700228,
					"content": "정확하고 효율적으로 급소를 타격하는 게 용병술의 핵심이야. 방어만으로는 절대 승리할 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700229
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700229,
					"content": "맞는 말이야… 계속 수동적으로 반격만 하는 건 답답하고 짜증 나니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700230,
					"content": "이미 야란이 부하들을 이끌고 비경을 조사하러 갔어. 몇 시진 후면 중요한 정보를 가지고 돌아올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700231
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700231,
					"content": "#이런, 미안하게 됐네. 옥형 님과 {NICKNAME}(이)가 대화를 더 나눌 수 있게 천천히 올 걸 그랬어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700232
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700232,
					"content": "으악! 야란, 너 언제 나타난 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700233
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700233,
					"content": "벌써 오다니, 조사가 잘 안 풀린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700234
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700234,
					"content": "그냥 반반이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700235
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700235,
					"content": "우선 대략적인 상황은 파악했어——이번 이상 현상은 지맥 혼란의 여파야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700236
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700236,
					"content": "기존 샘플을 조사하고 전쟁 기록을 참조해 본 결과, 지맥이 비경 안에서 기록된 참혹한 전투를 재현하고 있음을 확인했어. 넘치는 마물들도 그럴 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700237
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700237,
					"content": "지맥 혼란이라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700238
					]
				},
				{
					"id": 716700238,
					"content": "익숙해? 그럼 맞을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700239
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700239,
					"content": "내가 파악한 정보에 따르면, 몬드에도 비슷한 현상이 일어났었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700240
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700240,
					"content": "다행히 상황은 그리 심각하지 않아서, 명예 기사와 어느 다크 히어로가 지맥 침적 포인트 밖으로 쏟아져 나온 마물을 처리했다지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700241
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700241,
					"content": "그렇게 그 안에 담겨있던 「정보」를 소진해 지맥을 정상으로 되돌리는 데 성공했어. 한 마디로, 소모전에서 승리한 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700242
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700242,
					"content": "둘 다 같은 성격의 문제인가 보네…. 어쩐지 하나같이 빨갛다 했어. 무슨 나무에 열린 열매처럼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700243,
						716700244
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700243,
					"content": "어떤 명예 기사가 그랬대요? 진짜 대단해요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700245
					]
				},
				{
					"id": 716700245,
					"content": "훌륭해. 가벼운 태도로 협력 상대에게 더 나은 가격을 제시하도록 암시하다니, 여전하네. 이번에는 절대 실망하지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700246
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700246,
					"content": "엥? 대체 무슨 소리들을 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700247
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700247,
					"content": "그럼 이제 나쁜 소식 차례겠네, 그렇지 야란?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700248
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700248,
					"content": "어, 이번 지맥 혼란 포인트는 과거의 단일 사례들과는 명확히 달라. 넘쳐난 마물을 처리하는 것만으로는 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700249
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700249,
					"content": "비경의 가장 깊은 곳으로 가서 특정 조건 하에 모든 마물을 처치하지 않으면, 전투는 끊임없이 반복될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700250
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700250,
					"content": "게다가 혼란 포인트와 연결된 비경은 특수한 규칙이 있는 듯해. 나와 병사들을 경계하면서 자신의 근원지를 조사하는 걸 거절했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700251
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700251,
					"content": "처음에는 샘플을 채취해 분석하는 것도 가능했지만, 심부에 진입한 뒤로는 병사들이 허약감을 느껴 정상적인 실력을 발휘할 수 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700252
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700252,
					"content": "그곳에 자리한 마물은 훨씬 난폭하고 새로운 특성까지 보여 상당히 까다로웠고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700253
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700253,
					"content": "아무래도 지맥의 제약을 적게 받는 사람만이 간섭에서 벗어나 그 안의 독특한 규칙을 파악할 수 있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700254
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700254,
					"content": "그런 인재가 병사를 이끌고, 위험한 환경을 극복해 지맥 혼란의 핵심을 공격해야 하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700255,
						716700256
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700255,
					"content": "이제 확실히 알아들었어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700257
					]
				},
				{
					"id": 716700257,
					"content": "그러니까 혼란 포인트의 주기적 활동이 멈출 때까지 밖에서 마물을 막거나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700258
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700258,
					"content": "#{NICKNAME}(이)가 병사를 이끌고 들어가서 원인을 해결해야 한다는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700259
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700259,
					"content": "알겠어, 양쪽으로 계획을 짜 볼게——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700260
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700260,
					"content": "이따 응광에게 연락해서 이곳 방어에 더 많은 자금을 투입하도록 할 거야. 개양성과도 상의해서 후속 교대 부대를 배치하게 해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700261
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700261,
					"content": "#어? 난 각청이 {NICKNAME}한테 곧바로 문제를 해결해 달라고 할 줄 알았는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700262
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700262,
					"content": "리월의 안녕을 지키는 건 천암군과 칠성의 사명이야. 전사들이 무모한 모험을 하지 않도록 하는 게 지휘관의 책임이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700263
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700263,
					"content": "공적이든 사적이든 너 혼자 모든 위험을 짊어지는 건 원치 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700264
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700264,
					"content": "그러니까 네가 원하지 않는다면, 천암군이 장기적인 방어선을 구축하고 여러 부대를 교대해 가면서 군사 훈련 형식으로 마물을 소탕할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700265
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700265,
					"content": "또 정찰병을 계속 파견해 비경 내부의 정보를 수집하고 특성을 파악해서, 언젠가는 부대를 이끌고 녀석을 제압해야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700266
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700266,
					"content": "물론, 네가 참전하고 싶다 해도 널 지지할 거야. 주둔 부대도 전력으로 널 지원할 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700267
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700267,
					"content": "지맥의 혼란을 효과적으로 제어하면, 전공을 토대로 너에게 마땅한 보상을 지급할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700268,
						716700269
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700268,
					"content": "공적이든 사적이든 난 다 도울 거야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700270
					]
				},
				{
					"id": 716700270,
					"content": "맞아, 리월 사람의 좋은 동료이자 에이스 모험가 파트너로서, 각청과 야란의 친구로서 이대로 가만히 있을 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700271
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700271,
					"content": "게다가 우린 보수 걱정은 전혀 없어. 각청이랑 야란은 우릴 섭섭하게 대한 적이 없으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700272
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716700272,
					"content": "눈빛이 진지해졌네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700273
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700273,
					"content": "멋진 기세야! 그럼 얼른 이 문제를 해결해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700274
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700274,
					"content": "#야란, 부하한테 {NICKNAME}을(를) 도울 준비를 하라고 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700275
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716700275,
					"content": "잠깐만, 분석 좀 할게. 지맥 혼란 포인트의 상황은 주기적으로 변해서 신중하게 진입해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716700276
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716700276,
					"content": "그동안 컨디션을 점검하면서 너만의 정예 부대를 꾸려 봐. 흔치 않은 격전이 될 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701201
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716701201,
					"content": "타이밍이 좋네. 지금이라면 비경의 중요 구역까지 깊숙이 들어갈 수 있겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701202
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716701202,
					"content": "길 위의 「규칙」을 찾아서 적합한 방식으로 강적을 처치하는 게 전제 조건이겠지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701203
					],
					"speakerTitle": "야란"
				},
				{
					"id": 716701203,
					"content": "신중하고 예리하게 항상 주변 환경을 살펴. 그리고 아군의 상태도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701204
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716701204,
					"content": "상황이 좋지 않다면 일단 후퇴해서 재정비해도 좋아. 무리하지 말고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701205
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716701205,
					"content": "승전보를 기다릴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716701206,
						716701207
					],
					"speakerTitle": "각청"
				},
				{
					"id": 716701206,
					"content": "최선을 다할게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716701208
					]
				},
				{
					"id": 716701208,
					"content": "응! 각청, 야란, 좋은 소식 기다리고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716701207,
					"content": "열심히 싸울게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716701208
					]
				},
				{
					"id": 716700269,
					"content": "같이 싸울 동료도 엄청 많다고!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700270
					]
				},
				{
					"id": 716700256,
					"content": "저만 할 수 있는 일이겠네요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700257
					]
				},
				{
					"id": 716700244,
					"content": "그런 일이 있었어요? 전 전혀 몰랐어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700245
					]
				},
				{
					"id": 716700220,
					"content": "그 정도는 아니지만 최선을 다할게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700221
					]
				},
				{
					"id": 716700210,
					"content": "내가 교관이었다니!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700211
					]
				},
				{
					"id": 716700204,
					"content": "언제든 싸울 수 있게 경계를 강화해야겠어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716700205
					]
				}
			]
		},
