	"talks": [
		{
			"id": 7052701,
			"completionStepIds": [
				7052702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052702",
							"2"
						],
						"stepId": 7052702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
