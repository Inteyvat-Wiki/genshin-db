			"trigger": {
				"objectNames": [
					"진"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "…사건의 전말은 이래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3580102,
					"content": "자유의 도시에 온 걸 환영해. 바람을 따라서 온 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580103,
					"content": "나는 단장 대행 진. 그리고 여긴 기사단의 도서관 사서인 리사야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580104,
					"content": "와우, 손이 부족해서 도와주러 온 착한 어린이들인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3580105,
					"content": "어머나 귀여워라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3580106,
					"content": "시기는 별로 안 좋지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3580107,
					"content": "풍마룡은 소생한 뒤로 도시 주변에서 맴돌면서 혼란을 만들고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3580108,
					"content": "몬드성의 원소 흐름과 지맥 순환이 모두 엉망진창이 돼 버렸지 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3580109,
					"content": "마법사에겐 아주 치명적인 상태지…. 피부도 기분도 모두 망쳤어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3580110,
					"content": "만약 이러한 교란만 없었더라면 벽보를 붙이는 것보다 더 큰 도움을 줬을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580111,
					"content": "우리 페보니우스 기사단이 최선을 다해 문제를 해결해 줄 테니 잠시 몬드성에서 머물러줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580112,
					"content": "기사단에게만 모든 걸 맡길 순 없죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "페이몬도 도울게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3580116,
					"content": "그럼, 작전 계획을 짜볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3580117,
					"content": "풍마룡이 몬드성을 공격한 게 역으로 이 재난을 종결시킬 방법을 찾는 계기가 되었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580118,
					"content": "리사의 마법 탐지로 몬드성을 뒤덮은 폭풍의 근원을 알아냈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580119,
					"content": "오호? 그럼 방법은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3580120,
					"content": "버려진 <color=#00E1FFFF>「바람 사신수」 사당</color>이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3580121,
					"content": "풍마룡은 거기에 남아 있는 힘을 이용해 이런 폭풍을 불러일으킨 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3580122,
					"content": "우리의 목표는 네 곳의 버려진 사당 가운데 <color=#00E1FFFF>세 곳</color>이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580123,
					"content": "세 곳만 선택하는 이유는… 모두 알고 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580124,
					"content": "모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3580125,
					"content": "몬드 사람들은 서로 통한다는 건가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "더 지체해서는 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580128,
					"content": "폭풍이 기승을 부리고 있으니 방어만 하는 건 소용없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "진"
				},
				{
					"id": 3580129,
					"content": "재해가 더 확대되기 전에 우리가 먼저 <color=#00E1FFFF>버려진 사당 유적</color>으로 가야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진"
				},
				{
					"id": 3580126,
					"content": "우리 나중에 다시 물어 보자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "그럼 기사단만 믿을 게요. 여관은 어디죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "이봐! 게으름 피우지 마. 우리도 함께해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}