			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780201,
					"content": "여기도 감실이 하나 있는데 가볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721780202,
					"content": "(평범해 보이는 감실이다. 특이한 원소 흔적은 없다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780203,
					"content": "조사",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(이 감실은 깨끗해 보인다, 은은한 벚나무 향기가 난다. 아마 얼마 전에 여기서 기도를 한 것 같다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780205,
					"content": "(하지만 그 외에 최근에 남겨진 흔적은 없다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780206,
					"content": "신성한 벚나무 냄새야… 쵸지 엄마가 왔을 수도 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721780207,
					"content": "그것도 얼마 전에!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
