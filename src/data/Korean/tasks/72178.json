			"dialogs": [
				{
					"id": 721780401,
					"content": "여기가 쵸지가 말한 감실이겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721780402,
					"content": "(평범해 보이는 감실이다. 특이한 원소 흔적은 없다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780403,
					"content": "조사",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(소박하지만 우아한 감실, 목재로 만들어진 감실에서 은은한 빛이 반짝거리며 단정한 자태로 손님의 공양을 맞이하고 있다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780405,
					"content": "(감실 주변에 신성한 벚나무에서 떨어진 꽃잎이 흩어져 있다. 자연적으로 만들어진 것이 아니라 벚꽃 수구를 뿌려둔 것 같다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780406,
					"content": "음… 여기도 흔적은 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721780407,
					"content": "저기, 벚꽃 수구…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "맞아, 쵸지가 엄마가 감실에서 이걸 공양한다고 했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721780410,
					"content": "이렇게 많은 꽃잎이 있는 걸 보면… 우연이 아닌 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721780411,
					"content": "빨리 돌아가서 쵸지한테 알려주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721780408,
					"content": "쵸지 엄마의 공양품이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				}
			]
		},
