			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780101,
					"content": "(평범해 보이는 감실이다. 특이한 원소 흔적은 없다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780102,
					"content": "조사",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(이 감실은 상태가 양호하다. 정리한 지 얼마 안 된 거 같다. 정리하는 사람이 매우 세심한 사람인 것 같다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780104,
					"content": "(하지만 그 외에 누가 온 흔적은 없다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "감실"
				},
				{
					"id": 721780105,
					"content": "이상해… 누군가 온 적이 있는 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7217802,
			"completionStepIds": [
				7217803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
