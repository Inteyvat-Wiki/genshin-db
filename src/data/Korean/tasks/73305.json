			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"릴루페르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733052201,
					"content": "저와 저쪽에 있는 「장기말」을 연결해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733052202,
					"content": "여… 연결…? 그게 무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733052203,
					"content": "장기말 표면에서 돌출된 부분을 찾아서 내 병 슬롯에 꽂으면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733052204,
					"content": "엥… 슬롯이라니? 그냥 매끄러운데? 뭘 꽂을 수 있는 부분은 안 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733052205,
					"content": "네 눈에 보이지 않을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733052206,
					"content": "어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733052207,
					"content": "방금 전 내가 지어낸 말이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052208
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733052208,
					"content": "이런… 야——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052209
					],
					"speakerTitle": "페이몬"
				},
