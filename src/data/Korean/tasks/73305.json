			},
			"dialogs": [
				{
					"id": 733051201,
					"content": "…조심하세요. 지하 깊은 곳에서 이상한 진동이 느껴져요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051202
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733051202,
					"content": "응? 뭔가가 느껴진 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733051203,
					"content": "별거 아니야… 단순한 훈련일 뿐이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051204
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733051204,
					"content": "오오, 별건 아니고 그냥 「훈련」일 뿐이구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733051205,
					"content": "잠깐—— 「훈련」은 무슨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733051206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733051206,
					"content": "쉿… 놈들이 온다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "릴루페르"
				}
			]
		},
		{
			"id": 7330522,
			"completionStepIds": [
				7330522
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
