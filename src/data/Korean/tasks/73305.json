				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050402,
					"content": "으… 릴루페르, 괜찮아? 왜 갑자기 반응이 없는 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050403,
					"content": "쉿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "잠깐만, 저기 좀 봐봐… 릴루페르의 몸에서 빛이 나오고 있어. 평소랑 왠지 다른 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050406,
					"content": "지니의 요술병이 어슴푸레 빛나더니 「장기말」과 같은 속도로 진동하기 시작했다.\\n귓가에 시간의 흐름이 들리기 시작한다. 시간의 소리는 마치 감옥에서 떨어지는 물방울 소리와도 같았다… 평생처럼 길고, 또 한순간처럼 짧았다.\\n릴루페르는 아무 말도 없다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "짙은 안개 속에서 거대하지만 차가운 구라바드를 발견한다.\\n곧 대지가 갈라지고 구라바드의 모든 것을 한입에 삼켜버린다….\\n하지만 구라바드의 성문은 벼랑에 박힌 듯 끄떡없는 모습이다. 그 문은 과거의 모든 더러움이 모인 것처럼 추악했으나, 사람들은 시선을 주지 않았다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "기억이 나는 것 같아요. 구라바드가 저쪽에 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050409,
					"content": "머리가 너무 아파…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "으으, 이게 도대체 어떻게 된 거야… 다음에는 제발 미리 좀 말해줘! 매번 이런 식으로 놀라게 만들지 말구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050411,
					"content": "미안, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "흥, 사과해도 난 화낼 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050415,
					"content": "흐흥… 어린애가 따로 없네. 알겠어. 걱정하지 마, 꼬마야. 주인님은 꼭 돌려줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050416,
					"content": "그러면 주인님은 사과의 의미라며 네게 맛있는 것도 잔뜩 사주시겠지? 아… 「머라」였나? 인간들이 사용하는 화폐였지 아마?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050417,
					"content": "「모라」야… 아니다, 왜 내가 고쳐주고 있지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "당연히 그래야지… 기억해둘게! 맛있는 음식과 모라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050420,
					"content": "자, 어리광은 그쯤 부리고 이제 구라바드로 가는 거예요. 주인님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050421,
					"content": "우리가 왜 그곳으로 가야 하지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "왜냐고요? 저도 모르겠네요… 아니, 애초에 이유 같은 건 별로 중요하지 않을지도 몰라요. 하지만 어떻게든 그곳으로 가야 해요, 주인님…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050423,
					"content": "굳이 이유를 말하자면, 주인님에게 제 과거와 제가 배운 교훈을 직접 확인시켜드리고 싶기 때문이려나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050428,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050429,
					"content": "밑도 끝도 없는 부탁이잖아…. 무슨 말인지 당최 모르겠어. 그리고 왜 당장이라도 떠나려는 사람처럼 말하는 거야? 무슨 일이라도 생겼어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050430,
					"content": "하하… 그런 거 아니야. 그냥 당신들이 직접 확인했으면 하는 게 있어서 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050431,
					"content": "뭐야, 나이 좀 먹었다고 수수께끼처럼 말하기는!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050432,
					"content": "어쨌든 절 따라와 주세요. 제가 구라바드로 안내할 테니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050424,
					"content": "구라바드… 그곳엔 뭐가 있는데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "아무것도 없죠. 아니, 아무것도 남지 않았어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050426,
					"content": "그곳에 남아있는 건, 망령의 기억과 산산이 조각나서 복원될 수 없는 꿈, 복수 뒤에 따르는 달콤한 여운뿐이라고 할 수 있겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050427,
					"content": "제 요구가 좀 과하다는 건 저도 알지만… 당신이 직접 제 과거를 확인하고 교훈을 느껴봤으면 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 733050418,
					"content": "멋대로 대신 결정을 내리지 마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "난 괜찮아, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "흥, 저번에도 그렇게 말했잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733050404,
					"content": "릴루페르?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
		{
			"id": 7330506,
			"completionStepIds": [
				7330506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
