			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"줄리앙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#페이몬, {NICKNAME}. 너희 왔구나! 밖을 여행할 땐 역시 친구들의 도움이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "줄리앙"
				},
				{
					"id": 732960202,
					"content": "전에 약속했잖아. 길 안내하는 게 딱히 어려운 일도 아닌데 뭐! 누워서 떡 먹기… 아니, 이럴 땐 걸으면서 떡 먹기라고 해야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732960203,
					"content": "그나저나 진짜 벌써 폰타인으로 돌아갈 거야? 수메르엔 멋진 풍경이 정말 많은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732960204,
					"content": "우림의 풍경은 정말 아름다워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "나무도 많고, 강도 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732960208,
					"content": "매력적이긴 하지만… 사실 난 아직 멀리 나갈 준비가 안 된 것 같아. 실패한 여행이었지만 이번에 값진 교훈을 얻었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "줄리앙"
				},
				{
					"id": 732960209,
					"content": "으… 그, 그럼 이 근처에도 볼 만한 경치가 있거든!? 놓치면 너무 아깝잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732960210,
					"content": "페이몬의 추천이니까 확실해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "너희가 이렇게까지 말하는데, 더 거절하는 건 친구에 대한 예의가 아니겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "줄리앙"
				},
				{
					"id": 732960212,
					"content": "헤헤, 난 티바트 최고의 가이드라구. 길 안내는 나한테 맡겨! 잘 따라와야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732960206,
					"content": "사막의 풍경은 정말 특별해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "모래도 많고, 유적도 잔뜩 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
