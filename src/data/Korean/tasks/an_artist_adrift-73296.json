				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "화가는 펜을 들기 전에 다양한 각도에서 관찰한다던데… 「고정 관념」인 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732960302,
					"content": "같이 근처를 돌아볼까? 높은 곳에 올라가서 봐도 좋고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732960303,
					"content": "좋은 생각 같아. 난 준비됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "줄리앙"
				},
				{
					"id": 732960304,
					"content": "#그럼 우리 누가 먼저 결승점에 도착하는지 시합할까? {NICKNAME}, 준비됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
