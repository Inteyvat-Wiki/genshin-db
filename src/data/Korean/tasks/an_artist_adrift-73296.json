					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961404
					],
					"speakerTitle": "줄리앙"
				},
				{
					"id": 732961404,
					"content": "푹 쉬면서 회복에 집중해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "줄리앙"
