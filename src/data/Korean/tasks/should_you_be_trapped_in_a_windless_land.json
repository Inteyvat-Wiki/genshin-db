			"dialogs": [
				{
					"id": 101130211,
					"content": "스탠리…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 101130212,
					"content": "이렇게 오랜 시간 동안, 그를 속박하고 있었던 건 더 이상 그 「친구」가 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130213
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 101130213,
					"content": "하지만 그 친구의 이야기는 영원히 몬드에서 잊혀지지 않겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "다이루크"
				}
			]
		},
		{
			"id": 1011303,
			"completionStepIds": [
				1011303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
