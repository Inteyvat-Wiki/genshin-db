					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "아란나가, 드디어 왔어. 저들이 왔다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730590202,
					"content": "응, 왔다 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730590203,
					"content": "#나라{NICKNAME}(이)랑 하얀 둥실이, 왔구나! 환영해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 730590204,
					"content": "달이 떴으니까 이제 꽃을 심을 시간이 됐어, 준비됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 730590205,
					"content": "준비됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "응, 나도 준비됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730590207,
					"content": "그럼… 아란나킨, 아란가루, 이제 의식을 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 730590208,
					"content": "「돌아가라, 돌아가. 화원의 꿈도, 숲의 기억도…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 730590209,
					"content": "「맞이한다, 우리가:」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730590210,
					"content": "「점점 짙어지는 꿈, 흩어지지 않는 환희」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730590211,
					"content": "「경축한다, 우리가:」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730590212,
					"content": "「석류는 노래하고, 사과는 박수를 치네!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730590213,
					"content": "아란나라들이 말라버린 꽃을 심는다. 바람 속에 노랫소리가 울려 퍼지자, 꽃이 기적처럼 생명을 되찾는다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "와… 꽃 세 송이가, 다시 살아났잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730590215,
					"content": "응… 자애로운 「마우티이마」니까. 이제 다시 기억이 되살아나게 해줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 730590216,
					"content": "맞아! 우리가 더 이상 너희를 기억하지 못하더라도, 기억은… 잎맥과 뿌리 사이에 녹아들어 푸른 잎이 되고 나이테로 변할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730590217,
					"content": "아니면 통통한 벌레로 변해서 다른 벌레의 먹이가 되겠지. 그리고 그 벌레가 초목에 남긴 것들을 통해 우리가 성장할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730590218,
					"content": "하지만… 너흰 여전히 우릴 기억하지 못 하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730590219,
					"content": "응… 기억은 우리들의 소유가 아니거든…. 예전에 겪었던 일들은 모두 숲의 초목들에게 나눠주었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 730590220,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "하지만 괜찮아, 우린 이미 새로운 친구가 됐잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730590222,
					"content": "응, 맞아! 새로운 친구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란가루"
				}
			]
		},
