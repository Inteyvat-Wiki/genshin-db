				"points": []
			},
			"dialogs": [
				{
					"id": 730750201,
					"content": "#나라{NICKNAME}이(가) 있는 우트사바 축제는 나라바루나와 함께 보냈던 축제랑 비슷해… 이렇게 즐거운 게 얼마 만인지 모르겠어. 흑흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750202
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730750202,
					"content": "비파랴스는 「눈물」을 용납하지 않아. 우트사바 축제는 기쁜 명절이어야 해. 아란나쿨라가 비파랴스를 위해 즐거운 음악을 연주해 줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란카라"
				}
			]
		}
