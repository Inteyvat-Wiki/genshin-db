				"objectNames": [
					"아란나쿨라",
					"아란카라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730750101,
					"content": "#나라{NICKNAME}와(과) 페이몬, 고마워. 이제 바나라나의 모밭에 비파랴스가 가득 자랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730750102,
					"content": "이곳의 비파랴스는 모두 행복해. 그래서 아란카라도 행복해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730750103,
					"content": "우트사바 축제가 끝났으니까, 금빛의 나라가 바나를 떠나기 전에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730750104,
					"content": "비파랴스 한 묶음을 받았다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#행복한 비파랴스를 금빛의 나라에게 줄게. 나라{NICKNAME}와(과) 페이몬도 행복했으면 좋겠어. 비파랴스는 시들지 않겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730750106,
					"content": "그래도 가끔씩 비파랴스한테 말을 걸어 줘야 해. 제일 좋은 건 연주를 해주는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730750107,
					"content": "#대지와 아란나라는 잊지 않을 거야. 나라{NICKNAME}(이)랑 페이몬도 잊지 않았으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란나쿨라"
				}
			]
		},
