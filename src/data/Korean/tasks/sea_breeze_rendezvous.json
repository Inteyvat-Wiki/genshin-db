				},
				{
					"id": 140240604,
					"content": "봐, 바깥 풍경이 정말 아름답지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240605,
						140240606
					],
					"speakerTitle": "크레이비"
				},
				{
					"id": 140240605,
					"content": "창문?",
