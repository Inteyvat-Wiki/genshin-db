						700782035
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700782035,
					"content": "난 내 분수를 알아. 장사라면 모를까, 모험은 내 전문이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782036
					],
					"speakerTitle": "오돌프"
				},
				{
					"id": 700782036,
					"content": "자, 친구들. 다음에 또 술집에 오면 그땐 더 재밌는 얘기나 나누자!",
