			"dialogs": [
				{
					"id": 700781601,
					"content": "아까 경보 장치가 빠르게 번쩍이길래, 여기 뭐라도 있는 줄 알았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700781602,
					"content": "지금 보니 아무것도 없잖아… 심연 마물도 없고, 유령도 없구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700781603,
					"content": "오히려 좀 쓸쓸한 느낌인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700781604,
					"content": "…쓸쓸함이야말로 가장 무서운 마귀일지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700781605
					]
				},
				{
					"id": 700781605,
					"content": "오, 그래? 무슨 말인지 전혀 모르겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700781606,
					"content": "근데 아까 불어대던 바람은 대체 어디서… 어라, 아니야, 위쪽이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700781607,
					"content": "위에서 뭔가 떨어진다, 으악——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
