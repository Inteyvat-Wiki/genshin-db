			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「압도적인 장비 격차」"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-347.962,
							200.495,
							-711.101
						],
						"pointId": 7028
					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "안녕! 나 왔어! 「아라타키 반짝반짝 갑각 곤충 싸움 수행」이 어디까지 진행됐는지 좀 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "「압도적인 장비 격차」"
				},
				{
					"id": 716664002,
					"content": "마침 잘 왔어, 연비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716664003,
					"content": "은인! 행사 허가를 받을 수 있게 도와줘서 정말 고마워. 그리고 멋진 홍보용 그림도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716664004,
					"content": "그나저나 그 기세를 보아하니… 혹시 대결에 직접 참여하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716664005,
					"content": "어라? 안 되나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "「압도적인 장비 격차」"
				},
				{
					"id": 716664006,
					"content": "해외 무역을 하는 고객이 한 분 계시는데, 그분이 소송에서 이길 수 있게 도와드린 적이 있거든요. 그래서 선물을 잔뜩 받았는데, 그중엔 특별한 귀신풍뎅이도 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "「압도적인 장비 격차」"
				},
				{
					"id": 716664007,
					"content": "그땐 어떻게 키워야 할지 몰라서 할머니께 한동안 봐달라고 맡겨뒀는데, 이제 보니 꽤 튼실한 녀석 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "「압도적인 장비 격차」"
				},
				{
					"id": 716664008,
					"content": "곤충 싸움 대회에 참여해도 흥이 깨지진 않겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "「압도적인 장비 격차」"
				},
				{
					"id": 716664009,
					"content": "은인 누님을 절대 무시하지 마, 오니의 왕. 곤충 싸움 경험은 없지만, 상상 이상으로 강한 귀신풍뎅이를 내보낼 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "「하나카도 장군」"
				},
				{
					"id": 716664010,
					"content": "음, 그렇군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716664011,
					"content": "그렇다면 「귀왕의 오른팔」이 「붉은 방망이」랑 출전하는 게 좋겠어. 내 친구는 어떤 상대를 만나도 침착하니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716664012,
					"content": "그럼요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#{NICKNAME}와(과)의 대결이라, 좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "「압도적인 장비 격차」"
				},
				{
					"id": 716664015,
					"content": "아직 곤충 싸움의 요령을 잘 모르니까 좀 서툴러도 양해해 줘~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「압도적인 장비 격차」"
				},
				{
					"id": 716664013,
					"content": "칭찬 고마워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
