				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "무슨 일이에요, 사라 아가씨?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "미안해요, 방금 막 밥을 다 먹은 참이었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "당신들이 오길 눈이 빠지게 기다렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860205,
					"content": "호객 행위를 하려는 게 아니에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860206,
					"content": "기사단에 뭘 좀 의뢰하려고 하는데 단장 대행님한테 말 좀 전해줬으면 해서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860207,
					"content": "진을 찾는 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4860209,
					"content": "서로 신뢰하는 친구 사이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "한 번 만나본 적이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "#전 진 단장의 충실한 {M#하인이죠}{F#하녀이죠}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "어? 진 단장님이랑 친한 사이인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860210,
					"content": "그래요? 진 단장님과 함께라면 엄청 안심이 되겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860212,
					"content": "진 단장님이 당신들을 되게 마음에 들어 하신다고 들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860214,
					"content": "#{M#하, 하인이요?!}{F#하, 하녀요?!} 설마 이제 페보니우스 기사단도 옛 귀족의 길을 걷는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860215,
					"content": "#미안, {NICKNAME}가 가끔 이상한 농담을 할 때가 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4860216,
					"content": "그래서 사라 씨가 전하고 싶은 말이 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4860217,
					"content": "음… 정말 죄송하지만, 요즘 식당 일이 너무 바빠서 직접 기사단에 갈 수가 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860218,
					"content": "근데 하필 이럴 때 츄츄족이 샘물 마을에서 몬드로 식자재를 공급하는 노선을 점령해버렸지 뭐예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860220,
					"content": "기사단에 부탁해 노선을 정리해달라는 말이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "알겠어요, 사냥꾼들을 혼쭐 내줘야겠어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "게다가 샘물 마을 사냥꾼들은 사냥만 책임진다면서 나 몰라라 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860221,
					"content": "맞아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860223,
					"content": "뭐야! 그럼 근본적인 문제를 해결할 수 없잖아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4860225,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "저 대신 <color=#00E1FFFF>진 단장님한테</color> 수송 경로에 있는 츄츄족들을 처치해줄 사람을 보내 달라고 전해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860226,
					"content": "휴… 살았다. 진 단장님이 나서면 빨리 해결할 수 있을 거예요. 고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860227,
					"content": "다들 진을 엄청 신뢰하고 있는 모양이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4860228,
					"content": "아, 참. <color=#00E1FFFF>바텐더 찰스</color> 씨도 도움이 필요한 것 같았어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860229,
					"content": "가는 길에 한번 들르는 게 어때요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "사라"
				},
				{
					"id": 4860230,
					"content": "음… 가는 길은 아니지만…. 한번 도왔으면 끝까지 도와야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"찰스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "뭘 마시겠나? 여긴 주스 가게가 아니야, 꼬마 친구들",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 4860302,
					"content": "흥, 그건 실례잖아. 우린 도와주러 왔다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4860303,
					"content": "도우러 왔다고? 참, 너희가 바로 요즘 단장 대행님의 총애를 받고 있다는 유명인들이구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 4860304,
					"content": "윽 …그게 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4860305,
					"content": "그럼 진 단장한테 가서 이번 분기의 세금 신고서를 가져다주겠니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
