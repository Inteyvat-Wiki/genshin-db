			"dialogs": [
				{
					"id": 4861001,
					"content": "엇, 케이아다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4861002,
					"content": "마침 둘을 기다리고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861003
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861003,
					"content": "진이 쓰러졌다는 소식은 이미 들었어, 기사단을 대표해서 감사를 전할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861004,
					"content": "케이아가 이렇게 진지하게 고맙다고 하다니. 적응이 안 되는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4861005,
					"content": "하하, 대리 단장의 일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861006,
					"content": "참, 이 일 외에도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861007,
					"content": "다른 일을 주려는 건가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "맞아~! 우리 좀 마음이 잘 통하는 것 같은데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861009,
					"content": "보상 주는 단계가 온 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "하하하, 말하는 스타일이 마음에 드네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861011,
					"content": "하지만 그전에 기사단의 일을 좀 더 도와줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861012,
					"content": "진이 맡은 일들을 도와달라는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4861013,
					"content": "그래, 전에 네가 진에게 보고한 의뢰들은 이미 처리할 사람을 보내긴 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861014,
					"content": "…진이 직접 나서지 않은 터라 실수라도 할까 봐 걱정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861015,
					"content": "네가 가서 도와줬으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861016,
					"content": "몬드의 「명예 기사」가 직접 나서준다면 나도 안심할 수 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861017,
					"content": "#{NICKNAME}을(를) 칭찬해주는 건 고마운데 할 말은 해야겠어, 왜 네가 직접 가지 않는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4861018,
					"content": "하하, 나한테는 더 중요한 임무가 있어서…. 음, 「준비」해야 할 것들이… 좀 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4861019,
					"content": "흥, 그래 그럼. 내 기억으로는… <color=#00E1FFFF>사라 씨와 찰스 씨 그리고 마가렛</color>. 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4861020,
					"content": "맞아, 그럼 둘한테 부탁할게. 나중에 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케이아"
				}
			]
