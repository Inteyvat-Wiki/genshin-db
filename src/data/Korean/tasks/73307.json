				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733070601,
					"content": "소루쉬와 그녀의 「찬{RUBY#[D]야스나}송의 주인」… 심지어 페이몬까지 있군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070602
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070602,
					"content": "이봐! 왜 내 이름 앞에 「심지어」가 붙는 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733070603,
					"content": "그보다 뭔가 흥미로운 일이 있었던 모양이군?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070604
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070604,
					"content": "흥미로운 일이라기보단…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733070605,
					"content": "주르반에게 「영혼이 깃든 나무」에 대해 말한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733070606
					]
				},
				{
					"id": 733070606,
					"content": "흠… 어디서부터 말해야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070607
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070607,
					"content": "너희가 만난 건 「영{RUBY#[D]프라바시}혼이 깃든 나무」로 변한 페리가 맞다. 하지만 그 안에 깃든 건 영혼의 잔재라기보단, 기억의 조각이라고 보는 게 더 맞겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070608
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070608,
					"content": "너희가 손에 넣은 그 「맑은 빛의 깃털」처럼, 그 안에는 대지로 돌아갈 수 없는 기억이 담겨 있다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070609,
						733070610
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070609,
					"content": "대지로 돌아갈 수 없다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070613
					]
				},
				{
					"id": 733070613,
					"content": "우리 페리는 꽃바다의 감로에서 태어나 마지막엔 또다시 꽃바다 속으로 돌아가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070614
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070614,
					"content": "이곳을 지키는 신처럼, 우리는 대지 속 시간의 흐름에 거부당한 종족이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070615
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070615,
					"content": "물론 그 또한 우리가 바라던 바지. 칠흑의 것들이 우리와 함께 대지에 흘러 들어가는 것을 막는 게 우리의 사명이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070616
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070616,
					"content": "「감로 연못」에서 우리는 감로로 모든 더러움을 씻어낼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070617
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070617,
					"content": "너희가 「맑은 빛의 깃털」을 「감로 연못」에 바치면, 바깥에 흩어진 페리는 다시 꽃바다로 돌아올 수 있게 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070618
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070618,
					"content": "오오, 우리가 좋은 일을 했나 본데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070619
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733070619,
					"content": "흥, 우쭐대는 꼴이라니. 다 내 덕분이었으면서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070620
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 733070620,
					"content": "응응, 소루쉬도 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070621
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733070621,
					"content": "진작 그럴… 아니지, 난 흰두둥실이 칭찬은 필요 없고, 「찬{RUBY#[D]야스나}송의 주인」만 있으면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070622
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 733070622,
					"content": "「찬{RUBY#[D]야스나}송의 주인」 얘기가 나왔으니 말인데, 넌 그 칭호를 받아들인 셈이니 이 의식을 완성하기에 더할 나위 없는 적임자인 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070623
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070623,
					"content": "과거 페리와 함께한 인간 용사는 사막에 흩어진 페리를 위해 죄를 정화하는 의식을 거행했고, 그들을 꽃바다로 돌려보냈지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070624
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070624,
					"content": "그렇게 페리와 특별한 연결을 맺은 인간들은 「찬{RUBY#[D]야스나}송의 주인」이라 불리게 되었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070625
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070625,
					"content": "소루쉬가 말했던 거랑 전혀 다르잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070626
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733070626,
					"content": "뭐, 아무렴 어떤가. 「찬{RUBY#[D]야스나}송의 주인」으로서 너희에겐 길 잃은 페리를 구원할 책임이 있다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070627
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070627,
					"content": "혹시 또 그런 「영{RUBY#[D]프라바시}혼이 깃든 나무」를 발견하면, 나무에 맺힌 「맑은 빛의 깃털」을 꽃바다로 가져와 주도록",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070628
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070628,
					"content": "그렇게 말 안 해도 우린 페리를 도울 생각이었다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733070610,
					"content": "「감로 연못」에 공양한 것도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070611
					]
				},
				{
					"id": 733070611,
					"content": "「맑은 빛의 깃털」은 신성한 새 「시무르그」의 크바{RUBY#[D]신성한 빛}레나에서 탄생한 거다. 우리 페리도 크바{RUBY#[D]신성한 빛}레나와 감로가 결합해 탄생한 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070612
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 733070612,
					"content": "그래서 우리가 크바{RUBY#[D]신성한 빛}레나의 후손이라 불리는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070613
					],
					"speakerTitle": "주르반"
				}
			]
		},
