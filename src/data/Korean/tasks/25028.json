					{
						"sceneId": 3,
						"position": [
							-3018.554,
							200.486,
							8722.414
						],
						"pointId": 9242
					}
				]
			},
			"dialogs": [
				{
					"id": 250280701,
					"content": "윽… 내 레코드… 이건 원본… 원본 레코드라고…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280702
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280702,
					"content": "정말 죄송해요, 도움이 필요하시면 언제든 말씀해주세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280703,
						250280704
					],
					"speakerTitle": "리요"
				},
				{
					"id": 250280703,
					"content": "적어도 하나밖에 없는 건 아니네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280705
					]
				},
				{
					"id": 250280704,
					"content": "아예 사라진 건 아니니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250280705
					]
				},
				{
					"id": 250280705,
					"content": "됐어, 다 부서져 버렸으니… 더 이상 복구할 방법이 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280706
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280706,
					"content": "이렇게 된 이상 그냥 묻고 싶은 게 하나 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280707
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280707,
					"content": "…내 레코드를 들었을 때, 듣기 좋다고 생각했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280708
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280708,
					"content": "아이들과 아기 용을 끌어당기는 그런 「듣기 좋은」 노래가 아니라, 그러니까… 대중성을 지닌 「듣기 좋은」 노래 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280709
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280709,
					"content": "무슨 말인지 알겠어? 이 레코드를 들을 때, 그런 느낌이 들었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280710
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280710,
					"content": "대중성? 그건… 잠시만요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280711
					],
					"speakerTitle": "리요"
				},
				{
					"id": 250280711,
					"content": "너희가 아기 용을 보내서 레코드를 빼앗으려고 했던 건, 그 음악이 대중성이 있기 때문이잖아, 그렇지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280712
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280712,
					"content": "저기, 제 얘기 좀 들어보세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280713
					],
					"speakerTitle": "리요"
				},
				{
					"id": 250280713,
					"content": "저희는… 아기 용에게 레코드를 가져오라고 「지시」한 적이 없어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280714
					],
					"speakerTitle": "리요"
				},
				{
					"id": 250280714,
					"content": "아마 아기용들이 레코드에서 나오는 노래에 이끌려 직접 달려간 것 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280715
					],
					"speakerTitle": "리요"
				},
				{
					"id": 250280715,
					"content": "뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280716
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280716,
					"content": "당신의 노래는 정말 훌륭해요! 믿어주세요, 제가 당신의 레코드를 틀 때마다 아기 용들이 절 둘러싸고는 미친 듯이 뛰어다녀요! 아주 신나 보이죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280717
					],
					"speakerTitle": "리요"
				},
				{
					"id": 250280717,
					"content": "뭐? 젠장… 내 레코드…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280718
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250280718,
					"content": "그 기분 이해해요. 이렇게 훌륭한 레코드가 망가져 버려서 정말 죄송합니다. 하지만 전 당신과 다시 한번 레코드를 제작하고 싶어요! 제가 있으면 아무도 당신의 레코드를 빼앗아 갈 수 없을 겁니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250280719
					],
					"speakerTitle": "리요"
				},
				{
					"id": 250280521,
					"content": "내 음반은! 그런 동요가 아니라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "밀루·누이"
				}
			]
		},
