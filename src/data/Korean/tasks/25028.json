	"talks": [
		{
			"id": 2502801,
			"completionStepIds": [
				2502801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
