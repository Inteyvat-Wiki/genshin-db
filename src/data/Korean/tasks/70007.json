			"trigger": {
				"objectNames": [
					"열애 중인 청년",
					"열애 중인 소녀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "진짜 감동적인 스토리야. 근데 해피 엔딩이 아니라서 아쉬워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "열애 중인 청년"
				},
				{
					"id": 700070202,
					"content": "우린 이렇게 되지 말자, 알았지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "열애 중인 소녀"
				},
				{
					"id": 700070203,
					"content": "당연하지, 지금은 장거리 커플이지만, 어떻게든 널 꼭 내 곁으로 데려올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "열애 중인 청년"
				},
				{
					"id": 700070204,
					"content": "도서관에서는 조용히 하셔야죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "엥? 최대한 작게 말했는데요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "열애 중인 소녀"
				},
				{
					"id": 700070207,
					"content": "휴, 이것도 연애를 방해하는 시련인가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "열애 중인 청년"
				},
				{
					"id": 700070208,
					"content": "다 본 책은 제자리에 갖다놔야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700070209,
					"content": "이렇게 아무데나 놓으면 사서가 힘들어진다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700070210,
					"content": "알겠어, 알겠다구. 지금 한창 달아오르고 있는데 방해하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "열애 중인 청년"
				},
				{
					"id": 700070211,
					"content": "달아오르고 있다고…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700070212,
					"content": "어떤 시련이 닥쳐도 지금 모습 변치 않을 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "열애 중인 소녀"
				},
				{
					"id": 700070213,
					"content": "그럼, 목숨을 걸고 맹세해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "열애 중인 청년"
				},
				{
					"id": 700070214,
					"content": "그건 너무 오바잖아… 목숨까지 걸다니, 나 마음 아파",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "열애 중인 소녀"
				},
				{
					"id": 700070215,
					"content": "아, 넌 너무 여려. 그게 매력이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "열애 중인 청년"
				},
				{
					"id": 700070216,
					"content": "내 말은 귓등으로 안 듣는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700070205,
					"content": "두 분이 너무 시끄럽대요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
