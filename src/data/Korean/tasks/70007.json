			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "엥? 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "사랑에 빠진 여성"
				},
				{
					"id": 700070302,
					"content": "도서관에서는 조용히 하셔야죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "미안, 주의할게. 하지만 어쩔 수 없는 때도 있긴 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "사랑에 빠진 여성"
				},
				{
					"id": 700070305,
					"content": "예를 들면 내가 책 속에서 장미를 꺼낸다던가 할 때 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "마술사 남성"
				},
				{
					"id": 700070306,
					"content": "책에서 나온 장미는 너처럼 부드럽고 지적이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "마술사 남성"
				},
				{
					"id": 700070307,
					"content": "와?! 대단해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "사랑에 빠진 여성"
				},
				{
					"id": 700070308,
					"content": "목소리가 너무 크잖아! 그리고 책으로 이상한 장난치지 마! 다 꾸겨졌잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700070309,
					"content": "페이몬, 너도 목소리가 너무 커…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "앗, 미안, 나도 모르게 그만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700070311,
