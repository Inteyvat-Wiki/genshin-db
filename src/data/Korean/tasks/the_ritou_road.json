				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"해리슨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "고마워, 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090205,
					"content": "만약에 안 도와줬으면 난 지금 이 자리에 없었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090206,
					"content": "야영지는 네가 만든 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "음… 그런 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090210,
					"content": "알다시피 이도에서 장사가 잘 안돼서, 이 야영지는… 내 영업 비밀 중 하나야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090211,
					"content": "며칠 전에 친구… 한테 부탁해 몬드에서 주조 재료를 가져오라 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090212,
					"content": "친구가 「다운 와이너리」에서 신상품들을 구해서 여기로 보내줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090213,
					"content": "그 녀석 일을 너무 못해. 상자도 부서지고, 안에 주조 재료 뚜껑도 느슨하게 닫았고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090214,
					"content": "그래서 뚜껑을 열었다 다시 닫으려고 하는 중",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090215,
					"content": "근데 뚜껑을 열자마자 슬라임이 달려들었어, 진짜 이유를 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090216,
					"content": "「다운 와이너리」의 주조 재료라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "됐어, 일단 주조 재료 일은 그 녀석이 오면 그때 다시 계산해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090218,
					"content": "날 구해줬으니 사례를 하고 싶은데… 이것들을 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090219,
					"content": "여기 있는 거 말고 옆에 있는 배 보여? 저게 내 두 번째… 영업 비밀인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090220,
					"content": "저 배를 타고 몰래 나루카미섬으로 들어갈 수 있어, 헤헤 정말 편하겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090221,
					"content": "내가 왜「몰래」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "에이, 혹시 모를… 만일에 대비해서지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090223,
					"content": "됐고, 난 가서 물건들을 정리해야 하니 이만 가 볼게, 구해줘서 고마웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090224,
					"content": "다른 장소로 옮겨야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090208,
					"content": "뭐 하고 있었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "나…물건 옮기고 있었지, 물건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "해리슨"
				}
			]
		}
	]
}