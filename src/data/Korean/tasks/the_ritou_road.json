			},
			"dialogs": [
				{
					"id": 728090108,
					"content": "물건들이 드디어 도착했네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090109
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090109,
					"content": "이렇게 오래 걸리다니 정말…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090110
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090110,
					"content": "상자에 흠도 있네, 에휴!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090111
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090111,
					"content": "조심하라고 해! 안에 물건이 깨진 건 아니겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090112
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090112,
					"content": "다행이다, 아직 안 깨져서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090113
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090113,
					"content": "응? 뚜껑이 왜 이렇게 느슨하지… 먼저 열었다 다시 닫아야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090114
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090114,
					"content": "콜록! 콜록… 칵테일 재료 냄새는 정말… 독하네, 빨리 옮겨야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090115
					],
					"speakerTitle": "해리슨"
				},
				{
					"id": 728090115,
					"content": "엥, 뭐야, 슬라임이 왜 이렇게 많아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "해리슨"
				}
			]
		},
		{
			"id": 7280902,
			"completionStepIds": [
				7280907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280907",
							"2"
						],
						"stepId": 7280907,
						"stateName": "QUEST_STATE_UNFINISHED"
