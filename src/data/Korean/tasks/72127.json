				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "왔어, 주위에 꽃들 보이지, 어때 정말 예쁘지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270102,
					"content": "예뻐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "헤헤… 당연하지! 내가 얼마나 열심히 보살피는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270106,
					"content": "참, 부탁이 하나 더 있는데, 아직 돌아오지 않는 사람들에게 편지와 꽃 몇 송이를 말려서 보내주고 싶은데 도와줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270107,
					"content": "내가… 잠을 너무 적게 자서 몇 송이 따는 데도 힘에 부쳐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270108,
					"content": "혹시 달콤달콤꽃을 좀 따줄 수 있어? 3송이면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270109,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "그럼 부탁할게, 난 조금 쉬고 있을게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270112,
					"content": "난 달콤달콤꽃의 달콤한 향기만 원해 편지에는 다른 말린 꽃을 넣을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270113,
					"content": "편지를 읽는 동안 달콤달콤꽃 향기에 둘러싸여 있으면… 편지를 읽는 사람의 기분이 좀 나아질 거라고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270114,
					"content": "그럼 부탁해, 난 조금 쉬고 있을게… 꽃을 따면 나한테 가져다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721270111,
					"content": "달콤달콤꽃은 흔히 보이는 거 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "얼마나 심은 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "얼마 안 됐어, 그냥… 잠을 조금 줄였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "하나야마 카오루"
				}
			]
