			"dialogs": [
				{
					"id": 752510101,
					"content": "마셔! 우미우치, 계속 마셔!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510102
					],
					"speakerTitle": "파파"
				},
				{
					"id": 752510102,
					"content": "으앗! 넌 누구야? 어쩌다가 나무에서 떨어진 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 752510103,
					"content": "나야 파파. 우미우치, 한 잔 더 하기로 했잖아. 이제서야 만난 게 얼마나 안타까운데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510104
					],
					"speakerTitle": "파파"
				},
				{
					"id": 752510104,
					"content": "으음…? 음…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510105
					],
					"speakerTitle": "파파"
				},
				{
					"id": 752510105,
					"content": "음…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752510106
					]
				},
				{
					"id": 752510106,
					"content": "우미우치, 왜 두 명이 된 거야? 키 큰 우미우치… 키 작은 우미우치…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510107
					],
					"speakerTitle": "파파"
				},
				{
					"id": 752510107,
					"content": "야! 너 사람 잘못 봤어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 752510108,
					"content": "응? 어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510109
					],
					"speakerTitle": "파파"
				},
				{
					"id": 752510109,
					"content": "우미우치! 어디로 간 거야? 계속 마시자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510110
					],
					"speakerTitle": "파파"
				},
				{
					"id": 752510110,
					"content": "나무에서 떨어진 주정뱅이는 비틀거리며 멀리 가버렸다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
