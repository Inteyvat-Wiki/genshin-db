			},
			"dialogs": [
				{
					"id": 721123501,
					"content": "점괘 뽑을 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123502
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123502,
					"content": "으으, 너무 차가워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721123503,
					"content": "점괘를 뽑고 싶어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123504
					]
				},
				{
					"id": 721123504,
					"content": "그래. 점괘를 뽑으려면 먼저 이걸 세게 흔들어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123505
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123505,
					"content": "이건 「점괘 뽑기 함」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123506
					]
				},
				{
					"id": 721123506,
					"content": "맞아, 안에서 죽첨 하나가 떨어질 거야. 그 죽첨을 나한테 주면 내가 그에 맞는 종이쪽지를 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123507
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123507,
					"content": "이걸 「점괘」라고 불렀던 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123508
					]
				},
				{
					"id": 721123508,
					"content": "그런 건 뭐 아무래도 상관없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123509
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123509,
					"content": "난 상관 있어! 만약에 우리가 뽑은 게 흉첨이면 어떡해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721123510,
					"content": "운명이 네게 흉첨을 준 건데 네가 뭘 어쩔 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123511
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123511,
					"content": "뭐야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721123512,
					"content": "밖에 저 선반 같은 물건은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123513
					]
				},
				{
					"id": 721123513,
					"content": "쳇",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123514
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123514,
					"content": "아주 대놓고 「쳇」이라고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123515
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721123515,
					"content": "어디 보자… 그러니까 이런 거야. 「흉첨을 『점괘 걸이』에 걸면, 흉한 일을 막을 수 있다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123516
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123516,
					"content": "아, 맞다! 만약 흉첨을 뽑으면, 그걸 저기에 묶어 놓으면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123517
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123517,
					"content": "그들은… 아니, 우리 「나루카미 다이샤」는 아주 친절해서, 흉첨을 뽑아도 그 운을 바꿀 수 있는 기회를 주거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123518
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721123518,
					"content": "뭔가 좀 이상한 것 같긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721123519,
					"content": "#{NICKNAME}, 우리도 뽑아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
