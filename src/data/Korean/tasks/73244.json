			},
			"dialogs": [
				{
					"id": 732441701,
					"content": "때, 때리지 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441702,
					"content": "그만 멈춰. 이러다 진짜 죽겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441703,
					"content": "맞는 쪽이 그런 말을 하니까 묘하게 설득력이 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441704,
					"content": "말해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441705,
					"content": "어서 말해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "알겠어, 말할게! 뭐가 궁금한데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441707,
					"content": "네가 아는 걸 전부 얘기해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441708,
					"content": "우, 우리는 그저 아드라피와 거래를 해왔을 뿐이야…. 타니트의 대모가 아자릭이랑… 새로 온 소녀를 편애한다던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441709,
					"content": "쳇, 근데 어쩐 일인지 아자릭도 실종됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441710,
					"content": "그 악독한 여자는 부족에 가치가 없어진 사람을 용납하지 않아…. 아드라피는 자신의 지위를 지키기 위해 우리한테 연락한 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441711,
					"content": "그전까지는 사막에서 일이 잘 풀리지 않았어. 하, 하지만 이번엔 모든 게 딱딱 맞아떨어졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441712,
					"content": "가치가 없어진다는 게… 무슨 뜻이지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "몰라… 정말 모른다고! 그건 사막인들 내부의 일이야…. 내 생각이지만 그 여자는 더 이상 우리를 신뢰하지 않는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441714,
					"content": "…그러니까 우릴 멀리했겠지. 우리와 자주 연락하던 아드라피도 불안해했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441715,
					"content": "우리야 이딴 곳에서 철수하면 그만이었지만 그 녀석은 착취당하며 부족의 처분을 기다려야 했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441724,
					"content": "다만 아드라피는 정말 교활한 녀석이야. 원하는 물건을 몇 번이나 구해다 줬지만 정작 우리에게 필요한 물건은 줄 기미도 안 보였으니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441725,
					"content": "그런데 녀석에게 무슨 일이 생겼다며? 무슨 일인지는 모르지만 좋은 기회인 것 같군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441726,
					"content": "좋은 기회라니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441727,
					"content": "앞으로는 아드라피와 거래할 일이 없을 것 같아서, 편지에 언급한 어떤 특별한 태고의 구조체를 가져오라고 했거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441728,
					"content": "그것만 손에 넣는다면 완전히 철수해도 얻은 게 있는 셈이니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441729,
					"content": "뭐? 너희도 빼앗을 생각으로 온 거야? 어쩐지 물건도 없고 「충전 전환 용기」도 안 보이더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441730,
					"content": "뭐? 「너희도」 빼앗을 생각으로 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441731,
					"content": "그래, 어서 「충전 전환 용기」를 내놔",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "앗, 설마 「충전 전환 용기」도 너희들이 지어낸 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441734,
					"content": "아니, 「충전 전환 용기」는 진짜야. 개수는 많지만 고대 물건이라 쓸만한 게 있을지는 모르겠군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441735,
					"content": "그래서, 「충전 전환 용기」는 어딨는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441736,
					"content": "페이몬, 기세 좋은데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#헤헤, 그런가…. {NICKNAME}, 화제를 돌리지 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441738,
					"content": "얼른 물건이 있는 장소를 말해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441739,
					"content": "…근처 거점에 있어. 열쇠는 여기 있고… 내가 아는 건 전부 얘기했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441740,
					"content": "가자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "알겠어, 지금 당장 사라질게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441741,
					"content": "두 번 다시 내 눈에 띄지 마!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "우릴 만나다니 운도 없지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "사막에서 무슨 일을 하는데…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "…그건 기밀이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441718,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#봐, 너 때문에 {NICKNAME}(이)가 화났잖아! {NICKNAME}(이)가 화나면 얼마나 무서운데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441720,
					"content": "으으… 알겠어! 말할 테니까 화내지 마! 아, 아는 건 별로 없지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441721,
					"content": "우리의 임무는 사막에 사는 각 부족의 상황을 조사하고, 교역을 통해 그들과 한편이 되어 현자의 주의를 끄는 거야…. 수메르성의 집행관님을 돕기 위해서지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441722,
					"content": "참… 사막에서 생체 샘플을 찾고 있는 프레드록 교수는 「도토레」 님에게 복종하지 않고 있어…. 내가 보기엔 질투 같지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "우인단 교역 담당자"
				},
				{
					"id": 732441723,
					"content": "크흠, 괜한 말을 했군…. 아무튼 아드라피는 우리의 물자 거래를 쭉 책임진 연락책이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "우인단 교역 담당자"
				}
			]
		},
