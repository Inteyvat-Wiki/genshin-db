			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "아, 붐붐이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441002,
					"content": "아드라피가 붐붐을 미처 데려가지 못해서 정말 다행이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441003,
					"content": "그나저나 여긴 정말 변한 게 하나도 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441004,
					"content": "대모를 꺾고 무사히 텐트로 돌아갈 수 있다고 생각한 걸까…? 정말 멍청하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441005,
					"content": "하지만 그 멍청함 덕분에 붐붐이 무사할 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441006,
					"content": "이게 무사한 거야? 붐붐, 붐붐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441007,
					"content": "왜 이렇게 된 거지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "그러게, 왜 땅에 떨어져 있는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441010,
					"content": "대체 무슨 일이 있었던 거야? 지난번만 해도 멀쩡했잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441011,
					"content": "붐붐은… 성현의 전당을 떠난 후로 점점 약해졌어. 고장이라도 난 것처럼 소리도 점점 작아졌고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441012,
					"content": "나중에는 그 소리마저 안 나더니 움직이지도 못했지. 뭐랄까, 가진 생명력을 조금씩 잃어가는 것 같았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441013,
					"content": "그때 아드라피를 제외한 다른 부족인들은 붐붐에게 무슨 일이 일어나는지 잘 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441014,
					"content": "그래서 아드라피에게 붐붐을 맡긴 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441015,
					"content": "말도 안 돼… 붐붐이 두 번 다시 깨어날 수 없는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441016,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441017,
					"content": "붐붐이 여기 있는 한 언젠간 고칠 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441018,
					"content": "하지만 단서가 전혀 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441019,
					"content": "음, 지난번에 아드라피가 그랬어. 심각한 문제가 아니라면 이틀 안에 결과가 나올 거라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441020,
					"content": "그 녀석이라면 분명 검사 기록을 어딘가에 남겨뒀을 거야. 주변을 둘러보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441021,
					"content": "「심각한 문제」가 아니라면 우리가 해결할 수 있을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				},
				{
					"id": 732441008,
					"content": "붐붐이… 왜 이러지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
