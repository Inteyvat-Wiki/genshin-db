			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"제트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "이거 봐, 여기 뭔가 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440302,
					"content": "근데 검사 기록이 아니라 편지 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440303,
					"content": "편지라고? 얼른 읽어 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440304,
					"content": "편지 내용대로라면 붐붐은 에너지가 다 떨어진 것뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440305,
					"content": "생각해 보면 우린 붐붐에게 도움을 참 많이 받았어. 적왕의 무덤 문도 열어주고 권능도 활성화해 줬잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440306,
					"content": "아무리 붐붐이라도 힘들었을 텐데… 우리 때문에 에너지를 소진한 걸지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440307,
					"content": "특별한 「충전 전환 용기」가 필요하다고 적혀 있는데, 텐트에는 없는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440308,
					"content": "혹시…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440309,
					"content": "어딘가에 숨겨둔 걸까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "그건 아닐 거야. 붐붐을 수리하는 데 필요한 물건이라면 숨기지 않고 바로 사용했겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440311,
					"content": "알겠다! 아직 거래가 성사되지 않은 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440314,
					"content": "아드라피가 거래 장소에 붐붐을 데려가지 못했기 때문에 「충전 전환 용기」도 받을 수 없었던 거지…. 그럼 남은 질문은 하나네. 아드라피의 거래 상대는 누구였을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440315,
					"content": "하, 정말 멍청한 질문이었네. 부족 밖에서 녀석과 거래할 사람은 한 부류뿐인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440316,
					"content": "수메르의 학자들?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "우인단이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440320,
					"content": "이제 어쩌지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440321,
					"content": "어쩌긴, 우인단은 말이 안 통하는 놈들이니 거래 장소로 가서 「충전 전환 용기」를 뺏어와야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440322,
					"content": "좋아, 그러자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440323,
					"content": "하지만 고장난 상태인 붐붐은… 함께 다니거나 거래 장소에 데려갈 수 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440324,
					"content": "다른 곳에 둔다 해도 위험할 거고. 혼자 남겨두는 건… 한 번으로 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440325,
					"content": "#그럼 나랑 {NICKNAME}(이)가 우인단 쪽을 처리할 테니까, 넌 붐붐이랑 여기서 기다려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440326,
					"content": "그래!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "자, 그럼 우인단을 털러 가볼까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440330,
					"content": "#내가 직접 가고 싶지만… {NICKNAME}, 페이몬. 너희에게 붐붐의 생사가 달렸어. 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440331,
					"content": "참, 상대가 우인단 몇 명뿐이더라도 조심하는 거 잊지 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440332,
					"content": "걱정 말고 우리한테 맡겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440333,
					"content": "응, 붐붐을… 계속 배신자의 거처에 둘 수 없으니 우선 내가 데려갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440334,
					"content": "「충전 전환 용기」를 손에 넣으면 내 텐트로 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				},
				{
					"id": 732440328,
					"content": "우인단을 털자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "응, 어차피 한두 번도 아닌데 뭐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732440318,
					"content": "우인단이야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "내 생각이 틀림없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732440312,
					"content": "아직 못 받았다는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "아, 무슨 말인지 알겠어. 아직 거래가 성사되지 않은 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "제트"
				}
			]
		},
