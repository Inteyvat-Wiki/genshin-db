				},
				{
					"id": 732441521,
					"content": "왜 그래, 제트?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441522,
					"content": "붐붐이 깨어나긴 했지만 조금 더 회복이 필요할 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441523
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732441523,
					"content": "그렇구나. 붐붐, 푹 쉬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441524
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732441524,
					"content": "삐삐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "붐붐"
				}
			]
