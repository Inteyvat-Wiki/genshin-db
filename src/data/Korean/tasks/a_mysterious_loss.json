			"dialogs": [
				{
					"id": 411270301,
					"content": "밖에 가서 뭘 했나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "이봐, 그런 의심스러운 표정 좀 짓지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 411270303,
					"content": "난 그냥 기분 전환할 겸 돌아다녔을 뿐이라고! 운석이 떨어지고 나선 서둘러 돌아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 411270304,
					"content": "자, 다시 가서 찾아봐. <color=#00E1FFFF>정 못 찾겠다 싶으면 날 찾아와도 돼</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 411270305,
					"content": "난 떠올릴 만한 게 있는지 더 곰곰이 생각해볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				}
			]
		},
