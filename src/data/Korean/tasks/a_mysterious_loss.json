			"dialogs": [
				{
					"id": 411270201,
					"content": "왜? 또 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 411270202,
					"content": "단서가 없어서 찾기 힘들어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "아, 알았어. 잠깐만, 기억 좀 더듬어 볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 411270204,
					"content": "진짜 기억이 안 나. 특별한 건 없었던 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 411270205,
					"content": "그럼 제가 질문할게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "질문? 그래, 질문이 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				}
			]
		},
