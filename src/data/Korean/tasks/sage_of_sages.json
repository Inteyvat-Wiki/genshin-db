			"dialogs": [
				{
					"id": 130380301,
					"content": "오늘, 가장 지혜로운 자 헤르마누비스 님의 권력과 권능의 증거 앞에서 우리는 다시금 결투 의례를 치를 것이오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "두안르"
				},
				{
					"id": 130380302,
					"content": "신성한 의식인 만큼, 참관인은 소란 피우지 말고, 존경하는 마음으로 엄숙히 관람하시길 바라오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "두안르"
				},
				{
					"id": 130380303,
					"content": "우선 수비 측, 침묵의 신전 대표",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "두안르"
				},
				{
					"id": 130380304,
					"content": "오셨네요, 할아버지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "세토스"
				},
				{
					"id": 130380305,
					"content": "…콜록… 세토스, 세월이 얼마나 흘렀는데 이 의식을 치르려는 게냐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "바문"
				},
				{
					"id": 130380306,
					"content": "제가 뭘 하고 있는지 알아요, 할아버지. 안심하고 지켜봐 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "세토스"
				},
				{
					"id": 130380307,
					"content": "다음은 공격 측, 아카데미아 대표",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "두안르"
				},
				{
					"id": 130380308,
					"content": "난 준비됐어. 오늘 우린 실력으로 발언권을 쟁취할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380309,
					"content": "그럼 양측 선수들은 자리에 서서 출전 순서를 결정하시오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "두안르"
				},
				{
					"id": 130380310,
					"content": "어디에서 왔고 어디로 갈 것인지는 중요하지 않소. 오늘 이 결투는 헤르마누비스의 힘을 걸고 승부가 날 때까지 계속될 것이오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "두안르"
				},
				{
					"id": 130380311,
					"content": "내가 먼저 나갈게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "뭐? 정말?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130380313,
					"content": "응, 사기가 중요하니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "나도 동의해. 넌 엄청 강하니까 상대방의 기를 꺾어놓을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130380315,
					"content": "그럼 네가 두 번째로 나가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380316,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130380317,
					"content": "우린 결정했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380318,
					"content": "우리도 마찬가지야. 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "세토스"
				}
