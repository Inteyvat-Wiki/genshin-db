				]
			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "약속 시간이 되고, 일행은 다시 한 자리에 모였다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "진지하게 고민해 봤어. 선생님 성격에 홀로 사막에 온 건 다시 돌아갈 생각이 없으시단 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380103,
					"content": "호불호가 분명하고 원하는 대로 하는 분이니, 도망치라고 설득하긴 힘들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380104,
					"content": "나도 동의해. 나피스 스승님도 키루스 씨가 고집이 세다고 말씀하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130380105,
					"content": "그래, 그리고 다른 것도 생각해 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380106,
					"content": "침묵의 신전의 정보는 너희도 다 아니까 내가 더 보탤 건 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380107,
					"content": "난 이곳에 대한 기억이 희미해. 아마 「바{RUBY#[S]Ba}」의 영향이겠지. 어릴 땐 자주 머리가 아프고 열이 나곤 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380108,
					"content": "갑자기 어떤 격한 감정이 들기도 했고, 흐릿한 모습이 보이기도 했지. 하지만 다 단편적이고, 기억나는 건 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380109,
					"content": "그땐 어려서 머릿속에 어떤 강인한 의지가 있다고만 여겼어. 지금 생각해 보면 헤르마누비스도 모종의 방식으로 인간을 격려하고 있었나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380110,
					"content": "어쩌면 그들은 정신까지 닿는 그 힘을 신앙 삼은 거겠지. 헤르마누비스의 의지와 힘은 확실히 존재해. 그러니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380111,
					"content": "녀석의 요구를 받아들이려고? 다른 방법은 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130380112,
					"content": "충동적으로 굴지 마, 사이노",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "아니, 돌려주려는 게 아니야. 일곱 기둥의 힘에 대한 자격이 녀석들에게 있을지 몰라도, 수메르를 지키기 위해 난 이 힘이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380115,
					"content": "——난 정정당당하게 승부해서, 이 힘을 다시 쟁취할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380116,
					"content": "참, 오기 전에 알하이탐이 말해줬어. 과거 침묵의 신전은 오래된 귀족 같은 조직이었대. 그리고 귀족이란 무릇 자기들만의 예절에 매여있기 마련이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130380117,
					"content": "카베도 사막에서 일하다가 들었는데, 사막 부족은 대부분 자기들만의 규칙이 있고, 혈통과 부족의 규칙을 절대 어기지 못 한대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130380118,
					"content": "그러니까 우리도 나름의 제안을 해보는 게 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130380119,
					"content": "와… 그렇게도 할 수 있구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130380120,
					"content": "나도 같은 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380121,
					"content": "우리가 먼저 거절할 수 없는 조건을 제시하면 상대를 설득할 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 130380122,
					"content": "좋은 생각인 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "그래, 내가 의학을 좀 아니까 할아버지의 상황을 봐주겠다는 식으로 세토스한테 접근하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130380113,
					"content": "다른 방법이 있을 거야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
