			"dialogs": [
				{
					"id": 230390401,
					"content": "후… 후… 내가 이겼다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390402,
						230390403
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390402,
					"content": "축… 축하해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390404
					]
				},
				{
					"id": 230390404,
					"content": "#헤헤, 잘 뛴다고 했잖아요. {M#형아}{F#누나}, 혹시 제가 어리다고 무시한 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390405
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390405,
					"content": "그런데 이렇게 빨리 달려도 하바치 형은 항상 저희를 따라잡아요. 대체 왜 그런 걸까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390406,
						230390407
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390406,
					"content": "지름길로 달린 게 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390408,
					"content": "그런가? 음… 그런데 이 주위에 지름길 같은 건 없는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390409
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390409,
					"content": "#아니면, 다음에는 {M#형아}{F#누나}랑 무슨 놀이를…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390410
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390410,
					"content": "무슨 훈련을 할까? 아… 「야외 흔적 숨기기」 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390411
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390411,
					"content": "맞아, 하바치 형처럼 빨리 달릴 수 없다면, 하바치 형을 피하면 되잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390412
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390412,
					"content": "전에도 해봤잖아? 우리가 아무리 노력해도 하바치 형한테 들킬 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390407,
					"content": "다른 노하우가 있는 게 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390403,
					"content": "진… 진짜 빠르다…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390404
					]
				}
			]
		},
