					"힐미"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "#{M#형아}{F#누나}, 잠깐만요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390102,
					"content": "혹시… 모험가예요? 다양한 곳들을 모험하고, 엄청 잘 싸우는 그런 모험가요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390103,
					"content": "그런 셈이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#그것 봐, 힐미! 이 {M#형아}{F#누나}가 분명 모험가일 거라고 내가 그랬지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390106,
					"content": "하지만 모험가들은 다들 그런 푸른색 옷을 입지 않나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390107,
					"content": "난 대단한 사람이라 그런 거 안 입어도 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "우와——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390110,
					"content": "우와——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390111,
					"content": "#그럼 {M#형아}{F#누나}! 분명 저희를 도와주실 수 있겠네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390112,
					"content": "마을에 있는 큰 창고 보셨죠? 하바치 형 말로는 창고 안에 아주 중요한 물건이 있어서 잘 지켜야 한대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390113,
					"content": "나쁜 사람들이 마을을 공격하면 바로 승강기를 멈추고 잔교를 차단해야 한다고 그랬어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390114,
					"content": "그런데 창고에서 승강기까지 꽤 멀어요. 하바치 형이 승강기를 멈추려면 힘들게 거기까지 뛰어가야 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390115,
					"content": "저희가 훈련하는 걸 도와주겠다고 했지만 하바치 형은 항상 저희를 무시해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390116,
					"content": "우리가 물수제비를 날리려 할 때는 그렇게 민감하게 굴면서, 칫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390117,
					"content": "큼, 어쨌든! 만약 나쁜 사람이 마을을 공격했을 때 하바치 형이 뛸 수 없는 상태라면 저희가 승강기를 멈출 수밖에 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390118,
					"content": "#{M#형아}{F#누나}는 모험가니까 분명 달리기도 잘하겠죠? 우리와 함께 훈련해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390119,
					"content": "그럼 같이 뛰어줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "#아싸! 고마워요, {M#형아}{F#누나}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390126,
					"content": "#시작점은 이미 정했어요. {M#형아}{F#누나}, 우리 거기로 가요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390127,
					"content": "헤헤, 이번에는 저랑 대결하는 거예요. 미리 말씀드리지만 전 굉장히 잘 뛴다고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "힐미"
				},
				{
					"id": 230390121,
					"content": "하바치를 믿는 게 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "에이… 그냥 저희랑 좀 놀아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390123,
					"content": "#아니, 저희랑 같이 훈련 좀 해주세요! {M#형}{F#누나}, 부탁드려요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390124,
					"content": "그래…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "#아싸! 고마워요, {M#형아}{F#누나}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "에비드"
				},
				{
					"id": 230390108,
					"content": "난 특별한 사람이라 그런 거 안 입어도 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "뭐 틀린 말은 아니지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
		},
