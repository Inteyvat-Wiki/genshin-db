					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "그럼 됐어. 대나무를 구해올 테니 완성되면 바로 월해정으로 보내마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "노 어르신"
				},
				{
					"id": 718130704,
					"content": "이 정도 주문이면 꽤 벌 수 있겠군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "노 어르신"
