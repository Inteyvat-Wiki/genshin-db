					"청주"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "어렵군. 너무 어려워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130302,
					"content": "《주옥 광물》에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "《주옥 광물》? 아아, 기억납니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130304,
					"content": "전에 상인과 관련된 시를 쓰기 위해 소재를 찾다가 우연히 그 책을 읽었거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130305,
					"content": "내용이 좀 난해하긴 했지만, 제 시에 영감을 준 사례들도 있었답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130306,
					"content": "무슨 시였더라? 잠시만 기다려주시죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130307,
					"content": "어디에 가면 그 책을 찾을 수 있을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "그 책을 찾으시게요? 어디에 있는지는 기억 안 납니다만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130309,
					"content": "급하면 제가 한 부 적어드릴 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130310,
					"content": "손수 써주신다구요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "휴, 그렇게 길진 않아서 외우는 거야 쉽죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130313,
					"content": "게다가 그 책을 읽고 있을 때 책 주인이 밖으로 못 갖고 나가게 하더군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130314,
					"content": "근데 시가 어디 하루 저녁에 써지나요…. 그래서 그 책을 한 부 베껴왔어요. 내용이 많지도 않아서 거의 외웠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130315,
					"content": "역시 시인이군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "에이, 그리 대단한 거 아닙니다. 그나저나… 제가 책을 적어드리기로 했으니, 저도 부탁 하나 해도 될까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130317,
					"content": "부끄러운 이야기지만, 여기서 소재를 찾느라 밥을 못 먹어서 배가 고프군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130318,
					"content": "「고기죽순데침」 1인분만 갖다주시겠어요? 전 여기서 《주옥 광물》을 쓰고 있을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718130319,
					"content": "돌아오실 때쯤 완성돼 있을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "청주"
				},
				{
					"id": 718130311,
					"content": "전부 외운 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
