			"dialogs": [
				{
					"id": 718130601,
					"content": "음? 무슨 일 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "노 어르신"
				},
				{
					"id": 718130602,
					"content": "대나무 장식품을 주문하고 싶어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "대나무 장식품? 만들 수는 있다만, 누구한테 받은 주문서인가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "노 어르신"
				},
				{
					"id": 718130604,
					"content": "백문 씨한테요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "호오… 월해정 주문서구먼. 좋아, 최대한 빨리하마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "노 어르신"
				},
				{
					"id": 718130606,
					"content": "근데 최근 내가 재료 구하러 가는 대나무숲에 갑자기 숲멧돼지가 많아졌더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "노 어르신"
				},
				{
					"id": 718130607,
					"content": "큰 문제는 없다만, 대나무를 구하려면 그것들을 피해 다녀야 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "노 어르신"
				},
				{
					"id": 718130608,
					"content": "그 멧돼지들을 쫓아내 주면 지금 바로 대나무를 구해다 시작할 수 있는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "노 어르신"
				},
				{
					"id": 718130609,
					"content": "제게 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "그럼 여기서 기다리고 있을 테니 멧돼지를 쫓아내고 나면 와서 얘기해주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "노 어르신"
				}
			]
		},
