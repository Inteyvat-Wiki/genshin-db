				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "방금 그 심연 메이지들… 매복하려던 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010202,
					"content": "아니, 그들은 유적 가디언의 잔해에서 뭔가를 찾고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010203,
					"content": "그랬구나…. 여행자도 자주 그러는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010204,
					"content": "「혼돈의 장치」나, 「혼돈의 회로」 같은 거 찾잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010205,
					"content": "맞아, 그것들은 전부 중요한 재료야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "그런 평범한 물건일 리 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010208,
					"content": "그 유적에는 시도 때도 없이 심연 메이지가 탐색을 나와. 그래서 나도 그 근처를 조사했던 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010209,
					"content": "그들은 유적 가디언의 잔해에서 「특유의 진귀한 물질」을 찾아가려는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010210,
					"content": "근데 실망한 모습을 보니 아직 못 찾은 모양이군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010211,
					"content": "근데 왜 놈들을 잡아서 심문하지 않는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010212,
					"content": "다이루크 어르신은 잡아서 심문했던 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "나도 놈들에게 자비를 베풀 마음은 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010215,
					"content": "다만 이 일이 심연 교단 전체와 관련 있는 중요한 일이라는 게 느껴져서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010216,
					"content": "그런 진상이 놈들을 고문한다고 해서 밝혀지진 않을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010217,
					"content": "어쩌면 저 심연 메이지들은 고문보다 더 무시무시한 것들을 상대하고 있는 걸지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010218,
					"content": "무시무시한 것들…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "으… 으… 이 오싹함 어쩔 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010221,
					"content": "자, 여기서 지체할 순 없어. 계속 추적하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010219,
					"content": "유적에 있던 것들과 관련 있을까요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "저놈들은 좀 심하게 다뤄도 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "심연 메이지가 설마 그걸 찾는 거겠어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
