				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"데인슬레이프"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "후… 여기는 심연 교단 말고 유적 가디언들도 날뛰네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010302,
					"content": "심연 메이지가 숨어있는 곳은 항상 유적 가디언도 돌아다니는 것 같은데, 이게 우연일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010303,
					"content": "세상에 우연은 없어. 모든 게 다 과거에 묻어둔 씨앗 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010304,
					"content": "그 술집에 네가 나타났던 것처럼… 시간은 그 씨앗이 싹 트길 기다릴 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010305,
					"content": "하지만 전 당신에 대해 우연히 들었을 뿐인걸요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "아냐, 내가 괜한 감상에 빠졌군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010308,
					"content": "아무튼 심연 교단과 유적 가디언의 관계는 우연이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010309,
					"content": "같은 줄기에서 갈라진 가지라고 봐야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010310,
					"content": "줄기? 가지? 그 뜻은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010311,
					"content": "그건 500년 전에 멸망한—— 「켄리아」에서 시작됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010312,
					"content": "엥? 켄리아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010313,
					"content": "그러니까… 심연 교단과 유적 가디언이 켄리아가 멸망한 후에 남은 것들이라고?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010314,
					"content": "그나저나 켄리아라니, 참 아득한 이름이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010315,
					"content": "아, 맞다. 가이드로서 설명해줄게. 「켄리아」라는 나라는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010316,
					"content": "나 「켄리아」라는 이름 알아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "엥…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010318,
					"content": "켄리아에서의 기억이 있거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "기억이 있다구? 거긴 500년 전에 멸망한 나라인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010320,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010321,
					"content": "그래? 사람은 다 비밀이 있는 법이지. 너도 내게 시간에 관한 걸 안 물었으니 나도 묻지 않을게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010322,
					"content": "하지만 말하고 싶다면 들어줄 순 있어. 그럼—— 네가 본 켄리아는 어떤 모습이었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010323,
					"content": "(더는 숨길 수 없겠어…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "그 일의 순서가 그랬던 거구나…. 난 또 네가 처음부터 낯선 신과 마주친 줄 알았네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010327,
					"content": "#음, 이 세계에 도착한 뒤 운석에 있는 널 네 {M#동생이}{F#오빠가} 처음으로 깨웠다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010328,
					"content": "#네 {M#동생이}{F#오빠가} 너보다 먼저 깨어난 것 같은데, 얼마나 일찍 깼는지 모르는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010329,
					"content": "#그 후 네 {M#동생은}{F#오빠는} 켄리아의 멸망으로 세상이 변했다며, 함께 티바트라는 세계를 떠나자고 한 거군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010330,
					"content": "#「켄리아의 멸망」? {M#동생이}{F#오빠가} 그렇게 말했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010331,
					"content": "맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "그 재난을 겪었다니, 그건… 500년 전의 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010334,
					"content": "네가 이 세계에서 처음 깨어난 것도 그 시기인 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010335,
					"content": "#음… 그렇다면 네 {M#동생은}{F#오빠는} 먼저 깨어났으니까 너보다 이 세계에 대해 더 잘 알겠네~?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010336,
					"content": "그 후, 너흰 곧바로 길을 막는 낯선 신령을 만나게 된 거고 도망치지 못한 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010337,
					"content": "음, 그 이야기라면 너무 많이 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010338,
					"content": "…알겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010339,
					"content": "그때 넌 막 깨어나서 황급히 이 세계를 떠나려고 했어. 「켄리아」라는 지명의 배경은 전혀 모르는 채 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010340,
					"content": "하지만 이제 어느 정도 티바트에 대해 알게 됐고, 그제야 그때 겪었던 전쟁이 「켄리아 멸망의 전투」라는 걸 알게 된 거지, 맞나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010341,
					"content": "아! 그러고 보니, 우리가 함께 여행한 이 몇 개월 동안 넌 고대 서적을 조사했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010342,
					"content": "몬드에 가기 전엔 애매한 자료뿐이었지만, 몬드와 리월에서는 고대 서적들을 수집했고, 그때마다 넌 「별로 쓸모가 없다」고 했었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010343,
					"content": "#사실 켄리아에 관해 알고 싶어서 그랬던 거구나. {M#동생을}{F#오빠를} 찾기 위해서이기도 하고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010344,
					"content": "그건 「일곱 신」에 대한 단서 다음으로 중요해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "응, 맞아. 일곱 신을 찾으려면 일곱 국가를 돌아봐야겠지. 하지만 500년 전에 멸망한 켄리아는 이제 찾을 수가 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010347,
					"content": "켄리아에 관한 일이라면 내가 너희보다 많이 알 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010348,
					"content": "켄리아는 신이 없는 국가야—— 신이 죽거나 떠난 게 아니라 애초부터 켄리아 역사엔 신이 존재하지 않았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010349,
					"content": "켄리아는 순전히 인류가 세운 강대국이었어. 인류는 켄리아의 엄청난 번영과 눈부신 문명을 자랑스러워했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010350,
					"content": "신이… 존재하지 않는 국가라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010351,
					"content": "그 후의 일은 네 기억과 같아——모든 게 신에 의해 파괴되었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010352,
					"content": "그 뜻은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010353,
					"content": "500년 전, 신들이 함께 강림해 켄리아를 멸망시켰어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010354,
					"content": "「인류의 자랑」은 마치 잡초처럼 신의 화원에서 제거됐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010355,
					"content": "어떻게 그럴 수가… 역사책에 그런 건 전혀 안 나오는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010356,
					"content": "너무하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "응, 여기서 계속 옛날이야기를 한다 해도 사기만 꺾일 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010359,
					"content": "(하지만, 다음에 벤티와 종려 씨를 만나면…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "일단 움직이자. 네가 알고 싶어 하는 그 일들은 가면서 계속 얘기해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010360,
					"content": "(그들의 설명도 들어봐야겠어)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#위험한 세계네요… 하루빨리 {F#오빠를}{M#동생을} 찾아야겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "「지명」에 대한 단서뿐이지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "그때 그렇게 말했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "(데인 씨와 켄리아… 밑지는 셈 치고 말해보자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "(날 깨웠던 사람…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "(그리고 깨어나서 봤던 그 불바다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "무슨 말인지… 잘 모르겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
