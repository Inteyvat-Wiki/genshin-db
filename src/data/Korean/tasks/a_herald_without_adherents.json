				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "다시 만났군…. 내 예상보다 훨씬 빠르지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010102,
					"content": "아, 데인이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010103,
					"content": "보아하니 뭔가 이상한 일을 겪은 듯한 표정이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010104,
					"content": "저 유적에서 「심연 사도」와 마주치기라도 했나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010105,
					"content": "엇, 그걸 어떻게 알아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010106,
					"content": "난 아직도 「심연 사도」를 쫓고 있거든, 여기서 너희를 만날 줄은 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010107,
					"content": "사실 사도만 마주친 게 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "거꾸로 매달린 신상이라… 손에선 심연 에너지가 나오고? 아니, 심연과 맞설 때 그런 건 못 봤어. 하지만… 뭔지 짐작은 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010110,
					"content": "너희들이 겪은 일들을 이야기해줘. 심연 에너지로 가득한 유적에서 도망친 후엔 어떻게 된 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010111,
					"content": "유적 출구까지 도망쳤는데 갑자기 「심연 사도」가 나타나서 우릴 가로막았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010112,
					"content": "그래서 그놈과 한바탕 겨뤘지. 아마 멀리는 못 갔을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010113,
					"content": "음, 좋은 기회로군, 그럼 쫓아가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80010114,
					"content": "네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "가자! 좋은 기회야. 데인도 도와준다잖아. 여러 수수께끼를 풀 수 있을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80010115,
					"content": "아니요, 고용주는 제 쪽이었던 것 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "유적 깊은 곳엔 더 엄청난 것이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
