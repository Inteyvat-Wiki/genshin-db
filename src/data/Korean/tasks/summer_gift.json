			},
			"dialogs": [
				{
					"id": 790080101,
					"content": "바로 이거겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "조사"
				},
				{
					"id": 790080102,
					"content": "엥? 옆에 편지가 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "조사"
				},
				{
					"id": 790080103,
					"content": "이곳에 온 친구에게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "조사"
				},
				{
					"id": 790080104,
					"content": "안녕, 멀리서 온 친구. 이 편지를 읽고 있는 넌 내가 남겨놓은 하르파스툼을 찾았겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "조사"
				},
				{
					"id": 790080105,
					"content": "금사과 제도에는 하르파스툼과 관련된 게임이 많아. 나와 내 친구들은 이곳에서 아주 즐거운 여름을 보냈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "조사"
				},
				{
					"id": 790080106,
					"content": "그래서 여기에 내가 만든 하르파스툼을 남겨뒀어. 우연히 이걸 발견한 너도 나처럼 즐거운 시간을 보냈으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "조사"
				},
				{
					"id": 790080107,
					"content": "태양과 바닷바람, 여름을 마음껏 즐기길",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "조사"
				},
				{
					"id": 790080108,
					"content": "——바바라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "조사"
				},
				{
					"id": 790080109,
					"content": "역시 바바라야. 바바라 덕분에 우리도 하르파스툼이 생겼어! 가자, 가서 신나게 놀자구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "조사"
				}
			]
		},
