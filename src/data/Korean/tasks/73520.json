						"stepId": 7352002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카슈메르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "「20년 전의 일」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "…역시 그런 말을 하는 게 아니었는데. 전에 술김에 쓸데없는 말을 좀 했더니, 요즘 계속 사람들이 그 이야기를 물어보네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200205,
					"content": "일단 궁금해하시니 말씀드리도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200206,
					"content": "20년 전에 저는 여섯 살 먹은 꼬마였어요. 그때 무슨 일이 있었는지는 전혀 기억나지 않아요. 얼마 전 어렸을 때 썼던 일기를 읽고 나서야 당시의 상황이 어렴풋이 떠올랐을 뿐이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200207,
					"content": "그 해에도 학부 대항전이 열렸었어요. 대항전은 세 라운드에 걸쳐서 진행됐는데, 마지막 라운드는 성 밖에서 열렸죠. 어머니께 구경을 가자고 졸랐지만, 안 된다고 하셔서 저 혼자 몰래 빠져나갔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200208,
					"content": "그런데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735200209,
					"content": "그런데 성 밖에서 길을 잃고 만 거예요. 아무도 없는 곳에 홀로 남은 저는 무서워서 울음을 터뜨렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200210,
					"content": "그때 이상한 생물이 제 눈에 들어왔어요…. 그게 어떻게 생겼는지는 기억나지 않아요. 기억나는 건 단지 어린아이였던 제가 그걸 보고 울음을 그쳤다는 것뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200211,
					"content": "그 이상한 생물이라는 건 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735200212,
					"content": "(아마 아란나라겠지)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "그들은 저를 대항전이 열리는 곳으로 데려다줬어요. 아쉽게도 제가 도착했을 땐 이미 한참 전에 행사가 끝난 상태였지만요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200214,
					"content": "그런데 실망하고 있던 와중에 갑자기 이상한 생물이 왕관을 천천히 끌고 가는 모습이 보였어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200215,
					"content": "정말 예쁜 왕관이었어요. 달빛 아래 아름답게 반짝이는 왕관을 본 저는 홀린 듯이 그 뒤를 따라갔죠. 그 조그만 생물은 왕관을 어떤 나무 구멍 속에 숨기더니, 그대로 사라져 버렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200216,
					"content": "저는 가까이 가서 왕관을 만져보려고 했지만, 그때 저 멀리서 어머니의 목소리가 들렸어요. 제가 몰래 나갔다는 사실을 알고는 이웃들과 함께 절 찾으러 나오신 거였죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200217,
					"content": "그래서 결국 그 왕관을 만져보지는 못했는데, 어른이 된 후 학부 대항전에서 「통찰의 왕관」을 보니 그게 그때의 왕관과 같은 물건 같더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "카슈메르"
				},
				{
					"id": 735200218,
					"content": "그렇구나…. 혹시 그 왕관을 어디에 뒀었는지는 기억나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
