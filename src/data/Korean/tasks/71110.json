			"dialogs": [
				{
					"id": 711100801,
					"content": "음… 이 사진들…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "방거"
				},
				{
					"id": 711100802,
					"content": "왜? 사진이 별로야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711100803,
					"content": "오히려 반대예요…. 며칠 동안 훌륭한 작품들을 충분히 봤다고 생각했는데, 두 분의 작품에서는 새로운 아름다움이 느껴지네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "방거"
				},
				{
					"id": 711100805,
					"content": "예를 들어 이 교영 마을 사진에서는 사다새가 조용한 마을에 활기를 더해주고 있어요. 생동감과 고요함 사이의 대비…. 정말 독창적이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "방거"
				},
				{
					"id": 711100806,
					"content": "제 안목대로라면, 분명 두 분 다 입선하실 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "방거"
				},
				{
					"id": 711100807,
					"content": "와! 그렇게 좋게 평가해 주다니, 조금 쑥스러운걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711100808,
					"content": "네가 찍은 것도 아닌데 뭐가 쑥스러워?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "네가 겸손한 걸 아니까, 내가 대신 쑥스러워해 준 거라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711100811,
					"content": "본론으로 돌아와서, 작품 선정은 내일 아침이 오기 전에 끝날 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "방거"
				},
				{
					"id": 711100812,
					"content": "선정된 작품은 내일 아침 8시부터 오후 6시까지 합철역 밖 거리에 공개 전시된답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "방거"
				},
				{
					"id": 711100813,
					"content": "이번 「침옥곡 여행」 풍경 사진 대회에 참가해 주셔서 정말 감사드려요. 내일 다시 오는 거 잊지 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "방거"
				},
				{
					"id": 711100814,
					"content": "응! 마지막 깜짝 선물을 놓칠 수 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711100810,
					"content": "그렇게 말하니까 나도 쑥스러워졌어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
