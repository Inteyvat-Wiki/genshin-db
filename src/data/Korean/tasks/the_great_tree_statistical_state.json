				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "우리에겐 더 많은 데이터가 필요해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300102,
					"content": "데이터 없이 어떻게 장치를 정상적으로 작동할 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300103,
					"content": "모든 데이터를 완벽하게 수집한 뒤에 움직이려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300104,
					"content": "넌 물고기를 잡을 때 파도를 일일이 다 확인해? 눈앞에 있는 물고기만 주시하고 있으면 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300105,
					"content": "이게 바로 네가 영원히 물고기를 잡을 수 없는 이유야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300106,
					"content": "넌 하라바타트에서 공부한 적도 없잖아! 말꼬리 잡지 말고 일이나 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300107,
					"content": "시간을 더 끌면 야스민과 우리의 논문에 시효성이 떨어진다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300108,
					"content": "왜 싸우는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "넌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300110,
					"content": "넌 분명 야스민이 말했던 여행자겠지. 우리에게 많은 도움을 줬다고 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300111,
					"content": "만나서 정말 반가워, 여행자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300112,
					"content": "난 페레즈야. 크샤흐레와르 학부에서 공부 중이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300113,
					"content": "난 라데프, 스판타마드 학부 학생이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300114,
					"content": "여행자, 우리도 좀 도와줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300115,
					"content": "야스민이 요즘 「신성한 나무」 뿌리 주위에 약물을 뿌리고 있다는 건 알고 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300116,
					"content": "그런데… 음… 야스민이 뿌린 약물에 문제가 있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300117,
					"content": "약물을 뿌린 곳 주변에 이상한 마물들이 나타나고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300118,
					"content": "맹세해. 난 절대 제조법이나 투약 비율을 바꾸지 않았어. 분명… 음, 예기치 못한 상황이 발생한 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300119,
					"content": "그렇다 치고… 여행자, 나랑 같이 야스민이 약물을 뿌린 곳으로 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300120,
					"content": "그쪽에 마물들이 잔뜩 모여있을지도 몰라서 우리끼리 갈 엄두가 안 나… 무력이 강한 사람이 동행해줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300121,
					"content": "버섯몬이 위험한 건 둘째로 치더라도 만약 지도 교수님께서 우리 약물에 문제가 생긴 걸 아시게 되면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300122,
					"content": "논문 연구 계획서를 다시 쓰라고 하시겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300123,
					"content": "특히 우리 스판타마드 학부는 워낙 엄격하거든. 제출한 데이터에 오류라도 있으면 지도 교수님께서 분명 심하게 혼내실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300124,
					"content": "저한테 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "전에 이런 문제가 생기면 어떻게 해결했어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "모험가를 고용하거나 바로 지도 교수님께 보고드렸지. 지도 교수님께서는 믿음직한 도금 여단 멤버에게 일을 맡기시거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300127,
					"content": "하지만 지도 교수님의 인내심에도 한계가 있는 법이지. 지금 상황에서 다시 부탁드릴 순 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300128,
					"content": "그럼 부탁할게, 여행자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라데프"
				}
			]
		},
		{
