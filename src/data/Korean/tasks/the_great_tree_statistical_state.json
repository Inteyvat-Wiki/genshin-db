					"페레즈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300201,
					"content": "아! 저 상자 좀 봐. 저 안에 약물이 담겨있는 거겠지. 야스민이 이미 여길 왔던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300202,
					"content": "응? 약물의 뚜껑도 안 열었네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300203,
					"content": "뚜껑 따지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300204,
					"content": "으앗! 뒤에 버섯몬이 나타났어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230300205,
					"content": "뭐? 아까는 없었잖아! 이게 도대체 무슨 일이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300206,
					"content": "#{NICKNAME}, 쟤들은 무시하고 우리끼리 어서 공격하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303004",
							"2"
						],
						"stepId": 2303004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"라데프",
					"페레즈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "상자 안에 있는 약물이 깨지지 않아서 다행이다. 깨졌다면 우리 전부 그 자리에서 토했을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300402,
					"content": "아직도 이 냄새에 익숙해지지 않은 거야? 다 네가 만든 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300403,
					"content": "내가 몇 번이나 말했잖아. 여기에 구토제를 첨가했다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300404,
					"content": "익숙해지는 거랑은 상관없어. 냄새를 맡는 순간 신체에서 바로 구토 반응이 일어나는 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300405,
					"content": "내가 왜 다시 설명해 주고 있는 거지? 어차피 절대 못 알아들을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300406,
					"content": "그런데 야스민은 도대체 어디 간 거야? 약물도 안 뿌리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300407,
					"content": "분명 또 희귀한 식물을 발견하고 표본을 채취하러 간 거겠지. 넌 아직도 아무르타 애들이 어떤지 몰라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "페레즈"
				},
				{
					"id": 230300408,
					"content": "그렇군, 이 약물은 일단 우리가 지키고 있을게. 도와줘서 고마워, 여행자. 이걸 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "라데프"
				},
				{
					"id": 230300409,
					"content": "아무르타는… 정말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페레즈"
				}
			]
		},
