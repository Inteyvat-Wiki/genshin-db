			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"앨리스의 쪽지를 확인한다…"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761590501,
					"content": "「과제 지도하느라 고생했어. 얼른 집에 가서 따뜻한 차 한 잔 마셔!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590502
					],
					"speakerTitle": "앨리스의 쪽지를 확인한다…"
				},
				{
					"id": 761590502,
					"content": "「추신: 문 안쪽에 깜짝 선물이 기다리고 있어!」",
					"roleType": "TALK_ROLE_NPC",
