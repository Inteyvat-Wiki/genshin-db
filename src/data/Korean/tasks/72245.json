			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "움직이지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "리스타이오스"
				},
				{
					"id": 722450402,
					"content": "아, 움직이지 마, 움직이지 말라니까! 어휴, 움직이지 말라고 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "리스타이오스"
				},
				{
					"id": 722450403,
					"content": "엥, 근데 갑자기 움직이지 말라고 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
