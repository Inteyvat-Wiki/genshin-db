				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "멀리서 온 여행자여. 쿨럭, 피곤해 보이는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "스레피오"
				},
				{
					"id": 722450302,
					"content": "피로는 안 좋은 징조야. 많은 질병들은 피로로부터 야기되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "스레피오"
				},
				{
					"id": 722450303,
					"content": "매일 충분한 숙면을, 취해야, 쿨럭, 쿨럭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "스레피오"
				},
				{
					"id": 722450304,
					"content": "쿨럭쿨럭, 쿨럭… 건강하게 자랄 수 있단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "스레피오"
				},
				{
					"id": 722450305,
					"content": "네 건강부터 걱정해야 될 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722450306,
					"content": "하하, 이건 고질병이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "스레피오"
				},
				{
					"id": 722450307,
					"content": "여행자, 건강한 신체를 가져야 건강하고 온전한 영혼이 깃들 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "스레피오"
				},
				{
					"id": 722450308,
					"content": "휴, 시간이 조금만 더 있었으면 좋았을 텐데. 그럼 난 분명 세상에서 가장 좋은 의사가 될 수 있었을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "스레피오"
				},
				{
					"id": 722450309,
					"content": "그럼 이런 몸이어도 건강하게 밖으로 나가 즐겁게 놀 수 있었을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "스레피오"
				}
			]
		},
