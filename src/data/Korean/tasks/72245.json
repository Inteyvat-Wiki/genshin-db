			"trigger": {
				"objectNames": [
					"리코루",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "응? 방해하지 마, 나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450102,
					"content": "엄청 중요한 일을 생각하는 중이니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450103,
					"content": "중요한 일? 그게 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722450104,
					"content": "다이니치 미코시 본 적 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450105,
					"content": "백야국에서 가장 높은 건물 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450106,
					"content": "난 어떻게 하면 다이니치 미코시보다 더 높은 건물을 지을 수 있을지 고민 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450107,
					"content": "으음, 근데 다이니치 미코시가 그렇게 높은 건 백야국을 밝게 비춰주기 위해서잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722450108,
					"content": "넌 왜 그렇게 높은 건물을 짓고 싶은 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722450109,
					"content": "그건 물론 이 리코루 님의 명성을 위해서지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450110,
					"content": "그래야 내가 아베라쿠 그 아저씨보다 더 대단한 사람이라는 걸 증명할 수 있으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450111,
					"content": "아는 사이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "물론이지. 다이니치 미코시를 건축해 백야국을 위험에서 벗어나게 한 사람이잖아… 예전에 난 그 사람을 존경해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450114,
					"content": "근데 그 아저씨가 왕위를 노리고 있을 줄은 몰랐어. 어른들이 아니었다면 난 목숨을 잃었을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450115,
					"content": "흥, 난 꼭 다이니치 미코시보다 더 높은 건물을 지을 거라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450116,
					"content": "엄, 엄청 오래 걸릴 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722450117,
					"content": "상관없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450118,
					"content": "내 명을 받들어 역사에 길이 남을 건축물을 짓는 건 백야국의 백성들에게 감지덕지한 일이니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450119,
					"content": "됐어, 이제 나 방해하지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450120,
					"content": "어디 보자, 들보의 높이는… 그렇다면 하중과 지붕 받침은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리코루"
				},
				{
					"id": 722450112,
					"content": "아베라쿠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
			],
