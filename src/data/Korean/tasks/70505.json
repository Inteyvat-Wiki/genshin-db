			"dialogs": [
				{
					"id": 705050201,
					"content": "맛이 아주 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050202
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050202,
					"content": "원재료가 좋아서 그래! 과일이 신선하면 다른 걸 안 넣어도 달잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050203,
					"content": "몬드의 대지에 감사해야겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050204
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050204,
					"content": "…잿빛 골짜기의 석양은 내가 처음 제조한 음료야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050205
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050205,
					"content": "어릴 때였는데, 아버지께서 재료를 주시더니 직접 만들어 보라고 하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050206
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050206,
					"content": "별다른 요구나 힌트도 없었어. 내 재능을 확인하고 싶으셨던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050207
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050207,
					"content": "결국, 내가 만들어 낸 게 이 주스였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050208
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050208,
					"content": "엥? 어, 어째서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050209,
					"content": "아버지도 무척 놀라셨어. 그때 난 다른 건 생각 안 하고, 주스가 달콤하다고만 생각했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050210
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050210,
					"content": "지금 보면 그 생각이 얼마나 유치하고 단순했는지 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050211
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050211,
					"content": "전 그렇게 생각하지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050212
					]
				},
				{
					"id": 705050212,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050213,
						705050214
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050213,
					"content": "아버지도 훌륭한 음료라고 생각하셨을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				},
				{
					"id": 705050215,
					"content": "그런 생각은 해 본 적 없어…. 아버지도 별말씀 없으셨으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050216
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050216,
					"content": "아무튼, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050217
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050217,
					"content": "참, 너한테 줄 게 있는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050218
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050218,
					"content": "…바텐더 경험이 좀 더 쌓였을 때 주는 게 좋겠군. 네 능력이라면 이 일을 훌륭하게 마무리할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050219
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050219,
					"content": "나도… 응원 열심히 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050220,
					"content": "응, 너희의 활약을 기대하지. 그럼 먼저 가 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050221
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050221,
					"content": "한가할 때 또 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050214,
					"content": "맛있다고 생각하셨을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050215
					]
				}
			]
		}
