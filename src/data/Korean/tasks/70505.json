			"dialogs": [
				{
					"id": 705050101,
					"content": "다이루크 어르신! 웬일이야? 오늘은 한가해서 할 일이 없는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050102,
					"content": "할 일이 없다니, 너희가 바텐더 일을 한다는 정보를 받고 보러 온 거뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050103
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050103,
					"content": "와, 정보 한번 빠르네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050104,
					"content": "#{NICKNAME}, 그래서 바텐더가 된 기분은 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050105
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050105,
					"content": "이제 막 시작해서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050106
					]
				},
				{
					"id": 705050106,
					"content": "맞아, 아직 그걸 물어볼 단계는 아니지. 시작한 지 얼마 안 됐다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050107,
					"content": "첫인상이 궁금한 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050108
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050108,
					"content": "신나? 아니면 귀찮은가? 어떤 느낌인지 솔직하게 말하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050109,
						705050110
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050109,
					"content": "신기한 경험이에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				},
				{
					"id": 705050111,
					"content": "그렇군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050112
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050112,
					"content": "나, 나한텐 안 물어봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050113,
					"content": "내 첫인상은… 맛있다였어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705050114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050115
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050115,
					"content": "다행이네. 축하해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050116
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050116,
					"content": "잿빛 골짜기의 석양 한 잔 부탁해도 될까? 사이즈는 아무거나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705050117
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050117,
					"content": "네, 잠시만 기다려주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050118
					]
				},
				{
					"id": 705050118,
					"content": "응, 서두를 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "다이루크"
				},
				{
					"id": 705050110,
					"content": "좀 정신없어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705050111
					]
				}
			]
		},
