			"dialogs": [
				{
					"id": 4650101,
					"content": "호프만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650102,
					"content": "아, 너희구나. 협조해줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650103,
					"content": "저번에 「다크 히어로」에 관한 얘기를 했는데… 혹시 또 제공해줄 만한 정보 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650104,
					"content": "우선 무슨 일이 일어났는지 물어봐도 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "그렇네. 질문하기 전에 먼저 필요한 정보를 제공했어야 하는데, 내가 기사로서의 예절을 소홀히 했군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650108,
					"content": "사실은… 이걸 먼저 봐줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650109,
					"content": "우와, 글씨가 엉망이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650110,
					"content": "음, 자세히 보니까… 알아볼 수 없는 내용투성이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650111,
					"content": "맞아, 「통용어」이긴 하지만, 「암호문」으로 쓰여 있는 부분도 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650112,
					"content": "알아볼 수 있는 부분만 봐도 대충 내용을 이해할 수 있긴 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650119,
					"content": "이건, 심연 교단이 「다크 히어로」한테 보내는 도전장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650113,
					"content": "그럼 「다크 히어로」가 나쁜 놈들의 표적이 되어버린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650114,
					"content": "응. 그래서 가능한 한 빨리 그와 함께 대책을 의논하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650115,
					"content": "이건 「다크 히어로」 혼자만의 일이 아니라, 몬드성 전체의 일이기도 하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650116,
					"content": "정보 공유 감사해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "응, 뭔가 발견하면 언제든 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호프만"
				},
				{
					"id": 4650117,
					"content": "명심할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "죄송하지만 다른 정보는 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "그렇구나…. 아쉽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "호프만"
				}
