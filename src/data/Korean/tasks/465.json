			"dialogs": [
				{
					"id": 4650201,
					"content": "다이루크 어르신! 내 말 들어봐, 우리 금방 기사단에서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650202,
					"content": "심연 교단에서 내린 도전장을 본 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650203,
					"content": "이미 알고 있었어. 소식 전하러 여기까지 와줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650204,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650205,
					"content": "다운 와이너리의 정보망은 상업 정보에만 국한되지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650206,
					"content": "그래서 다이루크 어르신은 어떻게 할 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650207,
					"content": "너희들의 의견은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650208,
					"content": "역시 기사단과 협력하는 게 좋을 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "그게 바로 심연 교단이 바라는 바야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650210,
					"content": "그들은 나와 기사단의 사이가 좋지 않다는 걸 노리고 일부러 내 신분을 그들 앞에서 드러나게 할 속셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650211,
					"content": "내 신분이 노출되면 앞으로 기사단의 간섭을 피할 수 없게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650212,
					"content": "권력을 장악하고 있는 조직에게 외부인이 「정의를 대행」하는 건 달갑게 느껴지지 않을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650217,
					"content": "흠… 심연 교단 녀석들, 일을 어렵게 만들었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650218,
					"content": "해결책은 있어, 단지 그들보다 정보에서 우세를 점해야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650219,
					"content": "…도전장에 의도적으로 가려진 정보들 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650220,
					"content": "의도적으로 가려진 정보? 알아볼 수 없는 부분을 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650221,
					"content": "그것은 아마 그들만 알아볼 수 있는, 내부에서 사용되는 「암어」일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650222,
					"content": "그럼 「도전장」은 자기네들이 보려고 만든 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "그러니까 이건 「도전장」일 뿐만 아니라, 그들의 「작전 공문」에 가까워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650225,
					"content": "입장이 대립될 때, 한쪽의 「영웅」은 반드시 다른 한쪽의 「악인」인 법이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650226,
					"content": "내가 이렇게 오랫동안 「악인」 역을 해 왔으니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650227,
					"content": "나를 심연 교단의 작전 타깃으로 세우면, 분명 내부의 힘을 더욱 결속시킬 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650228,
					"content": "…우와 …영웅이 되려면 모두 다이루크 어르신처럼 머리가 잘 돌아가야 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650229,
					"content": "그들을 잘 알고 있을 뿐이야. 내가 말했듯이 「영웅」 또한 다른 관점에선 「악인」이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650230,
					"content": "그럼 그 알아볼 수 없는 정보들은 어떻게 해야 될까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4650231,
					"content": "모르면 가서 물어봐야지, 간단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650232,
					"content": "난 이미 그들의 <color=#00E1FFFF>거점</color> 한 곳을 발견했어…. 궁금하면 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650223,
					"content": "어차피 우리는 알아보지도 못하는데, 왜 굳이 암어를 쓴 걸까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "잠잠해질 때까지 와이너리에 피신해있는 게 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "그럼 결국 모든 걸 기사단에게 맡겨야 한다는 뜻이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650215,
					"content": "흥, 그들이 믿음직하다면 일이 이 지경까지 되지 않았겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4650216,
					"content": "더구나 나 다이루크가 기사단 뒤에 숨어서 그들이 뒷수습해 줘야 할 지경에 이르진 않았다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "다이루크"
				}
			]
