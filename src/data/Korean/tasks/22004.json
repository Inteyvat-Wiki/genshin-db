				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "대체 언제쯤 입질이 오려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220040102,
					"content": "뭐 하고 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "큰 물고기 좀 잡아보려고 낚시 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220040104,
					"content": "내 친구가 요리하는 걸 엄청 좋아하거든. 큰 물고기를 잡아다 주면 분명 좋아할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220040105,
					"content": "근데 주변에 몬스터가 계속 방해를 해서 물고기가 도망가 버렸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220040106,
					"content": "네가 가진 원소 기운 괜찮은 것 같은데, 낚시 좀 하게 저 몬스터 무리 좀 처리해 줄 수 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220040107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220040112,
					"content": "근데 넌 몬스터가 언제 올지 어떻게 아는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220040113,
					"content": "알 필요 있나? 그냥 고개 들면 보이는데, 뒤를 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220040114,
					"content": "뒤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220040109,
					"content": "어떻게 알았어요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "예전엔 나도 신의 눈을 가지고 있었거든. 사용하기 귀찮아서 그렇지 아직 원소는 느낄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220040111,
					"content": "넌 원소의 힘이 있으니까 저 몬스터쯤은 식은 죽 먹기잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "강설"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
