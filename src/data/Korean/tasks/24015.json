			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"드피에리스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "헉… 헉… 정말 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150602,
					"content": "정말 재수도 없지. 가만히 그림을 그리고 있었는데 갑자기 저놈들이 날 에워싸는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150603,
					"content": "그러더니 이 그림을 씹어먹을 것처럼 미친 듯이 이젤을 공격하기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150604,
					"content": "놈들을 피해 그림을 안고 이리저리 뛰어다녔지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150605,
					"content": "얼마 못 가서 결국 따라잡히고 말았지. 네가 와줘서 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150606,
					"content": "그림에 무슨 문제라도 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "나, 나도 몰라! 난 네가 가져다준 구라구라 꽃꿀로 만든 물감을 썼을 뿐이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150609,
					"content": "잠깐, 설마… 꽃꿀로 만든 물감 때문에 몰려든 건가? 하지만 물감에선 아무런 향기도 나지 않는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150610,
					"content": "물감 제조법은 마음대로 바꿀 수 있는 게 아니니까 다른 방법을 찾는 수밖에 없겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150611,
					"content": "크흠, 잠시나마 구라구라꽃도 이 그림에 담긴 아름다움을 구경하러 온 줄 알았네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150607,
					"content": "무슨 짓을 한 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}