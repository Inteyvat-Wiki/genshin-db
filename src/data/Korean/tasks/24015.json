			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"드피에리스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "아니, 이것도 아니야…. 음영을 제거하고도 깊이감을 살릴 방법이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150402,
					"content": "붓 터치의 표현력도 어딘지 부족하고… 색깔도 전혀 구분되지 않았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150403,
					"content": "젠장, 몇 가지 요소를 제거한 것뿐인데… 그림 전체가 엉망이 됐잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150404,
					"content": "여기서 뭐 하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "아, 너였구나. 이제 안심이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150407,
					"content": "오해하게 해서 미안. 그림 생각에 빠져 발길 닿는 대로 걷다 보니 그만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150408,
					"content": "넌 어떨지 몰라도 난 생각에 잠기면 가만히 못 있는 성격이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150409,
					"content": "한곳에 머물러 고민하다 보면 점점 짜증이 치밀어 오르더라고. 그래서 주로 산책하며 생각에 잠기곤 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150410,
					"content": "머리로는 생각하면서 다리가 이끄는 대로 자유롭게 거니는 거야. 하여튼 한곳에 가만히 있지만 않으면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150411,
					"content": "그래서… 이번에도 이렇게 된 거지. 걱정 끼쳐서 미안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150412,
					"content": "고민에 대한 답을 찾았나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "전혀, 약간의… 단서도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150415,
					"content": "음영을 제거하면 깊이감이 사라지고 형체를 흐릿하게 그리면 그림의 구성력이 약해지고 말아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150416,
					"content": "몇 가지 요소를 제거한 것뿐인데 그림 전체가 무너지더니 결국 한낱 쓰레기로 전락했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150417,
					"content": "혼잣말이니 너무 신경 쓰지 마. 난 이 문제를 어떻게 해결할지 계속 고민해 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150418,
					"content": "그 전에 돌아가서 내 이젤부터 찾아야겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240150413,
					"content": "고민은 해결됐어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "위험한 일이라도 생긴 줄 알았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
