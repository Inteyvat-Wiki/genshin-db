			"dialogs": [
				{
					"id": 711090201,
					"content": "우와, 허름한 왕산청에 이렇게 깊은 비밀이 숨겨져 있을 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711090202,
					"content": "나도 전혀 눈치채지 못했어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "게다가 황삼야도 이곳의 존재를 모르는 것 같았어… 잠깐만, 여기가 설마 전설의 그 「고화 보물고」인가?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711090205,
					"content": "#그리고… {NICKNAME}, 저기 좀 봐. 저쪽 받침대 위에 뭔가 빛나는 게 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711090206,
					"content": "보물이야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "아무튼 빨리 가서 확인해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711090207,
					"content": "장치인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "역시 「겉모습만 보고 판단해선 안 돼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
							"2"
						],
