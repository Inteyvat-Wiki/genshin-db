						],
						"pointId": 13301
					}
				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "야! 이 덩치야! 지금 뭐 하는 거야! 당장 멈춰!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760220202,
					"content": "모라… 아니, 아냐! 무라사키를 해친 녀석… 죽어라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "분노한 무사"
				},
				{
					"id": 760220203,
					"content": "#으아아! {NICKNAME}, 조심해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7602203,
			"completionStepIds": [
				7602203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
