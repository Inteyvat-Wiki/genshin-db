			"dialogs": [
				{
					"id": 760220101,
					"content": "저항해 봤자 죽을 뿐이다. 어서 모라를 내놔라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220102
					],
					"speakerTitle": "분노한 무사"
				},
				{
					"id": 760220102,
					"content": "도와주세요! 제발 도와주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220103
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220103,
					"content": "으아… 빨리 가서 구해주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
