						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페코"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2260.9,
							200.7,
							9289.5
						],
						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "아야야, 구해주셔서 정말 감사합니다. 저는 여행 상인 페코라고 해요. 나중에 저한테서 물건 사실 일 있으면 꼭 특별 할인가로 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220302,
					"content": "그러고 보니 오늘 정말 재수 없는 날이네요. 저런 전설적인 인물을 만나게 될 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220303,
					"content": "전설적인 인물? 걔가 그렇게 유명해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760220304,
					"content": "악행으로 유명하죠. 동료들은 그 녀석의 소문에 겁을 먹고 이 길을 피했는데, 저는 믿지 않았어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220305,
					"content": "정말 겁이 없구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760220306,
					"content": "여행 상인이라 별별 일을 다 겪으니까요. 그리고 여행 상인의 소문은 「사실이 과장」되기도 하죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220307,
					"content": "말이 옆으로 샜네요. 그 사람 이름은 「곤파치」라고 하는데, 이나즈마에서 큰일을 저지르고 이 외진 곳까지 도망쳐 왔다더군요. 아, 애인도 함께요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220308,
					"content": "그럼 그 사람이 말한 「무라사키」는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#맞다! 아까 그 괴인이 {NICKNAME}에게 그 이름을 언급했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760220310,
					"content": "범죄자는 새출발하기 쉽지 않아요. 제대로 된 생업이 없다 보니 그는 다시 옛날로 돌아갔죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220311,
					"content": "하지만 피로 얼룩진 삶은 원한을 낳았으며, 그는 무사했으나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220312,
					"content": "그의 애인은 무사하지 못했고, 결국 그는 미쳐버렸죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "페코"
				},
				{
					"id": 760220313,
					"content": "하아… 덩치가 괘씸하긴 해도, 저 꼴을 보니 조금 안쓰럽네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760220314,
					"content": "페이몬 절대 모라 때문에 약탈하지 마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "야! 그게 포인트가 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760220318,
					"content": "자자, 더는 두 분의 시간 안 뺏을게요. 이건 작은 감사의 표시니, 꼭 받아주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페코"
				},
				{
					"id": 760220316,
					"content": "페이몬이 약탈당하면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#후후, 내 곁에는 {NICKNAME}, 네가 있잖아! 내 모라는 안전해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}