				"points": []
			},
			"dialogs": [
				{
					"id": 722490201,
					"content": "좋, 좋아! 자네라면 반드시 해낼 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490202,
					"content": "자네에게 부탁하네, 이, 이 공물들을… 이 공물들을… 꼭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490203,
					"content": "꼭 가져가서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490204,
					"content": "가져가서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490205,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490206,
					"content": "왜 목소리가 점점 흐릿해지는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490207,
					"content": "공양하는 장소에… 가져가서… 영혼을 한곳에 모아야 해. 그래야만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490208,
					"content": "잔혼 선생?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490209,
					"content": "그래야만… 그래야만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490210,
					"content": "그래야만, 뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490211,
					"content": "그래야만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490212,
					"content": "윽, 뭐라고 하는지 하나도 모르겠어, 공물을 어딘가로 옮겨달라고 하는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490213,
					"content": "공물을 너무 오래 방치해둬서 먹을 수 있긴 하려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490214,
					"content": "몰래 먹을 생각하지 말라구…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "나, 나도 아무 음식이나 먹는 건 아니라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490216,
					"content": "#좋아, {NICKNAME} ,일단 공물을 넣어 둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
