			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490302,
					"content": "난 헬리오스를 건축한 자, 이름하여 아베라쿠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490303,
					"content": "음? 헬리오스?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490304,
					"content": "무슨 대단한 물건인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490305,
					"content": "물론이지! 내가 헬리오스를 세우고 온 나라의 힘을 동원해 심해 용의 자손의 침공을 막았다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490306,
					"content": "백야국 전체를 뒤져봐도, 이런 업적을 세울 수 있는 자는 나밖에 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490307,
					"content": "우와, 정말 대단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490308,
					"content": "근데 그렇게 대단한 사람이 왜 이곳에 갇혀있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490309,
					"content": "나… 난 배신을 당해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490310,
					"content": "당시 하늘의 나라가 무너져 끝없는 심연 아래로 추락했고, 인간들은 용의 자손들에게 공격당했지. 그리고 내가, 바로 내가 헬리오스를 건축해 사람들을 구했다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490311,
					"content": "하지만 그 비열한 소인배들이! 생명의 위협이 사라지자 향락에 빠져 온갖 비리를 저지르고… 마지막에는 어린아이를 한 나라의 왕으로 추대했지. 흥, 웃기지도 않는군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490312,
					"content": "그리고 나조차도 그들에게 모함을 당해 감옥에 갇히게 됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490313,
					"content": "젠장! 젠장!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490314,
					"content": "그런데, 자네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490315,
					"content": "저요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "맞아. 바로 너",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490320,
					"content": "자네를 말하는 걸세!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490321,
					"content": "원래 이곳에 내 의복이 있었지만, 세월이 흐른 탓에 모두 낡아 이제 사용할 수 없을 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490322,
					"content": "자네가 시련을 통과한다면 의식이 깃든 공물을 자네한테 맡기겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490323,
					"content": "자네가 시련을… 통과하길 바라네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490324,
					"content": "매우 위험한 일이네. 여행자여, 준비되면 나한테 말해주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722490317,
					"content": "페이몬, 널 부르잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "엥? 분명 널 쳐다보면서 말하고 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722490319,
					"content": "(그것도 엄청 부담스러운 눈빛으로 말이야)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "페이몬"
				}
			]
		},
