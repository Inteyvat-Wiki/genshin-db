					"nextDialogs": [
						4842202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4842202,
					"content": "앞에 원소 흔적이 끊겼어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "문물에 남긴 원소력이 거의 소진된 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4842204,
					"content": "그렇군, 괴조 일당은 원소 흔적을 없애지 못한다는 것을 알고, 부하들에게 시간을 끌게 한 거였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4842205,
					"content": "원소의 흔적이 자연히 사라지길 바란 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "엠버"
