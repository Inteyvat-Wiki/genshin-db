				},
				{
					"id": 4840403,
					"content": "…누가 바람 슬라임으로 그런 짓을 했단 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4840404,
					"content": "어쨌든, 아주 선명한 흔적이야, 일단 여기를 기억해 둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4841101,
					"content": "원소의 흔적이 계속 앞을 가리키고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841102
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4841102,
					"content": "괴조가 앞으로만 도망친 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4841103,
					"content": "추측만으로는 결론을 낼 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841104
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4841104,
					"content": "#{NICKNAME}, 흔적을 따라 쫓아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841105
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4841105,
					"content": "어, 앞에서 무슨 소리가 나는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4841106,
					"content": "싸우는 소리 같은데, 설마 괴조인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841107
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4841107,
					"content": "서둘러, 빨리 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				}
			]
