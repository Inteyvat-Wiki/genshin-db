	"talks": [
		{
			"id": 7082801,
			"completionStepIds": [
				7082801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082801",
							"2"
						],
						"stepId": 7082801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"엘시"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "아! 거기 금발 모험가! 잠깐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280103,
					"content": "도와줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "아니, 도와달라는 게 아니라, 사랑에 관한 시집이 있는지 물어보려고 한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280107,
					"content": "잘 들어. 이 몸은 엄청난 음유시인이거든. 어쩌면 몬드 역사상 바르바토스 님을 빼면 가장 뛰어난 음유시인일지도 몰라… 아무튼 엄청 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280108,
					"content": "근데 그 리누스라는 음유시인은 도무지 인정하려 들지를 않아. 하루가 멀다 하고 와서는 내 앞에서 시를 낭독한다니까! 누가 봐도 일부러 시비 거는 거잖아, 그렇지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280109,
					"content": "더 열받는 건, 그가 읽는 시라는 게 전부 사랑이니 연인이니… 나는 한 번도 써 본 적 없는 주제들이라는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280110,
					"content": "그래서 말인데, 이번엔 내가 직접 나설 거야. 몬드 전체를 뒤흔들 위대한 사랑의 시를 써서, 진짜 재능이 뭔지 보여 줄 생각이거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280111,
					"content": "하지만 말이야… 난 그동안 위대한 예술에 시간을 바치느라, 아직 사랑을 직접 경험해 볼 여유는 없었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280112,
					"content": "그러니 사랑에 관한 시집이 있다면 나한테 팔아! 조금만 훑어보면, 이 몸의 천재적인 재능으로 바로 영감이 샘솟을 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280104,
					"content": "아니, 난 바빠서 이만",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "도와달라는 게 아니라니까! 그리고 말인데, 만약 사람들이 문제가 생길 때마다 길가에서 아무나 붙잡고 해결해 달라고 하면, 다들 길도 못 나서지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280106,
					"content": "크흠, 그냥 사랑에 관한 시집이 있는지 물어보려던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "엘시"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
