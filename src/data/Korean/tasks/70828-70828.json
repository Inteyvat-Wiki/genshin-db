					"엘시"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "(《로나부예의 꿈》을 건넨다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "오오, 폰타인의 시집이네! 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280403,
					"content": "과거로 돌아가… 물의 기사의 왕궁… 시녀를 보고 첫눈에 반한다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280404,
					"content": "아, 웃겨 죽겠네. 뭐 이렇게 멍청한 사람이 다 있어! 과거로 돌아갔으면서 고작 자기 조상 또래 사람이랑 연애할 생각밖에 없다니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280405,
					"content": "이건 사랑 시가 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280406,
					"content": "아, 이제 알겠어! 사랑이라는 건 사람을 멍청하게 만드는 거구나. 일단 사 가서 천천히 읽어봐야지… 고마워, 금발 모험가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘시"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082805",
							"2"
						],
						"stepId": 7082805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"엘시"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "하하, 고마워, 금발 모험가! 넌 정말 내 최고의 영웅이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280502,
					"content": "지금 내 머릿속의 영감이 말이야, 바람 드래곤의 폐허의 광풍, 침옥 협곡의 연기, 세이라이섬의 번개처럼 막 쏟아져 나오고 있어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280503,
					"content": "위험한 거 아니야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "흥, 두고 봐! 지금 당장 다 써 내려갈 거니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "엘시"
				},
				{
					"id": 708280505,
					"content": "리누스의 그런 낯 간지러운 시 따윈 상대도 안 돼. 내 불후의 걸작이 완성되면, 티바트의 모든 술집이 이 몸 때문에 들끓게 될걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘시"
				}
			]
		},
		{
			"id": 7082806,
