			"dialogs": [
				{
					"id": 730630601,
					"content": "금빛의 나라와 하얀 둥실이, 너희 왔구나! 난 아란가루라고 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630602
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730630602,
					"content": "초목과 버섯이 너희가 올 거라고 알려줬어, 한참 기다렸지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630603
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730630603,
					"content": "응…? 우릴 알아…? 무슨 일로 우리를 찾아온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730630604,
					"content": "아주 아주 아주 중요한 일이 있어!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630605
					],
					"speakerTitle": "아란가루"
				},
				{
