			"dialogs": [
				{
					"id": 3760401,
					"content": "다이루크 어르신, 이번 주 장부입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 3760402,
					"content": "역시 이번 폭풍으로 장사에 큰 타격을 입었군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3760403,
					"content": "빨리 이 재앙이 지나갔으면 좋겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 3760404,
					"content": "주인장, 우리… 좀 은밀한 곳이 필요한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3760405,
					"content": "2층으로 가봐. 2층엔 사람이 적어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3760406,
					"content": "하지만 넌 음유시인이잖아? 눈에 띄는 자리가 좋을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3760407,
					"content": "아하하, 공연은 다음에 하고 먼저 올라갈게, 나중에 봐~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3760408,
					"content": "저들을 잘 감시해. 저 시인은 뭔가 수상하단 말이지. 무슨 상황인지 알아봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3760409,
					"content": "음… 누구에게 물어보시려고요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 3760410,
					"content": "몬드성의 「경비병」들에게 물어봐야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "다이루크"
				}
			]
		},
