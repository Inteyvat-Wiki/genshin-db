			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"류지"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "왔구나. 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330102,
					"content": "방금 의심스러운 곳들을 조사했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330103,
					"content": "야영지 중 한 곳은 그 모자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330104,
					"content": "크흐흠, 그 「검은 그림자」가 지키고 있어. 만약 별문제가 없다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330105,
					"content": "어제 말한 「조사」는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "그거라면, 아직 아는 게 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330107,
					"content": "어? 산고가 조사하라고 하지 않았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400330108,
					"content": "그렇지, 근데… 그게 어떻게 말을 떼야 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330109,
					"content": "예를 들어, 「잘 익은 제비꽃 열매」와 「문발 위의 흙손 자국」. 난 둘이 관련이 있다고 생각하지 않거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330110,
					"content": "하지만 산고 사장님의 머리만 거치면 「퍼즐」을 푸는 열쇠가 될 수 있다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330111,
					"content": "「잘 익은 제비꽃 열매」와 「문발 위의 흙손 자국」… 둘 사이에 무슨 관계가 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400330112,
					"content": "그냥 예시일 뿐이야. 난 지시에 따라 야시오리섬과 진수의 숲에서 몇몇 장소를 조사한 후 사장님에게 보고했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330113,
					"content": "그리고 내 보고에서 사장님이 어떤 결론을 도출했을지는 사장님 본인만이 알고 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330114,
					"content": "오직 시카노인 선생님만이 사장님의 머리를 따라갈 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330115,
					"content": "시카노인?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "텐료 봉행의 사람이야. 전에 수사할 때 운 좋게 만난 적이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330117,
					"content": "음… 독특한 분위기를 풍기는 사람이었지. 만나게 되면 너도 한눈에 알아볼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330118,
					"content": "아무튼, 동물은 너한테 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400330119,
					"content": "난 아직도 「잘 익은 제비꽃 열매」가 신경 쓰이는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003303",
							"2"
						],
						"stepId": 4003303,
						"stateName": "QUEST_STATE_UNFINISHED"
