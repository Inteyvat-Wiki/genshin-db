			"dialogs": [
				{
					"id": 400335201,
					"content": "안심해. 짐작 가는 게 있으니까. 류지가 계속 「검은 그림자」를 조사할 거야. 너희들은 빨리 동물을 구해줘",
					"roleType": "TALK_ROLE_NPC",
