				"points": []
			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "젠장! 젠장! 어째서 나한테 이런 일이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "원청"
				},
				{
					"id": 210070202,
					"content": "그놈들이 눈치채기 전에 광갱에 먼저 와서 보물을 쓸어가려고 했는데, 몬스터가 그렇게나 많을 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "원청"
				},
				{
					"id": 210070203,
					"content": "젠장할…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "원청"
				}
			]
		},
