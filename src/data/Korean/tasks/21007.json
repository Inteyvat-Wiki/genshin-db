			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"원청"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "으악… 아, 아까 그 사람들이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210070602,
					"content": "의지할 숲도 없이 외로이 서 있는 나무 한 그루…. 하하, 역시 혼자선 아무것도 할 수 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "원청"
				},
				{
					"id": 210070603,
					"content": "붉은 단풍이 무성하면 바람이 불지 않아도 저절로 떨어지네…. 형님과 아버지의 말을 믿을 수 있다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "원성"
				},
				{
					"id": 210070604,
					"content": "붉은 단풍이 떨어져 바람을 타고 흩어지네…. 보물… 보물 때문에 모든 걸 잃었네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "원량"
				},
				{
					"id": 210070605,
					"content": "구불구불한 나무가 우거져 가족을 보호하네…. 애들아, 우린 한 식구다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "원홍"
				},
				{
					"id": 210070606,
					"content": "너희들은 모두 내가 보물을 광갱에 숨긴 줄 알았겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "원홍"
				},
				{
					"id": 210070607,
					"content": "나한테 보물이 어딨겠느냐…. 이 나무 기억나니? 너희가 어렸을 때 온 가족이 같이 심었던 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "원홍"
				},
				{
					"id": 210070608,
					"content": "매년 여기에 물건을 묻어뒀어. 너희가 어른이 됐을 때 다 같이 그 물건들을 파내려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "원홍"
				},
				{
					"id": 210070609,
					"content": "그럼 그때 여기 있는 것들로 맛있는 걸 사서 술도 마시며 온 가족이 모여 옛날이야기라도 하려고 했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "원홍"
				},
				{
					"id": 210070610,
					"content": "아이고, 애들아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "원홍"
				}
			]
		}
	]
