					"원성"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "형제는 무슨! 형님들은 좋은 건 다 자기네들끼리만 먼저 차지하려고 하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "원성"
				},
				{
					"id": 210070302,
					"content": "아버지도 늙은 영감처럼 보고도 눈감아 주고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "원성"
				},
				{
					"id": 210070303,
					"content": "보물이 아직 광갱 안에 있다는 건 다들 모를 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "원성"
				},
				{
					"id": 210070304,
					"content": "보물을 빨리 가져와서 멀… 멀리 떠나야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "원성"
				}
			]
		},
		{
			"id": 2100704,
			"completionStepIds": [
				2100713
