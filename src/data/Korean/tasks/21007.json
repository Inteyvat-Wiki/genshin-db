			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "갔네…. 다 갔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "원홍"
				},
				{
					"id": 210070502,
					"content": "원청, 원량… 그리고 원성. 어리석은 놈들, 좀 더 자세히 보고 곰곰이 생각해 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "원홍"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
