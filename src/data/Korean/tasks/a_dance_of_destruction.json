				"points": []
			},
			"dialogs": [
				{
					"id": 30301001,
					"content": "도착했어! 여긴 야시로 봉행부잖아? 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301002,
					"content": "#{NICKNAME}, 오랜만이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301003
					],
					"speakerTitle": "히로타츠"
				},
				{
					"id": 30301003,
					"content": "안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301004
					]
				},
				{
					"id": 30301004,
					"content": "봉행 어르신과 아가씨를 찾는 거라면, 아쉽지만 오늘은 댁에 안 계셔서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301005
					],
					"speakerTitle": "히로타츠"
				},
				{
					"id": 30301005,
					"content": "공무를 처리하러 간 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301006
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301006,
					"content": "봉행 어르신은 공무 처리를 위해 자리를 비우셨고 아가씨는 봉행 어르신 대신 회의에 참석하러 가셨어. 급한 일이라면 안에서 기다려도 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301007
					],
					"speakerTitle": "히로타츠"
				},
				{
					"id": 30301007,
					"content": "어떻게 할래? 들어갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301008
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301008,
					"content": "그럼 실례하겠습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301009
					]
				},
				{
					"id": 30301009,
					"content": "정원에서 산책해도 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301010
					]
				},
				{
					"id": 30301010,
					"content": "다른 사람이라면 안 되겠지만 넌 봉행 어르신과 아가씨와 절친한 사이니 괜찮을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301011
					],
					"speakerTitle": "히로타츠"
				},
				{
					"id": 30301011,
					"content": "고마워! 그럼 들어간다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301012
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301012,
					"content": "음? 왜 그렇게 쳐다보는 거야? 뭐 묻고 싶은 거라도 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301013
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301013,
					"content": "할머니, 뭐 하나만 물어봐도 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301014
					]
				},
				{
					"id": 30301014,
					"content": "호호, 물론이지. 네 이야기는 아가씨한테서 많이 들었단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301015
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301015,
					"content": "뭐가 궁금하니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301016
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301016,
					"content": "봉행 어르신과 아가씨는 잘 지내시죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301017
					]
				},
				{
					"id": 30301017,
					"content": "너희 덕분에 두 분 다 잘 지내신단다. 아가씨는 요즘 각종 회의에 출석하시느라 바쁘시고, 가끔 봉행 어르신을 도와 민간 조직을 방문하시지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301018
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301018,
					"content": "그리고 봉행 어르신은 평소처럼 늘 바쁘시단다. 굳이 첨언하자면, 최근에는 기분이 좋아 보이시더구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301019
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301019,
					"content": "별 이상 없는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301020
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301020,
					"content": "그렇단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301021
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301021,
					"content": "(카미사토 아야토는 여전히 봉행직을 맡고 있고 카미사토 아야카는 여전히 봉행부의 아가씨야…. 기존과 달라진 건 없어)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301022
					]
				},
				{
					"id": 30301022,
					"content": "(야시로 봉행의 상황도 달라진 게 없는 것 같고…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301023
					]
				},
				{
					"id": 30301023,
					"content": "(무사할 거라 예상하긴 했지만 두 남매가 잘 지낸다는 말을 들으니 마음이 놓이네)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301024
					]
				},
				{
					"id": 30301024,
					"content": "어때? 더 묻고 싶은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301025
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301025,
					"content": "묻고 싶은 건 다 물었어요. 감사합니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301026
					]
				},
				{
					"id": 30301026,
					"content": "괜찮단다. 바쁘지 않으면 봉행부에 자주 놀러 오렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301027
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301027,
					"content": "아가씨는 늘 너를 언급하신단다. 너 같은 대단한 친구가 있어서 기쁘다고 하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301028
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301028,
					"content": "네가 이나즈마에 온 뒤로 모든 게 올바른 방향으로 흘러가는 것 같아. 네가 바로 소위 말하는 귀인인가 보구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301029
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301029,
					"content": "과찬이세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 303012,
			"completionStepIds": [
				303010
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303010",
							"2"
						],
						"stepId": 303010,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"12035",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"후루타"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30301201,
					"content": "사실을 말한 거뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301202
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301202,
					"content": "봉행 어르신이 식사하실 때마다 토마가 함께하는데, 옆에서 둘의 대화를 듣는 게 이 늙은이의 낙이란다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301203
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301203,
					"content": "공무 때문에 외식하고 들어오시는 경우도 있지만 봉행 어르신은 웬만하면 저택에서 식사를 선호하시지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301204
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301204,
					"content": "웬만한 요리사보다 요리 솜씨가 좋은 토마 때문이라고 하시던데. 허허, 봉행 어르신께선 언제나 「집」을 그리워하시는 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301205
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301205,
					"content": "너는 모르겠지만, 봉행 어르신과 아가씨는 늘 너를 언급할 때마다 수십 년 지기 친구처럼 말하시지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301206
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301206,
					"content": "가끔 아가씨도 끼어서 다 함께 가족 식사를 하시는데, 최근 그럴 때마다 네 이야기가 늘 빠지지 않았단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301207
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301207,
					"content": "…전대 봉행 어르신과 부인께서 돌아가신 지도 어언 몇 년이 흘렀구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301208
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301208,
					"content": "이 늙은이는 봉행 어르신과 아가씨가 성장하는 걸 지켜봐 왔지. 두 분의 신분으로는 너희처럼 재밌고 믿을 만한 벗을 사귀기 쉽지 않은데 참 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301209
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301209,
					"content": "그러니 시간 나면 자주 봉행부에 놀러 오렴, 이 늙은이의 부탁이란다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301210,
						30301211
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301210,
					"content": "감사합니다, 그렇게 할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301212
					]
				},
				{
					"id": 30301212,
					"content": "호호, 정말 고맙구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301213
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301213,
					"content": "헤헤, 나도 여기가 좋아. 그리고 할머니 말대로라면 야시로 봉행부 음식은 정말 맛있겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301214,
					"content": "상상만 해도 군침이 도는걸. 다음에는 밥 먹으러… 아니, 놀러 와야겠어! 물론 식사 시간에 오는 게 가장 좋겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301215,
					"content": "물론이지, 언제든지 오렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301401
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301401,
					"content": "그럼 이만 가볼게. 그런데… 음, 이제 우리 어디로 가는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301402,
					"content": "타타라스나로 갈 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301403
					]
				},
				{
					"id": 30301403,
					"content": "알았어. 할머니 안녕! 배웅 나올 필요 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301404,
					"content": "아아, 그래. 다음에 만나자꾸나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301405
					],
					"speakerTitle": "후루타"
				},
				{
					"id": 30301405,
					"content": "벌써 가려는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301406
					],
					"speakerTitle": "히로타츠"
				},
				{
					"id": 30301406,
					"content": "응, 볼일은 다 봤으니 걱정하지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30301407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30301407,
					"content": "알았어, 그럼 여정이 순조롭기를 빌게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "히로타츠"
				},
				{
					"id": 30301211,
					"content": "카미사토 가문 사람들은 전부 제 친구들이니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30301212
					]
				}
			]
		},
