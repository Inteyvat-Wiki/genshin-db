			"dialogs": [
				{
					"id": 733480201,
					"content": "잠깐! 제발 그만! 때리지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "다라"
				},
				{
					"id": 733480202,
					"content": "후우… 겨우 책이 든 상자 하나 때문에 이렇게 무섭게 굴 필요 없잖아. 원한다면 그냥 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "다라"
				},
				{
					"id": 733480203,
					"content": "이게 다예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "맹세할게! 우리가 찾은 건 이 상자 하나가 전부야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "다라"
				},
				{
					"id": 733480206,
					"content": "책 말고도 돌이랑 진흙이 담긴 병이 들어 있었어…. 돌 중에는 비싸 보이는 보석들도 있었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "다라"
				},
				{
					"id": 733480207,
					"content": "그 보석들을 가져갔어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "이봐! 보석들을 전부 돌려줘! 그건 소중한 지질 샘플이란 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733480209,
					"content": "지질 샘플…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "다라"
				},
				{
					"id": 733480210,
					"content": "돌려줘요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "아, 알겠어! 돌려줄게! 다들 뭐해? 빨리 물건을 상자에 넣지 않고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "다라"
				},
				{
					"id": 733480213,
					"content": "다 넣었으니까 우리는 이만 가볼게… 아하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "다라"
				},
				{
					"id": 733480214,
					"content": "사다피가 찾는 물건은 전부 이 안에 있겠지? 빨리 가져다주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733480215,
					"content": "그나저나 정말 대단한 학자네…. 혼자 사막에서 지질 샘플을 이만큼이나 모으고, 메모도 잔뜩 남겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733480211,
					"content": "3초 줄게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "다른 것도 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
		{
