						],
						"stepId": 7311001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"소헤일"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100101,
					"content": "후… 여긴 훨씬 더 시원하군. 일단 석판부터 보여주겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100102
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100102,
					"content": "소헤일은 석판을 이리저리 훑어보더니 미간을 찌푸리기도 하고 감탄을 하기도 했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100103
					]
				},
				{
					"id": 731100103,
					"content": "이봐… 너무 오래 보는 거 아니야! 설마 그 위에 적힌 내용을 전부 기억하고 보수를 떼어먹으려는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100104,
					"content": "미안, 미안. 너무 집중하는 바람에. 이런 문헌은 처음 봐서 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100105
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100105,
					"content": "뭐 알아낸 거 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100106
					]
				},
				{
					"id": 731100106,
					"content": "음… 일부는 어떤 프로젝트의 기록처럼 보이는군… 「아루」라는 단어가 언급되는데, 아루 마을과는 어떤 연관이 있는지 모르겠어. 기록이 이것뿐이라 아쉽군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100107
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100107,
					"content": "하지만 그래도 논문에 도움이 될 것 같아. 고맙군. 이건 약속한 보수라네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100108,
						731100109
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100108,
					"content": "천만에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100112
					]
				},
				{
					"id": 731100112,
					"content": "그럼 이제 더 많은 문헌을 찾아야겠군. 하지만 사막에 진입하지 않으면 얻기 힘들 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100113
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100113,
					"content": "아… 생각났다! 너희 혹시 시간 있으면 내 부탁 좀 들어주겠나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100114
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100114,
					"content": "소헤일 씨, 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100115
					],
					"speakerTitle": "훌와니"
				},
				{
					"id": 731100115,
					"content": "현자님의 분부에 따르면 그 어떤 학자도 사막에 들어갈 수 없습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100116
					],
					"speakerTitle": "훌와니"
				},
				{
					"id": 731100116,
					"content": "아, 오해하지 마. 현자님의 명령을 어길 생각은 없으니까. 하지만 현자님께서 선물을 주면 안 된다고 말씀하신 적은 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100117
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100117,
					"content": "선물? 우리한테 무슨 선물을 주려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100118,
					"content": "아주 귀한 물건——내 고고학 노트지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100119
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100119,
					"content": "솔직히 십여 년 전, 나도 사막에 들어갔었지만 별다른 발견은 하지 못했어. 그저 의심스러운 유적의 위치만 기록해 두었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100120
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100120,
					"content": "오랜 세월이 흐른 뒤, 이곳에 돌아오자마자 유적 때문에 자네들과 만나게 됐다니, 이건 어떤 숙명일 게 분명하네. 그러므로 이 노트를 자네들에게 주겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100121
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100121,
					"content": "설마…? 알겠습니다. 확실히 현자님의 말씀을 어긴 건 아니군요. 하지만 이런 행동은 결국…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100122
					],
					"speakerTitle": "훌와니"
				},
				{
					"id": 731100122,
					"content": "#행동? 무슨 행동? 난 대영웅 {NICKNAME}(와)과 작은 영웅 페이몬을 만난 걸 기념하기 위해 선물을 하는 걸세. 아주 합리적이지 않나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100123
					],
					"speakerTitle": "소헤일"
				},
				{
					"id": 731100123,
					"content": "합리적…이네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100124,
						731100125
					],
					"speakerTitle": "훌와니"
				},
				{
					"id": 731100124,
					"content": "아주 합리적이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100130,
					"content": "후, 학자들의 세계는 참 복잡하네! 우리한테 조사를 부탁하고 싶은 거면서 굳이 선물을 하고 싶다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100131,
					"content": "솔직히 말하면 옆에 있는 남자가 현자에게 고자질할까 봐 걱정돼서 그러는 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100132,
						731100134,
						731100136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100132,
					"content": "페이몬의 세계가 너무 단순한 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100133
					]
				},
				{
					"id": 731100133,
					"content": "그래? 난 내 세계도 꽤 복잡하다고 생각하는데, 여러 가지 음식의 맛을 기억해야 하고… 여러 보물들의 획득 방법도 기억해야 하니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100141,
					"content": "그것보다 어서 소헤일이 준 선물에 뭐라고 기록되어 있는지부터 확인하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100142,
					"content": "음… 힘들었겠네. 적왕의 무덤 부근을 한 달이나 탐색했는데 수확이 전혀 없었다니. 하지만 포기하지 않고 결국에는 몇몇 「투명 유적」을 발견했대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100143
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100143,
					"content": "그러고 나서 적왕의 무덤보다 훨씬 작은 「포식의 릉」을 발견했어. 마지막으로는 「양을 삼킨 바위」라는 곳에서 용병들한테 습격당했다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100144,
					"content": "음, 기록을 보니까 꽤 힘들었던 것 같아. 그런데도 「비웃음보다 지식이 늘지 않은 것이 더 고통스럽다」라고 말하다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100145,
					"content": "지금과는 딴판이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100146
					]
				},
				{
					"id": 731100146,
					"content": "응, 그 당시 소헤일은 지식 탐구에 진심이었나 봐. 나 감동받았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100147
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100147,
					"content": "그렇다면 이 노트를 귀중한 선물이라고 말한 게 과장이 아닐지도 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100148
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100148,
					"content": "그럼, 소헤일이 말한 곳에 다 가보자! 선물에 대한 답례로, 발견한 건 모조리 챙겨오는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100134,
					"content": "페이몬이 알아들었다니!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100135
					]
				},
				{
					"id": 731100135,
					"content": "당연하지! 얼굴에 「도와달라」고 쓰여있던데! 이럴 때 도와주면 분명 보수를 많이 받을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100136,
					"content": "나름대로 사정이 있겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100137
					]
				},
				{
					"id": 731100137,
					"content": "그렇긴 하지만, 학자들은 지식 추구라는 단어를 방패로 생각하는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731100138,
					"content": "그 단어만 말하면 정의의 화신이 되어 어떤 말을 하든지, 어떤 행동을 하든지 다 무슨 엄청난 사정이 있는 것처럼 된다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100139
