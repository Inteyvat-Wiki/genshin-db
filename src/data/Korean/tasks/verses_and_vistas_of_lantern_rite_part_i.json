			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"청주"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "여기 경치 좋다. 엇, 이 사람은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350302,
					"content": "소인은 청주입니다. 시객이라 할 수 있죠. 당신은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350303,
					"content": "하하, 시인이라고요? 난 화가예요. 근처에서 소재를 찾던 중이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350304,
					"content": "소재를 찾고 계신다고요? 저도 그런데 이거 반갑네요. 근데 어째서 소재를 찾고 계시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350305,
					"content": "음, 전 해등절과 리월항을 그리고 싶어요. 그래서 이 여행자와 경치 좋은 곳을 찾고 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350306,
					"content": "맞다, 당신은 왜 여기서 소재를 찾고 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350307,
					"content": "음… 이거 놀라운데 사실 저도 해등절과 리월항에 관한 시를 쓰려고 여기서 소재를 찾고 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350308,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350309,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350310,
					"content": "시 한 수로는… 부족하지 않을까요? 해등절과 리월항을 어떻게 몇 구절 안에 담을 수 있겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350311,
					"content": "하하, 저도 마찬가지로 해등절과 리월항을 담으려면 아주 큰 그림을 그려야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350312,
					"content": "큰 그림? 허허, 그럼 오히려 해등절의 운치가 사라질 것 같은데요? 리월의 바람도 놓칠 것 같고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350313,
					"content": "게다가 이렇게 큰 리월을 어떻게 그림 한 폭에 다 담을 수 있겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350314,
					"content": "하하, 제 생각엔 그림이 나을 거 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350315,
					"content": "허허, 제 생각엔 시가 나을 거 같군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350316,
					"content": "두 분 좀 진정하세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "이렇게 싸우다간 끝이 없겠네요. 그럼 각자 작품을 하나씩 창작해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350318,
					"content": "작품이 완성되면 사람을 불러다가 평가를 들어보는 게 어떨까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350319,
					"content": "그것도 괜찮겠네요. 그럼 그림이 완성되면 망서 객잔을 오십시오. 거기서 평가해줄 사람을 찾아보죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350320,
					"content": "좋아요, 그럼 그렇게 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350321,
					"content": "알겠습니다. 그럼 전 먼저 가볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "청주"
				},
				{
					"id": 413350322,
					"content": "저 시인 되게 자신만만하네. 글 몇 줄로 해등절과 리월항을 담겠다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350323,
					"content": "흥, 나중에 내 그림을 보면 저 시인은 패배를 인정할 수밖에 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350324,
					"content": "심혈을 기울여야지…. 그림 재료도 제대로 준비해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350325,
					"content": "여행자, 특별 재료를 수집해줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350326,
					"content": "알겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "그럼 부탁할게. 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350329,
					"content": "음… 뜨거운 구라구라꽃에서 구라구라 꽃꿀을 모아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350330,
					"content": "그게 있으면 특별한 물감을 만들 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350328,
					"content": "어떤 재료가 필요하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
