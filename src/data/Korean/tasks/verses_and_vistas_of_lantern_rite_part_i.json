			"trigger": {
				"objectNames": [
					"베르메르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "아냐, 이것도 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "아, 안녕. 난 이 근처에서 소재를 찾고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350104,
					"content": "지금 해등절 기간이잖아? 어떻게 그림으로 해등절과 리월항을 표현할지 고민 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350105,
					"content": "휴… 근데 내 방법이 잘못됐는지 아니면 다른 이유 때문인지… 아무리 그려도 느낌이 안 살아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350106,
					"content": "장소를 바꾸면 영감이 떠오를까? 근데 좋은 장소를 못 찾겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350107,
					"content": "여행자, 그림 그릴 만한 곳을 알고 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 413350108,
					"content": "그럼 저희가 주변에서 찾아볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "음… 그래. 그럼 같이 주변을 찾아보자. 괜찮은 곳이 눈에 띌 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르메르"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
