				},
				{
					"id": 200130202,
					"content": "한번 더 도와줄 수 있어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200130203,
					"content": "이 장애물이 내 모험의 길을 가로막고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200130204,
					"content": "이 장애물을 치워줄 수 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200130205,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "엇, 내가 너라면 벌써 위대한 모험가가 되었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "잭"
				},
				{
					"id": 200130206,
					"content": "다른 일이 있어서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "안 돼. 내 위대한 모험 여정이 여기서 끝나면 안 돼. 제발 도와줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "잭"
				}
			]
		},
