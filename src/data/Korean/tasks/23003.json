				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하팀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "여행자! 아니, 재물의 자손이여, 행운의 자손이여! 드디어 왔군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030202,
					"content": "저번에 자네가 준비한 「황금 요리」를 먹고 거래소에서 큰 수익을 거뒀다네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030203,
					"content": "오늘 확인해 보니 그때 산 선물들 모두 아주 큰 수익이 났다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030204,
					"content": "자자, 어서 람바드 술집으로 가자고. 음식은 마음껏 시켜. 고마움의 뜻으로 오늘은 내가 살 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하팀"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하팀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "자네들이 도와준 덕분에 큰돈을 벌 수 있었어. 마음껏 시키라고! 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030402,
					"content": "정말 돈을 많이 번 모양이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230030403,
					"content": "다른 사람에겐 큰돈일지 모르지만, 이 하팀의 자산 규모에 비하면 푼돈일 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030404,
					"content": "난 수십 년 동안 거래소를 누빈 전문가니까. 자네들도 선물 거래에 관심이 있다면 투자 팁을 알려줄 수도 있는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030405,
					"content": "저번에 수익을 얻으면 따로 보상을 주겠다고 했지? 사양하지 말고 뭐든지 물어보게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030406,
					"content": "보상이라는 게 그거였어? 보상이 없는 거랑 똑같잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230030407,
					"content": "우리는 선물 거래도 안 하는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "무슨 소리야, 모라는 당연히 줄 거라네. 하지만 모라보다 이 하팀의 가르침이야말로 진짜 가치가 있는 거라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030409,
					"content": "그럼 궁금한 게 있어… 정말 슬라임도 선물 거래가 가능해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230030410,
					"content": "딱, 딱히 돈을 벌고 싶은 건 아니야! 그냥 궁금해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230030411,
					"content": "유통되는 상품만 선물 거래를 할 수 있네. 시장에 슬라임 응축액이 밀가루나 우유만큼 많아져야 슬라임 응축액의 선물 거래가 형성될 수 있다는 뜻이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030412,
					"content": "전에도 말했지만 슬라임 응축액 선물 거래가 시작된다면 야외의 슬라임들은 씨가 말라버릴 게야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030413,
					"content": "그리고 전문적으로 슬라임을 기르며 지속적으로 대량의 슬라임 응축액을 생산하는 기관이나 개인이 나타날지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030414,
					"content": "그러면 슬라임 응축액의 가격이 대폭 상승할지도 모르겠군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030415,
					"content": "우와! 슬라임 응축액을 사는 게 이렇게 복잡하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230030416,
					"content": "#나, 난 그냥 {NICKNAME}한테 슬라임을 처치하라고 부탁하는 게 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230030417,
					"content": "재물의 자손이여, 자네는? 자네는 뭐 질문 같은 거 없나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030418,
					"content": "「황금 요리」는 어떻게 연구한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "하! 역시 재물의 자손답군. 바로 재물을 획득할 수 있는 핵심 포인트를 잡아내다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030420,
					"content": "「연구」했다기보다… 장기간 선물 거래를 하면서 「황금 요리」에 대해 「정리」한 거라고 하는 게 더 정확하다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030421,
					"content": "선물 거래 시장은 그 흐름을 예측할 수 없지만… 「황금 요리」가 있다면 투자라는 배의 키를 잡은 거나 마찬가지지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030422,
					"content": "역시 아무런 근거도 없는 거군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "그 얘기는 조금 있다가 하고! 자, 얼른 먹어. 많이 먹으라고! 앞으로도 잘 부탁하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030425,
					"content": "자! 이 샤와르마 좀 먹어보게. 이건 꼭 먹어 봐야 하는 수메르의 스페셜 요리라네, 하하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030426,
					"content": "하팀과 함께 맛있는 음식을 먹는다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "그냥 「마음의 평화」를 얻기 위한 거 아닌가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하팀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "분명 「재물의 땅」에서 「황금 요리」를 먹었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030702,
					"content": "왜 이렇게나 떨어진 게야… 이건 말도 안 돼! 이 시장은 규칙 같은 것도 없는 건가? 규칙 같은 것도 없는 거냐고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030703,
					"content": "하팀, 한참 찾았잖아. 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230030704,
					"content": "자네들이었군… 괜찮네… 난 괜찮아… 뭐, 팔다리를 잃은 것도 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030705,
					"content": "그냥 보증금을 날린 것뿐이야… 큼큼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030706,
					"content": "죄, 죄송해요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "아니! 이건 자네 잘못이 아니야. 마음에 담아두지 말게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030708,
					"content": "물론 이건 내 잘못도 아니지. 이 시장이 너무 엉망인 탓이라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030709,
					"content": "아무런 규칙도 없어! 아무런 징조도 없이 떨어지고… 오를 땐… 아니지, 한 번도 오른 적이 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030710,
					"content": "참, 난 정말…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230030711,
