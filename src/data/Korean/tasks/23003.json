	"talks": [
		{
			"id": 2300302,
			"completionStepIds": [
				2300302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
