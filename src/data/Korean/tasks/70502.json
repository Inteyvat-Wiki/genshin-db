					"루카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "안녕, 네가 바로 그 유명한 여행자구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705020102,
					"content": "맞아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "이봐, 나도 있거든. 내가 바로 그 유명한 페이몬이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705020105,
					"content": "그게, 요새 「천사의 몫」 술집에서 「바텐더 체험 주간」 행사를 열고 있거든. 너라면 관심 있을 것 같아서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705020106,
					"content": "쉽게 말해서, 직접 칵테일을 만드는 거야… 다른 걸 만들어도 되고. 재료도 마음껏 쓸 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705020107,
					"content": "낭비만 안 한다면, 완성품도 무제한으로 마실 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705020108,
					"content": "무한으로!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705020109,
					"content": "손님들 반응이 좋으면, 보수도 꽤 짭짤할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705020110,
					"content": "와, 보수까지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705020111,
					"content": "엄청 신났네, 페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "우리도 하자! 응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705020113,
					"content": "「체험 주간」이라곤 해도, 출근이 엄격하진 않아서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705020114,
					"content": "지금 바로 결정 안 해도 되니까, 일단 시험 삼아서 한 번 해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705020115,
					"content": "어때, 해볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루카"
				},
				{
					"id": 705020103,
					"content": "무슨 일이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
