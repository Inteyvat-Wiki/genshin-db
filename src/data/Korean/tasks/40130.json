					"nextDialogs": [
						401300632
					],
					"speakerTitle": "「텔크시」"
				},
				{
					"id": 401300632,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300633
					],
					"speakerTitle": "「텔크시」"
				},
				{
					"id": 401300633,
					"content": "사랑해요, 엄마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300634
					],
					"speakerTitle": "「텔크시」"
				},
				{
					"id": 401300634,
					"content": "이게 바로 「텔크시」가 한 말이었구나",
