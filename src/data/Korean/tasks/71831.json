					"왕평안"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "이 정도면 나쁘지 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310302,
					"content": "정말 괜찮네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "어? 마침 잘 오셨어요. 사당 수리가 방금 막 끝나서 급료를 지불하고 있었거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310304,
					"content": "휴… 돈이 이렇게 많이 들 줄 몰랐어요. 제가 번 돈이 거의 다 깨졌네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310305,
					"content": "어찌 됐든, 사당을 수리했으면 그걸로 된 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310306,
					"content": "사당에서 향을 피우실래요? 사람을 찾아서 새 향로를 만들었답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310307,
					"content": "그럴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "향 받으세요, 향로는 저쪽에 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310308,
					"content": "당신도 향을 피우셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "그건 물론이죠. 사당이 완공된 후 좋은 향을 하나 피웠어요, 지금쯤 다 탔겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "왕평안"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
