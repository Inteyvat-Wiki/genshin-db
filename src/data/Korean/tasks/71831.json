					"왕평안"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "향은 다 피우셨나요? 느낌이 어때요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310502,
					"content": "좋았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "그럼 다행이구요. 앞으로 향을 피우러 오는 사람들이 많아졌으면 좋겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310504,
					"content": "당분간 여기 있을 생각입니다. 조용해서 책을 편집하기에 좋거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310505,
					"content": "전에 수집했던 자료들을 정리해서 「호법야차」와 관련된 책을 계속 편집해야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310506,
					"content": "나중에 시간이 된다면 자주 들러주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310507,
					"content": "향을 피울 생각이라면 바로 저를 찾으시면 됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310508,
					"content": "휴, 사실 이 주변도 좀 정리하고 싶은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718310509,
					"content": "길도 수리해야 하고, 양쪽에 울타리도 세우고, 사당 옆에는 화단도 만들고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "왕평안"
				}
			]
		},
