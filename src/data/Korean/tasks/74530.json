				"points": []
			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "아, 스승님! 돌아왔네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300402,
					"content": "카치나, 기분 좋아 보이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "헤헤, 이번 발굴에서 정말 괜찮은 원석을 찾았거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300405,
					"content": "잘 다듬으면 반짝반짝 빛나는 보석이 될지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300406,
					"content": "잘됐네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "응! 방금까지는 아무런 수확도 없어서 빈손으로 돌아갈 뻔했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300408,
					"content": "하지만 스스로에게 「조금만 더 파보자, 정말 조금만 더」라고 다독였지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300409,
					"content": "몇 번이나 반복했는지 모르겠지만, 결국 이걸 찾아낸 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300410,
					"content": "밖에 나와 보니 해가 거의 지고 있었어… 하루 종일 파다 보니 시간 가는 줄도 몰랐나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300411,
					"content": "역시 카치나, 끈기가 대단해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "우와, 정말? 근데 나, 사진기 앞에 서면 쑥스러워져서… 예쁘게 찍힐지 자신이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300414,
					"content": "하지만… 스승님의 부탁이라면, 노력해볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300415,
					"content": "충분히 잘하고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "응! 알겠어. 그럼 스승님한테 맡길게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카치나"
				},
				{
					"id": 745300416,
					"content": "카치나는 지금 이대로가 좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "반짝반짝 빛나는 너를 사진으로 남겨도 될까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "무슨 좋은 일 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
}