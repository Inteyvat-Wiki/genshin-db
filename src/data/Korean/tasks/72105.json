					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050101,
					"content": "「어!」 …어? 난 하나치루사토가 갑자기 우리 뒤에서 나타날 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050102,
					"content": "그렇다면, 이게 마지막 다섯 번째 나무뿌리겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050103,
					"content": "마지막 한 곳까지 처리하면, 전처럼 하나치루사토가 「피슉!」하고 우리 뒤에 나타나서 보물을 주는 줄 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050104,
					"content": "「피슉!」 그게 뭔데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050105
					]
				},
				{
					"id": 721050105,
					"content": "그냥 「피슉!」이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050106,
					"content": "아무튼 「신성한 벚나무 대액막이」는 완성된 셈이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050107,
						721050108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050107,
					"content": "홀가분하다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050109
					]
				},
				{
					"id": 721050109,
					"content": "확실히",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050110,
					"content": "나루카미섬을 거의 다 돌아다니다가, 결국엔 바다 밑까지 내려왔네. 피곤해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050111,
						721050113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050111,
					"content": "피곤한 건 나라고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050112
					]
				},
				{
					"id": 721050112,
					"content": "야! 페이몬은 열심히 열심히 응원했다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050114,
					"content": "전에 가면 무녀가 다섯 곳의 나무뿌리를 다 정화하고 나면, 자기를 찾아오라고 했지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050115,
					"content": "#헤헤，분명히 우리에게 보상을 해줄거야. {NICKNAME}，콘다 마을 우물 아래 결계로 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050116,
					"content": "너구리 밥만 아니면 좋겠는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050113,
					"content": "알았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050114
					]
				},
				{
					"id": 721050108,
					"content": "많은 경험을 했지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050109
					]
				}
			]
		},
		{
