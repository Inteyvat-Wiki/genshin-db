				"points": []
			},
			"dialogs": [
				{
					"id": 721050201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050202
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050202,
					"content": "가면 무녀, 우리 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050203,
					"content": "너무 잘했어요. 번개의 벚나무 뿌리가 두 분의 공적을 저한테 계속 칭찬하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050204
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050204,
					"content": "당황스럽겠지만, 당신에게 고백해야 할 일이 하나 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050205
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050205,
					"content": "말해주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050206
					]
				},
				{
					"id": 721050206,
					"content": "무슨 일인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050207,
					"content": "당신이 콘다 마을에서 처음 주술 도구를 얻었을 때, 저는 당신을 「운명으로 정해진 자」라고 불렀습니다. 하지만 당시만 해도 당신의 품성과 용맹을 완전히 믿지는 않았습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050208
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050208,
					"content": "하지만 「대규모 액막이」 진전에 따라, 당신은 제가 얄팍하고 우둔했음을 증명했을 뿐만 아니라 저의 예상을 훨씬 뛰어넘는 모습을 보여주었습니다. 오죽하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050209
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050209,
					"content": "아쉬움을 금할 수 없습니다. 애초에 「호재궁」 옆에 당신 같은 사람이 있었다면, 어쩌면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050210
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050210,
					"content": "어쩌면?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050211
					]
				},
				{
					"id": 721050211,
					"content": "아니에요, 아무것도. 제가 말이 많았네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050212
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050212,
					"content": "그럼, 일도 일단락됐겠다. 보상은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050213,
						721050215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050213,
					"content": "보상?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050214
					]
				},
				{
					"id": 721050214,
					"content": "그 전에 아직 끝나지 않은 일이 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050217
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050217,
					"content": "「신성한 벚나무 대액막이」의 마지막 단계가 남았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050218
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050218,
					"content": "뭐가 이렇게 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050219,
					"content": "땅을 지키고 오염을 흡수한 대가로 불길함이 뿌리에 쌓입니다. 당신이 결계를 풀고 더러운 요물들을 처치했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050220
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050220,
					"content": "신사에 지부가 있듯이, 모든 번개의 벚나무는 요고우산 「신성한 벚나무」의 곁가지입니다. 그 다섯 개의 나무뿌리는 그중 큰 것이구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050221
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050221,
					"content": "이들이 흡수하는 오염은 사실 요고우산 깊은 곳에 있는 신성한 벚나무에 상당 부분 전해집니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050222
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050222,
					"content": "그러니까 가장 중요한 것은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050223
					]
				},
				{
					"id": 721050223,
					"content": "맞습니다. 「신성한 벚나무 대액막이」의 마지막 단계인 신성한 벚나무의 결계를 해제하는 게 가장 중요해요. 신성한 벚나무의 뿌리에 수년간 축적된 불길함을 깨끗이 제거하는 것이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050224
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050224,
					"content": "어! 신성한 벚나무는 나루카미 다이샤에 있잖아? 나루카미 다이샤에서 요괴를 때려잡으면 소동이 일어날 텐데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050225,
					"content": "하하, 걱정 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050226
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050226,
					"content": "신성한 벚나무의 뿌리는 요고우산 깊숙한 곳에 위치해 있어 나루카미 다이샤와 상당한 거리가 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050227
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050227,
					"content": "정말 괜찮은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050228,
					"content": "걱정 마시고, 저를 믿어 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050229
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050229,
					"content": "가면 무녀가 이렇게까지 말했으니 어쩔 수 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050230,
					"content": "고맙습니다. 그럼 빨리 움직이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050215,
					"content": "일이 아직 끝나지 않았죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050216
					]
				},
				{
					"id": 721050216,
					"content": "맞아요. 다섯 군데 결계를 쉽게 풀어버린 사람답네요. 구름을 뚫고 들어오는 달빛처럼 사물을 보는 안목이 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050217
					],
					"speakerTitle": "하나치루사토"
				}
			]
		},
		{
