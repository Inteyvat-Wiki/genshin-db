			"dialogs": [
				{
					"id": 721050301,
					"content": "이것이 바로 「신성한 벚나무 대액막이」의 마지막 결계입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050302
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050302,
					"content": "그럼, 두 분이 준비됐다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050303
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050303,
					"content": "잠깐! 그 전에 질문이 좀 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050304,
					"content": "물어보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050305
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050305,
					"content": "저번에 가면 무녀가 그랬잖아, 때가 되면 모든 걸 털어놓겠다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050306,
					"content": "그렇긴 합니다. 하지만 가능하면 「신성한 벚나무 대액막이」가 완료될 때까지 기다려주실 수 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050307
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050307,
					"content": "신성한 벚나무가 계속 고통받고 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050308
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050308,
					"content": "이런 말씀 드려서 굉장히 죄송해요… 두 분이 많이 도와주셨는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050309
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050309,
					"content": "정말 죄송합니다만, 양해 부탁드립니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050310,
						721050311
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050310,
					"content": "알았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050312
					]
				},
				{
					"id": 721050312,
					"content": "흥, 알았어. 약속은 지키라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050313,
					"content": "하하, 당연하죠. 두 분의 배려에 감사드립니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050314
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050314,
					"content": "그럼, 결계를 해제할게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050315
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050315,
					"content": "「…동지경연, 서달신해, 남지염광, 북달약수…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050316
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050316,
					"content": "「…천지만맥, 청제화재」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050311,
					"content": "당신을 믿어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050312
					]
				}
			]
		},
		{
			"id": 7210504,
