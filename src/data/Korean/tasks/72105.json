			},
			"dialogs": [
				{
					"id": 721050401,
					"content": "봉인은 풀렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050402
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050402,
					"content": "다음은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050403,
					"content": "이 아래는 정말 깊구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050404
					]
				},
				{
					"id": 721050404,
					"content": "다음은, 외람된 말씀이지만 제 말을 들어주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050405
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050405,
					"content": "뛰어 들어가세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050406,
						721050407
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050406,
					"content": "못, 못 하겠어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050409
					]
				},
				{
					"id": 721050409,
					"content": "이 아래쪽이 무서워 보이는데, 뛰어들면 사고 나겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050410,
					"content": "걱정하지 마세요. 신성한 벚나무 뿌리가 많이 오염됐지만, 「대규모 액막이」를 하는 사람의 기운은 알아봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050411
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050411,
					"content": "그녀는 마지막 불길함을 제거하기 위해 당신의 안전한 착지를 도와줄 거예요. 제가 보장할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050412
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050412,
					"content": "정말 괜찮은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050413,
					"content": "절 믿으세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050414
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050414,
					"content": "내려가서 뭘 해야 하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050415,
					"content": "한마디로 당신의 실력을 발휘하면 됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050416
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050416,
					"content": "축적된 사악한 기운은 요고우산 가장 깊은 곳에 거대한 「혹」으로 응결되어, 현재 신성한 벚나무 뿌리에 착 달라붙어 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050417
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050417,
					"content": "기회를 놓치지 말고 장독의 혹을 공격하세요. 불결한 혹은 공격을 받을 때 분명히 발버둥칠 거고, 심지어 요물이 번식하여 당신의 행동을 방해할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050418
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050418,
					"content": "그동안 다섯 군데의 봉인을 해제했던 것처럼 주변 기관을 움직여 신성한 벚나무 뿌리를 단단히 하는 것도 필요해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050419
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050419,
					"content": "그러면 신성한 벚나무가 당신의 행동에 맞춰 공격의 기회를 만들어 줄 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050420
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050420,
					"content": "뭔가 무시무시한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050421,
						721050422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050421,
					"content": "더 골치 아픈 것도 잡아봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050423
					]
				},
				{
					"id": 721050423,
					"content": "당신의 실력을 믿습니다. 그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050424
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050424,
					"content": "당신은 같이 갈 수 없어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050425
					]
				},
				{
					"id": 721050425,
					"content": "전투가 끝나면 아래에서 당신과 합류해 「대규모 액막이」의 마무리 작업을 하겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050426
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050426,
					"content": "정말 죄송합니다. 전에 말씀드린 대로 제 몸 상태로는 이런 일을 해낼 수 없습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050427
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050427,
					"content": "너그럽게 양해해 주시기를…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050428
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050428,
					"content": "그럼 어쩔 수 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050429
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721050429,
					"content": "그렇다면… 이제 준비되셨습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050430,
						721050432
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050430,
					"content": "준비됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050431
					]
				},
				{
					"id": 721050431,
					"content": "그럼 앞으로 나아가서 「신성한 벚나무 대액막이」 최후의 단계를 진행하십시오…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050434
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050434,
					"content": "어쨌든 정화와 관련해서 궁금한 것이 있으면 언제든지 물어보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050435
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050435,
					"content": "그럼… 이게 마지막입니다. 행운을 빌어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050432,
					"content": "아직이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050433
					]
				},
				{
					"id": 721050433,
					"content": "그렇군요… 어쨌든 이곳의 사악한 기운의 결계는 해제되었으니, 가능하면 빨리 해결해주시길 바랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050434
					],
					"speakerTitle": "하나치루사토"
				},
				{
					"id": 721050422,
					"content": "무서운데!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050423
					]
				},
				{
					"id": 721050407,
					"content": "페, 페이몬은 날 수…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050408
					]
				},
				{
					"id": 721050408,
					"content": "야! 무슨 소리 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050409
					],
					"speakerTitle": "페이몬"
				}
			]
		},
