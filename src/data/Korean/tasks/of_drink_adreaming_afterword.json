			"dialogs": [
				{
					"id": 705100401,
					"content": "이야… 요 며칠 술집에 손님이 끊이질 않더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705100402,
					"content": "술 마시러 온 사람도 있지만, 대부분 널 보러 온 손님이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705100403,
					"content": "그 말… 뭔가 좀 이상한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705100404,
					"content": "이렇게 성공적인 「바텐더 체험 주간」 행사는 처음이야. 장사도 잘되고, 입소문도 제대로 났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705100405,
					"content": "아무튼… 잘했어, 친구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705100406,
					"content": "고작 요 며칠로 친구가 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705100407,
					"content": "어떤 의미에서는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "혹시 남아서 계속 일할 생각 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705100410,
					"content": "안 돼. 음료를 무제한으로 마실 수 있는 건 엄청난 유혹이지만, 얘랑 여행하기로 약속했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705100411,
					"content": "알았어. 강요하지 않을게. 찰스 씨도 그 얘기 하셨어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705100412,
					"content": "아무튼 기회 되면, 「천사의 몫」에 자주 와줘! 친구들도 데려오고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "루카"
				},
				{
					"id": 705100413,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "그럼 안녕, 행운을 빌게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루카"
				},
				{
					"id": 705100408,
					"content": "그 말도 맞지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
	]
}