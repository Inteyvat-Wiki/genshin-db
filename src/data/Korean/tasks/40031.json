			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"캐서린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "여행자, 마침 잘 왔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 400310102,
					"content": "이 익숙한 시작…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310103,
					"content": "그럼 다음 대사는 분명…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "역시 숙련된 모험가답네. 마침 너한테 딱 맞는 의뢰가 들어왔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 400310106,
					"content": "만능 산고 탐정소에서 「동물 집단 실종 사건」을 조사해 달라는 의뢰가 들어왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 400310107,
					"content": "엥? 우리한테 동물을 찾으라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310108,
					"content": "#흥, 이런 간단한 일에 {NICKNAME}(이)가 나서야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310109,
					"content": "괜찮아, 난 배달도 해봤어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "게다가 「만능 산고」는 사건을 직접 해결하는 탐정소 아니야? 왜 모험가한테 사건을 의뢰하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310114,
					"content": "류지 씨와 함께 발로 뛰어줄 경험 많은 모험가가 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 400310115,
					"content": "그리고, 어디 보자… 산고 씨가 의뢰를 맡기면서 이런 말을 남겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 400310116,
					"content": "「이번 사건에서 수많은 의뢰인의 반려동물이 실종되어 모험가 길드에 의뢰를 맡기게 됐습니다. 사건만 해결된다면 두둑한 보수를 약속드립니다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 400310117,
					"content": "#두둑한 보수…! 으음, 그렇구나. {NICKNAME}, 주인의 곁으로 돌아갈 수 없는 동물들이 불쌍하지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310118,
					"content": "게다가 의뢰가 크든 작든 성장에 도움이 되잖아, 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310119,
					"content": "페이몬은 정말 단순해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "아무튼, 산고를 찾아가 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310110,
					"content": "괜찮아, 난 차도 수리해 봤어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "괜찮아, 난 풍마룡도 쓰러트려 봤어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "풍마룡 처치가 「간단한 일」이야…? 정말 대단하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 400310104,
					"content": "맡길 의뢰가 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"산고",
					"류지"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "나쁘지 않네. 생각보다 훨씬 빨리 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310203,
					"content": "당연하지! 두둑한 보… 보고, 동물이 실종됐다는 보고를 듣자마자 바로 달려왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310204,
					"content": "#말해봐, 어떻게 된 일이야? 나와 {NICKNAME}만 있으면 뭐든 해결할 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310205,
					"content": "일하는 건 난데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "페이몬이 곁에서 열심히 응원할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310207,
					"content": "활력이 넘치네. 그럼 설명부터 할게. 최근 실종된 동물을 찾아달라는 의뢰가 급증했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310208,
					"content": "이 동물들은 대부분 집에서 길러서 보통 멀리 가지 않는 게 정상이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310209,
					"content": "이나즈마에 괴력난신(怪力亂神)에 대한 이야기가 있긴 하지만 모든 일에는 원인과 결과가 있고, 논리로 풀리지 않는 수수께끼는 없어. 며칠간 우리가 한 현장 조사도 이를 뒷받침하고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310210,
					"content": "일하는 건 전데요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310211,
					"content": "페이몬이 곁에서 류지 씨를 응원할 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "어라?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310213,
					"content": "…고맙지만 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310214,
					"content": "요 며칠 실종된 동물의 흔적을 따라 야외의 야영지를 몇 개 찾았어. 마물이 지키는 것도 있었지만 별로 큰 문제는 아니었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310215,
					"content": "그런데 야영지 중 한 곳에서, 갇혀 있는 동물을 풀어주려고 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310216,
					"content": "…「갑자기 나타난 검은 그림자한테 당해서 기절해버렸어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310217,
					"content": "일어나 보니 야영지에는 아무것도 남아있지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310218,
					"content": "창피하네요, 류지 씨. 「삼본도 킨파치」 사건에서 전설의 악귀 토라치요처럼 포효하며 범인을 쓰러뜨리던 기세는 어디로 간 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310219,
					"content": "그때 죽은 척하는 저를 안고, 큰 소리로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310220,
					"content": "사장님, 그만! 그만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310221,
					"content": "다, 다음은 어떻게 됐는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310222,
					"content": "우선 눈앞의 사건부터 해결하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "아무튼 동물을 구출하려면 너희 둘처럼 경험 많은 모험가가 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310228,
					"content": "너희들이 있으면 류지 씨가 기절해도 어느 정도 백업해 줄 수 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310229,
					"content": "그런데 산고는 왜 직접 나서지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310230,
					"content": "나? 난 두뇌파라서 머리를 쓰는 게 더 중요해. 나에게 몸은 그저 장식이랄까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310231,
					"content": "(와우, 게으른데 당당하기까지 하네)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310232,
					"content": "걱정 마, 난 악덕 의뢰인이 아니라고. 보수는 톡톡히 챙겨줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310233,
					"content": "보수!! 지금 당장 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310234,
					"content": "페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "잠깐. 가기 전에, 이걸 가지고 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310237,
					"content": "어? 이게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310238,
					"content": "<color=#00E1FFFF>「사방의 그물」</color>이라고 하는 건데, 친구에게 부탁해서 책에 기록되어 있는 「카무나 음양술」로 만든 간편 아이템이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310239,
					"content": "범인을 제압하기에는 역부족이지만, 정확하게 조준한다면 동물을 잡는덴 문제없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310240,
					"content": "이것만 있으면 실종된 동물을 쉽게 되찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310241,
					"content": "와, 이게 있으면 훨씬 수월하겠네! 산고 사장, 사랑해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310242,
					"content": "그렇게 칭찬하지 않아도 돼. 그저 의뢰를 망치면 안 되니까 도움이 되라고 주는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310243,
					"content": "그리고 류지 씨도 함께 가줘요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310244,
					"content": "네, 산고 사장님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310245,
					"content": "최근에 동물의 흔적을 또 발견했어. 날 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310246,
					"content": "그럼 출발하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "그래, 조심해서 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "산고"
				},
				{
					"id": 400310247,
					"content": "산고 사장님, 고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "페이몬은 행동력이 참 강해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "다음 이야기가 궁금하네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "어머, 그 사건에 관심 있는 거야? 얘기하자면 길어. 평소 상냥하던 도신 킨파치, 그가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400310225,
					"content": "일, 일단 눈앞의 사건부터 해결해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310226,
					"content": "맞아. 실례했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "산고"
				}
			]
		},
