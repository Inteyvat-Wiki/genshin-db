			"dialogs": [
				{
					"id": 400310801,
					"content": "도와줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310802
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310802,
					"content": "#내가 말했지! {NICKNAME}(은)는 대단하다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310803,
					"content": "빨리 봐봐, 동물 수량은 맞아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310804,
					"content": "음… 아직 부족해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310805
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310805,
					"content": "어떻게 된 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400310806,
					"content": "그래도 소득은 있어. 적어도 이번에는 「검은 그림자」의 방해를 받지 않고 많은 동물을 찾았으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310807
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310807,
					"content": "조사에는 진전이 있는데 아쉽게도 다른 단서가 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310808
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310808,
					"content": "이렇게 하자, 난 계속 조사하고 있을게. 두 사람은 먼저 다른 일 하러 가봐. 내일 만능 산고 탐정소에서 만나자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310809
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400310809,
					"content": "알았어, 어쩔 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
