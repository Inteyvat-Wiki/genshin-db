							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "우리 왔어! 이것 좀 봐봐, 혹시 이게 네가 말한 「진귀한 물건」이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 701110202,
					"content": "오, 이 은혜를 어찌 다 갚아야 할지! 정말 감사하오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "소가 스미다류 사콘 시게히라"
				},
				{
					"id": 701110203,
					"content": "그렇다면 지체할 것 없이, 봉인을 풀어보겠소——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "소가 스미다류 사콘 시게히라"
				},
				{
					"id": 701110204,
					"content": "이, 이건…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "소가 스미다류 사콘 시게히라"
				},
				{
					"id": 701110205,
					"content": "으악! 이거 곧 터지는 거 아니야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 701110206,
					"content": "우황의 님께서 나를 해칠 리는 없소… 설마 수호자가 「폭탄」으로 개조한 건가?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "소가 스미다류 사콘 시게히라"
				},
				{
					"id": 701110207,
					"content": "이런 굴욕을 당하다니! 하지만 「폭탄」 해제법을 모르니… 던질 수밖에!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "소가 스미다류 사콘 시게히라"
				},
				{
					"id": 701110208,
					"content": "그래도 걱정 마시오! 「휘페르보레아」에서 오신 분이 「폭탄」 던지는 법을 알려주셨소!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "소가 스미다류 사콘 시게히라"
				},
				{
					"id": 701110209,
					"content": "「그대는 셋까지 세어야 한다. 많아서도 적어서도 아니 되느니라. 넷은 아니 되고, 둘도 아니 되며, 다섯은 지나치다. 그대가 세는 수가 셋이 되었을 때——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "소가 스미다류 사콘 시게히라"
				},
				{
					"id": 701110210,
					"content": "말이 너무 많아! 빨리 안 던지면 진짜 터진다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
