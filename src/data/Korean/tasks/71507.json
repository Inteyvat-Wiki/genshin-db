			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"호세이니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715070101,
					"content": "효과가 생각보다 더 좋은걸? 모든 현상과 데이터가 낱낱이 기록되었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070102,
					"content": "무엇보다 여기 검은 진흙이 완전히 제거되었다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070103,
					"content": "다만, 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070104,
					"content": "왜 시무룩한 얼굴이야? 광구가 깨끗이 정리된 게 좋은 일 아니었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715070105,
					"content": "글쎄… 나와 헤디브는 검은 진흙이 분출되는 지맥 출구가 광구에 있을 거라고 판단했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070106,
					"content": "지맥 출구가 이렇게 쉽게 정리될 리가 없잖아. 그렇다면 지맥 출구가 사실 다른 곳에 있다는 소린데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070107,
					"content": "이번에 검은 진흙 범람의 영향을 받은 구역은 이 광구를 제외하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070108,
					"content": "전방 갱도!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "그래… 검은 진흙을 뿜어내는 지맥 출구가 갱도 구역에 있다고 판단할 수 있겠어. 갱도는 여기보다 더 좁기에 검은 진흙이 쉽게 쌓이고 몬스터를 더 많이 불러와서 심각한 문제를 초래할 수 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070110,
					"content": "하지만 나는 「푸르시나 볼트」를 믿어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070111,
					"content": "왜냐하면… 이건 푸르시나 선배님이 만드신 굉장히 위대한 장치이기 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715070112,
					"content": "그나저나, 장치를 먼저 좀 수리해야겠어. 그리고 약속한 광부들이 내려오면 볼트를 갱도 안으로 옮기면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호세이니"
				}
			]
		}
	]
}