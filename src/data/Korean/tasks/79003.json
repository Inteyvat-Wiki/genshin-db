				},
				{
					"id": 790030320,
					"content": "또 마물과 마주칠 수도 있어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790030321
					]
				},
				{
					"id": 790030321,
					"content": "여긴 바다니까 그럴 일 없어. 기껏해야 물고기 정도겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790030322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790030314,
					"content": "어쩌면 운 좋게 재난을 면했는지도 몰라",
