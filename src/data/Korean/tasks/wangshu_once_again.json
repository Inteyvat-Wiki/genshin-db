			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베르 고데트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "역시 매년 축제 기간에는 무척 바쁘네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718200202,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "객잔 일 때문에 그렇지. 해등절을 지내러 온 사람들이 많아서 일손이 너무 부족해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718200204,
					"content": "손님 응대하랴, 객잔 꾸미랴 정신 없어. 축제에 필요한 것들도 준비해야 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718200205,
					"content": "늘상 하던 일들도 해야 해…. 언소가 바빠 죽으려고 하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718200206,
					"content": "여행자, 괜찮다면 네가 언소 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718200207,
					"content": "제게 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "그럼 좀 부탁할게. 언소는 주방에 있으니까 그리 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718200209,
					"content": "난 처리해야 할 일이 있어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르 고데트"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"언소"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "누구야! 여긴 함부로 들어오면… 아, 너구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718200302,
					"content": "무슨 일 있어? 음식을 주문하려면 좀 기다려야 해. 지금 많이 바쁘거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718200303,
					"content": "도와드리러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "도와주러 왔다고? 아… 마침 잘됐다. 일이 많이 밀려있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718200306,
					"content": "일단 객잔 밑에 가서 방금 배송된 요리용 재료들을 좀 가져다줘. 급히 써야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718200307,
					"content": "그리고 내려가는 김에 이 소등을 객잔 문 앞의 커다란 나무 두 곳에 걸어줘…. 사장님이 소등을 걸라고 한참 잔소리하셨어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				},
				{
					"id": 718200304,
					"content": "제가 뭐 도와드릴 거 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"언소"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "어때, 일은 다 끝났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718201502,
					"content": "다 끝났어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "진짜 고마워. 난 손님들이 너무 오래 기다리기 전에 어서 이 요리들을 끝내야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베르 고데트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "왔구나. 언소는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718201602,
					"content": "이제 한숨 돌리실 수 있을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "그럼 다행이고, 정말 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718201604,
					"content": "여기에도 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201605,
					"content": "어, 망아 씨?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "여행자? 여기서 다 만나다니 이런 우연이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201608,
					"content": "소등 전달…? 그런 셈이지. 혹시 경책 산장 아니? 거긴 성에서 아주 멀고 대부분 노인과 아이들이 살고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201609,
					"content": "그래서 매년 해등절이 되면 총무부는 그쪽에도 축제에 필요한 것들을 보내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201610,
					"content": "첫 번째 물자는 벌써 보냈는데, 경책 산장의 축제 분위기를 띄울 만한 게 더 없는지 생각 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201611,
					"content": "그래서 시인 청주 씨에게 부탁했어. 그는 소등 퀴즈를 준비해서 경책 산장의 아이들과 놀아주겠다고 약속했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201612,
					"content": "청주…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "그 시인이라면 문제 없겠지? 그리고 백환자 씨를 찾아갈 생각이었어. 그의 글씨는 정말 일품이거든. 그가 경책 산장 노인분들의 소등에 소원을 써준다면 참 좋을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201615,
					"content": "근데 아무리 찾아도 백환자 씨를 못 찾겠더라고. 그가 시의 소재를 찾으러 적화주에 갔다는데 거길 가볼까 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201616,
					"content": "사장님이 알고 계실지도 몰라요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "백환자 씨? 음… 최근에 객잔에 한 번 다녀가긴 했어. 근처에서 현지 풍습 같은 소재를 수집한다고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718201619,
					"content": "근데 거긴 마물이 많은 곳이라서 그가 아직도 있을지는 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718201620,
					"content": "그랬군요… 근데 전 청주 씨와 좀 이따 망서 객잔에서 만나기로 약속했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201621,
					"content": "여행자, 네가 백환자 씨를 찾아줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201622,
					"content": "제게 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "그럼 부탁할게. 난 여기서 청주 씨를 기다려야 해. 그에게 부탁할 일이 좀 있어서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "망아"
				},
				{
					"id": 718201624,
					"content": "으아… 할 일이 너무 많아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "망아"
				},
				{
					"id": 718201617,
					"content": "사장님, 백환자 씨에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(엇, 베르메르 씨와 약속한 그 시인이잖아…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "「소등을 전달하러」 오셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182019",
							"2"
						],
						"stepId": 7182019,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"백환자"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "고마워. 휴… 내가 너무 부주의했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201902,
					"content": "여기서 뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "난 소재를 얻으러 왔어. 지금 해등절이잖아? 글씨를 적어서 주변 친구들한테 선물해주려고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201904,
					"content": "원래 여길 돌아다니면서 소재도 얻고, 특별한 먹물을 만들 생각이었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201905,
					"content": "마물들과 마주쳤지 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201906,
					"content": "망아 씨의 부탁에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "경책 산장에 가서 글씨를 써달라고… 알겠어, 그 일은 나한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201908,
					"content": "경책 산장이라…어르신들이 많았던 것 같은데, 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201909,
					"content": "이렇게 하자, 네가 콜 라피스 1개, 청심 1송이를 가져다주면 가서 먹물을 만들게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201910,
					"content": "그것들로… 먹물을 만든다고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "하하하, 모르는구나? 먹물에 콜 라피스 가루를 넣으면 쓸 때 은은한 금빛이 돌아. 행운을 가져다주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201912,
					"content": "청심 즙을 넣으면 먹물에 향긋한 향이 가미돼서 먹물을 다 만들고 보면 두 가지 냄새가 잘 어우러져 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201913,
					"content": "뭐, 뭔가 엄청난데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "하하, 이건 아무것도 아니야. 진짜 제대로 만들면 이것보다 훨씬 복잡할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201916,
					"content": "이번엔 최대한 간소화했어. 다 모으면 나한테 가져다줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201917,
					"content": "에휴…난 좀 쉬어야겠어. 아까 너무 힘들었나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "백환자"
				},
				{
					"id": 718201914,
					"content": "엄청 복잡하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
