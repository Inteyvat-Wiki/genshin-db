			"dialogs": [
				{
					"id": 100060101,
					"content": "안녕, 두린. 여기 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100060102,
					"content": "#{NICKNAME}(이)랑 페이몬! 여긴 어쩐 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060103,
					"content": "헤헤, 밖에 날씨가 얼마나 좋은데, 왜 여기서 혼자 책을 읽고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100060104,
					"content": "그게… 몬드에 있으면서 「사회생활」을 할 기회가 많아졌는데, 내가 사람들의 농담을 못 알아듣고 진지하게 받아들이는 경우가 많더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060105,
					"content": "예를 들어 저번에는 꽃집에 엄청 예쁜 꽃이 있길래 주인한테 말했더니, 그 사람이 이러는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060106,
					"content": "「이 잡초가 마음에 들면, 민트랑 달콤달콤꽃을 함께 꽂아서 꽃다발로 만드시죠」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060107,
					"content": "그래서 주인이 말한 대로 꽃다발을 만들어서 보여줬더니, 엄청 이상한 표정을 짓더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060108,
					"content": "두린의 안목은 참 독특하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "나중에 알베도가 말해줬는데, 내가 사람들 「말속에 숨은 뜻」을 이해하지 못해서 그런 거래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060111,
					"content": "몬드의 문자를 배우고 나서, 이곳에 있는 책을 많이 읽어보라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060112,
					"content": "난 이야기책에서 탄생했으니까, 책들 속에서 이 세상의 「규칙」을 배울 수 있을 거래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060113,
					"content": "근데 나도 모르게 지금까지 봐버렸네…. 참, 그래서 나한테 무슨 볼일 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060114,
					"content": "친구끼리 자주 봐야지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "그렇구나, 이것도 「규칙」인가 보네. 또 하나 배웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060116,
					"content": "그것도 틀린 얘기는 아닌데, 너한테 할 얘기가 있어서 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100060118,
					"content": "그게, 사실 너한테 라인도티르의 「말」을 전해주러 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100060119,
					"content": "그래…? 라인도티르 이모가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060120,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "응, 조금 놀란 것 뿐이야…. 라인도티르 이모는 엄마의 친구지만, 동시에 이 세계에 존재했던 「마룡」의 어머니이기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060123,
					"content": "그리고 난 그 마룡의 것이었던 운명을 대신하게 되었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060124,
					"content": "그래서 만약 그분이 날 싫어한다면… 어떻게 해야 할지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060125,
					"content": "그렇게 인색하진 않을 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "응응! 두린, 걱정하지 마. 별로 나쁜 일은 아닐 거야. 그리고 우리도 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100060128,
					"content": "너희가 그렇게 말해주니까 마음이 놓여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "두린"
				},
				{
					"id": 100060129,
					"content": "그럼, 한번 열어볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두린"
				},
				{
					"id": 100060126,
					"content": "우리가 있잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "긴장 풀어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "마녀 일로 왔어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "그 주인의 문제 아닌가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
