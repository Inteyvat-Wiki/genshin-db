			"dialogs": [
				{
					"id": 413310301,
					"content": "아직 필요한 게 많네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310302
					],
					"speakerTitle": "소백"
				},
				{
					"id": 413310302,
					"content": "저도 도울게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310303
					]
				},
				{
					"id": 413310303,
					"content": "어? 아… 그럼 정말 고맙죠. 마침 식자재를 어떻게 구해야 할지 고민이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310304
					],
					"speakerTitle": "소백"
				},
				{
					"id": 413310304,
					"content": "어디 보자… 짐승고기 3개랑 새고기 3개가 필요해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310305
					],
					"speakerTitle": "소백"
				},
				{
					"id": 413310305,
					"content": "나머지는 제가 마련해볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소백"
				}
			]
		},
