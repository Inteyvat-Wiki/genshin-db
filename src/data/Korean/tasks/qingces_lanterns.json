			"trigger": {
				"objectNames": [
					"약심"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "또 해등절이 됐구먼, 에휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310202,
					"content": "걱정거리라도 있으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "이제 해등절이잖니. 원래대로라면 떠들썩했겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310204,
					"content": "이 경책 산장엔… 우리 노인네들과 아이들뿐이니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310205,
					"content": "시내로 일하러 간 자식애들은 일이 너무 바빠서 휴가도 못 내고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310206,
					"content": "아니면 너무 멀어서 못 온다고 하더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310207,
					"content": "온 가족이 다 같이 모여야 하는 날인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310208,
					"content": "물론 애들이 힘들다는 것도 알지. 그래도 이 좋은 날에, 에휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310209,
					"content": "됐다, 그만하마. 이 좋은 날에 이러면 안 되지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310210,
					"content": "참, 혹시 괜찮으면 가서 소백 좀 도와주지 않겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310211,
					"content": "그 애가 마을 사람들을 위해 음식을 차려준다고 했거든. 혼자 잘하고 있나 걱정돼서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "약심"
				},
				{
					"id": 413310212,
					"content": "맡겨 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "정말 고맙네. 그럼 부탁해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "약심"
				},
				{
					"id": 413310213,
					"content": "도우러 갈 테니 걱정 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
