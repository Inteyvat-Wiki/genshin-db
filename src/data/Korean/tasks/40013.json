			"dialogs": [
				{
					"id": 400130101,
					"content": "클레——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400130102,
					"content": "비늘 잘 놨어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "잘했어! 헤헤헤, 그럼 다음은 클레 차례 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130104,
					"content": "응! 저기 저 장치는 클레한테 맡길게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400130105,
					"content": "좋아——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130106,
					"content": "클레!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130108,
					"content": "조심해야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "응, 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130111,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130112,
					"content": "클레, 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400130113,
					"content": "클레는… 걱정돼…. 이 안에 진짜 도도 대마왕이 있으면 어쩌지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130114,
					"content": "도도 대마왕이 클레가 도도코의 가족이 되는 걸 인정 안 해주거나, 호, 혹시라도 클레가 진다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130115,
					"content": "그럼 도도코는 클레랑 함께할 수 없어. 엄마도 슬퍼할 거야…. 도도코는 엄마가 클레한테 준 소중한 친구인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130116,
					"content": "그래서… 못 누르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130117,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400130118,
					"content": "#아! 명예 기사 {F#언니}{M#오빠}, 이거 좀 눌러주면 안 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130119,
					"content": "클레, 난 눌러줄 수 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130121,
					"content": "난 무기를 꼭 쥐어야 하거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "그래야 클레를 지켜주지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "그래, 클레. 모두 너와 함께하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "진"
				},
				{
					"id": 400130124,
					"content": "여럿이 모일수록 힘이 된다는 게 바로 이런 거지!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400130125,
					"content": "적이 누구든 우리가 있는데 뭐가 걱정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400130126,
					"content": "나도 마침 이 섬의 적이 얼마나 강한지 알고 싶었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 400130127,
					"content": "가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400130128,
					"content": "준비됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400130129,
					"content": "여러분, 그런 말 마세요…. 도도 대마왕은 그냥 클레와 대화하려는 걸지도 모르잖아요? 아니면… 아! 이미 클레를 인정했을지도 몰라요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400130130,
					"content": "클레를 인정해 줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130131,
					"content": "안 해줄 이유 있어? 클레는 지금까지 잘 해왔잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400130132,
					"content": "진짜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130133,
					"content": "클레는 착한 아이니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "…응!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130136,
					"content": "그럼 클레 간다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400130137,
					"content": "장치 따위… 눌러 버려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클레"
				},
				{
					"id": 400130134,
					"content": "인정해 줄 거야. 장담해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "우리 모두 클레 옆에 있을 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				}
			]
		},
