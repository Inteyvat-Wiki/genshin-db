			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아사기리"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "콜록, 콜록… 이러면… 안 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830102,
					"content": "더 미루다간 이번 호 원고를 제출하지 못하게 될 거야… 흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830103,
					"content": "안녕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "네?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830106,
					"content": "죄송해요! 죄송해요! 오늘 꼭 제출할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830107,
					"content": "우앗! 잠시만, 우린…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726830108,
					"content": "모리코 님! 저기…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830109,
					"content": "응? 모리코 님이 아니네… 다행이다… 콜록! 콜록…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830110,
					"content": "모리코 님은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "모리코 님은 제 편집자예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830112,
					"content": "전 아사기리예요… 음… 「프리랜서 일러스트레이터」라고 할 수 있죠. 모리코 님은… 제 담당 편집자예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830113,
					"content": "일러스트? 그게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726830114,
					"content": "「야에 출판사」의 라이트 노벨 읽어본 적 있으시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830115,
					"content": "가끔 보면 글 대신 그림이 그려진 페이지들이 있잖아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830116,
					"content": "이런 라이트 노벨에 삽입되는 그림이 「일러스트」예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830117,
					"content": "글 속에 중요한 장면이나 스토리가 등장하거나 저자가 캐릭터의 이미지를 드러내려 할 때 일러스트를 선택하기도 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830118,
					"content": "그러면 독자들이 이해하기 편하고, 라이트 노벨의 내용도 더 풍부해져요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830119,
					"content": "아… 그렇구나. 라이트 노벨은 정말 복잡하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726830120,
					"content": "제가 책 추천해드릴게요! 예를 들면… 콜록! 콜록… 콜록…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830121,
					"content": "괜찮아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "괜찮아요. 몸이 좀 안 좋아서요. 일러스트를 그리다 보면 밤샘은 기본이고 식사를 거르기도 하거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830123,
					"content": "콜록… 그러다 보니 몸이 점점 나빠졌어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830124,
					"content": "몸도 안 좋은데 집 가서 그리지 왜 계속 여기서 그리는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726830125,
					"content": "소재를 찾기 위해 이리로 왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830126,
					"content": "요즘 통 영감이 떠오르지 않아요. 벌써 여러 번 마감일을 넘겼어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830127,
					"content": "모리코 님이 기한을 여러 차례 연기해 주셨어요. 또 제출하지 않으면 화내실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830128,
					"content": "밖에 나가면 영감을 얻을 수 있지 않을까 해서 집을 나선 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830129,
					"content": "하하… 보시다시피 얼마 못 가서 지치네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830130,
					"content": "휴, 모험가 길드로 가서 「사진기」가 있는 모험가에게 의뢰를 맡겨봐야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830131,
					"content": "엥? 「사진기」라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726830132,
					"content": "나한테 있긴 한데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "네?! 사진기를 갖고 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830135,
					"content": "모, 모험가에게 「사진기」로 사진 좀 찍어달라고 하려고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830136,
					"content": "밖에 재미있는 곳이 많대요! 몬드 근처의 높은 설산이라든가, 리월의 기둥이 많은 곳이든가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830137,
					"content": "그리고 또! 리월에 「절운간」이라는 곳이 있는데 거기에 선인이 산대요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830138,
					"content": "선인이 사는 곳… 생각만 해도 설레요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830139,
					"content": "건강 문제로 직접 여행을 할 수는 없지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830140,
					"content": "만약 「사진기」로 그곳의 풍경을 기록해준다면… 분명… 콜록! 콜록콜록…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830141,
					"content": "앗! 진정해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726830142,
					"content": "제게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "정말요!? 잘됐다! 보, 보고 싶은 곳이 많거든요. 잠시만요, 보여줄게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830145,
					"content": "참, 보수는 걱정하지 마세요. 통장이 꽤 두둑하니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830146,
					"content": "내 노트 어디 갔지? 노트, 노트…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아사기리"
				},
				{
					"id": 726830143,
					"content": "방법을 생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "근데 「사진기」로 뭘 할 수 있죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "저기…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}