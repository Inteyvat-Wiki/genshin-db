			"dialogs": [
				{
					"id": 726820201,
					"content": "도착했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820202
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820202,
					"content": "이 수상한 문만 통과하면 결투장으로 갈 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820203,
						726820204
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820203,
					"content": "흥분되는군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				},
				{
					"id": 726820205,
					"content": "이번 규칙도 저번과 비슷해. 세계 각지에 모인 싸움에 굶주린 마물, 모험가, 전사들이 스테이지에서 무예를 겨루지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820206
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820206,
					"content": "예전처럼 뜻이 맞는 동료, 전우와 함께 참가해도 돼. 「백 명」이니까 사람이 많으면 많을수록 좋겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820207
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820207,
					"content": "자네의 활약을 기대하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820208
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820208,
					"content": "당신은 참가하지 않나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820209
					]
				},
				{
					"id": 726820209,
					"content": "나? 옆에서 응원하면서 구경만 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820210
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820210,
					"content": "내 목적은 최고의 격투 소설을 쓰는 거지 너처럼 훌륭한 전사가 되는 게 아니거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820211
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820211,
					"content": "네가 엄청 뛰어난 활약을 할 것 같은 예감이 들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820212,
						726820213
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820212,
					"content": "최선을 다하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820214,
					"content": "그래. 이번에도 너의 눈부신 활약을 기대할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820213,
					"content": "기대하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820204,
					"content": "어렵네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				}
			]
		}
	]
