				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "안녕! 거기 금발의 이방인…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820102,
					"content": "또 만났네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "음… 어디서 많이 본듯한 금발인데… 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820105,
					"content": "아하! 저번에 「백 명의 봉기」에서 대단한 활약을 했던 「황금 돌풍」, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820106,
					"content": "황, 황금 돌풍이요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "저번 난투 때 구석에서 가장 뛰어난 참가자들의 모습을 소재로 쓰려고 관찰하고 있었거든. 그때 넌 마치 풀을 베는 황금빛 돌풍처럼 적을 무찌르고 다녔었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820108,
					"content": "오글거리는 소리는 됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "최근에 또 어떤 호사가가 「백 명의 봉기」를 주최했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820114,
					"content": "「백 명의 봉기」가 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "통쾌한 전투를 통해 경축하거나 불운을 없애는 난투 대회지. 무인이든 마물이든, 신분을 불문하고 순수하게 전투를 즐길 수 있는 축제야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820116,
					"content": "그중에서 특출난 사람은 각종 보물도 얻을 수 있다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820117,
					"content": "주최자, 후원자가 어떤 사람인지는 아직도 미스터리이지만 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820119,
					"content": "여긴 사람이 많으니 조용한 곳으로 가서 얘기하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820118,
					"content": "그렇군요, 알겠습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "…그래서요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "크흠… 「검호처럼 동체 시력이 뛰어난 관객이라면 이미 눈치챘을 테지만, 이 금발의 이방인이 사용하고 있는 기술은 바로 고무술(古武術)에서도 금기시되던 『고우랑가 소용돌이』였다…!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820111,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "이건 네가 싸우는 모습을 보고 영감을 받아서, 쓴 문장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726820103,
					"content": "무슨 의뢰 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
