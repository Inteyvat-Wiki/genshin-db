							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "어머, 헤르타는 바빠서 돌아간 것 같고, 글렌피디아도 안 보이네…. 귀염둥이가 음료 가게를 완전히 접수한 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480102,
					"content": "네, 맞습니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "좋아~ 그럼 안심하고 주문할 수 있겠네…. 보급 소대의 기묘한 특제 음료를 마시면 잠이 너무 안 와서, 밤새 근무할 수밖에 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480105,
					"content": "이제 밤샘 근무는 안 하시죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "맞아, 지금의 나는 그냥 한가한 도서 관리인일 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480108,
					"content": "책을 연체하는 사람이 줄어들면 나도 받아내러 돌아다니지 않아도 될 텐데. 그럼 귀염둥이랑도 더 얘기하고, 음료도 더 맛볼 수 있을 거 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480109,
					"content": "오늘은 뭐로 드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "글쎄… 특별히 선호하는 레시피는 없어. 기운 나고 기분 좋아질 만한 걸로 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480112,
					"content": "편안하고 여유롭게 잠들 수 있다면 더할 나위 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480113,
					"content": "(가게에는 클래식한 레시피가 많으니, 우선 그중에서 하나를 골라보자…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "(리사 씨의 기운을 나게 하려면, 「아침 눈꽃」이 좋은 선택일 것 같다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "특별히 원하시는 맛이 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "요즘은 그렇게까지 바쁘진 않죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "명예 바텐더가 주문 도와드릴게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
			"completionStepIds": [
				7054806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7054806",
							"2"
						],
						"stepId": 7054806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리사"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "여기 「아침 눈꽃」이에요. 드셔보세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "정말 좋네, 귀염둥이~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480203,
					"content": "산미는 적당하고, 달콤하지만 느끼하지 않아. 부드럽게 넘어가면서도, 산뜻한 여운이 남네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480204,
					"content": "근데, 이걸 마시고 나니까, 왠지 정신이 더 맑아진 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480205,
					"content": "어쩌면 너도 모르게 글렌피디아의 비법을 알아내서, 더 강력한 각성 음료를 만들어낸 건 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480206,
					"content": "음료 성분을 조금 조정해 볼까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "괜찮아, 급할 거 없어~ 눈에 호기심이 가득한 걸 보니, 나한테 물을 게 많나 보구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480209,
					"content": "얘기하면서 천천히 생각해. 곧 영감이 떠오를 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480210,
					"content": "오늘은 어떤 책들을 회수하셨어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "좀 골치 아프면서도 웃음이 나오는 질문이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480212,
					"content": "폰타인에서 돌아와 고트 호텔에 부임한 요리사 한 명이, 가장 귀중한 《몬드 천년 디저트 전집》을 빌려 갔었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480213,
					"content": "디저트를 만드는 방식으로 각종 고기 요리를 개선해서, 느끼함을 줄이겠다나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480214,
					"content": "단맛이 나는 고기인가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "맞아, 결국 캐러멜 시럽을 너무 많이 넣어서, 향긋해야 할 고기가 아찔할 정도로 달달해졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480217,
					"content": "캐러멜 시럽은 착한 아이야. 어떤 음료에 넣어도 반감을 사지 않지. 나도 가끔 애프터눈 티에 한 스푼 넣어 마시곤 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480218,
					"content": "하지만 요리를 개량할 때, 창의적이라고 다 좋은 건 아닌가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480219,
					"content": "노트도 가져오셨네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "아, 이건 또 다른 업무의 결과물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480221,
					"content": "——곧 원정대의 많은 대원들이 몬드로 돌아올 텐데, 오랫동안 외지에서 지내다 보니 입맛이 바뀌었을 수도 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480222,
					"content": "그래서 진이 새로운 식자재를 수입해 기사들의 입맛을 맞출 수 있도록, 가정집 열몇 곳을 방문해서 몇 가지 설문조사를 해달라고 부탁했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480223,
					"content": "꼼꼼한 계획이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "응. 그들은 몬드를 위해 시간과 노고를 바쳤으니까, 우리도 그만한 존중과 배려로 보답해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480226,
					"content": "조사 결과, 가장 많이 언급된 식자재는 나타의 카카오와, 이 특이한 식물로 만든 코코아였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480227,
					"content": "기사들도 코코아를 마셔서 정신력을 유지한다고 편지에 적은 사람이 많았고. 나도 따뜻한 코코아를 마셔봤는데, 각성 효과가 커피 못지않았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480228,
					"content": "최근에 다른 곳도 가보셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "이 핑계로 밖을 놀러 다녔냐는 얘기야? 들켜버렸네~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480230,
					"content": "몬드의 마이너한 음료를 조사하려고 다운 와이너리에 가서, 아델린 하녀장과 이야기를 나눴어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480231,
					"content": "돌아오는 길에는 순찰 중이던 기사 애마톨과 마주쳤는데, 상대하기 까다로운 마물을 만나서 나한테 도움을 청하는 거 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480232,
					"content": "그래서 애마톨이랑 울프 영지로 가서, 난폭한 사냥개들을 혼내주고 왔어…. 오랜만에 몸을 썼더니 상쾌하더라~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480233,
					"content": "요즘엔 어떤 식물을 좋아하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "어머? 귀염둥이가 말을 조심스럽게 하네. 「요즘」이란 단어를 붙이고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480235,
					"content": "못 본 사이에 내 취향이 변했을까 봐? 아니면… 오래전 일이라 잘 기억이 안 나서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480236,
					"content": "리사 씨는 견문이 넓고 박학다식하시니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "좋아, 빈틈없는 대답이었어~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480239,
					"content": "학생 때는 책에나 나올 법한 신기한 식물들에 매료돼서, 계속 새로운 걸 찾아 나섰어. 하지만 이제는 안정적이고 규칙적인 생활에 익숙해졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480240,
					"content": "한 리월 법률가의 표현을 빌리자면, 내 삶은 「유유자적한 황혼」에 가까워졌달까? 더는 변덕스럽지 않게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480241,
					"content": "그러니까, 넌 기억하고 있을 거야. 몇 년 전에 함께 모험할 때, 날 위해 구해준 향긋한 연금 재료…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480242,
					"content": "내 취향은 변한 적이 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480243
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480243,
					"content": "좋아요, 이제 알 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "개량한 특제 음료를 준비해 드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "역시, 우리 귀염둥이가 더 똑똑해졌네. 살짝 힌트만 줬는데도 바로 알아채다니~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리사"
				},
				{
					"id": 705480237,
					"content": "언제든 새로운 관심사가 생기실 수 있잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480224,
					"content": "세심한 배려가 느껴져요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480215,
					"content": "기발한 발상이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480207,
					"content": "레시피를 살짝 바꿔서 다시 만들어 드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				}
			]
		},
