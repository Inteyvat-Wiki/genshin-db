			"dialogs": [
				{
					"id": 705480301,
					"content": "여기, 리사 씨를 위한 특별 신메뉴예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480302
					]
				},
				{
					"id": 705480302,
					"content": "일찍 편안한 꿈에 드시길 바라는 마음을 담아서, 「장미의 단꿈」이라는 이름을 붙여봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480303
					]
				},
				{
					"id": 705480303,
					"content": "색 조합부터 잔 모양까지 전부 바뀌었네. 첫 잔과는 완전히 다른 스타일이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480304
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480304,
					"content": "일단 외형은 내가 좋아하는 타입이 맞아. 그럼 한번 맛을 볼까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480305
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480305,
					"content": "음… 만점이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480306
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480306,
					"content": "마치… 고급 디저트를 즐긴 뒤, 시드르 호숫가를 따라 걸으며 산들바람을 맞는 듯한, 여유롭고 한가한 느낌이랄까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480307
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480307,
					"content": "피로가 말끔히 사라지면서도, 너무 들뜨지 않는 기분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480308
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480308,
					"content": "흐음~ 벌써 졸음이 밀려오네, 잠자기 전 음료로 최고인걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480309
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480309,
					"content": "이 음료를 자랑하고, 너에게 「천재 바텐더」라는 수식어를 붙이는 글을 쓰고 싶을 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480310,
						705480311
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480310,
					"content": "그럴 필요까진 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				},
				{
					"id": 705480312,
					"content": "그러고 보니, 날씨가 맑고 상쾌하면서 햇빛도 너무 뜨겁지 않은 날, 호숫가에서 산책하면 기분 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480313
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480313,
					"content": "귀염둥이랑 같이 걸으면서 이야기하면, 더 힐링 되겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480314
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480314,
					"content": "그러고 돌아올 때쯤, 이 「장미의 단꿈」을 한 잔 만들어 주면 더할 나위 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480315,
						705480316
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480315,
					"content": "다음에 꼭 그럴게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480317,
					"content": "흐응~ 그 진지한 대답, 기억해 놓을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480318
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705480318,
					"content": "나중에 핑계 대면서 빼면 안 된다?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리사"
				},
				{
					"id": 705480316,
					"content": "시간 비워둘게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480311,
					"content": "리사 씨의 마음에 들면 됐어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				}
			]
