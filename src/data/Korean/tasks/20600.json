			"dialogs": [
				{
					"id": 206000301,
					"content": "「사안」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "야… 너 정말 눈치가 없는 거야 아니면 모르는 척하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000303,
					"content": "넌 「우인단」의 정식 멤버도 아닌데, 그렇게 무턱대고 「『사안』이 뭐예요?」라고 물어보다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000304,
					"content": "내가 하나하나 다 말해줄 것 같아? 문을 지키는 저 페보니우스 기사들이랑 같은 취급하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000305,
					"content": "근데 뭐… 「사안」은 우리 「우인단」의 보물이니까 너한테 알려주는 것도 나쁘진 않을 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000306,
					"content": "이렇게 하자, 네가 한 번 더 다녀와 줘야겠어. 몬드성 근처에 있는 그 「보물 사냥단」 본 적 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000307,
					"content": "별 볼 일 없는 좀도둑들이지만, 가끔은 진짜 보물을 훔치기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000308,
					"content": "네가 나 대신 가서 「보물 사냥단」한테 있는 물건을 가져와 주면 내가 「사안」에 대해 이야기해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000309,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "시원시원해서 좋군. 그럼 빨리 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000311,
					"content": "돈이 부족하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "돈이 부족하냐고? 하하하, 우리가 페보니우스 기사단으로 보여?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000313,
					"content": "난 그저 보물 사냥단이 몬드에서 어떤 보물을 찾아내는지 보려는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000314,
					"content": "흐흐… 근데 아마 보물이라고 할 만한 건 없을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				}
			]
		},
