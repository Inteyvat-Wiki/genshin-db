					"빅토르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000201,
					"content": "「우인단」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000202
					]
				},
				{
					"id": 206000202,
					"content": "오우, 단도직입적이군. 흠흠, 그건 말하자면 길어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000203
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000203,
					"content": "하지만 넌 「우인단」의 정식 멤버가 아니니까 나도 맨입으로 말해줄 순 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000204
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000204,
					"content": "듣자 하니, 이 몬드성 주변엔 츄츄족이 많고 무리 지어 있는 곳도 있다던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000205
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000205,
					"content": "네가 나 대신 가서 「츄츄 폭도」한테 전리품을 얻어오면 너에게 색다른 이야기를 해 줄게. 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000206,
						206000209
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000206,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000207
					]
				},
				{
					"id": 206000207,
					"content": "오, 모처럼 몬드성에서 시원시원한 사람을 만났군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000208
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000208,
					"content": "그럼 빨리 가봐. 난 여기서 기다릴게. 빨리 와야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000209,
					"content": "그거면 되나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000210
					]
				},
				{
					"id": 206000210,
					"content": "왜? 너 설마 이게 시시하다고 투덜대는 거야? 됐어, 더 사나운 몬스터를 네가 처치할 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000211
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000211,
					"content": "빨리 가봐. 난 여기서 기다릴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000212
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000212,
					"content": "하암… 더 꾸물댔다간 내가 이 바람을 쐬다 잠들어버릴 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				}
			]
		},
