					"빅토르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000101,
					"content": "여행자, 여기 있었구나. 널 오랫동안 지켜봐 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000102
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000102,
					"content": "저한테 무슨 볼일 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000103
					]
				},
				{
					"id": 206000103,
					"content": "왜 그렇게 경계하는 말투야? 난 너한테 좋은 소식을 전하러 왔다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000104
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000104,
					"content": "「우인단」에 들어 오는 거 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000105
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000105,
					"content": "흥, 관심 없거든요! 그치?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000106,
						206000109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 206000106,
					"content": "생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000107
					]
				},
				{
					"id": 206000107,
					"content": "야! 이런 걸 생각하고 말고가 어딨어! 단칼에 거절해야지!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 206000108,
					"content": "안목 있군. 큰 업적을 이루려면 우리 「우인단」에 들어오는 것만큼 좋은 게 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000111,
					"content": "어라, 뭐 궁금한 게 있는 얼굴이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				},
				{
					"id": 206000109,
					"content": "여긴 몬드성이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000110
					]
				},
				{
					"id": 206000110,
					"content": "몬드성이 뭐? 우리 「우인단」은 공평하게 전 대륙에서 사람을 모집해. 페보니우스 기사단도 관여할 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000111
					],
					"speakerTitle": "빅토르"
				}
			]
		},
		{
			"id": 2060002,
			"completionStepIds": [
				2060002
			],
