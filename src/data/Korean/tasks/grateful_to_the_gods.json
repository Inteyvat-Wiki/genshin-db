			"trigger": {
				"objectNames": [
					"젤리안나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "휴, 일곱신상이 잘 계신지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380102,
					"content": "일곱신상이 왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "예전엔 매주 일곱신상에서 기도도 드리고, 그런 김에 신상의 먼지도 털어드렸었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380104,
					"content": "신의 힘을 받아 지금처럼 행복한 생활을 하게 되었답니다. 이게 제가 조금이나마 신에 보답할 수 있는 방법이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380105,
					"content": "하지만 릴리가 온 뒤로, 외출할 기회가 점점 줄어들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380106,
					"content": "분명히 지금쯤 청소해 줄 사람이 없어서 일곱신상엔 먼지가 잔뜩 쌓여있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380107,
					"content": "떠넘기는 것처럼 들릴 수도 있지만, 혹시 저 대신 일곱신상의 먼지를 치워줄 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380109,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "정말 고마워요, 바람 신의 가호가 함께하길…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380115,
					"content": "아 참, 일곱신상엔 신의 힘이 깃들어 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380116,
					"content": "일반적인 방법으로는 위쪽의 「먼지」를 없애기 힘들어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380117,
					"content": "그래도 「원소」의 힘과 함께라면 쉽게 해결할 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380118,
					"content": "그럼 저처럼 하루 종일 신상 앞에 쪼그려 앉아서 치우지 않아도 돼요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380110,
					"content": "뭐… 바람한테 먼지 좀 날려버려 달라고 하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "바르바토스 님과 그분의 바람은 분명 무척 바쁘실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380113,
					"content": "신에게만 기대하고 게으름 피우고만 있을 수는 없죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "젤리안나"
				},
				{
					"id": 200380114,
					"content": "나와 함께 바르바토스 님의 걱정을 덜어드려요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "젤리안나"
				}
			]
		},
