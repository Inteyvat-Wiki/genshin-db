			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu…mimi tomo… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250202,
					"content": "안녕?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika! 앗… 너였구나… 깜짝이야… 날 방해하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250204,
					"content": "이봐, 네가 불렀잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700250212,
					"content": "응? 아앗… 너희구나! 도와줘서 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250205,
					"content": "수첩 내용에 틀린 덴 없었어? 그걸로 츄츄족과 평화로운 대화가 가능할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250206,
					"content": "어렵진 않았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "후후, 내 사전이 완성까지 좀 더 가까워졌어! 인류가 츄츄족과 공존할 수 있다는 증거가 늘어났다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250209,
					"content": "그 이상한 츄츄족이랑 말을 못 해본 게 아쉽지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250210,
					"content": "내가 수집한 언어 자료로 봤을 땐 이 낯선 땅에서 새 친구를 사귀고 싶었던 걸지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250213,
					"content": "소통을 못 해서 정말 아쉽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250214,
					"content": "아 참, 이건 답례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250215,
					"content": "지금까지 귀찮게 해서 미안해. 나중에 또 같이 일할 기회가 있길 바래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700250211,
					"content": "뭐야, 이 녀석 말 잘하잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700250207,
					"content": "그래도 난 내 방식대로가 좋아",
