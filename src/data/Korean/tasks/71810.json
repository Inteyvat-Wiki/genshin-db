				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"엘라니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "우와… 정말 특이한 전투 방식이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100202,
					"content": "맞다, 「신의 눈」 사용자는 원소의 흔적을 감지하는 능력도 있다던데. 「원소 시야」라고 했던가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100203,
					"content": "비록 넌 「신의 눈」이 없지만, 네가 원소의 힘을 사용하는 걸 보면… 너도 이런 능력이 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100204,
					"content": "헤헤, 조금 전 이 주변에서 슬라임을 본 것 같은데, 이번엔 「원소 시야」를 사용해볼래? 「원소 시야」로 그것들을 찾아봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘라니"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"엘라니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "하하하… 난 「신의 눈」이 없어서 그런지 네가 「원소 시야」를 사용했을 때 평소랑 뭐가 다른지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100302,
					"content": "음, 아마 「신의 눈」을 가진 사람한테만 보이는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100303,
					"content": "어쨌든 이렇게 많은 걸 보여줘서 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100304,
					"content": "휴, 나도 「신의 눈」 갖고 싶다…. 「번개」 속성이면 좋겠네. 멋있으면서 방어력도 뛰어나잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100305,
					"content": "아니, 번개 속성의 「신의 눈」이 제일 가능성 없나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100306,
					"content": "노력하면 분명 얻을 수 있을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "불가능해. 번개 속성의 「신의 눈」은 아무리 노력해도 얻을 수 없다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100308,
					"content": "응? 너, 너 설마 몰라? 1년 전부터 번개 속성의 「신의 눈」을 얻은 사람은 단 한 명도 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100309,
					"content": "심지어 아카데미아에서 이걸 꽤 오래 연구했다고 해. 그래서 결론은… 이제 누구에게도 「신의 눈」을 부여하지 않는 건 「번개의 신」의 뜻이래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100310,
					"content": "게다가 이나즈마를 통치하는 그 「번개의 신」이 「안수령」을 내렸대. 이나즈마에 있는 대부분 사람들의 「신의 눈」을 전부 몰수한다더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100311,
					"content": "불복할 경우엔 심한 처벌도 받는 거 같더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 718100312,
