			"dialogs": [
				{
					"id": 761071701,
					"content": "우인단의 규칙 따위 따를 생각 없어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071702
					]
				},
				{
					"id": 761071702,
					"content": "규칙을 따르지 않겠다면, 사라져라!",
