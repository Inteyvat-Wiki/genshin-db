					"리스토"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071101,
					"content": "난 집행관 「산드로네」다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "엥? 지, 지금 그 설정으로 밀고 나가는 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761071103,
					"content": "흥, 용기는 인정하지. 하지만 그렇게 뻔뻔한 거짓말을 하다니, 우인단을 너무 얕보는 거 아니야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리스토"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리스토"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "난 「산드로네」가… 특별 채용한 연구원이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "특별 채용 연구원이라고? 그분은 기계와 달의 힘에 대한 연구가 이미 최고 수준인데, 외부에서 연구원을 데려온다니 상상하기 어렵네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리스토"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리스토"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "과학 연구는 협력이 바탕이 돼야 하니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "맞아. 나도 그분을 위해 폰타인 과학원의 연구 보고서를 꽤 많이 수집했었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "리스토"
				},
				{
					"id": 761071303,
					"content": "당신이 이쪽 분야 전문가니까, 이 기갑선 고장도 금방 해결하겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리스토"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리스토"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "어… 난 주로 이론 연구에 집중해서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "아, 그렇구나. 달의 힘에 관한 이론 연구는 가장 심오한 학문이지. 정말 대단해! 기갑선 수리는 비교적 실용적인 분야라서, 둘을 혼동하면 안 되겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "리스토"
				},
				{
					"id": 761071403,
					"content": "하지만 「산드로네」님은 지금 이곳에 계시지 않으니, 일단 아잘레아 대장님을 찾아가는 게 좋을 거야. 아마 다음 일정에 대해 알고 계실 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리스토"
				}
			]
		},
		{
			"id": 7610715,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
