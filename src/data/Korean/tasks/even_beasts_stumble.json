			},
			"dialogs": [
				{
					"id": 731850501,
					"content": "이 동물 짐꾼은… 기분이 별로 안 좋아 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731850502,
					"content": "우와, 이 발굽 좀 봐, 엄청 단단해 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731850503,
					"content": "이 발굽에 한 방 맞으면 평범한 사람은 바로 기절하겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731850504,
					"content": "페이몬, 네가 먹이들을 주고 와…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "네, 네가 가! 아, 빨리!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731850506,
					"content": "맛있게 드세요…",
