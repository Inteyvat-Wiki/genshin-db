			"dialogs": [
				{
					"id": 747090101,
					"content": "#고생 많았어, {NICKNAME}, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747090102,
					"content": "아픈 물고기들의 증상을 대충 파악했어. 그걸 토대로 멜뤼진의 비법 약제도 만들었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747090103,
					"content": "이 특별한 약을 수조에 풀면, 모두를 진정시킬 수 있을 거야~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747090104,
					"content": "수조 전체를 치료소로 바꾸는 셈이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747090105,
					"content": "생각해 봤는데… 이건 정말 시그윈만 할 수 있는 일인 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747090106,
					"content": "하지만 이건 임시방편일 뿐이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "맞아. 정확한 발병 원인을 파악하려면, 다양한 특성을 가진 물고기들을 데려와서 「건강검진」을 받게 해야 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747090109,
					"content": "이제부터는 물고기의 특성에 따라 더 구체적인 환자 목록을 정리해 둘게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747090110,
					"content": "조건에 맞는 물고기를 발견하면 각별히 더 신경 써 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747090107,
					"content": "문제를 해결하려면 원인을 찾아야 해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				}
			]
		}
	]
