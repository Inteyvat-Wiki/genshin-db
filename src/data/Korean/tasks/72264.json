				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722640901,
					"content": "엄청 뜨거워, 뜨거워. 근데 재밌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640902
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640902,
					"content": "근데 전에 「교부 코반」이었나, 「쇼우세이」었나, 아무튼 다른 너구리도 횃불로 변했었잖아… 너구리 요괴는 횃불로 변하는 걸 좋아하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640903
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640903,
					"content": "인간의 물건으로 변하면 인간이랑 놀 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640904
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640904,
					"content": "변하지 않으면 인간들은 길법사랑 잘 안 놀아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640905
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640905,
					"content": "#괜찮아, 나랑 {NICKNAME}(이)가 길법사랑 놀아줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640906
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640906,
					"content": "오예! 같이 놀아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640907
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640907,
					"content": "음… 근데 이 앞은 절벽인데, 우리가 데려가 줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640908
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640908,
					"content": "길법사, 슝슝, 펑펑!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640909
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640909,
					"content": "엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640910
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640910,
					"content": "길법사의 몸에서 풍선 같은 물건이 나오더니\\n그 물건의 부력과 설산의 차가운 바람을 이용해 순조롭게 산 건너편에 도착한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722640911
					]
				},
				{
					"id": 722640911,
					"content": "…저게 대체 뭔데! 어떻게 된 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
