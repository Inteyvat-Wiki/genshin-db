			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722640101,
					"content": "흑흑… 전에 산꼭대기의 「기둥」을 들어 올리긴 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640102,
					"content": "근데 몇 번을 와도 드래곤 스파인은 너무 춥다니까… 못 참겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640103,
					"content": "낭하하, 하얀 털은 약해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640104
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640104,
					"content": "뭐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640105,
					"content": "길법사는 추위를 타지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640106
					]
				},
				{
					"id": 722640106,
					"content": "우낭낭, 추워, 너무 추워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640107
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640107,
					"content": "뭐야! 열 받아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640108,
					"content": "하지만 재밌어, 새하얀 게 잔뜩 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640109
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640109,
					"content": "새하얀… 아, 저건 「눈」이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640110,
					"content": "「눈」… 「벚꽃 눈보라」의 눈? 신성한 벚나무?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640111
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640111,
					"content": "아냐, 드래곤 스파인의 엄청 차갑고 새하얀 게 바로 눈이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640112,
					"content": "근데 길법사가 벚꽃 눈보라 같은 단어를 알고 있다니. 역시 이나즈마의 너구리 요괴라는 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640113,
					"content": "낭! 눈이야! 너무 추워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640114
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640114,
					"content": "길법사, 기분이 엄청 좋아 보여",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640115
					]
				},
				{
					"id": 722640115,
					"content": "산에 눈이 있어서 추운 거야, 아니면 산이 추워서 눈이 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640116
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640116,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640117,
					"content": "#엣, 좋은 질문이야. {NICKNAME}, 넌 눈이 뭐라고 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640118,
						722640121,
						722640124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640118,
					"content": "물 원소겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640119
					]
				},
				{
					"id": 722640119,
					"content": "음… 그럼 여기가 너무 추워서 물 원소가 얼어서 눈이 된 거겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640120,
					"content": "너무 추워, 눈 엄청 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640128,
					"content": "어쨌든 이런 건 나중에 기회가 될 때 리사 같은 박학다식한 사람한테 물어보는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640129,
					"content": "드래곤 스파인은 정말 너무 추워. 전에 산꼭대기로 올라갈 때 추워서 정신을 잃을 뻔한 적도 있었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640130,
					"content": "하지만 경치가 정말 아름다워! 요고우산에서 여길 볼 수 있다면 산꼭대기에서 요고우산도 볼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640131,
					"content": "게다가 별빛 동굴은 엄청 깊다구, 안에 발견하지 못한 보물이 숨겨져 있을지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640132,
					"content": "보물! 보물은 좋은 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640133
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640133,
					"content": "길법사와 페이몬은 죽이 잘 맞을지도 모르겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640134
					]
				},
				{
					"id": 722640134,
					"content": "흥흥, 보물이 없으면 어떻게 호의호식하면서 살겠어? 길법사가 뭘 좀 아네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640135,
					"content": "길법사는 눈에서 놀고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640136
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640136,
					"content": "응, 감기 걸리지 않게 조심해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640137,
					"content": "위험한 상황에 처하면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640138
					]
				},
				{
					"id": 722640138,
					"content": "「보물 찾았다」라고 큰소리로 외치면 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640139
					]
				},
				{
					"id": 722640139,
					"content": "야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640121,
					"content": "얼음 원소겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640122
					]
				},
				{
					"id": 722640122,
					"content": "응? 그런 거야? 그렇다면 눈이 얼음 원소라서 이곳을 춥게 만든 거겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640123,
					"content": "너무 추워, 눈 엄청 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640124,
					"content": "케이아가 한 짓이겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640125
					]
				},
				{
					"id": 722640125,
					"content": "「감기 걸리지 않게 조심하라구!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640126,
					"content": "아냐! 아무리 그래도 케이아가 그렇게 대단하진 않잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640127,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「길법사」"
				}
			]
		},
