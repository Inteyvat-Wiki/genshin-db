					"nextDialogs": [
						722640322
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722640322,
					"content": "그, 그것도 맞긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722640323,
					"content": "너구리 요괴만 부릴 수 있는 요술이겠지",
