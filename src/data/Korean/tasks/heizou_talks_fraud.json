				"objectNames": [
					"이바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "헤이조는 정말 무서운 녀석이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "이바"
				},
				{
					"id": 190570902,
					"content": "음? 내가 겪었던 일을 알고 싶다고? 너무 간단해서 별로 말할 건 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "이바"
				},
				{
					"id": 190570903,
					"content": "그때 헤이조가 조사를 시작했다고 들었을 때 난 이미 끝났다고 생각해서 모든 걸 순수히 불었어. 상대가 「폭풍」이었으니까 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "이바"
				},
				{
					"id": 190570904,
					"content": "「폭풍」이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "헤이조의 별명이야. 들어본 적 없나? 감옥에 있는 범인들은 다들 그렇게 부르거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "이바"
				},
				{
					"id": 190570906,
					"content": "절대 도망치지 못하고, 숨지도 못해. 범죄자들에게 있어서 헤이조는 폭풍 같은 재앙적인 존재지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "이바"
				},
				{
					"id": 190570907,
					"content": "휴, 이렇게 될 줄 알았으면 처음부터…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이바"
				}
			]
