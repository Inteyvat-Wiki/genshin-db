				"objectNames": [
					"카노 나나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "여행자, 안녕하세요. 동생이 많이 폐 끼친 모양이네요. 개성이 넘치는 아이지만 심성이 나쁘진 않답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "카노 나나"
				},
				{
					"id": 190570802,
					"content": "만약 녀석이 실례를 범하면 망설이지 말고 따끔하게 혼내주세요. 반항하면 제 허락을 맡았다고 하시구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카노 나나"
				}
			]
		},
