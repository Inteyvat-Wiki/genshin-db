					"nextDialogs": [
						10151114
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10151114,
					"content": "오늘 저녁에 사람들이 극찬하는 유명한 항구의 술창고로 데려가 주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151115
					],
					"speakerTitle": "종려"
				},
