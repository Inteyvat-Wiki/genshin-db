			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "음, 이 재료들이면 충분하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150602,
					"content": "잠시만 기다려줘, 내가 한번 고쳐보지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150603,
					"content": "다 됐어. 「귀종기」의 구조는 내 생각보다 더 정교하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150604,
					"content": "우와! 그럼 어떻게 작동시키는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150605,
					"content": "간단해. 그냥 이렇게 하면 돼…. 봐, 선인의 장치에 「망원」 기능까지 있다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150617,
					"content": "여기엔… 없고… 저기도 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150606,
					"content": "이봐! 당신들 거기서 뭐 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "황곰보"
				},
				{
					"id": 10150607,
					"content": "이건… 이 쇠뇌, 너희가 고친 거야? 너희 마음대로 건드리면 어떡해?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "황곰보"
				},
				{
					"id": 10150608,
					"content": "이건 쇠뇌가 아니라 「귀종기」라네. 그리고—— 질문을 하기 전에 먼저 통성명을 하는 게 예의지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150609,
					"content": "보면 몰라? 흥, 우린 보물 사냥단이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "황곰보"
				},
				{
					"id": 10150610,
					"content": "이 일대엔 온갖 보물들이 매장되어 있다지. 하지만 이 쇠뇌는 기계인데도 이 일대를 지키는 경비병 같아. 아무튼 골칫거리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "황곰보"
				},
				{
					"id": 10150611,
					"content": "저번엔 이것 때문에 꼬치가 될 뻔한 단원도 있었다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "황곰보"
				},
				{
					"id": 10150612,
					"content": "목숨 걸고 이 큰 녀석을 망가뜨려 놨더니——한숨 돌리기도 전에 다시 고쳐 놨다고!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "황곰보"
				},
				{
					"id": 10150613,
					"content": "너희들, 오늘 나한테 혼 좀 나봐야겠구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "황곰보"
				},
				{
					"id": 10150614,
					"content": "흥, 사리사욕을 채우려고 선인의 지혜를 더럽히다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150615,
					"content": "혼나야 하는 건, 너희다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150616,
					"content": "맞아! 덤벼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"치치"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "미안하지만 「야자염소」라는 반신수에 대한 단서를 못 찾아서 「계약」을 완수하지 못했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150702,
					"content": "아, 할 수 없죠. 그래도 정말 실망이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "치치"
				},
				{
					"id": 10150703,
					"content": "힝——치치가 이러니까 괜히 나까지 죄책감이 드네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150704,
					"content": "치치야, 다른 단서는 없니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "음… 「야자염소」에서 나오는 우유는 맛있어요. 다른 산양유보다 훨씬 맛있어요. 그러니까 분명 반신수일 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "치치"
				},
				{
					"id": 10150707,
					"content": "죄송해요. 전 기억력이 나빠요. 그래서 그 우유의 이름을 적어놨는데… 찾아볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "치치"
				},
				{
					"id": 10150708,
					"content": "아, 이거예요. 그 맛있는 우유는… 「코코넛 우유」라고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "치치"
				},
				{
					"id": 10150709,
					"content": "응?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150710,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150711,
					"content": "미안하군, 치치와 공정하게 거래하기 위해 너무 섣불리 승낙한 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150712,
					"content": "아냐, 괜찮아. 리월엔 「세상만사 무상하다. 인생은 한 치 앞도 모르는 것」이라는 말이 있잖아. 결말이 이렇게 황당할 줄 누가 알았겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150713,
					"content": "음… 치치가 뭐 잘못 말했나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "치치"
				},
				{
					"id": 10150714,
					"content": "#{NICKNAME}, 미안하지만 동심을 파괴하는 일은 너한테 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150715,
					"content": "야자 우유, 그러니까 코코넛 우유는 「야자염소」에서 나오는 게 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "치치"
				},
				{
					"id": 10150718,
					"content": "치치가 생각에 잠긴 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150719,
					"content": "방해하지 말자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "하하, 정말 보람찬 인생 수업이군요. 우리 치치를 잘 돌봐 주셔서 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150722,
					"content": "당신은…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150723,
					"content": "이런, 실례했군요. 전 「불복려」의 주인, 백출이라고 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150724,
					"content": "주인은 치치가 아니라——저 목에 약재가 달린 이상한 사람이었어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150725,
					"content": "가엽군. 치치보다 더 순진한 사람이 있다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150726,
					"content": "아악! 저 약재 같은 게… 뱀이었어? 그리고 마… 말도 해?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150727,
					"content": "뱀이 말을 해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "쳇, 입을 열 생각은 없었어. 단골이 아닌 손님들은 항상 놀라더군. 하지만 말을 안 했다면 계속 날 서랍 속의 저 마른 뱀들과 같은 취급을 했겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150730,
					"content": "하하하… 이분은 「장생」입니다. 악의는 없어요. 그나저나 이곳엔 무슨 일로 오셨죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150731,
					"content": "여기 「영생향」이 있는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150732,
					"content": "오, 「영생향」 말씀이신가요? 물론 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150733,
					"content": "휴… 다행이다. 반나절을 허투루 쓴 건 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150734,
					"content": "300만 모라입니다. 품질은 최상급이고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150735,
					"content": "300만?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "차라리 가서 「황금옥」을 털어! 음… 하지만 지금 「황금옥」은 칠성이 맡고 있으니 그건 어렵겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150739,
					"content": "음… 300만이라…. 별거 아닌 것 같지만, 일반적인 상식으로 따져보니 확실히 곤란한 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150740,
					"content": "이렇게나 비싸다니! 우리 힘으론 어림도 없어!——종려는 뭐 말할 것도 없겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150741,
					"content": "그렇지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150742,
					"content": "명쾌한 대답이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "어쩌지… 휴, 이번에도 타르탈리아의 도움을 받는 수밖에 없겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150744,
					"content": "하하하하하하하——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150745,
					"content": "야자염소… 야자염소라니! 정말 재밌네. 어린아이의 말장난에 한바탕 놀아났구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150746,
					"content": "비웃지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150747,
					"content": "참, 눈물이 쏙 빠지게 웃었군. 좋아, 나를 이렇게 웃겨 줬으니 보답으로 문제를 해결해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150748,
					"content": "백출 님, 맞으시죠? 전 「우인단」의 집행관 「타르탈리아」입니다. 괜찮으시면 앞으로도 잘 부탁드립니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150749,
					"content": "「불복려」에서 원하신다면, 우인단에서 코코넛 우유의 공급 루트를 연결해드리죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150750,
					"content": "응? 우인단이 「암흑가의 벗」을 끌어들인다고는 들었지만, 고작 코코넛 우유로 「불복려」를 매수하려는 건 아니겠지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150751,
					"content": "코코넛 우유, 코코넛 우유. 백 선생님, 코코넛 우유",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "치치"
				},
				{
					"id": 10150752,
					"content": "알았어, 치치… 그럼 부탁드립니다, 「타르탈리아」 님. 앞으로의 협력 관계를 기대하겠습니다. 이 「영생향」도 299만 모라에 조금 싸게 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "백출"
				},
				{
					"id": 10150753,
					"content": "300만이랑 299만은 별 차이 없잖아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150754,
					"content": "음… 299만이라…. 별거 아닌 것 같지만, 따져보니 확실히 300만보다 1만이 적군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150755,
					"content": "그럼 모든 게 해결됐으니, 우리도 옥경대로 돌아가자고. 「타르탈리아」 씨, 백출 주인장, 치치, 기회가 되면 다음에 또 보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150756,
					"content": "정말 재밌는 사람들이라니까. 이렇게 웃은 건 오랜만이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150757,
					"content": "그럼, 나보다 훨씬 전부터… 이곳에 잠복해있던 넌, 뭐 「건진 거」 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150758,
					"content": "네, 「타르탈리아」 님. 그들에 의하면, 「황금옥」이 칠성에게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "예카테리나"
				},
				{
					"id": 10150759,
					"content": "그랬군, 그랬던 거야. 흥, 응광, 그리고 칠성. 당신들이 황금옥에 숨기고 싶어 하는 게… 「선조의 허물」 말고 또 뭐가 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150760,
					"content": "#{NICKNAME}, 미안하게 됐지만, 내가 전에도 말했었지? 「벽에 귀가 있다」는 리월의 속담을 잘 기억해둬야 할 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10150737,
					"content": "차라리 「황금옥」을 털어 오세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "하지만 지금 「황금옥」은 칠성이 맡고 있으니 그건 어렵겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150728,
					"content": "여기는 리월이니까. 이 정도는 놀랄 일도 아니지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "아이들은 다 이렇게 크는 거지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "야자 우유, 그러니까 코코넛 우유는 야자수에서 나오는 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "치치는 「야자염소」로 뭘 하려고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
