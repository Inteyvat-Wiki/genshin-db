			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "이렇게 거대할 줄이야. 역시 선인이 남긴 물건이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150302,
					"content": "근데, 이거 어떻게 쓰는 거지? 조종하려면 엄청난 힘이 필요해 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150303,
					"content": "지금은 조종할 수 없어. 망가졌거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150304,
					"content": "말도 안 돼…. 망가졌다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150305,
					"content": "천년의 세월이 흘렀으니 아무리 선인의 장치라고 해도 원래대로 유지하긴 힘들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150306,
					"content": "그럼 어떡해? 빨리 그 무한한 「상류층 지식」으로 생각 좀 해봐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150307,
					"content": "이런, 날 아무것도 못 하는 부잣집 도령 취급하는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150308,
					"content": "음… 사실 「귀종기」를 처음 만들었을 때, 전쟁 피해를 대비해 예비 자재를 준비해 뒀다고 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150309,
					"content": "내 생각이 맞다면, 아마 「옛 성벽」에서 당시의 보급소를 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150310,
					"content": "보급소의 자재만 찾으면 돼. 그리고 「귀종기」의 작동 원리만 알면, 어렵지 않게 수리할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150311,
					"content": "그럼… 그 원리를 알고 있다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10150312,
					"content": "대충은 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10150313,
					"content": "<color=#00E1FFFF>재료만 충분히</color> 모으면 시도는 해볼 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종려"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
