			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120601,
					"content": "(파손된 텅 빈 나무상자가 길가에 덩그러니 버려졌다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120602
					],
					"speakerTitle": "조사"
				},
				{
					"id": 732120602,
					"content": "이 나무상자는 캐러밴의 것이 틀림없어. 겉에 부족 문양이 있는걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120603,
					"content": "이곳 지형은 매복하기에 완벽하지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120604
					]
				},
				{
					"id": 732120604,
					"content": "그러게… 이 위치는 딱 봐도 엄청 험악해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120605,
					"content": "부피 큰 화물까지도 모조리 털렸네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120606
					]
				},
				{
					"id": 732120606,
					"content": "화물을 가져가고 빈 상자만 남겨놓았어… 음, 인원이 꽤 많지만 빈 나무상자를 옮길 도구가 부족했나보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120607,
					"content": "아니면, 그들의 계략일 수도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120608
					]
				},
				{
					"id": 732120608,
					"content": "엥…? 계략?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120609,
					"content": "설마 빈 상자는… 그들이 일부러 남겨놓은 미끼일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120610,
					"content": "우리를 낚기 위한 미끼야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120611
					]
				},
				{
					"id": 732120611,
					"content": "우와… 소름 돋았어! 그래도 계속 조사할 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120612,
						732120614
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120612,
					"content": "무서우면 먼저 돌아가도 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120613
					]
				},
				{
					"id": 732120613,
					"content": "아니, 누가 무섭대! 흥… 더군다나 너는 내가 없으면 안 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120614,
					"content": "캐러밴을 약탈한 녀석들이 아직도 근처에 매복해 있을지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120615
					]
				},
				{
					"id": 732120615,
					"content": "으, 너무 무섭게 들리는데… 흥, 하지만 너도 두려워하지 않는데 뭐. 계속 길을 따라 조사하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7321208,
