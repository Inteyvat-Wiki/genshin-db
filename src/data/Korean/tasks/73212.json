			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120501,
					"content": "(파손된 빈 항아리다. 모래에 완전히 묻히지 않은 걸 봐서는 버린 지 얼마 안 된 것 같다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120502
					],
					"speakerTitle": "조사"
				},
				{
					"id": 732120502,
					"content": "이것 봐! 이 항아리는 아직 모래에 묻히지 않았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120503,
						732120505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120503,
					"content": "길에 화물이 흩어져 있네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120504
					]
				},
				{
					"id": 732120504,
					"content": "상황이 심상치 않은 것 같아… 그들이 길에서 다른 것도 흘렸을 수 있으니 좀 더 가볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120505,
					"content": "길을 따라 좀 더 찾아보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120506
					]
				},
				{
					"id": 732120506,
					"content": "응… 그들이 다른 것도 흘렸을 수 있으니 계속 가면서 찾아보자구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
