			"dialogs": [
				{
					"id": 732121001,
					"content": "도, 돌, 돌아오셨군요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121002
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121002,
					"content": "왜, 우리가 돌아온 게 많이 이상해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121003
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732121003,
					"content": "아, 아, 아니, 돌아오시니 얼마나 기쁜데요. 존, 존귀하신 「지니의 주인」이시여!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121004
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121004,
					"content": "아, 아, 맞다, 캐, 캐, 캐러밴에 관한 일은… 조사가 어떻게 되었습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121005
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121005,
					"content": "캐러밴은 습격을 당했고 화물은 모두 약탈당했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121006
					]
				},
				{
					"id": 732121006,
					"content": "젠장! 젠장! 또 그 배신자 놈들 짓이군! 부, 분, 분명해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121007
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121007,
					"content": "배신자라니…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121008
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732121008,
					"content": "배, 배, 배신자, 북방인들과 결탁한 나쁜 놈들이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121009
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121009,
					"content": "그, 그것 말고 또, 또, 또 무엇을 발견했나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121010
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121010,
					"content": "돌아오는 길에 도금 여단의 습격을 받았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121011
					]
				},
				{
					"id": 732121011,
					"content": "응, 캐러밴에 대한 조사를 마치자마자 도금 여단 녀석들이 갑자기 나타나서 우리를 습격했어! 그놈들은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121012
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732121012,
					"content": "우리가 누군지 잘 안다고 그랬어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121013
					]
				},
				{
					"id": 732121013,
					"content": "어… 맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121014
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732121014,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121015
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121015,
					"content": "여, 역, 역시… 그들이 당신도 노리고 있었네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121016
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121016,
					"content": "여기 당신께 드리는 수, 수고, 수고비입니다. 그리고 어, 어서 바벨 대모에게 이 얘기를 해주세요. 지, 지, 지체할 수 없어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121017
					],
					"speakerTitle": "유프텐"
				},
				{
					"id": 732121017,
					"content": "아, 알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121018
					]
				},
				{
					"id": 732121018,
					"content": "아, 안녕히 가세요. 존귀하신 「지니의 주인」이시여!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "유프텐"
				}
			]
