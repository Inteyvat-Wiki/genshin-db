				"points": []
			},
			"dialogs": [
				{
					"id": 732120401,
					"content": "#안녕! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120402
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732120402,
					"content": "나랑 같이 모험을 해줘서 정말 고마워. 그리고 우리 부모님 일도… 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120403
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732120403,
					"content": "뭐 이렇게 감사할 것까지야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120404
					]
				},
				{
					"id": 732120404,
					"content": "헤헤, 바벨 대모가 다른 임무를 맡기지 않았더라면 나도 너와 함께 사막을 탐험했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120405
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732120405,
					"content": "내가 재미있는 곳을 많이 아니까 나중에 시간 있으면 너희를 데려갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120406
					],
					"speakerTitle": "제트"
				},
				{
					"id": 732120406,
					"content": "하지만 지금은 그럴 여유가 없어. 북방인과 결탁한 배신자들이 우리 영지를 호시탐탐 노리고 있기에 나는 그들의 움직임을 감시해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				}
			]
		},
		{
			"id": 7321205,
