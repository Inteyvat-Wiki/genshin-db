			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732120801,
					"content": "(상태가 양호한 모포. 타니트 부족의 문양이 새겨졌으며 불길한 얼룩이 군데군데 묻어있다…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120802
					],
					"speakerTitle": "조사"
				},
				{
					"id": 732120802,
					"content": "이 모포 말이야… 정말 이상해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120803
					]
				},
				{
					"id": 732120803,
					"content": "음… 이 모포는 엄청 비싼 건데 왜 여기에 버려두고 갔을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120804,
					"content": "혹시 서로 빼앗고 싸우면서 떨어뜨렸으려나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120805
					]
				},
				{
					"id": 732120805,
					"content": "어, 일리가 있네… 그렇다면 다 설명이 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120806,
					"content": "캐러밴과 도적 떼가 여기서 싸움을 벌인 거야. 일부 화물은 싸우는 과정에서 망가졌고, 일부 멀쩡한 화물은 챙겨갈 겨를이 없어서 버려진 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120807
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120807,
					"content": "오호, 그럴듯한데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120808
					]
				},
				{
					"id": 732120808,
					"content": "흥흥! 난 페이몬이라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120809,
					"content": "캐러밴은 강도와 싸우고 도망가고 싸우고 도망가고를 거듭해서, 길에 부서진 상자와 항아리가 가득 널린 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120810,
					"content": "어때, 설득력 있는 추리지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120811,
					"content": "전혀 말이 안 돼!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120812
					]
				},
				{
					"id": 732120812,
					"content": "에에——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120813,
						732120814
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120813,
					"content": "저 쓰레기는 강도가 화물을 손에 넣은 후 버린 것일 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				},
				{
					"id": 732120815,
					"content": "그런가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120816
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120816,
					"content": "왜냐하면, 오는 길에서 싸운 흔적이 발견되지 않았거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120817
					]
				},
				{
					"id": 732120817,
					"content": "그렇구나… 흥흥, 그래도 내 추리가 얼추 맞았네… 비슷하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120818
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120818,
					"content": "음… 근데 뭔가 좀 이상한 것 같단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120819,
						732120820
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120819,
					"content": "뭐가 이상해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120821,
					"content": "이 단서들이 너무 작위적인 느낌이 나지 않아? 우리를 유인하기 위해 일부러 배치한 것 같기도 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120822,
						732120823
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120822,
					"content": "음… 그냥 네 의심이 너무 많은 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120824,
					"content": "어! 저길 봐, 마차가 바로 저쪽에 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120825
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120825,
					"content": "원래 모습을 거의 알아볼 수 없을 정도로 망가졌구나…. 그래도 흐릿하게 타니트 부족의 문양이 보이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120826
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120826,
					"content": "좋아, 이제 사건을 종결할 수 있겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120827
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120827,
					"content": "캐러밴은 매복 습격을 당해 화물을 전부 빼앗긴 게 분명해. 이제 유프텐에게 조사 결과를 알려주면 의뢰가 끝나는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120828
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120828,
					"content": "응. 돌아가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120829
					]
				},
				{
					"id": 732120829,
					"content": "두 분, 실례지만 잠깐만요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120830
					],
					"speakerTitle": "도금 여단 암살자"
				},
				{
					"id": 732120830,
					"content": "엥… 너희들은 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120831
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120831,
					"content": "우리는 제트의 친구입니다. 정말 수고 많으셨습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120832
					],
					"speakerTitle": "도금 여단 암살자"
				},
				{
					"id": 732120832,
					"content": "그래? 제트의 친구라면 곧 우리 친구야! 마침 우리 일도 끝났으니 같이 돌아가면 되겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120833
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120833,
					"content": "아니, 서둘러 돌아가지 않으셔도 됩니다, 하하하!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120834
					],
					"speakerTitle": "도금 여단 암살자"
				},
				{
					"id": 732120834,
					"content": "잠깐, 페이몬… 저 사람들 좀 이상해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120835
					]
				},
				{
					"id": 732120835,
					"content": "제트는 두 분이 사막에 좀 더 오래 머물렀으면 좋겠다고 했어요… 그리고 우리에게 두 분을 「환대」하라고 부탁했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120836
					],
					"speakerTitle": "도금 여단 암살자"
				},
				{
					"id": 732120836,
					"content": "그녀를 실망시키지 않으셨으면 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120837
					],
					"speakerTitle": "도금 여단 암살자"
				},
				{
					"id": 732120837,
					"content": "#엥…? {NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120838
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120838,
					"content": "빨리 숨어, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120839
					]
				},
				{
					"id": 732120839,
					"content": "아, 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732120823,
					"content": "일리가 있긴 한데 뒷받침해 줄 증거가 부족해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120820,
					"content": "페이몬의 직감 타임!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120814,
					"content": "짐을 최대한 줄여서 빨리 움직이려는 목적이겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120815
					]
				}
