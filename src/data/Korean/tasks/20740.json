			"dialogs": [
				{
					"id": 207400401,
					"content": "그 꽃들에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "다 꺾어 오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400403,
					"content": "다 꺾어 왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "다 신선하네요…. 감사해요. 이 꽃들을 밖에 두면 틀림없이 손님들을 불러 모을 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400405,
					"content": "또 부탁드릴 게 있는데… 바람이 불 때 가게에 있던 민들레도 다 날아가 버렸거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400406,
					"content": "민들레 씨앗이 바람에 날아간 건 좋은 일이지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400407,
					"content": "몬드성 꽃집에 민들레가 없다는 건 말이 안 되는 것 같아서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400408,
					"content": "민들레는 그냥 꺾어오면 안 되고 씨앗을 심어야 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400409,
					"content": "혹시 민들레 씨앗 하나만 구해 주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400410,
					"content": "나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "그럼 부탁드려요. 몬드성 밖에 민들레가 많았던 걸로 기억해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400412,
					"content": "어디서 구해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "몬드성 밖에 민들레가 많아요. 쉽게 구하실 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				}
			]
		},
