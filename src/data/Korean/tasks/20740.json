					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "감사해요, 이 정도면 충분해요. 이따 화분에 심어야겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400505,
					"content": "전에 꺾어 오신 꽃들도 화분에 옮겨 심을 생각이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400506,
					"content": "참, 감사 인사를 안 드렸네요. 이건 답례니까 받아주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 207400507,
					"content": "전 빨리 이 꽃들이랑 민들레 씨앗을 화분에 심어야겠어요…",
					"roleType": "TALK_ROLE_NPC",
