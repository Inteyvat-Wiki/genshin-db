			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"청경"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "청경, 우리 돌아왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705220302,
					"content": "부탁한 음료는 이미 주문 완료됐어. 내일 선적돼서 부두 쪽으로 운송될 거야! 이 주문서를 잘 챙겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705220303,
					"content": "거래가 벌써 성사되었다고요? 정말 수완이 좋으시네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "청경"
				},
				{
					"id": 705220304,
					"content": "아, 잠깐만 기다리세요. 제가 당장 최고의 샘물로 차를 타 드릴게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "청경"
				},
				{
					"id": 705220305,
					"content": "괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "맞아 맞아. 얼른 다른 사람들 주문도 도와야 하니까 여기서 폐 끼치지 말고 얼른 갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705220308,
					"content": "장사 잘되길 바랄게! 맛있는 음료는 다음에 왔을 때 대접해 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705220309,
					"content": "그럼 다음에는 두 분이 좋아하는 음료를 꼭 준비해 놓을게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "청경"
				},
				{
					"id": 705220310,
					"content": "자주 놀러 오세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "청경"
				},
				{
					"id": 705220306,
					"content": "수고비는 이미 받았잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
