			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"청경"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "주문에 관한 것은 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "청경"
				},
				{
					"id": 705220402,
					"content": "이 특산 음료가 있으면 선원들이 맛을 바꿔가면서 갈증을 해소할 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "청경"
				},
				{
					"id": 705220403,
					"content": "맛?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "선원들은 취향도 제각각이거든요. 담백한 차를 좋아하는 사람도 있고, 새콤달콤한 주스를 원하는 사람도 있고… 무엇보다 같은 음료를 계속 마시면 질릴 수 있잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "청경"
				},
				{
					"id": 705220405,
					"content": "그래서 저는 선원들의 요구사항을 최대한 충족시키기 위해 다양한 맛의 음료를 가게에 준비해두고 있어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "청경"
				},
				{
					"id": 705220406,
					"content": "가게에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "선원들이 저에게 큰 도움을 준 적이 있어요. 그래서 보답의 의미로 부두 쪽에 가게를 열어 그들에게 음료수를 제공하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "청경"
				},
				{
					"id": 705220408,
					"content": "근데 아직 서툴러서 장사가 잘 안되네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "청경"
				},
				{
					"id": 705220409,
					"content": "나중에 봬요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "잘 가요! 모든 게 순조롭길!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "청경"
				}
