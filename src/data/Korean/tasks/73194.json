			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "이번 연도 「비옥한 은혜」 발급이 시작되었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 731940402,
					"content": "이번 해에도 원칙적으로 작년 발급 정책 및 요구에 따라 발급될 예정이며 구체적인 내용은 허공에 게시되었으니 확인하십시오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 731940403,
					"content": "변경 사항이 있을 경우 근처의 교령관을 통해 아카데미아에 수정 신청을 제출할 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
