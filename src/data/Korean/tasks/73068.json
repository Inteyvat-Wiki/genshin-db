						"rawParams": [
							"7306802",
							"2"
						],
						"stepId": 7306802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아란카라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680201,
					"content": "#나라{NICKNAME}(이)랑 페이몬? 아란나쿨라는 아란판두랑 아샤반의 땅에 가서 아직 안 돌아왔어. 지금은 버섯이나 먹으러 가는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란카라"
				}
			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아란나쿨라",
					"아란카라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "아란나쿨라야! 바나라나로 무사히 잘 돌아왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680302,
					"content": "#나라{NICKNAME}, 페이몬! 바루나 신기는 다 나았어. 이제 아란나쿨라는 모밭을 돌보는 데 집중할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680303,
					"content": "여기가 아란나쿨라가 계속 말하던 모밭이구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680304,
					"content": "맞아. 아란나쿨라와 아란카라가 함께 돌보는 모밭이야. 이곳의 흙은 식물을 키우기 좋아. 행복한 비파랴스를 키울 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680305,
					"content": "불행한 비파랴스도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680306,
					"content": "불행한 건 아니고 그다지 행복하지 않은 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730680307,
					"content": "…응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680308,
					"content": "성장하기 알맞은 토양에 적절히 내리는 빗물과 태양 빛만 있으면, 자라면서 어떤 어려움도 겪지 않아…. 그러니까 불행하진 않지만, 그렇게 행복하지도 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680309,
					"content": "오… 정말 평범 그 자체인데. 엥? 그럼 이 땅은 다른 곳이랑 달라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680310,
					"content": "바나라나의 흙은 다 좋은데, 여기는 특히 더 좋아. 거기다 제일 중요한 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680311,
					"content": "아란카라랑 아란나쿨라가 보살펴 준다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730680312,
					"content": "보살핀다는 건… 구체적으로 어떻게 한다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680313,
					"content": "연주를 들려주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680314,
					"content": "예쁘게 자라라고 칭찬해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730680315,
					"content": "이게 야생에서 자라는 거랑 집에서 자라는 것의 차이구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "무슨 말인지 알 것 같아…. 만약 매일 좋은 음악을 듣고 예쁘다는 말을 들으면 행복하지 않을 수 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680317,
					"content": "#맞아, 나도 {NICKNAME}(이)가 구해주기 전까진 그렇게 불행하지도 행복하지도 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680318,
					"content": "#하지만 {NICKNAME}와(과) 같이 여행하니 힘들 때도 있지만 행복할 때는 배로 행복하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680319,
					"content": "페이몬이 맞아, 아란카라는 행복한 비파랴스로 우트사바 축제를 위한 예쁜 등불을 만들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730680320,
					"content": "헤헤, 아란나쿨라가 다시 돌아온 김에 우리도 빨리 시작하자! 비파랴스 씨앗이… 비파랴스도 씨앗이 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680321,
					"content": "비파랴스는 대지의 잠꼬대야. 대지가 꿈을 꾸면 나타나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680322,
					"content": "그럼 씨앗은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680323,
					"content": "비파랴스는 씨앗이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730680324,
					"content": "엥? 씨앗이 없는데 모밭에 어떻게 심은 거야…. 아! 설마 아란나쿨라에게 씨앗 없이도 비파랴스를 심을 수 있는 아란라칼라리가 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680325,
					"content": "아냐, 페이몬 그게 아니야…. 모밭에 비파랴스를 심으려면 바스므리티가 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680326,
					"content": "바…바 뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680327,
					"content": "「바스므리티」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "바나는 모든 걸 기억해. 그래서 바스므리티가 있으면 대지가 꿈속에서 다시 기억을 떠올려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680329,
					"content": "모밭에도 행복한 비파랴스가 피어날 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730680330,
					"content": "#음… 그럼, 「바스므리티」는 아란나라만 얻을 수 있는 거지? 나랑 {NICKNAME}(은)는 모밭에서 비파랴스를 키워볼 기회가 없겠구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680331,
					"content": "#금빛의 나라는 나랑 다른 아란나라를 도와줬으니까 우리 아란나라의 친구야. 아란나쿨라랑 나라{NICKNAME}(이)가 함께 비파랴스를 키우면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680332,
					"content": "#바스므리티를 흙 속에 넣으면 비파랴스가 자랄 거야. 나라{NICKNAME}, 한번 해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680333,
					"content": "아란나쿨라가 말한 대로 「바스므리티」를 흙 속에 넣는다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "이러면 끝난 거야? 다른 식물 심는 거랑 다를 게 없어 보이는데! 씨앗을 흙 속에 심고 새싹이 틀 때까지 기다리는 거잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680335,
					"content": "바스므리티는 씨앗이 아니야. 페이몬이 날아다니는 고양이가 아닌 것처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730680336,
					"content": "어… 그, 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680337,
					"content": "그건 그렇고, 모밭에 아직 빈 곳이 많네. 하나, 둘, 셋… 비파랴스 열두 개는 더 심을 수 있겠다. 아란나쿨라, 바스므리티 더 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680338,
					"content": "전에는 있었는데, 지금은 없어. 다시 모아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680339,
					"content": "꿈의 바깥에 열두 개의 모밭이 있는데, 거기에 바스므리티가 열릴 거야. 그게 있으면 바나라나의 모밭에는 비파랴스가 가득 필 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680340,
					"content": "#우트사바 축제에는 비파랴스가 많이 필요해. 바나라나에는 이미 많지만, 행복한 비파랴스가 많을수록 페이몬과 나라{NICKNAME}, 아란나라가 더욱 행복해질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "아란카라"
				},
				{
					"id": 730680341,
					"content": "이렇게 된 김에 우리도 바스므리티 모으는 걸 도와줄게! 그런데 어떻게 모아야 해? 아란카라가 방금 꿈의 바깥에 있는 모밭이라고 했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680342,
					"content": "금빛의 나라, 모밭의 땅을 돌아다녀야 해. 하지만 딱 한 번만이야, 너무 많으면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680343,
					"content": "한 번만 돌면 돼… 비가 내리면 다음 날 아침 잎에 이슬이 맺히는 것처럼 모밭의 땅에 바스므리티가 열릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730680344,
					"content": "…음… 무슨 말인지 전혀 모르겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680345,
					"content": "아란나라와 교류했던 경험에 의하면… 우리가 꿈의 바깥에서 모밭을 찾으면, 방금 아란나쿨라의 말이 무슨 뜻인지 알게 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730680346,
					"content": "만약 모밭을 찾게 되면 가서 봐 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
