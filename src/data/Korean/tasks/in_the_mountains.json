					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701410505,
					"content": "맞다, 산꼭대기로 향하는 길을 열어줘서 고마워. 이건 보수니까 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410506
					],
					"speakerTitle": "옥희"
				},
