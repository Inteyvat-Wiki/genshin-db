			"dialogs": [
				{
					"id": 760840201,
					"content": "콜롬비나가 자주 흥얼거리던 노래를 연주하자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202
					]
				},
				{
					"id": 760490202,
					"content": "콜롬비나가 자주 흥얼거리던 노래를 연주하자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(어떤 감정으로 연주할까…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "잔잔하게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "듣기 좋네. 내가 흥얼거리던 멜로디를 다 기억하고 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490605,
					"content": "헤헤, 네가 노래를 워낙 잘 부르니까, 가끔 옆에서 몰래 듣기도 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490606,
					"content": "월령들도 푹 빠져서 듣더라. 잘 보고 배웠는지 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490607,
					"content": "앞으로 몇 번 더 부탁해야 할지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490608,
					"content": "자, 손 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490609,
					"content": "응? 이건 무료 공연이야. 수강료는 필요 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490610,
					"content": "응? 수강료?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490611,
					"content": "난 그냥, 예쁜 선율은 예쁜 달빛과 함께하는 게 좋을 것 같아서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490701,
					"content": "즐겁게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "벌써 끝났어? 더 듣고 싶었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490703,
					"content": "이건 내가 유일하게 기억하는 「자장가」라고 했었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490704,
					"content": "거기에 담긴 의미는 아직 잘 모르겠지만, 네 연주를 듣고 나니 이런 생각이 들어. 달에서 나를 기다리고 있는 답은, 최소한 아름다운 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490705,
					"content": "자, 손 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490706,
					"content": "이번엔 보답 같은 건 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490707,
					"content": "아냐. 그냥 이 예쁜 선율에 예쁜 달빛을 더하고 싶을 뿐인걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				}
			]
