					],
					"speakerTitle": "사나다"
				},
				{
					"id": 728070206,
					"content": "이게 진짜 히이라기 치사토 아가씨의 친필 편지라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "사나다"
				},
				{
