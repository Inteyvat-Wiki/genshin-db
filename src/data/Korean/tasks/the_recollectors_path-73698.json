				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736980101,
					"content": "훈련은 순조로운 모양이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980102,
						736980104
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 736980102,
					"content": "응, 순조로워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980103
					]
				},
				{
					"id": 736980103,
					"content": "그러게, 소루쉬에겐 너무 쉬울지도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980106,
					"content": "후후, 소루쉬가 이번에는 어떻게 할지 기대해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980107
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 736980107,
					"content": "참, 소루쉬 얘기 듣고 알게 된 건데 소루쉬 사춘기였던 거더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980108,
					"content": "쓸데없는 말 하지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980109
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980109,
					"content": "에엑——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980110,
					"content": "크흠, 어쨌든 지금 그, 그 시기는 벗어났어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980111
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980111,
					"content": "중요한 건 「찬{RUBY#[D]야스나}송의 주인」이랑 흰두둥실과 함께 페리의 탄생 역사를 회상하는 과정에서 숲속 초목의 권속과 그들의 특별한 축제 얘기가 나왔다는 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980112
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980112,
					"content": "왜 페리에겐 자신만의 축제가 없는 거죠? 선배는 이상하다고 생각하지 않나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980113
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980113,
					"content": "페리의 축제에 인간들을 불러 페리를 칭송하는 찬송가를 부르게 하고, 제가 그중에서 가장 훌륭한 녀석을 선택해야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980114
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980114,
					"content": "내가 알기로 우트사바 축제는 그런 엉망진창인 축제가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980115
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 736980115,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980116
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980116,
					"content": "소루쉬는 계속 인간들에게 업적을 기록하게 하려고 하는데, 다른 페리들과는 생각 자체가 다르네… 회의론단의 영향인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980117,
					"content": "그래서 과거를 회상하고 반성하는 행동이 의미가 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980118
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 736980118,
					"content": "후후, 아무튼 소루쉬가 이번엔 어떻게 할지 기대해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "주르반"
				},
				{
					"id": 736980104,
					"content": "그 정도는 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980105
					]
				},
				{
					"id": 736980105,
					"content": "소루쉬도 본인이 말한 것처럼 대단하진 않던걸, 앞으로 노력해야 할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980106
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7369806,
			"completionStepIds": [
				7369806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369806",
							"2"
						],
						"stepId": 7369806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소루쉬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736980601,
					"content": "아! 나 여기 알아, 전에 와봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980602,
						736980604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980602,
					"content": "확실히 기억에 남는 곳이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980603
					]
				},
				{
					"id": 736980603,
					"content": "처음 봤을 때 깜짝 놀랐다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980606,
					"content": "이 녀석이 운이 없어서 이곳에 봉인된 거라고 했던 것 같은데. 그런데 그게 소루쉬의 훈련이랑 무슨 상관이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980607,
					"content": "앗, 설마 주르반이 하려는 말은 「후후, 소루쉬, 보아라. 저게 바로 운 나쁜 녀석의 최후다」일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980608,
					"content": "풉… 선배는 그런 시시한 짓을 할 페리가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980609
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980609,
					"content": "…그보다 전에 여기 왔을 땐 자세히 말 안 했는데, 이 녀석을 이곳에 봉인한 재앙이 있어. 너희도 익숙할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980610
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980610,
					"content": "500년 전의 그…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980611,
					"content": "맞아. 순식간에 일어난 일이겠지. 근데 봐, 결정이 된 지금도 녀석은 그때 당시의 형태를 유지하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980612
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980612,
					"content": "봉인이 풀리면 동굴 안을 당장이라도 휘젓고 다닐 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980613
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980613,
					"content": "이 순간을 영원하게 만들어주지…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980614
					]
				},
				{
					"id": 736980614,
					"content": "으아, 저렇게 되고 싶지 않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980615
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980615,
					"content": "한순간에 일어난 일일지 몰라도, 으… 안 되겠어. 생각만 해도 무서워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980616,
					"content": "페이몬이 그런 일을 겪게 하진 않을 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980617
					]
				},
				{
					"id": 736980617,
					"content": "#물론이지! 나도 절대 {NICKNAME}(이)가 이런 위험을 겪게 하지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980618,
					"content": "흠, 그럼 우리 페리에게 고마워해야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980619
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980619,
					"content": "그때 당시 재난을 잠재우기 위해 페리를 포함한 수많은 종족과 생명들이 목숨을 바쳤지…. 일부는 목숨보다 더 소중한 걸 내놓기도 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980620
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980620,
					"content": "지금 우리가 이 녀석을 덮친 돌이킬 수 없는 재앙을 피할 수 있었던 건, 그때 당시 그들의 희생 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980621
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980621,
					"content": "대재앙을 직접 겪지 않았기 때문에 대지에 또다시 위기가 찾아오면, 난 꼭 무언가를 더 해내야만 한다고 생각해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980622
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980622,
					"content": "그러고 보니 이 모래벌레의 나이가 소루쉬보다 많겠네. 어떻게 보면 선배인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980623
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980623,
					"content": "하지만 다시 살아날 일은 없어. 결정화가 된 상태로 몇백 년은 지났으니 이제 남은 건 부식될 운명뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980624
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980624,
					"content": "그 재앙에 목숨을 잃은 생명은 셀 수도 없이 많아. 그중 이 운 나쁜 녀석처럼 재앙이 덮친 순간에 갇힌 녀석들도 많지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980625
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980625,
					"content": "하지만 대부분 생명들은 이 운 나쁜 녀석보다 더 운이 없어서, 수백 년의 세월에 형체조차 마모되어 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980626
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980626,
					"content": "아무것도 남지 않았고, 기억하는 이도 없고, 그들을 추모하는 사람도 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980627
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980627,
					"content": "이 운 나쁜 녀석은 거대한 몸을 가진 데다, 뙤약볕과 거센 바람이 없는 지하 동굴에서 살던 덕분에 비교적 완전한 형태를 유지할 수 있었던 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980628
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980628,
					"content": "하지만 세상에 시간을 이길 수 있는 존재는 없어. 그건 유해 또한 마찬가지지. 언젠가는 이 녀석마저 깨끗이 사라져버릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980629
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980629,
					"content": "조금 안타깝네…. 마지막엔 살아있던 흔적조차 남지 않는다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980630
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980630,
					"content": "흠, 인간들이 남긴 문서에 녀석에 대한 기록이 남아있겠지. 인간들에겐 아주 희귀해 보일 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980631
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980631,
					"content": "예전에 선배가 그랬어, 회의론단의 인간뿐만 아니라 숲에서 온 학자도 사방을 조사하고 다녔다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980632
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980632,
					"content": "일부 인간은 바람 침식 모래 벌레가 사막 뱀장어의 최종 형태라고 믿더라…. 그따위 지식과 상상력으로 작성한 기록이 어떨지 걱정되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980633
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980633,
					"content": "그걸 어떻게 믿어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980634
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980634,
					"content": "곰곰이 생각해보면 인간의 기록을 믿을 수 없는데도 소루쉬는 「찬{RUBY#[D]야스나}송의 주인」이 될 인간을 열심히 찾았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980635
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980635,
					"content": "소루쉬를 위해 만든 찬송 시가 이 결정보다 먼저 흔적도 없이 사라질지도 모르는데 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980636
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980636,
					"content": "후대의 사람들이 찬송 시를 듣게 될 때쯤이면, 페리 용자는 분홍색도 아니고 귀엽지도 않은 데다, 건장하고 믿음직스러운 외형에 온화하고 예의 바르며 충동적으로 행동하지도 않는… 음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980637
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980637,
					"content": "이상적인 용자의 이미지네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980638
					]
				},
				{
					"id": 736980638,
					"content": "소루쉬랑 조금도 닮지 않았지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980639
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980639,
					"content": "그건 안돼! 잠깐, 선배의 뜻을 알겠어. 더 그럴듯한 업적 기록 방법을 찾으라는 의미일 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980640
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980640,
					"content": "후, 역시 선배는 선견지명이 있어. 나중에 제대로 감사해야겠는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980641
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736980641,
					"content": "그런 뜻이 아닌 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736980604,
					"content": "여기가 어디였더라…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736980605
					]
				},
				{
					"id": 736980605,
					"content": "소루쉬랑 주르반을 만나러 가는 길에 여기를 지나쳤잖아, 기억 안 나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736980606
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
