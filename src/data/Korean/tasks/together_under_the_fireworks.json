			"dialogs": [
				{
					"id": 120130301,
					"content": "감히 공무 집행을 방해하다니, 간덩이가 부었구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130302
					],
					"speakerTitle": "요시타카"
				},
				{
					"id": 120130302,
					"content": "텐료 봉행은 이런 행위를 좌시하지 않을 것이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130303
					],
					"speakerTitle": "요시타카"
				},
				{
					"id": 120130303,
					"content": "어디로 도망가든 엄벌을 피할 순 없을 줄 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130304
					],
					"speakerTitle": "요시타카"
				},
				{
					"id": 120130304,
					"content": "말은 그렇게 해도 엄청 빨리 도망가네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130305
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120130305,
					"content": "시간 낭비하지 말고 계속 들어가자. 두 사람은 분명 안에 있을 거야",
