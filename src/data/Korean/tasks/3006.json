						30060513
					],
					"speakerTitle": "도리"
				},
				{
					"id": 30060512,
					"content": "원하는 가격을 말해봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				},
				{
					"id": 30060514,
					"content": "역시 통 크셔, 거래 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060515
					],
					"speakerTitle": "도리"
				},
				{
					"id": 30060515,
					"content": "돈을 지불했으니 정보를 말해줄게. 신의 항아리 지식은 어제 아흐마르의 눈의 두목 미쯔리의 차지가 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060516
					],
					"speakerTitle": "도리"
				},
				{
					"id": 30060516,
					"content": "아흐마르의 눈? 그 적왕을 섬기는 도금 여단 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060517
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30060517,
					"content": "오, 그 사람들을 잘 아나 보네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060518
					],
					"speakerTitle": "도리"
				},
				{
					"id": 30060518,
					"content": "아흐마르의 눈은 이 신의 항아리 지식을 얻기 위해서 수단과 방법을 가리지 않았어. 그들은 그 안에 있는 힘이 적왕의 힘이라고 믿고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060519
					],
					"speakerTitle": "도리"
				},
				{
					"id": 30060519,
					"content": "역시 신의 항아리 지식은 전에 봤던 것들과는 달랐어. 항아리에서 붉은빛을 내뿜더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060520
					],
					"speakerTitle": "도리"
				},
				{
					"id": 30060520,
					"content": "내가 찍은 사진에 신의 항아리 지식이 선명하게 찍혀있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060521
					],
					"speakerTitle": "도리"
				},
				{
					"id": 30060521,
					"content": "정보 고마워, 도리",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30060522,
					"content": "아니야, 너희처럼 안목 좋은 손님이 있어서 어제의 노력이 헛되지 않았다고 느껴지네. 앞으로 필요한 거 있으면 언제든지 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "도리"
				},
				{
					"id": 30060513,
					"content": "그 정보, 내가 살게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				}
			]
