			"trigger": {
				"objectNames": [
					"묘 사부"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "얼마나 남았더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320202,
					"content": "뭐 하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "하하, 뭐 하냐고? 그야 당연히 「만민당」 장사 중이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320204,
					"content": "요새 해등절이라 외식하는 사람이 많아졌거든. 외국에서 온 관광객들도 많고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320205,
					"content": "내 딸 향릉도 일을 도우러 왔지만, 그 애도 나 못지 않게 바빠. 조금 전에 또 배달하러 나갔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320206,
					"content": "다른 가게들은 일찌감치 소등을 달았지만, 우리 「만민당」은 바빠서 소등 만들 틈도 없었다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320207,
					"content": "참, 여행자, 혹시 괜찮으면 나 좀 도와주겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320208,
					"content": "아츠코 씨라고 알지? 부두에 있는 이나즈마에서 온 그 아가씨 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320209,
					"content": "그분이 음식을 주문했거든. 네가 좀 갖다 줬으면 해. 명절이라 특별히 양을 좀 푸짐하게 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320210,
					"content": "그리고 항상 부두에서 일하는 <color=#00E1FFFF>왕반자, 이망치, 관해, 지화</color> 씨도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320211,
					"content": "다들 우리 가게 단골손님들인데 명절 때도 부두에서 일을 하는 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320212,
					"content": "모처럼 명절이니 그분들한테도 맛있는 걸 좀 준비해드리고 싶은데, 가게가 너무 바빠서 자릴 비울 수가 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320213,
					"content": "그러니까 여행자, 가는 김에 그들한테 뭐가 제일 먹고 싶은지 물어봐 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 413320214,
					"content": "내게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "그럼 부탁할게. 물어보고 바로 나한테 알려주렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "묘 사부"
				}
			]
		},
