				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "여기 서서 책 보는 게 네가 의를 행하는 방식이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000602,
					"content": "재밌군, 재밌어. 이런 일도 있었다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000603,
					"content": "야! 사람이 말을 하면 좀 들어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000604,
					"content": "그렇군, 역시 많은 사랑을 받는 데엔 다 이유가 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000608,
					"content": "야——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000605,
					"content": "방금 그 기세등등한 사람들은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "맞아. 헐값으로 광석 사겠다고 상 어르신을 괴롭히다니, 강도랑 다를 게 뭐야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000609,
					"content": "상구야 어르신을 도울 방법을 찾아야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "나도 껴줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000613,
					"content": "뭐야, 우리가 하는 말 다 듣고 있었잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000614,
					"content": "상황이 나빠지면 이 책도 결국 저당 잡히실 게 뻔해서 빌려온 거야, 그러기엔 너무 아까운 책이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000615,
					"content": "상 어르신께 했던 말이 빈말은 아니야. 은혜를 받았으면 갚는 게 협객의 대의지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000616,
					"content": "이 책은 일단 내가 대신 보관하고 나머지 책들도 내가 다 받아오고 말겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000617,
					"content": "무슨 계획이라도 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "당연히 있지. 이미 실마리를 잡았으니 세세한 부분만 생각해보면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000620,
					"content": "음, 나한테 생각할 시간을 조금만 줘. 오래 걸리진 않을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000621,
					"content": "아직도 여기서 얼쩡대고 있네. 정말 내가 말로만 겁주는 것 같아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000622,
					"content": "두부파는 사람도 실력도 없으면서 간덩이만 부었군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000623,
					"content": "아, 실수, 고화파였지! 고화파, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000624,
					"content": "「개미가 큰 나무를 흔들다니, 가소롭기 짝이 없다」라는 말이 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000625,
					"content": "뭐? 어디서 유식한 척 폼을 잡아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000626,
					"content": "돌아가시죠. 전 강압적인 장사는 용납 못 합니다. 게다가 제가 신세 진 상 어르신의 일이라면 더더욱이요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000627,
					"content": "이 자식, 또 상 씨를 도우려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000628,
					"content": "날을 잘못 잡았군. 봐, 오늘은 「우인단」의 어르신이 계시니 고화파 놈들이 수십 명이 있어도 어림없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000629,
					"content": "소생 비록 나이가 젊지만, 그래도 강호에서 몇 년을 구른 몸. 악한 자들을 피한 적은 없습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000630,
					"content": "그럼 본때를 보여주마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "창호"
				},
				{
					"id": 120000618,
					"content": "계획이 있어 보이진 않는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "리월편은 읽을 수 없을 것 같네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "책을 찾으러 왔으면서, 이렇게 쉽게 포기하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000606,
					"content": "아까 그 사람들 무재공 밑에서 일한다고 했지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
