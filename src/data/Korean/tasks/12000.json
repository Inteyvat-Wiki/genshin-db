						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"행추"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120001001,
					"content": "허리춤에 달린 게 그냥 평범한 옥이 아니라… 「신의 눈」이었다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120001002,
					"content": "오, 오늘은 이만 보내주지! 두고 봐! 아직 끝난 게 아니니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120001022,
					"content": "휴, 저들이 정신 차리길 기대하는 건 불가능한 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001003,
					"content": "너한테 「신의 눈」이 있었다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "응. 하지만 「신의 눈」으로 적을 상대하는 건 약한 사람들을 괴롭히는 것 같아서 별로 안 좋아해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001008,
					"content": "지금은 그냥 물러났지만, 분명 다시 찾아올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120001009,
					"content": "나도 알아. 내 은인에게 해를 끼치진 않을 거야. 장사에는 상도가 있는 법, 이 일은 내가 끝까지 책임지겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001010,
					"content": "「우인단」이 어느 상인의 편을 드는 경우는 드문데, 아까 그 하인의 태도를 보니 거짓말을 하는 것 같지는 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001011,
					"content": "분명 더 깊은 유착이 있는 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001012,
					"content": "아까 그들이 언급한 「무재공」이라는 이름도 들어본 적 있어. 그는 리월항에서 눈에 띄는 저택에서 살고 있지. 너희가 가서 단서를 찾아봐 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001013,
					"content": "일리 있는 말이긴 한데…. 그럼 넌 뭘 할 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120001014,
					"content": "나? 난 또 알아볼 일이 있거든. 음… 나중에 리월항의 옥경대에서 만나자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001015,
					"content": "진짜? 그냥 우리한테 귀찮은 일을 떠넘기려는 건 아니고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120001016,
					"content": "오오, 이런 일이 일어나다니. 이 부분은 참으로 절묘하군, 절묘해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001017,
					"content": "으으으! 짜증 나 죽겠네! 나 얘 때려도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120001018,
					"content": "먼저 상구야부터 도와드리자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "알았어, 하지만 날 화나게 만드는 사람한텐 전부 이상한 별명을 지어줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120001021,
					"content": "저 녀석은 이제부터 「책벌레」야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120001019,
					"content": "군자의 복수는 십 년 뒤에 해도 늦지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001005,
					"content": "그럼 고화파는 사실 고수들이 모여 있는 와호장룡의 곳이었던 거야?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001006
					]
				},
				{
					"id": 120001006,
					"content": "아니, 그건 오해야. 아까 그 자가 한 말은 화가 나지만, 고화파에 대한 평가는… 사실 틀린 말이 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001007
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120001007,
					"content": "문파를 다시 일으키고는 싶지만, 하루아침에 될 일은 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "행추"
				}
			]
		},
