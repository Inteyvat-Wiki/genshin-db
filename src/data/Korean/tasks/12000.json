				"points": []
			},
			"dialogs": [
				{
					"id": 120000201,
					"content": "「만문집사」…. 여기가 리월항의 서점이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000202,
					"content": "여기에 《티바트 유람 가이드》 리월편이 있는지 물어보자! 그 책 완전 재밌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"기향"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "안 사도 되니까, 천천히 둘러봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "기향"
				},
				{
					"id": 120000302,
					"content": "우린 책을 찾으러 왔어. 혹시 여기 《티바트 유람 가이드》의 리월편 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000303,
					"content": "그 책은 인기가 없어서 안 판 지 오래됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "기향"
				},
				{
					"id": 120000304,
					"content": "엥?! 그 책, 몬드편도 진짜 재밌었는데… 아쉽다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000305,
					"content": "그 책의 저자는 개성이 너무 강해. 여행 가이드라는 이름에 맞지 않게 가이드 역할은 하나도 못 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "기향"
				},
				{
					"id": 120000306,
					"content": "잘 팔리지도 않는 데다 책을 산 손님들이 불만을 토로한 적도 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "기향"
				},
				{
					"id": 120000307,
					"content": "개성이 너무 강한 건가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "그래도 아쉽네. 몬드편은 모험 일기 같아서 재밌게 읽었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000310,
					"content": "아무튼 여긴 없어. 정말로 읽고 싶으면 상구야라는 분께 가봐, 거기엔 아직 있을 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "기향"
				},
				{
					"id": 120000311,
					"content": "상구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000312,
					"content": "상 어르신은 경책 산장에 살면서 여러 가지 책들을 수집하셔. 성질이 고약하시긴 하지만 책에 대한 이야기를 하실 땐 입담이 넘치지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "기향"
				},
				{
					"id": 120000313,
					"content": "어르신은 리월항에 계실 때부터 내 단골손님이었어. 지금도 가끔 절판된 책을 보내주곤 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "기향"
				},
				{
					"id": 120000324,
					"content": "하지만 상 어르신이 계신 곳을 찾긴 어려울 거야, 경책 산장 뒷산의 잔도를 따라 쭉 올라가야 하거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "기향"
				},
				{
					"id": 120000314,
					"content": "절판된 책이라 하셨습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000315,
					"content": "그럼 이미 절판된 《신소절극록》 6권이 그에게 있을지도 모르겠군요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000316,
					"content": "넌 누구야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "실례했군. 소생의 이름은 행추. 그저 우연히 길을 지나던 애서가라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000319,
					"content": "우리 둘 다 책을 찾고 있는 것 같은데, 함께 경책산에 상구야라는 분을 찾으러 가지 않겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000320,
					"content": "맞는 말이야, 그럼 길 안내를 부탁해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "같은 애서가끼리 사양할 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "행추"
				},
				{
					"id": 120000322,
					"content": "그렇게 멀리까지 갈 생각은 없는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "그런 말 마시게. 가끔은 이 시끌벅적한 리월항을 벗어나 신선한 공기도 마셔줘야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "행추"
				},
				{
					"id": 120000317,
					"content": "갑자기 나타나서 놀랐잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "범죄를 부추기는 내용이라도 있는 건가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
			"completionStepIds": [
				1200005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200005",
							"2"
						],
						"stepId": 1200005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"상구야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "아이고, 하늘이 날 망하게 하는구나…. 하늘이… 날 망하게 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000502,
					"content": "당신이 상구야인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "응? 무슨 일인가? 할 말 있으면 빨리해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000504,
					"content": "여기에 절판된 책들이 많다고 들었어. 우린 《티바트 유람 가이드》의 리월편을 빌리러 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000505,
					"content": "휴, 책 얘기는 꺼내지도 마! 짜증 나 죽겠으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000506,
					"content": "층암거연이 봉쇄된 뒤부터 광석 사업이 망하게 생겼어. 「우인단」도 여전히 음모를 꾸미고 있고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000507,
					"content": "대금을 모으기 위해 내가 애지중지 모은 책들이 모두 저당 잡혔단 말이야…! 이게 뭘 의미하는지 알아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000508,
					"content": "…읽을 책이 없어서 속상하신 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "아니! 내 인생이 사라졌어! 내가 평생을 모으고 지켜온 건데! 내 책들이… 전부 사라졌다고!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000511,
					"content": "휴… 너희한테 화내봤자 무슨 소용이 있겠어. 하루빨리 대금을 구해서 책을 다시 돌려받아야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000512,
					"content": "대화할 기분 아니니까 더 할 말 없으면 어서 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000513,
					"content": "설마, 《신소절극록》 6권마저 저당 잡히신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000514,
					"content": "응? 그 책을 알다니…. 넌 좀 품격 있군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000515,
					"content": "그럼 우린 품격이 없다는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000516,
					"content": "그건 시대적 의미를 지닌 기서야. 처음 출판됐을 땐 아무도 좋아해 주지 않았지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000517,
					"content": "그러나 그 책은 무협 소설에 대한 사람들의 인식을 많이 바꿔놓았어. 그 뒤로 모방자들도 많이 생겨났지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000518,
					"content": "제일 처음 출판됐을 땐 양이 매우 적어 단번에 절판됐었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000519,
					"content": "나중에 추가 인쇄 버전에 스토리를 보충하기 위해 6권을 냈는데, 무슨 이유에선지 그 뒤론 재간되지 않았죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000520,
					"content": "맞아, 그렇다니까! 워낙 희귀한 거라, 아무리 돈이 부족해도 그것만은 내놓을 수 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000521,
					"content": "그렇다면, 아직 가지고 계신다는 건가요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000522,
					"content": "그래, 내게 남은 유일한 애장서야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000523,
					"content": "어이, 상 씨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000524,
					"content": "질질 끌지 말라고, 우리 어르신이 너무 봐줘서 그래? 그 콜 라피스 팔 거야 말 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000525,
					"content": "무재공을 화나게 하는 건 「우인단」을 화나게 하는 것과 마찬가지라는 걸 모르진 않겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000526,
					"content": "또 왔군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000527,
					"content": "그렇다고 콜 라피스를 3할의 가격에 팔순 없잖아. 그렇게 되면… 내 책들을 다시는 돌려받지 못할지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000528,
					"content": "그건 내 알 바 아니고. 책을 볼 건지 밥을 먹을 건지 정하기나 하시지. 아니면 책 싸 들고 관으로 들어갈래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000529,
					"content": "으… 너 이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000530,
					"content": "그렇게 말씀하시면 안 되죠. 장사란 서로 원해서 하는 게 도리인데, 어찌 판매를 강요하십니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000531,
					"content": "넌 또 뭐야? 너랑 무슨 상관인데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000532,
					"content": "소인은 불의를 참지 못하는 의협지사, 고화파 행추입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000533,
					"content": "푸… 푸하하하——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000534,
					"content": "고화파, 고화파래! 하하하——! 들었어? 이 시대에 아직도 고화파를 들먹이는 사람이 있다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000535,
					"content": "후대가 끊겨 몰락한 작은 문파잖아? 그런데 정의를 행하겠다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000536,
					"content": "정의와 신분은 관계없습니다. 당신도 그저 하인일 뿐인데, 주인의 힘만 믿고 허세 부리며 버젓이 나쁜 짓을 하고 있잖습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000537,
					"content": "이… 이 자식! 너, 딱 기다려! 아주 작살을 내줄 테니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000538,
					"content": "그리고 상 씨! 그 광석은 싫어도 무조건 팔아야 할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "창호"
				},
				{
					"id": 120000539,
					"content": "에휴, 내 팔자야. 내가 어쩌다 저런 놈한테. 못 살겠다 못 살겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000540,
					"content": "그나저나, 그 책을 저에게 빌려주실 수 있습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000541,
					"content": "너무 무관심한 거 아니야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "아니야, 됐어. 나도 다른 사람이 내 걱정 하는 건 바라지도 않아. 아까 내 편을 들어줬으니 어서 책 들고 가버려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000544,
					"content": "감사합니다! 이 책을 3년 넘게 찾았는데, 책을 빌려주신 이 은혜 꼭 갚겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120000545,
					"content": "됐어, 고화파 제자에게 그런 기대는 하지도 않으니까 잊지 말고 책을 돌려주기나 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120000546,
					"content": "야! 그냥 이렇게 가버린다고? 아직 뭐가 뭔지도 모르잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120000542,
					"content": "제발 분위기 파악 좀 해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "…읽을 책이 없어서 심심하신 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
