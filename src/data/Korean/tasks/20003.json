			},
			"dialogs": [
				{
					"id": 200030501,
					"content": "모나, 집에 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200030502,
					"content": "모나, 월세 내야 해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "음… 모나가 집에 없는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200030504,
					"content": "이상하다, 원래는 집에만 틀어박혀있지 않았었나? 일이 있어서 잠시 나간 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200030505,
					"content": "설, 설마! 아무것도 못 먹어서 문 열 힘도 대꾸할 힘도 없는 건 아니겠지!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200030506,
					"content": "에이 설마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "그, 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200030509,
					"content": "근데 어디서 모나를 찾지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200030507,
					"content": "전에 돈을 벌 방법을 찾았다고 했잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				}
			]
