			"dialogs": [
				{
					"id": 200030601,
					"content": "기사단의 도서관",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030602
					]
				},
				{
					"id": 200030602,
					"content": "도서관이라…응! 기사단 도서관은 엄청 크니까 모나가 자료 찾으러 갔을 수도 있겠네",
					"roleType": "TALK_ROLE_NPC",
