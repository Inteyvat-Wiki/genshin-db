			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"고트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030301,
					"content": "정말 고맙네. 이 정도면 충분해. 그럼 난 바로 목수한테 목재를 건네주러 감세… 아, 월세도 받으러 가야 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030302
					],
					"speakerTitle": "고트"
				},
				{
					"id": 200030302,
					"content": "휴, 그… 아스… 아스… 뭐시기 모나…가 이번엔 집에 있으려나 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030303
					],
					"speakerTitle": "고트"
				},
				{
					"id": 200030303,
					"content": "아스트로지스트·모나·메기스토스예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030304
					]
				},
				{
					"id": 200030304,
					"content": "맞아! 그 이름이야, 아이고… 이름이 너무 길어서 외우기 힘들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030305
					],
					"speakerTitle": "고트"
				},
				{
					"id": 200030305,
					"content": "엥? 모나가 월세를 안 냈어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200030306,
					"content": "그렇다네. 다른 사람들은 다 냈는데, 그 아이만 안 냈지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030307
					],
					"speakerTitle": "고트"
				},
				{
					"id": 200030307,
					"content": "집에 여러 번 찾아갔었는데, 매번 집에 없더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030308
					],
					"speakerTitle": "고트"
				},
				{
					"id": 200030308,
					"content": "여행자, 나 대신 모나를 찾아가서 월세를 좀 재촉해줄 수 있겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "고트"
				}
			]
		},
