			},
			"dialogs": [
				{
					"id": 401060116,
					"content": "(전에 했던 조사에 대해 숨긴다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060117
					]
				},
				{
					"id": 401060117,
					"content": "미안, 계속 학부 대항전에 대해 생각하느라 나도 모르게 말이 많아졌네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060118
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060118,
					"content": "기분이 안 좋아 보이는데… 정말 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401060119,
					"content": "괜찮아, 다 지나간 일이잖아. 사람은 앞을 바라보며 살아야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카베"
				}
			]
		},
		{
			"id": 7352404,
			"completionStepIds": [
				7352406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
