			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카베",
					"알하이탐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060201,
					"content": "밥 먹으러 안 오고 어디 갔었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060202
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060202,
					"content": "너한테 그런 것까지 보고할 의무는 없을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060203
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 401060203,
					"content": "또 어디에 처박혀서 책 보고 있었던 건 아니지? 좀 바뀔 때도 됐잖아. 사람은 책으로만 살 수 없다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060204
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060204,
					"content": "네가 사주는 밥으로 살아남는 게 더 어렵겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060205
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 401060205,
					"content": "너…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060206
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060206,
					"content": "흥, 뻔하지 뭐. 사카인을 조사하러 간 거잖아? 그 메모만 봐도 알 수 있어. 근데 네가 그의 연구에 흥미를 느낄 것 같진 않은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060207
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060207,
					"content": "그 사람이 한 짓은 불쾌하기 짝이 없고, 너야 뭐… 솔직히 네 견해는 마음에 안 들지만, 너와 사카인은 다른 부류니까 관점도 다르겠지. 이기주의와 허무주의는 다르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060208
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060208,
					"content": "흥미는 둘째 치고, 혼자 이 정도 규모의 실험을 남겼다는 건 어느 정도 의미 있는 일이긴 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060209
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 401060209,
					"content": "그리고 칭찬 고마워. 다만 난 지금 아카데미아로 가는 중이라 그런 얘기는 별로 듣고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060210
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 401060210,
					"content": "학자로서 이념에 대해 토론하는 것보다 가치 있는 게 어딨다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060211
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060211,
					"content": "내가 알기론 네가 불쾌하다고 생각하는 사카인이 20년 전에 네 아버지와 만났을 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060212
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 401060212,
					"content": "…뭐라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060213
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060213,
					"content": "…설마… 아니, 그런 거였다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060214
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060214,
					"content": "하, 그래서 사카인이 날 보고 낯이 익다고 생각했던 거야. 아버지가 사막에 갔던 것도 그 사람의 영향을 받아서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060215
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060215,
					"content": "아마 그럴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060216
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 401060216,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060217
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060217,
					"content": "왕관을 깨뜨려서 다행이야. 앞으론… 그런 일이 일어나지 않겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060218
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060218,
					"content": "지식의 경계는 끊임없이 확장되고 있어. 언젠간 같은 연구를 하는 사람이 또 나타나겠지. 그게 인론파에도 합리적인 연구 방향이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060219
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 401060219,
					"content": "또 그 얘기야? 정말 네 말대로 인간이 늘 지식의 함정에 빠진다고 해도, 일이 꼭 그렇게 흘러갈 거란 보장은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060220
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060220,
					"content": "그리고 일부 개체와 집단의 행동이 꼭 일치하는 건 아니라고. 사카인은 특별한 케이스야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060221
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401060221,
					"content": "사카인을 막은 너도 마찬가지지. 이런 갈등 자체가 특별한 거야. 하지만 갈등은 현재에만 벌어지지 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060222
					],
					"speakerTitle": "알하이탐"
