			"trigger": {
				"objectNames": [
					"타들라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "오실 줄 알았어요. 너무 기쁘네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732820402,
					"content": "절 찾는다고 들었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "항상 지금 이 시간의 사막이 가장 아름답다고 생각해왔어요. 정말 좋네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732820405,
					"content": "하지만 안타깝게도… 지금껏 여기서 친구와 함께 서서히 저무는 태양을 같이 볼 기회가 없었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732820406,
					"content": "그러네. 온 사막이 이렇게 붉게 물들다니… 너무 예쁘고 평화로워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732820407,
					"content": "근데 타들라, 우리를 따로 부른 게 이거 때문이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732820408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732820409,
					"content": "타니트에게 당신은 손님이죠. 「사냥매」에겐 잠재적인 「사냥감」이고요…. 하지만 전 당신이 살아남길 바라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732820410,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "그러니, 미안해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타들라"
				},
				{
					"id": 732820403,
					"content": "잘 지냈어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
