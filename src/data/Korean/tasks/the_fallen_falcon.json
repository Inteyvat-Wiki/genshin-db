					"타들라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(그녀는 황급히 눈을 돌렸다. 그리고는 불안한 듯 고개를 숙였다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822802,
					"content": "괜찮아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "미안해요. 사냥은 이미 끝났어요. 전 아버지의 「사냥매」예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822804,
					"content": "하지만… 전 괜찮아요. 걱정하지 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822808,
					"content": "원래 그렇게 극단적이에요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "극단적이라…? 글쎄요, 전 어렸을 때부터 이렇게 살아왔는걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822814,
					"content": "아… 하지만… 여러분의 이야기와 여러분의 모험은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822815,
					"content": "기회만 된다면 더 들어보고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822816,
					"content": "그래, 우린 해줄 수 있는 이야기가 아주 많다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732822817,
					"content": "그래요, 들려줄게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "푸훗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822820,
					"content": "크흠, 아무것도 아니에요. 그냥 기뻐서… 고마… 아니, 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822818,
					"content": "듣고 싶으면 언제든지 들려줄게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "자신을 위해 살아야겠다는 생각은 안 해봤어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822812,
					"content": "…네. 그런 생각도, 기대도 해본 적 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822813,
					"content": "사막은 너무나도 가혹해서 자신을 생각할 겨를이 없어요. 제가 없어도 다른 사람들은 살아갈 수 있지만, 부족이 없다면… 전 혼자서 살아갈 방법이 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822805,
					"content": "마세리아와의 관계에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "제 아버지라고 말씀드린 적이 있죠? 저는 아버지의 「사냥매」예요. 전 그분의 명령에 따르고 그분을 위해 사냥하고 그분을 위해 죽어요…. 왜냐하면 그는 타니트의 의지를 대표하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732822807,
					"content": "만약 제가 아버지의 명령을 이행할 수 없는 상황이 되면 「사냥매」로서의 생명이 끝난다고 보면 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "타들라"
				}
			]
