			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "아, 오셨군요! 잠시만요, 부탁드리고 싶은 게 있습니다. 아마 이번이 마지막일 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "마세리아"
				},
				{
					"id": 732820102,
					"content": "말씀하세요. 뭘 도와드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "타들라가 당신을 찾고 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "마세리아"
				},
				{
					"id": 732820106,
					"content": "엥…? 무슨 일인데 그렇게 정색을 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732820107,
					"content": "북쪽 유적, 여러분이 처음 만났던 곳 근처입니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "마세리아"
				},
				{
					"id": 732820108,
					"content": "뭐라고요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "북쪽 유적, 여러분이 처음 만났던 곳 근처입니다…. 잊지 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마세리아"
				},
				{
					"id": 732820110,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "네, 그럼 잘 부탁드립니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마세리아"
				},
				{
					"id": 732820104,
					"content": "저는 다른 할 일이 있어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "부디 제 말을 들어주세요…. 타들라가 당신에게 할 얘기가 있다고 했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "마세리아"
				}
			]
		},
