				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "으… 이럴 줄 알았으면 <color=#00E1FFFF>그놈</color>을 안 돕는 건데…. 괜히 도와줬어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620302,
					"content": "「그놈」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620303,
					"content": "진짜 고마워! 큰일 날 뻔했는데 너희들 때문에 살았어. 너희가 페보니우스 기사라는 녀석보다 더 든든하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620304,
					"content": "별거 아니야, 얘는 여행자라서 매일 다양한 사건사고에 휘말린다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620305,
					"content": "여행자? 너에 대해 들은 적이 있는 것 같은데 <color=#00E1FFFF>연락책</color>에게 구조될 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620306,
					"content": "와! 그럼 네가 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620307,
					"content": "너희한테 어떻게 보답해야 할지 몰랐는데, 이왕 이렇게 된 거 정보를 무료로 제공해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620308,
					"content": "정보상들은 친구의 중요성을 잘 알고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620309,
					"content": "진짜 괜찮겠어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "당연하지, 생명의 은인이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620312,
					"content": "헤헤, 운이 좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620313,
					"content": "근데… 원래 케이아가 정보 비용을 내기로 했는데…. 걔만 이득 본 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620314,
					"content": "그럼 잘 들어, 「아카디아 유적」에 대한 정보는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620315,
					"content": "「호수 가운데에 있는 성에 팔이 6개 달린 거인이 3명 살고 있다. 둘은 신상을 수호하고 하나는 신들의 보물을 지킨다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620316,
					"content": "…? 이게 끝이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620325,
					"content": "정보가 기록된 종이에 이런 그림도 있었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620317,
					"content": "음… 여기가 바로 보물이 숨겨진 장소인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620318,
					"content": "음… 단서를 얻긴 했는데… 또 수수께끼를 풀어야 한다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620319,
					"content": "#그래도 {NICKNAME}은(는) 똑똑하니까 풀 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620320,
					"content": "당연하지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "못 풀어도 케이아한테 물어보면 되겠지, 딱 봐도 똑똑할 것 같잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620326,
					"content": "생각 안 날 때 언제든지 꺼내서 확인할 수 있도록 이걸 가지고 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "베일"
				},
				{
					"id": 4620327,
					"content": "헤헤, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620323,
					"content": "「호수 가운데에 있는 성에 팔이 6개 달린 거인이 3명 살고 있다. 둘은 신상을 수호하고 하나는 신들의 보물을 지킨다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620324,
					"content": "대체 무슨 뜻일까…? 케이아를 귀찮게 하기 싫으면 너 혼자 잘 생각해봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620321,
					"content": "…문 …제 없을 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "고마워, 친구",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
