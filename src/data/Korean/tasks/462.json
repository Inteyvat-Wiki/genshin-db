			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME}! 왔어? 보니까 단서를 얻은 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620502,
					"content": "얻긴 얻었는데… 생각한 것보다 복잡해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620503,
					"content": "「호수 가운데에 있는 성에 팔이 6개 달린 거인이 3명 살고 있다. 둘은 신상을 수호하고 하나는 신들의 보물을 지킨다」 이게 무슨 뜻일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620504,
					"content": "수수께끼라니… 진짜 고전적인데? 흠…생각 좀 해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620505,
					"content": "호수의 도시라면 몬드성일테고… 팔이 6개 달린 거인? 6이라… 뭐가 6이랑 관련되어 있었더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620506,
					"content": "설마 꽃게 다리?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "그럼 팔이 6개 달린 거인이라면 커다란 꽃게?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620508,
					"content": "…일단 커다란 꽃게 문제는 다음에 생각하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620509,
					"content": "그리고 꽃게 다리는 8개야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620516,
					"content": "…그럼 혹시 풍차?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "혹시… 풍차 아닐까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "오호~! 역시!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620519,
					"content": "풍차의 날개가 정확히 6개니까 「팔이 6개 달린 거인」 이미지랑 완전히 맞아떨어져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620510,
					"content": "우와! 그렇다면!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620511,
					"content": "나머진 쉽지. 풍차 3개 중에 2개는 신상이랑 가까우니까 그게 바로 신상을 지키는 「거인」이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620512,
					"content": "그리고 마지막 풍차가 지키고 있는 게 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620513,
					"content": "보물! 바로 보물이야! 너무 쉽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620514,
					"content": "하하하… 너희 생각처럼 순조로웠으면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4620515,
					"content": "#{NICKNAME}, 어서 가자! 빨리 저 풍차로 가서 확인해 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
