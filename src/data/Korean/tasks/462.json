			"dialogs": [
				{
					"id": 4620401,
					"content": "뭐가 숨겨져 있어? 어서 보여줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620402,
					"content": "「그녀는 그를 사랑하지 않는다. 샘물은 그저 겉으로만 열정이 넘쳐 보일 뿐. 차갑고 적막할 때 비로소 그녀의 진심이 드러난다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620407,
					"content": "이번에도 그림이 같이 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620403,
					"content": "또 수수께끼야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620404,
					"content": "으… 모르겠어…. 머리를 너무 많이 써서 페이몬… 대뇌의 전두엽이 아파온다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4620405,
					"content": "넌 그냥 아무 생각도 없잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "입 다물어! 아무튼 너에게 맡길게. 정 안되면 케이아한테 부탁해봐~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
