			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"혜심",
					"감우"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "감우 선배, 와주셔서 감사해요. 그리고 너희도 함께 와줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320202,
					"content": "천만에!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110320203,
					"content": "자리 마련하느라 수고 많았어요. 이렇게까지 안 해도 되는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320204,
					"content": "하하, 사실… 감우 선배께 감사하기도 하고, 부탁드리고 싶은 것도 있어서요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320205,
					"content": "아! 도움이 필요하면 어려워하지 말고 얼마든지 말해줘요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320206,
					"content": "아… 그게, 도움이 필요한 건 아니고… 천천히 들어주실래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320207,
					"content": "물론이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320208,
					"content": "하하… 제가 아주 어렸을 때부터, 아버지는 감우 선배 이야기를 많이 하셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320209,
					"content": "전 아버지도 무척 존경하지만, 감우 선배의 부드럽고 믿음직스러운 모습에 매료됐죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320210,
					"content": "그때부터 선배님을 동경했고, 월해정에서 일하기로 결심한 것도 그 때문이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320211,
					"content": "그렇게 좋게 봐주다니… 고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320212,
					"content": "하지만 역시 월해정 비서는 꽤 고달픈 자리였어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320213,
					"content": "전 선배처럼 업무 능력이 뛰어나지 않아서 늘 자괴감이 들어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320214,
					"content": "무슨 말이에요. 충분히 잘하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320215,
					"content": "하하, 감사해요, 선배",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320216,
					"content": "그러다가 저도 딸을 가진 엄마가 됐죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320217,
					"content": "엥? 천추 아저씨가 아니라 천추 할아버지였네?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110320218,
					"content": "제 영향을 받았는지 딸아이도 저처럼 월해정 비서가 되는 게 꿈이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320219,
					"content": "고달픈 자리라 처음엔 솔직히 걱정됐어요. 지금도 딸아이에게 그만한 자질이 있는지도 잘 모르겠구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320220,
					"content": "하지만 이번 일을 겪으며… 그 아이를 응원해 주기로 마음먹었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320221,
					"content": "음, 왜 그런 결심을…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320222,
					"content": "그 아이도 감우 선배를 만나 일을 배우게 될 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320223,
					"content": "감우 선배는 따뜻하게 가르쳐주며, '너희 엄마도 예전엔 그랬단다'라고 말해주겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320224,
					"content": "이런 상상을 하니 너무 근사하더라구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320225,
					"content": "그러니까 20년 후에도 잘 부탁드려요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320226,
					"content": "혜심 씨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320227,
					"content": "…제 존재가 혜심 씨에게 그런 의미일 줄은 몰랐어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320228,
					"content": "하하, 선배가 제게 아버지의 방법을 몸소 보여주셨잖아요. 선배 같은 「증인」이 있어서 다행이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320229,
					"content": "「증인」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320230,
					"content": "…맞아요. 전 수천 년 넘게 리월항을 지켜봐왔어요. 발전하고 변화하는 모습, 사람과 사건들…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320231,
					"content": "전 그것들이 그저 절 외롭게 만든다고만 생각했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320232,
					"content": "하지만 혜심 씨가 방금 해준 말은 제게 정말 힘이 되네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320233,
					"content": "암왕제군과 체결한 「계약」 말고, 제가 리월항의 인간 세계와 이어져있다는 느낌은 처음이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320234,
					"content": "누군가 날 믿어주고 의지하며, 증인이 되어주길 바라는 느낌은 참 근사하네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320235,
					"content": "물론이죠, 감우 선배는 세상에 하나뿐이니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320236,
					"content": "하하… 맞아요, 그러니까 모두의 기대에 부응해야겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320237,
					"content": "바로 그거야! 감우가 드디어 의욕을 되찾았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110320238,
					"content": "설령 진짜 외톨이가 된다 해도, 꿋꿋이 이겨낼 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320239,
					"content": "모두의 기대를 저버리면 안 되니까, 전 계속 「계약」에 따라 「칠성」 비서를 맡겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320240,
					"content": "휴… 처음부터 말했잖아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "어쨌든, 이제 전 돌아가 봐야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320243,
					"content": "제가 없어서 일이 다 밀렸을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320244,
					"content": "자, 일하러 가죠! 여기서 이럴 시간 없어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320245,
					"content": "힘내요! 감우 선배!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "혜심"
				},
				{
					"id": 110320246,
					"content": "이봐! 그렇게 가버리면 어떡해! 나 배고프다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110320241,
					"content": "외면받았다는 건 오해였어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
