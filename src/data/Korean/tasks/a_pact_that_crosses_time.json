	"talks": [
		{
			"id": 1103202,
			"completionStepIds": [
				1103203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103203",
							"2"
						],
						"stepId": 1103203,
