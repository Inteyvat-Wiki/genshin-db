			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"백효",
					"백식",
					"백문"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "백식"
				},
				{
					"id": 110320302,
					"content": "식아, 너 괜찮아…? 설마 서서 졸고 있는 건 아니지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "백문"
				},
				{
					"id": 110320303,
					"content": "얘들아… 누가 왔는지 좀 봐봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "백효"
				},
				{
					"id": 110320304,
					"content": "여유 부리는 걸 보니, 여러분이 제 업무를 대신한 능력자들인가 보네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320305,
					"content": "아니에요! 업무가 너무 길어져서… 이렇게 한숨이라도 돌리지 않았다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "백문"
				},
				{
					"id": 110320306,
					"content": "감우 님을 뵙지 못하고 일 더미에 깔려 죽었을 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "백효"
				},
				{
					"id": 110320307,
					"content": "감우 님, 정말 보고 싶었어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "백식"
				},
				{
					"id": 110320308,
					"content": "음, 일면식뿐이 없는데, 누가 들으면 우리가 되게 친한 줄 알겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320309,
					"content": "감우 님이 돌아오셔서 일을 맡아주시길 목이 빠져라 기다렸거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "백문"
				},
				{
					"id": 110320310,
					"content": "불쌍한 중생을 구하러 선인께서 내려와 주신 것 같은 느낌이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "백식"
				},
				{
					"id": 110320311,
					"content": "이제 아무래도 좋아요. 지금은 빨리 이 일에서 해방되고 싶은 맘뿐이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "백효"
				},
				{
					"id": 110320312,
					"content": "알았어요, 알겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320313,
					"content": "지금 주어진 업무를 정치, 경제, 민사로 분류하고, 아직 손대지 않은 것과 진행 중인 것을 표시해 주세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320314,
					"content": "나머진 제가 처리하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320315
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320315,
					"content": "넵! 바로 시작하겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320316
					],
					"speakerTitle": "백문"
				},
				{
					"id": 110320316,
					"content": "이제 좀… 살겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320317
					],
					"speakerTitle": "백식"
				},
				{
					"id": 110320317,
					"content": "아, 맞다, 그것도 처리해야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320318
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320318,
					"content": "여행자, 그동안 함께해줘서 정말 고마워요… 당신이 아니었다면 혼자 끙끙 앓았을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320319,
						110320320
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320319,
					"content": "저도 많이 즐거웠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320321
					]
				},
				{
					"id": 110320321,
					"content": "하하, 일밖에 모르고 살았는데 인간 친구가 있다는 건 생각보다 훨씬 기쁜 일이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320322
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320322,
					"content": "지금 맡은 일을 다 끝내면, 답례 겸 제가… 여행에 동참해도 될까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320323
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320323,
					"content": "하, 하지만… 감우의 일이 끝나기는 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110320324,
					"content": "…흠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320325
					],
					"speakerTitle": "감우"
				},
				{
					"id": 110320325,
					"content": "음… 나중 일은 그때 가서 생각하기로 해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "감우"
				},
				{
					"id": 110320320,
					"content": "감우 씨가 의욕을 되찾아서 기뻐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320321
					]
				}
			]
		}
	]
