			"dialogs": [
				{
					"id": 765040701,
					"content": "#{NICKNAME}, 페이몬, 안녕하세요. 식사는요? 오늘 특별한 일정이 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 765040702,
					"content": "그냥 여기저기 둘러보고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "그렇군요. 돌아다니면서 카메라로 주변을 기록하는 건 괜찮은 휴식 방법이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 765040705,
					"content": "근데 당신의 몸에서 사진기가 감지되지 않습니다. 나올 때 너무 바빠서 두고 온 거 아닌가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이네파"
				},
				{
					"id": 765040703,
					"content": "촬영 소재 찾으면서",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				}
			]
		},
