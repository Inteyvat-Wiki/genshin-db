					"아란가루",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "어때, 뭐 좀 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730580202,
					"content": "으… 애매모호한 명령밖에 못 찾았어! 아, 그리고 이거! 바람에 말린 꽃도 있었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730580203,
					"content": "앗…! 이거, 나한테 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730580204,
					"content": "이건 나쁜 사람이 남긴 거야. 독 같은 게 있을 수도 있는데… 걱정되지도 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730580205,
					"content": "이 꽃은… 본 적이 있어, 그 나쁜 나라도 아마 본 적이 있는 것 같아… 그러니까 나한테 줘도 괜찮아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730580206,
					"content": "자, 여기",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#고마워! 나라{NICKNAME}(이)랑 하얀 둥실이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 730580208,
					"content": "아란가루는 바람에 말린 작은 꽃을 가지고 마우티이마 숲으로 향했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7305804,
