			"dialogs": [
				{
					"id": 740360101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360102,
						740360103
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360102,
					"content": "윤 씨?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				},
				{
					"id": 740360104,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360105
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360105,
					"content": "윤 씨!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360106
					]
				},
				{
					"id": 740360106,
					"content": "네?! 왜요? 다 썼어요! 다 썼다고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360107
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360107,
					"content": "저예요. 제안서는 다 썼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360108
					]
				},
				{
					"id": 740360108,
					"content": "아, 당신이군요. 제… 제가 깜박 잠이 들었나 봐요. 죄송해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360109
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360109,
					"content": "로이알트 씨랑 세멘 씨가 저랑 같이 밤을 새 주셨어요. 두 분의 가르침 덕분에 제안서를 완성할 수 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360110
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360110,
					"content": "너무 피곤해서 잠깐 눈 좀 붙인다는 게 지금까지 잤네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360111
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360111,
					"content": "일단 세일러한테 가서 제안서에 행정청 직인을 찍은 다음, 뒤포르 씨 도장을 받고 정식으로 인쇄하면… 그럼 끝이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360112,
						740360113
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360112,
					"content": "간단한 것 같은데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360114,
					"content": "그러니까요! 게다가 세일러 쪽에서 신형 도장 기계를 들여왔다던데, 편의성과 보안성을 모두 갖췄다고 하더라고요. 행정청 전체에 들여놓을 거래요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360115
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360115,
					"content": "보세요, 로이알트 씨가 열쇠까지 주셨어요. 각 부서마다 가지고 있는데 이 열쇠가 있어야 도장 기계를 켤 수 있대요…. 꽤 제대로 하는 것 같죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360116
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740360116,
					"content": "음, 일단 한숨 자는 게 어때? 제대로 걷지도 못할 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740360117,
					"content": "어차피 그냥 도장 하나 찍는 것뿐이고, 그 뭐야… 도장 기계도 있다면서? 이렇게 급하게 움직일 필요 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740360118,
					"content": "아뇨, 더 시간을 지체할 순 없어요. 지금 바로 가죠. 말 그대로 그냥 도장 하나 받는 거니까 시간도 별로 안 걸릴 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "윤"
				},
				{
					"id": 740360113,
					"content": "전처럼 복잡하진 않은 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360103,
					"content": "작업 다… 끝냈어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				}
			]
		},
