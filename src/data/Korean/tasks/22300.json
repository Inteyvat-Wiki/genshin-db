			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"막승"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "이 정도면 됐겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000102,
					"content": "뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "암왕제군께 경배를 드리는 중이야. 음, 넌 여기 토박이가 아니구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000104,
					"content": "여긴 의암전이야. 암왕제군께 제사를 지내는 곳이지. 리월항 사람들은 여기 와서 향을 피우며 행운을 빌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000105,
					"content": "난 사는 곳이 멀어서 자주 못 와. 그래서 한번 오면 최대한 오랫동안 머무는 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000106,
					"content": "나도 암왕제군님에 관한 서적을 많이 읽었어. 볼 때마다 그분이 얼마나 대단하신 분인지 깨닫게 되더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000107,
					"content": "암왕제군께서 리월항을 위해 하신 일에 비해 난 그저 조금 멀리 와서 향을 피운 것뿐이지만 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000108,
					"content": "참, 넌 암왕제군님을 잘 모르지? 내가 그분이 하신 일들을 다 말해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000109,
					"content": "근데 듣기만 해선 별로 크게 와닿지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000110,
					"content": "음… 아니면 <color=#00E1FFFF>리월항 인근</color>에서 물건을 좀 찾아 와. 실물과 함께 암왕제군께서 하신 일들을 이야기해줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000111,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "그럼 여기서 기다리고 있을 테니, 빨리 갔다 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "막승"
				},
				{
					"id": 223000113,
					"content": "정확히 어떤 물건인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "<color=#00E1FFFF>리월항</color> 혹은 네 생각에 <color=#00E1FFFF>암왕제군 님과 관련된</color> 물건이면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000115,
					"content": "하지만 나도 알고 있는 이야기가 많진 않으니…. 아무거나 무작정 갖고 오면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223000116,
					"content": "네가 가져오면 확인해볼 테니, 어서 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "막승"
				}
			]
		},
