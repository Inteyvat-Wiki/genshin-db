			]
		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"막승"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "하하, 광석이네. 「바위」의 뜻을 잘 이해하고 있군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001002,
					"content": "리월항의 선조들에게 이 광석들은 제련하는 데 사용됐을 뿐만 아니라 더 중요한 역할을 했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001003,
					"content": "최초의 선조들이 이곳에 도착하여 황무지를 개척할 때, 그들은 돌로 부뚜막을 만들고 돌을 서로 부딪혀서 불도 지폈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001004,
					"content": "불이 있으니 밥을 만들어 먹기 시작했지. 사람들은 따뜻한 밥을 먹어야 열심히 일할 힘이 생기거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001005,
					"content": "이건 모두 「돌」에서 온 거야, 즉 암왕제군님의 은총이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001006,
					"content": "그래서 몇몇 서적에는 암왕제군님을 「주방의 신」이라고도 부르고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001007,
					"content": "식당이나 술집을 새로 개업한 주인장들은 모두 암왕제군께 향을 피워 부뚜막의 불씨가 꺼지지 않고 장사가 잘되길 기도해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001008,
					"content": "너도 다음에 리월항의 식당에서 밥을 먹을 때는 마음속으로 암왕제군님께 감사의 인사를 올리는 거 잊지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "막승"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"막승"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "야외에서 채굴한 거야? 엄청 힘들었겠는데, 고생했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001102,
					"content": "음… 봤지? 지금의 리월항은 규모가 엄청 커",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001103,
					"content": "하지만 아무리 큰 도시라도 아주 작은 벽돌과 기왓장으로 세워진 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001104,
					"content": "우리 선조들이 여기에 처음 발을 들였을 땐 「리월항」 같은 건 존재하지도 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001105,
					"content": "선조들의 땀과 용기로 이 거대한 도시가 만들어진 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001106,
					"content": "너도 알겠지만 리월항 인근엔 울퉁불퉁한 바위산이 많아 개척하기 매우 어려워. 하지만 이 식물들은 이런 바위산에서도 뿌리를 내리며 자라고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001107,
					"content": "다양한 용도로 사용되는 이 식물들은 땅을 계속해서 개척해 나가는 선조들에게 큰 힘이 됐어. 사람들은 이 또한 암왕제군께서 도우시는 거라 믿었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001108,
					"content": "선조들의 이야기는 리월항에서 대대로 전해져 내려오고 있어. 몇몇 리월항 출신의 모험가들은 여전히 이 이야기들에 감화되어 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001109,
					"content": "그들은 선조들의 개척 정신을 계승했을 뿐만 아니라, 암왕제군님을 「개척의 신」으로 숭배하기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "막승"
				},
				{
					"id": 223001110,
					"content": "바위처럼 단단한 불굴의 의지를 지닌 모험가가 되는 게 바로 그들의 목표야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "막승"
				}
			]
		},
