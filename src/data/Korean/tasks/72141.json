						721410606
					],
					"speakerTitle": "와시즈"
				},
				{
					"id": 721410606,
					"content": "「그분」의 상은 멀리 있지 않아. 내일 받을 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
