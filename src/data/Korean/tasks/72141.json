					"nextDialogs": [
						721411807
					],
					"speakerTitle": "와시즈"
				},
				{
					"id": 721411807,
					"content": "그녀는 당신에게 선택받았어도, 결국 도망가고 저희를 배신했지 않습니까!",
					"roleType": "TALK_ROLE_NPC",
