			"dialogs": [
				{
					"id": 733280201,
					"content": "잘 지내! 다음에 또 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280202,
					"content": "우린 어디서 또 만나게 될까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "글쎄, 셀레스티아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280204,
					"content": "하하하, 농담이야! 하지만 네가 거기서 날 보고 싶어한다면, 난 분명 그곳에 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280205,
					"content": "왜냐고 묻지는 마. 느낌이 그러니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280208,
					"content": "어쨌든 다음에 또 만나자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				},
				{
					"id": 733280206,
					"content": "너도 잘 지내야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "하하, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "제트"
				}
			]
		}
