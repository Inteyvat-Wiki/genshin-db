			},
			"dialogs": [
				{
					"id": 733280101,
					"content": "너였구나, 제트——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}! 페이몬도 있네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280103,
					"content": "삐삐——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "붐붐"
				},
				{
					"id": 733280104,
					"content": "하하, 내 말이 맞지? 또 만났잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280105,
					"content": "여기서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "음… 여자의 비밀?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280107,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733280108,
					"content": "#{M#묻지 말라는 뜻이야! 나도 사생활이 있다고…}{F#선술집에서 날 기쁘게 해준다면 털어놓게 될지도 몰라…. 이렇게까지 알려줘야 해?}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280109,
					"content": "#{M#풉… 호송국 규정이라 말해줄 수 없어. 미안해}{F#노, 농담이야! 호송국 규정 때문에 이번 화물은 비밀로 해야 하거든…. 미안해}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280110,
					"content": "흥, 정말 수상해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733280111,
					"content": "그래서… 요즘 어떻게 지냈어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280112,
					"content": "괜찮게 지내고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "음… 나도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280115,
					"content": "그래, 더는 시간 뺏지 않을게. 휴… 나도 해야 할 일이 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280116,
					"content": "어? 제트가 이렇게 바빴나…. 예전엔 안 그랬는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733280117,
					"content": "풉… 하는 일은 똑같지만 「안정적인」 일을 구했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280118,
					"content": "호송국 일을 시작한 지 얼마 안 되었는데도 벌써 자유로웠던 날들이 그리워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280119,
					"content": "네가 어떤 상황인지는 모르지만 네 이야기를 기다려왔어. 그리고 나도 네게 들려줄 이야기가 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280120,
					"content": "하지만 조급해하지 않을게. 이야기는 쌓아두고 묵혀두는 게 좋으니까. 그건 여행자들이 사막에서 살아남는 법이기도 해! 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280121,
					"content": "음… 어쨌든 늘 건강해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280122,
					"content": "너도 건강해야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "응, 널 위해 항상 기도할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733280124,
					"content": "삐삐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "붐붐"
				},
				{
					"id": 733280125,
					"content": "하하, 붐붐도 그럴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				},
				{
					"id": 733280113,
					"content": "그냥 그래…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
		{
