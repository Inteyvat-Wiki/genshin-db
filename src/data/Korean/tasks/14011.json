						],
						"pointId": 5844
					}
				]
			},
			"dialogs": [
				{
					"id": 140110301,
					"content": "미안, 너흰 그냥 가볍게 산책 나온 건데 내가 괜히 무거운 화제만 꺼낸 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110302
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110302,
					"content": "괜찮아. 이런 푸리나도 신선하고 좋은걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140110303,
					"content": "그래, 고마워. 그럼 좀 더 같이 있어 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110304
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110304,
					"content": "너희도 느꼈을지 모르지만, 내가 과거의 나를 받아들이지 못하는 건, 단순히 오랫동안 아파하고 외로워했기 때문만은 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110305
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110305,
					"content": "배 가장자리에 서 있으면, 머릿속에 물이 차오르던 그때의 장면이 떠올라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110306
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110306,
					"content": "생명이 하나둘 녹아 물이 됐고, 푸아송 마을 주민의 소중한 삶과 추억은 거품이 돼 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110307
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110307,
					"content": "신의 보호 아래, 사람들은 재앙이 강림하기 전 강대한 존재가 나타나 지켜줄 거라 믿었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110308
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110308,
					"content": "나도 사람들이 그렇게 믿게끔 끝없이 연기를 했고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110309
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110309,
					"content": "그런데 정말로 물이 차올랐을 때, 「물의 신」은 아무것도 하지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110310
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110310,
					"content": "그렇게 말하지 마. 그땐 너도 네 책임을 다한 것뿐이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140110311,
					"content": "자기를 너무 내몰지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110312
					]
				},
				{
					"id": 140110312,
					"content": "진실을 지키기 위해, 난 줄곧 비슷한 일을 겪어야 했어. 그럴수록 고통과 고독은 커져만 갔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110313
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110313,
					"content": "그러다 점점, 진실 말고는 아무것도 없게 됐어. 완전히 실패해서 자리에 주저앉아 울게 될까 두려웠고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110314
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110314,
					"content": "다행히 너희와 많은 영웅의 도움 덕에 최악의 결말은 피할 수 있었지만 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110315
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110315,
					"content": "다들 자신의 책임과 의무를 다하고 있는데, 나는… 다시 자유의 몸이 됐네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110316
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110316,
					"content": "생각해 보면, 자유란 건 날 필요로 하는 사람이 없다는 거잖아? 이제 난 쓸모가 없어졌으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110317
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110317,
					"content": "그렇게 생각하는 줄은 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140110318,
					"content": "자유는 너에게 주는 포상이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110319
					]
				},
				{
					"id": 140110319,
					"content": "포상?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110320,
						140110321
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110320,
					"content": "적어도 용감하게 속마음을 얘기할 수 있게 됐잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110322
					]
				},
				{
					"id": 140110322,
					"content": "…그렇네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110323
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110323,
					"content": "누군가에게 마음을 털어놓는 건, 과거엔 상상도 못 할 일이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110324
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110324,
					"content": "중요한 비밀을 지켜야 했으니까. 사람들이 진짜 내 모습을 알아챌까 봐 두려웠거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110325
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110325,
					"content": "「무대 위의 푸리나를 믿도록 해. 그게 너희들이 믿어야 할 모습이니까」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110326
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110326,
					"content": "하지만 무대 아래에선 나의 호기심도, 속마음도 절대 들켜선 안 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110327
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110327,
					"content": "그래서 전에 난 좋은 관계를 유지할 줄 아는 사람이 아니라고 얘기했던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110328
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110328,
					"content": "그랬구나. 난 그냥 네 성격이 그래서 그런 줄 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140110329,
					"content": "넌 어째 오늘 하는 말마다 나랑 불협화음이니? 너나 성격 좀 돌아보라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110330,
						140110331
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110330,
					"content": "페이몬은 네가 침울해할까 봐 그러는 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110332
					]
				},
				{
					"id": 140110332,
					"content": "응, 과거의 나에겐 진실밖에 없었는데 드디어 해방됐네. 당장은 어디로 가야 할지 모르겠지만, 그래도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110333
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110333,
					"content": "이젠 선택할 자격이 주어진 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110334
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110334,
					"content": "좋아, 이제 그만 돌아갈까? 아마 대본의 결말도 완성됐을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110335
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110335,
					"content": "응응, 그럼 돌아가 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140110331,
					"content": "털어놓고 나니까 훨씬 편하지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110332
					]
				},
				{
					"id": 140110321,
					"content": "적어도 더는 아파하고 외로워하지 않아도 되잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110322
					]
				}
			]
		},
