			"dialogs": [
				{
					"id": 140110101,
					"content": "제 기억이 맞다면 폴로는 여기에 살고 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110102
					],
					"speakerTitle": "로윅"
				},
				{
					"id": 140110102,
					"content": "누구십니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110103
					],
					"speakerTitle": "폴로"
				},
				{
					"id": 140110103,
					"content": "나야. 대본은 다 썼어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110104
					],
					"speakerTitle": "로윅"
				},
				{
					"id": 140110104,
					"content": "그것 때문에 여기까지 쫓아온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110105
					],
					"speakerTitle": "폴로"
				},
				{
					"id": 140110105,
					"content": "에이, 그건 됐고 우선 나와 봐. 좋은 소식이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110106
					],
					"speakerTitle": "로윅"
				},
				{
					"id": 140110106,
					"content": "흥, 누가 속을 줄 알아? 좀만 더 기다려. 이제 마무리 중이니까 다 쓰면 나갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110107
					],
					"speakerTitle": "폴로"
				},
				{
					"id": 140110107,
					"content": "알겠어, 그럼 걸작을 기대할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110108
					],
					"speakerTitle": "로윅"
				},
				{
					"id": 140110108,
					"content": "흠, 예상대로 질질 끌고 있구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110109
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110109,
					"content": "아무래도 이번 공연에선 결말이 매우 중요하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110110
					],
					"speakerTitle": "델피"
				},
				{
					"id": 140110110,
					"content": "다 쓰고 나면 다 같이 한번 본 다음, 모든 멤버가 동의해야 마지막 결말로 채택되는 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110111
					],
					"speakerTitle": "델피"
				},
				{
					"id": 140110111,
					"content": "방금 누가 알려주길래 설마 했는데, 정말 너희였구나? 게다가 푸리나 씨도 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110112
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110112,
					"content": "역시나 마주치게 됐네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110113
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110113,
					"content": "폴로를 찾으러 왔나 보네? 더 기다려야 하면 마을을 좀 둘러볼래? 준비는 내가 다 해놨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110114
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110114,
					"content": "아, 아뇨. 저흰 여기서 기다려도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110115
					],
					"speakerTitle": "로윅"
				},
				{
					"id": 140110115,
					"content": "그럼 사양하지 않겠습니다! 저흰 좀 둘러보고 올게요. 감사해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110116
					],
					"speakerTitle": "델피"
				},
				{
					"id": 140110116,
					"content": "빨리 이리 와. 분위기 파악 좀 하라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110117
					],
					"speakerTitle": "델피"
				},
				{
					"id": 140110117,
					"content": "요즘… 푸아송 마을은 좀 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110118
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110118,
					"content": "그냥, 천천히 회복 중이죠. 하지만 사람들 마음에 남은 상처는 평생 낫지 못할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110119
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110119,
					"content": "미안해. 나도 뭐라도 하고 싶은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110120
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110120,
					"content": "괜찮아요. 설마 만날 때마다 이런 무거운 주제만 얘기하려는 건 아니죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110121
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110121,
					"content": "가슴에 납덩이 같은 고통이 남았다고는 해도, 숨은 쉬고 살아야죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110122
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110122,
					"content": "푸리나 씨도 새로 시작하기로 했다면, 과거에 있었던 일은 그만 얘기하라구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110123
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110123,
					"content": "위로해 줘서 고마워. 네 말이 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110124
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110124,
					"content": "하지만 아직까지는, 무거운 마음을 품고 있고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110125
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110125,
					"content": "괜찮아요. 말이야 쉽지 실제로 하려면 생각보다 어렵다는 거 저도 아니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110126
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110126,
					"content": "그래서 알려주러 온 거예요. 재난 중에 아무것도 하지 않은 물의 신을 아직 모든 사람이 용서한 건 아니라는 걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110127
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110127,
					"content": "일단 불필요한 말썽이 없게 마을 사람들한텐 당신이 푸리나 역을 맡은 극단 배우라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110128
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110128,
					"content": "그렇다고 아무런 일도 없으리란 보장은 못 하지만, 아마 활동에 제약은 없을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110129
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110129,
					"content": "너 생각보다 훨씬 세심하구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140110130,
					"content": "무슨 소리야, 가시 장미회의 회장은 언제나 대담하면서 세심했다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110131
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110131,
					"content": "자, 그럼 난 먼저 갈게. 푸리나 씨 좀 잘 챙겨줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110132,
						140110133
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140110132,
					"content": "네, 그럴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110134
					]
				},
				{
					"id": 140110134,
					"content": "그럼 이제 위로 한번 올라가 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140110135
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110135,
					"content": "그동안 속마음을 털어놓을 친구가 없었는데, 나비아 말처럼 너희가 적임자일지도 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "푸리나"
				},
				{
					"id": 140110133,
					"content": "고마워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140110134
					]
				}
			]
		},
