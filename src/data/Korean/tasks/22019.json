					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "잠깐, 여행자. 아직… 우리가 나설 때가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220190206,
					"content": "조금만 더 기다리자… 음… 이제 거의 다 된 거 같군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220190207,
					"content": "너 이놈, 지금 뭐 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "안도"
				},
				{
					"id": 220190208,
					"content": "손에 든 거 내려놓고 꼼짝 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220190209,
					"content": "당, 당신들 어떻게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "이시카와 하치로"
				},
				{
					"id": 220190210,
					"content": "젠장… 구경만 하지 말고 얼른 쓸어버려! 다 같이 이 두 놈들을 해치우고 여길 뜨자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "이시카와 하치로"
				},
				{
					"id": 220190211,
					"content": "보물 사냥단 주제에 날뛰긴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220190212,
					"content": "안도 씨, 아마노 씨! 우리도 도울게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220190213,
					"content": "오! 그럼 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "안도"
				},
				{
					"id": 220190214,
					"content": "여행자, 지금이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220190215,
					"content": "왜 이렇게까지 귀찮게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "사장님의 분부야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220190217,
					"content": "됐어, 이제 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				},
