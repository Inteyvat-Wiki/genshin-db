			"dialogs": [
				{
					"id": 220190301,
					"content": "범인과 장물을 한꺼번에 해결했네. 고마워, 류지. 여행자 너도 수고 많았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "안도"
				},
				{
					"id": 220190302,
					"content": "나와 아마노는 지금부터 보물 사냥단을 봉행소에 연행할 거야. 나머지는 우리에게 맡겨줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "안도"
				},
				{
					"id": 220190303,
					"content": "근데 산고는 정말 대단해. 이렇게 정확하게 범인을 찾아내다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220190304,
					"content": "산고잖아. 이 정도의 사건은 산고에겐 일도 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "안도"
				},
				{
					"id": 220190305,
					"content": "류지, 우린 봉행소로 먼저 돌아갈게. 사건이 마무리되면 탐정소로 인사하러 가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "안도"
				},
				{
					"id": 220190306,
					"content": "별말씀을요, 어서 가보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220190307,
					"content": "끝났네. 여행자, 우리도 사장님께 보고하러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				}
			]
		},
