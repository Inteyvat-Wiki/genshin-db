			"trigger": {
				"objectNames": [
					"바레리나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "와아, 고양이 구세주와 하얀 고양이 마법사님! 오셨군요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470102,
					"content": "응? 방금 우리를 뭐라고 불렀어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705470103,
					"content": "어디서 들어본 것 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "음… 우리 전에 만난 적 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705470106,
					"content": "하하! 하얀 고양이 마법사님이 절 기억해 주시다니, 대성공이네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470107,
					"content": "옛이야기는 나중에 하고, 제가 협찬한 새 게임을 해보는 건 어때요? 지난 일주일 동안 푹 빠져 있었거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470108,
					"content": "짜잔! 바로 도도코 쾅쾅 대난투랍니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470109,
					"content": "도… 도도코 종류가 엄청 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705470110,
					"content": "다 익숙하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "보세요! 고양이 구세주… 아니, 섬광처럼 빛나는 존경스러운 명예 기사님!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470113,
					"content": "이 도도코 인형은 당신을 참고해 디자인한 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470114,
					"content": "#지, 진짜네. 배색과 무늬가 전부 {NICKNAME} 스타일이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705470115,
					"content": "이건 불꽃 도도코, 섬광 도도코, 기사 도도코, 마법 도도코가 힘을 합쳐, 전대미문의 적을 폭탄으로 무찌르는 게임이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470116,
					"content": "전 게임의 협찬과 운영만 맡아서, 세부적인 개발 사항이나 이 적들의 실제 모티브는 잘 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470117,
					"content": "하지만 실제로 이 적들과 만나도, 기묘한 도도코가 물리쳐 줄 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470118,
					"content": "물론이지. 어떤 마물도 클레와 도도코를 막을 순 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705470119,
					"content": "그럼 한번 해보죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "헤헤, 여러분도 분명 좋아하실 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705470120,
					"content": "새로운 도도코 게임!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "모델이 누군지 알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "처음 듣는 별명이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
}