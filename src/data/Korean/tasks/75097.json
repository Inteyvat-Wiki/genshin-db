			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "음? 나타의 일곱신상은 좀 이상한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970102,
					"content": "신상을 처음 만지면 좀 더 강렬한 느낌이 나야 할 텐데… 「웅」하는 느낌말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970103,
					"content": "난 잘 모르겠는데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "아니 진짜 이상하단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970108,
					"content": "아무튼 어떻게 설명해야 할까? 다른 신상을 만질 때는 더 확실하게 연결되는 것 같은 느낌이 들었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970109,
					"content": "이번에는 그냥 스위치로 전등을 켜는 것 같은 느낌이 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970110,
					"content": "맞다, 네가 전에 신상을 만졌을 땐 원소의 힘을 느낄 수 있었지? 이번에는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970111,
					"content": "불 원소의 활발하면서도 뜨거운 기운이 느껴져?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970112,
					"content": "(자세히 느껴본다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "뭐? 조금도 느껴지지 않는다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970115,
					"content": "뭔가 이상한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970113,
					"content": "(예상했던 뜨거운 감각이 느껴지지 않는다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "사실 여태까지 내가 「웅」거렸던 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "아, 그랬구나. 그럼 다음에는 「웅」하는 걸 잊지 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970107,
					"content": "그럴 리가 없잖아! 그럼 앞으로 일곱신상을 만질 때마다 「웅」 소리를 내 보라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
