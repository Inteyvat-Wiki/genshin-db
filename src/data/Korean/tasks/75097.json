					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "음, 네가 일곱신상에서 원소력을 얻을 수 없다니… 도무지 적응이 안 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970202,
					"content": "으아, 일곱신상에 대체 무슨 문제가 생긴 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970203,
					"content": "너무 오랫동안 수리하지 않아서 그런 걸 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "그치만 만지니까 제대로 빛이 났잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970205,
					"content": "음, 일곱신상아… 너 혹시 농땡이 피우는 중이니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970208,
					"content": "전혀 감이 안 잡히네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750970206,
					"content": "나타가 좀 특별한 게 아닐까…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "그러고 보니까 나타는 줄곧 심연의 영향을 받고 있었지. 설마 그것 때문인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "페이몬"
				}
			]
		},
