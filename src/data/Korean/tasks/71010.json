			"dialogs": [
				{
					"id": 710100301,
					"content": "마물은 원래부터 해로운 것. 우린 오랫동안 무예를 익혔으니, 마물을 퇴치하고 도를 지키는 것이 우리의 본분이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
