			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"보운"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(각청이 알려준 대로, 이렇게 말해야 돼…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210302,
					"content": "안녕, 여기 혹시 달도 팔아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210303,
					"content": "네, 몇 개 드릴까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "보운"
				},
				{
					"id": 10210304,
					"content": "구체적인 수량은 말할 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210305,
					"content": "좋습니다. 여기서 군옥각으로 가시면 돼요. 두 분이 오늘 응광 님을 뵙기로 한 손님들이시군요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "보운"
				},
				{
					"id": 10210306,
					"content": "맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210307,
					"content": "(근데 이건 「손님」의 암호가 아니라 「옥형의 특별 허가」 암호인데. 어떻게 된 거지…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보운"
				}
			]
		}
	]
}