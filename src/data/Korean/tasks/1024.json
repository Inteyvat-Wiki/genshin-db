	"talks": [
		{
			"id": 102402,
			"completionStepIds": [
				102402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102402",
							"2"
						],
						"stepId": 102402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "후… 후… 급하게 오느라 힘이 다 빠졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240202,
					"content": "「황금옥」을 나오면서 운 좋게 「군옥각」을 못 봤더라면, 어디로 가야 할지 몰랐을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240203,
					"content": "시간 맞춰서 온 건가? 「소용돌이의 마신」은 아직 바다에서 리월항으로 안 온 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240204,
					"content": "너희가… 왜 여기에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "소"
				},
				{
					"id": 10240205,
					"content": "응? …아! 선인들이다! 왜 「군옥각」에 있는 거야? 칠성이랑 싸우고 있다고 들었는데…. 다 끝난 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240206,
					"content": "선인들은 위기 상황인 만큼 잠시 싸움을 접어두고 힘을 합쳐 적에 맞서야 한다는 입장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10240207,
					"content": "흥",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "소월축양진군"
				},
				{
					"id": 10240208,
					"content": "그랬구나. 그래서 어떻게 방어할 계획이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240209,
					"content": "으… 그 「소용돌이의 마신」, 이렇게 멀리서 살짝 본 건데도 간 떨어질 뻔했다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240210,
					"content": "벌써 천암군 중에는 제대로 서 있지도 못하는 신병들이 있어. 고대 마신의 위압감은 일반인의 몸에 해로운 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "각청"
				},
				{
					"id": 10240211,
					"content": "——그렇기 때문에 더더욱 그 괴물이 리월항의 시민들에게 접근하게 둬선 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "각청"
				},
				{
					"id": 10240212,
					"content": "무서워…. 2천 년 전에 있던 마신들의 전쟁에서도 이렇게 적들과 싸웠을까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240213,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "소"
				},
				{
					"id": 10240214,
					"content": "그럼 지금 여기 있는 칠성, 천암군 그리고 선인들의 전력으로 그 바다에 있는 마신을 해치울 수 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240215,
					"content": "선인들과 의논해 봤지만… 확실치 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10240216,
					"content": "뭐?! 하… 하지만 리월을 지키는 선인과 칠성이잖아! 다른 방법은 없는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240217,
					"content": "아예 없는 건 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 10240218,
					"content": "엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10240219,
					"content": "전에 「귀종기」의 일로 칠성이 관심을 갖고 조사하러 온 적이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 10240220,
					"content": "그리고 지금 마침 「귀종기」를 만든 장본인이 여기에 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 10240221,
					"content": "너희 인간들이 선인의 장치로 뭘 할 수 있겠냐마는 내가 이 낡은 대포를 손 본다면 상상할 수 없을 정도로 좋아질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 10240222,
					"content": "하하… 이것도 「선인과의 인연」이겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10240223,
					"content": "그렇다면 「새로운 귀종기」에 선인분들의 신력을 불어 넣어 마신에 대항할 수 있겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10240224,
					"content": "지체할 시간이 없어요. 지금이 바로 결전의 순간입니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "응광"
				}
			]
		},
		{
			"id": 102408,
