			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"지경",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360201,
					"content": "#안녕하세요! {NICKNAME} 선배님, 잘 지내시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360202,
						710360204
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360202,
					"content": "그럭저럭요. 좀 괜찮은가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360203
					]
				},
				{
					"id": 710360203,
					"content": "걱정해 주셔서 고마워요. 전 이제 괜찮아요. 그간 여러분께 걱정 끼쳐 죄송해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360206,
					"content": "흥, 지경, 멋대로 뛰어다니지 말라구! 또 지난번처럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710360207,
					"content": "아뇨, 아뇨. 선배님이 노력해주신 덕분에 층암거연이 많이 안전해졌어요. 지리적 특징도… 음, 훨씬 안정됐구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360208
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360208,
					"content": "근데 근우 언니랑 헤디브는 그 신비한 결정체를 분석해야 하는데… 그…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360209
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360209,
					"content": "음, 파장? 헤디브는 그걸 연구한다고 했어요. 아마 또 수메르의 이상한 학술 용어겠죠… 어쨌든, 우선은 비콘을 배치해야 데이터를 획득할 수 있대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360210
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360210,
					"content": "근우 언니는 최근에야 겨우 짬을 내서 비콘을 다 조립했어요. 전 비콘들이 데이터를 수집할 수 있는 특정 장소에 배치해야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360211
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360211,
					"content": "그리고 일정 시간이 지난 후 비콘을 회수하는 거죠. 수집한 데이터를 헤디브에게 가져다 주면 연산에 사용해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360212
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360212,
					"content": "전에는 위험한 구역이 많아서 눈금 측정하는 건 야영지 내로 제한했었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360213
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360213,
					"content": "이젠 선배님 덕에 통로가 열렸으니 현지에서 비콘을 측정하면 더 정확한 데이터를 수집할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360214
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360214,
					"content": "후… 한가한 것보단 해야 할 일이 있는 게 훨씬 낫죠. 참, 선배님만 괜찮다면 저랑 함께 가요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360215,
						710360217
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360215,
					"content": "그럼, 우리도 출발하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360216
					]
				},
				{
					"id": 710360216,
					"content": "네, 출발해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지경"
				},
				{
					"id": 710360217,
					"content": "우리에게 무슨 이득이 있죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360218
					]
				},
				{
					"id": 710360218,
					"content": "너무 노골적이잖아! 물론, 나도 궁금하긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710360219,
					"content": "하하, 이번에는 간단히 다녀오는 것뿐이에요. 하지만 근우 언니가 무척 고마워할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지경"
				},
				{
					"id": 710360204,
					"content": "그냥 그래요. 적어도 살아는 있으니까요, 당신은요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360205
					]
				},
				{
					"id": 710360205,
					"content": "저도… 음, 그냥 그래요. 모험 분위기는 선배님이 다 내셨네요, 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "지경"
				}
			]
		},
		{
			"id": 7103603,
			"completionStepIds": [
				7103610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103610",
							"2"
						],
						"stepId": 7103610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"지경"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "선배님, 수고하셨어요. 이건 제 작은 성의니까 받아주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360302,
					"content": "이럴 것까진 없는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "후… 층암거연의 지형 이변이 멈춘 것 같아요. 그러니까 전 현재의 지도를 조금만 더 보완하면 될 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360304,
					"content": "선배님의 모험에 감사드려요, 덕분에 저희 업무도 비교적 수월해졌어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360305,
					"content": "아, 선배님을 더는 방해하지 않을게요. 이곳에서 쉬거나 모험을 계속하셔도 돼요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "지경"
				},
				{
					"id": 710360306,
					"content": "후우… 비콘 회수까지는 꽤 시간이 필요해요. 다음 모험에도 선배님이 함께했으면 좋겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지경"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
