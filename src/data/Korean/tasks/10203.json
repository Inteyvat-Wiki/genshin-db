			"dialogs": [
				{
					"id": 102030101,
					"content": "후… 클레는 사실 우리 페보니우스 기사단의 「불꽃 기사」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "진"
				},
				{
					"id": 102030102,
					"content": "뭐? 클레도 기사라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102030103,
					"content": "그렇다면 페이몬도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "맞아. 페이몬은 인정 못 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102030106,
					"content": "근데 「불꽃 기사」라니, 클레의 보물과 관련이 깊은 호칭이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102030107,
					"content": "응, 기사단을 자주 골치 아프게 하지만, 기사단에선 그 아이를 아끼고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "진"
				},
				{
					"id": 102030108,
					"content": "그 아이는 사실…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "진"
				},
				{
					"id": 102030109,
					"content": "아무튼 앞으로 클레에 대해 더 많이 알게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "진"
				},
				{
					"id": 102030110,
					"content": "#그때도 그 아이를 잘 돌봐줘, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진"
				},
				{
					"id": 102030104,
					"content": "게다가 「명예 기사」보다 더 강하게 들리는데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				}
			]
		},
