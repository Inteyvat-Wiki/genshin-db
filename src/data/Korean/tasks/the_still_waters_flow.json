				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#{NICKNAME}, 안녕하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330102,
					"content": "츠유코, 산호를 취하는 준비는 잘돼 가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330103,
					"content": "휴, 또 문제가 생겼어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330104,
					"content": "츠유코가 속상한 듯 고개를 숙이고는 있지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330105,
					"content": "이렇게 우리한테 눈빛을 보내는 건 너무 노골적이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330106,
					"content": "흑, 역시 여러분도 상황이 위급한 걸 눈치채셨나 보네요. 그럼 저도 더 이상 숨기지 않겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330107,
					"content": "숨길 생각이 전혀 없었잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330108,
					"content": "「월광욕 연못의 열쇠」를 구한 덕분에 연하궁이 천천히 깨어나고 있긴 하지만, 인력이 부족해서 조사의 진행 속도가 아직도 너무 느려요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330109,
					"content": "특히 요즘은 비상 시기이기도 하구요. 나루카미섬과의 관계가 완화될 수 있는지 모르겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330110,
					"content": "그럼, 제가 돕는다고 해결될 일도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "전혀 달라요. 전통에 따르면 산호를 취할 때 가장 필요한 사람이 바로 「용사」랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330112,
					"content": "먼저 거점을 세운 후, 「용사」를 도와 선조들의 흔적을 찾고, 마지막으로 시련을 맞이하게 되죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330113,
					"content": "실수 없이 차근차근 해결하는 방법이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330114,
					"content": "근데 요즘 인력이 부족해서 탐사할 사람이 없다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330115,
					"content": "맞습니다. 그리고 제일 중요한 「용사」는 지금 머리카락 한 올 보이지 않는 상황이고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330116,
					"content": "하지만 지금은 보이네요. 아… 금발인 거 같아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330117,
					"content": "으악, 듣는 것만으로도 귀찮아. 절대 끼고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330118,
					"content": "거기엔 널린 게 보물이죠. 관례대로라면 찾은 보물은 산호궁에 상납해야 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330119,
					"content": "하지만 여행자님이 이번 탐색에서 무언가를 찾는다면, 한쪽 눈 감고 모르는 척 슬쩍 넘어갈지도 모르죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330120,
					"content": "차라리 두 쪽 다 감는 게 어떨까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "영웅님, 대협님, 어르신님, 구세주님! 그럼 동의하신 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330123,
					"content": "산호궁이 위험한 상황인데 우리가 모르는 척할 수는 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330124,
					"content": "그렇게 말해주신다면 정말 감사하죠. 산고노미야 님이 가르쳐 준 화술은 역시 잘 먹히네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330125,
					"content": "산고노미야 님은 여러분이 절 찾아올 거라는 것도 예측하고 계셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330126,
					"content": "뭐라고 했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330127,
					"content": "아니에요, 알 거 없어요. 그럼 절 따라오세요. 보여드릴 물건이 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330128,
					"content": "그럼 저쪽 아래에 있는 제단에서 뵙겠습니다. 혹시 안 보인다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330129,
					"content": "안 보인다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722330130,
					"content": "바로 동남쪽에 있으니 눈을 가늘게 뜨면 보일 거랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "츠유코"
				},
				{
					"id": 722330121,
					"content": "전 코코미와 정말 친해요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
