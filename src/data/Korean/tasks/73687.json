	"talks": [
		{
			"id": 7368701,
			"completionStepIds": [
				7368701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368701",
							"2"
						],
						"stepId": 7368701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"유우",
					"테츠야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736870101,
					"content": "우와, 벌써 게시판에 사람이 많이 몰렸네. 나도 좀 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870102,
					"content": "아, 표 차이가 이렇게 많이 날 줄은 몰랐네. 「연무 전심」처럼 이나즈마의 특색이 강한 경기는 마사코 씨가 이길 줄 알았는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870103
					],
					"speakerTitle": "유우"
				},
				{
					"id": 736870103,
					"content": "예상대로네. 「오르치 아가씨의 사건 파일」은 신예 인기작이라고. 스토리도 재밌고, 일러스트의 폰타인 의상도 특색 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870104
					],
					"speakerTitle": "테츠야"
				},
				{
					"id": 736870104,
					"content": "그리고 오르치 아가씨의 이미지가 카미사토 아가씨랑 어울리지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870105
					],
					"speakerTitle": "테츠야"
				},
				{
					"id": 736870105,
					"content": "음… 오르치 아가씨는 승부욕이 강하고 장난도 좋아해서 카미사토 아가씨랑 전혀 다르지만, 폰타인 옷을 입은 카미사토 아가씨도 또 하나의 볼거리겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870106
					],
					"speakerTitle": "유우"
				},
				{
					"id": 736870106,
					"content": "음… 무슨 얘기를 하는 건지 하나도 못 알아듣겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870107,
					"content": "어라? 이것 봐! 게시판에 연무 전심 투표 선택지가… 「부탁해요, 나의 여우 신선 궁사님」, 「오르치 아가씨의 사건 파일」…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870108,
					"content": "잠깐만, 이나즈마의 사계절을 상징하는 의상 중에서 선택하는 거라고 하지 않았나? 언제부터 선택지가 라이트 노벨 주인공의 의상이 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870109,
						736870110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870109,
					"content": "혹시 막바지에 뭔가 바뀐 건가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870111
					]
				},
				{
					"id": 736870111,
					"content": "이건 한번 확인해 봐야겠어. 야시로 봉행으로 가서 아야카에게 물어보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870110,
					"content": "혹시 투표에 무슨 착오가 있었나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870111
					]
				}
			]
		},
		{
			"id": 7368702,
			"completionStepIds": [
				7368702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368702",
							"2"
						],
						"stepId": 7368702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"미즈타",
					"오노데라",
					"카미사토 아야카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736870201,
					"content": "정말 죄송합니다! 제가 투표 상자를 헷갈렸어요! 오노데라 씨가 왔을 땐 이미 결과를 공개한 후였고요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870202
					],
					"speakerTitle": "미즈타"
				},
				{
					"id": 736870202,
					"content": "하아… 비밀 유지를 위해서 투표함에 주제를 표기하지 않았더니, 그것 때문에 일이 이렇게 될 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870203
					],
					"speakerTitle": "오노데라"
				},
				{
					"id": 736870203,
					"content": "아, 어떡해… 연무 전심 의상 투표에 정말 문제가 발생했던 거였네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870204,
					"content": "여행자님, 페이몬 님, 보아하니 두 분도 투표 결과에 대해 알게 되셨나 보네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870205
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870205,
					"content": "응, 우리뿐만 아니라 다들 이번 일에 대해 얘기하고 있더라. 이제 어쩌지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870206,
					"content": "카미사토 아가씨, 이번 사고는 저희 책임이니 이번 일에 대해 제대로 설명하고 재투표를 하고 오도록 하겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870207
					],
					"speakerTitle": "오노데라"
				},
				{
					"id": 736870207,
					"content": "아뇨. 오노데라 씨, 잠시만요. 어쩌면 다른 해결책이 있을지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870208
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870208,
					"content": "투표에 착오가 생겼다는 것을 알고 있는 건 대회를 준비하는 우리 같은 사람들뿐이에요. 일반인들은 투표에 문제가 있다는 것을 모르고 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870209
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870209,
					"content": "그리고 시범 경기에 요즘 유행하는 작품의 의상이 나와도 별다른 불만은 없을 거예요. 오히려 깜짝 이벤트라고 생각하겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870210
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870210,
					"content": "보다 많은 사람이 이번 경기에 관심을 가지게 하는 게 저희의 목적 중 하나예요. 그렇다면 이번 착오로 생긴 결과를 「사고」로 규정해서는 안 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870211
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870211,
					"content": "아야카, 그 말은 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870212,
					"content": "네, 차라리 이대로 가는 게 낫다고 생각해요. 지금 투표 결과에서 뽑힌 의상을 입고 마지막 시범 경기에 나가도록 할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870213
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870213,
					"content": "하지만… 카미사토 아가씨가 곤란해지지 않습니까. 소설 캐릭터의 의상은 연무복처럼 전투를 위해 만들어진 옷이 아닌걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870214
					],
					"speakerTitle": "오노데라"
				},
				{
					"id": 736870214,
					"content": "괜찮아요. 소설 속에 나오는 폰타인 스타일의 치마는 움직임을 방해하거나 하지는 않아서 큰 문제는 없을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870215
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870215,
					"content": "평소에 입는 옷과는 다를 테지만 적응해 보도록 할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870216
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870216,
					"content": "와! 굉장히 침착하게 말했는데도 박력이 느껴졌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870217,
					"content": "네, 알겠습니다…. 그렇다면 카미사토 아가씨의 말씀대로 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870218
					],
					"speakerTitle": "오노데라"
				},
				{
					"id": 736870218,
					"content": "원래는 팬 미팅을 위해서 준비한 의상이었습니다만, 시범 경기 때 아무런 문제가 없도록 며칠 내로 카미사토 아가씨의 몸에 맞춰보도록 하겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870219
					],
					"speakerTitle": "오노데라"
				},
				{
					"id": 736870219,
					"content": "네, 그럼 부탁할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870220
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870220,
					"content": "아야카, 소설 캐릭터의 의상을 입고 시범 경기에 나가도 정말 괜찮아? 우리 앞이라고 무리하는 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736870221,
					"content": "걱정하지 마세요. 딱히 무리한 것도 아니고, 오히려 조금 즐거운걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870222
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870222,
					"content": "이전까지는 화려한 옷을 입고 시범 경기 무대에 오른다는 게 걱정되었어요. 과연 무대에서 관중들의 기대에 미칠 정도로 우아하고 아름답게 행동할 수 있을까 싶어서 말이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870223
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870223,
					"content": "하지만 소설 캐릭터의 옷을 입으면 그런 걱정을 하지 않아도 돼요. 소설 속 탐정 아가씨는 제멋대로에 장난을 좋아하기로 유명한 사람이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870224
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870224,
					"content": "또 이렇게 하면 시범 경기를 보러 온 관중들도 전통 방식에서 새로운 재미를 느낄 수 있겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870225
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870225,
					"content": "(아야카는 그런 생각을 했구나…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736870226
					]
				},
				{
					"id": 736870226,
					"content": "아니, 실은 그게 다가 아니에요. 전 마음속 깊은 곳에서… 언젠가는 평소랑 다르게 꾸며보고 싶다는 생각을 하고 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870227
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870227,
					"content": "여행자님을 처음 만난 지 얼마 안 됐을 때, 리월과 몬드의 의상은 각자 특색이 있다고 했었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870228
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870228,
					"content": "그때의 저는 그런 이국적인 걸 직접 체험해볼 수 있을 거라고는 생각도 못 했어요. 하지만 과거에 품었던 바람을 이룰 기회가 지금 눈앞으로 다가왔죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870229
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870229,
					"content": "게다가 어머니께서도 살아 계실 때 늘 다른 나라의 의상을 입어보는 것을 꿈꾸셨거든요. 덕분에 제가 어머니의 소원을 또 하나 이뤄드리게 되었네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736870230
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736870230,
