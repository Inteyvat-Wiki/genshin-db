				]
			},
			"dialogs": [
				{
					"id": 765080101,
					"content": "요즘 「샘물 무리」에서 무슨 이벤트를 열고 있나? 관광객이 많아진 것 같네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080102,
					"content": "저기 수메르에서 온 손님이… 춤을 보여주고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080103,
					"content": "오오, 빛나는 영웅과 귀여운 페이몬 참모가 왔네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080104
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080104,
					"content": "내가 가장 존경하는 전사, 힘과 춤의 용사이자 인생을 즐기는 너에게 진심이 담긴 인사를 건넬게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080105
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080105,
					"content": "어라? 어디서 많이 본 얼굴인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080106,
					"content": "#그리고 {NICKNAME}이(가) 춤출 때 즐거워하는 거 어떻게 알았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080107,
					"content": "그야 당연히 성화 경기장 앞에서 신나게 춤을 추는 모습을 봤으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080108
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080108,
					"content": "#같이 사진을 찍고 나서, 난 눈에 띄지 않는 곳을 찾아 용용 쿠키를 먹으면서 {NICKNAME}의 축복의 춤을 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080109
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080109,
					"content": "#춤은 가볍고 자유로워야 하잖아! 그래서 나도 올라가서 {NICKNAME} 곁에서 춤추고 싶었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080110,
						765080112
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080110,
					"content": "기억났어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080111
					]
				},
				{
					"id": 765080111,
					"content": "영광이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080114,
					"content": "본론으로 돌아와서, 보다시피 최근 수메르 친구들이 와줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080115
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080115,
					"content": "무토타, 아미나, 파칼, 그리고 말라니랑 상의해서 우리 「꽃깃회」는 「메아리 아이」, 「샘물 무리」와 함께 그 친구들을 환영해 주기로 결정했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080116
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080116,
					"content": "어째 「도금 여단」의 용병이 꽤 있는 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080117,
					"content": "맞춰볼게! 혹시 사막 여행하다가 서로 싸우면서 정든 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080118,
					"content": "아, 거의 맞았어! 하지만 우리끼리 싸운 게 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080119
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080119,
					"content": "우리가 하드라마베스 사막 남쪽에서 바비큐 파티를 크게 열었을 때, 고약한 붉은 독수리 떼가 꼬였어. 녀석들은 우리가 배불러서 움직일 수 없는 때를 노려 공격했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080120
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080120,
					"content": "거기다 지형적 우세를 이용해 싸우는 녀석들의 전투 방식이 너무 교활해서, 우리는 힘겹게 싸웠지만 성과를 얻지 못했고, 지쳐서 일단 후퇴할 수밖에 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080121
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080121,
					"content": "그런데 용병 부대가 우리가 후퇴하는 길에 나타나 붉은 독수리들을 향해 신비로운 전투의 춤을 추기 시작했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080122
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080122,
					"content": "그랬더니 붉은 독수리들이 용병들이랑 합의라도 한 것처럼 물러났어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080123
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080123,
					"content": "전투의 춤으로 붉은 독수리를 쫓아냈다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080124,
						765080125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080124,
					"content": "춤이 너무 이상해서 놀랐나 보네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080126,
					"content": "정말 신기하지? 우리도 그 춤의 비밀이 궁금해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080127
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080127,
					"content": "야영지를 정리한 후, 우린 함께 술과 고기를 배불리 먹고 댄스 기술을 교류하기 시작했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080128
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080128,
					"content": "중간에 다른 마물과 야수가 우리의 흥을 깨면, 다 같이 무기를 들고 싸웠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080129
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080129,
					"content": "2주도 안 돼서, 우리는 생사를 함께한 전우이자 댄스 파트너가 됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080130
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080130,
					"content": "그리고 헤어지기 전에 약속했지. 나중에 각자의 야영지를 정식으로 방문해 「댄스 교류」를 이어가자고. 이번이 그 첫 시도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080131
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080131,
					"content": "#{NICKNAME}, 우리 이렇게 수메르랑 나타 사람들이 서로 춤을 추는 이벤트에는 참가한 적 없지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080132,
						765080133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080132,
					"content": "확실히 신기해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080134,
					"content": "이런 기회는 흔치 않아, 우릴 가르쳐보는 건 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080135
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080135,
					"content": "가면 말라니도 있어. 우리 중에서 가장 활기 넘치는 댄서라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080136
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080136,
					"content": "그리고 「도금 여단」의 친구는 거금을 들여 현지의 유명 무용수를 수메르 측의 리더와 고문으로 초대했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080137
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080137,
					"content": "너희도 분명 그 무용수를 알 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080138
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080138,
					"content": "누군지 알 것 같아. 헤헤, 이따가 우리 깜짝 놀라게 해 주자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080139,
						765080140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765080139,
					"content": "좋아요. 저 참가할게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080141,
					"content": "하하하하! 이걸로 더 시끌벅적해졌네. 말라니의 말을 빌리자면, 분위기가 최고로 달아올랐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080142
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080142,
					"content": "자 그럼 우리 타라네한테 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "누스타"
				},
				{
					"id": 765080140,
					"content": "이런 이벤트를 놓칠 수 없죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080133,
					"content": "구경해보고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080125,
					"content": "아니면 원래 알던 사이였을지도 몰라요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080112,
					"content": "앞으로 기억할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080113
					]
				},
				{
					"id": 765080113,
					"content": "그렇단 건 내 노력이 부족해서 눈에 띄는 성과를 남기지 못했다는 거겠지. 계속 노력해야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "누스타"
				}
			]
		},
