	"talks": [
		{
			"id": 7151601,
			"completionStepIds": [
				7151601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151601",
							"2"
						],
						"stepId": 7151601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"응공"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715160101,
					"content": "덕분에 종이극을 무사히 마쳤어. 연기가 제법이던데. 어땠어? 많이 어려웠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160102,
						715160104
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160102,
					"content": "식은 죽 먹기였어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160103
					]
				},
				{
					"id": 715160103,
					"content": "종이극은 리월극과 달리 혼자 진행할 수 있어서 확실히 덜 힘들지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160106
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160106,
					"content": "#난 {NICKNAME}(이)가 충분히 잘한 것 같은데? 종이극도 정말 재밌었어. 언제 또 다른 공연을 볼 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715160107,
					"content": "하하, 재밌었다니 다행이네. 언제 또 공연할 수 있을지는 장담할 수 없지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160108
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160108,
					"content": "사실 아이들에게 종이극을 보여주는 건 내 취미야. 공연을 마쳤으니 이제 운한사로 돌아가 의상과 소품을 관리해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160109
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160109,
					"content": "응? 운한사 소속이었어? 그럼 리월극도 잘하겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715160110,
					"content": "할 수야 있지. 운한사에 몸담은 세월이 얼만데 그걸 못 하겠어? 하지만 운 사장님에 비하면 아직 멀었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160111
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160111,
					"content": "난 무대 뒤에서 바쁘게 돌아다니는 쪽이지. 무대에서 쓰는 무기와 깃발부터 각종 무대 의상, 장신구와 소품까지… 모두 내 담당이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160112
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160112,
					"content": "운한사의 소품은 주로 물려받거나 내가 산 거야. 내가 직접 만든 소품도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160113
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160113,
					"content": "리월극을 한번 부르려면 무대 위아래에서 여러 사람이 분주히 움직여야 해. 배우들만 있다고 되는 게 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160114
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160114,
					"content": "올해 해등절엔 운 사장이 무대 뒤에서 일하는 직원들에게 휴가를 줬어. 내 동료들은 명절을 쇠기 위해 고향에 내려갔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160115
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160115,
					"content": "혼자 있으니 심심해서 이것저것 가져와 종이극을 선보인 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160116
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160116,
					"content": "고향에는 안 가세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160117
					]
				},
				{
					"id": 715160117,
					"content": "아, 난 가족이 없어. 재작년에 부모님이 돌아가셔서 혼자가 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160118,
						715160119
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160120
					]
				},
				{
					"id": 715160120,
					"content": "미안할 게 뭐 있어? 괜찮으니 신경 쓰지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160121
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160121,
					"content": "혼자 보내는 해등절도 제법 괜찮던걸. 아까 봤지? 아이들이 내 종이극을 보면서 즐거워하는 모습 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160122
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160122,
					"content": "우리도 즐거웠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715160123,
					"content": "나도 마찬가지야. 즐겁지 않다면 굳이 시간을 들여 종이 인형과 무대를 만들지 않았겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160124
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160124,
					"content": "이야기는 직접 쓰시는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160125
					]
				},
				{
					"id": 715160125,
					"content": "그건 아니야. 리월극이든 종이극이든 차 명인의 이야기든 모두 「규염공」의 이야기를 언급한 적이 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160126
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160126,
					"content": "무릇 영웅이란 누군가 필요로 하고 불러줄 때 나타나 위험에 빠진 이들을 구해주잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160127
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160127,
					"content": "리월에는 이런 영웅들이 많아. 그들의 이야기에 살만 조금 붙이면 모두가 좋아하는 공연이 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160128
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160128,
					"content": "그런 영웅 이야기는 정말 많이 들었어. 이것도 리월의 전통문화라고 볼 수 있으려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715160129,
					"content": "하하, 그런 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160130
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160130,
					"content": "그런데 아무리 영웅이 위기의 순간에 나타나 도와준다고 해도 평소에 남에게 과하게 의존하는 건 좋지 않아. 자기 자신은 스스로 돌봐야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160131
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160131,
					"content": "너도 스스로를 잘 살펴야 해. 그럼 즐거운 해등절 보내길!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160132
					],
					"speakerTitle": "응공"
				},
				{
					"id": 715160132,
					"content": "네, 즐거운 해등절 보내세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160133
					]
				},
				{
					"id": 715160133,
					"content": "해피 해등절!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715160134,
					"content": "한가할 때 운한사에 공연을 보러 좀 자주 와줘. 그럼 다음에 또 보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "응공"
				},
				{
					"id": 715160119,
					"content": "죄, 죄송합니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160120
					]
				},
				{
					"id": 715160104,
					"content": "어려웠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715160105
					]
				},
				{
					"id": 715160105,
					"content": "넌 전문가가 아니니까. 첫 시도에 실수가 있는 건 당연한 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715160106
					],
					"speakerTitle": "응공"
				}
			]
		}
	]
}