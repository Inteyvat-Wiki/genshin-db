{
	"id": 71516,
	"type": "WQ",
	"name": "무대 뒤의 연출가",
	"description": "당신의 도움으로 종이극 《규염공·고향으로》가 무사히 막을 내렸다. 그런데 응공은 못다 한 말이 있는 듯하다…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 2019,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
