					{
						"sceneId": 3,
						"position": [
							3556.893,
							446.167,
							4435.611
						],
						"pointId": 340100226
					}
				]
			},
			"dialogs": [
				{
					"id": 745000201,
					"content": "어서 와, 난 가게 주인인 카론이야. 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000202
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000202,
					"content": "안녕, 카론. 이곳에 엄청난 장난감이 있다는 얘길 듣고 궁금해서 와 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000203,
					"content": "하하, 그래. 근데… 너희 둘, 형이 정보를 알아오라고 보낸 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000204
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000204,
					"content": "응? 형? 아니, 근데… 우리가 정보를 얻으러 온 건 어떻게 알았어!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000205,
					"content": "레쇼의 태엽 공방 쪽에서 오는 걸 봤거든. 공방 주인이 내 형이라 바로 알았지. 형이 할 법한 행동이기도 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000206
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000206,
					"content": "뭐야… 바로 들켰어. 한 것도 없는데 끝나버렸다구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000207,
					"content": "에이, 좀 더 준비하고 올걸. 형제일 줄 누가 알았겠어! 동종업계 종사자끼리의 경쟁인 줄 알았는데… 가족끼리… 동족상잔이었다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000208,
					"content": "페이몬, 그런 단어 쓰는 거 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000209
					]
				},
				{
					"id": 745000209,
					"content": "미안해, 카론… 순간 머리가 멈췄어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000210,
					"content": "괜찮아. 아무리 좋은 장난감이라도 부품이 버벅댈 때가 있는 것처럼 사람도 똑같아. 정비가 필요한 법이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000211
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000211,
					"content": "게다가… 형의 눈에 비친 우리 상황은 아마 그게 맞을 거야. 흠, 아무튼 시간 낭비 그만하고 장난감을 소개해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000212
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000212,
					"content": "엥, 괜찮겠어? 우리는… 산업 스파이인데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000213,
					"content": "하하, 산업 스파이라, 재미있는 발언인걸. 우리 가게에서 주로 다루는 건 시계야. 대대손손 이어져온 기술이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000214
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000214,
					"content": "장난감은 그냥 내 개인적인 취미야. 장난감이란 기쁨을 가져다주는 물건이니까 더 많은 사람에게 알리면 기쁨이 더 널리 퍼지지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000215
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000215,
					"content": "와, 정말 따뜻한 생각인걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000216,
					"content": "하하, 형이라면 모험 정신이 부족하다고 말했겠지…. 그보다 장난감 한번 볼래? 너희 마음에 들면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000217
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000217,
					"content": "몬드에서 영감을 받으셨다고 들었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745000218
					]
				},
				{
					"id": 745000218,
					"content": "맞아. 어렸을 때부터 몬드를 좋아했거든. 그러다 얼마 전에 여행을 갔는데 예상했던 대로 많은 걸 얻었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000219
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000219,
					"content": "몬드에서 만났던 모험가의 이야기를 장난감에 녹여봤는데 너무 기대하진 마. 그래 봤자 간단한 태엽 장난감일 뿐이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000220
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000220,
					"content": "모험가? 연금술 장난감 같은 게 아니었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000221,
					"content": "연금술 장난감? 그것도 재미있을 것 같지만 이 모험가도 제법 인상적인 친구였어. 기회가 되면 그의 이야기를 다시 제대로 해보고 싶네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000222
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000222,
					"content": "우선 이 장난감부터 살펴볼래? 백 마디 말보다 직접 해보는 게 빠르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000223
					],
					"speakerTitle": "카론"
				},
				{
					"id": 745000223,
					"content": "#그러고 싶긴 한데 저쪽에서 우릴 기다리고 있어서…. {NICKNAME}, 우리 빨리 갔다 다시 오자! 얼른 모험가 장난감을 체험해 보고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745000224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745000224,
					"content": "알겠어, 언제든지 환영해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카론"
				}
			]
		},
