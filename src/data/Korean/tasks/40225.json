			"dialogs": [
				{
					"id": 402250201,
					"content": "북두는 선원들을 지휘해 화물을 내린 뒤, 당신을 따라 전시회장에 도착했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "여기 맞지? 자리 좋은데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "북두"
				},
				{
					"id": 402250203,
					"content": "시간 나면 와서 원거리 유도 테스트를 도와줘. 스릴 있어서 네 마음에 들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "북두"
				}
			]
		}
