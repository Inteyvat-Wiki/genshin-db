					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "불이 잘 붙는 명소등 재료들이 쌓인 현장에서 수상한 사람을 봤어!",
					"roleType": "TALK_ROLE_NPC",
