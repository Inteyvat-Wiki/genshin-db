			"dialogs": [
				{
					"id": 205160101,
					"content": "이 녀석, 또 어디 간 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160102,
					"content": "안나가 또 놀러 나갔니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "왜 뻔하다는 표정을 짓는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160104,
					"content": "안나가 점점 말을 안 들어…. 내가 한눈팔면 바로 빠져나가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160105,
					"content": "병도 아직 다 안 나았는데. 어서 안나 좀 찾아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160106,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160115,
					"content": "맞다! 전에 안나가 계속 바람 신의 신상을 보러 가고 싶다고 말했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160116,
					"content": "그레이스 수녀님이 거기 자주 계셨던 걸로 기억해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160117,
					"content": "우선 그레이스 수녀님한테 물어봐. 어쩌면 뭔가 알고 계실지도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160108,
					"content": "넌 찾아봤어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "당연히 찾아봤지. 성 밖에도 가봤는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160110,
					"content": "그래도 못 찾아서 너한테 부탁하는 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160111,
					"content": "안나는 어떤 음식을 좋아해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "음, 안나가 좋아하는 건… 야! 내 동생을 고양이 취급하지 말라니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160113,
					"content": "게다가 안나가 좋아하는 음식은 셀 수 없을 만큼 많거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205160114,
					"content": "됐고, 빨리 가서 좀 찾아줘. 난 여기서 기다릴게. 찾는다고 하도 돌아다녀서 힘들어 죽겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "앤서니"
				}
			]
		},
