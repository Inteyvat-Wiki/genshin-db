			"dialogs": [
				{
					"id": 722470201,
					"content": "자네들의 실력이라면… 분명 공물을 무사히 호송할 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470202,
					"content": "이제야 안심이 되는군… 부탁하네, 반드시 무사히 그곳으로 보내야만 하네. 그래야만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470203,
					"content": "그래야만, 뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470204,
					"content": "그래야만… 그래야만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470205,
					"content": "큰일이야, 상태가 안 좋아 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470206,
					"content": "얘기한 공양품이 이건가 봐… 좀 낡은 거 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
