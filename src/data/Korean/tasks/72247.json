			"dialogs": [
				{
					"id": 722470301,
					"content": "뭐, 뭔가 튀어나왔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470302,
					"content": "잔상 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470303,
					"content": "난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470304
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470304,
					"content": "난 헬리오스를 건축한 자, 이름하여 아베라쿠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470305
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470305,
					"content": "나 이 말 이해했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470306,
					"content": "이 말의 의미는ㅡ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470307,
					"content": "이 사람의 이름은 헬리오스야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470308,
						722470309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470308,
					"content": "전혀 이해 못 했잖아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				},
				{
					"id": 722470310,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470311,
					"content": "아베라쿠…? 이상한 이름이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470312,
					"content": "근데 이름이 아베라쿠면 헬리오스는 또 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470313,
					"content": "헬리오스! 헬리오스!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470314
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470314,
					"content": "내가 직접… 헬리오스를 만든 날, 무수한 빛이 하늘로부터 쏟아졌고, 사람들은 더 이상 용 괴물의 침략을 받지 않게 되었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470315
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470315,
					"content": "아아, 그때, 사람들은 감동해서 눈물을 흘리며. 두 팔을 하늘 높이 쳐들고 환호하면서 기쁜 마음을 감추지 못했는데… 지금은 왜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470316
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470316,
					"content": "아, 아니, 내가 왜 여기에 있는 거지. 왜… 내 영혼은 안식을 얻지 못하고 서성이고 있는 건가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470317
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470317,
					"content": "페이몬, 알아들을 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470318
					]
				},
				{
					"id": 722470318,
					"content": "당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470319,
					"content": "이 잔혼은… 정신이 온전치 않은 게 분명해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470320,
					"content": "생각났어… 내 영혼은 불완전해. 영혼이 한곳에 모이면 다시 안식을 취할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470321
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470321,
					"content": "해결사는 자네라는 느낌이 강하게 드는군. 내 상황을 설명하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470322
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470322,
					"content": "윽, 귀찮은 사건의 냄새가 나는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722470323,
					"content": "이곳은 나의 유골을 공양했던 곳이지만 유골은 이미 썩어버렸지… 그러니 자네에게 부탁하고 싶은 일이 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470324
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470324,
					"content": "나의 마음이 담긴 공물을 가져가게… 하지만 주변에는 나의 영혼을 지키는 괴물들이 있다네. 나의 영혼이 깃든 물건이 이곳을 떠나려고 하면… 그들이 나타날 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470325
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470325,
					"content": "매우 위험한 일이네. 여행자여, 준비되면 나한테 말해주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722470309,
					"content": "이 사람의 이름은 아베라쿠야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				}
			]
