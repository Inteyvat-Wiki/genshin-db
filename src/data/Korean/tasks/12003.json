				1200308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200308",
							"2"
						],
						"stepId": 1200308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"행추"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "제법이군. 평범한 녀석이 아니야…. 이렇게 싸우다 보면 손해가 막심하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "채무 처리인"
				},
				{
					"id": 120030802,
					"content": "놈들은 곧 나가떨어질 겁니다! 계속 공격하세요! 콜 라피스를 전부 뺏어오란 말입니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "무재공"
				},
				{
					"id": 120030803,
					"content": "우인단은 네놈과 사업상의 협력 관계일 뿐. 내 수하들을 데리고 이런 소란을 피우라고 한 적은 없을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "채무 처리인"
				},
				{
					"id": 120030804,
					"content": "무… 무슨 말씀입니까? 어르신, 저, 저도 주문을 맞추려고 이러는 거 아닙니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "무재공"
				},
				{
					"id": 120030805,
					"content": "그 일은 너 혼자 알아서 해라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "채무 처리인"
				},
				{
					"id": 120030806,
					"content": "가, 가지 마세요! 어, 어르신! 어르신!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "무재공"
				},
				{
					"id": 120030807,
					"content": "도련님?! 왜 여기 계신 거예요? 어디 다치진 않으셨어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 120030808,
					"content": "#여기 이 {F#여협}{M#소협}께서 도와주셔서 별 탈 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030809,
					"content": "도련님?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030810,
					"content": "도련님이라고?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "네, 네가 「비운 상회」의 도련님이라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "무재공"
				},
				{
					"id": 120030813,
					"content": "딱히 신분을 숨긴 적은 없습니다만. 전 고화파의 제자이자 「비운 상회」 회주의 둘째, 행추입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030814,
					"content": "젠장, 네놈한테 당하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "무재공"
				},
				{
					"id": 120030815,
					"content": "무재공, 사업하는 사람이 강제로 남의 것을 뺏다니, 너무 격 떨어지는 행동 아닙니까? 사업적으로 해결했으면 더 좋았을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030816,
					"content": "이 콜 라피스가 없다면 「우인단」이 당신을 어떻게 할지 제가 한번 맞춰볼까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030817,
					"content": "젠장… 말해, 도대체 원하는 게 뭐야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "무재공"
				},
				{
					"id": 120030818,
					"content": "상 어르신에게 3할의 가격을 요구하셨으니, 갚아야 할 건 갚아야겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030819,
					"content": "시장가의 3배, 어떻습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030820,
					"content": "날강도도 아니고! 너무한 거 아니야! 너… 너!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "무재공"
				},
				{
					"id": 120030821,
					"content": "그래서, 살 건가요 말 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030822,
					"content": "난… 어휴, 알았어. 사면 되잖아! 돈을 마련해 올게, 됐지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "무재공"
				},
				{
					"id": 120030823,
					"content": "「비운 상회」를 이용해 주셔서 감사합니다. 다음에도 잘 부탁드리겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030824,
					"content": "너너너너너 네가 「비운 상회」의 도련님이라고?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030825,
					"content": "우리가 쓴 그 셀 수 없는 모라가 다 네 금고에서——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030826,
					"content": "별거 아니야. 돈도 벌고, 무재공도 혼낼 수 있는 일거양득의 사업이라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030827,
					"content": "진짜 사람은 겉만 보고 평가해선 안 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "과찬이야. 오히려 네 의협심에 감탄했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030831,
					"content": "아——! 내가 계속 책벌레라고 놀렸는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030832,
					"content": "무협 소설에선 돈 많은 도련님이 화가 나면 사람을 시켜서 손발을 잘라가던데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030833,
					"content": "어떡해? 어떡하지? 미안! 아니, 죄송해요! 정말 죄송해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030834,
					"content": "넌 날 수 있으니까, 발은 굳이 필요 없을 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030835,
					"content": "#으으! {NICKNAME}, 나 좀 살려줘. 쟤 눈빛, 완전 살벌해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030836,
					"content": "딱 봐도 놀리는 거잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "장난은 여기까지 하자고. 이번 일은 정말 고마워, 너희 덕분에 잘 마무리됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030839,
					"content": "이 《신소절극록》도 정말 흥미진진했어. 너희가 나 대신 상구야에게 돌려줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030840,
					"content": "또 우리한테 심부름시키는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "사실 난 한 게 별로 없어서 감사 인사를 받을 자격이 없어. 되려 이 일과 관련이 없는 너희 둘이 끝까지 도왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030842,
					"content": "이렇게 의협심 넘치는 벗을 사귀게 되어 아주 만족스러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030843,
					"content": "도련님, 방해해서 죄송합니다만, 어르신께서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 120030844,
					"content": "아, 그 일 말인데. 아버님께 이번에 사태를 해결하면서 돈을 꽤 벌었다고 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030845,
					"content": "이번 공으로 며칠 더 자유를 얻을 수 있으려나? 《신소절극록》에서 언급한 비경을 한번 찾아가 보고 싶은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030846,
					"content": "말만 번드르르하지 결국 직접 가기 싫단 얘기잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030847,
					"content": "하하하, 만약 상구야께서 감사 인사 외에 감사 선물도 준비하셨다면?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030848,
					"content": "선물! 그… 그럼 한번 가줄 수 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030849,
					"content": "하아, 제가 무슨 말을 해도 도련님을 말릴 순 없겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 120030850,
					"content": "행추가 도련님이라고 진작에 좀 말해주시지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "저, 저는 두 분이 당연히 알고 계시는 줄 알았습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 120030852,
					"content": "그럼 책 반납을 부탁할게. 인연이 되면 다시 강호에서 만나자. 그럼 이만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "행추"
				},
				{
					"id": 120030837,
					"content": "네가 본 게 진짜 무협 소설이 맞아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "부잣집 도련님은 글쓰기 연습을 안 하는 건가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "하하하, 이제 그만 놀려. 가족들은 내 글씨를 한눈에 알아보니, 이것도 특징이라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120030811,
					"content": "…역시, 그렇게 된 거였구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200309",
							"2"
						],
						"stepId": 1200309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"상구야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "드디어 왔구나! 오늘 아침 전당포에서 내 책들을 모두 돌려줬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030902,
					"content": "다 자네들이 도와준 덕이지. 정말 고맙네, 정말 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030903,
					"content": "천만에요. 도움이 됐다니 다행이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "어이쿠, 그런 말 마. 이번 일은 나한테 아주 중요한 일이었으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030906,
					"content": "우리 상 씨 집안도 원래는 리월의 대가문이었지만, 내가 젊었을 때 벌인 사업이 모두 실패해 재산을 다 날려버렸어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030907,
					"content": "가문을 다시 일으키기 위해 수년간 돈을 열심히 모았어…. 내 가문의 희망을 모두 이 콜 라피스 사업에 걸었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030908,
					"content": "너희들이 아니었다면, 난 이 황량한 산속에 묻혔을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030909,
					"content": "상구야도 「도련님」이었을 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030910,
					"content": "응? 무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030911,
					"content": "아, 아무것도 아냐! 참, 우린 책을 돌려주러 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030912,
					"content": "오오, 《신소절극록》이구만! 그 고화파 녀석이 왜 갑자기 코빼기도 안 보이나 했네. 좀도둑인 줄 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030913,
					"content": "고화파가… 그렇게 형편없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120030914,
					"content": "그 문파는 몇백 년의 역사를 지녔고, 잘 나갔던 적도 있었지만, 지금은 문파라 부르기에도 민망할 정도로 쇠락했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030915,
					"content": "문파가 부활하려면 새로운 인재가 필요한데, 계속 쇠락하는 문파에 들어올 인재가 있나, 그냥 악순환인 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030916,
					"content": "요즘 고화파의 젊은이들은… 예를 들면 그 녀석, 은혜를 갚는다더니 너희들만 못하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 120030917,
					"content": "꼭 그렇진 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "에이, 그러거나 말거나. 참, 《티바트 유람 가이드》의 리월편을 찾았었지? 이미 준비해뒀다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
