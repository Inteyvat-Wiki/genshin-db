			"dialogs": [
				{
					"id": 700740801,
					"content": "구구——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "비둘기"
				},
				{
					"id": 700740802,
					"content": "깃털! 드디어 얻었다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 700740803,
					"content": "겨우 구했네. 진짜로 생각보다 버거운 과제잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700740804,
					"content": "이제 마지막 하나인가… 「큰 솥에 끓인 탕약」, 이건 타타우파 협곡으로 가야겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 700740805,
					"content": "먼저 갈 테니 서둘러 따라오도록!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 700740806,
					"content": "이봐——쟤 너무 신난 거 아니야? 나는 것보다 더 빨리 뛰어가는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700740807,
					"content": "역시 바람처럼 자유로운 사람이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "…술고래 아저씨다…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740810,
					"content": "음? 거기 누구 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "…으앗!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740812,
					"content": "디오나? 여기서 뭐 해? 왜 숨어 있어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700740813,
					"content": "그게… 과일 따러 나왔다가, 갑자기 그 아저씨를 마주쳐 버렸거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740814,
					"content": "요즘 계속 저번의 그 술을 또 만들어 달라고 귀찮게 굴어서… 어쩔 수 없이 피해 다니는 중이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740815,
					"content": "저번의 그 술이라니… 무슨 소리야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "얼마 전에 원정군이랑 같이 몬드로 돌아왔잖아? 그때 캣테일 술집에서 축하주를 마셨거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740817,
					"content": "축하 파티인가? 기사단에서 할 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700740818,
					"content": "「천사의 몫」에서 할 줄 알았는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "휴… 거기서도 다 했어. 캣테일 술집은 3차였지. 성안에 있는 술집을 전부 돌 기세였다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740820,
					"content": "…다음 원정군이 돌아오면, 또 같은 핑계로 똑같이 마셔댈 게 뻔해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700740821,
					"content": "틀림없지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "…어쨌든! 그 주정뱅이 아저씨들을 도저히 못 봐주겠는 거야! 그래서 제일 맛없고 구역질 나는 술을 만들어서 정신 좀 차리게 해주려고 했지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740823,
					"content": "하지만 넌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "맞아. 그래서 처음엔 왕자님한테 만들라고 했는데… 그 사람들이 술에 취해서 왕자님한테 장난을 치는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740826,
					"content": "…결국 왕자님은 중간에 도망갔어. 뭐, 대신 술고래 아저씨를 대차게 할퀴고 갔지만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740827,
					"content": "(바르카 씨가 말한 그 흉터… 설마…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "그걸 위해 혼돈의 비{RUBY#[D]술집}경에 들어가, 가장 사나운 마{RUBY#[D]왕자님}물과 싸워야만 했지…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 700740829,
					"content": "…근데 보니까, 음료가 거의 다 만들어진 상태더라고. 그래서 그냥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740830,
					"content": "네가 직접 마무리했구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "응…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740832,
					"content": "하나만 물어볼게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "음, 기사들 몸에 붙은 나무 부스러기랑, 숲에서 주운 비둘기 깃털…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740835,
					"content": "그리고 원래 술 깨우는 용으로 쓰려고 했던… 츄츄족의 탕약…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "디오나"
				},
				{
					"id": 700740836,
					"content": "#{NICKNAME}… 바르카는 최근에 막 돌아왔잖아? 그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700740837,
					"content": "…아직 모르겠지. 그런 재료로 술을 만들 수 있는 사람은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "으아… 큰일 났다! 빨리 막으러 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700740838,
					"content": "디오나뿐이라는 걸!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "거기에 뭘 넣은 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "뭐든 맛있게 만들어 버리잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "술 마시고 싶은 마음이 넘쳐나나 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
