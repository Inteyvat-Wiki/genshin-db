			"dialogs": [
				{
					"id": 700740401,
					"content": "대단해요! 이렇게 하는 거였구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 700740402,
					"content": "…됐어! 그 말은 전에도 너한테 많이 들었다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700740403,
					"content": "음… 이 부스러기… 모양도 질감도 거의 똑같군…. 품질이 아주 좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 700740404,
					"content": "나무 부스러기에 품질이 어딨어… 뭐, 네가 만족하면 된 거지만. 다음 재료는… 「기뻐서 떨어진 비둘기 깃털」인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
