			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "흥, 무슨 낯짝으로 계속 얻어먹기만 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030102,
					"content": "뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "나? 공짜 밥 먹는 못된 놈 밥 만들어주고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030104,
					"content": "매일 객잔에 와서 일도 안 하고 탱자 탱자 놀기만 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030105,
					"content": "매일 낚시한다고 하면서 물고기는 잡아온 적도 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030106,
					"content": "나 아니었다면 벌써 굶어죽었을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030107,
					"content": "됐다, 됐어. 어차피 듣지도 않는데 말해서 뭐 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030108,
					"content": "지금 채소가 좀 부족해서 그런데 시간 있으면 채소 좀 구해다 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030109,
					"content": "많이도 필요 없어. <color=#00E1FFFF>절운고추</color>랑 <color=#00E1FFFF>연꽃받침</color> 하나면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030110,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "찾으면 돌아와~ 바로 만들어야 하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				},
				{
					"id": 220030112,
					"content": "객잔에 채소 많잖아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "그건 사장님이 산 거고. 쟤가 돈 한번 낸 적 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030114,
					"content": "이것들은 전부 내가 산 건데… 칫! 내가 전생에 무슨 죄를 지었다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030115,
					"content": "빨리 갔다 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				}
			]
		},
