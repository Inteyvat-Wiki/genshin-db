						220030502
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220030502,
					"content": "이건 언소가 당신에게 주는 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "이 맛있는 냄새가 어디서 풍기나 했네. 역시 맛있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "강설"
				},
				{
					"id": 220030504,
					"content": "고마워, 나중에 돌아가서 고맙다고도 전해주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "강설"
