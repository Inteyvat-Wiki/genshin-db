			"dialogs": [
				{
					"id": 220030601,
					"content": "밥은 잘 전달했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030602,
					"content": "네. 그가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "말 안 해도 돼. 분명 고맙다니 뭐니 이런 쓸데없는 말만 했을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030604,
					"content": "그 말만 귀에 딱지 앉을 정도로 들었어. 고맙긴 개뿔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030605,
					"content": "고맙다는 말할 시간이랑 낚시할 시간은 있으면서 객잔에서 일할 시간만 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "언소"
				},
				{
					"id": 220030606,
					"content": "쳇! 너한테 이 말해서 뭐 해. 자, 여기 수고비",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				}
			]
		},
