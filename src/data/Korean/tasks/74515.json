	"talks": [
		{
			"id": 7451501,
			"completionStepIds": [
				7451501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7451501",
							"2"
						],
						"stepId": 7451501,
						"stateName": "QUEST_STATE_UNFINISHED"
