			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"자비에"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "오! 여행자, 상황이 그다지 좋지 않은 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190102,
					"content": "안에 있던 우인단이 갑자기 사람들을 코어 근처로 모으고 있어. 뭔가 발견한 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190103,
					"content": "코어의 방어를 뚫을 수 있을 것 같진 않은데… 아니, 더 이상 미룰 수 없어. 당장 기능성 테스트를 시작해야 하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190104,
					"content": "기능성 테스트?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "바로 이 새 동료의 정화 능력을 테스트해보는 거지. 들여보낸 뒤에 뭔갈 발견하긴 싫거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190106,
					"content": "그러니까 「귀신풍뎅이」 세 마리를 찾아 주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190107,
					"content": "귀신풍뎅이를 「미카게 용광로」 주위에 넣어서 그들이 「재앙신」의 영향을 받게 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190108,
					"content": "그런 다음 다시 꺼내 정화 장치로 「재앙신」의 영향받은 그들을 정화할 수 있는지 테스트하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190109,
					"content": "이게 바로 내가 설계한 「기능성 테스트」라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190110,
					"content": "어디서 「귀신풍뎅이」를 찾을 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "음… 그것들은 보통 번개 원소가 풍부한 지역에 서식하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190112,
					"content": "「미카게 용광로」 근처에도 산다고 들었어… 정말 대단한 애들이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190113,
					"content": "차라리 「미카게 용광로」에 가서 잡는 게 나을 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "그래도 되는데… 「미카게 용광로」에서 직접 「귀신풍뎅이」를 잡아서 테스트하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190115,
					"content": "솔직히 말해서 난 이 새 장치의… 신뢰성이 걱정돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190116,
					"content": "테스트를 할 때, 가장 좋은 것은 역시「순서에 따라 점진적으로」니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190117,
					"content": "크음, 어쨌든 「귀신풍뎅이」 세 마리를 가지고 오게. 여기서 기다리고 있을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190118,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "그럼 부탁하지. 「귀신풍뎅이」 세 마리만 있으면 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190120,
					"content": "차라리 제가 한번 돌고 오는 게 낫겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "어… 테스트 자체로 말하자면, 네가 직접 들어가서 한 바퀴 돌고, 「재앙신」을 잔뜩 묻혔다가 다시 나오면, 확실히 테스트 대상이 될 수도 있겠겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190122,
					"content": "하지만 앞서 말했지만, 이 장치의 신뢰성은… 기대에 못 미치니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190123,
					"content": "만약 정화 과정에서 우리가 미처 예상하지 못한 일이 생긴다면, 넌 어쩌면… 어, 예상 밖의 문제에 직면하게 될지도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190124,
					"content": "큼, 아무튼, 역시 「귀신풍뎅이」로 테스트하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721190125,
					"content": "「귀신풍뎅이」 세 마리만 있으면 되네. 잡으면 내게 가져다주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비에"
				}
			]
		},
