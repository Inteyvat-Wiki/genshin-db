			"dialogs": [
				{
					"id": 700010401,
					"content": "엥? 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "초조한 시민"
				},
				{
					"id": 700010402,
					"content": "바람의 꽃이 흩날리니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "바람의 꽃? 무슨 소리야? 민들레 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "초조한 시민"
				},
				{
					"id": 700010404,
					"content": "근데 그게 뭐 어때서? 민들레가 흩날리는 건 당연한 일이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "초조한 시민"
				},
				{
					"id": 700010405,
					"content": "미안, 실례했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700010406,
					"content": "평범한 시민 같아. 다른 사람한테 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
