			"dialogs": [
				{
					"id": 220490301,
					"content": "갔다 왔구나, 폭죽은 어땠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490302,
					"content": "아주 예뻤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "좋았으면 됐어, 하하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490306,
					"content": "좋아, 나도 슬슬 가게 좀 보러 가야겠어. 요즘 폭죽을 사러 오는 사람들이 점점 많아져서 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490307,
					"content": "딸내미 녀석은 왜 아직도 돌아오질 않는 건지. 어디까지 가서 꿈지럭대는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490304,
					"content": "더 하고 싶었어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "엄청 좋았나 보구나? 그럼 좋지, 다음에도 와서 갖고 놀도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "나가노하라 류노스케"
