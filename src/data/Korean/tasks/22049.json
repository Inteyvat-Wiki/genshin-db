				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "호오, 요이미야의 새 친구 아니냐? 오늘 놀러 온 게야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490102,
					"content": "오늘 장사는 좀 어떠세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "좋지, 좋아! 하하하, 딸내미가 폭죽을 쪼물딱거리면서 잘 만들어줘서 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490104,
					"content": "너희들 오늘은 그 아일 보러 온 게냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490107,
					"content": "아쉽지만 딸내미 말로는, 폭죽 재료를 구하러 밖에 나간다며 이미 가버렸거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490108,
					"content": "그럼 어디로 갔을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "뭐, 뭐라고? 뭐라고 했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490110,
					"content": "요이미야요, 어디로 갔냐고요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "오, 아이고… 이건 나도 잘 모르겠네, 딸내미가 말 해줬을 수도 있겠지만, 귀가 이래가지고 잘 들리지가 않아서 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490112,
					"content": "딸내미는 왜 찾는 건데? 저기 뭐야, 폭죽이라도 사서 놀게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490113,
					"content": "요이미야랑 놀고 싶어서요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "흠, 이번에는 아마 못 찾겠지 싶구나, 딸내미가 폭죽을 만들러 나갈 때는, 언제 돌아올지 모르거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490115,
					"content": "이러자, 딸내미가 나가기 전에 새 폭죽들을 몇 개 만들어다 가게에 뒀으니까, 너희들은 그 폭죽을 가져다가 좀 놀고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490118,
					"content": "내가 그 폭죽들을 어디다 뒀더라… 방 안에 뒀었나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490119,
					"content": "이러면 안 되지 않을까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "괜찮아, 괜찮아, 가게에 아직 물량이 많으니까, 너희들이 몇 개 갖고 논다고 해서 문제 될 거 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490122,
					"content": "게다가 딸내미도 원래 누구더러 새 폭죽들을 테스트 해달라 하려던 참이었으니까, 너희들이 오늘 온 김에 테스트해 주는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490123,
					"content": "마음 편히 가져가서 좀 놀아본 다음에, 돌아와서 어땠는지나 알려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490124,
					"content": "딸내미가 돌아오면 전해줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490125,
					"content": "걱정 마, 딸내미도 폭죽들을 가지고 논 게 너희인 걸 알게 되면 엄청 좋아할 테니까 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490126,
					"content": "어서 가 봐, 불은 성 밖에서 붙여야 해. 성안에서 폭죽놀이를 하면, 사람들이 또 엄청나게 몰려드니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490120,
					"content": "요이미야한테 말하지도 않고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "폭죽놀이 하고 싶다…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "하하, 그럼 딱이네. 딸내미가 나가기 전에 새 폭죽들을 몇 개 만들어다 가게에 뒀으니까, 너희들은 그 폭죽을 가져다가 좀 놀고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "나가노하라 류노스케"
				},
				{
					"id": 220490105,
					"content": "요이미야 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "아이고, 오늘 그 아이를 찾으러 온 거구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "나가노하라 류노스케"
				}
			]
		},
