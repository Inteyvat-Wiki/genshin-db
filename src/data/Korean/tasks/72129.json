					"nextDialogs": [
						721290604
					]
				},
				{
					"id": 721290604,
					"content": "오오, 괜찮아. 천천히 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카지"
				},
				{
