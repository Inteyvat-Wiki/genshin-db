			"dialogs": [
				{
					"id": 30025101,
					"content": "그럼 하이파시아 씨를 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30025102
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30025102,
					"content": "난 콜레이의 약을 달여야겠어. 달 연꽃은 신선할 때 약에 넣어야 효과가 가장 뛰어나거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30025103
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30025103,
					"content": "콜레이는 약 먹고 나면 괜찮아질 테니 걱정하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타이나리"
				}
			]
		},
