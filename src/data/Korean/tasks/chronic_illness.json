					"타이나리"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020101,
					"content": "너희구나, 마침 찾으러 가려고 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020102
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020102,
					"content": "어, 타이나리, 네가 왜 여기 있어? 콜레이는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020103,
					"content": "콜레이 상태 좀 보려고 왔어. 조금 아픈 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020104
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020104,
					"content": "아프다고? 어째서… 잠깐, 설마 어제 내가 한 실수 때문에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020105,
					"content": "걱정 마, 너 하나 때문에 그렇게 심각한 일이 생기진 않으니까. 콜레이가 아픈 건 지병 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020106
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020106,
					"content": "솔직히 말하면 너희가 오고 나서 콜레이가 너무 기분이 업된 나머지 자신의 몸 상태를 잊은 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020107
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020107,
					"content": "후우, 어쩔 수 없지. 친구를 본 지 꽤 되었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020108
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020108,
					"content": "타이나리, 콜레이는 대체…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020109,
					"content": "장소를 옮기자, 콜레이는 약 먹고 막 잠들어서 안정을 취해야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타이나리"
				}
			]
		},
		{
			"id": 300202,
			"completionStepIds": [
				300203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300203",
							"2"
						],
						"stepId": 300203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"타이나리"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30020201,
					"content": "자, 이곳에서 이야기를 계속 해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020202
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020202,
					"content": "방금 콜레이가 말해줘서 네가 몬드의 명예 기사인 걸 알았어. 나도 네가 리월과 이나즈마에서 한 의로운 일에 대해 들은 적 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020203
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020203,
					"content": "미리 말해두는데 콜레이에 대한 사실을 너희들에게 알려주는 건 너희의 신분이나 경험과는 전혀 상관없이 단 한 가지 이유 때문이야——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020204
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020204,
					"content": "콜레이가 말해달라고 부탁했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020205
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020205,
					"content": "사실 난 콜레이가 자신이 겪었던 일을 너희에게 알리지 않았으면 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020206
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020206,
					"content": "하지만 콜레이는 너희들이 자기를 친구처럼 대해주고 진심으로 다가가 준 만큼 자기도 똑같이 대해야 된다고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020207
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020207,
					"content": "타이나리, 콜레이는 무슨 병에 걸린 거야? 방금 「지병」이라고 했잖아, 병에 걸린 지 오래 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020208,
					"content": "맞아, 콜레이는 어렸을 때부터 「비늘병」을 앓았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020209
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020209,
					"content": "「비늘병」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020210,
					"content": "수메르에만 있는 병인데 환자의 몸에 어두운 잿빛 비늘 같은 조직이 생겨서 비늘병이라 불러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020211
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020211,
					"content": "처음에는 변한 피부에 마비가 오는데, 병세가 악화되면 힘이 줄어들고 손가락과 발가락 감각이 간헐적으로 사라지는 상태가 되기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020212
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020212,
					"content": "그러다 결국 자기 몸을 제어하지 못하고 움직이는 능력을 완전히 상실하게 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020213
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020213,
					"content": "듣기만 해도 무시무시하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020214,
					"content": "「자기 몸을 제어하지 못한다고」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020215
					]
				},
				{
					"id": 30020215,
					"content": "잠깐, 그럼 전에 콜레이가 덜렁대고 실수한 게 다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020216,
					"content": "맞아, 비늘병 때문이지. 그래서 콜레이가 다치지 않게 되도록이면 물건을 들지 않게 한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020217
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020217,
					"content": "치료가 가능한 병이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020218
					]
				},
				{
					"id": 30020218,
					"content": "치료 방법이 적절하면 병세를 억제할 수는 있어. 하지만 유감스럽게도 아직 비늘병을 완전히 치료할 방법은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020219
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020219,
					"content": "그런데 누군가 콜레이의 어머니에게 비늘병을 고칠 수 있다고 속여 딸아이를 「우인단」이라는 조직에 넘기라고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020220
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020220,
					"content": "뭐? 우인단?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020221,
					"content": "우인단을 아나 보네. 좋아, 설명을 생략해도 되겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020222
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020222,
					"content": "아무튼 나한테 콜레이를 돌봐달라고 부탁한 사람이 말하길, 콜레이는 「도토레」라는 집행관에게 넘겨졌었대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020223
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020223,
					"content": "「도토레」가 어떤 방법을 썼는지는 몰라도 거기에 있는 동안 비늘병이 완전히 억제되긴 했다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020224
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020224,
					"content": "하지만 우인단에서의 기억이 콜레이에게 좋은 기억만은 아니었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020225
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020225,
					"content": "콜레이는 항상 밝고 씩씩한 모습을 보이려고 하지만, 지금도 가끔 다른 사람과의 접촉을 두려워할 때가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020226
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020226,
					"content": "콜레이가 그런 끔찍한 일을 겪었다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020227,
					"content": "맞다, 페이몬. 콜레이가 놀라게 해서 미안하다고 전해 달라고 했어. 그리고 너희에게 병에 대해서 숨긴 것도 미안하대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020228
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020228,
					"content": "그건 콜레이 잘못이 아니니까 사과할 필요 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020229,
					"content": "응, 그 말은 다음에 만나면 직접 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020230
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020230,
					"content": "콜레이는 자신이 우정을 얻을 자격이 없다고 생각했었거든. 내 제자가 같은 아픔을 겪지 않게 해줬으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020231
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020231,
					"content": "걱정하지 마, 타이나리!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020232,
					"content": "콜레이 상태는 좀 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020233
					]
				},
				{
					"id": 30020233,
					"content": "다행히 심각하진 않아. 며칠 동안 무리한 바람에 체력이 방전돼서 쓰러진 거야. 약 먹었으니까 좀 쉬면 괜찮아질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020234
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020234,
					"content": "콜레이가 처음에 간다르바 성곽에 왔을 때는 지금보다 상태가 훨씬 좋았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020235
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020235,
					"content": "그때는 콜레이가 숲의 순찰자 일에 관심이 많고 지식을 배우고 싶어 해서 우리 팀에 들어오라고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020236
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020236,
					"content": "요즘은 체력이 많이 떨어졌어. 적당히 운동을 해야 하긴 하지만 장거리 순찰은 더 이상 콜레이에게 무리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020237
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020237,
					"content": "암튼, 콜레이의 상태는 대충 이래. 난 콜레이의 약재를 캐러 가봐야 되니 대화는 여기까지 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020238
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020238,
					"content": "우리도 같이 가면 안 돼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30020239
					]
				},
				{
					"id": 30020239,
					"content": "맞아, 타이나리. 우리도 콜레이를 도와주고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020240
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020240,
					"content": "…좋아. 다만 우림은 아주 위험해. 게다가 여행자는 아직 회복 중이니 내 지시에 따라줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020241
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 30020241,
					"content": "응, 알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30020242
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30020242,
					"content": "가자. 「달 연꽃」이라는 식물을 구하러 갈 거야. 비늘병 환자의 기력 회복에 큰 도움이 되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타이나리"
				}
			]
		},
