			"dialogs": [
				{
					"id": 710350101,
					"content": "너희구나, 무슨 요리를 먹고 싶어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 710350102,
					"content": "흘호어 구이 3인분, 포장이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "좋아! 잠시만 기다려 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 710350104,
					"content": "3인분? 나, 너… 그리고 나머지 1인분은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350105,
					"content": "동작을 보러 가고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "전에 우리한테 칠성등과 향로를 줬던 그 동작 얘기하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350108,
					"content": "맞아, 동작 씨는 흘호어 구이가 무척 먹고 싶다고 했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350109,
					"content": "하지만 동작은 이미 떠났을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350110,
					"content": "가보는 것도 괜찮잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "응, 그럼 다시 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350112,
					"content": "전에 저쪽에서 동작을 만났을 때, 사당은 낡고 허름했어. 옆에는 보물 사냥단의 흔적도 있었고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350113,
					"content": "동작의 조각상이 더 이상 망가지지 않았으면 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350114,
					"content": "흘호어 구이 3인분 포장됐어, 자, 여기",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 710350115,
					"content": "#맛있는 냄새! {NICKNAME}, 그럼 얼른 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350106,
					"content": "동작은 흘호어 구이를 제일 좋아하잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
