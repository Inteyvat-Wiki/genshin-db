				"points": []
			},
			"dialogs": [
				{
					"id": 710350301,
					"content": "선인님, 영웅님, 감사합니다… 여기서 또 뵐 줄은 몰랐어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350302,
					"content": "우릴 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350303,
					"content": "제가 선인님을 잊을 리가요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350304,
					"content": "당신은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "왕평안이라고 합니다! 기억나시나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350306,
					"content": "「철성확진천군」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "네에?! 아뇨아뇨, 「철성확진」이라뇨, 당치도 않습니다. 선인님도 계시는데 놀리지 마세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350310,
					"content": "전 산에 있는 야차 「동작」님의 사당에 가보려던 참이었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350311,
					"content": "하지만 산에 들어간 지 얼마 안 돼 보물 사냥단의 표적이 됐죠… 구해주셔서 감사합니다, 선인님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350312,
					"content": "잠깐, 동작 씨의 사당에는 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350313,
					"content": "설마… 동작 씨 조각상에 눈독 들인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350314,
					"content": "아뇨! 그건 당치도 않은 생각이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350315,
					"content": "그럼 뭘 하려고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "전 그냥… 사당을 제대로 수리하고 싶었을 뿐입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350317,
					"content": "오늘 이곳에 온 것도 맞는 재료를 구매하려고 사당의 상태를 확인하러 온 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350318,
					"content": "그런데 가는 길에 보물 사냥단의 습격을 받아서 도망치는 수밖에 없었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350319,
					"content": "그렇게 도망치다가… 길을 잃게 됐습니다. 그 후의 일은 여러분들도 아시겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350320,
					"content": "사당으로 가서 자세히 얘기하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "네, 대화를 나누기 좋은 곳은 아닌 것 같네요. 일단 사당 쪽으로 가요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350322,
					"content": "다른 얘기는 도착해서 다시 얘기하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350323,
					"content": "먼저 가, 난 아직 볼일이 남았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "소"
				},
				{
					"id": 710350324,
					"content": "엣! 가는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350325,
					"content": "벌써… 가버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350308,
					"content": "당신을 기억해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "기억해 주셔서 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "왕평안"
				}
			]
		},
		{
			"id": 7103504,
