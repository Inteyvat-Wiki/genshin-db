				"points": []
			},
			"dialogs": [
				{
					"id": 710350201,
					"content": "네가 어떻게 여길?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "소"
				},
				{
					"id": 710350202,
					"content": "소도 동작을 보러 온 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "그냥 지나가다 잠시 멈춘 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "소"
				},
				{
					"id": 710350204,
					"content": "너희들, 무슨 일로 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "소"
				},
				{
					"id": 710350205,
					"content": "우린 동작 씨를 보러 온 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350206,
					"content": "하지만 이 주변은 여전히 저번처럼 엉망진창이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350207,
					"content": "사당도 짓고, 조각상도 만들어져 있는데… 왜 관리하는 사람은 없는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350208,
					"content": "깜빡했을지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "그걸 깜빡할 수가 있는 거야? 야차는 리월항을 지킨 영웅인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350210,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "소"
				},
				{
					"id": 710350211,
					"content": "소… 혹시 기, 기분이 별로야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350212,
					"content": "아니. 야차는 수호의 직책을 수행할 뿐. 후손의 기념 같은 건 바라지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "소"
				},
				{
					"id": 710350213,
					"content": "이 얘기는 나중에 하고, 얼른 흘호어 구이부터 먹자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350214,
					"content": "음… 소도 흘호어 구이가 먹고 싶으면 우리가 절반씩 나눠줄 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350215,
					"content": "그럴 필요 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "소"
				},
				{
					"id": 710350216,
					"content": "사람 살려! 사람 살려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350217,
					"content": "응? 무슨 소리가 들린 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350218,
					"content": "누군가 도움을 청하고 있어, 저쪽이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "소"
				},
				{
					"id": 710350219,
					"content": "빨리 가자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "엥? 흘호어 구이 잘 챙겨! 아직 못 먹었단 말야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
