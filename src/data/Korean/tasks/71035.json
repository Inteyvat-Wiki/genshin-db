				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "이 사당은 여전히 황폐하네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350402,
					"content": "얼른 말해, 왜 갑자기 사당을 고치러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350403,
					"content": "크흠, 말하자면 긴데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350404,
					"content": "전에 선인 행세를 하려고 자료를 많이 수집했거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350405,
					"content": "그때, 전 선인님의 가르침을 받고 개과천선하겠다는 맹세를 했었죠. 그래서 전 돌아가서 그 자료들을 전부 불태울 생각이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350406,
					"content": "그런데 나중에 생각해 보니… 자료를 불태우는 것보다, 선인 행세하는 방법을 핸드북으로 엮어서 사람들한테 나눠주는 게 더 좋을 것 같다는 생각이 들더라구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350407,
					"content": "사람들이 사기꾼을 간파하는 데 도움이 될 수 있겠다는 생각이 들어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350408,
					"content": "그런데 제가 엮은 핸드북이 정말 사기 예방에 도움이 될 줄은 몰랐어요. 총무부 분들도 핸드북이 무척 유용하다고 하셨구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350409,
					"content": "제가 쓴 부분 외에도, 기타 사기 예방 내용을 추가해 달라는 요청도 들어왔죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350410,
					"content": "총무부에서는 추가 내용에 대한 돈도 지불했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350411,
					"content": "최근에는 핸드북 외에, 「호법야차」와 관련된 책을 편집하는 중이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350412,
					"content": "이 책을 통해 모두에게 「호법야차」의 이야기를 전하고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350413,
					"content": "제가 배운 민속학 지식들도 올바른 길에 사용된 셈이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350414,
					"content": "「동작」님의 사당도 「호법야차」와 관련된 책을 편집할 때 발견하게 됐어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350415,
					"content": "기록에 따르면, 이 사당은 선조들이 야차 「동작」을 기념하기 위해 지은 것이라고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350416,
					"content": "하지만 이렇게 황폐할 거라곤 생각도 못 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350417,
					"content": "돌아간 후 이런저런 고민 끝에… 사비를 들여 사당을 다시 재건하기로 결정했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350418,
					"content": "어쨌든 제가 바른길을 걷게 된 건 전부 선인님이 주신 가르침 덕분이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350419,
					"content": "이 사당을 재건하는 것도, 제가 저지른 잘못을 조금이나마 속죄하는 방법이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350420,
					"content": "음… 거짓말은 아닌 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350421,
					"content": "#{NICKNAME}, 네 생각은 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710350422,
					"content": "나름 진심인 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "나름이라뇨, 진심입니다, 정말로요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350426,
					"content": "휴, 됐어요. 좋을 대로 생각하세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350427,
					"content": "그렇게 안 믿긴다면, 보수 작업을 시작할 때 다시 와 보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "왕평안"
				},
				{
					"id": 710350424,
					"content": "전에는 사기꾼이었잖아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "지금은 아니라니까요! 지금은 정말 착하고 바른 사람입니다, 선인님 앞에서 맹세까지 했잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "왕평안"
				}
			]
