				"points": []
			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "동풍의 용, 남풍의 사자, 북풍의 늑대, 서풍의 매…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081402,
					"content": "그들이 바로 몬드를 지키는 수호자이자 바람의 신 「바르바토스」의 권속이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081403,
					"content": "드발린——풍마룡의 이름이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081404,
					"content": "사람들에게 마룡이라고 불리기 전에는 「바람 사신수」의 「동풍의 용」이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081405,
					"content": "이게 바로 드발린이 나머지 셋의 힘을 빌릴 수밖에 없었던 이유지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081406,
					"content": "드발린은 처음부터 「자기 자신」을 불태우고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081407,
					"content": "대체 왜…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "아마도… 「원한」 때문인 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081410,
					"content": "원한…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3081411,
					"content": "몬드에 대한 원한…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081412,
					"content": "원한에 눈이 멀어 마룡으로 변한 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081413,
					"content": "「바람 사신수」 중 하나면서 갑자기 왜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3081414,
					"content": "지켜야 할 도시에 원한을 가지게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3081415,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081416,
					"content": "몬드 출신으로 말을 꺼내기 어렵네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081417,
					"content": "이걸 가지고 가서 읽어 봐…. 이게 100년 전에 발생했던 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리사"
				},
				{
					"id": 3081408,
					"content": "도대체 왜 이렇게까지 하는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
