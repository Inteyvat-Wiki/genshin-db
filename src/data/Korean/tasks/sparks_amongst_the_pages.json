			"dialogs": [
				{
					"id": 3081101,
					"content": "어머, 귀염둥이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081102,
					"content": "이렇게 위험한 일도 도와주려고? 진짜 감동이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081103,
					"content": "모르는 게 있으면 나한테 물어봐, 다 알려줄 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081104,
					"content": "도서관 사서면 주로 무슨 일을 하는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "좋은 질문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081106,
					"content": "기본적으로 몸이랑 머리 쓰는 걸 제외한 일이라고 봐도 무방할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081107,
					"content": "몸이랑 머리 쓰는 걸 제외하면 어떤 일이 남아있다는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3081111,
					"content": "그러니까 너희들도 나만 믿으면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리사"
				},
				{
					"id": 3081108,
					"content": "왜 도서관 사서가 유적에…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "좋은 질문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "리사"
				},
				{
					"id": 3081110,
					"content": "정답은… 당연히 진이 날 신임하기 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
