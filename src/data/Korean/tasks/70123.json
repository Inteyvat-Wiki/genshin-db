			"dialogs": [
				{
					"id": 701230101,
					"content": "아빠는 어디 가신 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230102,
					"content": "왜 그러니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "아…. 안녕하세요. 아… 아빠가 안 오셔서요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230104,
					"content": "절 데리고 설산에 가서 눈 구경시켜준다고 하셨거든요. 근데 약속한 날이 됐는데도 안 오시네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230105,
					"content": "분명 엄청난 보물 지도 같은 걸 찾아서 아직 안 온 걸 거예요. 응, 그렇고 말고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230106,
					"content": "그래서 혼자 설산에 왔어요. 아빠를 찾으러요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230107,
					"content": "그런데 여기에서도 아빠를 못 찾았어요. 저 페보니우스 기사 아저씨는 아빠가 산꼭대기로 가는 걸 봤대요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230108,
					"content": "아빠를 찾으러 가려고 했는데 기사 아저씨가 못 가게 해서 일단 여기서 기다리고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230109,
					"content": "근데… 아빠가 아직도 안 오셔서 걱정이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230110,
					"content": "설산에 갈 수 있으면 아빠를 좀 찾아주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230111,
					"content": "내게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "도와주시는 거예요? 정말 고마워요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230114,
					"content": "저… 기사 아저씨가 그러는데, 아빠는 일단 <color=#00E1FFFF>「눈 덮힌 길」을 따라 계속 올라간다</color>고 하셨대요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230115,
					"content": "그리고 <color=#00E1FFFF>설산 서쪽 오름</color> 근처를 살펴본 다음 마지막으로 <color=#00E1FFFF>산꼭대기</color>에 오르고 싶다고 그러셨대요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230116,
					"content": "이곳들을 먼저 찾아보면 어떨까요? 근처에 계실지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230117,
					"content": "저와 눈 구경을 가겠다고 했으니, 약속을 꼭 지키실 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230112,
					"content": "어디로 가서 찾아야 할까?",
					"roleType": "TALK_ROLE_PLAYER",
