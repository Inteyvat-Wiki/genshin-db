				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"요엘"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230501,
					"content": "어떻게 됐나요? 아빠는 찾았어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230502,
						701230511
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230502,
					"content": "산꼭대기 동굴에서 발견한 것에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230503
					]
				},
				{
					"id": 701230503,
					"content": "아빠는…. 아니 아빠는 대단한 모험가예요. 이 정도 사소한 일은 반드시 해결하실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230504
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230504,
					"content": "아빠의 노트에는 하산하는 법을 찾았다고 나와 있어요…. 분명 무사히… 내려오셨겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230505
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230505,
					"content": "무사히 산에서 내려오셨을 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230506
					]
				},
				{
					"id": 701230506,
					"content": "네…. 산에서 내려와서 지금 쉬고 계실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230507
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230507,
					"content": "아니면… 산꼭대기의 다른 곳에 새로운 야영지를 세우고 쉬고 계시겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230508
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230508,
					"content": "어쨌든 아빠는 좀 쉬고 나면… 절 만나러 오실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230509
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230509,
					"content": "전 여기서 계속 기다릴게요. 도와줘서 고마워요. 이거 받으세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230511,
					"content": "아무것도 못 찾았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230512
					]
				},
				{
					"id": 701230512,
					"content": "아… 그래요? 근데 기사 아저씨는 아빠가 설산에 올라가는 걸 밨다고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230513
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230513,
					"content": "그 아저씨가 잘못본 걸까요? 아니면… 아빠가 다른 곳에 새로운 야영지를 세웠을까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230514
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230514,
					"content": "알겠어요. 어쨌든 여기서 기다려야겠네요…. 아빠가 돌아왔는데 제가 없으면 걱정하실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230515
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230515,
					"content": "도와주셔서 고마워요. 이거 받으세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230516
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 701230516,
					"content": "아빠… 어디 계신 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요엘"
				}
			]
