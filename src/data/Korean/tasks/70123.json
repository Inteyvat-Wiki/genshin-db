			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230301,
					"content": "가는 내내 무사하다. 날씨도 여전히 좋다. 드디어 운이 풀리나보다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230302
					],
					"speakerTitle": "단정한 글씨의 노트"
				},
				{
					"id": 701230302,
					"content": "이런 상황이라면 산꼭대기에 도전해도 될 것 같다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230303
					],
					"speakerTitle": "단정한 글씨의 노트"
				},
				{
					"id": 701230303,
					"content": "일단 조금만 가보자. 가다가 문제가 생기면 바로 철수해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "단정한 글씨의 노트"
				}
			]
		},
		{
			"id": 7012304,
			"completionStepIds": [
				7012304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012303",
