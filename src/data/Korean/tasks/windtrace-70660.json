					"캐서린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "여행자, 안녕! 요즘 모험은 할 만해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706600102,
					"content": "네, 할만해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "그거 다행이네, 계속 이렇게 모험을 계속하다 보면 언젠가는 위대한 모험가가 될 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706600104,
					"content": "맞다, 관심 있으면 가이각스에게 가서 새로 만든 「바람의 행방」을 체험해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706600108,
					"content": "모험가 길드와… 관련이 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "그게… 가이각스 씨가 길드에 의뢰를 했거든, 「바람의 행방」을 체험할 사람을 구해달라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706600110,
					"content": "이렇게 보면… 관계가 있다고 할 수도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706600111,
					"content": "아무튼 테스트할 의향이 있으면 가서 한번 참여해 봐. 「바람의 행방」을 참여해 본 모험가들 말을 들어보면 엄청 재밌다고 했거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706600105,
					"content": "새로운 의뢰가 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "의뢰는… 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706600107,
					"content": "하지만 관심 있으면 가이각스에게 가서 새로 만든 「바람의 행방」을 체험해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "캐서린"
				}
			]
		},
		{
