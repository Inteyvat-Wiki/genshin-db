				"points": []
			},
			"dialogs": [
				{
					"id": 733500401,
					"content": "에… 에취! 이 향신료 냄새는 정말이지… 푸에취!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500402
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500402,
					"content": "빨리 사진이나 찍고 방에 돌아가 있는 게 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500403
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500403,
					"content": "여행자! 저, 저기, 잠깐만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500404,
						733500405
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500404,
					"content": "저요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500406
					]
				},
				{
					"id": 733500406,
					"content": "혹시 사진 좀 찍어줄래? 오래 걸리진 않을 거야, 한 장이면 충분하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500409
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500409,
					"content": "아, 얘기하면 비웃을 것 같은데, 실은 이 지역의 향신료 냄새가 너무 자극적이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500410
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500410,
					"content": "폰타인에선 해 봤자 소금 간이 전부라 매운맛을 느낄 일이 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500411
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500411,
					"content": "그런데 수메르에 오니까 사람들 몸에서 향신료 냄새가… 에… 에취!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500412
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500412,
					"content": "수메르 사람들한텐 부탁을 못 하겠더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500413
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500413,
					"content": "그래서 너한테 부탁하게 된 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500414
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500414,
					"content": "폰타인에서 오셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500415
					]
				},
				{
					"id": 733500415,
					"content": "맞아. 미안, 내 소개를 잊고 있었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500416
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500416,
					"content": "내 이름은 아우구스투스·러브레이스, 「폰타인 운동 에너지 공학 연구원」 소속 연구원이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500417,
						733500418
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500417,
					"content": "「폰타인 운동 에너지 공학 연구원」이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500419
					]
				},
				{
					"id": 733500419,
					"content": "이름이 너무 길지? 다른 폰타인 사람들처럼 「폰타인 과학원」이라고 불러도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500420
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500420,
					"content": "한때 폰타인 과학원은 폰타인 연구원들의 성지나 마찬가지였어. 대부분 장치가 우리 과학원에서 제작됐거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500421
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500421,
					"content": "하지만 천재 에드윈 씨의 주도하에 폰타인 과학원의 건물 대부분이 폐허가 되고 말았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500422
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500422,
					"content": "레이먼드와 슈아죌 씨가 재건 작업을 맡은 뒤로 과학원의 「연구 정신」도 무너지고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500423
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500423,
					"content": "난 깔끔한 편이라 폐허에서 지내고 싶지 않았어. 그래서 기분 전환을 위해 곳곳을 떠돌기 시작한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500424
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500424,
					"content": "찌푸릴 거 없어, 너랑 관계없는 일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500425
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500425,
					"content": "자, 어서 사진 한 장 찍어줘. 자비에한테 수메르의 풍경을 보여주면 이나즈마를 벗어날 생각이 들겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500426,
						733500436
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500426,
					"content": "같이 일했던 적이 있어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500427
					]
				},
				{
					"id": 733500427,
					"content": "너… 앗! 설마 자비에가 말한 여행자가 너였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500428
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500428,
					"content": "반가워! 자비에의 편지를 통해 「미카게 용광로」에서의 네 영웅담은 익히 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500429
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500429,
					"content": "편지에서 「활동 사진」을 언급할 때마다 네 뛰어난 연기력을 얼마나 강조하던지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500430
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500430,
					"content": "자비에는 네가 용감하고 고상한 데다, 무엇보다 유머 감각이 넘친다고 했지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500431
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500431,
					"content": "사진을 찍고 나서 그 위에 사인해 줘야 해, 꼭이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500432
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500432,
					"content": "자비에 씨는 괜찮나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500433
					]
				},
				{
					"id": 733500433,
					"content": "음… 실은 별로 안 괜찮아. 「활동 사진」으로 골머리를 앓고 있거든. 편지를 보니 새로운 소재를 못 찾고 있는 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500434
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500434,
					"content": "우선 일을 멈추고 바람 쐴 겸 수메르에 오라고 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500435
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500435,
					"content": "최고의 「활동 사진」을 찍어 「야시로 봉행」에 내기 전까지는 이나즈마를 떠나지 않겠다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500441
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500441,
					"content": "이 얘기는 그만하자. 여기 서 있을 테니까, 사진이나 찍어줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500436,
					"content": "자비에 씨와는 어떻게 알게 됐어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500437
					]
				},
				{
					"id": 733500437,
					"content": "알다시피 자비에는 폰타인 과학원의 연구원이야. 연구실에서 함께 일하면서 날 많이 도와줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500438
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500438,
					"content": "자비에는 「활동 사진」을 찍는 「활동 사진 감독」이 되겠다고 했지만, 그 의견은 당시 폰타인 과학원에서 환영받지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500439
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500439,
					"content": "하지만 자비에는 다른 프로젝트로 쫓겨난 후에도 연구 과정을 기록한다면서 「다큐멘터리 활동 사진」을 계속해서 찍었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500442
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500442,
					"content": "그렇게 프로젝트와 연구실을 전전하던 자비에는 결국 이나즈마로 파견됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500440
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500440,
					"content": "감각적인 친구라 연구 방향이 분명하고 연구비가 넉넉했던 과거나, 아름다운 미래에 태어났다면 훨씬 더 많은 걸 이룰 수 있었을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500441
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500418,
					"content": "뭐 하는 곳인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500419
					]
				},
				{
					"id": 733500405,
					"content": "무슨 일인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500406
					]
				}
			]
		}
	]
}