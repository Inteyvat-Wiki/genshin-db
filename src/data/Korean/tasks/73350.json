			"trigger": {
				"objectNames": [
					"아우구스투스·러브레이스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500101,
					"content": "에… 에취! 이 향신료 냄새는 정말이지… 푸에취!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500102
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500102,
					"content": "빨리 사진이나 찍고 방에 돌아가 있는 게 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500103
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500103,
					"content": "여행자! 저, 저기, 잠깐만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500104,
						733500105
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500104,
					"content": "저요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500106
					]
				},
				{
					"id": 733500106,
					"content": "혹시 사진 좀 찍어줄래? 오래 걸리진 않을 거야, 한 장이면 충분하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500109
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500109,
					"content": "아, 얘기하면 비웃을 것 같은데, 실은 이 지역의 향신료 냄새가 너무 자극적이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500110
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500110,
					"content": "폰타인에선 해 봤자 소금 간이 전부라 매운맛을 느낄 일이 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500111
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500111,
					"content": "그런데 수메르에 오니까 사람들 몸에서 향신료 냄새가… 에… 에취!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500112
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500112,
					"content": "수메르 사람들한텐 부탁을 못 하겠더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500113
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500113,
					"content": "그래서 너한테 부탁하게 된 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500114
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500114,
					"content": "폰타인에서 오셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500115
					]
				},
				{
					"id": 733500115,
					"content": "맞아. 미안, 내 소개를 잊고 있었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500116
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500116,
					"content": "내 이름은 아우구스투스·러브레이스, 「폰타인 운동 에너지 공학 연구원」 소속 연구원이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500117,
						733500118
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500117,
					"content": "「폰타인 운동 에너지 공학 연구원」이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500119
					]
				},
				{
					"id": 733500119,
					"content": "이름이 너무 길지? 다른 폰타인 사람들처럼 「폰타인 과학원」이라고 불러도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500120
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500120,
					"content": "한때 폰타인 과학원은 폰타인 연구원들의 성지나 마찬가지였어. 대부분 장치가 우리 과학원에서 제작됐거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500121
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500121,
					"content": "하지만 천재 에드윈 씨의 주도하에 폰타인 과학원의 건물 대부분이 폐허가 되고 말았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500122
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500122,
					"content": "레이먼드와 슈아죌 씨가 재건 작업을 맡은 뒤로 과학원의 「연구 정신」도 무너지고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500123
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500123,
					"content": "난 깔끔한 편이라 폐허에서 지내고 싶지 않았어. 그래서 기분 전환을 위해 곳곳을 떠돌기 시작한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500124
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500124,
					"content": "찌푸릴 거 없어, 너랑 관계없는 일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500125
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500125,
					"content": "자, 어서 사진 한 장 찍어줘. 자비에한테 수메르의 풍경을 보여주면 이나즈마를 벗어날 생각이 들겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500126
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500126,
					"content": "자비에 씨에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500127
					]
				},
				{
					"id": 733500127,
					"content": "자비에는 폰타인 과학원의 연구원이야. 나랑 같은 연구실에 있었는데, 함께 일할 때 날 많이 도와줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500128
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500128,
					"content": "자비에는 「활동 사진」을 찍는 「활동 사진 감독」이 되겠다고 했지만, 그 의견은 당시 폰타인 과학원에서 환영받지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500129
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500129,
					"content": "하지만 자비에는 다른 프로젝트로 쫓겨난 후에도 연구 과정을 기록한다면서 「다큐멘터리 활동 사진」을 계속해서 찍었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500132
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500132,
					"content": "그렇게 프로젝트와 연구실을 전전하던 자비에는 결국 이나즈마로 파견됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500130
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500130,
					"content": "감각적인 친구라 연구 방향이 분명하고 연구비가 넉넉했던 과거나, 아름다운 미래에 태어났다면 훨씬 더 많은 걸 이룰 수 있었을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500131
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500131,
					"content": "이 얘기는 그만하자. 여기 서 있을 테니까, 사진이나 찍어줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500118,
					"content": "뭐 하는 곳인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500119
					]
				},
				{
					"id": 733500105,
					"content": "무슨 일인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500106
					]
				}
			]
		},
