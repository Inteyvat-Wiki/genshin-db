			},
			"dialogs": [
				{
					"id": 733500201,
					"content": "사진은 다 찍었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500202
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500202,
					"content": "아직이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500203
					]
				},
				{
					"id": 733500203,
					"content": "앗, 천천히 해. 사진을 찍는 게 쉬운 일은 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아우구스투스·러브레이스"
				}
			]
		},
		{
			"id": 7335003,
			"completionStepIds": [
				7335003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7335003",
							"2"
						],
						"stepId": 7335003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아우구스투스·러브레이스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500301,
					"content": "잘 나왔네. 사진 찍기에 소질이 있구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500302
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500302,
					"content": "지금까지 여행하면서 본 사람 중에 이렇게 구도와 색감을 잘 알고 있는 사람은 네가 처음이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500303
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500303,
					"content": "어디어디 가보셨어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500304
					]
				},
				{
					"id": 733500304,
					"content": "그게, 음… 사실 폰타인에는 수메르의 베이다 항구까지 직통으로 가는 항로가 있어서 그냥 바로 수메르로 왔어도 되긴 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500312
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500312,
					"content": "왜 그런 말도 있잖아, 여행에서 가장 중요한 건 과정이라고. 그래서 더 재미있을 것 같은 경로를 선택했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500313
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500313,
					"content": "난 우선 등방울 항구를 거쳐 침옥 협곡으로 간 다음 경책 산장을 지나 몬드와 리월을 구분하는 석문에 도착했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500310
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500310,
					"content": "그 후 다운 와이너리에 들렀다가 남쪽에 있는 리월항을 둘러보기로 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500305
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500305,
					"content": "그리고 리월항에서 오르모스 항구로 향하는 배를 타고 북쪽으로 이동해 이곳에서 널 만나게 된 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500306
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500306,
					"content": "이번 여행의 목적은 기분 전환이거든. 만약 내가 모험에 진심인 용사였다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500311
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500311,
					"content": "뭐 바다 이슬 항구에서 출발해 고대 순례길을 지나 남쪽의 사막으로 갈 수도 있었겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500307
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500307,
					"content": "…누가 알겠어? 어쩌면 돌아가는 길에 사막을 건널지도 모르지. 아직 돈이 충분해서 사막을 지나 나타로 가볼까 싶기도 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500308
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500308,
					"content": "자, 그럼 더는 시간 뺏지 않을게. 사진을 찍어줘서 고마워, 이건 보수야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500309
					],
					"speakerTitle": "아우구스투스·러브레이스"
				},
				{
					"id": 733500309,
					"content": "난 이제 자비에한테 편지를 쓰러 가야겠어. 자비에가 수메르로 오지 않으면, 나도 폰타인으로 돌아갈 거니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아우구스투스·러브레이스"
				}
			]
		},
