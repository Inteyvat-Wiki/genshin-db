			"dialogs": [
				{
					"id": 761360301,
					"content": "(<color=#FFCC33FF>야호다</color>라면 상자를 확인하고 싶을지도 몰라…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "히히… 최근에 얼마나 벌었으려나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360303,
					"content": "저번에 보스가 보너스를 주겠다고 했으니까, 그냥 이참에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360304,
					"content": "…돈이 안 들어 있네? 웬 쪽지가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360305,
					"content": "「야호다에게. 상자는 잘 닫아두렴. 네 보너스는 여기서 나오는 게 아니란다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360306,
					"content": "쳇, 보스가 또 겁주네. 숨겨진 공간 같은 거 없나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360307,
					"content": "그런 건 없어. 네 보너스는 여기 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761360308,
					"content": "오! 고마워 보스, 나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360309,
					"content": "으아아아아아아아——보보보보스! 나, 난 그냥 확인만 해봤을 뿐이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360310,
					"content": "바로 일하러 갈게, 지금 당장——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360311,
					"content": "거기 서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761360312,
					"content": "넵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360313,
					"content": "상자부터 잘 잠가둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 761360314,
					"content": "넵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 761360315,
					"content": "이제 가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "네페르"
				},
