			"dialogs": [
				{
					"id": 745250401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 745250402,
					"content": "얼굴이 심각해 보이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "아, 너였구나. 아니, 오늘 조사는 이미 끝났어. 근처에 특이 사항이 발견되지 않았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 745250405,
					"content": "난 그저 방금 지나간 도금 여단이 왜 그렇게 기운이 없어 보였는지 생각하고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 745250406,
					"content": "혹시 여행이 너무 힘들었던 게 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "내가 추측하기로는 아마도 경제적인 이유일 거야. 「도금」 여단에서 「금」이 빠져버리면, 「도」검만 남게 되니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 745250409,
					"content": "…재밌는 구「도」는 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "그래. 근데 그냥 서 있기만 하면 너무 단조롭고, 인상적이지 않으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 745250412,
					"content": "번개 원소력을 써서 「눈부신」 장면을 만들어 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 745250413,
					"content": "…좋은 생각이야. 잘 포착해 볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "응. 「빛나는 순간」을 놓치면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사이노"
				},
				{
					"id": 745250410,
					"content": "사진을 찍어줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "혹시 임무에 실패했나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "범인을 쫓고 있는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
	]
