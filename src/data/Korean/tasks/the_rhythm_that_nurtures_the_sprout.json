			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아란슈드라카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700501,
					"content": "아란마! 또 만났네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700502,
					"content": "#응! 나라{NICKNAME}, 페이몬. 안녕. 이쪽은 아란슈드라카야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700503
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700503,
					"content": "#우와! 나라{NICKNAME}, 페이몬. 만나서 반가워! 시에서 나온 것처럼 금빛의 나라는 키가 크고 튼튼하구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700504
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700504,
					"content": "나도 반가워! 아란슈드라카는 아란마의 친구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700505,
					"content": "응! 아란슈드라카도 「채곡가」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700506
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700506,
					"content": "씨앗이 묘목으로 자라기 전에, 우린 함께 잎사귀 속에 숨은 채 쿠사나리 화신의 큰 나무로 가서, 나라가 자기를 바보로 만드는 물을 마시며 노래하는 걸 구경했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700507
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700507,
					"content": "#나라{NICKNAME}, 페이몬. 갖고 있는 시 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700508
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700508,
					"content": "시라… 그 초록색 녀석이라면 꽤 알고 있을 텐데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700509,
					"content": "초록색 녀석? 황혼새? 버섯 돼지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700510
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700510,
					"content": "아니야! 그 녀석은 몬드의 바람 신이자 음유시인이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700511,
					"content": "우와! 그럼 시를 아주 많이 알고 있겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700512
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700512,
					"content": "대단해! 바람의 신이라면 틀림없이 바람으로 시를 아주 먼 곳까지 보낼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700513
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700513,
					"content": "응! 그나저나 여기도 숨겨진 노래가 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700514,
					"content": "이쪽은 아란마하가 남긴 노래인 것 같아. 그렇다면 근처에 바사라 나무가 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700515
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700515,
					"content": "#그럼 바소마 열매를 구할 수 있겠네… {NICKNAME}, 우리도 돕자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700516,
					"content": "야호! 나라와 함께 과거의 노래를 연구할 수 있다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700517
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700517,
					"content": "아란마하는 장미를 좋아하지만, 장미로 시를 숨기는 방법은 아란야마가 발견했어! 아란야마는 거만해서 그의 장미도 거만해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700518
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700518,
					"content": "그래서 장미는 우리에게 알려주지 않을 거야. 오로지 똑똑한 아란나라 혹은 똑똑한 나라만이 숨겨진 노래를 찾을 수 있어. 하지만 아란슈드라카는 똑똑하지 못해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700519
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700519,
					"content": "#걱정하지 마! 크흠, {NICKNAME}(은)는 아주 똑똑해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700520,
						730700521
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700520,
					"content": "라나 씨를 돕기 위해서라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700522
					]
				},
				{
					"id": 730700522,
					"content": "응! 우리에게 맡겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700521,
					"content": "나 진짜 똑똑해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700522
					]
				}
			]
		},
		{
			"id": 7307006,
			"completionStepIds": [
				7307006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
