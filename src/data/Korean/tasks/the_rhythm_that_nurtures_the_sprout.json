					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730701909
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730701909,
					"content": "오오! 보물이란 게 그런 의미였구나… 알겠어. 고마워, 페이몬!",
					"roleType": "TALK_ROLE_NPC",
