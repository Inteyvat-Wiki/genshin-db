			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아란슈드라카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730700401,
					"content": "아란마! 또 만났네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700402,
					"content": "#응! 나라{NICKNAME}, 페이몬. 안녕. 이쪽은 아란슈드라카야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700403
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700403,
					"content": "#우와! 나라{NICKNAME}, 페이몬. 만나서 반가워! 시에서 나온 것처럼 금빛의 나라는 키가 크고 튼튼하구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700404
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700404,
					"content": "나도 반가워! 아란슈드라카는 아란마의 친구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700405,
					"content": "응! 아란슈드라카는 「채곡가」야. 다양한 시를 수집하곤 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700406
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700406,
					"content": "씨앗이 묘목으로 자라기 전에, 우린 함께 잎사귀 속에 숨은 채 쿠사나리 화신의 큰 나무로 가서, 나라가 자기를 바보로 만드는 물을 마시며 노래하는 걸 구경했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700407
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700407,
					"content": "#나라{NICKNAME}, 페이몬. 갖고 있는 시 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700408
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700408,
					"content": "시라… 그 초록색 녀석이라면 꽤 알고 있을 텐데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700409,
					"content": "초록색 녀석? 황혼새? 버섯 돼지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700410
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700410,
					"content": "아니야! 그 녀석은 몬드의 바람 신이자 음유시인이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700411,
					"content": "우와! 그럼 시를 아주 많이 알고 있겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700412
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700412,
					"content": "대단해! 바람의 신이라면 틀림없이 바람으로 시를 아주 먼 곳까지 보낼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700413
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700413,
					"content": "응! 그나저나 여기가 아슈바타 전당인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700414,
					"content": "아, 아니야. 이것도 대단한 발견이야. 여기에는 아란나라가 몇 년 동안 찾지 못한 노래가 잠들어 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700415
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700415,
					"content": "아란나라의 채곡가는 끊임없이 노래의 아름다움을 추구해. 그래서 시간의 끝자락에 자신만의 노래를 남기지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700416,
						730700418
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700416,
					"content": "그게 아슈바타 전당과 관련이 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700417
					]
				},
				{
					"id": 730700417,
					"content": "이쪽에 아란마하가 남긴 노래가 있는 것 같아. 그렇다면 근처에 바사라 나무가 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700420
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700420,
					"content": "바사라 나무라… 전에 아란자가 말했던 것 같은데, 숲의 책에서 좀 찾아볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700421
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700421,
					"content": "#찾았다! 바소마 열매를 맺는 바사라 나무! {NICKNAME}, 우리도 가서 돕자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700422,
					"content": "야호! 나라와 함께 과거의 노래를 연구할 수 있다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700423
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730700423,
					"content": "아란마하는 장미를 좋아하지만, 장미로 시를 숨기는 방법은 아란야마가 발견했어! 아란야마는 거만해서 그의 장미도 거만해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700424
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700424,
					"content": "그래서 장미는 우리에게 알려주지 않을 거야. 오로지 똑똑한 아란나라 혹은 똑똑한 나라만이 숨겨진 노래를 찾을 수 있어. 하지만 아란슈드라카는 똑똑하지 못해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700425
					],
					"speakerTitle": "아란슈드라카"
				},
				{
					"id": 730700425,
					"content": "#걱정하지 마! 크흠, {NICKNAME}(은)는 아주 똑똑해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700426,
						730700427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700426,
					"content": "라나 씨를 돕기 위해서라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700428
					]
				},
				{
					"id": 730700428,
					"content": "응! 물건 찾는 건 우리 주특기잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730700427,
					"content": "그래",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700428
					]
				},
				{
					"id": 730700418,
					"content": "행운을 빌게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730700419
					]
				},
				{
					"id": 730700419,
					"content": "#응! 나라{NICKNAME} 고마워. 이쪽은 아란마하가 남긴 노래인 것 같아. 그렇다면 근처에 바사라 나무가 있을 거야. 운이 좋았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730700420
					],
					"speakerTitle": "아란마"
				}
			]
		},
		{
			"id": 7307005,
			"completionStepIds": [
				7307004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307004",
							"2"
						],
						"stepId": 7307004,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
