			"dialogs": [
				{
					"id": 751570401,
					"content": "위대하신 산하자 님, 가여운 후손을 불쌍히 여겨 주세요…. 제발 은인님이 <color=#00E1FFFF>굉장한 명룡을 찾을 수 있게</color> 도와주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570402
					],
					"speakerTitle": "코누라프"
				},
				{
					"id": 751570402,
					"content": "당신의 후손을 모욕하는 다른 부족 사람들에게 본때를 보여주세요…. 훌쩍",
