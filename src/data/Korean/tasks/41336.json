					"임령"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "음… 아무래도 현장에 가서 생각하는 게 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360102,
					"content": "뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "사람들한테 부탁을 받아서 소등에 쓸 만한 문구를 생각하고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360104,
					"content": "해등절에는 다들 소등에 소원이나 축복의 말을 적어 날리잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360105,
					"content": "축제 분위기를 살리기 위해서 사람들은 소원이나 축복의 말을… 음, 뭐랄까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360106,
					"content": "「문학적」으로… 쓰고 싶어 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360107,
					"content": "벽파 씨와 효 총관님, 덕귀 씨가 내게 「문학적」인 축복의 말을 소등에 써서 보내달라고 부탁했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360108,
					"content": "하지만 여기서 혼자 생각하면 멋진 문구가 떠오르지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360109,
					"content": "그래서 일단 소등을 준비해서 내게 문구를 부탁한 사람들을 관찰하러 가려고. 그래야 의뢰인들에게 딱 맞는 축복의 문구가 떠오를 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360110,
					"content": "근데 난 소등을 못 만들어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360111,
					"content": "제가 도와드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "그래? 그럼 부탁할게. 소등 3개가 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360114,
					"content": "소등을 다 만들면 어떤 문구가 좋을지 소재를 찾아보러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360115,
					"content": "헤헤, 대충 감은 잡았어. 이제 영감만 떠오르면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				},
				{
					"id": 413360112,
					"content": "전 소등 잘 만들거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
