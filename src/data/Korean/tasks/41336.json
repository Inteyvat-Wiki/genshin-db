			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"벽파"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360901,
					"content": "엇? 임령이잖아. 저번에 내가 부탁한 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360902
					],
					"speakerTitle": "벽파"
				},
				{
					"id": 413360902,
					"content": "걱정 마세요. 이 여행자와 함께 만들어 왔어요. 자, 받으세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360903
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360903,
					"content": "이렇게 빨리? 고마워, 어디 좀 볼까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360904
					],
					"speakerTitle": "벽파"
				},
				{
					"id": 413360904,
					"content": "「신선한 해산물이 오가고, 푸른 바다에 파도가 범람하네」…. 훌륭하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360905
					],
					"speakerTitle": "벽파"
				},
				{
					"id": 413360905,
					"content": "사실 저도 하나 지었는데 같이 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360906
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360906,
					"content": "하나 더 있다고? 한번 볼까, 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360907
					],
					"speakerTitle": "벽파"
				},
				{
					"id": 413360907,
					"content": "낮에는 쥐처럼 수상… 크흠! 이, 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360908
					],
					"speakerTitle": "벽파"
				},
				{
					"id": 413360908,
					"content": "어때요? 아주 사실적이죠? 마음에 드시면 소등을 하나 더 만들어서 적으세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360909
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360909,
					"content": "크…흠! 고마워, 난 일이 좀 있어서 먼저 가볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360910
					],
					"speakerTitle": "벽파"
				},
				{
					"id": 413360910,
					"content": "휴… 소등을 다 전달했네. 수고했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360911
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360911,
					"content": "다들 만족해하는 것 같아. 너도 나처럼 이 분야에 재능이 넘치는걸~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360912
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360912,
					"content": "휴, 이 도시엔 너처럼 나와 시구를 주고받을 만한 사람이 거의 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360913
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360913,
					"content": "나중에 시간 되면 자주 놀러와. 또 같이 시를 연구하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360914
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360914,
					"content": "네, 꼭 그럴게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360915
					]
				},
				{
					"id": 413360915,
					"content": "그래. 이제 내 소등에 적을 시구를 생각해봐야겠네…. 이번엔 안 도와줘도 돼. 내가 직접 지을 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360916
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360916,
					"content": "맞다, 이거 보수니까 받아둬. 축제 기간에 나와 함께 다녀줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				}
			]
		},
