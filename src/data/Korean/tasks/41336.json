				"points": []
			},
			"dialogs": [
				{
					"id": 413360401,
					"content": "효 총관님이 저기 계시네. 일단 여기서 관찰하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360402,
					"content": "효 총관님은 꽤 기억에 남는 분이니까 문구가 금방 떠오를 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360403,
					"content": "한번 읽어줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360404,
					"content": "「못된 영감탱이, 성격도 고약하지」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360405,
					"content": "네?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "「하지만 마음은 따뜻하다네」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360408,
					"content": "엥?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "제목도 있어. 제목은… 「좋은 사람이긴 해」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360411,
					"content": "어때, 아주 사실적이지 않아? 효 총관님은 좀 무서워 보이시지만 좋은 분이시거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360412,
					"content": "다른 문구는 없을까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "아, 하나 더 있어. 근데 이어지는 구절이 떠오르지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360414,
					"content": "어때, 네가 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360415,
					"content": "앞 구절은 「후배가 오면, 눈을 부릅뜨며 위엄이 넘치고」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360416,
					"content": "「배들이 떠나면, 걱정 없이 코고는 소리가 산을 울리네」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "느낌 좋은데…. 제목은 뭐가 좋을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360418,
					"content": "음… 「산 같은 평안」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "왓! 너 재능이 뛰어난걸. 이 문구 제법 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360420,
					"content": "이걸 바로 소등에 써야겠어. 잠시만 기다려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "임령"
				},
				{
					"id": 413360421,
					"content": "됐다, 다 썼어. 이제 소등을 효 총관님께 드리자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				},
				{
					"id": 413360409,
					"content": "일단 멈춰봐요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "자, 잠깐만요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
