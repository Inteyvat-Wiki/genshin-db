			"dialogs": [
				{
					"id": 705400101,
					"content": "캬악!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "「왕귤 기사」"
				},
				{
					"id": 705400102,
					"content": "윽… 로자리아 씨, 이 녀석은 왜 이렇게 사나운 거죠. 너무 무서워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705400103,
					"content": "뒤로 물러나. 까딱 잘못하면 고양이한테 얼굴 다 긁히겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 705400104,
					"content": "무슨 일이야? 고양이가 바레리나를 괴롭혔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705400105,
					"content": "길냥이가 침입한 건가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "명예 기사와 하얀 고양이 마법사 씨! 「샤베트」랑 산책을 나갔는데 저 덩치 큰 녀석이 샤베트가 맘에 들었는지 따라 들어온 거 있죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705400108,
					"content": "그렇게 긴장하지 않아도 돼. 여기에 널 해치려는 사람은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 705400109,
					"content": "나쁜 녀석들이나 너한테 못된 짓을 시키는 놈들은 이 성에 발도 못 붙일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 705400110,
					"content": "네 주위에서 널 조금 귀찮게 할 수는 있지만, 다들 좋은 사람들이고 다 널 위한 행동이야. 그러니 긴장 풀고 여유로운 삶에 적응해 보도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 705400111,
					"content": "캬——악——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "「왕귤 기사」"
				},
				{
					"id": 705400112,
					"content": "저, 저 덩치 큰 녀석이 알아들은 걸까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "바레리나"
				},
				{
					"id": 705400113,
					"content": "알아들은 것 같은데. 꽤 똑똑한 고양이인가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 705400114,
					"content": "다른 고양이들에 비해 덩치도 크고 색깔도 풍선귤 주스 같네. 게다가 자세히 보니까, 기사단 문장이 있는 머플러를 하고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705400115,
					"content": "좋아, 그렇다면 「왕귤 기사」라고 불러야겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705400116,
					"content": "야옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "「왕귤 기사」"
				},
				{
					"id": 705400117,
					"content": "네 방법은 정말 효과가 좋네. 경계심을 완전히 내려놓은 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 705400118,
					"content": "내가 볼 땐 「왕귤 기사」가 로자리아랑 몇 마디 나눈 후로 덜 사나워진 것 같아. 이번엔 로자리아 덕분이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705400119,
					"content": "로자리아 씨, 고양이랑 사이가 좋아졌네요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "그런가? 귀여운 녀석들은 귀찮게 굴어도 미워할 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 705400122,
					"content": "「왕귤 기사」가 왜 화가 났었는진 모르겠지만, 고양이 마법을 더 부려서 긴장을 풀어주고 즐겁게 만들어 주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705400120,
					"content": "로자리아 씨의 특별 임무가 더 즐거워졌네요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "고독한 고양이 기사 같기도 하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}