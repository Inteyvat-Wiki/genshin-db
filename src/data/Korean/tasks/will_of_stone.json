					"약심"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "얘는 대체 어딜 간 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150502,
					"content": "육이에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "육이를 찾으러 왔니? 휴, 타이밍이 안 좋구나. 그 애가 어디 갔는지 못 찾겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150504,
					"content": "얼마 전, 그 애 아버지가 리월항에서 편지를 보내 금방 돌아올 거라 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150505,
					"content": "육이는 신나서 아빠의 선물을 준비한다며 아이들 몇 명을 데리고 여기저기 과일을 따러 다녔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150506,
					"content": "그런데 며칠 전에 그 애 아버지가 갑자기 근무해야 돼서 못 돌아온다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150507,
					"content": "그래서 화가 났는지 아무리 타일러도 풀리지 않더구나. 아빠가 안 돌아오면 자기가 리월항에 갈 거라면서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150508,
					"content": "다들 농담인 줄 알았는데. 오늘 아침에 일어나보니 글쎄 육이가 사라졌지 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150509,
					"content": "에휴, 그래서 다들 그 아이를 찾으러 나갔어. 괜찮다면 너희도 같이 좀 찾아주렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150510,
					"content": "내게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "그럼 부탁하마. 에휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "약심"
				},
				{
					"id": 708150512,
					"content": "어디로 갔을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "멀리 가진 않았을 거야. 이 근처에 있을 텐데… 하지만 혼자 밖에 있으면 위험하니 어서 그 아이 좀 찾아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "약심"
				}
			]
		},
