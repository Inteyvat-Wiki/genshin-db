			"dialogs": [
				{
					"id": 708150701,
					"content": "절 경책 산장으로 돌려보내려구요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "육이"
				},
				{
					"id": 708150702,
					"content": "약심 할머니가 걱정하고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "흥, 역시 날 잡으러 온 거잖아요. 안 갈 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "육이"
				},
				{
					"id": 708150706,
					"content": "리월항에 아빠 찾으러 갈 거라고 마을 사람들에게 전해줘요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "육이"
				},
				{
					"id": 708150707,
					"content": "아빠랑 몇 마디만 하고 돌아갈 테니 안심하라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "육이"
				},
				{
					"id": 708150704,
					"content": "너한테 줄 게 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "필요 없어요. 어차피 어린애들이나 달래는 거겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "육이"
				}
			]
		},
