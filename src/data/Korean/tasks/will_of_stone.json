			"dialogs": [
				{
					"id": 708150601,
					"content": "가의 그 사람도 참. 그렇게 갑자기 안 온다 하면 어떡해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150602,
					"content": "1년에 몇 번 볼까 말까 한데, 그런 아버지가 어딨어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150603,
					"content": "리월항을 위해서 그러는 거잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "가의도 매번 그렇게 말하지. 벌써 그 말을 몇 번이나 들었나 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "약심"
				},
				{
					"id": 708150605,
					"content": "일 때문에 그러는 거잖아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "그래도 자기 딸은 돌봐야지. 육이가 벌써 이렇게 컸는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150607,
					"content": "나중에 일을 그만두고 돌아왔는데 그때 육이가 일하러 떠나면?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "약심"
				},
				{
					"id": 708150608,
					"content": "그럼 둘은 영영 같이 살 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "약심"
				}
			]
