			"dialogs": [
				{
					"id": 726840601,
					"content": "하하하하하하! 친구! 드디어 왔구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840602,
					"content": "네가 언제쯤 올지 생각하고 있었는데, 딱 맞게 와줘서 기쁘군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840603,
					"content": "이 몸이 준비한 장소 어때? 아주 훌륭하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840604,
					"content": "바다에 둘러싸여서 공기도 맑고 도시의 소음과도 멀리 떨어져 있지. 그야말로 완벽한 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 726840605,
					"content": "뒤쪽이 바로 아마카네섬과 맞닿아 있어서 축제 문화 중심지 최고의 시설을 독점할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "아키라"
				},
				{
					"id": 726840606,
					"content": "게다가 수로와 육지의 교통이 발달해서 걸어서도 올 수 있고 배 타고도 올 수 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "겐타"
				},
				{
					"id": 726840607,
					"content": "확실히 괜찮은 곳이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "이 장소를 처음 본 순간부터 이 몸은 결정했어! 바로 이곳이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840610,
					"content": "그 순간, 세상이 달라졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840611,
					"content": "형님, 대단하십니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "겐타"
				},
				{
					"id": 726840612,
					"content": "그냥 텐료 봉행한테 쫓겨난 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840613,
					"content": "크흠… 중요한 얘기부터 하자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840614,
					"content": "너희를 부른 건, 아라타키 천하제일 초호화 북 축제에 초대하기 위해서다! 대단히 뜻깊은 축제지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840615,
					"content": "형님이 이 축제의 첫 번째 취지는 신입 모집을 위해서 우리 아라타키파의 명성을 널리 알리는 거라고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "겐타"
				},
				{
					"id": 726840616,
					"content": "두 번째로는 시노부 누님의 졸업을 축하하기 위해서고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 726840617,
					"content": "마지막으로 경비 부족으로 연기됐던 야유회도 겸사겸사 충당할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "아키라"
				},
				{
					"id": 726840618,
					"content": "정말 취지가 다양한 축제네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840619,
					"content": "아키라… 마지막 말은 굳이 안 해도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840620,
					"content": "시노부가 안 보이네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "축제는 홍보를 많이 해야 사람들이 오는 법이잖아. 시노부는 전단지 돌리러 갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840622,
					"content": "잠깐! 축제의 주인공은 시노부잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840623,
					"content": "시노부는 일하고 있는데 너흰 여기서 빈둥거리고 있다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840624,
					"content": "이 몸도 여기서… 성심성의껏 너희를 맞아주고 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840625,
					"content": "사실 형님도 좀 전에 돌아오셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "겐타"
				},
				{
					"id": 726840626,
					"content": "너희 올 때 다 됐다면서 일부러 마중 오신 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 726840627,
					"content": "형님도 시노부 누님이랑 같이 나가서 열심히 사람을 모으고 계셨거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "아키라"
				},
				{
					"id": 726840628,
					"content": "됐어 됐어, 칭찬은 넣어둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840629,
					"content": "오~ 소몰이 청년 이토가 진지할 때도 다 있네. 정말 모처럼 믿음직스러워 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840630,
					"content": "흥, 날아다니는 땅딸보 녀석이랑은 상종하고 싶지 않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840631,
					"content": "그래서 친구. 이번 축제에 대해서 뭐 더 궁금한 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840608,
					"content": "다들 낙관적이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				}
			]
		},
