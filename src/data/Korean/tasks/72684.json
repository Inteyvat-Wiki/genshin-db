				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840632,
					"content": "축제에 어떤 활동들이 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840633
					]
				},
				{
					"id": 726840633,
					"content": "하하하하! 그야 엄청 다양하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840634
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840634,
					"content": "저기 있는 언덕 보이지? 가왕의 언덕이야. 저기 서서 바다를 향해 마음껏 노래를 부를 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840635
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840635,
					"content": "그리고 이 모닥불은, 제비꽃 열매 굽기에 딱이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840636,
					"content": "그리고 이 상자들은 《일곱 성인의 소환》이나 곤충 싸움을 하기에 전혀 비좁지 않고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840637
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840637,
					"content": "응, 정말 「다양」하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840638
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840638,
					"content": "물론, 축제의 하이라이트는 바로 북 치기 공연이지. 자, 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840639
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840639,
					"content": "너희들한테만 알려주는 건데, 이건 내가 은밀한 루트를 통해 구한 엄청난 물건이야. 한 훌륭한 음양사가 남긴 북인데, 800만 모라를 호가하는 보물이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840640
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840640,
					"content": "근데 북 파는 상인이 말이지, 내가 잘생기기도 했고, 자기랑 만난 것도 인연이라면서 좀 싸게 주겠다지 뭐야, 그것도 80만 모라에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840641
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840641,
					"content": "800만 모라인 걸 80만에 파는 건 딱 봐도 사기 치는 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840642
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840642,
					"content": "물론이지! 이 몸이 그런 저열한 수법에 넘어갈 리가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840643
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840643,
					"content": "난 한눈에 이 북의 끝부분이 좀 파손된 걸 발견했어. 하자가 있는 거지! 인연이 어쩌고 하는 것도 가소롭더군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840644
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840644,
					"content": "그래서 이 몸은 또 흥정해서 단돈 8만 모라에 이 북을 샀어. 하하하하하! 완전 땡잡았지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840645
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840645,
					"content": "땡잡은 건 그 상인 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840646
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840646,
					"content": "그나저나 소몰이 청년 이토한테 8만 모라가 있다니, 새삼 다시 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840647,
					"content": "이 몸이 그깟 8만 모라가 없겠어? 얕보지 말라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840648,
					"content": "그중 2만 모라는 내가 냈어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840649
					],
					"speakerTitle": "겐타"
				},
				{
					"id": 726840649,
					"content": "나도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840650
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 726840650,
					"content": "엥? 형님, 왜 저만 3만 모라나 낸 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840651
					],
					"speakerTitle": "아키라"
				},
				{
					"id": 726840651,
					"content": "2만 더하기 2만에, 또 3만을 더하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840652
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840652,
					"content": "이 파렴치한 녀석! 자기는 한 푼도 안 내고 부하들한테서만 8만 모라를 뜯어오다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840653
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726840653,
					"content": "크흠, 계산이 잘못된 것 같은데. 이이이 몸도 1만 모라 냈거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840665
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840665,
					"content": "자, 다른 건 나중에 얘기하고, 나도 이제 시노부한테 가봐야 할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840666
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840666,
					"content": "축제는 이제 시작이야. 떠들썩한 축제가 되도록 사람들을 더 모아 와야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840667
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840667,
					"content": "이 북을 잘 보관해 둬. 공연을 시작할 준비가 되면 겐타를 찾아가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840668
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 726840668,
					"content": "그럼 나중에 봐, 친구!",
