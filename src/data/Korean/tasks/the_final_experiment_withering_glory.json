				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "왔구나. 마침 결과가 나왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450502,
					"content": "근데 시간이 꽤 걸렸네? 오면서 무슨 일이라도 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450503,
					"content": "아니",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "우선 결론부터 말할게. 오늘 모은 데이터가 워낙 많아서 연구가 한 번에 끝나진 않을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450507,
					"content": "하지만 대략적인 결과는 알려줄 수 있어. 그건 바로——네가 이 세계의 인류와 아주 비슷하다는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450508,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "그건 딱 봐도 알 수 있는 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450511,
					"content": "우리가 생고생한 결과가 겨우 이거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450512,
					"content": "조급하게 굴지 마. 당연해 보일지 모르지만, 이 세계에 당연한 건 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450513,
					"content": "티바트라는 세계는 외부인에게 본질적으로 거부 반응을 보일 수도 있다는 생각, 해봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450514,
					"content": "정답은 신만이 알지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "내가 이 세계의 법칙에 대해 말한 적이 있지? 우리가 별 탈 없이 대화하는 건 어쩌면 기적일지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450517,
					"content": "왜냐면, 너처럼 멀리서 온 생명, 내가 전에 말했던 그 씨앗은 티바트의 법칙 때문에 정상적으로 자라서 꽃을 피우지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450518,
					"content": "하지만 널 관찰하고 나서 다른 아이디어가 생겼지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450519,
					"content": "네 생명을 모방해서 연금술에 내 새로운 영감을 불어 넣으면, 그다음에——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450520,
					"content": "우와, 뭔가 엄청난 게 나올 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450521,
					"content": "무에서 유가 되고, 새싹이 자라나 결실을 맺는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450522,
					"content": "이 세계에 속하지 않은 생명을 키워내는 건, 새로운 세계를 키워내는 거나 다름없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450523,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450524,
					"content": "멋지네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "휴, 그게 한계인 것 같아. 최고로 아름다운 꽃을 피워내는 건 한순간일 뿐이지. 생명의 극치도 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450527,
					"content": "우리가 계속 노력하면 영원히 활짝 피어있을 거라고 생각해. 아직 열매도 안 맺었잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450528,
					"content": "생명은 다양성을 지닌 자유로운 존재지. 수명의 길이로 우열을 논할 수 없어. 가령 그게 찰나일지라도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450529,
					"content": "빨리 죽는 게 나쁜 것만은 아니야. 효율적이고 완벽하다는 거지. 외로움에 고통받지 않는다는 뜻이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450530,
					"content": "이제 내가 아까 「우리가 별 탈 없이 대화하는 건 어쩌면 기적일지도 몰라」라고 했던 이유를 알겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450531,
					"content": "적어도 아직 난 살아있으니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "엥? 갑자기 분위기가 왜 이래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450534,
					"content": "#헤헤, 기운 내라고~ {NICKNAME}, 내가 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450535,
					"content": "알베도 너도, 난 너랑 친해지고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450536,
					"content": "…고마워. 굳이 외로움을 달랠 필요는 없다고 생각하지만… 나쁘진 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}, 네 도움으로 영감을 얻었어. 그 씨앗을 꽃 피울 방법도 찾을 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450538,
					"content": "「실험 대상」으로서의 도움?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "아니, 너희와 설산에서 함께한 시간도 아주 가치 있고 즐거웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450540,
					"content": "앞으로도… 도움이 필요하면 불러도 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450541,
					"content": "언제든지 불러줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "그럼… 잘 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450544,
					"content": "여행자에게 실험 결과가 「평범」하다고는 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450545,
					"content": "병에 가라앉아있던 침전물은 어떻게 된 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450546,
					"content": "흑토(黑土)를 마시면 오염되고 백악(白堊)을 마시면 순결해지지. 너도 나처럼 미래가 정해지지 않은 「질료(質料)」인 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450547,
					"content": "언젠가 통제불능의 내가 몬드의… 모든 걸 파괴하려 한다면——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450548,
					"content": "네가 날 말려줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450532,
					"content": "#({M#동생은}{F#오빠는} 잘 지내고 있을까…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
