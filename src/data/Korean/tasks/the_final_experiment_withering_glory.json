				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450462,
					"content": "처음 보는 도안이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "내가 알기로 이건 룬 문자야. 티바트 대륙 곳곳에 있지만, 수수께끼로 가득하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450402,
					"content": "미스터리가 한둘이 아니야. 게다가 이 룬 문자가 왜 여기에 남아있는 건지도 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450403,
					"content": "어쨌든, 일단 적어둬야겠어. 널 다 연구하면 천천히 살펴봐야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450404,
					"content": "휴, 또 알 수 없는 게 나왔군. 이 이상한 문제들과 실험으로 뭘 얻을 수 있다는 건지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450405,
					"content": "하지만 보수를 얻으려면 그에 맞는 대가를 치러야 하는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450406,
					"content": "이번 실험은 도움이 많이 됐어. 그에 비해 보수가 보잘것없어서 민망하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450407,
					"content": "난 먼저 야영지로 돌아갈게. 너희들이 돌아오면 놀라운 결과를 보여줄 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450408,
					"content": "그럼 나중에 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "이렇게 고생했는데 어떤 결과가 나올지 기대되는 걸…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450411,
					"content": "별다른 일 없으면 우리도 야영지로 돌아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450413,
					"content": "내가 위험 요소를 모두 제거하기 전까지 서두르지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450414,
					"content": "엇? 로자리아! 설산을 떠난 게 아니었구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450415,
					"content": "물론이지. 너희가 알베도와 뭘 하는지 전부 지켜봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450416,
					"content": "넌 순진한 거야, 아니면 그의 독특한 사고방식과 다정함에 속아 넘어간 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450417,
					"content": "무슨 일이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "낯선 사람이 시키는 대로 움직이지 않나, 출처 불명의 포션을 들이키지 않나, 정체불명의 실험에 수차례 응했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450420,
					"content": "순진하다기보다는 네가 속았거나… 처음부터 짜고 연기한 거라는 생각이 들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450421,
					"content": "역시 경계심이 강한 수녀라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450422,
					"content": "전 연구를 도왔을 뿐이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "상관없어. 알베도라면 외지에서 온 너보다야 내가 훨씬 더 잘 아니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450425,
					"content": "난 네가 연금술로 이상한 괴물이 된 건 아닌지만 알고 싶을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450426,
					"content": "말도 안 돼! 그런 낌새는 전혀 없었어! 게다가 알베도는 실험 내내 연금술을 안 썼다구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450427,
					"content": "그 정도 실력의 연금술사라면 티 안 내고도 얼마든지 연금술을 쓸 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450428,
					"content": "어쨌든, 난 위협이 될 만한 인물이 몬드로 돌아가게 놔둘 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450429,
					"content": "그, 그럼 어쩔 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450430,
					"content": "확인하러 왔다면 방법은 있겠죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "이런 쪽으로는 머리가 잘 돌아가네. 뭔갈 만져보는 수밖에 없어. 너희가 만진 것들이 아무 이상 없다면 너희도 무사한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450432,
					"content": "다른 것들은 다 확인했거든. 이제 남은 건 이 룬 문자뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450433,
					"content": "이거 우린 알아보지도 못한다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450451,
					"content": "알아. 게다가… 음, 그냥 문자일 뿐, 장치는 아닌 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450452,
					"content": "하지만 안전이 최우선이니, 기록해야겠어… 음, 아무래도 여기를 중점으로 정기순찰을 나와야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450434,
					"content": "됐어, 너희들 별 이상은 없는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450435,
					"content": "나도 너희가 이상 없길 바랄게. 너희 때문에 특근하면 내가 너무 억울하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450436,
					"content": "특, 특근?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450437,
					"content": "헤어지기 전에 충고 한 마디 하지. 알베도를 너무 믿지 마. 적어도 이번처럼 무턱대고 따르는 건 피하라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110450439,
					"content": "갔어, 진짜 제멋대로인 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450440,
					"content": "몬드에 저런 사람은 정말 드문데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450441,
					"content": "조심성이 많은 것뿐이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "그래, 신경 끄고 알베도 만나러 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110450442,
					"content": "좀 예민한 것뿐이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "알베도는 나쁜 사람이 아닐 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "알베도가 다른 꿍꿍이라도 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "내 지능에 문제 없나 보네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "어디선가 본 적이 있는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
