			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "모험을 하면서 너도 여러 수수께끼를 마주해 봤을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450102,
					"content": "체력 테스트와 마찬가지로 네 지능 수준을 실험해보려고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450103,
					"content": "문제없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "이 유적을 탐험해보고 네가 얻은 답을 알려줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450106,
					"content": "유적의 양쪽 가장자리에 수수께끼가 있어. 그걸 풀면 중앙에 있는 장치를 가동시킬 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450107,
					"content": "체력 테스트와 마찬가지로 따로 제한은 없어. 네 행동을 전부 관찰할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450108,
					"content": "이런 건 익숙하지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "역시 경험이 풍부한 모험가답네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450112,
					"content": "그럼, 건투를 빌어. 어느 쪽부터 할 건지는 네 마음대로 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450110,
					"content": "어떻게든 되겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "이건 지능 테스트란 걸 잊지 마. 운으로 하는 게 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110450104,
					"content": "지능이라니, 기분이 이상한 걸?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
