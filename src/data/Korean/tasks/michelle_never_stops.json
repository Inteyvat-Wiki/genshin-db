					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "오늘 퀸 씨 가게엔 할 일이 별로 없으니까 돌아가서 푹 쉬도록 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200430604,
					"content": "그래? 후… 아무래도 다른 일을 찾아봐야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430605,
					"content": "어, 어?! 안 쉰다고? 얼마 만의 휴식인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200430606,
					"content": "주변을 느껴봐. 바르바토스 님의 바람도 열심히 일하고 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430607,
					"content": "우리 같이 그분의 가호를 받는 사람들은 게으름 피울 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430608,
					"content": "근데 대체 무슨 일을 하고 왔길래 땀을 이렇게나 흘리는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430609,
					"content": "보니까 너도 되게 바쁜 사람이구나. 하지만 열심히 일해 땀을 흘리고 맞는 바르바토스 님의 바람도 꽤 상쾌하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430610,
					"content": "자, 이 우유 받아, 어서 마시고 힘내, 일이란 게 원래 끝이 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미셸"
				}
			]
