			"dialogs": [
				{
					"id": 200430301,
					"content": "왜 아직도 안 오지, 큰일이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200430302,
					"content": "무슨 일이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "아… 일몰 열매가 다 팔려서 방금 일몰 열매를 더 주문했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200430304,
					"content": "그런데 아직도 안 오네…. 손님들이 기다리는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200430305,
					"content": "유리 아가씨만 해도 3번이나 다녀갔어. <color=#00E1FFFF>일몰 열매 3개</color>를 사고 싶다고 말이야. 단골 손님 놓치기 싫은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200430306,
					"content": "난 노점을 봐야 하니…. 성 밖에 가서 일몰 열매 좀 찾아가지고 와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200430307,
					"content": "급하다면 내가 도와줄게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "도와줄 거야? 정말 고마워. 그럼 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "퀸"
				},
				{
					"id": 200430309,
					"content": "미셸 아가씨가 곧 올 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "잠깐! 미셸 아가씨가 저 상태로 어떻게 열매를 따러 나가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200430311,
					"content": "우리가 도와주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
