			"dialogs": [
				{
					"id": 200430101,
					"content": "허리가 왜 이렇게 쑤시지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "일하러 가려고 하는데 갑자기 허리가 쑤셔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430104,
					"content": "퀸의 과일 노점에 가서 도와주겠다고 약속했는데, 쉬어야 할 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430105,
					"content": "어휴, 그래도 여기에 계속 이러고 있으면 일만 지체될 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430106,
					"content": "네가 퀸에게 가서 내가 뭘 해야 하는지 물어봐줄래? 나도 준비 좀 하려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "그럼 부탁할게. 난 좀 쉬면 괜찮아질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미셸"
				},
				{
					"id": 200430109,
					"content": "별로 안 멀어 보이는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "야, 이런 일 정도는 도와줄 수 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
