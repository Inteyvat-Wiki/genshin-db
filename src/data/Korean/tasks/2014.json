			"dialogs": [
				{
					"id": 20140201,
					"content": "여긴 것 같은데, 수상한 녀석은 안 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20140202,
					"content": "#설마 숨은 건가? {NICKNAME}, 이 일대를 수색해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20140203,
					"content": "여기 있는 <color=#00E1FFFF>번개 원소 비석</color>들, 뭔가 수상해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
