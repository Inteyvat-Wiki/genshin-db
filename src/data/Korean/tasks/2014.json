			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"산고노미야 코코미"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "코코미, 우리 왔… 어라, 고로도 있네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20140602,
					"content": "무슨 일이지? 다들 표정이 심상치 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20140603,
					"content": "이상 현상이 있는 사람이 얼마나 되지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20140604,
					"content": "아직 집계가 다 안 끝났습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "고로"
				},
				{
					"id": 20140605,
					"content": "코코미, 고로, 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}, 최근 일부 저항군한테서 기이한 노화 증상이 나타났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "고로"
				},
				{
					"id": 20140607,
					"content": "캐물어 보니 몰래 후원자에게서 「비밀 무기」들을 받아왔더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "고로"
				},
				{
					"id": 20140608,
					"content": "다들 지고는 못 배기는 성격이라 안수령에 강한 불만을 품고 비밀 무기를 몰래 사용해 온 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "고로"
				},
