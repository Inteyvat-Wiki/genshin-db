				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "영웅님, 그만 때리세요! 잘못했습니다, 잘못했습니다요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300402,
					"content": "물건 챙기고 당장 사라져!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "예, 예…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300405,
					"content": "하지만… 우리 형제가 영웅님께 어떤 무례를 범한 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300406,
					"content": "영웅님, 설마 근처에서 보물이라도 찾고 계셨던 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300407,
					"content": "근처에서 사당을 수리하고 있었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "사, 사당 수리? 이 황량한 곳에서 왜 영웅님이 사당 수리를?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300409,
					"content": "이… 이 주변에 선인님의 사당이? 잠깐, 설마 그 폐허가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300410,
					"content": "형님, 저번에 우리 저쪽에서 쉴 때 새 조각상을 하나 봤잖아. 그게 혹시…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "보물 사냥단 부하"
				},
				{
					"id": 718300411,
					"content": "그분은 야차 「동작」이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "에엣?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300413,
					"content": "형, 형님! 우리 설마 선인님께 무례를 범한 겁니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "보물 사냥단 부하"
				},
				{
					"id": 718300414,
					"content": "허, 허튼소리! 전에는 몰랐으니까 그건… 그건 무심코 저지른 잘못이야! 선인님도 아마… 아마 죄를 묻지 않으실 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300415,
					"content": "영웅님! 선인님의 사당을 수리하시는지 지금에야 알게 됐습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300416,
					"content": "전에는 몰라뵙고 불경스러운 짓을 저질렀습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300417,
					"content": "지금 바로 돌아가서 형제들한테 사당에 가까이 가지 말라고 이르겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300418,
					"content": "형님, 시간 날 때 저기서 향 좀 피우고 선인님한테 죄를 비는 게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "보물 사냥단 부하"
				},
				{
					"id": 718300419,
					"content": "쓸데없는 소리 말고 얼른 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보물 사냥단 두목"
				},
				{
					"id": 718300403,
					"content": "이젠 이 주변에서 얼쩡거리지 마",
					"roleType": "TALK_ROLE_PLAYER",
