				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "대형 공사가 될 것 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300202,
					"content": "진짜 수리하고 있네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "여행자시군요. 그럼요, 이젠 착하고 바른 사람이라고 했잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300204,
					"content": "그런데 작업량이 이렇게 많을 줄은 몰랐어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300205,
					"content": "설계 사무소의 장인도 이 사당이 「야차」에게 공양하는 사당이라는 얘기를 듣고 의욕에 불타올랐어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300206,
					"content": "두꺼운 설계도는 물론, 저와 함께 이곳저곳 재료를 구매하러 다녔죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300207,
					"content": "조금만 더 젊었다면 직접 수리하러 올 기세였어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300208,
					"content": "위험한 일은 없었죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "위험? 아, 마물과 보물 사냥단을 말하는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300212,
					"content": "그건 걱정 마세요. 제가 야차님의 사당을 수리한다는 소식을 듣고 총무부에서 천암군 몇 명을 보내줬거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300213,
					"content": "근처의 마물들은 천암군들이 거의 다 쫓아냈습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300214,
					"content": "보물 사냥단은… 천암군이 근처에 있는 걸 보면 아마 얼씬거리지 못할 거고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300215,
					"content": "하지만 사당을 수리 작업량이 제 예상을 훨씬 벗어날 정도로 어마어마해요. 준비한 재료도 모자라서 성에서 운반해 오는 수밖에 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300216,
					"content": "전… 보물 사냥단 녀석들이 현장에 손을 대진 못해도 길에 매복했다가 운송 재료들을 약탈할 가능성은 있다고 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300217,
					"content": "천암군이 현장을 지키고 있긴 하지만, 재료를 운반하는 일꾼이 길에서 보물 사냥단한테 습격이라도 당한다면 천암군들도 바로 구하러 가긴 어려울 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300218,
					"content": "영웅님, 부탁 하나만 드려도 될까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300219,
					"content": "당신의 실력이라면 보물 사냥단쯤은 식은 죽 먹기겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300220,
					"content": "주변의 보물 사냥단이 더 이상 난동 피울 수 없도록 혼내주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300221,
					"content": "물론이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "그럼 부탁드리겠습니다, 정말 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300223,
					"content": "천암군은요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "다들 밤낮을 가리지 않고 현장을 지키느라 많이 피곤할 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300225,
					"content": "그럼 부탁드리겠습니다, 영웅님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "왕평안"
				},
				{
					"id": 718300210,
					"content": "이 주변은 안전하지 않았던 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "주변에 마물과 보물 사냥단이 있다는 말씀이죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "왕평안"
				}
			]
		},
