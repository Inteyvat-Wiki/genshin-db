			"trigger": {
				"objectNames": [
					"하나야마 카오루"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "큰일이네… 어떻게 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260102,
					"content": "무슨 일 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "왔구나… 사실은, 씨앗을 받고서 바로 심기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260104,
					"content": "하지만 얼마 지나지 않아 마물들이 나타나 꽃 심는 곳에서 떠나질 않아. 겁이 나서 다가가지도 못하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260105,
					"content": "계속 이렇게 두면 심어둔 꽃이 큰일 날 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260106,
					"content": "괜찮다면 마물들을 쫓아내 줄 수 있어? 난 그냥 꽃을 심고 싶을 뿐인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260107,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "정말? 고마워! 그럼 부탁해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260109,
					"content": "왜 이렇게 꽃에 집착을 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "사람들이 타타라스나에 돌아오기 싫어하는 이유는 「미카게 용광로」 사건이 터지고 더 이상 생활하기 힘들어서일 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260111,
					"content": "한명 한명 설득하기 힘들지만 이곳에 예쁜 꽃을 많이 심어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260112,
					"content": "사람들을 설득해서 타타라스나가 안전하다는 믿음을 줄 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260113,
					"content": "그리고… 헤헤, 난 꽃 심는 것 말고는 사람들을 설득할 방법을 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "하나야마 카오루"
				},
				{
					"id": 721260114,
					"content": "그러니 제발 마물들을 쫓아내 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하나야마 카오루"
				}
			]
		},
