							-2071.53,
							194.015,
							7587.84
						],
						"pointId": 8759
					}
				]
			},
			"dialogs": [
				{
					"id": 750210501,
					"content": "이게 다겠지? 이번 의뢰는 생각했던 거보다 훨씬 수월하네! 근데 정말 그렇게 신기한 건가? 좀 전까진 반신반의했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750210502,
					"content": "페이몬도 숨겨진 힘을 각성하고 싶어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#당연하지. 보물상자를 엄청 잘 찾을 수 있는 슈퍼 수색 능력이나, 한 방에 마물을 때려눕힐 수 있는 강력한 힘이라면 엄청 편리하잖아! {NICKNAME}은(는) 각성하기 싫어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750210504,
					"content": "나도 더 많은 힘이 필요해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "오오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750210508,
					"content": "#{M#형}{F#누나}, 빨리 흩어진 조각을 별 위에 돌려놓자. 와… 난 어떤 힘을 각성하게 될까? 하늘로 갈 수 있을지도 몰라… 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오르코"
				},
				{
					"id": 750210506,
					"content": "난 이미 충분히 강하니까 필요 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "엥? 다들 힘을 추구하는 길에는 끝이 없다고 하잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
