				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#어, {NICKNAME}? 여기서 널 만날 줄은 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200402,
					"content": "오랜만이네요, 유라 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "정기 순찰이야. 나에겐 전투 상태를 유지하기 위해 꼭 필요한 활동이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200405,
					"content": "최근 몬드는 꽤 평화로워서 유격대 전원이 출동해야 할 만한 위협은 거의 없거든. 대원들도… 많이 느슨해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200406,
					"content": "일과 휴식의 균형을 맞추는 것도 좋은 거죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "그렇긴 하지만, 대장인 나만큼은 전투력을 항상 유지해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200408,
					"content": "적의 검은 평화로운 시기라고 무뎌지지 않으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200409,
					"content": "그래서 순찰 중에도 틈틈이 조용한 곳을 찾아 검술을 연마하며, 정신을 가다듬고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200410,
					"content": "딱 좋은 타이밍이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "응? 재미있는 부탁이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200413,
					"content": "근데 사진기가 내 날렵한 움직임을 따라잡을 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200414,
					"content": "평소 속도대로 하시면 돼요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "좋아. 네가 그렇게 자신 있다면, 나도 전력을 다할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "유라"
				},
				{
					"id": 745200417,
					"content": "잘 봐. 파도가 치는 순간은 눈 깜짝할 사이에 사라지니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "유라"
				},
				{
					"id": 745200415,
					"content": "최선을 다해 따라가 볼게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "사진 한 장 찍어드려도 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "여기서 근무 중이신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
}