			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"유라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705030238,
					"content": "페이몬이 말한 대로 커피에 물을 탄다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705030201,
					"content": "나쁘지… 않네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030202
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030202,
					"content": "와, 물을 그렇게 많이 탔는데 전혀 눈치 못 챘어. 역시 많이 마셨나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030203,
					"content": "바텐더, 한 잔 더… 자, 잠깐, 너희가 왜 여기 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030204,
						705030205
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030204,
					"content": "바텐더 체험 중이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030206
					]
				},
				{
					"id": 705030205,
					"content": "이제 알았어요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030206
					]
				},
				{
					"id": 705030206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030207
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030207,
					"content": "미안, 캣테일 술집에 있다 온 거라, 좀 많이 마셨나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030208,
						705030209
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030208,
					"content": "무슨 고민이라도 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030210
					]
				},
				{
					"id": 705030209,
					"content": "우리한테 얘기해 보세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030210
					]
				},
				{
					"id": 705030210,
					"content": "맞아, 혼자 마시면 외롭잖아. 우리랑 수다 떨면서 마시는 게 훨씬 즐거울 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030212
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030212,
					"content": "그래, 나 혼자 마시고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030213
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030213,
					"content": "몬드에 있으면 어느 술집을 가든 환대를 못 받거든. 오늘 모처럼 기분이 좋아서 한잔하고 싶었는데, 또 손가락질 받았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030214
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030214,
					"content": "#{NICKNAME}, 넌 어떻게 친구를 그렇게 많이 사귄 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030215
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030215,
					"content": "사람들이 네 얘기를 할 때면 말투에서 널 동경하는 게 느껴져. 얼굴엔 미소를 띠고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030216
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030216,
					"content": "난, 내 성만 입 밖으로 꺼내도 다들…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030217
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030217,
					"content": "그렇게 생각하지 마요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030218
					]
				},
				{
					"id": 705030218,
					"content": "로렌스 가문에서 태어난 건 유라가 선택한 게 아니잖아. 우린 그런 거 신경 안 써. 우리가 아는 유라는 좋은 사람이니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030219,
					"content": "근데 유라는 솔직하지 못한 것 같아. 앙심 품는 척하면서 상냥한 면을 감추려고 하잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030220,
					"content": "이봐, 누가 그런 척한다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030221,
						705030222
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030221,
					"content": "우리 말고도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030223
					]
				},
				{
					"id": 705030222,
					"content": "유라 씨를 인정하는 사람이 많을 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030223
					]
				},
				{
					"id": 705030223,
					"content": "정말? 아무리 취해도 그런 생각은 못 하겠던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030224
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030224,
					"content": "그동안 페보니우스 기사단에도 들어갔지만, 사람들은 아직도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030225
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030225,
					"content": "「바람의 방향은 항상 바뀌는 거니까요」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030226
					]
				},
				{
					"id": 705030226,
					"content": "맞아! 각설이도 그런 멋진 말을 한 적 있지 참",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030227,
					"content": "유라는 계속 유라의 방식대로 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030228,
					"content": "언젠가 너로 인해 로렌스 가문에 대한 사람들의 인식이 바뀔 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030229,
					"content": "인내심을 가져야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030230
					]
				},
				{
					"id": 705030230,
					"content": "응, 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030231
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030231,
					"content": "나, 난… 크흠! 오늘은 여기까지 하자. 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030232
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030232,
					"content": "배웅해줄까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030233
					]
				},
				{
					"id": 705030233,
					"content": "아니, 지금 다른 생각은 할 수 없어…. 방금 그 말들을 기억해 놨다가 얼른 종이에 적어야 되거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030234
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030234,
					"content": "술에 취한 유라는 평소보다 솔직한 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030235
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030235,
					"content": "근데 유라가 입버릇처럼 하는 말을 못 들어서, 2% 부족한 느낌이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030236,
					"content": "아! 나중에 술 깨고 나서 오늘 일을 전부 잊어버리라고 협박하는 거 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030237
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030237,
					"content": "그럴지도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}