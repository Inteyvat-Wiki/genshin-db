			"dialogs": [
				{
					"id": 705030101,
					"content": "암초의 물거품, 작은 사이즈로… 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030102,
						705030103
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030102,
					"content": "유라 씨?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				},
				{
					"id": 705030104,
					"content": "난… 난 괜찮아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030105
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705030105,
					"content": "음… 유라 상태가 이상한데, 술을 많이 마시고 온 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030106,
					"content": "암초의 물거품은 커피로 만들었던 것 같아. 술 먹고 커피 마시면, 으아, 배가 폭발하는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030107,
					"content": "유라의 배를 생각해서, 음료를 내가기 전에 몰래 물을 타자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705030103,
					"content": "왜 그래요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				}
			]
		},
		{
			"id": 7050302,
			"completionStepIds": [
				7050303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050303",
							"2"
						],
						"stepId": 7050303,
						"stateName": "QUEST_STATE_UNFINISHED"
