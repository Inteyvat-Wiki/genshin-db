				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "「영롱한 소등도」에 온 걸 환영해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580102,
					"content": "응? 이 등들…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "너구나. 마침 잘 왔어. 저번에 그 등은 네가 다 맞춰서 특별히 다른 걸로 바꿨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580104,
					"content": "어때? 한번 풀어볼래? 이번엔 저번처럼 쉽지 않을걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580105,
					"content": "도안이 더 복잡해졌나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "아니, 도안은 쉬워. 여전히 3개야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580107,
					"content": "어려워진 건 「돌리는 방식」이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580112,
					"content": "맞다, 이번에 맞춰야 할 그림은 <color=#00E1FFFF>「모라」</color>야. 그림을 정확히 맞춰야 보물을 찾을 수 있다는 거, 잊지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소천"
				},
				{
					"id": 413580108,
					"content": "돌리는 방식이 어려워졌나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "헤헤, 이번엔 등 3개가 <color=#00E1FFFF>「연동」</color>돼 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580110,
					"content": "쉽게 말해서 하나를 돌릴 때 다른 등이 같이 돌아갈 수도 있다는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580111,
					"content": "자, 직접 체험해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "소천"
				}
			]
		},
