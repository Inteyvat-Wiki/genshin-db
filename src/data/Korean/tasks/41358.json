			"dialogs": [
				{
					"id": 413580201,
					"content": "어때? 보물 찾기는 잘 돼가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580202
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580202,
					"content": "모든 보물을 다 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "전부 다? 보물 찾기 실력이… 정말 대단한데? 다들 와서 등만 돌리다 가버리거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413580204,
					"content": "보물을 전부 찾았으니… 이 보상을 줄게. 해등절 재밌게 보내길 바라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소천"
				}
			]
		},
