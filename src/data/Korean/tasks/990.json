					"nextDialogs": [
						9901515
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 9901515,
					"content": "어쨌든, 당신의 초대를 받아서 너무 기뻐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 9901517,
