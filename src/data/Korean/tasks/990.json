					"nextDialogs": [
						9901526
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 9901526,
					"content": "바바라는 쉽게 행복을 느끼는구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "바바라는 늘 다른 사람을 배려하니까 그래",
