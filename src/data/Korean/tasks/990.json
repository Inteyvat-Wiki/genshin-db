						9901517
					]
				},
				{
					"id": 9901513,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 9901514,
					"content": "그렇게 말해줘서 고마워요. 하지만… 노래를 싫어하는 사람이 있을지도 모르잖아요",
