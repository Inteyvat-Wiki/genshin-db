					"nextDialogs": [
						9901535
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 9901535,
					"content": "지적을 당해야… 발전이 있잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바바라"
				},
				{
					"id": 9901537,
					"content": "아, 요새 새로운 곡을 연습 중이었는데",
