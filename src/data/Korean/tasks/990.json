						9901522
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 9901522,
					"content": "왜 갑자기 웃는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "아, 이렇게 친구와 편하게 수다 떠는 게 너무 간만이라서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 9901525,
					"content": "갑자기 행복해졌어요",
