				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "「장미야, 장미야. 내 소원을 들어주렴」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "「꽃은 돌에서 피어나고, 황금 장미는 내게 노래하네」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "와, 정말 아름다운 황금 장미야. 꽃이 핀 걸 보니 내 마음도 환해지는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732090402,
					"content": "요 며칠 쏟았던 노력이 헛되지 않아서 정말 기뻐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732090403,
					"content": "드디어 소원이 이루어졌네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "드디어 내도 하나를 제대로 끝냈데이. 샤파카트 아재, 제가 아재 소원을 대신 이뤘습니더",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732090406,
					"content": "아쉽게도 샤파카트 어르신은 보실 수 없네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090407,
					"content": "사바, 아이다. 장미의 노래 마지막 구절이 뭐였는지 기억나나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732090408,
					"content": "「나를 품어줄 땅은 없고, 노래만이 나를 품어주네」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732090409,
					"content": "「노래는 나를 싫어하는 운명을 이겨내고, 나의 마지막을 이겨내지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732090410,
					"content": "「나를 이기고, 시간을 이기고, 영원히 사라지지 않는 소멸을 이겨내리」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732090411,
					"content": "샤파카트 아재의 생명과 황금 장미는 직접 만드신 노래와 함께 우리 곁에 남아있데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732090412,
					"content": "음, 그렇네요. 샤파카트 어르신은 소멸을 이겨내신 분이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090413,
					"content": "내게 샤파카트 어르신의 이야기를 알려줘서 고마워. 정말 큰 의미가 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090414,
					"content": "샤파카트 어르신은 나보다 앞서 추방되셨던 분인데, 어르신이 남기신 삶의 흔적을 보니 시공간을 뛰어넘은 듯한 느낌이 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090415,
					"content": "샤파카트 어르신뿐만 아니라 내 모습도 보이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090416,
					"content": "비록 샤파카트 어르신에게 무슨 말을 전할 수는 없지만, 내가 어르신의 아쉬움을 안고 살아갈 수는 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090417,
					"content": "어르신의 몫만큼 열심히 살아간다면 언젠가 나 자신을 구원할 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090418,
					"content": "행복하길 바랄게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "이곳의 생활이 더 이상 나쁘게만 느껴지진 않네. 너희를 만나서 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090421,
					"content": "역시 장미꽃은 행복을 가져다주는 꽃이야. 아판 어르신, 우리 앞으로 힘내서 더 많은 장미꽃을 심어 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090422,
					"content": "하하하, 약속한 거래이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732090423,
					"content": "네, 노력할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				},
				{
					"id": 732090419,
					"content": "힘내세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "모든 일은 가치 있는 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
