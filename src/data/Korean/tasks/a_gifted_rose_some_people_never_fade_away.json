			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "왔나, 장미캉 기다리고 있었데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732090102,
					"content": "사바도 일찍 왔네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732090103,
					"content": "요즘 여기에 자주 들르고 있어. 샤파카트 어르신이 남기신 노트도 다 봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090104,
					"content": "아루 마을에서 살면서 외롭다고만 생각했었는데 생각이 바뀌었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090105,
					"content": "적어도 난 혼자가 아니더라고. 장미들도 있고 너희와 함께한 기억도 있고 아판 어르신도 있으니 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090106,
					"content": "또 내 삶에는 아름다운 그리움이 있지. 이렇게 생각하니 더 이상 외롭지 않더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090107,
					"content": "아판 어르신과는 잘 이야기했어. 앞으로 아판 어르신과 함께 황금 장미를 돌볼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090108,
					"content": "장미들은 더 많이 피어나 모밭을 가득 채우게 될 거야. 지금은 우선 이 몇 송이부터 피워 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090109,
					"content": "전에 내 수메르 장미를 어떻게 피게 했는지 기억나? 똑같이 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732090110,
					"content": "해볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "자, 네게 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				}
			]
		},
		{
