			"dialogs": [
				{
					"id": 732090301,
					"content": "「장미야, 장미야. 내 소원을 들어주렴」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "「꽃은 돌에서 피어나고, 황금 장미는 내게 노래하네」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7320904,
			"completionStepIds": [
				7320903
			],
