				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "이 새싹들이 건강하게 자라면 니캉 내캉 나중에 더 많은 황금 장미를 피워낼 수 있을 기다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "아판"
				},
				{
