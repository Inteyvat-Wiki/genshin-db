		{
			"id": 4003902,
			"completionStepIds": [
				4003902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003902",
							"2"
						],
						"stepId": 4003902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"응광"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390201,
					"content": "물건이 많이 없어졌군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390202
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400390202,
					"content": "무슨 물건이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390203
					]
				},
				{
					"id": 400390203,
					"content": "군옥각에 있던 물건이 전에 비해 많이 줄었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390204
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400390204,
					"content": "내가 수집한 책, 가구 그리고 장식품들까지, 모두 군옥각과 함께 바다로 빠져 버렸지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390205
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400390205,
					"content": "대부분 그 재난 속에서 파손됐고, 그나마 멀쩡한 일부 물품은 해수면에 떠 있어서 회수하기가 쉽지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390206
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400390206,
					"content": "그러려면 해상 작업에 능한 사람이 필요한데… 북두가 그것들을 전부 건질 수 있을지 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390207
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400390207,
					"content": "건진다구요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390208
					]
				},
				{
					"id": 400390208,
					"content": "엥? 북두한테 건져 오라고 시킨 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400390209,
					"content": "「시켰다」는 말은 적절하지 않아. 우린 늘 공평한 거래만 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390210
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400390210,
					"content": "북두 씨가 돈 받고 일하는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390211
					]
				},
				{
					"id": 400390211,
					"content": "「돈」말고 다른 「보수」도 있지…. 후후, 설명하자면 복잡해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390212
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400390212,
					"content": "아무튼 북두는 지금 고운각 일대에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390213
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400390213,
					"content": "관심 있으면 한번 가봐. 아마 도울 일이 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "응광"
				}
			]
		},
		{
			"id": 4003904,
			"completionStepIds": [
				4003904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
