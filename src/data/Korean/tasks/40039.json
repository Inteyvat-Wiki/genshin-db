			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"북두",
					"신염"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390401,
					"content": "정말 귀찮은 여자군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390402
					],
					"speakerTitle": "북두"
				},
				{
					"id": 400390402,
					"content": "군옥각은 산산조각 나고, 안에 있던 물건도 다 망가졌을 텐데, 대체 어떻게 건지라는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390403
					],
					"speakerTitle": "북두"
				},
				{
					"id": 400390403,
					"content": "작업은 잘 되고 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390404
					]
				},
				{
					"id": 400390404,
					"content": "여행자? 여기까지 웬일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390405
					],
					"speakerTitle": "북두"
				},
				{
					"id": 400390405,
					"content": "도와드리러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390406
					]
				},
				{
					"id": 400390406,
					"content": "오! 잘 왔어, 지금 선원들이 다 바빠서 안 그래도 일손이 부족했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390407
					],
					"speakerTitle": "북두"
				},
				{
					"id": 400390407,
					"content": "봐, 신염까지 불러왔다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390408
					],
					"speakerTitle": "북두"
				},
				{
					"id": 400390408,
					"content": "신염도요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390409
					]
				},
				{
					"id": 400390409,
					"content": "그러게, 신염이 왜 배에 있어? 공연하러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400390410,
					"content": "맞아! 정식 공연은 아니지만, 북두 언니가 연회에서 노래해달라고 날 초대했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390411
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400390411,
					"content": "근데 시작도 하기 전에 응광 님의 비서라는 사람이 와서는 북두 언니를 데려갔지 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390412
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400390412,
					"content": "백문인지 백효인지, 어… 기억이 잘 안 나네",
					"roleType": "TALK_ROLE_NPC",
