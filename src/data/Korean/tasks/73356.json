			"dialogs": [
				{
					"id": 733560201,
					"content": "각자 나아갈 길이 있으니, 더 이상의 말은 필요 없겠지. 차는 맛있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "모자"
				},
				{
					"id": 733560202,
					"content": "(조금 더 앉아있자)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 733560204,
					"content": "그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "모자"
				},
				{
					"id": 733560203,
					"content": "티타임을 슬슬 끝내야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "「산드로네」"
				}
			]
		}
	]
