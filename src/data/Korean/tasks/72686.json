			"dialogs": [
				{
					"id": 726860101,
					"content": "이름이 어떻게 되는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860102,
					"content": "#{NICKNAME}(이)요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "좋아, 기록해 뒀어. 그럼 무사의 긍지를 걸 각오는 됐겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860104,
					"content": "네? 너무 갑작스럽잖아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "음? 자네는 소문을 듣고 결투에 참여하러 온 무사가 아닌가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860107,
					"content": "처음 듣는 소문인데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "설마 자네는 「검의 각축」을 들어보지 않았나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860109,
					"content": "그럴 리가, 분명 공지를 붙였을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860110,
					"content": "어디에 붙였는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726860111,
					"content": "여기에 붙였네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860112,
					"content": "여긴 붙여도 소용없거든! 그렇게 홍보해서 대체 누가 오겠냐구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726860113,
					"content": "흥, 야시로 봉행이 「이로도리 축제는 칼부림을 엄금한다」며, 내가 이도에서 결투장을 열겠다는 요구사항을 거절해서 이렇게 된 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860114,
					"content": "그래서 결투장을 이곳으로 정하는 수밖에 없었지, 공지사항도 바로 옆에 붙인 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860115,
					"content": "하지만 이미 네 명의 무사가 비무에 참여하러 왔네, 그대까지 포함하면 다섯 명인 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860116,
					"content": "#이딴식으로 홍보에도 참여하러 오는 사람이 있다니, 정말 신기해. 그나저나 {NICKNAME}은(는) 여기 왜 왔더라, 전혀 기억이 안 나네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726860117,
					"content": "사정을 모르는 상황에서도 이 섬에 오다니, 자네는 분명 강한 무사도 정신을 지닌 용사님이 틀림없군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860118,
					"content": "무예를 추구하는 자들을 서로 이끌리기 마련이지. 이건 상식이니 그렇게 의아해할 필요 없다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860119,
					"content": "그게 대체 무슨 상식인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726860120,
					"content": "하하, 어떤가? 한번 겨뤄보겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860121,
					"content": "자네가 네 명의 참가자와 대결해서 모두 승리한다면, 자연히 상금도 주어질 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860122,
					"content": "생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "알겠네, 그럼 좀 더 생각해 보게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726860105,
					"content": "아뇨, 실례했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}