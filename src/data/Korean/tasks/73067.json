						730670703
					],
					"speakerTitle": "아란샤쿤"
				},
				{
					"id": 730670703,
					"content": "응, 「털북숭이 가면 마왕」은 츄츄족이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730670704,
					"content": "「츄츄족」은 다 「털북숭이 가면 마왕」이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "아란샤쿤"
				},
				{
					"id": 730670705,
					"content": "아니, 그건 아닌데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730670706,
					"content": "아란샤쿤, 그렇게 이해해도 상관없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "응, 아란샤쿤 이해했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "아란샤쿤"
				},
				{
					"id": 730670708,
					"content": "#아, 나라{NICKNAME}와(과) 페이몬 덕분에 아란샤쿤이 앞장서서 다 쓸어버릴 수 있었어. 음흉하고 교활한 「털북숭이 가면 마왕」도 내 적수가 되기엔 역부족이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "아란샤쿤"
				},
				{
					"id": 730670709,
					"content": "오늘 일은 아란샤쿤이 돌아가서 꼭 큰 글씨로 적을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "아란샤쿤"
				},
				{
					"id": 730670710,
					"content": "꼭 큰 글씨여야 해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "응, 엄청나게 큰 글씨로 적을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "아란샤쿤"
				},
				{
					"id": 730670712,
					"content": "「용기」 있는 아란샤쿤은 「용기」 없는 아란샤쿤이랑 완전히 다른 아란나라 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730670713,
					"content": "「용기」 없는 아란샤쿤은 손발만 덜덜 떨면서 아무것도 못 해. 하지만 「용기」 있는 아란샤쿤은 무슨 일이든 멋지게 해낼 수 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670714
					],
					"speakerTitle": "아란샤쿤"
				},
				{
					"id": 730670714,
					"content": "그러니까 「용기」는 나라 친구가 준 최고의 선물이자 아란샤쿤에게 있어서 제일 중요한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670715
					],
					"speakerTitle": "아란샤쿤"
				},
				{
					"id": 730670715,
					"content": "그럼 또 츄츄족에게 뺏기지 말고 잘 간직해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670716
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730670716,
					"content": "응, 다시는 「용기」를 뺏기지 않을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란샤쿤"
				}
