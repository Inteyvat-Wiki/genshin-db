				{
					"id": 200400501,
					"content": "그녀가 말은 그렇게 했지만 앞에 몬스터가 꽤 많다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200400502,
					"content": "핀더 아가씨를 도와 주위를 쓸어버리자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200400503,
					"content": "그녀의 심각한 모습을 보니 자칫하면 정면돌파할지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200400504,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "응. 심각한 사람은 도움을 받아야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200400505,
					"content": "정말 그 정도로 심각한 사람이 있다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "그건 가장 최악의 상황이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200400508,
					"content": "그런 상황이 벌어지지 않게 빨리 마물들을 처치하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
