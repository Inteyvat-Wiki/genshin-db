			"dialogs": [
				{
					"id": 200400101,
					"content": "휴, 대체 어떻게 지나가야 하는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400102,
					"content": "오… 날 찾다니 무슨 볼일이라도 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400103,
					"content": "여기서 뭐 해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "폭풍이 몰려오는지 확인하러 바람맞이 봉우리의 전망대에 갈 준비 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400105,
					"content": "하지만 앞에 몬스터 떼가 길을 막고 있어서…. 여길 어떻게 지나갈지 생각하고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400106,
					"content": "아, 걱정 마, 나 대신 전망대에 가란 뜻은 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400107,
					"content": "이건 내 임무이자 개인적인 고집이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400108,
					"content": "바쁘면 가서 일 봐. 난 방법을 좀 더 생각해볼 테니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "핀더"
				}
			]
		},
