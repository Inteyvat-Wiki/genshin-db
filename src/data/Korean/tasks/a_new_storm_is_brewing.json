			"dialogs": [
				{
					"id": 200400201,
					"content": "무슨 일이 더 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400202,
					"content": "앞쪽은 이미 해결됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "엇? 바람 신께 감사를…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400204,
					"content": "아, 아니지. 너한테 감사해야 하는데, 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400205,
					"content": "어떻게 보답해야 할지…. 아, 맞다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400206,
					"content": "전망대로 가봐. 난 여기서 기다릴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "핀더"
				}
			]
