			"dialogs": [
				{
					"id": 200400401,
					"content": "그러게…. 오늘도 바람 한 점 없이 잔잔한 하루네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400402,
					"content": "내 가족은 바네사 님의 명에 따라 폭풍을 감시해왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400403,
					"content": "바르바토스 님의 비호를 받은 뒤로 몬드는 더 이상 폭풍의 침입을 받은 적이 없어, 전망대도 점점 쓸모가 없어졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400404,
					"content": "하지만 그렇다고 해도 난 전망대에 가서 보고 싶은 마음이 들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400405,
					"content": "수고했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "고마워, 하지만 내 「직책」은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400407,
					"content": "차라리 영원히 그걸 수행하고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400410,
					"content": "됐고, 도와줘서 고마워. 이 풍차 국화는 선물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400411,
					"content": "전에 우리 가족은 풍차 국화의 생장 정도로 지역의 풍력을 가늠했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400412,
					"content": "바람이 아예 불지 않는 곳이나 폭풍의 침입이 있는 곳에선 풍차 국화가 자라지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400413,
					"content": "몬드처럼 부드러운 바람이 있는 곳에서만 잘 자랄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400414,
					"content": "이대로만 잘 자라줬으면 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "핀더"
				},
				{
					"id": 200400408,
					"content": "아주 고된 역사군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "맞아, 그런 역사가 영원히 되풀이되지 않길 바라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "핀더"
				}
			]
		},
