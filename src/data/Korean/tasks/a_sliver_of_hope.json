						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이마타니 카오리"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "역시 젊은 사람은 일처리가 빠르다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120502,
					"content": "젊은 사람은 힘이 넘치고 어르신분들은 경험이 풍부하잖아요. 각자 장점이 있는 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120503,
					"content": "그러고 보니, 올해가 딱 오십 년인가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120504,
					"content": "그렇구먼, 한해 한해 지나갈 땐 별 느낌 없었는데, 눈 깜박할 사이에 벌써 오십 년이 흘렀네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120505,
					"content": "오십 년? 무슨 중요한 날이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120120506,
					"content": "하하, 그건 오십 년 전에 할멈이 나 좋다고 쫓아다닐 때의 일이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120507,
					"content": "이이가, 못 하는 소리가 없네. 당신이 좋다고 따라다닌 거잖수",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120508,
					"content": "그럼 그 부분은 생략하고. 어쨌든, 그 해 「나가노하라 불꽃축제」에서 내가 이 사람한테 청혼을 해서 지금까지 쭉 함께 해 온 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120509,
					"content": "축하드려요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "사실 준비가 안 된 상태에서 망설이는 마음으로 나가노하라에 폭죽을 주문했다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120512,
					"content": "폭죽을 쏘아 올린 순간에도 어떻게 얘길 꺼내야 할지 감이 안 잡히더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120513,
					"content": "그러다 펑 하면서 폭죽이 밤하늘을 밝혔고, 그녀의 옆모습을 봤더니 눈에 폭죽이 비치면서 반짝였지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120514,
					"content": "어찌 된 일인지, 정신을 차리고 보니 이미 청혼을 해버렸고, 이 사람도 좋다고 하더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120515,
					"content": "오십 년이 길다면 길고 짧다면 짧은 시간이니, 그리 대단한 일은 아닐세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120516,
					"content": "그래도 함께 오십 년 인생을 걸어왔으니 기념할만한 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120517,
					"content": "올해가 오십 주년인 줄 몰랐어요. 알았으면 더 특별하고 화려한 폭죽을 준비해 드리는 건데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120518,
					"content": "괜찮아, 전과 같은 거면 된단다. 매번 불꽃축제를 보는데 그게 아니면 허전할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120519,
					"content": "불꽃만 보면 그때의 일들이 떠오른단다. 나이가 들었어도 지나온 세월에 후회는 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120520,
					"content": "사이가 정말 좋네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120120521,
					"content": "그나저나 우리 얘기는 이만하고, 한창 불꽃축제 때문에 바쁠 텐데 여기까지 오다니, 중요한 일이라도 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120522,
					"content": "음, 사실 부탁드리기 좀 곤란한 일인데, 일단 설명해드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120523,
					"content": "사쿠지로가… 돌아왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120524,
					"content": "어? 누군지 아세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120525,
					"content": "우리 애랑 어릴 적 제일 친한 친구였단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120526,
					"content": "휴, 그땐 매일 붙어 다녔지. 함께 자라면서 이곳저곳 쏘다니던 둘도 없는 친구였단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120527,
					"content": "그런데 하루는 둘이 엄청 심하게 다퉜지 뭐니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120528,
					"content": "그때 사쿠지로는 이나즈마가 너무 평온하다면서 바깥 세상을 보고 싶어 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120529,
					"content": "하지만 우리 애 케이스케는 어릴 적부터 우리처럼 안정된 삶을 사는 게 나쁘지 않다고 생각했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120530,
					"content": "애들은 늘 옳고 그름의 문제 때문에 심하게 다투잖니. 결국엔 사쿠지로가 홧김에 떠나버렸단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120531,
					"content": "그랬군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120532,
					"content": "그 뒤로 케이스케는 별 얘기 없었지만, 우린 그 애가 얼마나 속상해하는지 알았지. 하지만 속마음을 우리한테 터놓고 얘기한 적은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120533,
					"content": "후엔 오기가 생긴 건지 아니면 다른 이유에서인지 텐료 봉행에 들어가더니 집에 좀처럼 돌아오지 않게 됐다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120534,
					"content": "다른 부탁이라면 케이스케와 잘 얘기하면 도와주겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120535,
					"content": "사쿠지로에 관한 일이라면, 아마… 우리가 끼어들 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120536,
					"content": "이런 우연이 있을 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120120537,
					"content": "알겠어요. 사쿠지로 씨한테 돌아온 이유를 물었을 때 「과거의 잘못」 때문이라고만 하고 대답을 피했거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120538,
					"content": "왜 결정을 못 내리는 건지 드디어 알겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120539,
					"content": "어릴 적 절친한 친구였는데 한 명은 텐료 봉행 소속, 한 명은 텐료 봉행에 수배당하는 신세라니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120120540,
					"content": "이런 게 바로 운명이겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "괜찮아요, 그럼 더 이상 두 분을 곤란하게 해선 안 되죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120543,
					"content": "저희가 방법을 찾아볼게요. 두 분도 무리하지 말고 이번 일은 사쿠지로 씨랑 케이스케 씨가 직접 해결하도록 맡기세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120544,
					"content": "그래, 둘 사이가 예전 같아진다면 참 좋을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "이마타니 카오리"
				},
				{
					"id": 120120545,
					"content": "오랜 다툼도 이젠 내려놓을 때가 됐는데 말이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이마타니 사부로"
				},
				{
					"id": 120120541,
					"content": "생각지도 못했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "너무 부러워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
