			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사토루"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "사토루 아저씨, 안녕하세요. 잘 지내셨어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120402,
					"content": "나야 그대로지, 뭐. 요이미야는 여전히 기운 넘치는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120403,
					"content": "여러분들 덕분에 가게 장사가 점점 더 잘되고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120404,
					"content": "전에 리월에 팔았던 폭죽도 호평을 받았다고 들었어요. 이제 주문이 점점 늘어나겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120405,
					"content": "그럼 더 힘들어지겠네. 류노스케 씨와 둘이서 괜찮겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120406,
					"content": "힘들면 도와줄 테니 언제든 말해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120407,
					"content": "괜찮아요, 폭죽에 관한 건 제가 잘 해낼 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120408,
					"content": "아, 참. 카오리 할머니가 보낸 무 절임이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120409,
					"content": "오, 고맙다. 예전엔 무 절임을 잘 안 먹었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120410,
					"content": "카오리 아주머니 솜씨를 한번 맛본 후론 잊을 수가 없더군. 지금은 가족 모두의 습관이 돼 버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120411,
					"content": "가족분들은 잘 지내죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120412,
					"content": "잘 지내. 가끔 다투기도 하는데, 가족끼린 원래 그러잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120413,
					"content": "같이 지내면 갈등이 생기긴 하지만, 아예 못 만나는 것보단 낫지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120414,
					"content": "그 두 분도 사이가 좋긴 해도, 아들이 잘 안 돌아오니 많이 적적하실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120415,
					"content": "그래 보이진 않았어요. 이미 익숙해지신 거 같던데요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120416,
					"content": "하지만 아저씨 말도 맞아요. 앞으로 제가 더 자주 가봐야겠네요. 이야기 상대가 있으면 심심하진 않을 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 120120417,
					"content": "그레, 콘다 마을 사람 모두 네가 오길 바라고 있을걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "사토루"
				},
				{
					"id": 120120418,
					"content": "헤헤, 고맙습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요이미야"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
