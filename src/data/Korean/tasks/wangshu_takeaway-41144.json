			"dialogs": [
				{
					"id": 411440301,
					"content": "특별 주문이 있다고 들었어요….",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411440302
					]
				},
				{
					"id": 411440302,
					"content": "왜, 배달 도와주러 왔니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440303
					],
					"speakerTitle": "언소"
				},
				{
					"id": 411440303,
					"content": "후, 마침 잘 왔어. 영주라는 손님이 송이버섯말이를 주문했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "언소"
				},
				{
					"id": 411440304,
					"content": "좀 이따가 적화주 서쪽에 있는 곳으로 배달해달라고 했어. 돈도 지불했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "언소"
				},
				{
					"id": 411440305,
					"content": "어때? 시간 되면 배달 좀 도와줄래? 보수는 두둑이 챙겨줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				}
			]
