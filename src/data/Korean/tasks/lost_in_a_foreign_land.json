					"카타리나",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "콜록… 후우… 잠깐, 멈춰…! 넌 누구지? 왜 여기 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710580102,
					"content": "그리고… 왜 날 공격하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710580103,
					"content": "우리가 묻고 싶은 말이야! 여기서 수상하게 뭘 하고 있었던 건데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710580104,
					"content": "당신이 나쁜 사람이니까 당신부터 말해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "…카타리나, 카타리나·스네즈브나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710580106,
					"content": "이름은 우리한테 가장 숨길 가치가 없는 정보지. 미안, 내가 말해줄 수 있는 건 여기까지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710580107,
					"content": "음… 우린 단지 상황을 물어보고 싶었던 것뿐이라구, 고문할 생각 같은 건 없었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710580108,
					"content": "미안, 미안. 이게 내가 말해줄 수 있는 전부야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710580109,
					"content": "왜 우인단이 이곳에서 활동하는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "기밀이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710580111,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "뭐야! 수상하고 나쁜 녀석들 같으니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710580113,
					"content": "후후, 맞아. 우린 나쁜 놈들이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710580114,
					"content": "자아, 호기심 많은 꼬마의 시간은 여기까지야…. 문제가 생겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카타리나"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
