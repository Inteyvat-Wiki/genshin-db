				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"자비에"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "잘했군. 내가 좀 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721180402,
					"content": "우리 운이 아직 괜찮나 보네. 「미카게 용광로」의 상태는 매우 안정적이고, 주변 「재앙신」의 에너지도 그리 짙은 편이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721180403,
					"content": "이런 농도라면 장치도 버틸 수 있을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721180404,
					"content": "모든 「재앙신」의 에너지를 정화해야 하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "이 장치가 그 정도까지 할 수 있다면 특허 출원했을 거야. 이 장치는 기껏해야 일부 지역의 에너지 지표를 낮출 수 있을 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721180406,
					"content": "「미카게 용광로」도 그래서 멈춘 거 같아. 자동 재시작 프로그램도 실행이 안 돼. 이게 아마 다 고농도의 「재앙신」 에너지 가방 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721180407,
					"content": "「재앙신」 농도가 가장 높은 곳을 찾아 이를 정화시켜, 코어가 다시 작동하도록 해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721180408,
					"content": "그 후, 「미카게 용광로」가 재개될 거야. 이후로는 우리가 신경 쓸 일이 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721180409,
					"content": "이게 내 계획의 전부야. 그전에 아직 준비할게 좀 남았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비에"
				}
			]
		},
