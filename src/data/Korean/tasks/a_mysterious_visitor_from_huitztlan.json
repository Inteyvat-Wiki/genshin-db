					}
				]
			},
			"dialogs": [
				{
					"id": 150000101,
					"content": "#{M#언니 오빠}{F#언니들} 안녕! 난 휴니야. 아기 용들 찾으러 온 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000102
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000102,
					"content": "난 토바야. 두 사람이 바로 그 조력자지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000103
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000103,
					"content": "응? 꼬마야, 반갑긴 한데 우리는 그냥 지나가던 길이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000104,
					"content": "야마시타 아저씨가 도와줄 친구를 보냈다고 했는데… 진짜로 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000105
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000105,
					"content": "우리한테 야마시타라는 친구는 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000106
					]
				},
				{
					"id": 150000106,
					"content": "…잘은 모르겠지만, 뭔가 착오가 있는 거 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000107,
					"content": "그런가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000108
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000108,
					"content": "망했어, 휴니, 우리가 속은 거야. 그 안경잡이는 역시 사기꾼이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000109
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000109,
					"content": "그럼 아기 용들은 어떡하지… 이제 시간이 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000110
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000110,
					"content": "꼬마야, 일단 침착하고 말해봐. 아기 용이 어쨌는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000111,
					"content": "요즘 부족 분위기가 어수선해. 아빠의 용 동료 난나가 사고를 당했거든. 새끼도 셋 있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000112
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000112,
					"content": "난나가 사고를 당해서 겁을 먹었는지 새끼들이 숨어버렸어. 난 걱정돼서 찾으러 온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000113
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000113,
					"content": "아빠의 용 동료 일이라면… 아빠가 해결하지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000114,
					"content": "아빠는 부족 장로라서 한창 회고의 밤을 준비하느라 바빠. 그건 아주 중요한 일이거든. 나도 아빠 몰래 빠져나온 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000115
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000115,
					"content": "오래 안 걸릴 줄 알았는데, 아까 그 아저씨한테 붙들려서 이것저것 얘기해 주느라 시간을 왕창 낭비했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000116
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000116,
					"content": "우씨, 진짜 인정도 없는 안경잡이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000117
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000117,
					"content": "#화내지 마. 우리가 도와줄게! 딱히 어려운 일도 아닌 거 같고, 우린 인정이 넘치는 사람들이거든. 안 그래, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000118,
					"content": "물론이야. 아기 용은 이 근처에 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000119
					]
				},
				{
					"id": 150000119,
					"content": "아마 그럴 거야. 내가 흔적들을 발견했는데, 주변 절벽 위에 숨어있을 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000120
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000120,
					"content": "나랑 페이몬한테 맡겨. 오래 걸리진 않을 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000121
					]
				},
				{
					"id": 150000121,
					"content": "#정말? {NICKNAME} {M#오빠}{F#언니}, 페이몬 언니, 정말 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000122
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000122,
					"content": "와! 대신 두 사람 다 조심해. 여기 절벽은 엄청 가팔라서 부족 어른들도 잘 못 올라가거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "토바"
				}
			]
		},
