				]
			},
			"dialogs": [
				{
					"id": 150000401,
					"content": "뀨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000402
					],
					"speakerTitle": "포치치",
					"speakerSubtitle": "아기 숲룡"
				},
				{
					"id": 150000402,
					"content": "아기 용들이 저기 있어! 응? 옆에 저건… 아쥬 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000403,
					"content": "이거 이거, 내 시종의 못된 친구들 아냐? 산 밑에서 내 늠름한 자태를 보고 공양하러 왔나 보군. 전에 본 이 몸의 위대함이 인상 깊었나 보구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000404
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000404,
					"content": "정말 못 말리겠군. 자, 내 발등에 입 맞추거라. 위대하고 신성한 용, 쿠훌 아쥬가 너희의 참배를 허락하마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000405
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000405,
					"content": "넌… 넌 그 키니치의 쫄병이잖아? 혼자 뭐라는 거야? 저번보다 더 얄미워졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000406,
					"content": "뭐? 쪼올병? 이 몸은 지고지상한 용이다! 열화의 나라의 지고한 영주란 말이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000407
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000407,
					"content": "키니치가 간곡히 빌지만 않았으면, 이 몸이 너희에게 말을 건네는 은혜는 없었을 거다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000408
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000408,
					"content": "뭐래, 키니치한테 꽉 잡혀 있으면서. 엄청 뭐라도 되는 것처럼 구네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000409,
						150000411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000409,
					"content": "위대하신 영주님, 여기서 뭘 하고 계셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000410
					]
				},
				{
					"id": 150000410,
					"content": "흐흥, 이제야 말귀를 좀 알아먹는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000413,
					"content": "이 몸은 시종의 간청을 들어주고자 위칠틀란 부근의 심연 사건을 조사하고 있는 것이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000414
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000414,
					"content": "심연 사건?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000415,
					"content": "이 작은 파충류가 보이나? 이것의 어미, 중간 파충류는 심연의 힘에 잠식되어 내 시종의 부족 사람들을 공격하고 자기 후손까지 공격했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000416
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000416,
					"content": "세상에… 그럼 지금 그 녀석은 어떻게 됐는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000417,
					"content": "저급한 파충류가 심연의 힘을 오래 버틸 수 있겠냐? 당연히 밤의 신의 나라로 가버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000418
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000418,
					"content": "연약한 생명이구나…. 절벽에서 뛰어내려 스스로 생을 마감했으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000419
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000419,
					"content": "절벽에서 뛰어…?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000420,
					"content": "날개 달린 흰개미, 질문이 백 개는 있는 듯한 멍청한 표정 짓지 마라. 위대하고 신성한 용 쿠훌 아쥬는 소원의 샘 따위가 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000421
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000421,
					"content": "날개 달린 흰개미?! 너… 나도 꼭 이상한 별명을 지어줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000422,
					"content": "흥. 이 몸은 근처에서 미약한 심연의 기운을 느꼈다. 분명 사악한 술사가 숨어있는 걸 테지. 그러니 수상한 외지인을 만나면 자세히 심문해 보도록",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000423
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000423,
					"content": "수상한 외지인이라면… 너 심연 핑계 대고 우리 욕하는 거 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000424
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000424,
					"content": "흥! 아랫것들이 이 몸을 이해할 리가 없지! 내 시종의 못된 친구만 아니었어도 아주 흠씬 두들겨 패줬을 거다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000425
					],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000425,
					"content": "참배하러 온 게 아니면 후딱 물러가! 위대하고 신성한 쿠훌 아쥬는 공사가 다망하시다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아쥬"
				},
				{
					"id": 150000411,
					"content": "쫄병 씨, 산 위에서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000412
					]
				},
				{
					"id": 150000412,
					"content": "영주님이라니까! 감히 이 위대한 쿠훌 아쥬 님을 화나게 해? 가히 천 년 동안 회고의 불에 태울 죄로다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "아쥬"
				}
			]
		},
		{
