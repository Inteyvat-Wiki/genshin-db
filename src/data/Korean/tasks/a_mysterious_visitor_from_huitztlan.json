					{
						"sceneId": 3,
						"position": [
							-2374.395,
							259.072,
							8482.007
						],
						"pointId": 9116
					}
				]
			},
			"dialogs": [
				{
					"id": 150000501,
					"content": "#와! {M#형 누나}{F#누나들} 진짜 대단해! 벌써 돌아온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000502
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000502,
					"content": "#아기 용들이 무사해서 다행이야. 이제 안심하고 집에 돌아갈 수 있겠어. 고마워, {M#언니 오빠}{F#언니들}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000503
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000503,
					"content": "별말씀을. 별로 힘들지도 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000504,
					"content": "#높은 산을 올랐으니까 분명 힘들었을 거야. {M#언니 오빠는}{F#언니들은} 여기 사람이 아니지? 옷차림이 그래 보여. 그럼 우리 집에서 쉬었다 가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000505
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000505,
					"content": "맞아, 나무살이가 손님을 얼마나 잘 대해 주는지 보여줄게! 두 사람은 정말 착해. 그 안경잡이랑은 완전 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000506
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000506,
					"content": "근데 그 사람도 외지인이었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000507,
					"content": "옷이 나타 스타일은 아니었어…. 어, 지금 생각해 보니까 엄청 수상하네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000508
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000508,
					"content": "수상한 외지인? 설마 아쥬가 말한 그…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000509,
					"content": "그 사람에 대해 자세히 알려줄래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000510
					]
				},
				{
					"id": 150000510,
					"content": "그 아저씨에 대해 알고 싶어? 음, 그러니까 어떻게 된 거냐면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000511
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000511,
					"content": "아저씨, 얘기라면 벌써 몇 개나 들려줬잖아…. 아기 용은 언제 찾아줄 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000512
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000512,
					"content": "하나만 더 듣고. 그 불 얘기도 들려주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000513
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000513,
					"content": "아저씨가 듣기로 거대하고 투명한 불이 500년, 1000년, 심지어는 그보다도 더 오랫동안 타오르고 있다던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000514
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000514,
					"content": "그건 회고의 불이야! 「말리{RUBY#[S]회고의 불}포」라는 고대 이름도 그 전설에서 탄생했지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000515
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000515,
					"content": "호오, 고대 이름의 기원이라고? 그렇게 대단하단 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000516
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000516,
					"content": "응. 모든 고대 이름엔 유래와 전설이 있어. 회고의 불은 나타 대연맹 시대에 나타나서, 폭군 오치칸이 나타를 통치하고 반대자들을 제압하는 데 썼다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000517
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000517,
					"content": "회고의 불이 평범한 불이랑 다른 건, 불이 붙어도 등이 타들어가는 고통은 느껴지지만 곧바로 죽진 않는다는 거야. 그리고 이때 절대로 뒤돌아보면 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000518
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000518,
					"content": "뒤돌아보면 안 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000519
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000519,
					"content": "돌아보는 순간 끝이야. 바로 재가 되어버려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000520
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000520,
					"content": "와… 옷이랑 머리를 태우는 정도면 몰라도, 사람을 태우는 건 너무한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000521
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000521,
					"content": "그치! 등을 불태우면서 돌아보지도 못하게 한다니, 오치칸은 정말로 못된 폭군이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000522
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000522,
					"content": "그럼 전설인 만큼 그에 대항할 용자가 나타났겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000523
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000523,
					"content": "뭘 좀 아네, 안경 아저씨. 맞아, 그 사람이 바로 우리 나무살이의 선조, 유팡키 님이셔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000524
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000524,
					"content": "응. 원래 유팡키 님과 폭군 오치칸, 그리고 초대 불의 신 스발란케 님은 모두 친구였어. 당시 대연맹의 군수관이셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000525
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000525,
					"content": "오치칸의 잔혹한 통치를 받아들일 수 없던 그분은 사람들을 위해 회고의 불을 훔쳐 폭군의 군대에 던졌어. 그걸 막아낼 수 없던 병사들은 전부 재가 돼버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000526
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000526,
					"content": "그렇게 선조님이 사람들을 해방시키고 성에서 도망치려는데, 뒤에서 오치칸의 목소리가 들려오는 것 같은 거야. 그래서 홀린 듯이 뒤를 돌아봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000527
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000527,
					"content": "하지만 그분의 눈에 비친 건 검게 그을린 도시와 말라버린 병사, 하늘까지 치솟는 불길뿐이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000528
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000528,
					"content": "그다음 순간, 눈에 비치던 불길이 갑자기 눈동자에서 튀어나와 선조님을 집어삼켰어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000529
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000529,
					"content": "그냥 한 번 뒤돌아봤을 뿐인데! 똑같이 재가 되고 마셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000530
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000530,
					"content": "그게 불을 훔친… 아니, 뒤를 돌아본 대가야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000531
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000531,
					"content": "모르겠어. 다만 유팡키 님을 태운 불길은 다른 무엇보다 맹렬했고, 장장 백 일 동안 타올라 지맥에 큰 구멍까지 뚫어버렸어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000532
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000532,
					"content": "그리고는 「슉」하고 깜깜한 밤의 신의 나라로 떨어져, 지금까지 타오르고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000533
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000533,
					"content": "어른들이 그랬어. 그 불은 왕생의 길을 밝혀주지만, 그 불에 타는 걸 받아들인 망자만이 깨끗해져서 다음 생을 맞이할 수 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000534
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000534,
					"content": "그게 마치 일생을 돌아보고 심판하는 것 같아서… 사람들은 그걸 유팡키의 회고의 불이라고 불러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000535
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000535,
					"content": "오… 정말 시적인 이야기네! 그럼 밤의 신의 나라에선 그 불꽃을 볼 수 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000536
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000536,
					"content": "그건 나도 몰라…. 아마 그냥 전설 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000537
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000537,
					"content": "그럼 그 고대 이름을 물려받은 사람도 있겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000538
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000538,
					"content": "당연하지. 「회고의 밤」 제사의 영웅 부르키나가 그중 하나야. 500년 전 사람이지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000539
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000539,
					"content": "응. 지금은 키니치 오빠가 고대 이름을 물려받았어…. 「말리{RUBY#[S]회고의 불}포」의 키니치야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000540
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000540,
					"content": "키니치라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000541
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000541,
					"content": "이제 됐지, 안경 아저씨? 이야기는 충분히 했으니까, 이제 아기 용을 찾아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000542
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000542,
					"content": "아… 근데 회고의 불의 전설도 뒤돌아보지 말라는 교훈을 남겼잖아? 그러니까 우리도 앞에 했던 얘기를 더 돌아보지 말자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000543
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000543,
					"content": "이번엔 키니치에 대해 얘기해 줘. 지금부터 하나만 더 듣는 걸로 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000544
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000544,
					"content": "응? 토바, 당장이라도 욕을 퍼부을 듯한 그 표정은 뭐야? 그러면 안 돼, 그건 어른의 특권이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000545
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000545,
					"content": "아저씨… 혹시라도 우릴 속인 거면… 죽고 나서 회고의 불에 엄청 끔찍하게 타버릴 줄 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000546
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000546,
					"content": "현지 불이 외지인도 태워? 근데 아저씨는 이곳 사람이 아닌걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000547
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000547,
					"content": "에…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000548
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000548,
					"content": "잠깐… 저건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000549
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000549,
					"content": "좋아, 친구들. 아저씨도 그냥 듣기만 하는 건 아니야. 친구를 두 명 불렀는데, 음… 그 친구들이 대신 보답해 줄 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000550
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000550,
					"content": "그 친구들이 오면 마음껏 부려. 아저씨 체면은 생각 안 해도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000551
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000551,
					"content": "정말? 그럼 안경 아저씨는 이름이 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000552
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000552,
					"content": "절벽 밑에서 만났으니, 「야마{RUBY#[D]산 아래}시타」라고 부르면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000553
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000553,
					"content": "뭐야 그게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000554
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000554,
					"content": "못 믿겠으면 돌아봐봐. 저기 벌써 왔네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000555
					],
					"speakerTitle": "엔죠"
				},
				{
					"id": 150000555,
					"content": "응? 어디 있다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000556
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000556,
					"content": "아저씨… 어? 어디 갔어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000557
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000557,
					"content": "들으면 들을수록 수상한걸… 그 녀석 고대 이름에 대해 캐묻고 다니는 거 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000558
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000558,
					"content": "그치? 망할 안경잡이, 우리를 배신했어! 대가를 치르게 될 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000559
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000559,
					"content": "근데 겨우 이야기 몇 개 들려준 게 다잖아. 그 정도로 별일 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000560
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000560,
					"content": "#음… {NICKNAME}, 키니치에게 알려줘야 하지 않을까? 아쥬 녀석이 조사 중이긴 하지만, 걘 뭔가 못 미덥단 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000561
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000561,
					"content": "어? 키니치 오빠랑 아는 사이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000562
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000562,
					"content": "친한 사이까진 아니고, 그냥 얼굴 몇 번 보고 밥 같이 먹은 정도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000563
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000563,
					"content": "좋겠다! 난 키니치 형이랑 한 번도 말 못 해봤는데. 형은 부족의 용 사냥꾼인 데다 엄청 대단한 고대 이름까지 있어서 완전 멋있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000564
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000564,
					"content": "나도! 근데 아빠는 오빠를 별로 안 좋아해서 가깝게 지내지 말래…. 분명 그 기고만장하고 못된 녀석 때문일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000565
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000565,
					"content": "아! 쿠훌 아쥬라는 그 나쁜 녀석 말이지? 우리도 한바탕 시달렸어. 진짜 상대하기 싫은 성격이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000566
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150000566,
					"content": "내 말이! 키니치 오빠는 어쩌다 나 말고 그런 애를 동료로 선택했는지 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000567
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000567,
					"content": "으악! 큰일이야, 휴니. 우리 너무 오래 나와 있었어. 빨리 안 들어가면 혼날 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000568
					],
					"speakerTitle": "토바"
				},
				{
					"id": 150000568,
					"content": "#앗, 그럼… {M#언니 오빠}{F#언니들}, 이 길을 따라가면 우리 마을이 나와. 그쪽에 들를 일 있으면 우리 집에도 꼭 한번 놀러 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000569
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000569,
					"content": "필요한 게 있으면 내가 아빠한테 도와달라고 할게, 꼭 와야 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000570
					],
					"speakerTitle": "휴니"
				},
				{
					"id": 150000570,
					"content": "그럼 다음에 또 봐! 우리 먼저 갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "토바"
				}
			]
		},
