						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#{NICKNAME}, 정말 대단해. 못생긴 장치를 「두둥」하고 멋진 부품으로 만들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490302,
					"content": "이제 꽃밭은 더 이상 방해받지 않을 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "좀 다치긴 했지만 남은 꽃들의 상태는 나쁘지 않네. 코슨제니아, 균열계 원형체는 더 이상 말썽 피우러 오지 않을 거니까 네 꽃들은 무럭무럭 자랄 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490304,
					"content": "다행이다…. 그래도 이번 일을 교훈 삼아 귀한 꽃들을 잘 가꾸고 보살필게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}와(과) 페이몬은… 코슨제니아에게 이국의 꽃도 선물하고 꽃밭까지 보호해 줬는데…. 이걸 어떻게 보답해야 하지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490306,
					"content": "신경 쓰지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490307,
					"content": "#참, 전에 직접 채집한 가장 귀한 꽃이 남아있었지! 이걸 {NICKNAME}와(과) 페이몬에게 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490308,
					"content": "#오! 그렇게 귀한 꽃이라면…. {NICKNAME}, 너도 꽃밭을 만들어서 길러보는 건 어떨까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490309,
					"content": "그런데 이거 돌말 아닌가? 이것도 꽃으로 볼 수 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490310,
					"content": "돌말도 식물이고, 아름다우니까 꽃이라고 할 수 있지. 난 훌륭한 원예사가 되기 위해 인간들의 「생물학」을 배웠다고, 후후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490311,
					"content": "뭔가 이상하긴 한데, 나도 정확한 분류법을 모르니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490312,
					"content": "난 앞으로 노력해서 더 훌륭한 원예사가 될 거야. 인간들이 그러는데, 훌륭한 원예사는 새로운 품종의 꽃을 길러내서 「원예회」에 참가한대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490313,
					"content": "나도 새로운 품종을 길러내서 「원예회」에서 「상」을 받을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490314,
					"content": "기세는 좋긴 한데, 코슨제니아가 뭔가 많은 오해를 하고 있는 모양이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490315,
					"content": "원예회에 참가하면 코슨제니아가 기른 새로운 품종을 인간들에게 보여줘야 하잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490316,
					"content": "하지만 코슨제니아의 심미관은 인간들과 너무 달라…. 인간들이 코슨제니아가 기른 새로운 품종의 꽃들을 이상하다고 생각하지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490317,
					"content": "페이몬은 코슨제니아의 원예업을 정말 많이 신경 써주네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "당연하지! 난 코슨제니아의 원예 선생님이라구. 코슨제니아가 상을 타면 나에게도 명예로운 일이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
