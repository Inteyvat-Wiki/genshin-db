						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "흑흑흑… 소중한 꽃이 망가졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490202,
					"content": "정말 안타깝네…. 균열계 원형체 때문에 꽃들이 시든 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490203,
					"content": "…나, 나 이제부터 꽃들의 곁에서 단 한 발짝도 벗어나지 않겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490204,
					"content": "진정해, 코슨제니아. 우리 같이 방법을 생각해 보자! 그러고 보니, 균열계 원형체는 왜 꽃밭을 파괴한 걸까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490205,
					"content": "코슨제니아, 다른 꽃을 들고 돌아왔을 때…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "그런 적 없어! 흥, 그 못된 녀석들은 날 무서워해서 내 뒤에서나 나쁜 짓을 꾸민다구! 짜증 나 죽겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "코슨제니아"
				},
				{
					"id": 740490208,
					"content": "와… 코슨제니아도 화낼 때가 있구나. 정말 꽃들을 소중히 여기는 모양이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490209,
					"content": "하지만 아까 코슨제니아가 접근했을 때는 균열계 원형체가 도망치지 않던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490210,
					"content": "균열계 원형체를 끌어 들인 건 꽃이 아닐 수도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "맞아, 그럴지도 모르겠네. 우리 꽃밭 주위를 조사해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740490206,
					"content": "…균열계 원형체에게 방해받은 적 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
