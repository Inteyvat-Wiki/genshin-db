			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "그 선인에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "오? 소를 이미 만났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030403,
					"content": "소가 기분이 좋나 보네. 사람을 다 만나고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030404,
					"content": "그게 「기분이 좋은」 거였구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10030405,
					"content": "그럼, 선인 만나기가 얼마나 어려운데. 평생 찾아다녀도 한 번 볼까 말까 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030406,
					"content": "바위의 신이 리월을 세울 때, 선인의 힘을 빌렸었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030407,
					"content": "하지만 선인들은 대부분 전투를 통해서만 리월을 지키려고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030408,
					"content": "그래서 결국 수천 년 동안 무역의 도시를 움직인 건 인간이었고, 선인은 먼 곳에 은거했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030409,
					"content": "주인아줌마는 정말 많은 걸 알고 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10030410,
					"content": "「주인아줌마」가 아니고 「사장님」이야——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030411,
					"content": "아무튼, 너희는 선인과의 인연이 깊어 보이니 일이 쉽게 풀리겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030412,
					"content": "조언을 해달라면… 음, 사실 소를 기쁘게 해주면 되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030413,
					"content": "기쁘게…? 「호법야차」님이 기뻐하는 모습은 상상이 안 되네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10030414,
					"content": "후후, 기대되지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030415,
					"content": "(사실 나도 그가 웃는 걸 본 적 없단다…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030416,
					"content": "이렇게 하자. 일단 주방장을 찾아가서 행인두부와 네가 자신 있는 요리를 준비해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030417,
					"content": "행인두부는 인간의 음식 중에서 소가 드물게 좋아하는 거야. 네가 자신 있는 요리는 실력 발휘를 잘 해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 10030418,
					"content": "#음, 실력 발휘라…. {NICKNAME}, 너의 제일 자신 있는 요리가 뭐였지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10030419,
					"content": "「만족 샐러드」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "실패할 확률이 낮은 요리네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10030423,
					"content": "하지만 선인에게 줄 요리니 좀 보수적인 게 낫겠지. 「만족 샐러드」가 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10030421,
					"content": "「홍련 마라 슬라임」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "와, 신기한 이름이네. 먹어보고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "페이몬"
				}
			]
		},
