				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "이럴 수가… 이미 「불퇴」의 경지에 올랐거늘 어찌하여 이렇게까지 약해진 것이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650202,
					"content": "원시 모태 바다에 대한 장악력도 완전히 잃어버렸군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650203,
					"content": "어째서, 어째서 이렇게 된 것이냐? 너희는 어찌, 어찌 이러는 것이냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650204,
					"content": "신세계가 탄생하지 못하면 모든 사람이 알껍데기의 꿈속에서 죽게 될 것이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650205,
					"content": "너야말로 빨리 꿈에서 깨지 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741650206,
					"content": "세계의 종말 같은 일은 당연히 전 세계 사람들이 함께 해결해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741650207,
					"content": "알겠다. 내 편에 서지 않은 성검이 원인이로구나. 성검을 휘두를 때마다 내 주변에 모여있는 중생의 의지를 베어낼 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650208,
					"content": "결국 내 나약한 인간성——나의 인격이 내 몸으로 돌아왔나니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650209,
					"content": "모태 바다는 그렇게 빨리 범람하지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "난 이미 「세계식」에 최초로 입력한 수치가 변했다는 걸 알아차렸다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650211,
					"content": "누군가는 생명의 힘을 장악했고, 또 다른 누군가는 짐승의 나라를 개척했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650212,
					"content": "그리고 또 하나의 「변수」가 바로 너로구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650213,
					"content": "모든 걸 삼킬 고래의 패배를 지켜보게 될 자, 모든 것의 증인",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650214,
					"content": "그렇군, 그렇게 된 거였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650221,
					"content": "나 역시 그런 꿈을 꾸었다. 너 같은 존재가 되는 꿈을 말이다. 그러나 그 꿈은 방금 깨져 버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650222,
					"content": "내가 한 모든 일은 의미를 잃었으니 허무한 꿈이로구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650223,
					"content": "아니, 꿈보다도 못하도다. 적어도 꿈은 무해하니 말이다. 난… 아니 너희와 그들은 이 때문에 너무 많은 대가를 치렀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650224,
					"content": "나르치센크로이츠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "안"
				},
				{
					"id": 741650225,
					"content": "아, 네가 있었군. 미처 알아차리지 못했다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650226,
					"content": "넌 내가 누구인지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "안"
				},
				{
					"id": 741650227,
					"content": "이름은 단지 호칭일 뿐. 네 영혼에 섞인 두 가지 색깔은 내게 너무도 익숙하노라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650228,
					"content": "릴리스 원장은 무슨 일이 일어난 줄도 모르고 아직 숨이 붙어 있는 마리안을 품에 안았다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650229,
					"content": "너무나도 복잡한 현재와 미래를 이해할 수 없었던 릴리스 원장은 과거를 붙잡고 싶은 마음에 유일하게 할 수 있는 일을 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650230,
					"content": "내 이름은 안이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "안"
				},
				{
					"id": 741650231,
					"content": "그래, 만나서 반갑군, 안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650232,
					"content": "난 널 용서하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "안"
				},
				{
					"id": 741650233,
					"content": "이상한 소리를 하는구나. 애초에 나의 계획에는 숭고하고 신성한 목적뿐이었고 사적인 감정은 없었느니라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650234,
					"content": "그 누구도 나를 평가하거나 심판할 수 없으며 용서할 수도 없노라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650235,
					"content": "네 목적은 숭고할지 몰라도 네 광기는 많은 사람을 해쳤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "안"
				},
				{
					"id": 741650236,
					"content": "심지어 넌 계산식도 잘못 입력했잖아. 잘못을 했으니 용서를 받는 게 이상해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "안"
				},
				{
					"id": 741650237,
					"content": "…네 말이 맞다. 미안하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650238,
					"content": "나르치센크로이츠, 우리랑 같이 돌아가자. 넌 다른 사람도 만나야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "안"
				},
				{
					"id": 741650239,
					"content": "이제 이 녀석이랑 말이 좀 통하는 것 같지만 그런 요구는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741650240,
					"content": "좋다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650241,
					"content": "엥? 보통은 속으로 고민하다가 우리가 한참 동안 설득하는 전개여야 하지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741650242,
					"content": "앞서 말했듯이 내겐 아무런 죄가 없다고 생각한다. 공들인 일이 무너졌지만 세계는 이미 구원받았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650243,
					"content": "얼마든지 질책하고 조롱하거라. 나의 마음은 이미 텅 비었고 한 가지 갈망만이 남아 있으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650244,
					"content": "그게 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741650245,
					"content": "맨처음으로 돌아가고 싶구나. 수선화의 용자가 아직 여정에 오르지 않았던 그때로 말이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650246,
					"content": "하지만 그건 불가능하지. 운명을 결정하는 건 결국 자기 자신이 아니다. 지금은 원하는 꿈을 꿀 힘조차 잃어버렸구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650247,
					"content": "#그럼 {NICKNAME} 기사님, 준비가 끝나시면 다시 모태 바다를 봉인하고 이곳을 떠나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안"
				},
				{
					"id": 741650215,
					"content": "그 고래는 이미 쓰러트렸어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "「변수」가 강림해서 최초로 「세계식」을 입력한 값에 변화가 생겼단 것을 알아차려야 했거늘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650217,
					"content": "우주 밖에서 온 것들이 전부 다 「강림」이나 「변수」라 불리는 건 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650218,
					"content": "내가 하나의 「변수」를 놓쳤구나. 바로 너 말이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650219,
					"content": "모든 것의 증인, 모든 것의 기록자, 모든 것의 설계자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "나르치센크로이츠"
				},
				{
					"id": 741650220,
					"content": "오직 하나의 세계와 동등한 가치를 지닌 자만이 그 칭호를 감당할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "나르치센크로이츠"
				}
			]
		},
