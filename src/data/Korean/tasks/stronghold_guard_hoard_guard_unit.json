	"talks": [
		{
			"id": 7668001,
			"completionStepIds": [
				7668001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7668001",
							"2"
						],
						"stepId": 7668001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
