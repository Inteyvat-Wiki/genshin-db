			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"청정",
					"양팡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766800101,
					"content": "#오, {NICKNAME}, 페이몬! 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800102
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800102,
					"content": "만난 김에 내 족제비 한 번 볼래? 이름은 양{RUBY#[D]양파 꼬리}팡이야, 엄청 귀엽지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800103
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800103,
					"content": "…야옹?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800104
					],
					"speakerTitle": "양팡"
				},
				{
					"id": 766800104,
					"content": "양팡아, 그렇게 울면 안 되지! 이 두 사람은 아슈르 선생님의 언어를 모를 거라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800105
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800105,
					"content": "…짹?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800106
					],
					"speakerTitle": "양팡"
				},
				{
					"id": 766800106,
					"content": "참새 말을 써도 안 돼. 바히마 씨는 수메르로 돌아가서 요양 중이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800107
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800107,
					"content": "미안, 우리 양팡이가 다른 동물이랑 너무 많이 소통하다 보니, 자기 언어를 까먹은 것 같네. 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800108
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800108,
					"content": "일단 좀 쉬게 하는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800109,
						766800110
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800109,
					"content": "당신도 동물 전문가인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				},
				{
					"id": 766800111,
					"content": "음… 왜 이렇게 친한 척해? 설마… 우리에 대해 뒷조사라도 한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766800112,
					"content": "진정해, 난 너희랑 한편이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800113
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800113,
					"content": "난 야란 사장님 밑에서 일하고 있고, 너희는 야란 사장님한테 제일 중요한 손님들이잖아. 우리 사이가 얼마나 끈끈한지는 더 말 안 해도 되지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800114,
						766800115
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800114,
					"content": "그럼 확실히 같은 편이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800116,
					"content": "에이, 진작 말하지! 괜히 긴장했잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766800117,
					"content": "그나저나, 양팡이랑 이런 황량한 곳에 가만히 서서 뭐 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766800118,
					"content": "대문을 지키는 중이야… 정확히 말하면, 내 「문지기 군단」이 제대로 일하는지 테스트 중이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800119,
						766800120
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800119,
					"content": "문지기요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800121,
					"content": "같은 편이니까, 살짝 알려줄게——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800122
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800122,
					"content": "이 지하에 내 물자 거점이 하나 있는데, 요즘 마물들이 자꾸 들락날락하면서 대문을 부수려 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800123
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800123,
					"content": "그래서 거금을 들여 뚝딱뚝딱 크룸카케 공방의 천재 엔지니어에게 문을 지키는 장치 군단을 만들어 달라고 의뢰했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800124
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800124,
					"content": "크흠, 정확히 말하자면 보안 시스템이야. 배치 장소를 자유롭게 고를 수 있고, 여러 기능을 조합해서 쓸 수 있는 방어 체계지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800125
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800125,
					"content": "마침 운이 좋았어. 그 천재 엔지니어가 곧 열릴 전시회에 출품할 모델의 사전 검증 버전을 나한테 팔아줬거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800126
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800126,
					"content": "그래서 거점 앞에 복합 방어선을 하나 깔아 두고, 쥐덫… 아니, 마물덫에 걸려들게 만드는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800127
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800127,
					"content": "이러면 거점을 지키는 여러 방안을 시험해 볼 수도 있고, 그 엔지니어한테 줄 데이터도 잔뜩 모을 수 있으니, 말 그대로 일석이조야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800128,
						766800129
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800128,
					"content": "아이노의 걸작을 손에 넣으셨군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800130,
					"content": "한번 해볼래? 나도 이걸로 마물을 여럿 처리해 봤는데, 스트레스가 확 풀리더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800131
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800131,
					"content": "너희도 스트레스 풀고, 난 겸사겸사 너희 생각을 참고하는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800132
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800132,
					"content": "물론, 보수는 섭섭지 않게 줄게. 우리는 같은 편이니 일반 고문보다 두 배는 줘야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800133,
						766800134
					],
					"speakerTitle": "청정"
				},
				{
					"id": 766800133,
					"content": "맞아요. 같은 편인데 더 주셔야죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800135,
					"content": "음… 으흠! 널 도와주면 야란을 돕는 셈이기도 하니깐, 모두에게 다 좋은 일이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766800136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766800136,
					"content": "그럼 경험이 풍부한 우리가 실력을 보여줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766800134,
					"content": "이거 참, 쑥스럽네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800135
					]
				},
				{
					"id": 766800129,
					"content": "듣기만 해도 꽤 재미있어 보여요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800130
					]
				},
				{
					"id": 766800120,
					"content": "군단이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800121
					]
				},
				{
					"id": 766800115,
					"content": "야란의 친구는 곧 우리의 친구니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800116
					]
				},
				{
					"id": 766800110,
					"content": "당신도 동물 친구인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766800111
					]
				}
			]
		}
	]
}