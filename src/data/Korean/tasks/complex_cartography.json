	],
	"talks": [
		{
			"id": 7352501,
			"completionStepIds": [
				7352501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352501",
							"2"
						],
						"stepId": 7352501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"패후"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735250101,
					"content": "하아, 이번에도 란 누님한테 민폐가 되고 말았네…. 하지만 어쩌겠어? 그 많은 일을 나 혼자 처리해야 한다는 것 자체가 무리인걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250102
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250102,
					"content": "지도 제출 기한을 또 미루는 수밖에 없겠어. 이러다 계약금보다 수메르에서 쓴 생활비가 더 많아지게 생겼네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250103
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250103,
					"content": "제, 제일 무서운 건 역시 란 누님이 화내는 거지만…. 어휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250104
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250104,
					"content": "어라, 여기 웬 리월 모험가가 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250105,
					"content": "이봐, 모험가 길드원!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250106,
					"content": "응? 왜 그래, 강가에서 쉬면 안 되는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250107
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250107,
					"content": "아니, 그게 아니라 그냥 궁금해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250108,
					"content": "리월의 모험가가 수메르에 있는 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250109
					]
				},
				{
					"id": 735250109,
					"content": "정말 드문 일이잖아. 게다가 근심 가득한 얼굴이길래, 우리가 도와줄 게 있나 싶었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250110,
					"content": "그렇구나, 내 이름은 패후야. 너희들은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250111
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250111,
					"content": "#난 페이몬, 얜 {NICKNAME}! 그래서 수메르에는 어쩐 일이야? 설마… 길을 잃은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250112,
					"content": "아하하, 이름이… 페이몬? 게다가 길을 잃었다니, 아하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250113
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250113,
					"content": "뭐가 그렇게 웃겨?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250114,
						735250115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250114,
					"content": "그럭저럭 웃기긴 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250116
					]
				},
				{
					"id": 735250116,
					"content": "…일반적인 상황이라면 웃길 일은 아니겠지만, 지도 제작자한테 길을 잃었냐는 질문은 좀 웃기잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250117
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250117,
					"content": "지, 지도 제작자?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250118,
					"content": "응, 옛날 지도를 보며 달라진 게 없는지 확인하는 게 내 일이야…. 모험가 길드의 업무이기도 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250119
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250119,
					"content": "안타까운 건, 내가 지도 제작자긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250120
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250120,
					"content": "한데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250121,
					"content": "아직 실습생이라 간단한 지도 제작도 제대로 못 해서 실수가 잦다는 거야. 다시 말해, 나무들에 가려진 골짜기나 지하 통로는 내가 직접 가서 조사해야 한다는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250122
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250122,
					"content": "하아, 힘들어 죽겠어. 수메르는 지형이 복잡하고 통로와 산굴이 참 많다니까. 어쩔 땐 산이 통째로 비어 있는 게 아닐까 싶은 생각까지 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250123
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250123,
					"content": "이렇게 느려서야… 어휴, 내가 현지인처럼 이곳 지형에 밝은 것도 아니고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250124
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250124,
					"content": "응? 그럼 지도 제작을 수메르 현지 모험가에게 맡기면 되잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250125,
					"content": "그게… 실은 이게 수메르와 리월 모험가 길드 지부의 협력 프로젝트거든. 두 지역을 오가는 상인과 모험가가 사용할 수 있는 지도를 제작하자는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250126
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250126,
					"content": "리월 모험가에게 맡긴 건… 원래 프로젝트를 담당하기로 했던 선배가 노련하고 믿을 만한 지도 제작자였기 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250127
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250127,
					"content": "그 선배는 교영 마을에서도 비슷한 일을 했는데, 아무리 복잡한 지형이라도 한 번 쓱 훑어보면 지도를 정확하게 제작해냈대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250128
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250128,
					"content": "하지만 그 후에 광구로 갔다고 했어. 아, 층암거연이랬나 흑암 공장이랬나… 기억이 가물가물하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250129
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250129,
					"content": "어쨌든 선배의 지도를 본 다른 제작자들은 자신의 실력을 부끄러워했고, 모험가들은 칭찬을 아끼지 않았대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250130
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250130,
					"content": "난 안 될 거야…. 제작을 마치긴 했지만 빠진 곳이 너무 많아. 다시 확인하자니 시간이 너무 오래 걸릴 것 같고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250131
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250131,
					"content": "어휴, 아무래도 낯선 곳이라 수메르 모험가 길드의 도움이 있어도 효율이 떨어진달까. 이러다간 미리 받은 계약금까지 경비로 쓰게 생겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250132
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250132,
					"content": "앗, 너무 불쌍하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250133,
					"content": "하지만 우린 지도를 제작할 줄 몰라… 맛있는 게 어딨는지 표시하는 일이라면 자신 있지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250134,
					"content": "하하, 좋은 생각인데? 다음에 미식 지도를 그리면 다들 좋아해 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250135
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250135,
					"content": "그런데… 지금 필요한 건 제작이 아니라 확인 작업이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250136
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250136,
					"content": "주변 지형이 험난한 탓에 아직 확인하지 못한 위험 지역이 몇 곳 남아있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250137
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250137,
					"content": "음, 그런 거라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250138,
					"content": "그렇게 어려울 것 같지 않은데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250139
					]
				},
				{
					"id": 735250139,
					"content": "응, 어쩌면 우리가 도와줄 수 있겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250140,
					"content": "…하지만 위험 지역은 생각보다 더 위험한 데다, 마물이 도사리고 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250141
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250141,
					"content": "그럴수록 더더욱 우리한테 맡겨야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250142,
					"content": "저, 정말? 너희가 도와준다면 확인 작업을 금방 마칠 수 있을 것 같아. 그럼 지도도 기한 내에 제출할 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250143
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250143,
					"content": "더 중요한 건 오가는 여행자들에게 새로운 지도를 줘서, 오래된 지도 때문에 인적 드문 위험 지역에 가는 일이 없도록 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250144
					],
					"speakerTitle": "패후"
				},
				{
					"id": 735250144,
					"content": "응, 그런데… 헤헤… 도와주는 대신 조건이 있어. 미식 지도가 완성되면 우리한테도 꼭 하나 줘야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735250145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735250145,
					"content": "하하하, 물론이지…. 하지만 그것도 이 일이 끝나야 제작할 수 있어. 그러니까 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "패후"
				},
				{
					"id": 735250115,
					"content": "5점 만점에 3점이랄까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735250116
					]
				}
			]
		}
	]
}