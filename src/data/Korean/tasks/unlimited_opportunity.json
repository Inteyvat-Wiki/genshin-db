			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "다른 사람들도 같은 생각일걸요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "맞아. 그러니까 우리가 먼저 가 있어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310303,
					"content": "여행자, 너만 괜찮다면 바로 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310304,
					"content": "여기서 이렇게 시간 낭비하고 있을수록 벌 수 있는 모라가 줄어드는 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310305,
					"content": "…끄응… 이래선 그를 설득할 수 없겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411310306,
					"content": "돈벌이가 안 된다거나… 운석이 정말 위험하다는 걸 그에게 알려줄 수만 있다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
