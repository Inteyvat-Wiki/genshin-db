			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이바노비치"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "흠… 좋아, 이걸로 크게 한몫 챙길 수 있겠군. 근데 한가지 문제가 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310102,
					"content": "무슨 문제요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "음? 아… 여행자구나. 마침 잘 왔어! 그… 재밌는 걸 해보지 않을래…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310107,
					"content": "신비롭고… 위대하고… 대박 날 수 있는 전대미문의 비즈니스랄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310108,
					"content": "네가 날 조금만 도와주면, 우리 둘 다 떼돈 벌 수 있다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310104,
					"content": "북국 은행이 얼마나 경비가 삼엄한데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "아, 당연하지. 경비병도 다 스네즈나야 사람이고…. 엥? 아니, 대체 뭘 상상한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310106,
					"content": "세계 각지를 여행해서 그런지 상상력이 정말 풍부하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310112,
					"content": "근데 이번 사업 계획은 틀림없이 성공할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310113,
					"content": "하늘에서 운석이 떨어진 건 너도 봤지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310114,
					"content": "난 운석을 찾은 뒤 거기서 몇 조각 떼어올 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310115,
					"content": "그런 다음 솜씨 좋은 장인한테 맡겨 장신구로 만들면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310116,
					"content": "생각해봐 운석으로 만든 장신구라고…. 반지, 목걸이, 팔찌, 귀걸이…. 어떤 걸로 만들어도 부자들한테 좋은 가격에 팔 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310117,
					"content": "여행자, 네가 할 일은 간단해. 몬스터들이 날 방해하지 못하도록 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310118,
					"content": "어때? 거래할래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310119,
					"content": "운석에 가까이 가면 안 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "뭐? 대체 왜? 이런 큰돈 벌 기회는 절대 포기 못 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310109,
					"content": "리월 법전에서 새로 발견한 거라도 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "음, 솔직히 리월의 법전은 상당히 엄격해서 거의 빈틈이 없지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 411310111,
					"content": "으, 아니 아니! 난 불법적인 일은 절대 안 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "이바노비치"
				}
			]
		},
