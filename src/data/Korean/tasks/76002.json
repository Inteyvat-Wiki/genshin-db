			"dialogs": [
				{
					"id": 760020701,
					"content": "헤헤, 전부 몰아냈다! 보물 사냥단 녀석들이 감히 우릴 싸움꾼으로 부리려 하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020702,
						760020704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760020702,
					"content": "악은 정의를 이길 수 없어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760020703
					]
				},
				{
					"id": 760020703,
					"content": "맞아, 맞아! 음, 그러고 보니 대체 저들이 노리던 물건은 뭐였을까?",
					"roleType": "TALK_ROLE_NPC",
