			},
			"dialogs": [
				{
					"id": 721280102,
					"content": "어, 잠깐, 그 상자는 막 열면 안 된다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280103,
					"content": "이 상자 당신 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "그, 이 상자들 모두 다 내가 여기 둔 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280106,
					"content": "내가 특별히 수집한 각종의 보물들이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280107,
					"content": "보물상자를 열고 싶다고? 안 되는 건 아니지만… 성의를 좀 보여줘야겠는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280108,
					"content": "모라를 드려야 해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "하하하, 모라는 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280111,
					"content": "내가 원하는 건 「소라」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280112,
					"content": "바닷가 근처에서 찾아보면 이런 소라가 많이 보일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280113,
					"content": "보물상자를 열어서 안에 보물을 갖고 싶으면 소라를 가지고 와서 나랑 교환하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280114,
					"content": "근데… 안에 뭐가 들었는지 어떤 보물을 가질 수 있는지는 알려줄 수 없어. 너의 운에 맡겨 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280115,
					"content": "어때, 보물상자를 열고 싶으면 소라를 가지고 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타카시"
				},
				{
					"id": 721280110,
					"content": "무슨 물건이 필요한데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "안에 뭐가 있는데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
