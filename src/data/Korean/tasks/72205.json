			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"키토",
					"키나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "또 만났네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050502,
					"content": "또 만났네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050503,
					"content": "안녕!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "#헤헤, 응! 근데 {F#누나}{M#형아}, 이 큰 바위들은 어디에 쓰는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050506,
					"content": "후후, 키토 오라버니는 모르는 게 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050507,
					"content": "모르겠는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "마타 할아버지 말로는, 이건 망령들을 불러들이는 묘비라고 했어… 죽어서 길을 잃어버리고, 떠도는 망령들이 이 묘비에 이끌려, 이곳에서 꿈에서 깨어난대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050510,
					"content": "그러고는 섬 곳곳을 돌아다니며… 그들의 소원을 들어줄 사람들을 찾아다닌다고 했어. 그 사람을 찾으면… 뱃사공한테 잡혀가기 전까지, 소원을 들어줄 때까지 쫓아다닌대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050511,
					"content": "그들 중에는 좋은 망령도 있고, 나쁜 악령도 있다고 했어요… 그러니까 늦은 밤 안갯속을 지나가려면, 꼭 이런 바위 앞에서 자기의 이름을 말해야 한다고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050512,
					"content": "그들의 조상이 누구인지 아는 사람들은 떠돌이 영혼보다 훨씬 자신감을 가질 수 있어. 그리고 영혼들은 산 사람이 어디서 왔는지 듣게 되면 더 이상 괴롭히지 않고 조용히 떠난다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050513,
					"content": "#아쉽게도 {F#누나}{M#형아}는 외부인이라… 자신의 이름을 말해도 효과가 있을지는 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050514,
					"content": "#음… 만약 악령이 오면 {F#언니}{M#오빠}는 어떡하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050515,
					"content": "헤헤, 괜찮아. 걱정 안 해도 돼, 내가 지켜줄 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050516,
					"content": "키나도 도와줄게, 같이 악령을 쫓아내는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키나"
				},
				{
