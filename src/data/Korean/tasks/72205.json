			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"키토",
					"키나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#안녕, {F#누나}{M#형아}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050302,
					"content": "안녕",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "저번에 꽃을 구해줘서 정말 고마워! 근데… 계속 이상한 기분이 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050305,
					"content": "나도 고마워. 근데 뭔가 이상해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050306,
					"content": "어디를 가든 안 좋은 일만 생기고… 다른 사람들은 내가 하는 말이 안 들리는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050307,
					"content": "게다가, 예쁜 꽃을 따서 주머니에 넣어두면 바로 사라져버려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050308,
					"content": "그건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "그래…? 난 잘 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050311,
					"content": "떠난다고…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050312,
					"content": "그 황금색 아저씨도 비슷한 말을 한 적이 있는데… 근데 우린 아직 떠나면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050313,
					"content": "우나 할머니에게 예쁜 꽃들을 보여줘야 한단 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키나"
				},
				{
					"id": 722050309,
					"content": "이제 떠날 때가 되어서 그런 거 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "기운이 넘쳐 보이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
