	"talks": [
		{
			"id": 7220501,
			"completionStepIds": [
				7220501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220501",
							"2"
						],
						"stepId": 7220501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"키토",
					"키나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "음, 이상하네… 분명 주머니에 있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050102,
					"content": "안녕",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "없어지면 안 되는데… 우나 할머니한테 가져다줘야 한다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050105,
					"content": "우나 할머니는 나이가 많아서 기억력이 많이 안 좋아졌어… 요즘에는 또 젊을 때 이야기를 하시고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050106,
					"content": "할머니는 항상 「꽃」만 찾아… 안개바다 밖에서 온 색이 엄청 예쁜 꽃이라고 하면서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050107,
					"content": "전에 꿈을 꿨는데… 섬에 있던 안개가 「휙」하고 사라지고, 바다 건너편에 갑자기 엄청나게 크고 아름다운 집이 하나 나타났어… 나무로 만든 것도, 금으로 만든 것도 아니었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050108,
					"content": "나도, 나도 그 꿈을 꿨어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050109,
					"content": "꿈속에서, 난 높은 산을 타고, 큰 나무에 올라, 예쁜 꽃들을 엄청 엄청 많이 땄어… 본 적은 없지만, 본능적으로 그게 우나 할머니가 말한 꽃이란 걸 깨달았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050110,
					"content": "하지만 꽃이 너무 무거워서, 나무에서 떨어졌고, 계속 떨어지고 떨어지다가… 꿈에서 깨어났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "키토"
				},
				{
					"id": 722050111,
					"content": "흥, 너무 욕심부려서 그런 거잖아! 내가 계속 충분하다고 했는데! 나까지 떨어졌다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "키나"
				},
				{
					"id": 722050112,
					"content": "주머니를 뒤져봐도… 아무것도 없었어… 할머니 얼굴을 볼 낯이 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키토"
				},
				{
					"id": 722050103,
					"content": "도움이 필요하니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
