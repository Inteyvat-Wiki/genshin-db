			"dialogs": [
				{
					"id": 718210301,
					"content": "수거할 만한 소등이 있었나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "홍우"
				},
				{
					"id": 718210302,
					"content": "3개 수거해왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "감사합니다. 거기 있는 소등은 수거하기가 너무 번거로워요. 갈 때마다 얼마나 힘든지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "홍우"
				},
				{
					"id": 718210304,
					"content": "도와주신 덕분에 좀 편하네요. 참, 이건 보수예요, 고생 많았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "홍우"
				}
			]
		},
