				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "어떻게 이럴 수가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "쾌권 아릉"
				},
				{
					"id": 718210202,
					"content": "여기서 뭐 해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "난… 휴, 사실 사부님께서 최근 새로운 발차기 기술을 개발하셨거든. 엄청 강해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "쾌권 아릉"
				},
				{
					"id": 718210204,
					"content": "근데 난 마음가짐이 부족하고 기본기도 엉망이라 그 발차기 기술을 전수해주지 않으시겠대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "쾌권 아릉"
				},
				{
					"id": 718210205,
					"content": "그래도 해등절이니까 사부님께 마음을 담아 소등을 드리려고. 그럼 기분이 좋아지셔서 마음이 바뀔 수도 있지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "쾌권 아릉"
				},
				{
					"id": 718210206,
					"content": "근데 도저히 부유석을 못 찾겠어서 구석에 끼인 소등의 부유석을 가져오려고 했더니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "쾌권 아릉"
				},
				{
					"id": 718210207,
					"content": "결국 이렇게 됐지…. 휴, 역시 소등은 그냥 자네한테 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "쾌권 아릉"
				},
				{
					"id": 718210208,
					"content": "마물 따위에 이렇게 당하다니. 역시 기본기가 아직 부족해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쾌권 아릉"
				}
			]
		},
