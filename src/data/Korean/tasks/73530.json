					}
				]
			},
			"dialogs": [
				{
					"id": 735300101,
					"content": "하하… 흑흑… 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300102
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300102,
					"content": "#{NICKNAME}, 봐봐. 여기에 울면서 웃는 녀석이 있어…. 어? 어딘가 낯익은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300103,
					"content": "아! 오랜만이야. 혹시 나 기억 나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300104,
						735300106
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300104,
					"content": "당신은?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300105
					]
				},
				{
					"id": 735300105,
					"content": "나야, 나! 생론파 학자 쟈미, 「파이즈 포션」을 제조한 사람!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300108,
					"content": "오, 어렴풋이 기억나는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300109,
					"content": "어때, 요즘 연구는 잘 되어가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300110,
					"content": "하하… 그건… 으흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300111
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300111,
					"content": "별로 순조롭지 않나 보네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300112
					]
				},
				{
					"id": 735300112,
					"content": "아, 아니야. 너희 덕분에 파이즈 포션의 연구는 상당히 훌륭한 성과를 거두었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300113
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300113,
					"content": "교수님의 기대를 저버릴까 봐 걱정했는데, 내 보고서를 보시고는 크게 칭찬해주셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300114
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300114,
					"content": "「아주 잘했네, 쟈미. 자넨 역시 내 가장 자랑스러운 제자야!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300115
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300115,
					"content": "그럼 잘된 거 아니야? 축하해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300116,
					"content": "여기까지라면 좋았겠지만… 휴, 그 뒤에 발생한 일은 영락없는 악몽이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300117
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300117,
					"content": "무슨 일이 있었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300118
					]
				},
				{
					"id": 735300118,
					"content": "지난번 실험 데이터가 잘 나와서 그랬는지, 교수님——그러니까 웃으면 주름이 자글자글한 그 영감이 「직접 실험해 볼」 생각을 한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300119
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300119,
					"content": "그래서 내가 실험 장소를 마련하고, 가장 효과가 좋은 파이즈 포션을 만들어줬는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300120
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300120,
					"content": "그랬는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300121,
					"content": "이걸 정말 뭐라 할지… 교수님은 수많은 학생이 지켜보는 가운데 마물 앞에서 파이즈 포션을 벌컥벌컥 들이켜시다 마물한테 기습을 당하고는, 눈 깜짝할 사이에 패배하셨어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300122
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300122,
					"content": "다행히 크게 다치진 않으셨어. 한동안 병상에 누워 계셔야 하지만 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300123
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300123,
					"content": "풉, 하하하!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300124,
					"content": "하하… 크흠. 어쨌든 내 실력이 부족해서 교수님 체면이 깎인 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300125
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300125,
					"content": "그 성질 나쁜 영감은 「이용자의 니즈를 고려하지 않았다」느니, 「실제 상황에 대한 인식이 부족하다」느니 하면서 날 호되게 혼냈지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300126
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300126,
					"content": "그건 너무 억지잖아. 자기 잘못도 있으면서!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300127,
					"content": "누가 아니래. 그래서… 너희한테 부탁이 있는데——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300128,
						735300129
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300128,
					"content": "교수를 혼내 달라고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300130,
					"content": "아니, 아니야! 그렇게 무서운 생각은 안 했어… 적어도 지금은!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300131
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300131,
					"content": "헤헤, 그럼 「예전」에는 했었단 말이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300132,
					"content": "으… 조금은… 하지만 그건 중요하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300133
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300133,
					"content": "난 지난번 실험을 다시 확인해 보고 「장기 지속형 파이즈 포션」을 만들어 냈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300134
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300134,
					"content": "장기 지속형 파이즈 포션? 그게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300135,
					"content": "교수님이 기습당했을 때를 떠올리다가 문득 든 생각인데, 우리 같은 일반인들은 위기가 찾아오면 아무 생각이 안 나고 몸이 뻣뻣하게 굳어버려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300136
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300136,
					"content": "게다가 위험 상황이 발생한 뒤에 파이즈 포션을 마셔봤자 바로 약효가 들지는 않잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300137
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300137,
					"content": "하지만 장기 지속형 파이즈 포션은 달라. 한번 마셔두면 위험 상황이 발생했을 때 자동으로 효능을 발휘하니까 일반인들에게 반응할 수 있는 시간을 벌어주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300138
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300138,
					"content": "「위험 상황」은 어떻게 판단하는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300139
					]
				},
				{
					"id": 735300139,
					"content": "장기 지속형 파이즈 포션을 마시면, 정상 활동을 할 때에는 그 효능이 발휘되지 않아. 하지만 내가 아까 말했지? 일반인은 위기가 닥치면 몸이 굳어버린다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300140
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300140,
					"content": "행동을 멈추고 제자리에 얼어붙으면, 장기 지속형 파이즈 포션이 효능을 발휘해서 그들의 「주관적인」 시간을 천천히 흐르게 하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300141
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300141,
					"content": "그렇구나, 대충 알아들었어. 그러니까… 우리한테 실험을 도와달라고 부탁하려던 거구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300142,
					"content": "맞아. 장기 지속형 파이즈 포션은 일반인을 위해 개발한 것이기는 하지만… 실험에는 어느 정도 리스크가 따르기 때문에 전투 경험이 있는 사람의 도움이 필요하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300143
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300143,
					"content": "음… 어떡할까, 도와줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300144,
					"content": "#갑자기 배가 고프네. 람바드 술집에 가서 거하게 한 끼 먹고 싶은데…. {NICKNAME}, 모라 얼마 남았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300145,
						735300146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300145,
					"content": "유감스럽게도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300147,
					"content": "크흠… 사실 교수님이 호되게 혼을 내시기는 했어도, 실험 경비는 넉넉하게 배정해 주셨거든. 그러니까 사례금은 걱정하지 않아도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300148
					],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300148,
					"content": "그렇다면 우리가 도와줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300149
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735300149,
					"content": "정말 고마워! 흑, 부탁이야… 산산조각난 내 학술적 명예를 회복시켜 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쟈미"
				},
				{
					"id": 735300146,
					"content": "이번 달은 이미 예산 초과야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300129,
					"content": "교수를 매수해 달라고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300106,
					"content": "한숨만 푹푹 쉬는 아카데미아 학자네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300107
					]
				},
				{
					"id": 735300107,
					"content": "그 별명 기억하고 있었구나. 맞아… 지도 교수님의 기대를 저버리고 한숨만 푹푹 쉬는 생론파 학자이자, 이제는 이름조차 밝히기 부끄러운 쟈미야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "쟈미"
				}
			]
		}
	]
}