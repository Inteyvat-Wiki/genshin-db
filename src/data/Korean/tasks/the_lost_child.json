			"dialogs": [
				{
					"id": 730030201,
					"content": "이오탐… 어떻게 이런 일이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030202,
					"content": "#흑흑, 라나 누나… 그리고 {M#형아}{F#누나}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "이오탐"
				},
				{
					"id": 730030203,
					"content": "어라? 이오탐이 어떻게… 죽음의 땅에 있는 거지… 마물도 너무 많은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730030204,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030205,
					"content": "여긴 저한테 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "안 돼… 시간이 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030208,
					"content": "#젠장… {NICKNAME}, 부탁해! 같이 싸우자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030209,
					"content": "이오탐, 꼼짝 말고 있어! 우리가 구해줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라나"
				},
				{
					"id": 730030206,
					"content": "저 초록색은 뭐죠…?",
					"roleType": "TALK_ROLE_PLAYER",
