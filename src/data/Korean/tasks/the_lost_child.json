				"points": []
			},
			"dialogs": [
				{
					"id": 730030301,
					"content": "하아… 하아… 이제 됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030302,
					"content": "라나 누나… 흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "이오탐"
				},
				{
					"id": 730030303,
					"content": "이오탐… 넌 사나이야, 울지 마. 누나가… 죽음의 땅에서 겪었던 걸… 아카데미아의 학자에게 알려주면… 죽음의 땅을 해결할 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030304,
					"content": "#그리고… 누나가 전투하는 모습 봤지… 아니… {NICKNAME} {M#형아}{F#누나}가 전투하는 모습 봤지? 고맙다고 말씀드려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030305,
					"content": "라나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730030306,
					"content": "말 그만하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "라나, 좀 쉬고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730030309,
					"content": "하… 하하… 조금 어지럽고 피곤하지만 괜찮아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030310,
					"content": "라나 누나… 미안해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "이오탐"
				},
				{
					"id": 730030311,
					"content": "무…무슨 소리야, 내 귀여운 호랑이, 울지 마! 너야말로 괜찮지? 이오탐… 어디 아픈 데 없어…? 조금 어지럽다든가 기운이 없다든가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730030312,
					"content": "나는 괜찮은데 라나 누나가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "이오탐"
				},
				{
					"id": 730030313,
					"content": "음! 괜찮아… 누나는 괜찮아. 누나는 수많은 전투를 겪은 베테랑 순찰관이잖아! 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라나"
				},
				{
					"id": 730030308,
					"content": "도와줄 사람을 찾아올게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
