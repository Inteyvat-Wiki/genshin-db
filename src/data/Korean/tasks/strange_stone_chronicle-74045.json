			},
			"dialogs": [
				{
					"id": 740450201,
					"content": "푸카, 우리 왔어! 네 증표도 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450202,
					"content": "찾아온 증표를 푸카에게 건넨다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "맞아, 이거야! 둘 다 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450204,
					"content": "그런데 우리가 증표를 찾다가 이런 것도 발견했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450205,
					"content": "한 번도 본 적 없는 광석이라 혹시 귀한 보석이 아닐까 싶어서 같이 들고 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450206,
					"content": "푸카가 전에 이 근처에서 예쁜 돌을 자주 줍는다고 했었잖아? 그럼 이런 것도 본 적 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450207,
					"content": "어디 보자… 확실히 예쁘기는 하네! 하지만… 귀한 건 아니고, 그냥 평범한 돌멩이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450208,
					"content": "다른 곳에는 이런 광석이 없을지 몰라도 이곳 광맥 근처에는 널리고 널렸어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450209,
					"content": "에이 뭐야, 그냥 평범한 돌멩이였잖아. 귀한 건 줄 알았더니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450210,
					"content": "달리 쓸데도 없으니 적당한 곳에 버리자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450211,
					"content": "하지만 바깥 사람들에겐 생소할지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "아, 그러니까 네 말은 바깥에 가져다 팔면 비싼 가격에 팔릴지도 모른다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450214,
					"content": "#확실히 바깥 사람들은 멜뤼진 마을에 광석을 캐러 온다는 건 상상도 못 할 거야. 이런 광석도 본 적 없을 거고…. 똑똑한데, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450215,
					"content": "이 돌을 폰타인성으로 가져가서 그곳 상인에게 한번 보여주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450216,
					"content": "응, 만약 광석에 대해 더 알고 싶다면 언제든지 날 찾아와…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450217,
					"content": "비록 난 언니와 달리 나만의 보석 공방도 없고, 보석 감정 같은 것도 잘 모르지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450218,
					"content": "귀한 보석보다는 각양각색의 흥미로운 돌을 모으는 걸 더 좋아해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450219,
					"content": "그래서 이 근처 광맥만큼은 내가 잘 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450220,
					"content": "응! 알겠어, 푸카",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450212,
					"content": "하지만 이곳에만 있는 거라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
