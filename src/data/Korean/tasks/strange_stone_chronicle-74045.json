			"dialogs": [
				{
					"id": 740450101,
					"content": "푸카, 여긴 또 왜 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450102,
					"content": "근처에 마물이 나타날 일은 이제 없겠지만, 다른 위험이 있을지도 모르니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450103,
					"content": "혼자선 함부로 돌아다니지 않는 게 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450104,
					"content": "#페이몬, {NICKNAME} {M#오빠}{F#언니}… 함부로 돌아다니는 거 아니야…. 난 내 「증표」를 찾으러 온 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450105,
					"content": "뭐? 「증표」를 잃어버렸어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450106,
					"content": "응… 전에 돌을 주웠던 곳에서 잃어버린 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450107,
					"content": "으음… 혹시 저번에 마수들한테 쫓길 때 실수로 떨어뜨린 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450108,
					"content": "흑흑… 맞는 것 같아…. 그땐 너무 무서워서 신경 쓸 겨를이 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450109,
					"content": "아직도 그때만 생각하면 무섭지만, 「증표」는 정말 소중한 거라 꼭 찾아야만 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450110,
					"content": "음… 하지만 푸카 혼자서 찾는 건 너무 위험해. 기왕 이렇게 된 거…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, 우리가 전에 갔던 그곳에 다시 가서 푸카의 「증표」를 찾아주자. 푸카는 집에 가서 기다리고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740450112,
					"content": "우리에게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#고마워! {NICKNAME} {M#오빠}{F#언니}, 페이몬! 난 얌전히 집에서 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450113,
					"content": "이 기회에 한번 둘러보는 것도 좋겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
