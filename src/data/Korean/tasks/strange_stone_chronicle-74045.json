			"dialogs": [
				{
					"id": 740450601,
					"content": "또 만났네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450602,
					"content": "광석에 대해 알고 싶은 거야? 얼마든지 물어봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450603,
					"content": "푸카라고 모든 걸 다 아는 건 아니지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450604,
					"content": "귀한 보석에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "이 근처 광맥에는 반짝이고 예쁜 돌이 많지만 진짜 보석하고는 좀 많이 달라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450606,
					"content": "나도 진짜 보석을 찾을 수 있다면, 슬루아시 언니처럼 나만의 보석 공방을 갖게 될지도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450607,
					"content": "광석의 용도에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "뭐? 푸카는 그런 거 생각해 본 적 없는데…. 난 그냥 예뻐서 다양한 돌을 모으는 것뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "푸카"
				},
				{
					"id": 740450609,
					"content": "따로 궁금한 건 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "헤헤, 푸카 보러 와줘서 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "푸카"
				}
			]
		}
	]
