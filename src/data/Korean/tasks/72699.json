			"dialogs": [
				{
					"id": 726990101,
					"content": "자네의 검술의 수준이 어떤지는 모르겠지만 정말 전투가 기대되는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990102,
					"content": "당신은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "사실, 네 명의 무사가 신청했다고 한 건 나도 포함해서 얘기한 것이라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990104,
					"content": "내가 이번 결투의 주최자긴 하나, 참여한 사람이 너무 적은지라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990105,
					"content": "게다가, 난 전투를 위해 태어난 몸일세. 강한 상대를 만나면 어찌 겨뤄보지 않을 수 있겠나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990106,
					"content": "하하, 꼭 한번 해보고 싶은 대사였네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990107,
					"content": "이봐, 대체 뭐 하자는 거냐구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726990108,
					"content": "방심은 금물이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "맞는 말이네! 상대가 누구든, 차별 없이 대하는 태도에 감탄했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990110,
					"content": "그때 내가 겉모습으로 사람을 판단하지 않았더라면, 얕잡아 보던 네 번째 무사한테 그렇게 형편없이 패하진 않았을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990111,
					"content": "#하지만 난 더 이상 그때의 내가 아니라네! 그럼, {NICKNAME}, 비무를 시작하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990114,
					"content": "오시죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "와라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스히코 타로"
				},
				{
					"id": 726990112,
					"content": "조금만 기다려주세요, 먼저 준비 좀 할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "알겠네, 먼저 준비하시게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스히코 타로"
				}
			]
		}
	]
