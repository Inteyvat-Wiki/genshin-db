			"dialogs": [
				{
					"id": 742490201,
					"content": "음! 여유로운 오후의 티타임은 아무리 즐겨도 질리지 않는다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 742490202,
					"content": "(조금 더 앉아있자)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 742490204,
					"content": "그래, 즐거운 시간은 참 금방 지나가 버리네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "푸리나"
				},
				{
					"id": 742490203,
					"content": "티타임을 슬슬 끝내야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "「산드로네」"
				}
