				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "큰일이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "형님이 또 체포됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000104,
					"content": "방금 텐료 봉행에서 축제를 중단시키겠다는 안내문을 게시판에 붙였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000105,
					"content": "잘은 모르겠지만, 형님이 천수각에까지 홍보용 전단지를 돌린 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000106,
					"content": "쇼군님도 분명 아라타키 천하제일 초호화 북 축제에 참여하고 싶어 하실 거라는 말까지 하신 모양이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000107,
					"content": "엥? 형님 말이 틀린 건 아니잖아. 나도 쇼군님이 축제에 참여하고 싶어 하실 거라고 생각하는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "아키라"
				},
				{
					"id": 725000108,
					"content": "맞아, 넌 그렇게 생각 안 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "겐타"
				},
				{
					"id": 725000109,
					"content": "어휴, 우리가 어떻게 생각하는지가 뭐가 중요해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000110,
					"content": "어쨌든 형님은 경비 서던 오쿠즈메한테 체포당해서 텐료 봉행에 보내지셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000111,
					"content": "그럼 어떡해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "시노부 누님이 수습하고 계실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000113,
					"content": "오쿠즈메는 형님을 군사 보호구역 난입 혐의로 체포했다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000114,
					"content": "근데 쿠죠 사라 님이 죄명을 공무 집행 방해죄로 바꿨대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000115,
					"content": "으아아아아, 괘씸한 쿠죠 텐구! 감히 우리 형님한테 이렇게 큰 죄명을 내리다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "겐타"
				},
				{
					"id": 725000116,
					"content": "야, 이 바보야! 처벌이 훨씬 가벼워진 거잖아. 이 정도는 그냥 봉행소에서 몇 마디 들으면 풀려난다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000117,
					"content": "축제는 형님이 풀려나셔야 어떻게 하든지 하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000118,
					"content": "여행자, 너무 걱정 마. 시노부 누님이 계시니까 별일 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000119,
					"content": "우리 축제에 신경 써줘서 고마워. 형님이 풀려나시면 직접 찾아와서 인사하실 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000120,
					"content": "네 여행도 우리 축제처럼 점점 더 잘 되길 바랄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "마모루"
				},
				{
					"id": 725000121,
					"content": "점점 잘 되길 바라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마모루"
				}
			]
		}
	]
}