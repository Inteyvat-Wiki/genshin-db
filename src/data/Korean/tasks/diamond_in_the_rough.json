						223050202
					],
					"speakerTitle": "석두"
				},
				{
					"id": 223050202,
					"content": "제가 대충 박석들을 분류해 놨습니다. 손님은 얼마짜리로 하실 건가요?",
					"roleType": "TALK_ROLE_NPC",
