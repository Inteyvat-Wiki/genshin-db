			"dialogs": [
				{
					"id": 200530201,
					"content": "어때? 뭔가 좋은 아이디어 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530202
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200530202,
					"content": "아니, 아직…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530203
					]
				},
				{
					"id": 200530203,
					"content": "음… 내가 전에 봤던 모험가들도 가끔 이렇더라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530204
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200530204,
					"content": "몬스터와 마주쳤을 땐 기민하게 대처하지만, 통나무를 때릴 땐 허둥대고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530205
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200530205,
					"content": "게다가 마치 자신이 쉽게 부술 수 있는 것처럼 각종 수단을 동원해서 통나무를 고정하더라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530206
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200530206,
					"content": "그렇게 도전하고 싶으면 바로 야외에 나가서 강력한 마물을 찾는 게 더 좋지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘린"
				}
			]
		},
