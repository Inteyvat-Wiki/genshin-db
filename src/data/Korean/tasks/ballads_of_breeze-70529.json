				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705290201,
					"content": "안녕! 윈드블룸 축제에 온 걸 환영해. 이쪽에서 「바람의 노래」를 즐겨 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290202
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290202,
					"content": "이 게임을 통해 몬드성의 음유시인들처럼 아름다운 선율을 연주할 수 있어~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290203,
						705290204
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290203,
					"content": "음유시인과 비교할 수 있을까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				},
				{
					"id": 705290205,
					"content": "걱정하지 마! 여러 사람에게… 그… 테스트해봤으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290206
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290206,
					"content": "악기 연주를 못하는 사람이라도, 한 곡 정도는… 음… 들어줄 만은 할 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290207
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290207,
					"content": "나를! 그리고 페보니우스 기사단을 믿어줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290208
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290208,
					"content": "집중해서 박자와 리듬만 따라가면 손쉽게 그럴듯한 곡을 연주할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290209
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290209,
					"content": "바람을 맞으며 음악을 연주하면… 고민거리를 날려 보낼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290210
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290210,
					"content": "그러면 음유시인들은 고민이 없겠네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290211
					]
				},
				{
					"id": 705290211,
					"content": "하하하, 그거야 모르지. 곡이 청중들의 지갑을 열게 할 정도로 좋은지 본능적으로 고민하는 사람들이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290212
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290212,
					"content": "하지만 넌… 즐기는 걸로 충분하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290213
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290213,
					"content": "크흠! 방금 얘기는… 못 들은 걸로 해줘! 게임 방법은 알지? 관심 있으면 한번 해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290214
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290214,
					"content": "자기 악기로 연주해도 되고, 악기가 없다면 대여도 가능해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290215
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290215,
					"content": "후후… 우리에겐 아주 많은 악기가 있지. 악기마다 손맛이 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290216
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290216,
					"content": "어떤 악기로 해볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290217,
						705290218,
						705290219
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290217,
					"content": "바람의 노래 하프",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290220,
					"content": "이 악기를 선택한 거야? 좋지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290221
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290221,
					"content": "아 참! 한 가지 더 있다! 잠깐만, 메모 좀 볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290222
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290222,
					"content": "음… 그… 손님분들이 좋은 곡을 연주할 수 있게 이번에 「악기 조율」 단계를 추가했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290223
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290223,
					"content": "한마디로 악기를 최상의 상태로 조율해준다는 거야…. 아주 간단해, 어디 보자, 일단…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290224
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290224,
					"content": "좋아! 조율은 끝났어. 연주하기 딱 좋은 상태야…. 악보도 준비됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290225
					],
					"speakerTitle": "리지"
				},
				{
					"id": 705290225,
					"content": "준비되면 바로 시작해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리지"
				},
				{
					"id": 705290218,
					"content": "거울꽃의 현악기",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290219,
					"content": "축제의 북",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290204,
					"content": "진짜 아름다운 곡을 연주할 수 있을까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				}
			]
		}
	]
}