						],
						"stepId": 2202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"오와다",
					"우에스기"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "오? 너는… 금발의 여행자구나. 아마노가 얘기한 적 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "오와다"
				},
				{
					"id": 220200302,
					"content": "왜, 나한테 볼일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "오와다"
				},
				{
					"id": 220200303,
					"content": "류지 씨가 보낸 선물이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "호오, 「벚꽃 모찌」잖아. 이건 아무렇게나 먹으면 안 돼. 명당자리에서 음미하면서 먹어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "오와다"
				},
				{
					"id": 220200305,
					"content": "우에스기, 잠시만 교대 좀 해줘. 나 찾는 사람이 있으면 좀 기다리라고 전해주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "오와다"
				},
				{
					"id": 220200306,
					"content": "오와다 씨, 지금은 근무 시간인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "우에스기"
				},
				{
					"id": 220200307,
					"content": "하하하, 괜찮아. 바람 좀 쐬러 가는 거니까 금방 돌아올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "오와다"
				},
				{
					"id": 220200308,
					"content": "휴… 알겠어요. 근데 빨리 돌아오셔야 해요. 높은 분들이 갑자기 방문하시면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "우에스기"
				},
				{
					"id": 220200309,
					"content": "걱정 마. 봉행소에서 얼마 전에 사건을 하나 해결했잖아. 오신다면 포상을 하러 오시는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "오와다"
				},
				{
					"id": 220200310,
					"content": "그럼 부탁할게, 우에스기",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "오와다"
				},
				{
					"id": 220200311,
					"content": "여행자, 같이 바람 쐬러 가자. 느긋하게 디저트를 즐길 수 있는 명당을 알고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오와다"
				}
			]
		},
