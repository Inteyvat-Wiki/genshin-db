			"trigger": {
				"objectNames": [
					"아마노",
					"안도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "오? 여행자, 여긴 어쩐 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200202,
					"content": "류지 씨가 보낸 선물이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "오? 어디 보자… 이건 「벚꽃 모찌」잖아. 류지 녀석, 예의 차리긴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200204,
					"content": "이봐, 안도, 경계 좀 풀어. 외국인이긴 하지만, 이 친구는 우릴 도와줬잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200205,
					"content": "그 녀석, 아직도 우리가 좋아하는 음식을 기억하고 있다니. 좀 감동인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200206,
					"content": "류지 씨와 같이 일한 적이 있으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "응? 류지가 말 안 했어? 잠깐이긴 하지만, 전에 같이 일했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200208,
					"content": "근데 무슨 이유인지 그 녀석은 어떤 사건에 휘말리게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200209,
					"content": "결국 산고 덕분에 진범을 잡고, 류지의 누명도 벗겨졌지만… 그 뒤로 류지는 봉행소를 떠나 산고 밑에서 일하게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200210,
					"content": "그 밖의 일들은 나도 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200211,
					"content": "됐어, 거기까지만 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "안도"
				},
				{
					"id": 220200212,
					"content": "흠, 하긴. 근데 류지 녀석, 산고 밑에서 일하는 게 여기보다 훨씬 꿀 빠는 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200213,
					"content": "할 수만 있다면, 나도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200214,
					"content": "너 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "안도"
				},
				{
					"id": 220200215,
					"content": "크흠! 그만할게. 고마워, 여행자. 디저트는 사양하지 않을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "아마노"
				},
				{
					"id": 220200216,
					"content": "류지와 산고에게 안부 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아마노"
				}
			]
		},
		{
			"id": 2202003,
			"completionStepIds": [
				2202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202003",
