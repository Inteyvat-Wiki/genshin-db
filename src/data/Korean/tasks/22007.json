			"dialogs": [
				{
					"id": 220070201,
					"content": "대체 어디에 떨어뜨린 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070202
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220070202,
					"content": "이런 상자에 담아도 되는 건가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "이봐, 자세히 봐봐. 안에 옷을 몇 겹씩이나 깔아뒀다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220070204,
					"content": "나 같은 전문적인 학자가 그런 실수를 할 리가 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220070205,
					"content": "그럼 유물은 부탁할게. 난 그런 몬스터들을 상대할 자신 없다구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보아"
				}
			]
		},
