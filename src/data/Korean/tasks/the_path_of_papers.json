				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "살려주세요! 제발 그만 때리세요! 이건 모두 오해라고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050502,
					"content": "오해가 아닐걸요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "엘라니에게 무슨 짓을 한 거야? 어서 사실대로 말해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731050504,
					"content": "아니면… 더 맞을 줄 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731050507,
					"content": "제, 제발 그것만은… 일단 제 말 좀 들어보세요. 이건 정말 오해랍니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050508,
					"content": "우리가 무슨 배짱이 있어 그 아가씨를 건드리겠어요. 얼마나 골치 아픈 아가씨였는데요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050509,
					"content": "무슨 뜻이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "먼저 제 말을 좀 들어보세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050512,
					"content": "얼마 전, 돈이 궁해진 우리 형제들은 누님을 따라 뭔가 돈 되는 일이 없을까 주변을 탐색하고 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050513,
					"content": "쳇! 또 돈을 빼앗거나 훔치는 짓을 하고 있었던 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731050514,
					"content": "그… 그거야 보물 사냥단이니 당연히 그런 일로 생계를 유지하는 거죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050515,
					"content": "야영지에서 계획을 꾸미고 있을 때, 갑자기 옆에서 어떤 아가씨가 큰 보따리 하나를 메고 야영지 쪽으로 걸어왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050516,
					"content": "혼이 나간 듯한 표정을 하고 있어서 우리도 보고 깜짝 놀랐죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050517,
					"content": "막 물건을 빼앗으려던 찰나, 그 아가씨가 모닥불 곁에 앉더라고요. 그러더니 눈물을 흘리면서 책을 전부 모닥불 속에 던져 태워버렸어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050518,
					"content": "형제들은 그걸 보고 겁에 질려 아무것도 할 수 없었죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050519,
					"content": "당신들도 겁에 질릴 때가 있군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "아이고, 우리가 보물 사냥단이긴 하지만 실제로 사람을 해친 적은 없다고요. 그래봤자 물건이나 좀 훔치고 보물이나 가져가는 수준이죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050522,
					"content": "우리가 무슨 반응을 하기도 전에, 그 아가씨는 모라가 든 주머니를 던지면서 자기를 가둬달라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050523,
					"content": "어? 어라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 731050524,
					"content": "이게 도대체 무슨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "처음에는… 아무도 감히 건드리려고 하지 않았죠. 하지만 아무것도 먹지 않으면서 계속 자기를 가둬달라는 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050527,
					"content": "결국 누님이 우리한테 나뭇가지 몇 개를 깎아 철장을 만들라고 했어요. 그리고 그 아가씨한테 그 안으로 들어가라고 했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050528,
					"content": "누님이라는 분 괜찮은 사람이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "우리 누님은 학식이 높은 사람을 존경해왔으니까요. 항상 기회가 있다면 자기도 학문을 배우고 싶다고 했죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050531,
					"content": "흠, 믿기 어려우면… 그 아가씨가 저쪽에 있으니 직접 가보세요. 분명 누님은 지금도 달래고 있을 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050532,
					"content": "만약 그 아가씨를 설득해 데려갈 수만 있다면, 우리가 두둑한 선물을 드릴게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "고블리"
				},
				{
					"id": 731050529,
					"content": "엘라니에게 꽤 잘해준 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "그래서 가뒀어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "당신들은 보물 사냥단이잖아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "역시 엘라니가 여기 있는 거군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "엘라니에게 대체 무슨 짓을 한 거죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "솔직히 말해! 아니면… 더 맞을 줄 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "페이몬"
				}
			]
		},
