	"talks": [
		{
			"id": 7370001,
			"completionStepIds": [
				7370001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
