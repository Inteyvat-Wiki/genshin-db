				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590201,
					"content": "지도를 보면… 리월항의 남쪽은 「흘호암」이지? 그 전설 속의 「단약 거장」은 아마 이 일대에서 지내고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590202
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590202,
					"content": "도착했어, 여기가 「흘호암」이야! 얼른 근처에서 찾아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7165903,
			"completionStepIds": [
				7165903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165903",
							"2"
						],
						"stepId": 7165903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"앵아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590301,
					"content": "드디어 제 생각이 나셨나 보네요? 게다가 친구분까지… 절 보러 일부러 오신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590302
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590302,
					"content": "윽, 조금 미안해지는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590303,
					"content": "사실… 앵아 씨, 우린 「단약 거장」을 만나러 온 거야. 혹시 그 장인을 알고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590304,
					"content": "어머, 역시 다른 이유가 있으셨군요? 조금 실망인데요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590305
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590305,
					"content": "하지만 제 비밀을 알아보고 다니시다니, 조금 놀랍기도 하고 기쁘기도 하네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590306,
						716590307
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590306,
					"content": "비밀이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				},
				{
					"id": 716590308,
					"content": "잠깐! 설마 앵아 씨가 「단약 거장」이었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590309,
					"content": "보면 볼수록 똑똑하네요, 정말 귀엽다니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590310
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590310,
					"content": "이런 결과일 줄은 생각지도 못했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590311,
					"content": "「단약 거장」이 이렇게 젊은 분이라니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590312
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590312,
					"content": "알베도 선생님이 주는 느낌과는 완전히 달라. 하지만 여전히 헤아릴 수 없는 심오한 분위기가 느껴져!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590313
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590313,
					"content": "다급한 표정을 보니, 어려움에 부딪힌 모양이네요. 괜찮다면 무슨 일인지 얘기하시겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590314
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590314,
					"content": "이유는 모르겠지만, 어쩐지 상황이 점점 예측할 수 없는 방향으로 흘러가고 있다는 예감이 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590315,
					"content": "데마로우스와 함께 앵아에게 「연기 단약」의 연구 과제에 대해 설명한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590316
					]
				},
				{
					"id": 716590316,
					"content": "그렇군요, 이 연금술사님은 기묘한 「연기 단약」을 연구하고 계시군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590317
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590317,
					"content": "아쉽지만 실망시켜 드릴 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590318
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590318,
					"content": "여러분들이 조사하고 있는 「연기 단약」은 연금술과는 전혀 관련이 없는, 단순한 특제 고대 향고거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590319
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590319,
					"content": "향고? 그건 고체 향료 아닌가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590320
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590320,
					"content": "「연기 단약」이라는 이름은 엄청 대단해 보이잖아! 책에서도 단약으로 강해질 수 있다고 했고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590321,
					"content": "후후, 제 고대 향고가 너무 인기가 많아서 그런가 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590322
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590322,
					"content": "고대 문인들은 「훈도(薰陶)」라는 단어를 유독 강조했죠. 장기간 향고의 향기를 맡으면 사람의 기품과 심성도 영향을 받게 된답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590323
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590323,
					"content": "제 고대 향고를 사용한 분들은 기품이 크게 달라지고 매력이 넘치게 되죠. 사람을 대할 때도 자신감이 넘치고 인간관계도 지속적으로 원활해집니다. 사업은 점점 승승장구하고 삶도 순조로워지죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590324
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590324,
					"content": "마치 선인의 단약을 사용한 것처럼 운세가 호전됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590325
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590325,
					"content": "이러한 이유로 손님들은 저의 고대 향고에 시적인 이름을 붙여주었답니다. 그리고 간단하고 쉬운 시를 지어 향고의 효능을 찬미했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590326
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590326,
					"content": "그랬구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590327,
					"content": "그럴 리가… 설마 책에 적혀있는 논문이 정확하지 않았던 건가? 아니면 내가 시에 대한 이해력이 딸리는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590328
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590328,
					"content": "예를 들어, 「단향은 오랫동안 머물며 의질을 끌어올린다」, 이 부분의 의미는 「연기 단약」이 사람의 잠재적 힘을 끌어낼 수 있다… 맞죠, 앵아 씨?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590329
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590329,
					"content": "어머, 「의질」은 사실 완전한 단어랍니다. 사람의 풍채와 기품을 의미하죠. 사실 이 시구는 고대 향고를 사용한 사람은 환골탈태와 흡사한 새로운 자태를 가지게 된다는 의미예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590330
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590330,
					"content": "당신 탓은 아니에요. 시구는 심오한 학문인 만큼 데이터를 분석하는 것처럼 단어를 하나하나 분리해서 해독할 수 있는 게 아니니까요. 시를 해독할 때는 전체적인 느낌에 주의해야 한답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590331
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590331,
					"content": "한 글자, 한 문구씩 분해해서 분석하는 방법이 통하지 않는다고요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590332
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590332,
					"content": "하지만 그 책에는 「연기 단약」이 신기한 효능을 발휘한 예시도 적잖게 쓰여 있었고, 제겐 신선한 충격이었습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590333
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590333,
					"content": "사람은 자극적이고 신비한 사물에 늘 마음이 끌리는 법이죠. 창호지 너머로 보이는 미인의 아름다운 그림자처럼요. 풍문을 기록한 서적도 적당한 예술적 가공이 필요해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590334
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590334,
					"content": "그 작가분의 과찬에 감사를 드려야겠네요~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590335
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590335,
					"content": "이럴 수가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590336
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590336,
					"content": "그러니까, 데마로우스의 참고 자료에서 향고의 효능을 과장해서 설명했고, 데마로우스도 시를 잘못 이해하는 바람에 「연기 단약」을 강력한 연금술 포션으로 착각했다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590337,
						716590338
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590337,
					"content": "마음의 준비를 미리 해둬서 다행이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590339,
					"content": "내 연구 과제가 처음부터 완전히 틀린 이론에 기반한 거였다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590340
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590340,
					"content": "이번 연구는 실패야, 또 헛수고했네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590341
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590341,
					"content": "어머, 그렇게 낙담할 필요는 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590342
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590342,
					"content": "「우여곡절 끝에 새로운 길을 발견할 수 있고, 고목의 새싹이 자라 큰 나무가 된다」는 말도 있잖아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590343
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590343,
					"content": "전통 향고 제조법에서 힌트를 얻어 마지막 슬럼프를 돌파하고 바라던 포션을 제작해낼 수 있을지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590344
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 716590344,
					"content": "맞아, 출발점은 좀 이상했지만 데마로우스도 자신만의 이해로 어느 정도 수확을 얻었잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590345
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590345,
					"content": "앵아 씨가 이렇게까지 제안했으니 포기하지 말고 도전해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590346
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716590346,
					"content": "어쩌면 뜻밖의 성과가 있을지도 몰라요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590347
					]
				},
				{
					"id": 716590347,
					"content": "일리 있어… 연금술은 심오한 학문이야. 처음 실패하는 것도 아닌데, 이럴수록 더 기운을 차려야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590348
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590348,
					"content": "난 원래 자료를 잘못 해석하는 실수는 안 해. 이번은 예외야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590349
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590349,
					"content": "전설 속의 기묘한 포션을 제작해낼 수는 없어도, 현존의 연금용 포션을 개량할 수만 있다면 그것도 괜찮은 성과지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590350
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590350,
					"content": "앵아 씨, 여행자, 지금 바로 합성대로 가죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 716590338,
					"content": "예상한 결말이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590307,
					"content": "기쁘다구요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				}
			]
		},
		{
			"id": 7165904,
			"completionStepIds": [
				7165904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165904",
							"2"
						],
						"stepId": 7165904,
						"stateName": "QUEST_STATE_UNFINISHED"
