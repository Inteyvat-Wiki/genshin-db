						230060402
					],
					"speakerTitle": "골샨"
				},
				{
					"id": 230060402,
					"content": "다 끝냈어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060403
					]
				},
				{
					"id": 230060403,
					"content": "정말 고마워, 여행자. 보수를 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "골샨"
				},
				{
					"id": 230060404,
					"content": "그러고 보니 구르겐 씨는 요즘 또 무리해서 일하더라. 내가 설득해보는 게 좋을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "골샨"
				},
				{
					"id": 230060405,
					"content": "요즘 해야 할 일이 워낙 많아서 다음에도 청소를 부탁하게 될지도 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "골샨"
				}
			]
