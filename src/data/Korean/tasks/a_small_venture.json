					"nextDialogs": [
						761390217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761390217,
					"content": "#윽… 아니! 내가 방금 말한건 다 진짜야. 역시 {NICKNAME}, 보는 눈이 있어!",
					"roleType": "TALK_ROLE_NPC",
