			"dialogs": [
				{
					"id": 20040301,
					"content": "이게 테지마 씨가 말한 부적인가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040302,
					"content": "근데 색도 그렇고 디자인도 그렇고 여자 것 같단 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040303,
					"content": "테지마 씨가 계속 지니고 있었다면 아마 그의 원소의 힘이 남아 있을 거야. 이걸로 뭔가를 알아낼 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
