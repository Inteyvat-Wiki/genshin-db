			"dialogs": [
				{
					"id": 20040701,
					"content": "휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "켄지로"
				},
				{
					"id": 20040702,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "내 생각에 이 일은 「안수령」과 관련 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "켄지로"
				},
				{
					"id": 20040704,
					"content": "테지마 씨는 아무 잘못이 없는데도 「신의 눈」을 몰수당했어. 그리고는 완전… 딴사람이 돼버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "켄지로"
				},
				{
					"id": 20040705,
					"content": "난 잘 모르겠지만, 아마 중요한 걸 잃은 기분일 테지. 혼자 마을을 몇 바퀴 돌더니 느닷없이 유랑을 떠나겠다 하더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "켄지로"
				},
				{
					"id": 20040706,
					"content": "테지마 씨를 붙잡아두는 게 옳은 일일지는 모르겠지만, 그가 이렇게 넋을 놓고 떠나게 할 순 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "켄지로"
				},
				{
					"id": 20040707,
					"content": "주변에서 다들 그를 존경하는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
