				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "이게 테지마 씨 일기장인 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040202,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040203,
					"content": "「오늘은 마을 사람들과 함께 은어조림을 만들었소. 서툰 실력 탓에 냄비를 태워서 가물치조림인 척할 수밖에 없었지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040204,
					"content": "「오늘은 물에 빠진 아이를 구했소. 친구 밤부가 아직 물속에 있다고 하여 오후 내내 고생했지만, 건지고 나서야 밤부가 기르던 꽃게라는 걸 알았지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040205,
					"content": "「오늘은 연을 날리다가 갑자기 줄이 끊어졌소. 쫓아봤지만, 닿을 수 없다는 걸 알고 자리에 앉아 멀어지는 걸 쳐다만 봤구려」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040206,
					"content": "흠… 그냥 다 소소한 일상을 적은 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040207,
					"content": "앗! 잠깐, 이것 좀 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040208,
					"content": "「오늘은 근처 감실에 가서 기도하며 오래 머물렀소. 당신이 준 부적은 색이 바랬지만, 나한텐 여전히 가장 소중한 것이라오…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040209,
					"content": "유용한 정보 같아. 감실에 가서 살펴보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
