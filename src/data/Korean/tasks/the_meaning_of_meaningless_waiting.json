			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "어디 보자~ 아야카가 말한 그 사람이 어디 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040102,
					"content": "뭐 하는 건가, 잘 살다가 갑자기 왜 떠난다는 게야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "마히루"
				},
				{
					"id": 20040103,
					"content": "맞네, 마음의 준비도 안 됐는데 갑자기 이렇게 떠나겠다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "켄지로"
				},
				{
					"id": 20040104,
					"content": "아이들은 아직 자네가 데리고 나가서 놀아주길 바라고 있네… 제발, 다시 한번 생각해주게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "켄지로"
				},
				{
					"id": 20040105,
					"content": "저 사람이 아야카가 말한 사람일 거야. 가서 한번 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
