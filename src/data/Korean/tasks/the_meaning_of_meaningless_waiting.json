					"마히루"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "너는… 너도 테지마 씨를 만류하러 온 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "마히루"
				},
				{
					"id": 20040602,
					"content": "무슨 일 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "테지마 씨는 30년 전 이곳에 온 이후부터 여길 지켜왔단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "마히루"
				},
				{
					"id": 20040604,
					"content": "보물 사냥단을 몰아내고, 근처 마물을 무찌르며, 마을 사람들의 다툼도 중재했지…. 그가 들인 정성을 알기에 우리도 그를 존경해왔고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "마히루"
				},
				{
					"id": 20040605,
					"content": "하지만 갑자기 여길 떠나겠다니, 우리가… 뭔갈 잘못한 건 아닌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "마히루"
				},
				{
					"id": 20040606,
					"content": "괜찮다면 테지마 씨에게 사과하고 여기에 계속 머물러 달라고 하고 싶구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마히루"
				}
			]
		},
