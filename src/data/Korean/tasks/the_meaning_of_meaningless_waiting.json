			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "찾았다! 테지마 씨가 자주 오는 곳 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040402,
					"content": "흙이 파헤쳐진 흔적이 있어…. 여기에 무슨 보물이라도 숨겨둬서 계속 머물렀던 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040403,
					"content": "테지마 씨가 여기서 30년 동안 지켜온 보물이라면 분명 엄청난 걸 거야. 빨리 파보자~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040404,
					"content": "이건… 편지? 편지지가 누렇게 변한 걸 보니까 되게 오래된 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040405,
					"content": "콘다 마을, 익숙한 이름인데…. 어디더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040406,
					"content": "여기잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "엥? 그러니까 테지마 씨는 여기서 누군가를 기다리고 있던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040408,
					"content": "하지만 30년이나 지났는데 아직도 못 만난 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20040409,
					"content": "어쨌든 이것들은 일단 테지마 씨에게 돌려주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
