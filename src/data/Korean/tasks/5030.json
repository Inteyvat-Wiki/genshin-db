						50300505
					],
					"speakerTitle": "마야힐"
				},
				{
					"id": 50301601,
					"content": "너희 왔구나. 무사해서 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마야힐"
				},
				{
					"id": 50300506,
					"content": "아드님 상황은 좀 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "모르겠어. 통신도 거의 끊겼고, 부상자들이 몰려오고 있어서 지금은 여기에 집중해야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "마야힐"
				},
				{
					"id": 50300508,
					"content": "하지만 난, 그 아이가 중요한 순간에 올바른 판단을 내릴 거라고 믿어. 자랑스러운 내 아들이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마야힐"
				}
			]
		},
