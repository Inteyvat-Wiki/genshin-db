					"nextDialogs": [
						400595111
					],
					"speakerTitle": "행추"
				},
				{
					"id": 400595111,
					"content": "이따 쿠로누시 초상화 제막식에서 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "행추"
				}
			]
		},
