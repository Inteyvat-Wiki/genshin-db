					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 400591519,
					"content": "가문이 모함당했다는 걸 알았다는 부분?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591522
					]
				},
				{
					"id": 400591522,
					"content": "후후후, 이 문제의 답은 저도 몰라요. 답은 미래의 여행자님에게 남겨두도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591523
					],
					"speakerTitle": "카미사토 아야토"
