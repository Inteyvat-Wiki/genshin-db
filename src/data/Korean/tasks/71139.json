			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"무월",
					"영연"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390201,
					"content": "파랑아, 파랑아! 저번에 나한테 해줬던 그 이야기의 결말, 아직 말해주지 않았잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390202
					],
					"speakerTitle": "무월"
				},
				{
					"id": 711390202,
					"content": "그래, 나도 안다. 하지만 마음이 바뀌었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390203
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390203,
					"content": "「마음이 바뀌었다」는 게 무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390204
					],
					"speakerTitle": "무월"
				},
				{
					"id": 711390204,
					"content": "그 이야기의 결말, 그건 너에게 맡기도록 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390205
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390205,
					"content": "뭐어?! 그건 반칙이야! 내가 이야기를 하나 해주면 너도 이야기를 하나 해주겠다고 분명히 말했잖아. 왜 갑자기 이야기 두 편을 모두 내가 하는 걸로 바뀐 건데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390206
					],
					"speakerTitle": "무월"
				},
				{
					"id": 711390206,
					"content": "난 그저 우둔한 짐승일 뿐이다. 좋은 결말이 떠오르지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390207
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390207,
					"content": "내가 생각해 낸 결말은 나쁜 결말이었고 아무도 웃을 수 없는 안 좋은 이야기였지. 그러니까, 네가 결말을 생각해 보거라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390208
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390208,
					"content": "그래도 그건 치사해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390209
					],
					"speakerTitle": "무월"
				},
				{
					"id": 711390209,
					"content": "부정하진 않으마. 대신 너한테 영몽산의 숨겨진 절경을 보여주도록 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390210
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390211
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390211,
					"content": "그런 표정 짓지 말거라. 내가 특별히… 5분 정도 등에 태워주마. 아니, 10분도 좋다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390212
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390212,
					"content": "그… 그거라면 좋아. 이야기를 어떻게 마무리 지을지 생각해 볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "무월"
				}
			]
		},
		{
			"id": 7113903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
