						],
						"pointId": 311500192
					}
				]
			},
			"dialogs": [
				{
					"id": 711390301,
					"content": "어? 저거 영연 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390303,
					"content": "아, 미안! 혹시 사냥하는데 우리가 방해한 건가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390304,
					"content": "사냥하고 있던 것도, 너희가 날 방해한 것도 아니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390305,
					"content": "음, 그럼 지금… 멍때리고 있어? 예를 들면 맛있는 걸 생각한다든가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390306,
					"content": "널 생각하고 있지도 않았다. 그저 고민 중일 뿐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390307,
					"content": "생각… 잠시만, 방금 그건 무슨 뜻이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390308,
					"content": "#전에 {NICKNAME}이(가) 했던 질문을 고민하고 있었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390309,
					"content": "「만약 인간의 활동도 자연의 규칙의 일부라면 인간을 어떻게 대해야 할까」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390310,
					"content": "부금과 뱀… 그녀들이 떠난 뒤로 난 마을을 구성하는 인간과 만난 적이 없다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390311,
					"content": "무슨 말이야? 무월도 인간이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390312,
					"content": "#무월은 마을에 속한 인간이지만 마을을 구성하는 인간은 아니잖느냐? 너와 {NICKNAME}은(는) 여행의 동반자로 「구성」되지만, {NICKNAME}에게 「속한」 건 아닌 것처럼 말이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390313,
					"content": "무월이 사회 질서의 일부분이라고 생각하지 않는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "아직 완전히 질서의 일부분이 된 건 아니니까. 인간의 아이는 질서에 완전히 흡수되기 전까지는 대부분 그런 상태지. 마치 자연이 그런 것처럼 말이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390317,
					"content": "마을을 구성하는 인간과 만난 지 너무 오래된 것 같군. 혐오 때문일 수도 있고, 두려움 때문일 수도 있지. 어쩌면 둘 다거나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390318,
					"content": "그들이 자연의 땅을 점령했기 때문이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "모르겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390321,
					"content": "어쩌면 「우리」와 「그들」을 구분할 수 있는 명확한 차이가 존재하지 않을 수도 있지. 하지만 확신할 수는 없더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390322,
					"content": "인간의 아이들은 나와 함께 할 거다. 내게도 호기심 때문에 인간과 함께하는 것을 선택한 어린 동족이 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390323,
					"content": "엥? 어린 동족?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390324,
					"content": "그 아이는 산속에서 속세에 물든 인간을 만났거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390325,
					"content": "그러니까 아직은 네 질문에 대답할 수 없겠군. 난 계속 인간을 관찰해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711390326,
					"content": "이해할 수 없는 일들은 많지만, 약속한 대로 네 질문에 답할 수 있을 때까지 이해하도록 노력해 보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "영연"
				},
				{
					"id": 711390319,
					"content": "부금이 그들을 위해 희생했기 때문이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "글쎄, 어떠려나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "이봐! 이상한 소리는 하지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113904",
							"2"
						],
						"stepId": 7113904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"무월",
					"오트몽테뉴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "대산 누나의 말을 들어보니까, 폰타인의 「오페라」는 우리의 연극이랑 비슷한 것 같아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "무월"
				},
				{
					"id": 711390402,
					"content": "기사나 마법사, 용사나 악룡이 나오고, 서로를 죽이려고 하다가 마지막엔 모두 죽는 그런 거요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "무월"
				},
				{
					"id": 711390403,
					"content": "중요한 건 결말이 아니라 과정, 과정이라니까! 모든 비극이 다 액션물인 건 아냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "오트몽테뉴"
				},
				{
					"id": 711390404,
					"content": "그리고 그리고, 대산 누나가 방금 말한 「레무리아 골렘」도 엄청 재밌을 것 같아요! 파랑이랑 비교하면 어느 쪽이 더 클까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "무월"
				},
				{
					"id": 711390405,
					"content": "응? 파랭이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "오트몽테뉴"
				},
				{
					"id": 711390406,
					"content": "맞다, 대산 누나한테 파랑이 얘기를 안 해줬네요…. 이렇게 해요. 「레무리아」 골렘 이야기를 해주면 내가 파랑이 이야기를 해줄게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "무월"
				}
			]
		},
		{
			"id": 7113905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"부금"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "우와! 어느새 선력을 이렇게나 많이 모았다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390502,
					"content": "역시 나야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "부금이 말한 대로라면 이 선력은 모두 「사롱옥」에 사용해야 해. 그래야 내년에 교영 마을이 풍년을 맞이할 수 있을 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390506,
					"content": "그때가 되면 나 씨 아저씨한테 엄청 맛있는 걸 준비해달라고 할 거야! 어디 보자, 찻잎 떡이랑 비둘기랑 홍소 고기 완자, 꿀 차사오, 그리고, 그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390507,
					"content": "맞다! 침옥 차 이슬까지! 이건 꼭 적어둬야지…. 어라? 잠깐, 거기 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390508,
					"content": "부, 부금?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390509,
					"content": "후후, 미안. 놀랐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390510,
					"content": "인간의 모습으로 돌아올 수 있게 됐구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390511,
					"content": "맞아. 으흠! 내가 말했잖아. 심각한 부상은 아니라서 조금만 쉬면 곧 내가 가장 좋아하는 모습으로 돌아갈 수 있을 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390512,
					"content": "#고마워, 내가 휴식을 취하는 동안 사롱옥에 이렇게나 많은 선력을 모아줘서. 내년에 이어질 풍작의 가장 큰 공신은 {NICKNAME}와(과) 페이몬이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390513,
					"content": "#흠흠, 이 {M#도련님}{F#아가씨}에게는 식은 죽 먹기죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "그나저나 인간의 모습으로 돌아왔으니 이제 이 깜깜한 곳에 갇혀있지 않아도 되잖아. 앞으로 하고 싶은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390516,
					"content": "음… 구체적인 건 아직 잘 모르겠어. 일단 주변을 좀 돌아다녀 볼까 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390517,
					"content": "지금의 차를 마시고, 지금의 연극을 감상하고, 지금의 사람을 만나고…. 후후, 미안. 무슨 늙은이처럼 자꾸 「지금」을 강조하게 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390518,
					"content": "하지만 난 「지금」이라는 단어가 정말 마음에 들어. 과거에 하지 못했던 일들을 「지금」은 할 수 있고, 과거에 지키지 못했던 수많은 약속을 「지금」은 지킬 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390519,
					"content": "그다음에는 귀리집에 가보고 싶어. 리월항에도 가서 그녀들이 말했던 좋은 사람들과, 약군을… 만나고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390520,
					"content": "같이 가드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "맞다, 네가 전에 그러지 않았어? 「맑은 물을 오래 떠날 수 없다」라거나, 「선인의 찻주전자에 의지해야만 멀리 갈 수 있다」라거나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390522,
					"content": "후후… 그걸 기억해 준 데다 챙겨주기까지 해서 정말 고마워. 하지만 난 일단 침옥 협곡에 한동안 머물면서 풍경을 제대로 감상해 보고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390523,
					"content": "멀리 가는 건, 음… 그래, 무월이가 다 클 때까지 기다렸다가 갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390524,
					"content": "그건 너무 오래 걸리잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711390525,
					"content": "농담이야! 어쨌든 난 일단 이곳에 잠시 머물 생각이야. 같이 여행을 떠나 보자고 영연을 설득해 볼까 싶기도 하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390526,
					"content": "#참, {NICKNAME}! 가기 전에 해주고 싶은 게 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390527,
					"content": "영연도, 나도 정말 너희에게 많은 폐를 끼쳤어. 선력도 조금은 회복이 됐으니 내가 진정한 축복을 내려줄게. 앞으로의 여정에서 너희를 지켜줄 수 있도록 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390528,
					"content": "후후, 됐어! 이거면 문제없을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390529,
					"content": "고맙습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#그럼 다시 한번… 고마워, {NICKNAME}, 페이몬. 나와 침옥 협곡을 위해서 해줬던 모든 것에 정말 감사해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "부금"
				},
				{
					"id": 711390530,
					"content": "별로 달라진 게 없는 것 같기는 한데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "「행운」이란 건 눈에 보이는 게 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "부금"
				},
				{
					"id": 711390514,
					"content": "도움이 되었다니 다행이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "#역시 {M#도련님은}{F#아가씨는} 달라!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "야! 이제 그것 좀 그만해. 언제까지 할 작정이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
