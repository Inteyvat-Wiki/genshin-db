				"points": []
			},
			"dialogs": [
				{
					"id": 190510301,
					"content": "여행자, 안녕! 해상 기후 관측에 대해 알아보러 온 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510302
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510302,
					"content": "어떻게 알았어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510303
					]
				},
				{
					"id": 190510303,
					"content": "하하, 이 일을 하는데 눈치가 안 좋으면 쓰나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510304
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510304,
					"content": "방금 누님이 신입 훈련을 구경시켜주고, 네가 은심과 해성을 찾아가 이야기 나누는 걸 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510305
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510305,
					"content": "그래서 누님이 너에게 선원 생활을 알려주고 싶어 하는구나 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510306,
						190510307
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510306,
					"content": "역시 제법이군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				},
				{
					"id": 190510308,
					"content": "하하하, 그럼 긴말할 필요 없이 해상 기후 관측의 요점을 소개하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510309
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510309,
					"content": "해상 기후란 주로 해상의 날씨와 해상 현상을 말해. 해무, 해일, 용오름 같은 것들 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510310
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510310,
					"content": "이것들은 모두 함대의 안전한 항해에 영향을 끼치지만, 어떤 기후든 오기 전에 징조를 보이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510311
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510311,
					"content": "용오름은 바다에 나타나는 빠른 회오리고, 대형 선박도 쉽게 삼킬 수 있어 큰 피해를 야기하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510312
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510312,
					"content": "하지만 용오름이 고온 다습하고 먹구름이 많은 환경에서만 생긴다는 걸 알고 있으면 대비할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510313
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510313,
					"content": "용오름이 나타나기 전엔 해수면과 반대 방향의 강풍이 분다는 사실을 알면 경계하기 더 쉬울 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510314
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510314,
					"content": "무엇보다 중요한 건 먹구름 속에 작고 하얀 소용돌이가 나타났을 때 얼른 사람들에게 알려주고 서둘러 항로를 피해야 한다는 점이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510315
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510315,
					"content": "그게 바로 용오름의 징조거든. 다행히도 난 몇 년간 어떠한 조짐도 놓친 적이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510316,
						190510324
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510316,
					"content": "시력이 정말 좋으시네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510317
					]
				},
				{
					"id": 190510317,
					"content": "음, 바다를 관찰하는 눈이라면 좋은 편이지, 하지만 사람을 보는 눈은 난 누님보다 한참 떨어져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510318
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510318,
					"content": "망서 객잔 옆의 작은 어촌 알아? 누님이 어릴 때 거기서 어른들과 함께 물고기를 잡는 일을 했었대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510319
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510319,
					"content": "후에는 살길을 찾아 항구에서 살았다는데 어린애가 그런 환경에서 출세하다니, 누님의 능력을 알았겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510320
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510320,
					"content": "봐봐, 누님이 내 어깨를 두드리며 전망대 선원 일을 해 보라고 안 하셨다면 아마 난 생각도 못 했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510321
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510321,
					"content": "넌 모르겠지만 세상 사람들한테 난 「술 세 사발이면 개가 된다」는 부끄러운 소문으로 유명하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510322
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510322,
					"content": "술에 취해 바다에 빠지고, 비웃음을 사고, 예전 함대에선 잘린 초짜가 남십자의 전망대 선원이 됐다면 누가 믿겠어, 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510323
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510323,
					"content": "그러니까, 능력만 있으면 안 되고, 누님처럼 사람을 보는 눈이 있는 대장을 찾아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510332,
					"content": "가르쳐 주셔서 감사합니다. 대충 이해했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510333
					]
				},
				{
					"id": 190510333,
					"content": "앞으로도 더 알고 싶은 게 있으면 찾아오렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510324,
					"content": "경험이 풍부하시네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510325
					]
				},
				{
					"id": 190510325,
					"content": "이런 말 부끄럽지만, 내 경험은 대부분 누님이 가르쳐주신 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510326
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510326,
					"content": "방금 너한테 말해준 기상 관측 내용도 말이지. 누님이야말로 진정한 전문가라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510327
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510327,
					"content": "망서 객잔 옆의 작은 어촌 알아? 누님이 어릴 때 거기서 물고기를 잡은 일을 했었대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510328
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510328,
					"content": "후에는 살길을 찾아 항구에 살면서 줄곧 이렇게 힘들게 살았었나 봐. 어쩐지 해상 일에 대해선 바삭하더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510329
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510329,
					"content": "처음 승선했을 땐, 그동안의 선원 생활이 헛됐던 걸까 매일같이 의심했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510330
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510330,
					"content": "나중에야 이런 새로운 지식과 견문에 익숙해지면서 남십자가 이렇게 강한 이유를 알게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510331
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510331,
					"content": "모든 함대에 「용왕」이 있는 건 아니니까. 남십자에 합류하게 돼서 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "서육석"
				},
				{
					"id": 190510307,
					"content": "#{F#북두 대장}{M#북두 누님}은 사람 보는 눈이 좋네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				}
			]
		},
