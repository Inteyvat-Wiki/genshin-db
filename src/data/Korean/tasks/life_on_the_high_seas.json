	"talks": [
		{
			"id": 1905101,
			"completionStepIds": [
				1905101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905101",
							"2"
						],
						"stepId": 1905101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"은심"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510101,
					"content": "안녕, 여행자! 난 남십자의 선의, 은심이라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510102
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510102,
					"content": "선원들의 뱃멀미, 감기와 같은 크고 작은 병의 치료부터 절단술까지 모두 내 담당이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510103
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510103,
					"content": "바다 위의 부상과 질병에 대해 알고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510104
					]
				},
				{
					"id": 190510104,
					"content": "응, 북두 대장이 주선한 거지? 내가 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510105
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510105,
					"content": "우선, 신입에게 있어 항해할 때 가장 위험한 게 뭔지 아니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510106,
						190510107,
						190510108
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510106,
					"content": "뱃멀미요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510109,
					"content": "골치 아픈 문제긴 하지만 가장 위험한 건 아냐. 해상에서 신입에게 가장 위험한 건 바로 「위험에 대한 방심」이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510110
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510110,
					"content": "젊은 패기만 믿고 우쭐대는 신참들은 많이 봐 왔어. 부상과 질병 예방에는 소홀하고, 육지에서 괜찮았으니 바다 위에서도 무탈할 거라고 생각하더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510111
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510111,
					"content": "그런 녀석들은 결국 호되게 고생했어. 바다에서의 항해——특히 장거리 항해는 열악한 환경에서의 고역이란 걸 모두가 알아야 할 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510112
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510112,
					"content": "우린 물자 부족으로 영양실조에 걸리기도 해. 급변하는 기온과 혹독한 날씨는 잡다한 질병을 일으키지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510113
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510113,
					"content": "또 정보와의 단절과 놀거리 부족으로 심리적인 문제가 생기기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510114
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510114,
					"content": "더군다나 바다에는 별다른 약이나 치료 수단이 없어서 사소한 문제가 돌이킬 수 없는 결과로 이어질 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510115
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510115,
					"content": "그럼 아까 말한 절단술은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510116
					]
				},
				{
					"id": 190510116,
					"content": "하하, 아마 내가 농담한 줄 알았겠지? 뭐, 놀랍지도 않아. 신입들 대부분이 그렇게 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510117
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510117,
					"content": "하지만 이제는 제대로 알아줬으면 좋겠어. 괜한 일이 많았거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510118
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510118,
					"content": "자, 신입에겐 이 정도면 충분할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510119,
					"content": "또 묻고 싶은 것이 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510120,
						190510129,
						190510137
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510120,
					"content": "#{F#북두 대장}{M#북두 누님}의 견해는 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510121
					]
				},
				{
					"id": 190510121,
					"content": "북두 대장은… 내가 만난 사람 중에 생명을 가장 중시하는 분이셔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510122
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510122,
					"content": "북두 대장은 한낱 선의인 내게 상태가 안 좋다고 생각되는 신입은 하선시켜 쉬게 해줄 수 있는 자격을 주셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510123
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510123,
					"content": "또 원양 항해를 앞두고 물자 조달을 할 때마다 약물을 항상 우선순위에 두고, 가격 상관없이 넉넉한 예산으로 공급상을 고를 수 있게도 해주시지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510124
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510124,
					"content": "우리 함대의 회계사 짠순이가 이걸 보고 뭐라 했는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510125
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510125,
					"content": "'막중한 재무 위험'이래, 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510126
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510126,
					"content": "하지만 무의미한 인명 피해를 막기 위해 내게 이런 권한을 주신 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510127
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510127,
					"content": "나는 대장이 신뢰하는 사람이고, 대장은 내가 이런 문제들을 해결할 수 있다고 믿으셔…. 물론 난 그 믿음에 부응하고 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510128
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510128,
					"content": "이게 대장의 견해야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510129,
					"content": "그럼 절단술을 받은 선원들은 어떻게 됐나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510130
					]
				},
				{
					"id": 190510130,
					"content": "음… 너도 그들이 맘에 걸리는구나? 북두 대장이 널 눈여겨보시던데… 실력 때문만은 아니셨던 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510131
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510131,
					"content": "짠순이를 설득해서 장부를 보게 되면 함대에 「부상 선원 정기 요양 지출 및 위로 보조금」이란 명목의 고정 지출이 있다는 걸 알 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510132
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510132,
					"content": "함대의 수입과 관계없이 이 지출은 고정적으로 매년 함께 싸워온 동료에게 전달되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510133
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510133,
					"content": "현재 그들은 뭍으로 돌아가 어떤 이는 장사를 하고, 어떤 이는 세상을 유람하기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510134
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510134,
					"content": "신체적인 결함을 잊을 수 있다면, 우리보다 훨씬 자유롭게 지낼 수 있을지도 몰라. 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510135
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510135,
					"content": "안타깝지만, 누가 평생을 따라다니는 그 고통을 쉽게 지울 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510136
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510136,
					"content": "유일한 위로라면 북두 대장이 있는 남십자가 그 누구도 잊지 않을 거란 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "은심"
				},
				{
					"id": 190510137,
					"content": "감사해요, 이해됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510138
					]
				},
				{
					"id": 190510138,
					"content": "응, 그럼 이 정도만 하자. 건강 잘 챙기렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "은심"
				},
				{
					"id": 190510107,
					"content": "감기요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510108,
					"content": "절단술이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				}
			]
		},
		{
