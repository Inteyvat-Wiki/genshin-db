			"trigger": {
				"objectNames": [
					"악천"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "이 편지의 글씨체는 어린아이 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260102,
					"content": "소몽? 이 아이는 누구지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260103,
					"content": "응? 이 해류병은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "여행자? 반응을 보니… 이 편지를 쓴 사람을 알고 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260105,
					"content": "그런 셈이죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "그렇구나. 생각이 깊은 아이네, 성숙해지고 싶다라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260108,
					"content": "여행하면서 견문을 넓히면 고민이 자연스럽게 풀릴지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260109,
					"content": "그러고 보니 소몽이도 리월항 밖에 나가보고 싶다고 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210260110,
					"content": "그런데 우리가 초대했을 때 왜 거절한 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210260111,
					"content": "하하하, 꼬마 대장부의 조그만 「고집」일지도 모르겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260112,
					"content": "자신의 고민은 자기가 직접 해결하려는 거야. 남의 도움에만 의지해서는 안 되니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260113,
					"content": "근데 해류병을 띄우는 거로 문제를 해결할 순 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210260114,
					"content": "그러니까, 이때 믿음직한 어른이 나타나서 도와줘야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260115,
					"content": "자, 여행자. 나랑 같이 이 꼬마에게 편지를 써주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260116,
					"content": "꼬마한테 바깥세상에 수많은 신기한 것들이 기다리고 있다고 얘기해 주는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260117,
					"content": "하지만… 하하. 난 가본 곳이 많지 않아서 구체적으로 어떤 걸 쓸지는 네가 결정해 줘, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260118,
					"content": "폭풍에 둘러싸인 폐허의 탑에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "천천히, 천천히 얘기해. 아직 다 못 적었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260122,
					"content": "음, 여긴… 이렇게 쓰는 게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260123,
					"content": "좋아! 완성했어, 어느새 이렇게나 많이 썼네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260124,
					"content": "하하하, 네 얘기를 들으니까 나도 왠지 여행을 떠나고 싶네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260125,
					"content": "여행을 다니는 것도 좋죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "이 나이가 되면 해야 할 일이 너무 많아서 여행을 떠나고 싶어도 못 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "악천"
				},
				{
					"id": 210260127,
					"content": "편지는 해류병에 넣어뒀으니 빨리 가서 강에 띄워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "악천"
				},
				{
					"id": 210260119,
					"content": "뇌폭에 둘러싸인 이국의 제도에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "번개 신이 검으로 일격에 두 동강을 낸 섬에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "리월항에 있는 아이예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
