			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730901,
					"content": "니콜, 우리 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730902,
					"content": "빨리 왔네! 역시 너희야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730903,
					"content": "히히, 뭘. 근데 사진은 어떻게 전해줘?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730904,
					"content": "일단 가지고 있어. 나 이틀 정도면 거기 도착할 거야. 조각상 얘기는 그때 다시 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730905,
					"content": "알겠어, 그때 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
