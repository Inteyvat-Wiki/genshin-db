					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730704
					],
					"speakerTitle": "만드라고라"
				},
				{
					"id": 766730704,
					"content": "좋아, 바로 이거야! 기세가 넘치는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730705,
						766730706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730705,
					"content": "페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730707
					]
				},
				{
					"id": 766730707,
					"content": "으아아악——살려줘!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730706,
					"content": "물러나!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730707
					]
				}
			]
		},
