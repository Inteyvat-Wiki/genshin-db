							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "이제 니콜한테 가져가서 다듬어달라고 하자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766731133,
					"content": "잘 깎아 왔어? 어디 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731134,
					"content": "헤헤, 이러면 완성!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766731101,
					"content": "어——마녀의 오두막이다! 언제 나타난 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766731102,
					"content": "이것이 바로 마녀의 힘?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "「이것이 바로 마녀의 힘?」 젊은이는 믿기지 않는 표정을 지었다. 「이렇게 굉장할 수가!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731104,
					"content": "오, 이야기를 이어서 들려주는 거야? 마녀랑 젊은이는 어떻게 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766731105,
					"content": "그리하여 그들은 오래오래 행복하게 살았다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731106,
					"content": "…끝이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731107,
					"content": "엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766731108,
					"content": "중간 과정은요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "어쩔 수 없네. 그렇게까지 듣고 싶으면 처음부터 얘기해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731111,
					"content": "「당신의 소원을 제 소원으로 삼겠습니다」라고 말한 젊은이는 대마녀 니콜라·코코의 시선을 끌었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731112,
					"content": "두 사람의 관계가 고조되던 그때, 갑자기 불청객이 나타나 마녀를 잡아가 버렸다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731113,
					"content": "크게 놀란 젊은이의 앞에 새로운 마녀 알리나스가 나타났다. 그녀는 젊은이와 계약을 맺었고, 젊은이는 마법을 손에 넣었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731114,
					"content": "그런데 혹독한 특훈을 치른 후, 젊은이는 배후에 숨겨진 음모를 발견했다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731115,
					"content": "대마녀 니콜라·코코는 사실 외계 생명체로, 고양이 행성의 국왕 냥트라스 3세의 첫째 딸이었던 것이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731116,
					"content": "그녀가 마녀로 위장한 진짜 목적은, 온 세계가 고양이 행성을 믿게 만드는 것이었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731117,
					"content": "「위대한 마녀여, 지금까지 절 속이신 겁니까?」 젊은이는 찢어지는 마음에 떨리는 목소리로 물었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731118,
					"content": "「돌아가. 우리 고양이 행성은 너희와 전쟁을 치를 운명. 우리는 처음부터 적이었어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731119,
					"content": "마녀는 눈물을 보이지 않으려 몸을 돌렸다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731120,
					"content": "그러나 용감한 젊은이는 마녀의 손목을 붙잡곤, 그녀와 영원히 함께하겠다고 맹세했다. 마녀는 젊은이의 마음에 감동해 반기를 들기로 결심했다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731121,
					"content": "그런데 이때, 젊은이를 도와줬던 알리나스가 돌연 국왕의 편에 서는 것이 아닌가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731122,
					"content": "사실 그녀는 냥트라스 3세의 둘째 딸이었다. 젊은이를 도운 건, 언니의 배신을 유도해 왕위 계승권을 쟁탈하기 위해서였다——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731123,
					"content": "니콜은 우여곡절의 과정을 끊임없이 이야기했고, 그 속엔 온갖 이상한 줄거리들이 가득했다. 결국 주인공은 인간의 범주에서 벗어나게 된다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "어쨌든 결말은 이래. 고양이가 된 젊은이는 마녀와 함께 음모를 깨부수고, 마녀 오두막으로 돌아가 세상과 단절된 평온한 삶을 살았습니다. 이야기 끝!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731125,
					"content": "으으… 최고야. 사랑과 반항으로 가득 찬 스토리…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766731126,
					"content": "시작 때랑 얘기가 많이 달라진 거 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "어쩔 수 없어. 어떤 창조물이든, 언젠가는 창조자의 제어에서 벗어나게 되는 법이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731128,
					"content": "우리 「천사」처럼. 우리도 한때는 인간을 인도하는 역할을 맡았지만, 일부 천사들이 「또 하나의 길」을 선택하면서 종족 전체가 벌을 받게 되었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731129,
					"content": "천리도 자신의 창조물을 완벽히 통제하지 못하는데… 나라고 가능하겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731130,
					"content": "운명은 예측할 수 없지만… 난 내가 본 사람들이 아름다운 결말로 향할 수 있게 인도하고 싶어. 그게 이야기 속 인물이라도 마찬가지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 766731131,
