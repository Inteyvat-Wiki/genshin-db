						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "젊은이는 마녀의 기품과 아름다움에 감탄하곤, 오랜 침묵 끝에 진지하게 입을 열었다——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730202,
					"content": "「유구한 마녀시여, 아름다운 마녀시여, 지혜로운 마녀시여! 당신을 보자마자 요동치는 마음을 주체할 수 없었습니다. 저는 당신의 소원을 제 소원으로 삼겠습니다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730203,
					"content": "마녀의 입가에 희미한 미소가 걸렸다. 「그렇다면 나를 대신해 네가 할 수 있는 일을 하거라. 보상이 미래에서 너를 기다리고 있을 것이다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730204,
					"content": "인도… 이 빛을 말하는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "「비밀 오두막?」 젊은이의 눈빛에 의아함이 어렸다. 「오두막이 어디 있죠?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730302,
					"content": "젊은이의 질문을 들은 마녀가 약간 당황한 목소리로 대답했다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730303,
					"content": "(잠깐만, 원래 이렇게 수줍은 캐릭터였나? 됐다, 일단 이 설정으로 가자. 구 작가 선생이 윤색해 주겠지)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730304,
					"content": "「흠흠, 젊은이여, 무례한 질문 말거라. 마녀의 오두막은 지금 건설 중이다. 그 호화로운 모습을 보면 깜짝 놀라게 될 것이다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730305,
					"content": "「이는 너에게 내리는 시험이니, 대마녀의 영토를 위해 너의 힘을 보태거라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "관찰"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "「자, 젊은이여. 이제 그대는 마녀의 고민을 알게 되었다. 니콜라·코코의 신성한 영지에, 그대의 도움이 필요하도다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730402,
					"content": "마녀가 젊은이에게 웃으며 차를 따라주었다. 「그대의 선택은 무엇이지?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730403,
					"content": "기꺼이 돕겠습니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "잠깐만! 혼잣말이나 하는 정체불명의 괴짜가 하는 말이라구. 그냥 들을 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730406,
					"content": "어… 근데 이 찻잔, 왠지 낯이 익은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730407,
					"content": "이제 눈치챘어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "니콜라·코코… 아! 설마 마녀N——니콜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730410,
					"content": "맞아. 방금 이야기 어땠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730411,
					"content": "어땠냐고…? 아직 안 끝났잖아? 그래서 젊은이랑 마녀는 어떻게 됐는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730412,
					"content": "아직 생각 안 해봤어. 나머진 마녀 오두막을 짓고 나서 생각해 봐야지. 또 새로운 영감이 떠오를 수도 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730413,
					"content": "내 목소리를 들었다는 건, 지금 노드크라이에 있다는 거겠지? 그럼 뭐 좀 모아다 주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730414,
					"content": "뭐요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "오두막을 지으면서 새 조각상도 몇 개 만들려는데, 영감이 떠오르질 않더라구. 너희가 멋진 사진을 찍어줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730418,
					"content": "정말 못 말린다니까. 알겠어, 그럼 우리한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730419,
					"content": "바로 나가서 괜찮은 거 있나 찾아볼게. 조각상이 완성되면 아까 그 이야기 마저 해줘야 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730416,
					"content": "조각상에 관련된 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "응. 오두막을 지으면서 새 조각상도 몇 개 만들려는데, 영감이 떠오르질 않더라구. 너희가 멋진 사진을 찍어줬으면 해",
