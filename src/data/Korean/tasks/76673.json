						],
						"pointId": 14930
					}
				]
			},
			"dialogs": [
				{
					"id": 766730801,
					"content": "#아주 오래전, 집을 떠난 한 젊은이가 있었다. 마지막 남은 모라까지 다 써버린 {M#그}{F#그녀}는 얇은 옷을 걸친 채 추위에 떨며 걸어갔다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730802,
					"content": "#그때, 젊은이의 발밑이 꺼지며 {M#그}{F#그녀}를 기묘한 공간으로 떨어뜨렸다. {M#그}{F#그녀}가 미처 반응하기도 전에, 멀리서 목소리가 들려왔다——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730803
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730803,
					"content": "「이곳은 영원불멸의 대마녀 니콜라·코코의 비밀 오두막. 낙심한 자여, 그대의 소원을 말해보아라. 위대한 마녀가 그대를 인도하고 소원을 이뤄주리라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730804
					],
					"speakerTitle": "관찰"
				},
				{
					"id": 766730804,
					"content": "으아… 뭔가 이상한 소리를 들은 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730805
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766730805,
					"content": "니콜라·코코… 그게 누구지? 우리가 아는 사람인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7667309,
			"completionStepIds": [
				7667309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667309",
